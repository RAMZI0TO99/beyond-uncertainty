+def complete_batch(jobs) -> B.BatchReport:
+    """Return a fully accounted synthetic report for the supplied exact plan."""
+
+    return B.BatchReport(
+        batch_id=B._manifest(jobs)["batch_id"],
+        total=len(jobs),
+        executed=len(jobs),
+        resumed=0,
+        synced=len(jobs),
+        failed=0,
+        sync_failed=0,
+    )
