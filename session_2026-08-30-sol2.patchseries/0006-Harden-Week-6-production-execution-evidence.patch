+    jobs = B.experiment_1_jobs()
+    kwargs = {
+        "preflight_path": preflight,
+        "preflight_sha256": sha256_file(preflight),
+        "git_commit": COMMIT,
+        "batch_id": B._manifest(jobs)["batch_id"],
+        "output_root": roots["output"],
+        "staging_root": roots["staging"],
