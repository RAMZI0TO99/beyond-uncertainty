"""Adopt a separately reviewed saved refusal, never rerun its target."""
import datetime,hashlib,json,os
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011');CAP=2097152
def raw(p):
 b=Path(p).read_bytes();assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 b=raw(q['path']);assert type(q['bytes']) is int and len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def obj(b):return json.loads(b)
adop=fact(P/'ROOT_I8_FINAL_PREWRITE_ADMISSION_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json');a=obj(pin(adop));assert a['author']=='/root' and a['verdict']=='ACCEPT_I8_PURE_PREWRITE_ADMISSION_AND_FIXTURE_SOURCE_ONLY'
c=obj(pin(a['different_Source_review']));f=obj(pin(a['full_proof']));assert c['reviewer']==f['reviewer']=='/root/owner_source_review' and c['checks_failed']==f['checks_failed']==0 and c['target_execution'] is False and f['tests_executed'] is False
assert len({q['name'] for q in f['checks']})==len(f['checks']) and all(q['passed'] is True for q in f['checks'])
for q in f['all_actual_inputs']:pin(q)
prior={key:fact(P/name) for key,name in [('scope','ROOT_I8_ONCE_SYNTHETIC_MEMORY_TEST_SCOPE_001.json'),('result','ROOT_I8_ACTUAL_ONCE_SYNTHETIC_MEMORY_RESULTS_001.json'),('supervisor','ROOT_I8_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_001.json'),('capture','ROOT_I8_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_001.json')]}
for key in ('result','supervisor'):assert prior[key] in f['all_actual_inputs']
r=obj(pin(prior['result']));s=obj(pin(prior['supervisor']));assert r['scope']==s['scope']==prior['scope'] and r['tests_executed'] is True and r['I8_memory_test_runs']==1 and r['actual_test_case_count']==0 and r['failed_or_last_case_at_failure']=='positive_template' and r['error']['message']=='E_PHASE_ORDINAL' and r['all_cases_passed'] is False and r['blocked_forbidden_event_names']==[]
assert s['passed'] is False and s['owned_child_invocations']==1 and s['owned_child_exit_code']==1 and s['owned_child_wait_reaped'] is True and 0<s['owned_child_wall_integer_nanoseconds']<=60000000000
for q in (r['consumption_marker'],s['supervisor_marker']):assert obj(pin(q))['scope']==prior['scope']
protocol=fact(P/'ROOT_I8_SAVED_ATTEMPT001_AND_INHERITED_PHASE_PATH_CORRECTION_PROTOCOL_001.json');assert protocol in f['all_actual_inputs']
x=dict(schema_version=1,record_type='Root_I8_attempt001_saved_refusal_and_correction_adoption',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),verdict='ACCEPT_I8_ATTEMPT001_SAVED_REFUSAL_AND_BOUNDED_CORRECTION_ONLY',prior_failed_attempt=prior,different_review=a['different_Source_review'],full_proof=a['full_proof'],corrected_quartet_Source_adoption=adop,bounded_correction_protocol=protocol,actual_completed_cases=0,failed_current_case='positive_template',owned_child_exit_code=1,owned_child_reaped=True,refusal_is_not_a_pass=True,consumed_scope_replay_authorized=False,automatic_retry_authorized=False,future_attempt_requires_fresh_one_use_scope_and_preinvocation_review=True,target_execution=False,tests_executed=False,actual_suite_invocations_observed_so_far=1,operational_authority=False,scientific_authority=False)
p=P/'ROOT_I8_ATTEMPT001_SAVED_REFUSAL_AND_CORRECTION_ADOPTION_001.json'
with p.open('xb') as h:h.write((json.dumps(x,sort_keys=True,indent=2)+'\n').encode());h.flush();os.fsync(h.fileno())
print(json.dumps(fact(p)))
