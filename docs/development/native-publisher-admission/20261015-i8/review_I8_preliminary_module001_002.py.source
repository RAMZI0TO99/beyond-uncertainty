 dict(id='I8_MODULE001_PUBLISHER_API_NESTED_PIN_EQUALITY',status='CONFIRMED_SOURCE_CORRECTION_REQUIRED',lines=[932,936],
      current_source="publisher_api.get('publisher_Source') == publisher['Source']",
      consequence='Nested bytes=True can equal a trusted one-byte synthetic Source pin under Python equality.',
