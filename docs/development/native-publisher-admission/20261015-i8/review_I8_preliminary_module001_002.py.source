]
check('confirmed_selection_guard_gap',"selected['selected_Source_nonce'] == current['selected_Source_nonce']" not in selection_text and 'ORDINAL_COUPLING_GROUPS' not in text,[module_pin,old_pin])
check('confirmed_recorded_metadata_shape_gap',"type(receipt['native_image_metadata']) is dict" in lease_text and 'shared_identity_indexes' not in lease_text,[module_pin,i1_pin])
check('confirmed_publisher_API_strict_pin_gap',"publisher_api.get('publisher_Source') == publisher['Source']" in request_text,[module_pin])
for q in list(inputs.values()):
    body=Path(q['path']).read_bytes()
    assert len(body)==q['bytes'] and hashlib.sha256(body).hexdigest()==q['sha256']
failed=[c['name'] for c in checks if not c['passed']]
out=dict(schema_version=1,record_type='Independent_actual_I8_module001_preliminary_Source_correction_report',
 reviewer='/root/owner_source_review',source_author='/root/phase_frontier',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
 verdict='SOURCE_CORRECTIONS_REQUIRED_BEFORE_FINAL_QUARTET_REVIEW',subjects=[module_pin],reviewer_Source=self_pin,
 all_actual_inputs=list(inputs.values()),checks=checks,checks_failed=len(failed),checks_passed=len(checks)-len(failed),
 static_check_failures=failed,semantic_findings=findings,semantic_findings_count=3,direct_local_calls_checked=len(calls),
 old_helpers_imported=0,target_function_calls=0,target_Source_compilations=0,fixture_invocations=0,native_or_Parser_calls=0,
 Git_mutations=0,tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False,
 final_quartet_adoption=False,scope_note='Preliminary static review only. Source/API/fixture/receipt quartet not yet final. Root and author received the complete correction batch.')
path=OWN/'INDEPENDENT_I8_PRELIMINARY_MODULE001_SOURCE_CORRECTION_REPORT_001.json'
raw=(json.dumps(out,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(raw)<=CAP
with path.open('xb') as f:f.write(raw)
print(json.dumps(dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),checks=len(checks),checks_failed=len(failed),semantic_findings=3,inputs=len(inputs),reviewer_Source=self_pin),indent=2))
