def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,value):
    raw=value if type(value) is bytes else (json.dumps(value,sort_keys=True,ensure_ascii=False,indent=2,allow_nan=False)+'\n').encode()
    assert len(raw)<=2097152
    with path.open('xb') as stream:assert stream.write(raw)==len(raw)
    assert path.read_bytes()==raw
    return pin(path)
def literal(raw,name):
    rows=[line[len(name)+3:] for line in raw.decode().splitlines() if line.startswith(name+' = ')]
    assert len(rows)==1,name
    return ast.literal_eval(rows[0])
def region_rows(raw):
    lines=raw.splitlines(keepends=True);rows=[]
    for node in ast.parse(raw).body:
        if isinstance(node,(ast.FunctionDef,ast.ClassDef)):
            first=min([node.lineno]+[d.lineno for d in node.decorator_list])
            body=b''.join(lines[first-1:node.end_lineno])
            rows.append(dict(name=node.name,kind=type(node).__name__,first_line=first,last_line=node.end_lineno,
                             bytes=len(body),sha256=hashlib.sha256(body).hexdigest()))
    return rows

