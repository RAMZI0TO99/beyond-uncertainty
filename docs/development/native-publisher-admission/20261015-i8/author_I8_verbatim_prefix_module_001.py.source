 'I8_SELECTED_ROW9':declarations['I2_source_declarations']['ROW_KEYS'],
 'I8_ROLE_ORDER':p['fixed_role_order'],'I8_ROLE_CAPS':literal(i2.read_bytes(),'ROLE_SOURCE_CAPS'),
 'I8_CATALOGUE11':['Source024','author','created_utc','current_selection','exact_original_guard_constants','operational_authority','record_type','roles','schema_version','target_execution','whole_cohort_or_runtime_acceptance'],
 'I8_CURRENT_SELECTION_PIN':literal(old.read_bytes(),'CURRENT_SELECTION'),
 'I8_HISTORICAL45_PIN':literal(old.read_bytes(),'CURRENT_INVENTORY'),
 'I8_SOURCE024_PROVENANCE_PIN':literal(old.read_bytes(),'SOURCE024'),
 'I8_BASE_PATH':r'D:\Aenv\pro2\resume-2026-10-03-continuation001',
 'I8_SESSION_PATH':r'D:\Aenv\pro2\WORK\resume-20261007-001',
 'I8_ORIGINAL_GUARDS':p['unchanged_numerical_guards'],
 'I8_REQUEST21':p['request21_and_row10']['batch_request21_v2']['keys'],
 'I8_REQUEST_ROW10':p['request21_and_row10']['batch_request_row10_v2']['keys'],
 'I8_PURPOSE12':p['new_purpose12']['keys'],'I8_PURPOSE_PROOF':p['purpose_proof_contract'],
 'I8_RESULT_FLAGS':flags,
