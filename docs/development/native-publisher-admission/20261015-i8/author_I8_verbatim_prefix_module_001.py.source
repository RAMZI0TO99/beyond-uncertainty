FRAGMENT=OWN/'I8_NEW_PURE_PREFLIGHT_SOURCE_FRAGMENT_001.py'
MODULE=OWN/'validate_current_owner_M3_prewrite_admission_001.py'


def pin(path):
    raw=path.read_bytes()
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def literal(raw,name):
    prefix=name+' = '
    lines=[line[len(prefix):] for line in raw.decode().splitlines() if line.startswith(prefix)]
    assert len(lines)==1
    return ast.literal_eval(lines[0])


for path,size,digest in ((PROTOCOL,58128,'0171e81f315adfced2c8e783eb272aae04f924227a5c2a367a343fdf8d3b388b'),
    (ADOPTION,3702,'9445d2c6ba153dcaa9b58f061d9754e80e3e65864596284158a18151e1232780'),
    (LINEAGE,2291,'f7d7306d8c94e1f340a1cb96f05aa94c3f5ee606fd0d4692c488fd05c6a57b92')):
    actual=pin(path);assert (actual['bytes'],actual['sha256'])==(size,digest)
p=json.loads(PROTOCOL.read_bytes())
i0=p['I0_whole_verbatim_prefix'];prefix=Path(i0['path']).read_bytes();assert pin(Path(i0['path']))==i0
