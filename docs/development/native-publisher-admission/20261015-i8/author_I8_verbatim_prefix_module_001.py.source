    'I7 actual publication entry remains literalFalse and unconditional UNWIRED; this result grants no action or qualification.'
 ]}
header='\n\n# New I8 declarations: exact old I0 bindings above remain untouched.\n'
header+='\n'.join(k+' = '+repr(v) for k,v in constants.items())+'\n\n'
data=prefix+header.encode()+FRAGMENT.read_bytes()
assert data.startswith(prefix)
tree=ast.parse(data);compile(data,str(MODULE),'exec')
before=set();after=set()
for node in tree.body:
    target=before if getattr(node,'lineno',0)<=prefix.count(b'\n') else after
    if isinstance(node,(ast.FunctionDef,ast.ClassDef)):target.add(node.name)
    elif isinstance(node,(ast.Import,ast.ImportFrom)):target.update(x.asname or x.name.split('.')[0] for x in node.names)
    elif isinstance(node,ast.Assign):
        target.update(n.id for t in node.targets for n in ast.walk(t) if isinstance(n,ast.Name))
assert not before&after
assert all(n.startswith(('I8','_i8')) or n in ('require_actual_finite8_publication_admission','validate_current_owner_M3_prewrite_metadata') for n in after)
with MODULE.open('xb') as stream:assert stream.write(data)==len(data)
assert MODULE.read_bytes()==data
print(json.dumps({'module':pin(MODULE),'verbatim_I0_prefix':i0,'new_AST_compile_only':True,'target_calls_tests':0},sort_keys=True))
