CAP=2097152
def raw(p):
 b=Path(p).read_bytes();assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def change(s,a,b,count=1):
 assert s.count(a)==count,(a,s.count(a),count)
 return s.replace(a,b)
made={};bases=[]
