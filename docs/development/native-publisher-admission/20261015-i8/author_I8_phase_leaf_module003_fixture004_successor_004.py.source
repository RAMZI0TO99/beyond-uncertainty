 own_current_Source_checks=dict(module_AST_and_compile_only=True,fixture_AST_and_compile_only=True,
 whole_I0_prefix_exact=True,only_one_new_function_changed=True,original_modules_imported_or_called=0,author_target_calls=0))
receipt['Source_bases'].extend(pin(x) for x in sources[:2]);receipt['Source_fragments'].append(fragment_pin)
receipt['author_programs'].append(pin(Path(__file__)))
rp=save(OWN/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_004.json',receipt)
inspector=(OWN/'inspect_I8_frozen_Source_003.py').read_text().replace('prewrite_admission_002.py','prewrite_admission_003.py').replace('memory_only_003.py','memory_only_004.py').replace('INERT_API_003.json','INERT_API_004.json').replace('PREDECESSOR_INVERSE_003.json','PREDECESSOR_INVERSE_004.json').replace('AUTHOR_RECEIPT_003.json','AUTHOR_RECEIPT_004.json').replace('INSPECTION_003.json','INSPECTION_004.json')
save(OWN/'inspect_I8_frozen_Source_004.py',inspector.encode())
print(json.dumps(dict(module=mp,fixture=fp,API=ap,inverse=ip,receipt=rp,inventory=inventory,planned_cases=96,target_invocations=0),sort_keys=True))
