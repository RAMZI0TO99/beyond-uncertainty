import ast
import base64
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011')
OWN=P/'i8'
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,value):
    raw=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode()
    assert 0<len(raw)<=2097152
    with path.open('xb') as f:assert f.write(raw)==len(raw)
    assert path.read_bytes()==raw
    return pin(path)
def regions(raw):
    lines=raw.splitlines(keepends=True);out=[]
    for n in ast.parse(raw).body:
        if isinstance(n,(ast.FunctionDef,ast.ClassDef)):
            first=min([n.lineno]+[x.lineno for x in n.decorator_list]);body=b''.join(lines[first-1:n.end_lineno])
            out.append(dict(name=n.name,kind=type(n).__name__,first_line=first,last_line=n.end_lineno,
                            bytes=len(body),sha256=hashlib.sha256(body).hexdigest()))
    return out
