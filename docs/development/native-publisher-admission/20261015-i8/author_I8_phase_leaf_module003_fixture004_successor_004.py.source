api['accepted_Source_bases'].extend(pin(x) for x in sources[:2])
api['fixture_interface']['coupling_regression']='selection_pair_ordinal now advances actual _900.BOUND.ps1 to _901.BOUND.ps1 in canonical/draft then requires E_ORDINAL_COUPLING.'
ap=save(OWN/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_004.json',api)
