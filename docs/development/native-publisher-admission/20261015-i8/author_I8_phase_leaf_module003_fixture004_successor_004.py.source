assert pin(fixture_old)['sha256']=='2118b2404c706662e7b8672f5f540042cdd490b4de5ffa04be945b1c2e954318'
old=b"""                suffix = re.fullmatch(r'.*_([0-9]{3})\\.ps1',_i8_leaf(canonical))
                _i8_need(row['selected_ordinal'] > 18 and suffix is not None and int(suffix[1]) == row['selected_ordinal'], 'E_PHASE_ORDINAL')"""
new=b"""                phase_suffix = '.TEMPLATE.ps1' if role.endswith('_template') else '.BOUND.ps1'
                _i8_need(ordinal > 18 and _i8_leaf(canonical) == expected_leaf and
                          expected_leaf.endswith(phase_suffix), 'E_PHASE_ORDINAL')"""
source=module_old.read_bytes();assert source.count(old)==1
source=source.replace(old,new)
fragment_old=OWN/'I8_NEW_PURE_PREFLIGHT_SOURCE_FRAGMENT_002.py'
fragment=fragment_old.read_bytes();assert fragment.count(old)==1
fragment=fragment.replace(old,new)
assert source.endswith(fragment)
module=OWN/'validate_current_owner_M3_prewrite_admission_003.py'
ast.parse(source);compile(source,str(module),'exec')
mp=save(module,source);fragment_pin=save(OWN/'I8_NEW_PURE_PREFLIGHT_SOURCE_FRAGMENT_003.py',fragment)
text=fixture_old.read_text()
oldfixture="""        r['canonical_path'] = r['canonical_path'].replace('_900.ps1','_901.ps1');r['draft_path'] = r['draft_path'].replace('_900.ps1','_901.ps1')"""
newfixture="""        old_canonical,old_draft = r['canonical_path'],r['draft_path']
        r['canonical_path'] = old_canonical.replace('_900.BOUND.ps1','_901.BOUND.ps1')
        r['draft_path'] = old_draft.replace('_900.BOUND.ps1','_901.BOUND.ps1')
        _f_check(r['canonical_path'] != old_canonical and r['draft_path'] != old_draft,
                 'specific coupled bound ordinal regression advances both exact inherited leaves')"""
assert text.count(oldfixture)==1
text=text.replace(oldfixture,newfixture)
fixture=OWN/'test_current_owner_M3_prewrite_admission_memory_only_004.py'
ast.parse(text);compile(text,str(fixture),'exec');fp=save(fixture,text.encode())
now=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
before=regions(module_old.read_bytes());after=regions(source)
bm={r['name']:r for r in before};am={r['name']:r for r in after}
changed=[n for n in bm if bm[n]['sha256']!=am[n]['sha256']]
assert changed==['_i8_selection']
prior_inverse=json.loads(inverse_old.read_bytes());prefix=base64.b64decode(prior_inverse['entries'][0]['whole_original_bytes'])
assert source.startswith(prefix)
