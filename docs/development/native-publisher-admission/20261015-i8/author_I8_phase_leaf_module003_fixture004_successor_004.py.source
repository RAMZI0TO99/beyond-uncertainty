api=json.loads(api_old.read_bytes())
api.update(created_utc=now,module=mp,fixture_Source=fp,prior_API=pin(api_old),preserved_consumed_attempt001=history,
 phase_leaf_correction='Exact inherited basename substitution includes corrected prefix and .TEMPLATE/.BOUND suffix. Ordinal>018 plus expected_leaf+role suffix replaces incompatible bare _NNN.ps1 regex.',
