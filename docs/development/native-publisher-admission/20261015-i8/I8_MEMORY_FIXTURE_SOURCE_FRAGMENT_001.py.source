    publication_facts = dict(facts_fixed,created_utc=_f_stamp(20),candidate_support=candidate4)
    if variant == 'publication_facts_missing_candidate':publication_facts['candidate_support'] = None
    pf = g.add('publication.facts',publication_facts,path=home+'\\ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json',born=20)
    publication = dict(common,record_type='Root_owner_v2_prospective_lease_original_publication',created_utc=_f_stamp(22),Root_facts=pf,
        candidate=candidate,candidate_author_receipt=cr,different_lease_Source_review=c_support['different_review'],candidate_Root_adoption=c_support['Root_adoption'],
        canonical=canonical,original_closed12_schema_preserved=True,complete_candidate_bytes_exact=True,original_owner_and_timestamp_contracts_preserved=True,
        continuing_owner=owner_pin,owner_review=owner_review_pin,actual_publication_metadata=_f_creation2(canonical,21,birth=21,identity=500),native_timestamp_image=image,
        native_image_metadata=_f_image7(image),actual_entry006=False,original_fixture_or_case_grant=False,host_quiet=False,
        actor_Job_or_science_authority=False,verdict='ROOT_EXACT_REVIEWED_NEW_CLOSED12_LEASE_SOURCE_PUBLICATION_ONLY')
    if variant == 'publication_wrong_type':publication['record_type'] = 'generic_role_receipt'
    if variant == 'recorded_image_changed':
        for field in ('path9','descriptor9'):publication['native_image_metadata'][field][1] += 1
    if variant == 'recorded_rename_identity':
