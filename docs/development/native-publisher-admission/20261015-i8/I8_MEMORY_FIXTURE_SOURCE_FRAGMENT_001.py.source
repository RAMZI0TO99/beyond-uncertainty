        full_created=-1 if variant == 'I1_full_time_unequal' else None,drop_adoption_full=variant == 'code_adoption_missing_full')
    producer = dict(Source=source,API=api,**cs)
    lease_path = module.I8_BASE_PATH+'\\EXECUTION_LEASE_GG6_M3_900.json'
    decision = dict(schema_version=2,record_type='Root_owner_v2_prospective_lease_issuance_decision',author='/root',Root_thread=I8F_ROOT_THREAD,
        created_utc=_f_stamp(10),current_owner_scope=scope,design=design_pin,owner_master=owner_pin,owner_review=owner_review_pin,
        predecessor_lease=module.I8_HISTORICAL_LEASES[-1],future_canonical_path=lease_path,selected_ordinal=900,selected_duration_seconds=43200,
        native_timestamp_entry=entry,lease_is_owner_deadline=False,operational_authority=False,target_execution=False,old_leases_extended=False,
