        stage['shared_descriptor7'][0] += 1
    op = g.add('lease.publication',publication,path=home+'\\ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_CANONICAL_PUBLICATION_RECEIPT_003.json',born=23)
    l_support,unused,unused2,unused3 = g.proof('lease.canonical',[canonical,op],24,scope=scope,
        full_created=25 if variant == 'canonical_full_after_capsule' else 23)
    lease5 = dict(canonical=canonical,separate_Root_decision=decision_pin,original_publication=op,**l_support)
    if variant == 'lease_reuses_history':lease5['canonical'] = module.I8_HISTORICAL_LEASES[-1]
    old_selection = json.loads(I8F_CURRENT_SELECTION_RAW)
    cp = g.add('old.selection',raw=I8F_CURRENT_SELECTION_RAW,path=module.I8_CURRENT_SELECTION_PIN['path'])
    hp = g.add('historical45',raw=I8F_HISTORICAL45_RAW,path=module.I8_HISTORICAL45_PIN['path'])
    gp = g.add('historical.Source024',raw=I8F_SOURCE024_RAW,path=module.I8_SOURCE024_PROVENANCE_PIN['path'])
    old_rows = {r['role']:r for r in old_selection['rows']}
    selected_rows = []; catalogue_rows = []
    neutral_predecessors = {}
    for role in list(module.I8_ROLE_CAPS)+['composer']:
        prior = old_rows[role]
        if role == 'composer':
            p = g.add('composer',raw=I8F_COMPOSER_RAW,path=prior['predecessor']['path'])
            _f_check(p == prior['predecessor'],'inert exact composer carry')
            row = dict(prior)
        else:
            raw = ('synthetic predecessor '+role+'\n').encode()
            p = g.add('pred.'+role,raw=raw,path=prior['canonical_path'])
            neutral_predecessors[role] = raw
            old_leaf = prior['canonical_path'].rsplit('\\',1)[1]
            positions = [m for m in re.finditer(r'[0-9]{3}(?![0-9])',old_leaf) if int(m.group()) == prior['selected_ordinal']]
            _f_check(len(positions) == 1,'fixture exact inherited basename ordinal')
            match = positions[0]
            leaf = old_leaf[:match.start()]+'900'+old_leaf[match.end():]
            parent = prior['canonical_path'].rsplit('\\',1)[0]
            row = dict(role=role,canonical_path=parent+'\\'+leaf,
                draft_path=module.I8_SESSION_PATH+'\\generation\\synthetic_I8\\drafts\\'+leaf,
                predecessor=p,source_cap=module.I8_ROLE_CAPS[role],selected_ordinal=900,must_change_Source_bytes=True,
                preparation_Source_author=I8F_EDITOR,retained_semantic_Source_author=prior['retained_semantic_Source_author'])
        selected_rows.append(row)
        catalogue_rows.append(dict(role=role,source=p,source_cap=row['source_cap']))
    selected_map = {r['role']:r for r in selected_rows}
    if variant == 'selection_phase18':selected_map[module.I8_ROLE_ORDER[0]]['selected_ordinal'] = 18
    if variant == 'selection_wrong_cap':selected_map[module.I8_ROLE_ORDER[0]]['source_cap'] = 131072
    if variant == 'selection_duplicate_role':selected_rows[-1] = dict(selected_rows[0])
    if variant == 'selection_composer_changed':selected_map['composer']['must_change_Source_bytes'] = True
    if variant == 'selection_pair_ordinal':
        r = selected_map[module.I8_ROLE_ORDER[4]];r['selected_ordinal'] = 901
        r['canonical_path'] = r['canonical_path'].replace('_900.ps1','_901.ps1');r['draft_path'] = r['draft_path'].replace('_900.ps1','_901.ps1')
    if variant == 'selection_successor':selected_map['launcher_template']['selected_ordinal'] = old_rows['launcher_template']['selected_ordinal']
    if variant == 'selection_ordinal1000':selected_map['launcher_template']['selected_ordinal'] = 1000
    if variant == 'selection_basename':selected_map['launcher_template']['canonical_path'] += '.changed'
    if variant == 'selection_predecessor_parent':
        r = selected_map['launcher_template'];r['predecessor'] = dict(r['predecessor'],path='D:\\I8Fixture\\wrong_parent\\old.TEMPLATE.ps1')
    if variant == 'selection_cross_group':
        r = selected_map['constructor'];r['selected_ordinal'] = 901
        r['canonical_path'] = r['canonical_path'].replace('900','901');r['draft_path'] = r['draft_path'].replace('900','901')
    selected = dict(schema_version=2,record_type='Root_owner_v2_actual_separate_future45_Source_path_selection',author='/root',created_utc=_f_stamp(28),
        current_owner_scope=scope,new_canonical_lease=canonical,current_selection=cp,current_complete45_inventory=hp,
        rows=selected_rows,selected_Source_nonce=old_selection['selected_Source_nonce'],
        derived_launcher_runtime_path=selected_map['launcher_template']['canonical_path'].replace('.TEMPLATE.ps1','.BOUND.ps1'),
        target_execution=False,operational_authority=False)
    if variant == 'selection_nonce':selected['selected_Source_nonce'] = 'f'*32
