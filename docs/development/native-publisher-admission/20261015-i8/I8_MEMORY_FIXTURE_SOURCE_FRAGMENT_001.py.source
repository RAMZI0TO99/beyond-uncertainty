    entry = g.add('native.entry',raw=b'synthetic inert PS entry bytes\n',path=home+'\\native_entry_003.ps1')
    image = g.add('native.image',raw=b'synthetic opaque native image bytes\n',path='C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe')
    code_api = dict(schema_version=2,record_type='Root_owner_v2_prospective_lease_inert_API',tool_source=source,
        actual_binding_Source_editor=I8F_EDITOR,accepted_design=design_pin,I0_Source=i0_source,I0_API=i0_api,native_timestamp_entry=entry)
    api = g.add('lease.API',code_api)
