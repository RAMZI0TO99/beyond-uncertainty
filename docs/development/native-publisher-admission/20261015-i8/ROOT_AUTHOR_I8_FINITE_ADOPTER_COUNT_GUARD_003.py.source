import ast,hashlib,json,os
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011')
s=(P/'ROOT_ADOPT_I8_FINITE_MANAGED_REVIEW_002.py').read_text()
a=" assert x['target_execution'] is False and x['tests_executed'] is False"
assert s.count(a)==1
s=s.replace(a,a+"\n assert x['I8_memory_runs_saved_and_adopted']==2 and x['accepted_complete_memory_runs']==1 and x['failed_memory_runs_preserved']==1 and x['accepted_attempt_ordinal']==2 and x['prior_failed_attempt_retained'] is True")
p=P/'ROOT_ADOPT_I8_FINITE_MANAGED_REVIEW_003.py';ast.parse(s);compile(s,str(p),'exec')
with p.open('xb') as h:h.write(s.encode());h.flush();os.fsync(h.fileno())
b=p.read_bytes();print(json.dumps(dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())))
