"""Create-only two-case fixture Source correction. No target calls/imports."""
import ast
import base64
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011\i8')
def pin(path):
    b=path.read_bytes();return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def save(path,value):
    raw=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode()
    assert 0<len(raw)<=2097152
    with path.open('xb') as f:assert f.write(raw)==len(raw)
    assert path.read_bytes()==raw
    return pin(path)
oldf=P/'test_current_owner_M3_prewrite_admission_memory_only_002.py'
oldapi=P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_002.json'
oldinv=P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_COMPLETE_PREDECESSOR_INVERSE_002.json'
oldrec=P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_002.json'
assert pin(oldf)['sha256']=='4b55ffe0bcc981c95e53cd9db6de06d8ea0c56cd85793cfbcb8f90dbc9942828'
text=oldf.read_text(encoding='utf-8')
oldliteral={n.targets[0].id:ast.literal_eval(n.value) for n in ast.parse(text).body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
names=oldliteral['PLANNED_CASE_NAMES']+('json_depth_before_callback','reader_cap_reuse_conflict')
assert len(names)==96 and len(set(names))==96
def replace(old,new):
    global text
    assert text.count(old)==1,old[:120]
    text=text.replace(old,new)
replace('EXPECTED_CASE_COUNT = 94','EXPECTED_CASE_COUNT = 96')
replace('PLANNED_CASE_NAMES = '+repr(oldliteral['PLANNED_CASE_NAMES']),'PLANNED_CASE_NAMES = '+repr(names))
codes=dict(oldliteral['I8F_EXPECTED_CODES'],json_depth_before_callback='E_JSON_BOUNDS',reader_cap_reuse_conflict='E_CAP_CONFLICT')
replace('I8F_EXPECTED_CODES = '+repr(oldliteral['I8F_EXPECTED_CODES']),'I8F_EXPECTED_CODES = '+repr(codes))
zero=oldliteral['I8F_ZERO_CALLBACK_CASES']+('json_depth_before_callback',)
replace('I8F_ZERO_CALLBACK_CASES = '+repr(oldliteral['I8F_ZERO_CALLBACK_CASES']),'I8F_ZERO_CALLBACK_CASES = '+repr(zero))
replace("    if variant == 'resource_exact60':resource['observed_utc'] = _f_stamp(now-60)","""    if variant == 'json_depth_before_callback':
        nested = None
        for unused in range(55):nested = [nested]
        resource['depth_probe'] = nested
    if variant == 'resource_exact60':resource['observed_utc'] = _f_stamp(now-60)""")
replace("        if purpose_only:\n            r = module.I8Reader(data['bindings'],data['purpose_support'],reader)","""        if case == 'reader_cap_reuse_conflict':
            r = module.I8Reader(data['bindings'],data['purpose_support'],reader)
            r.body(data['request_pin'],65536)
            r.body(data['request_pin'],2097152)
            raise AssertionError('inconsistent cap reuse must refuse')
        if purpose_only:
            r = module.I8Reader(data['bindings'],data['purpose_support'],reader)""")
replace("                if case in I8F_ZERO_CALLBACK_CASES:_f_check(calls == 0,'protected early refusal before any callback: '+case)","""                if case in I8F_ZERO_CALLBACK_CASES:_f_check(calls == 0,'protected early refusal before any callback: '+case)
                if case == 'reader_cap_reuse_conflict':_f_check(calls == 1,'cap conflict after exactly one external read')""")
fixture=P/'test_current_owner_M3_prewrite_admission_memory_only_003.py'
data=text.encode();ast.parse(data);compile(data,str(fixture),'exec')
fp=save(fixture,data)
api=json.loads(oldapi.read_bytes());now=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
api.update(created_utc=now,fixture_Source=fp,prior_API=pin(oldapi))
api['fixture_interface'].update(expected_case_count=96,planned_case_names=list(names),
 pure_component_cases='purpose_* cases directly test new purpose component; reader_cap_reuse_conflict directly tests new I8Reader using coherent graph; all others use public metadata/refuser route.',
 required_category_additions={'json_depth_before_callback':{'expected_error':'E_JSON_BOUNDS','external_callbacks':0},
                              'reader_cap_reuse_conflict':{'expected_error':'E_CAP_CONFLICT','external_callbacks':1}},
 defensive_limit_coverage='1024 external callbacks and64MiB returned-byte guards are verified in Source only: valid public cached<=256records/32MiB declared state cannot reach them. No runtime coverage claimed.')
api['reader_limits']['defensive_1024_and_64MiB_coverage']='SOURCE_ONLY_UNREACHABLE_IN_VALID_PUBLIC_CACHED_STATE'
ap=save(P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_003.json',api)
prior=json.loads(oldinv.read_bytes())
entries=prior['entries'][:2]
for path in (oldf,oldapi,oldrec,oldinv):
    entries.append(dict(pin=pin(path),encoding='base64',whole_original_bytes=base64.b64encode(path.read_bytes()).decode()))
inverse=dict(prior,created_utc=now,entries=entries,new_fixture=fp,API=ap,new_module=api['module'],
 whole_I0_and_all_prior_Source_inverse_chain_retained=True,prior_inverse=pin(oldinv),prior_002_quartet_uninvoked=True,
 correction_groups=['Two mandatory fixture categories: depth limit and cap-reuse conflict; no module Source change'],
 unchanged_module_Source=api['module'])
ip=save(P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_COMPLETE_PREDECESSOR_INVERSE_003.json',inverse)
receipt=json.loads(oldrec.read_bytes())
receipt.update(created_utc=now,fixture=fp,API=ap,inverse=ip,prior_002_author_receipt=pin(oldrec),
 predecessor_002_outputs=[pin(x) for x in (oldf,oldapi,oldinv,oldrec)],
 actual_module_unchanged=api['module'],fixture_correction='Exactly2 category cases added to existing94 ordered names; no module modification or execution.',
 defensive_limit_coverage=api['fixture_interface']['defensive_limit_coverage'])
receipt['author_programs'].append(pin(Path(__file__)))
receipt['own_static_checks']['planned_fixture_cases']=96
receipt['own_static_checks']['actual_fixture_cases_executed']=0
rp=save(P/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_003.json',receipt)
inspector=(P/'inspect_I8_frozen_Source_002.py').read_text()
inspector=inspector.replace('memory_only_002.py','memory_only_003.py').replace('INERT_API_002.json','INERT_API_003.json').replace('PREDECESSOR_INVERSE_002.json','PREDECESSOR_INVERSE_003.json').replace('AUTHOR_RECEIPT_002.json','AUTHOR_RECEIPT_003.json').replace('INSPECTION_002.json','INSPECTION_003.json').replace("'Literal94 case count'","'Literal96 case count'").replace("==94","==96")
save(P/'inspect_I8_frozen_Source_003.py',inspector.encode())
print(json.dumps(dict(module=api['module'],fixture=fp,API=ap,inverse=ip,receipt=rp,planned_cases=96,target_invocations=0),sort_keys=True))
