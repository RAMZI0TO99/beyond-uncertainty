        inputs[str(p)]=q;raws[str(p)]=b
    return q,b
def pin(q):
    actual,b=fact(q['path'],empty=q['bytes']==0);assert actual==q;return b
def pairs(rows):
    d={}
    for k,v in rows:assert k not in d;d[k]=v
    return d
def bad(v):raise ValueError(v)
