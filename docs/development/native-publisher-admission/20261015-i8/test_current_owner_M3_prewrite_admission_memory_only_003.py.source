    full = dict(schema_version=2,record_type=module.I8_PURPOSE_PROOF['full_record_type'],reviewer='/root/synthetic_purpose_review',
        source_author='/root',created_utc=_f_stamp(40),verdict=module.I8_PURPOSE_PROOF['review_verdict'],subjects=subjects,scope=pp,checks=checks,
        checks_failed=0,target_execution=False,operational_authority=False,native_Parser_executed=False,
        owner_provenance_boundary=module.I8_PURPOSE_PROOF['provenance_boundary'],purpose=purpose,
        subject_reviews=[dict(subject=p,subject_kind='publication_purpose' if i == 0 else 'actual_input',whole_bytes_reviewed=True,provenance_reviewed=True)
                         for i,p in enumerate(subjects)])
    if variant == 'purpose_missing_coverage':full['subject_reviews'].pop()
    if variant == 'purpose_full_time':full['created_utc'] = _f_stamp(41)
    fp = g.add('purpose.full',full,born=41,aux=True)
    capsule = dict(schema_version=2,record_type=module.I8_PURPOSE_PROOF['capsule_record_type'],reviewer=full['reviewer'],source_author='/root',
        created_utc=_f_stamp(40),verdict=module.I8_PURPOSE_PROOF['review_verdict'],subjects=subjects,scope=pp,full_proof=fp,checks_failed=0,
        target_execution=False,operational_authority=False,native_Parser_executed=False,purpose=purpose)
    if variant == 'purpose_capsule_unknown':capsule['unknown'] = False
    rp = g.add('purpose.review',capsule,born=42,aux=True)
    adoption = dict(schema_version=2,record_type=module.I8_PURPOSE_PROOF['adoption_record_type'],author='/root',created_utc=_f_stamp(43),
        verdict=module.I8_PURPOSE_PROOF['adoption_verdict'],subjects=subjects,different_review=rp,full_proof=fp,purpose=purpose,
        target_execution=False,operational_authority=False)
    if variant == 'purpose_root_missing_full':adoption['full_proof'] = pp
    ap = g.add('purpose.adoption',adoption,born=44,aux=True)
    purpose_support = dict(subject=pp,different_review=rp,Root_adoption=ap)
    bindings = dict(owner_support=owner_support,lease_producer_support=producer,continuing_owner=owner_pin,owner_review=owner_review_pin,
        historical_leases=module.I8_HISTORICAL_LEASES,publisher_support=publisher,expected_inputs=inputs,expected_output_paths=outputs,
        recorded_births_ns=dict(g.births),purpose_full_proof=fp)
    resource = dict(observed_utc=_f_stamp(now-1),available_RAM_bytes=1073741824,disk_free_bytes=10737418240)
    if variant == 'json_depth_before_callback':
        nested = None
        for unused in range(55):nested = [nested]
        resource['depth_probe'] = nested
    if variant == 'resource_exact60':resource['observed_utc'] = _f_stamp(now-60)
    if variant == 'resource_age61':resource['observed_utc'] = _f_stamp(now-61)
    if variant == 'resource_bool_RAM':resource['available_RAM_bytes'] = True
    if variant == 'resource_unknown':resource['unknown'] = 0
    if variant == 'birth_after_review':bindings['recorded_births_ns'][candidate['path']] = _f_ns(17)
    if variant == 'birth_wrong_epoch':bindings['recorded_births_ns'][candidate['path']] += module.I8_FILETIME_UNIX_BRIDGE*100
    if variant == 'purpose_input_birth_plus1ns':bindings['recorded_births_ns'][request_pin['path']] = _f_ns(38)+1
    if variant == 'purpose_aux_birth_future':bindings['recorded_births_ns'][ap['path']] = _f_ns(now)+1
    if variant == 'history_wrong_pin':bindings['historical_leases'] = list(reversed(bindings['historical_leases']))
    if variant == 'input_output_alias':
        p = _f_pin(outputs[0],b'x');bindings['expected_inputs'] = sorted(inputs+[p],key=lambda x:x['path'])
        bindings['recorded_births_ns'][p['path']] = _f_ns(1)
    if variant == 'support_output_alias':bindings['publisher_support'] = dict(publisher,Source=_f_pin(outputs[0],b'x'))
    if variant == 'pin_zero':bindings['expected_inputs'][0] = dict(bindings['expected_inputs'][0],bytes=0)
    if variant == 'pin_bool':bindings['expected_inputs'][0] = dict(bindings['expected_inputs'][0],bytes=True)
    if variant == 'pin_overcap':bindings['expected_inputs'][0] = dict(bindings['expected_inputs'][0],bytes=2097153)
    if variant == 'path_case_alias':bindings['expected_inputs'][0] = dict(bindings['expected_inputs'][0],path=bindings['expected_inputs'][0]['path'].replace('D:\\','d:\\'))
    if variant == 'declared_record_count':bindings['expected_inputs'] = inputs+[dict(inputs[0])]*253
    if variant == 'declared_bytes_limit':
        extras = [dict(path='D:\\I8Fixture\\limit\\'+str(i)+'.bin',bytes=2097152,sha256='a'*64) for i in range(17)]
        bindings['expected_inputs'] = sorted(inputs+extras,key=lambda p:p['path'])
        for p in extras:bindings['recorded_births_ns'][p['path']] = _f_ns(1)
    return dict(graph=g,request_pin=request_pin,purpose_support=purpose_support,bindings=bindings,resource=resource,
                now=_f_stamp(now),request=request,roles=[r['role'] for r in request_rows],scope=scope)


def _f_invoke(module,case,*,purpose_only=False):
    data = _f_make(module,case)
    counter = [0]
    def reader(pin):
        counter[0] += 1
        if case == 'callback_mutates_bindings' and counter[0] == 1:
            data['bindings']['expected_output_paths'].clear()
            data['bindings']['owner_support'].clear()
        raw = data['graph'].records[pin['path']]
        if case == 'reader_corrupt_hash' and counter[0] == 1:return raw+b' '
        if case == 'reader_nonbytes' and counter[0] == 1:return bytearray(raw)
        return raw
    root = I8F_ROOT_THREAD if case != 'wrong_expected_thread' else '00000000-0000-0000-0000-000000000000'
    try:
        if case == 'reader_cap_reuse_conflict':
            r = module.I8Reader(data['bindings'],data['purpose_support'],reader)
            r.body(data['request_pin'],65536)
            r.body(data['request_pin'],2097152)
            raise AssertionError('inconsistent cap reuse must refuse')
        if purpose_only:
            r = module.I8Reader(data['bindings'],data['purpose_support'],reader)
            r.source_editor = I8F_EDITOR
            result = module._i8_purpose(r,data['request_pin'],data['request'],data['roles'],data['scope'],module._ticks(data['now'],'fixture now'))
        else:
            result = module.validate_current_owner_M3_prewrite_metadata(request_pin=data['request_pin'],purpose_support=data['purpose_support'],
                trusted_bindings=data['bindings'],read_record=reader,expected_root_thread=root,source_editor=I8F_EDITOR,
                now_utc=data['now'],resource_observation=data['resource'])
    except ValueError as error:
        error.I8_fixture_reader_calls = counter[0]
        raise
    return result,counter[0],data


def run_memory_suite(module):
    cases = []
    case = None
    for case in PLANNED_CASE_NAMES:
        calls = 0
        detail = {}
        if case == 'actual_entry_held_zero_callbacks':
            counter = [0]
            def poison(*args,**kwargs):
                counter[0] += 1
                raise AssertionError('actual entry consulted callback')
            try:module.require_actual_finite8_publication_admission(read_record=poison,qualified=True,fixture=True)
            except ValueError as error:_f_check('E_ACTUAL_PUBLICATION_HELD' in str(error),'public held first')
            else:raise AssertionError('actual entry must refuse')
            _f_check(counter[0] == 0,'held zero callbacks')
        else:
            positive = case in ('positive_template','positive_multirow','positive_detached_immutable','positive_ctime_rename','callback_mutates_bindings','resource_exact60')
            purpose_only = case.startswith('purpose_')
            try:
                view,calls,data = _f_invoke(module,case,purpose_only=purpose_only)
            except ValueError as error:
                if positive:raise
                calls = getattr(error,'I8_fixture_reader_calls',0)
                if case in I8F_EXPECTED_CODES:_f_check(getattr(error,'code',None) == I8F_EXPECTED_CODES[case],'specific refusal branch: '+case)
                if case in I8F_ZERO_CALLBACK_CASES:_f_check(calls == 0,'protected early refusal before any callback: '+case)
                if case == 'reader_cap_reuse_conflict':_f_check(calls == 1,'cap conflict after exactly one external read')
                detail = dict(expected_refusal=True,actual_error_type=type(error).__name__,actual_error=str(error)[:256])
            else:
                _f_check(positive,'required refusal did not occur: '+case)
                record = view.to_dict()
                _f_check(view.metadata_only is True and view.actual_admission is False and view.producer_qualified is False and
                         view.caller_qualified is False and all(record[k] is False for k in module.I8_RESULT_FLAGS if k not in ('metadata_only','frozen_detached')) and
                         record['frozen_detached'] is True,
                         'no semantic result is actual qualification')
                expected = list(module.I8_ROLE_ORDER[:2] if case == 'positive_multirow' else module.I8_ROLE_ORDER[:1])
                _f_check(record['selected_roles'] == expected and record['request'] == data['request_pin'] and
                         record['canonical_lease']['path'].endswith('EXECUTION_LEASE_GG6_M3_900.json') and
                         record['lease_created_utc'].endswith('0000000+00:00') and record['actual_external_reader_calls'] == calls,
                         'exact positive joins/order/UTC7/callback counts')
                _f_check(record['lease_end_utc'] != json.loads(data['graph'].records[data['scope']['path']])['interval_end'],
                         'lease is not owner deadline')
                if case == 'positive_detached_immutable':
                    record['selected_roles'].clear()
                    _f_check(view.to_dict()['selected_roles'] == expected,'detached immutable output')
                detail = dict(selected_roles=expected,metadata_only=True,actual_admission=False,producer_qualified=False,caller_qualified=False,
                              declared_native_birth_age_exceeds60=True,epoch_bridge=module.I8_FILETIME_UNIX_BRIDGE)
        cases.append(dict(name=case,passed=True,synthetic_fixture=True,memory_record_reader_calls=calls,detail=detail))
    _f_check(len(cases) == EXPECTED_CASE_COUNT and tuple(c['name'] for c in cases) == PLANNED_CASE_NAMES,'exact complete planned cases')
    return dict(synthetic_fixture=True,filesystem_calls=0,project_or_native_tests=False,cases=cases,
                checks_passed=len(cases),checks_failed=0,actual_family_publication=False,
                qualification=False,physical_provenance_authenticated=False)
