I8F_COMPOSER_RAW = b'"""UNRUN Root-owned packet producer; it never emits an independent approval."""\nimport argparse\nimport datetime as dt\nimport hashlib\nimport json\nimport os\nimport re\nimport stat\nimport sys\nfrom pathlib import Path\n\nPROJECT=Path(\'D:/Aenv/pro2\')\nWORK=PROJECT/\'resume-2026-10-03-continuation001\'\nOWN=WORK/\'guard006-bound-late-checker-prep001\'\nG=WORK/\'consumer005-guard006-runtime-prep001\'\nM=WORK/\'metadata3-producer-core-prep001\'\nSELF=OWN/\'compose-root-review-packet-012.BOUND.py\'\nBASE=PROJECT/\'runtimes/week8-python313-frozen-001/python.exe\'\nBASE_PIN=\'5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed\'\nSCOPE=\'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY\'\n# This exact model is selected/reviewed before the actual capture timer. It is\n# not supplied by approval bodies or a mutable packet. None refuses entry.\nFRESH_SOURCE_MODEL=None\nMODEL_KEYS=(\'fixed19\',\'source_roles\',\'source_approval_models\',\'core_roles\',\'whole_auth_path\',\'ack_keys\',\'ack_nominals\',\'whole_acceptance_keys\',\'whole_nominals\',\'core12\',\'core_nominals\',\'root_template\',\'driver_sha256\',\'bound_keys\',\'root_trust_selection\')\nPACKET_KEYS=(\'schema_version\',\'record_type\',\'phase\',\'roles\',\'producer_roles\',\'approval_cores\')\nROLES=(\'ack\',\'whole_acceptance\',\'whole_auth\',\'metadata_source_review\',\'metadata_source_binding\',\'metadata_bound_source\',\'metadata_bound_review\',\'metadata_before_review\',\'whole_phase_review\',\'root_writer\',\'root_writer_review\',\'bound_review\',\'root_launcher\')\nPRODUCERS=(\'whole_acceptance\',\'metadata_source_review\',\'whole_phase_review\',\'metadata_before_review\',\'root_writer_review\')\nCORES=(\'metadata_source_review\',\'metadata_before_review\',\'whole_phase_review\',\'root_writer_review\')\nFIXED19=(\'profile\',\'driver\',\'driver_template\',\'observer\',\'observer_template\',\'static\',\'source_peer\',\'source_manifest\',\'owner\',\'root_template\',\'bound_template\',\'late_template\',\'root_writer_before\',\'root_writer\',\'metadata_template\',\'metadata_manifest\',\'metadata_binding_plan\',\'pro3_coord\',\'root_coord\')\nCORE12=(\'schema_version\',\'record_type\',\'reviewer\',\'created_utc\',\'verdict\',\'input_sha256\',\'context_sha256\',\'runtime_snapshot_sha256\',\'parent_terminal_sha256\',\'metadata_only\',\'operational_authority_granted\',\'evidence_sha256\')\nSEEN={}\n\ndef require(value,reason):\n    if not value:raise ValueError(reason)\ndef sha(data):return hashlib.sha256(data).hexdigest()\ndef wire(value):return(json.dumps(value,sort_keys=True,separators=(\',\',\':\'),ensure_ascii=True,allow_nan=False)+\'\\n\').encode(\'ascii\')\ndef exact(value,keys,reason):require(type(value)is dict and set(value)==set(keys),reason)\ndef nominal(value,expected,reason):\n    require(type(value)is type(expected),reason+\' nominal type\')\n    if type(expected)is dict:\n        exact(value,expected,reason)\n        for key in expected:nominal(value[key],expected[key],reason+\'.\'+key)\n    elif type(expected)in(list,tuple):\n        require(len(value)==len(expected),reason+\' fixed length\')\n        for item,wanted in zip(value,expected):nominal(item,wanted,reason)\n    else:require(value==expected,reason+\' literal\')\ndef pin(value):require(type(value)is str and re.fullmatch(\'[0-9a-f]{64}\',value),\'external SHA256\');return value\ndef confined(value):\n    require(type(value)is str,\'nominal source path\');p=Path(value)\n    require(p.is_absolute()and p.is_relative_to(PROJECT)and \'..\'not in p.parts and all(\':\'not in x for x in p.parts[1:]),\'confined project path\')\n    return p\ndef raw(info):\n    value=[getattr(info,key,None)for key in(\'st_dev\',\'st_ino\',\'st_size\',\'st_mtime_ns\',\'st_ctime_ns\',\'st_mode\',\'st_nlink\',\'st_file_attributes\',\'st_birthtime_ns\')]\n    require(all(type(x)is int for x in value),\'exact Windows raw9\');return value\ndef parents(p):\n    rows=[]\n    for parent in reversed(p.parents):\n        s=parent.lstat();require(stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&0x400,\'plain ancestors\');rows.append((str(parent),s.st_dev,s.st_ino))\n    return rows\ndef read(p,expected=None,maximum=65536):\n    p=confined(str(p));require(type(maximum)is int and 0<maximum<=8388608,\'bounded metadata reader\')\n    ancestors=parents(p);a=p.lstat();ar=raw(a)\n    require(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&0x400 and 0<=a.st_size<=maximum,\'bounded single-link metadata file\')\n    require(a.st_ctime_ns==a.st_birthtime_ns,\'Windows path creation\')\n    fd=os.open(p,os.O_RDONLY|os.O_BINARY);parts=[];count=0\n    try:\n        b=os.fstat(fd);br=raw(b)\n        require(stat.S_ISREG(b.st_mode)and b.st_nlink==1 and not b.st_file_attributes&0x400,\'owned read handle\')\n        require(all(ar[i]==br[i]for i in(0,1,2,3,6,7,8)),\'cross API identity\')\n        if ar[5]!=br[5]:require(p==BASE and expected==BASE_PIN and a.st_size==105816 and ar[5]&0o111==0o111 and br[5]&0o111==0 and ar[5]&~0o111==br[5],\'exact BASE executable mode projection\')\n        while True:\n            part=os.read(fd,min(1048576,maximum+1-count))\n            if not part:break\n            count+=len(part);require(count<=maximum,\'read cap\');parts.append(part)\n        require(raw(os.fstat(fd))==br,\'descriptor raw9 stable\')\n    finally:os.close(fd)\n    require(raw(p.lstat())==ar and parents(p)==ancestors,\'path/raw9/ancestor stable\')\n    data=b\'\'.join(parts);require(len(data)==a.st_size and(expected is None or sha(data)==pin(expected)),\'size/SHA pin\')\n    observation={\'sha256\':sha(data),\'bytes\':len(data),\'path_raw9\':ar,\'descriptor_raw9\':br}\n    require(str(p)not in SEEN or SEEN[str(p)]==observation,\'input reobserved unchanged\');SEEN[str(p)]=observation\n    return data\ndef unique(rows):\n    out={}\n    for key,value in rows:require(key not in out,\'duplicate JSON key\');out[key]=value\n    return out\ndef reject_number(unused):raise ValueError(\'float/nonfinite metadata forbidden\')\ndef decode(data):return json.loads(data.decode(\'utf-8\',\'strict\'),object_pairs_hook=unique,parse_float=reject_number,parse_constant=reject_number)\ndef record(p,expected,maximum=65536):return decode(read(p,expected,maximum))\ndef pointer(row):exact(row,(\'path\',\'sha256\'),\'closed pointer2\');return confined(row[\'path\']),pin(row[\'sha256\'])\ndef absent(p):\n    parents(p)\n    try:p.lstat()\n    except FileNotFoundError:return\n    raise ValueError(\'create-once metadata path already exists\')\ndef publish_once(p,value):\n    data=wire(value);require(len(data)<=65536,\'finite packet output\');absent(p)\n    fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_BINARY,0o600)\n    with os.fdopen(fd,\'wb\')as f:f.write(data);f.flush();os.fsync(f.fileno())\n    nominal(read(p,sha(data)),data,\'full packet readback\')\n    return {\'path\':str(p),\'sha256\':sha(data)}\ndef atomic_ready(p,value):\n    # Windows rename refuses an existing destination. The owned temporary is\n    # preserved on refusal; no replacement, removal, replay or cleanup occurs.\n    require(os.name==\'nt\',\'Windows create-once rename semantics\')\n    absent(p);temporary=p.with_name(p.name+\'.publishing\');row=publish_once(temporary,value)\n    absent(p);os.rename(temporary,p);read(p,row[\'sha256\'])\n    return {\'path\':str(p),\'sha256\':row[\'sha256\']}\ndef genuine_ticks(value,width):\n    require(type(value)is str and re.fullmatch(r\'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{\'+str(width)+r\'}\\+00:00\',value),\'genuine producer timestamp\')\n    base=dt.datetime.strptime(value[:19],\'%Y-%m-%dT%H:%M:%S\').replace(tzinfo=dt.timezone.utc);d=base-dt.datetime(1970,1,1,tzinfo=dt.timezone.utc)\n    return(d.days*86400+d.seconds)*10000000+int(value[20:20+width])*(10 if width==6 else 1)\ndef fresh(value,width,seconds):\n    now=genuine_ticks(dt.datetime.now(dt.timezone.utc).isoformat(timespec=\'microseconds\'),6);age=now-genuine_ticks(value,width)\n    require(0<=age<=seconds*10000000,\'original freshness\');return now\n\ndef main():\n    parser=argparse.ArgumentParser()\n    for name in(\'expected-self-sha256\',\'phase\',\'ack-sha256\',\'whole-acceptance-sha256\',\'whole-auth-sha256\',\'metadata-core-sha256\',\'whole-core-sha256\'):\n        parser.add_argument(\'--\'+name,required=True)\n    parser.add_argument(\'--bound-review-sha256\');parser.add_argument(\'--root-launcher-sha256\')\n    args=parser.parse_args()\n    require(os.name==\'nt\'and sys.version_info[:3]==(3,13,5)and sys.flags.isolated==1 and sys.flags.no_site==1 and sys.flags.dont_write_bytecode==1 and sys.flags.utf8_mode==1 and sys.flags.optimize==0,\'Root direct isolated own metadata process\')\n    nominal(Path(sys.executable).absolute(),BASE,\'direct BASE\');read(BASE,BASE_PIN,105816)\n    nominal(Path(__file__).absolute(),SELF,\'bound Root own producer\');read(SELF,pin(args.expected_self_sha256),131072)\n    exact(FRESH_SOURCE_MODEL,MODEL_KEYS,\'unbound fresh source model\')\n    require(args.phase in(\'bound\',\'late\'),\'closed phase\')\n    exact(FRESH_SOURCE_MODEL[\'fixed19\'],FIXED19,\'fresh nineteen Source roles\')\n    nominal(FRESH_SOURCE_MODEL[\'core12\'],list(CORE12),\'unaltered Core12 protocol\')\n    for row in FRESH_SOURCE_MODEL[\'fixed19\'].values():\n        exact(row,(\'path\',\'sha256\',\'maximum\'),\'fixed Source row3\')\n        read(confined(row[\'path\']),pin(row[\'sha256\']),row[\'maximum\'])\n    trust=FRESH_SOURCE_MODEL[\'root_trust_selection\'];record(*pointer(trust))\n    roles=dict(FRESH_SOURCE_MODEL[\'source_roles\'])\n    roles.update(ack={\'path\':str(G/\'ROOT_EXECUTION_ACK_GUARD_UNIT006_002.json\'),\'sha256\':pin(args.ack_sha256)},whole_acceptance={\'path\':str(G/\'INDEPENDENT_WHOLE_BEFORE_ACCEPTANCE_007.json\'),\'sha256\':pin(args.whole_acceptance_sha256)},whole_auth={\'path\':FRESH_SOURCE_MODEL[\'whole_auth_path\'],\'sha256\':pin(args.whole_auth_sha256)},metadata_before_review={\'path\':FRESH_SOURCE_MODEL[\'core_roles\'][\'metadata_before_review\'],\'sha256\':pin(args.metadata_core_sha256)},whole_phase_review={\'path\':FRESH_SOURCE_MODEL[\'core_roles\'][\'whole_phase_review\'],\'sha256\':pin(args.whole_core_sha256)},bound_review=None,root_launcher=None)\n    exact(roles,ROLES,\'fresh fixed roles13\')\n    ack=record(*pointer(roles[\'ack\']));exact(ack,FRESH_SOURCE_MODEL[\'ack_keys\'],\'ACK22\');require(len(ack)==22,\'ACK22 count\')\n    for key,value in FRESH_SOURCE_MODEL[\'ack_nominals\'].items():nominal(ack[key],value,\'actual ACK nominal\')\n    context,runtime=pointer(ack[\'runtime_snapshot\']);rt=record(context,runtime)\n    fresh(rt[\'captured_utc\'],6,90);cp,cs=pointer(rt[\'context_selection\']);ctx=record(cp,cs,1048576);now=fresh(ctx[\'captured_utc\'],6,90)\n    require(now+5100000000<=genuine_ticks(ack[\'expires_utc\'],7),\'ACK510 reserve\')\n    rp,rs=pointer(ack[\'resource_snapshot\']);res=record(rp,rs);fresh(res[\'captured_utc\'],7,60)\n    require(type(res[\'free_ram_bytes\'])is int and res[\'free_ram_bytes\']>=1073741824 and type(res[\'disk_free_bytes\'])is int and res[\'disk_free_bytes\']>=10737418240,\'resource floor snapshot\')\n    whole=record(*pointer(roles[\'whole_acceptance\']));exact(whole,FRESH_SOURCE_MODEL[\'whole_acceptance_keys\'],\'whole acceptance7\')\n    for key,value in FRESH_SOURCE_MODEL[\'whole_nominals\'].items():nominal(whole[key],value,\'different whole acceptance\')\n    nominal(whole[\'runtime_snapshot_sha256\'],runtime,\'whole original runtime\')\n    approvals={}\n    for role in CORES:\n        approval=record(*pointer(roles[role]),maximum=2097152)\n        if role in(\'metadata_source_review\',\'root_writer_review\'):\n            model=FRESH_SOURCE_MODEL[\'source_approval_models\'][role]\n            exact(approval,model[\'keys\'],\'source approval closed schema\')\n            for key,value in model[\'values\'].items():nominal(approval[key],value,\'source-bound approval field\')\n            approvals[role]=model\n        else:\n            exact(approval,CORE12,\'actual Core12\')\n            for key,value in FRESH_SOURCE_MODEL[\'core_nominals\'][role].items():nominal(approval[key],value,\'actual independent metadata decision\')\n            nominal(approval[\'runtime_snapshot_sha256\'],runtime,\'core actual runtime\');nominal(approval[\'context_sha256\'],cs,\'core actual original context\')\n            require(approval[\'reviewer\']==\'/root/actual_record_checker\'and approval[\'metadata_only\']is True and approval[\'operational_authority_granted\']is False,\'different genuine metadata scope\')\n            # The independent retained BOUND/LATE checker will fully reobserve\n            # Core/detail/input/parent/Source closure. Root merely creates this\n            # closed packet; it does not approve metadata or waive those checks.\n            approvals[role]={\'keys\':list(FRESH_SOURCE_MODEL[\'core12\']),\'values\':approval}\n    packet={\'schema_version\':1,\'record_type\':\'root_selected_gg6_actual_record_review_001\',\'phase\':args.phase,\'roles\':roles,\'producer_roles\':{role:\'python6\'for role in PRODUCERS},\'approval_cores\':approvals}\n    if args.phase==\'late\':\n        roles[\'bound_review\']={\'path\':str(G/\'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json\'),\'sha256\':pin(args.bound_review_sha256)}\n        template_path,template_pin=pointer(FRESH_SOURCE_MODEL[\'root_template\'])\n        require(template_path.parent==G and template_path.name.startswith(\'ROOT_FIRST_LAUNCH_006-rev\')and template_path.name.endswith(\'.TEMPLATE.ps1\'),\'selected fresh Root launcher template\')\n        roles[\'root_launcher\']={\'path\':str(template_path.with_name(template_path.name.replace(\'.TEMPLATE.ps1\',\'.BOUND.ps1\'))),\'sha256\':pin(args.root_launcher_sha256)}\n        bound=record(*pointer(roles[\'bound_review\']));exact(bound,FRESH_SOURCE_MODEL[\'bound_keys\'],\'BOUND22\')\n        nominal(bound[\'root_ack_sha256\'],args.ack_sha256,\'bound ACK\');nominal(bound[\'reviewer\'],\'/root/pubnative_review\',\'different bound reviewer\')\n        launch=read(*pointer(roles[\'root_launcher\'])).decode(\'utf-8\',\'strict\')\n        for name,value in((\'BoundDriverSha256\',FRESH_SOURCE_MODEL[\'driver_sha256\']),(\'RootAckSha256\',args.ack_sha256),(\'BoundReviewSha256\',args.bound_review_sha256)):\n            pattern=r"(?m)^\\$"+name+r" = \'[0-9a-f]{64}\'\\r?$";rows=re.findall(pattern,launch)\n            require(len(rows)==1 and rows[0].rstrip(\'\\r\')=="$"+name+" = \'"+value+"\'",\'Root three-literal exact binding\')\n            launch=re.sub(pattern,lambda match,n=name:\'$\'+n+\' = $null\'+(\'\\r\'if match.group().endswith(\'\\r\')else\'\'),launch)\n        nominal(launch.encode(),read(template_path,template_pin),\'Root three-literal reversal\')\n    for p,observed in list(SEEN.items()):read(Path(p),observed[\'sha256\'],max(1,observed[\'bytes\']))\n    fresh(rt[\'captured_utc\'],6,90);fresh(ctx[\'captured_utc\'],6,90);fresh(res[\'captured_utc\'],7,60)\n    phase=args.phase.upper();output=OWN/(\'ROOT_SELECTED_\'+phase+\'_PACKET_\'+(\'007\' if phase==\'BOUND\' else \'006\')+\'.json\');row=publish_once(output,packet)\n    marker=atomic_ready(OWN/(\'ROOT_SELECTED_\'+phase+\'_PACKET_READY_\'+(\'007\' if phase==\'BOUND\' else \'006\')+\'.json\'),{\'schema_version\':1,\'record_type\':\'root_guard006_packet_ready\',\'author\':\'/root\',\'phase\':args.phase,\'packet\':row,\'target_execution\':False})\n    print(json.dumps({\'packet\':row,\'ready\':marker,\'target_execution\':False,\'operational_authority\':False},sort_keys=True))\n\nif __name__==\'__main__\':main()\n'

"""Synthetic in-memory graph suite for newly authored I8 only. No filesystem IO.

The historical raw constants are inert exact bytes. All new authority-shaped
records are synthetic nested memory data, never grants or actual output files.
"""
import json
import hashlib
import datetime as I8F_dt
import re


def _f_check(condition, message):
    if not condition:
        raise AssertionError(message)


def _f_stamp(seconds, native=False):
    value = I8F_dt.datetime(2026,10,15,18,tzinfo=I8F_dt.timezone.utc)+I8F_dt.timedelta(seconds=seconds)
    text = value.isoformat(timespec='microseconds')
    return text.replace('+00:00','0+00:00') if native else text


def _f_ns(seconds):
    base = I8F_dt.datetime(2026,10,15,18,tzinfo=I8F_dt.timezone.utc)
    epoch = I8F_dt.datetime(1970,1,1,tzinfo=I8F_dt.timezone.utc)
    delta = base-epoch
    return (delta.days*86400+delta.seconds+seconds)*1000000000


def _f_wire(value):
    return (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf-8')


def _f_pin(path, raw):
    return dict(path=path,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def _f_read12(pin, observed, *, birth, identity=200, links=1):
    vector = [7,identity,pin['bytes'],_f_ns(observed),_f_ns(observed),33188,links,32,_f_ns(birth)]
    descriptor = list(vector);descriptor[4] += 100
    shared = [0,1,2,3,6,7,8]
    return dict(pin,cap=65536,raw9=vector,path9=list(vector),descriptor9=descriptor,
        shared_identity_indexes=shared,shared_descriptor7=[descriptor[i] for i in shared],
        both_full_API9_independently_stable=True,two_read_match=True,observed_utc=_f_stamp(observed))


def _f_creation2(pin, observed, *, birth, identity):
    canonical = _f_read12(pin,observed,birth=birth,identity=identity)
    staging = dict(canonical,path=pin['path']+'.staging')
    staging['raw9'] = list(canonical['raw9']);staging['raw9'][4] -= 100
    staging['path9'] = list(staging['raw9'])
    staging['descriptor9'] = list(canonical['descriptor9']);staging['descriptor9'][4] -= 100
    staging['shared_descriptor7'] = list(canonical['shared_descriptor7'])
    return dict(staging=staging,canonical=canonical)


def _f_image7(pin):
    record = _f_read12(pin,11,birth=0,identity=300,links=2)
    return dict(Source=pin,path9=record['path9'],descriptor9=record['descriptor9'],cap=2097152,
        actual_link_count=2,shared_identity_indexes=[0,1,2,3,6,7,8],ordinary_Source_single_link_reader_unchanged=True)


class I8FixtureGraph:
    def __init__(self):
        self.records = {}
        self.pins = {}
        self.births = {}
        self.inputs = set()
    def add(self,name,value=None,*,raw=None,path=None,born=0,aux=False):
        path = path or 'D:\\I8Fixture\\metadata\\'+name+'.json'
        raw = _f_wire(value) if raw is None else raw
        _f_check(path not in self.records,'fixture path unique')
        pin = _f_pin(path,raw)
        self.records[path] = raw;self.pins[path] = pin;self.births[path] = _f_ns(born)
        if not aux:self.inputs.add(path)
        return pin
    def proof(self,name,subjects,created,*,scope=None,selection=None,full_created=None,editor='/root/synthetic_review',
              full_drop=None,drop_adoption_full=False,grant_marker=False):
        full_subjects = subjects if full_drop is None else subjects[:full_drop]
        verdict = 'PASS_SYNTHETIC_COMPATIBLE_SOURCE_ONLY'
        full = dict(reviewer=editor,created_utc=_f_stamp(created if full_created is None else full_created),verdict=verdict,
                    subjects=full_subjects,checks_failed=0,target_execution=False,operational_authority=False,
                    checks=[dict(name='synthetic bounded whole bytes',passed=True,extra_metadata='open ABI retained')])
        fp = self.add(name+'.full',full,born=created+1)
        capsule = dict(reviewer=editor,created_utc=_f_stamp(created),verdict=verdict,subjects=subjects,
                       checks_failed=0,target_execution=False,operational_authority=False,full_proof=fp,
                       compatible_non_I0_open_metadata=True)
        rp = self.add(name+'.review',capsule,born=created+1)
        adoption = dict(author='/root',created_utc=_f_stamp(created+2),verdict='ACCEPT_SYNTHETIC_SOURCE_ONLY',
                        subjects=subjects,different_review=rp,target_execution=False,operational_authority=False)
        if not drop_adoption_full:adoption['full_proof'] = fp
        if scope is not None:adoption['current_owner_scope'] = scope
        if selection is not None:adoption['selection'] = selection
        if grant_marker:adoption['implementation_scope_or_purpose_admission_granted'] = False
        ap = self.add(name+'.adoption',adoption,born=created+2)
        return dict(different_review=rp,Root_adoption=ap),full,capsule,adoption


def _f_owner(module,g,variant,now):
    root = I8F_ROOT_THREAD
    instruction = dict(schema_version=2,record_type='Root_retained_owner_instruction_witness_v2',author='/root',Root_thread=root,
        created_utc=_f_stamp(1),human_message_observed_utc=_f_stamp(0),human_message_reference='synthetic retained instruction',
        exact_text='synthetic memory instruction\nwith retained whitespace\t',attribution='DIRECT_USER_MESSAGE_RETAINED_BY_ROOT')
    policy = dict(instruction,record_type='Root_retained_owner_resource_policy_witness_v2',exact_text='synthetic policy; no Pro3 coordination')
    if variant == 'owner_witness_thread':instruction['Root_thread'] = '00000000-0000-0000-0000-000000000000'
    ip = g.add('owner.instruction',instruction);pp = g.add('owner.policy',policy)
