def fact(p):
 p=Path(p);b=p.read_bytes();assert 0<len(b)<=CAP
 q=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if str(p) in inputs:assert inputs[str(p)]==q and raws[str(p)]==b
 inputs[str(p)]=q;raws[str(p)]=b;return q
def pin(q):
 assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
 assert fact(q['path'])==q;return raws[q['path']]
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(x):raise ValueError(x)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def doc(p):q=fact(p);return q,obj(pin(q))
def ck(name,value,evidence):
 assert type(value) is bool and name not in {c['name'] for c in checks}
 checks.append(dict(name=name,passed=value,evidence=evidence))
def constants(t):
 out={}
 for n in t.body:
  if isinstance(n,ast.Assign):
   try:v=ast.literal_eval(n.value)
   except (ValueError,TypeError,SyntaxError):continue
   for a in n.targets:
    if isinstance(a,ast.Name):assert a.id not in out;out[a.id]=v
 return out
def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def segment(raw,n):return ast.get_source_segment(raw.decode(),n)
def walkpins(v):
 if type(v) is dict:
