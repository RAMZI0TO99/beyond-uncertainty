def fact(p):raw(p);return INPUTS[str(Path(p))]
def obj(p):return json.loads(raw(p))

def literal(n):
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('frozenset','set','tuple') and len(n.args)==1:
        value=ast.literal_eval(n.args[0]);return tuple(value) if n.func.id=='tuple' else sorted(value)
    value=ast.literal_eval(n)
    return sorted(value) if type(value) is set else value

def inspect(p):
    b=raw(p);tree=ast.parse(b,filename=str(p));lines=b.splitlines(keepends=True);functions={};constants={}
    for n in tree.body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            try:constants[n.targets[0].id]=literal(n.value)
            except (ValueError,TypeError):pass
        if isinstance(n,ast.FunctionDef):
            region=b''.join(lines[n.lineno-1:n.end_lineno]);functions[n.name]=(n,region)
    return functions,constants

