inputs={};raws={};checks=[]
def fact(path):
    path=Path(path);raw=path.read_bytes();assert 0<len(raw)<=CAP
    q=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    if q['path'] in inputs:assert inputs[q['path']]==q and raws[q['path']]==raw
    inputs[q['path']]=q;raws[q['path']]=raw;return q
def pin(q):
    assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int
    assert fact(q['path'])==q;return raws[q['path']]
def pairs(rows):
    d={}
    for k,v in rows:assert k not in d;d[k]=v
    return d
def bad(value):raise ValueError('noninteger JSON number')
def decode(raw):return json.loads(raw,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def doc(path):
    q=fact(path);return decode(raws[q['path']])
def ck(name,passed,evidence):
    assert type(passed) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name,passed=passed,evidence=evidence))
def literals(tree):
    d={}
    for n in tree.body:
        if isinstance(n,ast.Assign):
            v=n.value
            if isinstance(v,ast.Call) and isinstance(v.func,ast.Name) and v.func.id in ('set','frozenset') and len(v.args)==1:v=v.args[0]
            try:x=ast.literal_eval(v)
            except (ValueError,TypeError,SyntaxError):continue
            for a in n.targets:
                if isinstance(a,ast.Name):d[a.id]=x
    return d
def defs(tree):return {n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def source(raw,node):
    start=min([node.lineno]+[d.lineno for d in node.decorator_list]);return b''.join(raw.splitlines(keepends=True)[start-1:node.end_lineno])
def region_inventory(rows,raw,label,evidence):
    tree=ast.parse(raw);nodes=defs(tree)
    for r in rows:
        n=nodes[r['name']];body=source(raw,n)
        ck(label+'_'+r['name'],len(body)==r['bytes'] and hashlib.sha256(body).hexdigest()==r['sha256'] and min([n.lineno]+[d.lineno for d in n.decorator_list])==r['first_line'] and n.end_lineno==r['last_line'] and type(n).__name__==r['kind'],evidence)
def local_calls(raw,label,p):
    tree=ast.parse(raw);fs={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)};count=0
    for n in ast.walk(tree):
        if not(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in fs):continue
        if any(isinstance(a,ast.Starred) for a in n.args) or any(k.arg is None for k in n.keywords):continue
        a=fs[n.func.id].args;pos=a.posonlyargs+a.args;names=[x.arg for x in pos];got={k.arg for k in n.keywords};assigned=set(names[:len(n.args)])
        missing=set(names[:len(pos)-len(a.defaults)])-assigned-got;missing_kw={x.arg for x,d in zip(a.kwonlyargs,a.kw_defaults) if d is None}-got
        unknown=got-set(names)-{x.arg for x in a.kwonlyargs}
        good=not missing and not missing_kw and not(assigned&got) and (len(n.args)<=len(pos) or a.vararg is not None) and (not unknown or a.kwarg is not None)
        ck(label+'_call_%04d_%03d_%s'%(n.lineno,n.col_offset,n.func.id),bool(good),[p]);count+=1
    return count

