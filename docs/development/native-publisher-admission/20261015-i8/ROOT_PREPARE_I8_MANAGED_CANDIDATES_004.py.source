"""Prepare finite I8 inert Source/evidence copies, without invoking project code."""
import datetime,hashlib,json,os
from pathlib import Path
R=Path(r'D:\Aenv\pro2');P=R/'WORK/resume-20261015-001/native_publisher_admission_011';G=R/'github-portable-20261012-001';C=R/'WORK/I8P011/c1';CAP=2097152
REL='docs/development/native-publisher-admission/20261015-i8/'
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def save(p,x):
 p=Path(p);b=x if type(x) is bytes else (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
 return fact(p)
def main():
 adoptionpin=fact(P/'ROOT_I8_PREWRITE_OWNER_LEASE_PURPOSE_AND_SAVED_MEMORY_RESULTS_ADOPTION_001.json');a=json.loads(pin(adoptionpin))
 assert a['author']=='/root' and a['verdict']=='ACCEPT_I8_PREWRITE_OWNER_LEASE_PURPOSE_AND_SAVED_MEMORY_RESULTS_ONLY'
 assert type(a['I8_memory_test_runs']) is int and a['I8_memory_test_runs']==2 and a['accepted_complete_memory_test_runs']==1 and a['failed_memory_test_runs']==1 and a['tests_executed'] is True and a['original_project_native_Parser_runtime_scientific_execution'] is False
 assert type(a['actual_memory_case_count']) is int and a['actual_memory_case_count']>0 and a['actual_memory_cases_passed']==a['actual_memory_case_count']
 scopepin=fact(P/'ROOT_CURRENT_I8_PREWRITE_ADMISSION_SOURCE_SCOPE_001.json');s=json.loads(pin(scopepin));assert scopepin['sha256']=='7eb47554ec7c5aa1579dcf3b864744e9e551661f3ba176a2b5f093300038bb44'
 assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(s['interval_end'])
 previouspin=s['prior_finite_managed_scope'];assert previouspin['sha256']=='50e2375f4707136680f3cb49cc775db677253e5203be04d5d6c29d2c847a04e1';previous=json.loads(pin(previouspin))
 rows=[];evidence=[];seen=set();prior=[]
 for row in previous['files']:
  q=dict(path=str(G/row['managed_path']),bytes=row['source']['bytes'],sha256=row['source']['sha256']);pin(q)
  if row['mode']=='create':prior.append(q)
 prior=previous['all_prior_I6_non_navigation_file_pins']+prior
 assert len(prior)==167 and len({q['path'] for q in prior})==167
 for q in prior:pin(q)
 def add(name,b):
  relative=REL+name;assert relative not in seen and not (G/relative).exists() and len(str(G/relative))<260;seen.add(relative)
  q=save(C/relative,b);rows.append(dict(managed_path=relative,mode='create',source=q));return q
 inputs=a['managed_evidence_inputs']+[adoptionpin];assert len({q['path'] for q in inputs})==len(inputs)
 for q in inputs:
  path=Path(q['path']);assert path.resolve().is_relative_to(P.resolve());inert=path.suffix in ('.py','.ps1');name=path.name+('.source' if inert else '')
  assert Path(name).suffix in ('.json','.source');copied=add(name,pin(q));evidence.append(dict(original=q,managed_path=REL+name,copied_bytes=copied['bytes'],copied_sha256=copied['sha256'],inert_Source_copy=inert))
 add('evidence-index.json',dict(schema_version=1,record_type='I8_exact_prewrite_owner_lease_purpose_Source_and_synthetic_memory_evidence_index',files=evidence,actual_evidence_copy_count=len(evidence),actual_new_I8_synthetic_memory_tests=True,original_publisher_I0_I1_I2_I3_I4_I5_I6_I7_import_call_test_execution=False,real_selected45_Source_publication=False,actual_lease_family_Native8_Parser_results=None,dated_Source_present=36,dated_Source_pending=9,frozen_STEP080_present=35,frozen_STEP080_pending=10,absolute_paths_are_dated_provenance_not_runtime_bindings=True))
 count=a['actual_memory_case_count'];checks=a['actual_independent_saved_results_checks']
 report=(f'# Current-owner prewrite metadata guards\n\nThe new owner, existing-lease and Source-publication-purpose preflight passed {count}/{count} synthetic memory cases in the second separately scoped run. The first run stopped on its initial positive case with E_PHASE_ORDINAL and zero completed cases; its saved failure and consumed scope are preserved. Two suite invocations occurred in total, with one accepted complete run. The new I8 guard now accepts exact inherited .TEMPLATE/.BOUND phase basenames while preserving the ordinal and lineage predicates; held I2 remains unchanged. Independent saved-results review passed {checks} checks without rerunning the fixture. The [Root adoption](ROOT_I8_PREWRITE_OWNER_LEASE_PURPOSE_AND_SAVED_MEMORY_RESULTS_ADOPTION_001.json) and [evidence index](evidence-index.json) pin the Source, tests and saved results.\n\nThe module retains the whole accepted I0 pure validator as an exact prefix. It checks owner identity and policy, the existing canonical lease chain, native UTC7 declarations and exact 43,200-second M3 duration, request/subset and draft hashes, and a separate Source-publication Purpose12. I1 lease reviews retain their own semantic ABI. Owner remaining time stays strictly above 60 seconds and lease remaining time strictly above 1,200 seconds. Integer FILETIME and Unix birth comparisons retain their declared epochs and precision. The metadata validator collects no native timestamps.\n\nThe purpose follows the exact request and binds its finite supplied-byte input set and future output path strings. Its separate review14, full proof16 and Root adoption11 directly cover the purpose and all declared inputs. Future output paths are protected before the first reader callback. Record counts, declared bytes, callback count and returned bytes have explicit limits; per-role caps remain unchanged. Callback byte hashing permits declared Source/code and draft buffers and proves no physical origin.\n\nThe returned view is frozen and detached, with metadata-only true and actual admission, producer qualification, caller qualification and physical/human/native provenance false. The real publication entry refuses before IO. Existing I0-I7 Sources and holds remain unchanged; copied I0 predicates were exercised only inside the new I8 module. No existing helper, native collector, Parser, renderer, runtime or scientific program was invoked. No real grant, lease, purpose or selected family was issued.\n\nThe new component checks the recorded owner/lease/purpose layer. Full M3 receipt22/facts21/render/inverse semantics, qualified I1/I2 producer successors and actual caller/IO bindings remain required before real publishing. The request actual45 catalogue, selection historical45 lineage and M3 inventory17 remain separate. Static I1 historical-time-format and I6 inventory-domain assumptions remain qualification findings; existing Sources were preserved and no actual failure or repair is claimed. Native8 support and Parser saved-result adaptation remain later work.\n\nThe dated Source family remains36/45 with nine pending; frozen STEP080 remains35/45 with ten pending. All75 spent identities and original caps, clocks and reserves remain unchanged. Historical608 file bytes, eight sentinels, current36 Sources, prior77 I6 and90 I7 published files and three complete navigation suffixes are preserved.\n\nPrograms are copied with inert `.source` suffixes. Absolute paths remain dated provenance. Root publication receipts and Git history record the later normal commit and push.\n').encode()
 add('I8_PREWRITE_OWNER_LEASE_PURPOSE.md',report)
 prefix=('**October15 I8 prewrite metadata guards tested.** The [owner/lease/purpose checkpoint]('+REL+'I8_PREWRITE_OWNER_LEASE_PURPOSE.md) records the tested pure owner, existing-lease and separate Source-publication-purpose checks. Full M3 producer semantics and actual caller/IO qualification remain pending; real publication stays held. Source remains36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n').encode()
 for name in ('CONTINUE.md','AGENTS.md','README.md'):
  predecessor=fact(G/name);old=pin(predecessor);saved=save(P/'managed_preparation_001/predecessors_001'/name,old);source=save(C/name,prefix+old);rows.append(dict(managed_path=name,mode='prepend',source=source,predecessor=predecessor,saved_predecessor=saved,prefix_bytes=len(prefix)))
 out=dict(schema_version=1,record_type='Root_exact_finite_I8_prewrite_metadata_and_saved_memory_managed_publication_scope',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),base_HEAD=s['managed_base_HEAD'],files=rows,managed_file_count=len(rows),Root_implementation_adoption=adoptionpin,preexisting608_byte_baseline=previous['preexisting608_byte_baseline'],all_frozen_STEP080_sentinels=previous['all_frozen_STEP080_sentinels'],current36_Source_baseline=previous['current36_Source_baseline'],all_prior_I6_I7_non_navigation_file_pins=prior,target_execution=False,tests_executed=True,I8_memory_test_runs=2,accepted_complete_memory_test_runs=1,failed_memory_test_runs=1,prior_failed_attempt=a['prior_failed_attempt'],original_project_target_execution=False)
 print(json.dumps(save(P/'managed_preparation_001/candidates_001/EXACT_MANAGED_I8_PREWRITE_METADATA_IMPLEMENTATION_PUBLICATION_SCOPE_001.json',out)))
if __name__=='__main__':main()
