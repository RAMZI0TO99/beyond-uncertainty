OWN = P / 'independent_review_001'
CAP = 2097152
REVIEWER = '/root/owner_source_review'
PROTO = 'ROOT_I8_EXACT_PREWRITE_OWNER_LEASE_PURPOSE_IMPLEMENTATION_PROTOCOL_001.json'
BIRTH = 'ROOT_I8_PROTOCOL001_BIRTH_FIELD_AND_PURPOSE_PROOF_CLOSURE_CLARIFICATION_001.json'
