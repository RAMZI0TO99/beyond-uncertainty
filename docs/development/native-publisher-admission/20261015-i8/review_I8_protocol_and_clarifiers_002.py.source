EXPECTED = {
    PROTO: (58128, '0171e81f315adfced2c8e783eb272aae04f924227a5c2a367a343fdf8d3b388b'),
    BIRTH: (1931, '81f36f5417d07083ac783f53bf7d70906a7851c77d0cffc4c6aa980d9d9250de'),
    LIMITS: (1641, '155f8e51d9594b59b9c28fbe240a502ad4d2152dbcd2abacb91fcb5a4c188380'),
}
inputs = {}
raws = {}
checks = []

def fact(path):
    path = Path(path)
    raw = path.read_bytes()
    assert 0 < len(raw) <= CAP
    q = dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    if str(path) in inputs:
        assert inputs[str(path)] == q and raws[str(path)] == raw
    inputs[str(path)] = q
    raws[str(path)] = raw
    return q

def chk(name, passed, evidence):
    assert type(passed) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name, passed=passed, evidence=evidence))

def read_pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    if q['path'] in inputs:
        assert inputs[q['path']] == q
        return raws[q['path']]
    actual = fact(q['path'])
    chk('whole_actual_input_' + str(len(inputs)) + '_' + Path(q['path']).name,
        actual == q, [q])
    return raws[q['path']]

def pairs(rows):
    out = {}
    for k, v in rows:
        if k in out:
            raise ValueError('duplicate JSON key')
        out[k] = v
    return out

def bad(value):
    raise ValueError('noninteger JSON number')

def obj(raw):
    return json.loads(raw, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def doc(path):
    return obj(raws[str(path)])

def literal_assignments(raw):
    tree = ast.parse(raw)
    result = {}
    for n in tree.body:
        if isinstance(n, ast.Assign):
            value = n.value
            if isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id in ('frozenset', 'set') and len(value.args) == 1:
                value = value.args[0]
            try:
                value = ast.literal_eval(value)
            except (ValueError, TypeError, SyntaxError):
                continue
            for target in n.targets:
                if isinstance(target, ast.Name):
                    result[target.id] = value
    return tree, result

