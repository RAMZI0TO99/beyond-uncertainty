            actual_component='Owner/existing lease/request/body-hash/distinct Source-purpose metadata semantics only; M3 producer/caller/physical/human/native/IO qualifications remain False.')
def save(name, value):
    path = OWN/name
    body = (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert 0 < len(body) <= CAP
    with path.open('xb') as f:
        f.write(body)
    return dict(path=str(path),bytes=len(body),sha256=hashlib.sha256(body).hexdigest())
fp = save('INDEPENDENT_I8_PROTOCOL001_AND_CLARIFIERS_FULL_PROOF_001.json',full)
capsule = dict(**common, record_type='Independent_I8_protocol_and_exact_clarifications_Source_capsule',
               full_proof=fp, checks_passed=len(checks)-len(failed), actual_input_count=len(held),
               actual_target_and_fixture_execution=False,
               boundary='Protocol Source PASS alone authorizes no module/test/physical/canonical action.')
cp = save('INDEPENDENT_I8_PROTOCOL001_AND_CLARIFIERS_SOURCE_CAPSULE_001.json',capsule)
print(json.dumps(dict(capsule=cp,full_proof=fp,reviewer_Source=reviewer_pin,checks=len(checks),checks_failed=len(failed),failures=failed,actual_inputs=len(held)),indent=2))
