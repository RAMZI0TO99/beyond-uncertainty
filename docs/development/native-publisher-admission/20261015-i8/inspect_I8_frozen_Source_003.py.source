"""Finite own Source-only inspection. No target import, evaluation or call."""
import ast
import base64
import builtins
import datetime
import hashlib
import json
import symtable
from pathlib import Path

OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011\i8')
M=OWN/'validate_current_owner_M3_prewrite_admission_002.py'
F=OWN/'test_current_owner_M3_prewrite_admission_memory_only_003.py'
A=OWN/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_003.json'
I=OWN/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_COMPLETE_PREDECESSOR_INVERSE_003.json'
R=OWN/'CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_003.json'
OUT=OWN/'I8_AUTHOR_STATIC_SOURCE_INSPECTION_003.json'
checks=[]
def check(name,condition,evidence):
    checks.append(dict(name=name,passed=condition is True,evidence=evidence))
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def assigned(tree):
    names=set()
    for node in tree.body:
        if isinstance(node,(ast.FunctionDef,ast.ClassDef)):names.add(node.name)
        elif isinstance(node,(ast.Import,ast.ImportFrom)):names.update(x.asname or x.name.split('.')[0] for x in node.names)
        elif isinstance(node,(ast.Assign,ast.AnnAssign)):
            targets=node.targets if isinstance(node,ast.Assign) else [node.target]
            names.update(n.id for t in targets for n in ast.walk(t) if isinstance(n,ast.Name))
    return names
def literals(tree):
    return {n.targets[0].id:ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
api=json.loads(A.read_bytes());inverse=json.loads(I.read_bytes());receipt=json.loads(R.read_bytes())
module=M.read_bytes();fixture=F.read_bytes();mt=ast.parse(module);ft=ast.parse(fixture)
compile(module,str(M),'exec');compile(fixture,str(F),'exec')
check('Module AST and compile-only accepted',True,pin(M));check('Fixture AST and compile-only accepted',True,pin(F))
check('API exact module pin',api['module']==pin(M),pin(A));check('API exact fixture pin',api['fixture_Source']==pin(F),pin(A))
for key,path in (('module',M),('fixture',F),('API',A),('inverse',I)):
    check('Author receipt exact '+key+' pin',receipt[key]==pin(path),pin(R))
for entry in inverse['entries']:
    raw=base64.b64decode(entry['whole_original_bytes'],validate=True);p=entry['pin'];path=Path(p['path'])
    check('Whole inverse '+path.name,len(raw)==p['bytes'] and hashlib.sha256(raw).hexdigest()==p['sha256'] and path.read_bytes()==raw,p)
prefix=base64.b64decode(inverse['entries'][0]['whole_original_bytes'],validate=True)
check('Complete I0 verbatim prefix unchanged',module.startswith(prefix),inverse['entries'][0]['pin'])
check('I0 all whole function/class regions unchanged',inverse['I0_regions_before']==inverse['I0_regions_after'],pin(I))
prefix_tree=ast.parse(prefix);old_names=assigned(prefix_tree);new_names=assigned(mt)-old_names
check('New global namespace disjoint from copied I0',assigned(ast.Module(body=[n for n in mt.body if getattr(n,'lineno',0)>prefix.count(b'\n')],type_ignores=[])).isdisjoint(old_names),pin(M))
check('Only prefixed new globals plus two public entries',all(n.startswith(('I8','_i8')) or n in ('validate_current_owner_M3_prewrite_metadata','require_actual_finite8_publication_admission') for n in new_names),pin(M))
for path,raw,tree in ((M,module,mt),(F,fixture,ft)):
    allowed=assigned(tree)|set(dir(builtins))|{'__name__','__file__','__doc__','__package__','__builtins__'}
    root=symtable.symtable(raw.decode(),str(path),'exec');unresolved=[]
    def walk(table):
        for symbol in table.get_symbols():
            if symbol.is_referenced() and symbol.is_global() and symbol.get_name() not in allowed:
                unresolved.append(dict(scope=table.get_name(),name=symbol.get_name()))
        for child in table.get_children():walk(child)
    walk(root)
    check('Static global names resolved '+path.name,not unresolved,unresolved)
    functions={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)};count=0;issues=[]
    for call in ast.walk(tree):
        if not isinstance(call,ast.Call) or not isinstance(call.func,ast.Name) or call.func.id not in functions:continue
        if any(isinstance(x,ast.Starred) for x in call.args) or any(k.arg is None for k in call.keywords):continue
        target=functions[call.func.id];args=target.args;positionals=args.posonlyargs+args.args
        given=[x.arg for x in positionals[:len(call.args)]]+[k.arg for k in call.keywords]
        required={x.arg for x in positionals[:len(positionals)-len(args.defaults)]}
        required.update(x.arg for x,d in zip(args.kwonlyargs,args.kw_defaults) if d is None)
        known={x.arg for x in positionals+args.kwonlyargs}
        invalid=len(given)!=len(set(given)) or bool(required-set(given)) or (len(call.args)>len(positionals) and args.vararg is None) or (bool(set(given)-known) and args.kwarg is None)
        if invalid:issues.append(dict(function=call.func.id,line=call.lineno,given=given))
        count+=1
    check('Static unexpanded direct-call signatures '+path.name,not issues,dict(calls_checked=count,issues=issues))
    imports=[a.name for n in tree.body if isinstance(n,(ast.Import,ast.ImportFrom)) for a in n.names]
    check('Only pure standard imports '+path.name,not any(x in ('os','pathlib','subprocess','ctypes','socket','importlib') for x in imports),imports)
    io_calls=[n.func.attr for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr in ('open','read_bytes','write_bytes','stat','lstat','rename','mkdir','system','Popen','run')]
    check('No target filesystem/process/native APIs '+path.name,not io_calls,io_calls)
ml=literals(ast.Module(body=[n for n in mt.body if isinstance(n,ast.Assign) and n.targets[0].id.startswith('I8')],type_ignores=[]))
fl=literals(ft)
check('Literal actual publication hold False',ml['I8_REAL_PUBLICATION_BINDINGS_QUALIFIED'] is False,pin(M))
entry=next(n for n in mt.body if isinstance(n,ast.FunctionDef) and n.name=='require_actual_finite8_publication_admission')
check('Actual entry first held then unconditional refusal',isinstance(entry.body[0],ast.If) and isinstance(entry.body[-1],ast.Raise) and not any(isinstance(n,ast.Name) and n.id=='read_record' for n in ast.walk(entry)),pin(M))
check('Literal96 case count',type(fl['EXPECTED_CASE_COUNT']) is int and fl['EXPECTED_CASE_COUNT']==96,pin(F))
names=fl['PLANNED_CASE_NAMES'];check('Unique planned literal names/API exact order',type(names) is tuple and len(names)==len(set(names))==fl['EXPECTED_CASE_COUNT'] and api['fixture_interface']['planned_case_names']==list(names),pin(F))
check('API exact fixture count',api['fixture_interface']['expected_case_count']==fl['EXPECTED_CASE_COUNT'],pin(A))
strings={n.value for n in ast.walk(ft) if isinstance(n,ast.Constant) and type(n.value) is str}
for name in names:check('Fixture branch declared '+name,name in strings,pin(F))
check('Specific correction error oracles',all(name in fl['I8F_EXPECTED_CODES'] for name in ('selection_successor','selection_ordinal1000','selection_basename','selection_predecessor_parent','selection_cross_group','selection_nonce','selection_launcher_runtime','recorded_read12_shape','recorded_raw9_bool','recorded_birth_ledger','recorded_image_cap','recorded_reparse','recorded_image_changed','recorded_rename_identity','publisher_pin_bool')),pin(F))
check('Own author does not report target execution',receipt['own_static_checks']['actual_fixture_cases_executed']==0 and receipt['own_static_checks']['original_module_imports_calls_tests']==0,pin(R))
check('All actual future cells null',all(v is None for v in api['actual_future'].values()),pin(A))
check('Final API admission/producer/caller remain False',all(api[k] is False for k in ('runtime_eligibility','actual_admission','producer_qualified','caller_qualified')),pin(A))
out=dict(schema_version=2,record_type='I8_author_static_Source_inspection',author='/root/phase_frontier',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),
 subjects=[pin(x) for x in (M,F,A,I,R)],checks=checks,checks_passed=sum(x['passed'] for x in checks),checks_failed=sum(not x['passed'] for x in checks),
 verdict='PASS_AUTHOR_STATIC_SOURCE_ONLY' if all(x['passed'] for x in checks) else 'REFUSE_AUTHOR_STATIC_SOURCE_FINDINGS',
 target_imports_calls_tests=0,fixture_cases_executed=0,independent_review=False,physical_origin_authenticated=False,operational_authority=False)
raw=(json.dumps(out,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(raw)<2097152
with OUT.open('xb') as stream:stream.write(raw)
print(json.dumps(dict(report=pin(OUT),checks_passed=out['checks_passed'],checks_failed=out['checks_failed'],findings=[x for x in checks if not x['passed']]),sort_keys=True))
