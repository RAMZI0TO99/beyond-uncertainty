import datetime,hashlib,json,os,sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011');CAP=2097152
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and 0<p.stat().st_size<=CAP
 with p.open('rb') as h:b=h.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise AssertionError(v)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def main():
 assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
 cp=fact(P/'independent_review_001'/sys.argv[1]);assert cp['sha256']==sys.argv[2];c=obj(pin(cp));f=obj(pin(c['full_proof']));pin(c['reviewer_Source'])
 for x in (c,f):assert x['reviewer']=='/root/owner_source_review' and x['verdict'].startswith(('PASS_','ACCEPT_')) and type(x['checks_failed']) is int and x['checks_failed']==0 and x['tests_executed'] is False and x['target_execution'] is False
 checks=f['checks'];assert checks and len({q['name'] for q in checks})==len(checks) and all(q['passed'] is True for q in checks)
 inputs=f['all_actual_inputs'];assert inputs and len({q['path'].casefold() for q in inputs})==len(inputs)
 for q in inputs:pin(q)
 sp=fact(P/'ROOT_I8_ONCE_SYNTHETIC_MEMORY_TEST_SCOPE_002.json');s=obj(pin(sp));assert sp in inputs
 assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(s['interval_end'])
 assert s['attempt_ordinal']==2 and s['total_suite_invocations_if_success']==2
 for prior in s['prior_failed_attempt'].values():pin(prior);assert prior in inputs
 assert s['maximum_invocations']==1 and s['automatic_retry_authorized'] is False and s['new_I8_pure_memory_fixture_invocation_authorized'] is True and s['original_I0_I1_I2_I3_I4_I5_I6_I7_native_Parser_project_invocations_authorized'] is False
 assert s['exact_child_runner']==fact(P/'ROOT_RUN_I8_ONCE_ISOLATED_MEMORY_FIXTURES_002.py') and s['exact_supervisor_Source']==fact(P/'ROOT_SUPERVISE_I8_ONCE_MEMORY_FIXTURES_002.py')
 for q in (s['adapter_Source'],s['fixture_Source'],s['API'],s['actual_final_Source_adoption'],s['exact_child_runner'],s['exact_supervisor_Source']):pin(q);assert q in inputs
 for k in ('consumption_marker_name','supervisor_marker_name','saved_result_name','supervisor_result_name','child_stdout_name','child_stderr_name'):assert not (P/s[k]).exists()
 x=dict(schema_version=1,record_type='Root_actual_I8_fresh_one_use_memory_scope_preinvocation_Source_review_adoption',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),verdict='ACCEPT_EXACT_ONCE_I8_NEW_PURE_PREWRITE_METADATA_MEMORY_SCOPE_ONLY',scope=sp,different_Source_review=cp,full_proof=c['full_proof'],reviewer_Source=c['reviewer_Source'],actual_named_checks=len(checks),all_actual_review_inputs_rehashed=True,actual_rehashed_input_count=len(inputs),all6_one_use_outputs_absent=True,supervisor=s['exact_supervisor_Source'],child_runner=s['exact_child_runner'],expected_case_count=s['expected_planned_case_count'],maximum_invocations=1,automatic_retry_authorized=False,tests_executed=False,target_execution=False,original_project_native_Parser_runtime_scientific_execution_authorized=False,operational_authority=False,scientific_authority=False)
 p=P/'ROOT_I8_FRESH_MEMORY_SCOPE_PREINVOCATION_REVIEW_ADOPTION_002.json';b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
 with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
 print(json.dumps(fact(p)))
if __name__=='__main__':main()