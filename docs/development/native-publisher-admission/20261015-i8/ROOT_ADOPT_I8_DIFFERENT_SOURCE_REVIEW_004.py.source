"""Root adopts exact different Source proof; never imports or invokes targets."""
import datetime,hashlib,json,os,re,sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_admission_011');CAP=2097152
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise AssertionError(v)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def main():
 assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
 mode=sys.argv[1];assert mode in ('protocol','source')
 scopepin=fact(P/'ROOT_CURRENT_I8_PREWRITE_ADMISSION_SOURCE_SCOPE_001.json');scope=obj(pin(scopepin))
 assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(scope['interval_end'])
 cp=fact(P/'independent_review_001'/sys.argv[2]);assert cp['sha256']==sys.argv[3];c=obj(pin(cp))
 assert c['reviewer']=='/root/owner_source_review' and c['verdict'].startswith(('PASS_','ACCEPT_'))
 fp=c['full_proof'];f=obj(pin(fp));rp=c['reviewer_Source'];pin(rp)
 for x in (c,f):assert type(x['checks_failed']) is int and x['checks_failed']==0 and x['target_execution'] is False and x['tests_executed'] is False and x['reviewer']==c['reviewer']
 checks=f['checks'];assert checks and len({q['name'] for q in checks})==len(checks) and all(q['passed'] is True for q in checks)
 inputs=f['all_actual_inputs'];assert inputs and len({q['path'] for q in inputs})==len(inputs)
 for q in inputs:pin(q)
 subjects=c['subjects'];assert subjects and subjects==f['subjects']
 for q in subjects:pin(q);assert q in inputs
 if mode=='protocol':
  assert c['source_author']=='/root'
  protocol=fact(P/'ROOT_I8_EXACT_PREWRITE_OWNER_LEASE_PURPOSE_IMPLEMENTATION_PROTOCOL_001.json')
  clarifier=fact(P/'ROOT_I8_PROTOCOL001_BIRTH_FIELD_AND_PURPOSE_PROOF_CLOSURE_CLARIFICATION_001.json')
  limits=fact(P/'ROOT_I8_PROTOCOL001_FINITE_READER_LIMITS_AND_CHRONOLOGY_CLARIFICATION_001.json')
  assert all(q in inputs and q in subjects for q in (protocol,clarifier,limits))
  for name in ('validate_current_owner_M3_prewrite_admission_001.py','test_current_owner_M3_prewrite_admission_memory_only_001.py','CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_001.json','CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_001.json'):assert not (P/'i8'/name).exists()
  verdict='ACCEPT_I8_PREWRITE_OWNER_LEASE_PURPOSE_PROTOCOL_SOURCE_ONLY';out='ROOT_I8_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
  extra=dict(protocol=protocol,clarification=clarifier,finite_limits_and_chronology=limits,new_Source_API_fixture_authoring_authorized=True)
 else:
  assert c['source_author']=='/root/phase_frontier' and len(subjects)==4
  assert fact(P/'ROOT_I8_SAVED_ATTEMPT001_AND_INHERITED_PHASE_PATH_CORRECTION_PROTOCOL_001.json') in inputs
  assert fact(P/'ROOT_I8_ACTUAL_ONCE_SYNTHETIC_MEMORY_RESULTS_001.json') in inputs
  assert fact(P/'ROOT_I8_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_001.json') in inputs
  patterns=(r'validate_current_owner_M3_prewrite_admission_\d{3}\.py',r'test_current_owner_M3_prewrite_admission_memory_only_\d{3}\.py',r'CURRENT_OWNER_M3_PREWRITE_ADMISSION_INERT_API_\d{3}\.json',r'CURRENT_OWNER_M3_PREWRITE_ADMISSION_ACTUAL_SOURCE_AUTHOR_RECEIPT_\d{3}\.json')
  assert all(sum(bool(re.fullmatch(pattern,Path(q['path']).name)) for q in subjects)==1 for pattern in patterns)
  verdict='ACCEPT_I8_PURE_PREWRITE_ADMISSION_AND_FIXTURE_SOURCE_ONLY';out='ROOT_I8_FINAL_PREWRITE_ADMISSION_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json'
  extra=dict(real_family_entry_unconditionally_held=True,fixture_invocation_requires_fresh_separate_one_use_Root_scope=True)
 x=dict(schema_version=1,record_type='Root_actual_I8_different_Source_review_adoption_'+mode,author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),scope=scopepin,verdict=verdict,subjects=subjects,different_Source_review=cp,full_proof=fp,reviewer_Source=rp,actual_named_checks=len(checks),all_actual_review_inputs_rehashed=True,actual_rehashed_input_count=len(inputs),tests_executed=False,target_execution=False,new_module_or_fixture_invocation_authorized_now=False,actual_family_Source_publication_authorized=False,all_future_lease_family_grants_canonical_paths_ordinals_purpose_Native8_Parser_results=None,operational_authority=False,scientific_authority=False,**extra)
 p=P/out;b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
 with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
 print(json.dumps(fact(p)))
if __name__=='__main__':main()
