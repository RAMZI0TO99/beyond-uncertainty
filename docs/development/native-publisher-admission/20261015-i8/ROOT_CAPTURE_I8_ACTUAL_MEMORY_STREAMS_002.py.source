x=dict(schema_version=1,record_type='Root_actual_owned_I8_memory_child_streams_dated_capture_envelope',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),serializer_Source=fact(Path(__file__)),supervisor_result=supervisor,streams=streams,empty_captured_stderr_bytes_are_actual_observation_not_a_positive_metadata_schema_pin=True,no_child_or_test_rerun=True,target_execution=False,operational_authority=False,scientific_authority=False)
p=P/'ROOT_I8_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_002.json';b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
print(json.dumps(fact(p)))
