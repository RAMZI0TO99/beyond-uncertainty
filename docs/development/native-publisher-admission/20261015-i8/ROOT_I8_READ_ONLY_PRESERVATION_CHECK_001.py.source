"""Finite read/hash preservation check; no target import/call or test entry."""
import datetime,hashlib,json,os
from pathlib import Path
R=Path(r'D:\Aenv\pro2');P=R/'WORK/resume-20261015-001/native_publisher_admission_011';G=R/'github-portable-20261012-001';CAP=2097152
def raw(p,cap=CAP):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=cap
 with p.open('rb') as f:b=f.read(cap+1)
 assert len(b)<=cap;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pinned(q,path=None,cap=CAP):
 b=raw(path or q['path'],cap);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
s_pin=fact(R/'WORK/resume-20261015-001/native_publisher_implementation_010/managed_preparation_001/candidates_001/EXACT_MANAGED_I7_HELD_PUBLISHER_IO_IMPLEMENTATION_PUBLICATION_SCOPE_001.json')
assert s_pin['sha256']=='50e2375f4707136680f3cb49cc775db677253e5203be04d5d6c29d2c847a04e1';s=json.loads(pinned(s_pin))
baseline=json.loads(pinned(s['preexisting608_byte_baseline']));rows=baseline['all_preexisting_file_bytes'];assert len(rows)==608
exceptions=[]
for q in rows:
 cap=CAP
 if q['bytes']>CAP:
  assert q['bytes']==3483233
  cap=q['bytes'];exceptions.append(q)
 pinned(q,path=G/q['path'],cap=cap)
assert len(exceptions)==1
assert len(s['all_frozen_STEP080_sentinels'])==8
for q in s['all_frozen_STEP080_sentinels']:pinned(q['actual_current_pin'])
b=json.loads(pinned(s['current36_Source_baseline']));assert b['actual_present']==36
present=0;absent=0
for q in b['current_45_identity_rows']:
 if q['canonical'] is not None:pinned(q['canonical']);present+=1
 else:assert not Path(q['canonical_path']).exists();absent+=1
assert (present,absent)==(36,9)

assert len(s['files'])==93
for row in s['files']:pinned(row['source'],path=G/row['managed_path'])
assert len(s['all_prior_I6_non_navigation_file_pins'])==77
for q in s['all_prior_I6_non_navigation_file_pins']:pinned(q)
adoption=json.loads(pinned(s['Root_implementation_adoption']))
for q in adoption['managed_evidence_inputs']:pinned(q)
x=dict(schema_version=1,record_type='Root_I8_actual_read_only_preservation_refresh_before_new_prewrite_admission_Source_birth',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),reviewer_Source=fact(Path(__file__)),prior_finite_scope=s_pin,baseline=s['preexisting608_byte_baseline'],all608_complete_working_bytes_exact=True,all93_I7_checkpoint_working_bytes_exact=True,all77_prior_I6_non_navigation_file_pins_exact=True,all_original_I7_evidence_pins_exact=True,total_historical_bytes=sum(q['bytes'] for q in rows),exact_dated_historical_raw_cap_exception=exceptions,all8_frozen_STEP080_sentinels_exact=True,current_Source_baseline=s['current36_Source_baseline'],all36_current_original_Source_bytes_exact=True,all9_pending_canonical_paths_absent=True,current_present=present,current_pending=absent,frozen_STEP080_present=35,frozen_STEP080_pending=10,all75_spent_identity_no_replay_policy_preserved=True,target_import_call_test_native_Parser_execution=False,operational_authority=False,scientific_authority=False)
p=P/'ROOT_I8_ACTUAL_START_READ_ONLY_PRESERVATION_CHECK_001.json';data=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(data)<=CAP
with p.open('xb') as f:f.write(data);f.flush();os.fsync(f.fileno())
print(json.dumps(fact(p)))
