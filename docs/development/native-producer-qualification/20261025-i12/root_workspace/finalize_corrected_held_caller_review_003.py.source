"""Own additive review metadata correction author only."""
import ast
from pathlib import Path
ROOT=Path(__file__).parent
raw=(ROOT/'finalize_corrected_held_caller_review_002.py').read_bytes()
text=raw.decode('utf8').replace("assert not any(isinstance(n,ast.ImportFrom) for n in tree.body)", "assert all(n.module == 'pathlib' for n in tree.body if isinstance(n,ast.ImportFrom))")
path=ROOT/'finalize_corrected_held_caller_review_corrected_002.py'
ast.parse(text)
with path.open('xb') as f:f.write(text.encode('utf8'))
