'''
text=head+'\nFIXED = '+repr(fixed)+'\n\nCASE_CATALOGUE = '+repr(meta['cases'])+'\n\nVARIANT_TO_LITERAL_CASES = '+repr(meta['variant_to_exact_literal_cases'])+'\n\nAUTHORITY_FALSE_FLAGS = '+repr(tuple(comp['result_constants']['authority_false_flags']))+'\n\nCASE_NAME_DIGEST = '+repr(meta['case_name_digest'])+'\n'
text+='\nSTATIC_FINDINGS_EXACT_CLOSURE = '+repr(meta['static_findings_exact_closure'])+'\n\nFINITE_EDGE_TABLE_LITERAL_CLOSURE = '+repr(meta['finite_edge_table_exact_literal_closure'])+'\n'
text+=(ROOT/'i12_fixture_builder_draft_002.txt').read_text(encoding='utf8')
text+=(ROOT/'i12_fixture_handlers_draft_002.txt').read_text(encoding='utf8')
raw=text.encode('utf8');assert len(raw)<=CAP
path=OUT/'test_outside8_receipt_contract_memory_only_002.py'
tree=ast.parse(raw);compile(raw,str(path),'exec',dont_inherit=True)
literal=next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CASE_CATALOGUE' for t in n.targets))
cases=ast.literal_eval(literal)
assert cases==meta['cases'] and len(cases)==meta['case_count']
assert hashlib.sha256(('\n'.join(r['name'] for r in cases)+'\n').encode()).hexdigest()==meta['case_name_digest']
run=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='run')
assert [a.arg for a in run.args.kwonlyargs]==['formats','single','peer','catalogue_bytes']
imports=[]
for n in ast.walk(tree):
    if isinstance(n,ast.Import):imports.extend(a.name for a in n.names)
    assert not isinstance(n,ast.ImportFrom)
    assert not(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('exec','eval','compile','open','__import__'))
assert set(imports)=={'base64','copy','hashlib','json','types'}
with path.open('xb') as f:f.write(raw)
fixture=pin(path,raw)
catalogue=save(OUT/'I12_FRESH_LITERAL_FIXTURE_CASE_CATALOGUE_002.json',dict(meta,fixture=fixture,AST_literal_case_count=len(cases),AST_literal_digest_match=True,fixture_imports=imports,run_signature='run(*,formats,single,peer,catalogue_bytes)',target_imports=0,target_calls=0,tests_executed=False))
kernel=json.loads((OUT/'I12_ACTUAL_STATIC_KERNEL_SOURCE_AUTHOR_RECEIPT_004.json').read_text(encoding='utf8'))
regions=[];lines=raw.splitlines(keepends=True)
for node in tree.body:
    if isinstance(node,(ast.FunctionDef,ast.ClassDef)):
        part=b''.join(lines[node.lineno-1:node.end_lineno]);regions.append(dict(name=node.name,first_line=node.lineno,last_line=node.end_lineno,bytes=len(part),sha256=hashlib.sha256(part).hexdigest()))
inventory=save(OUT/'I12_FRESH_FIXTURE_SOURCE_REGION_AND_LITERAL_INVENTORY_002.json',dict(schema_version=1,record_type='I12_fresh_unrun_fixture_exact_Source_regions_and_literal_inventory',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),fixture=fixture,case_catalogue=catalogue,case_count=len(cases),case_name_digest=meta['case_name_digest'],case_counts=meta['counts'],regions=regions,bind_exact_kernel_sources=kernel['sources'],bind_exact_kernel_APIs=kernel['APIs'],fixed_capture=pin(ROOT/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json'),fixed_record_count=len(fixed),fixed_total_body_bytes=sum(r['pin']['bytes'] for r in fixed.values()),fixed_spent_body_count=0,prior_fixture_preserved=pin(OUT/'test_outside8_receipt_contract_memory_only_001.py'),findings_review=meta['findings_review'],finite_edge_table=meta['finite_edge_table'],static_findings_exact_closure=meta['static_findings_exact_closure'],finite_edge_table_exact_literal_closure=meta['finite_edge_table_exact_literal_closure'],strict_snapshot_checks_after_every_case=True,start_end_hash_seals=True,source_drafts=[pin(ROOT/'i12_fixture_builder_draft_002.txt'),pin(ROOT/'i12_fixture_handlers_draft_002.txt')],prior_literal_metadatas_preserved=[pin(ROOT/f'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_00{i}.json') for i in (1,2,3,4)],target_imports=0,target_calls=0,tests_executed=False,operational_authority=False,scientific_authority=False))
receipt=save(OUT/'I12_FRESH_MEMORY_ONLY_FIXTURE_STATIC_AUTHOR_RECEIPT_002.json',dict(schema_version=1,record_type='I12_fresh_memory_only_fixture_static_Source_author_receipt',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),fixture=fixture,catalogue=catalogue,inventory=inventory,case_count=len(cases),case_name_digest=meta['case_name_digest'],case_counts=meta['counts'],exact_run_signature='run(*,formats,single,peer,catalogue_bytes)',supervisor_contract='Root new supervisor emits SUITE_ENTRY, loads only exact new formats003/single003/peer004 Sources as fixed ModuleTypes, calls this literal run once, receives exact I12_owned_synthetic_memory_case_results dict. Internal fixture emits JSON CASE_PASS name with flush=True after each success. First assertion/typed-error mismatch raises; prior events remain; no child result can claim unentered cases. Emitter not loaded. Fresh60/50/10/5 separate one-use scope and Source review/adoption still required.',return_shape=dict(record_type='I12_owned_synthetic_memory_case_results',cases='ordered literal{name,passed:true} rows',passed='exact builtin int case_count',failed=0,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False),isolation='FIXED and literal case specs fully deep-copied; complete definitions, returned graphs and siblings have disjoint mutable identities; explicit fixed-pin mutations and positive/negative/sibling probes precede schema mutations; strict complete type/value global snapshots checked after every case and independent start/end fingerprint seals; input mutation changed proof before target invocation.',static_findings_exact_closure=meta['static_findings_exact_closure'],finite_edge_table_exact_literal_closure=meta['finite_edge_table_exact_literal_closure'],preserved_fixture001=pin(OUT/'test_outside8_receipt_contract_memory_only_001.py'),findings_review=meta['findings_review'],finite_edge_table=meta['finite_edge_table'],corrections='F01 explicit synthetic format-only predecessor for uncaptured descriptor roles; F02-F09 finite exact typed controls/edge closure. Key-subclass mutation fingerprints retain key type. Full strict detached global snapshots after each case plus independent initial/final hash seals; no timing qualification or cap widening.',coverage='Exact literal per-case expected first typed guard, complete every-key deletion matrix for consumed closed schemas, explicit co-limit/applicability notes, constructor36 descriptors and9single/5peer graphs, equality/100ns chronology, spent whitelist-only metadata, actual historical differingnominal/largeoldCode data positives; no oldfixture bytes or cases reused.',status='FROZEN_UNRUN_REQUIRES_GENUINE_DIFFERENT_SOURCE_REVIEW_AND_ROOT_ADOPTION_PLUS_FRESH_ONCE_SCOPE',target_imports=0,target_calls=0,tests_executed=False,target_execution=False,full_G01_closed=False,operational_authority=False,scientific_authority=False,author_tool=pin(Path(__file__))))
print(json.dumps(dict(fixture=fixture,catalogue=catalogue,inventory=inventory,author_receipt=receipt,case_count=len(cases),case_name_digest=meta['case_name_digest'],counts=meta['counts']),sort_keys=True))
