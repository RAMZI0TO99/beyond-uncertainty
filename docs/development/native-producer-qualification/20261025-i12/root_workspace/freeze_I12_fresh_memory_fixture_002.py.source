"""Own fixture Source/literal/AST metadata author only, never imports/runs fixture."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
OUT=BASE/'i12'
CAP=2097152
def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=CAP
    with path.open('xb') as f:f.write(raw)
    return pin(path,raw)
fixed=json.loads((ROOT/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json').read_text(encoding='utf8'))
