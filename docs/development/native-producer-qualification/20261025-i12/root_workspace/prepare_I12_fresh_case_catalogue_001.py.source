"""Own finite literal case-spec metadata author. Does NOT import/run fixture/targets."""
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
c=json.loads((BASE/'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json').read_text(encoding='utf8'))
fixed=json.loads((ROOT/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json').read_text(encoding='utf8'))
import base64
old=json.loads(base64.b64decode(fixed['old_selection']['body64']).decode())
writer_index=next(i for i,row in enumerate(old['rows']) if row['role']=='writer')
cases=[];mapping={}
def add(name,expected='PASS',category='misc',route='graph',kind='single',role='writer',**kw):
    assert name not in {r['name'] for r in cases}
    row=dict(name=name,expected=expected,category=category,route=route,kind=kind,role=role,**kw)
    cases.append(row);mapping.setdefault(category,[]).append(name)
for mode in ('positive','negative','sibling'):
    add('fixture_detachment_'+mode,route='isolation',category='P_ISOLATION',mode=mode)
for role in c['generic9_roles']:add('single_graph_'+role,category='P_SINGLE9',role=role)
for role in c['peer_format_roles']:add('peer_graph_'+role,category='P_PEER5',kind='peer',role=role)
for role in ('phase_peer','pipeline_peer'):add('peer_distinct_retained_and_historical_nominal_'+role,category='P_DISTINCT_ACTORS',kind='peer',role=role)
add('phase_context_large_existing_I5_Source_data',category='P_OLD_CODE_CAP',kind='peer',role='phase_peer',special='large_code_context')
add('phase_context_unknown_implementation_object_is_data',category='P_OPAQUE',kind='peer',role='phase_peer',special='phase_reference_opaque')
for index in (4,5):add('ordinary_independent_API_difference_index'+str(index),category='P_INDEPENDENT_APIS',special='nonshared_observation',index=index)
add('Root_child_prefix_sibling_reviewer',category='P_ACTOR',special='reviewer',actor='/root/i2_resume_gap2')
outside=sorted(set(c['ROLE_SOURCE_CAPS'])-set(c['finite8_roles']))
for role in outside:
    for record_kind,label in (('single_request14_v2','request'),('single_publication29_v2','publication'),('generic_stage_receipt29_v2','generation')):
        add('format36_'+record_kind+'_'+role,category='P_FORMAT36',route='format',role=role,record_kind=record_kind,label=label)
formats=[('single_request14_v2','single','writer','request'),('single_publication29_v2','single','writer','publication'),('generic_stage_receipt29_v2','single','writer','generation'),('selected_peer_receipt27_v2','peer','phase_peer','receipt'),('generic_peer_content_decision13_v2','peer','metadata_peer','decision'),('phase_content_decision15_v2','peer','phase_peer','decision'),('peer_serialization_witness13_v2','peer','phase_peer','serialization'),('peer_inverse12_v2','peer','phase_peer','inverse'),('single_reconciliation26_v2','single','writer','reconciliation')]
for record_kind,kind,role,label in formats:
    add('format_kind_'+record_kind,category='P_CONSTRUCTOR_KINDS',route='format',kind=kind,role=role,record_kind=record_kind,label=label)
locations=[]
for schema,kind,role,label in formats:locations.append((schema,kind,role,label,[],schema,'format'))
locations.extend([
 ('I5_closed9_lease_support','single','writer','generation',['lawful_lease_support'],'generic_stage_receipt29_v2','format'),
 ('recorded_observation12','single','writer','generation',['actual_paired_metadata_inputs',0],'generic_stage_receipt29_v2','format'),
 ('fixed_spent_observation10','single','writer','publication',['actual_paired_metadata_inputs',2],'single_publication29_v2','format'),
 ('publication_details5','single','writer','publication',['details'],'single_publication29_v2','format'),
 ('generic_late_facts26_v2','single','writer','generation_facts',[],None,'graph'),
 ('generic_stage_decision14_v2','single','writer','generation_decision',[],None,'graph'),
 ('publication_stage_support6','single','writer','publication_facts',['stage_support'],None,'graph'),
 ('phase_context21_v2','peer','phase_peer','context',[],None,'graph'),
 ('phase_parser_support9_v2','peer','phase_peer','context',['fresh_parser_support'],None,'graph'),
 ('single_packet22','single','writer','packet',[],None,'graph'),
 ('peer_packet20','peer','phase_peer','packet',[],None,'graph'),
 ('code_support5','single','writer','packet',['constructor_support'],None,'graph'),
 ('subject_support3','single','writer','packet',['selection_support'],None,'graph'),
 ('decision_support3','peer','phase_peer','packet',['content_support'],None,'graph'),
 ('proposal_support3','peer','phase_peer','packet',['proposal_support'],None,'graph'),
 ('review_support2','single','writer','packet',['canonical_support'],None,'graph'),
 ('constructor_API13','single','writer','constructor_api',[],None,'graph'),
 ('held_generic_emitter_API14','single','writer','emitter_api',[],None,'graph')])
selection_fields=['author','created_utc','current_complete45_inventory','current_owner_scope','current_selection','derived_launcher_runtime_path','new_canonical_lease','operational_authority','record_type','rows','schema_version','selected_Source_nonce','target_execution']
selection_row_fields=['canonical_path','draft_path','must_change_Source_bytes','predecessor','preparation_Source_author','retained_semantic_Source_author','role','selected_ordinal','source_cap']
for schema,fields,path in (('selection13_v2',selection_fields,[]),('selection_row9',selection_row_fields,['rows',writer_index])):
    for key in fields:add('schema_'+schema+'_missing_'+key,'E_SCHEMA',category='N_CLOSED_SCHEMA',operations=[['delete','selection',path+[key]]])
    add('schema_'+schema+'_unknown','E_SCHEMA',category='N_CLOSED_SCHEMA',operations=[['set','selection',path+['unknown_qualified'],True]])
    if not path:
        for version in (1,True):add('schema_selection_version_'+str(type(version).__name__),'E_SELECTION',category='N_VERSION',operations=[['set','selection',['schema_version'],version]])
        add('schema_selection_wrong_tag','E_SELECTION',category='N_RECORD_TAG',operations=[['set','selection',['record_type'],'unknown']])
for schema,kind,role,label,path,record_kind,route in locations:
    spec=c['schemas'][schema]
    opts=dict(kind=kind,role=role,route=route)
    if route=='format':opts.update(record_kind=record_kind,label=label)
    for key in spec['fields']:
        add('schema_'+schema+'_missing_'+key,'E_SCHEMA',category='N_CLOSED_SCHEMA',operations=[['delete',label,path+[key]]],**opts)
    add('schema_'+schema+'_unknown','E_SCHEMA',category='N_CLOSED_SCHEMA',operations=[['set',label,path+['unknown_qualified'],True]],**opts)
    wrong='E_OBSERVATION' if schema in ('recorded_observation12','fixed_spent_observation10') else 'E_SCHEMA'
    operation=['set',label,path,None] if path else ['root_set',label,[],None]
    add('schema_'+schema+'_wrong_root_type',wrong,category='N_CLOSED_TYPE',operations=[operation],**opts)
    if 'schema_version' in spec['fields']:
        for version,suffix in ((1,'int1'),(True,'boolTrue')):
            add('schema_'+schema+'_version_'+suffix,'E_VERSION',category='N_VERSION',operations=[['set',label,path+['schema_version'],version]],**opts)
    if 'record_type' in spec['fields']:
        add('schema_'+schema+'_wrong_tag','E_RECORD_TYPE',category='N_RECORD_TAG',operations=[['set',label,path+['record_type'],'unknown_record_type']],**opts)
# Constructor shape includes typed equality constraints, distinct from graph joins.
for record_kind,role in (('generic_peer_content_decision13_v2','metadata_peer'),('phase_content_decision15_v2','phase_peer')):
    for name,op in (('author_reviewer',[['set','decision',['reviewer'],'/root/other_content_author']]),('actual_inputs',[['set','decision',['actual_current_Source_inputs'],[]]])):
        add('constructor_'+record_kind+'_unequal_'+name,'E_RECORD_JOIN',category='N_CONSTRUCTOR_EQUALITY',route='format',kind='peer',role=role,record_kind=record_kind,label='decision',operations=op)
for name,value in (('malformed','%%'),('noncanonical','eA==\n'),('wrongbytes','eA==')):
    add('constructor_inverse_'+name,'E_INVERSE',category='N_INVERSE',route='format',kind='peer',role='phase_peer',record_kind='peer_inverse12_v2',label='inverse',operations=[['set','inverse',['complete_predecessor_bytes_base64'],value]])
for limit,expected in ((50000,'PASS'),(50001,'E_NODES')):
    add('constructor_nodes_'+str(limit),expected,category='B_NODES',route='format',record_kind='generic_stage_receipt29_v2',label='generation',format_special='value_nodes',limit=limit)
for limit,expected in ((48,'PASS'),(49,'E_DEPTH')):
    add('constructor_depth_'+str(limit),expected,category='B_DEPTH',route='format',record_kind='generic_stage_receipt29_v2',label='generation',format_special='value_depth',limit=limit)
for limit,expected in ((2097152,'PASS'),(2097153,'E_METADATA_CAP')):
    add('constructor_bytes_'+str(limit),expected,category='B_BYTES',route='format',record_kind='generic_stage_receipt29_v2',label='generation',format_special='value_bytes',limit=limit)
add('constructor_dict_subclass','E_VALUE',category='N_BUILTINS',route='format',record_kind='generic_stage_receipt29_v2',label='generation',format_special='subclass')
post_cases=[('packet_dict','E_PACKET_BYTES'),('packet_duplicate','E_DUPLICATE_JSON_KEY'),('packet_float','E_JSON_NUMBER'),('packet_nonfinite','E_JSON_NUMBER'),('packet_surrogate','E_VALUE'),('packet_utf8','E_JSON'),('packet_subclass','E_PACKET_BYTES'),('records_subclass','E_RECORD_COUNT'),('record_subclass','E_RECORD_SCHEMA'),('record_mapping','E_RECORD_SCHEMA'),('pin_subclass','E_PIN'),('record_key_subclass','E_RECORD_SCHEMA'),('pin_key_subclass','E_PIN'),('pin_int_subclass','E_PIN_BYTES'),('pin_str_subclass','E_PIN_SHA256'),('body_subclass','E_RECORD_BODY'),('body_bytearray','E_RECORD_BODY'),('body_same_length_wrong_hash','E_RECORD_HASH'),('body_length','E_RECORD_LENGTH'),('store_alias','E_RECORD_ALIAS'),('record257','E_RECORD_COUNT'),('total32MiB','E_RECORD_TOTAL'),('extra_keyword','TypeError'),('catalogue_wrong_hash','E_CATALOGUE_PIN')]
for post,expected in post_cases:add('boundary_'+post,expected,category='N_PUBLIC_BOUNDARY',post=post)
for field in ('pin','body'):add('supplied_record2_missing_'+field,'E_RECORD_SCHEMA',category='N_CLOSED_SCHEMA',post='record_delete',field=field)
for field in ('path','bytes','sha256'):add('supplied_fact3_missing_'+field,'E_PIN',category='N_CLOSED_SCHEMA',post='pin_delete',field=field)
for post,expected in (('record_extra','E_RECORD_SCHEMA'),('pin_extra','E_PIN')):add('supplied_'+post,expected,category='N_CLOSED_SCHEMA',post=post)
for value,suffix in ((0,'zero'),(-1,'negative'),(True,'boolTrue'),(2097153,'over2MiB')):
    add('pin_bytes_'+suffix,'E_PIN_BYTES',category='N_PIN_TYPES',post='pin_field',field='bytes',value=value)
for value,suffix in (('A'*64,'uppercase'),('bad','malformed')):
    add('pin_sha_'+suffix,'E_PIN_SHA256',category='N_PIN_TYPES',post='pin_field',field='sha256',value=value)
for value,suffix in [('relative.txt','relative'),('d:\\x.txt','lowerdrive'),('\\\\host\\share\\x','UNC'),('D:\\x\\..\\y','traversal'),('D:\\x:stream','ADS'),('D:/x/y','slash'),('D:\\CLOCK$.txt','reserved'),('D:\\x\x01.txt','control'),('D:\\x.','trailingdot'),('D:\\x ','trailingspace'),('D:\\'+'x'*32765,'path32768')]:
    add('pin_path_'+suffix,'E_PATH',category='N_PATH',post='pin_field',field='path',value=value)
for field,value,suffix in [('source_editor',None,'null'),('source_editor','/root','Root'),('expected_root_thread','ABCDEFAB-1234-1234-1234-123456789ABC','UUIDuppercase')]:
    add('argument_'+suffix,'E_ROOT_THREAD' if field=='expected_root_thread' else 'E_ACTOR',category='N_ACTOR_UUID',post='argument',field=field,value=value)
for actor,suffix in [('/root/i2_resume_gap','fixed_kernel'),('/root/I2_Resume_Gap','fixed_kernel_case'),('/root/i2_resume_gap/child','fixed_kernel_descendant'),('/root/i12_synthetic_preparer','recorded_worker'),('/root/selector_prep','historical_retained')]:
    add('review_actor_'+suffix,'E_REVIEWER',category='N_ACTOR_UNION',special='reviewer',actor=actor)
add('review_actor_fresh_sibling45_omitted','E_REVIEWER',category='N_ACTOR_UNION',special='sibling_author')
add('review_actor_nested_explicit_content_source','E_REVIEWER',category='N_ACTOR_UNION',special='nested_author')
for part in ('full','capsule','adoption'):
    for flag in ('target_execution','operational_authority'):
        for mode in ('missing','true'):
            op=['delete','canonical_'+part,[flag]] if mode=='missing' else ['set','canonical_'+part,[flag],True]
            add('proof_'+part+'_'+flag+'_'+mode,'E_AUTHORITY',category='N_PROOF_FLAGS',operations=[op])
for part in ('full','capsule'):
    for value,suffix in ((0,'zero'),(True,'bool'),(2,'mismatch')):
        add('proof_'+part+'_checks_passed_'+suffix,'E_REVIEW',category='N_PROOF_COUNTS',operations=[['set','canonical_'+part,['checks_passed'],value]])
    add('proof_'+part+'_checks_passed_missing','E_REVIEW',category='N_PROOF_COUNTS',operations=[['delete','canonical_'+part,['checks_passed']]])
for name,label,path,value in [('nonPASS','canonical_capsule',['verdict'],'REFUSE'),('nonzero_failed','canonical_full',['checks_failed'],1),('empty_checks','canonical_full',['checks'],[]),('empty_check_name','canonical_full',['checks',0,'name'],''),('false_check','canonical_full',['checks',0,'passed'],False),('full_capsule_mismatch','canonical_full',['verdict'],'PASS_OTHER'),('nonACCEPT','canonical_adoption',['verdict'],'REFUSE')]:
    add('proof_'+name,'E_ADOPTION' if name=='nonACCEPT' else 'E_REVIEW',category='N_PROOF_VALUES',operations=[['set',label,path,value]])
for part,error in (('_full','E_REVIEW_COVERAGE'),('_capsule','E_REVIEW_COVERAGE'),('_adoption','E_ADOPTION_COVERAGE')):
    add('proof_exact_closed3_extended_only'+part,error,category='N_PROOF_DIRECT',special='proof_coverage',part=part,mode='extended')
add('proof_Root_pointer_only','E_ADOPTION_COVERAGE',category='N_PROOF_DIRECT',special='proof_coverage',part='_adoption',mode='pointer')
for count in (10000,10001):add('named_checks_'+str(count)+'_dominated_by_nodes','E_NODES',category='B_COLIMITS',special='checks_count',count=count)
add('aggregate_graph_nodes','E_NODES',category='B_COLIMITS',special='graph_nodes')
for index in (0,1,2,3,6,7,8):add('ordinary_shared7_index'+str(index),'E_OBSERVATION',category='N_OBSERVATIONS',special='shared_observation',index=index)
for name,label,path,value in [('source_worker','generation',['metadata_Source_worker'],'/root/wrong_worker'),('retained','publication',['retained_semantic_Source_author'],'/root/wrong_retained'),('stage','generation',['stage'],'config'),('facts_decision','generation_facts',['stage_decision'],None),('pub_request','publication_facts',['publication_request'],None),('selection_ordinal_zero','selection',['rows',writer_index,'selected_ordinal'],0),('selection_ordinal_bool','selection',['rows',writer_index,'selected_ordinal'],True),('selection_ordinal1000','selection',['rows',writer_index,'selected_ordinal'],1000),('selection_mustchange','selection',['rows',writer_index,'must_change_Source_bytes'],False)]:
    expected='E_ACTOR_JOIN' if name in ('source_worker','retained') else 'E_SELECTION' if name.startswith('selection_') else 'E_PIN' if name=='facts_decision' else 'E_SINGLE_JOIN'
    add('single_join_'+name,expected,category='N_SINGLE_JOINS',operations=[['set',label,path,value]])
for special,expected in [('same_predecessor','E_SELECTED_MATERIAL'),('draft_canonical_differ','E_SELECTED_MATERIAL'),('spents_remove','E_SPENT_SET'),('spents_duplicate','E_OBSERVATION'),('extra_role_observation','E_OBSERVATION')]:add('single_'+special,expected,category='N_SINGLE_JOINS',special=special)
for role in sorted(set(c['ROLE_SOURCE_CAPS'])-set(c['generic9_roles'])):
    add('single_graph_unsupported_role_'+role,'E_UNSUPPORTED_PRODUCER_ROUTE',category='N_ROUTE',operations=[['set','packet',['role'],role]])
add('single_graph_composer_unsupported','E_UNSUPPORTED_PRODUCER_ROUTE',category='N_ROUTE',operations=[['set','packet',['role'],'composer']])
