    field='canonical_Source_birth_utc' if name=='canonical_birth_before_request' else 'created_utc'
    add('chronology_'+name,'E_CHRONOLOGY',category='N_TIME',operations=[['set',label,[field],'2026-10-25T00:00:'+str(value).zfill(2)+'.000000+00:00']])
for name,label,path,value,expected in [('content_actor','receipt',['genuine_content_author_and_reviewer'],'/root/other_content','E_ACTOR_JOIN'),('physical','receipt',['physical_selected_byte_editor'],'/root/other_physical','E_SCHEMA_VALUE'),('nominal','receipt',['original_peer_source_author_nominal'],'/root/other_nominal','E_ACTOR_JOIN'),('lease','receipt',['new_canonical_lease'],None,'E_PIN'),('proposal','receipt',['actual_genuine_content_proposal'],None,'E_PIN'),('decision_author','decision',['reviewer'],'/root/other_content','E_RECORD_JOIN'),('content_inputs','decision',['actual_current_Source_inputs'],[],'E_RECORD_JOIN'),('inverse_hash','inverse',['inverse_sha256'],'0'*64,'E_INVERSE'),('context_absent','packet',['context'],None,'E_PEER_CONTEXT')]:
    add('peer_join_'+name,expected,category='N_PEER_JOINS',kind='peer',role='phase_peer',operations=[['set',label,path,value]])
add('peer_proposal_draft_differ','E_SELECTED_MATERIAL',category='N_PEER_JOINS',kind='peer',role='phase_peer',special='proposal_draft_differ')
for module in ('formats','single','peer'):
    for toggle in (False,True):add('actual_entry_'+module+('_editedTrue' if toggle else '_False'),'E_ACTUAL_ENTRY_UNWIRED',category='N_ACTUAL_HOLD',route='hold',module=module,toggle=toggle)
assert cases[:3][0]['route']=='isolation'
assert len({r['name'] for r in cases})==len(cases)
data=dict(schema_version=1,record_type='I12_fresh_finite_literal_case_catalogue_metadata',author='/root/i2_resume_gap',cases=cases,variant_to_exact_literal_cases=mapping,case_count=len(cases),case_name_digest=hashlib.sha256(('\n'.join(r['name'] for r in cases)+'\n').encode()).hexdigest(),counts=dict(positive=sum(r['expected']=='PASS' for r in cases),expected_refusals=sum(r['expected']!='PASS' for r in cases)),target_imports=0,target_calls=0,tests_executed=False)
raw=(json.dumps(data,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_001.json'
with path.open('xb') as f:f.write(raw)
print(json.dumps(dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),case_count=len(cases),case_name_digest=data['case_name_digest'],counts=data['counts']),sort_keys=True))
