add('single_recon_rejects_finite8_tag','E_RECORD_TYPE',category='N_ROUTE',operations=[['set','reconciliation',['record_type'],'Root_owner_v2_verified_prior_finite8_M3_Source_publication_reconciliation']])
for part in ('full','capsule','adoption'):
    add('proof_missing_time_'+part,'E_TIME',category='N_TIME',operations=[['delete','canonical_'+part,['created_utc']]])
