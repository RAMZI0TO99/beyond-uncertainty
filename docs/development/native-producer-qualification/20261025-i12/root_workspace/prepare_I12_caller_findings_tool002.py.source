"""Own metadata-reader key correction only; reviewed targets remain unrun."""
from pathlib import Path
root=Path(__file__).parent
text=(root/'review_I12_caller002_static_findings_001.py').read_text(encoding='utf8')
text=text.replace("OUT=BASE/'caller_source_different_review_001'","OUT=BASE/'caller_source_different_review_002'").replace("['strict_value_rules']","['strict_types']")
path=root/'review_I12_caller002_static_findings_002.py'
with path.open('xb') as f:f.write(text.encode('utf8'))
print(str(path))
