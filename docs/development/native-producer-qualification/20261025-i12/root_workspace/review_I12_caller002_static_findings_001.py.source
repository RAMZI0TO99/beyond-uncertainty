"""Own genuine different read/hash/AST review; no target import/call."""
import ast
import datetime as dt
import hashlib
import json
import re
from pathlib import Path
ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
OUT=BASE/'caller_source_different_review_001'
OUT.mkdir(exist_ok=False)
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
checks=[]
def check(name,passed,evidence=None):checks.append(dict(name=name,passed=bool(passed),evidence=evidence))
def save(path,value):
    b=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode();assert len(b)<=2097152
    with path.open('xb') as f:f.write(b)
    return pin(path)
caller=BASE/'caller'/'compose_current_owner_receipt_caller_002.py'
i2=BASE/'i2'/'build_M3_metadata_current_owner_deferred_005.py'
raw=caller.read_bytes();tree=ast.parse(raw)
check('exact_caller002_pin',pin(caller)==dict(path=str(caller),bytes=65259,sha256='1e5d98aaf4dfbb403cd72a156e10594b1fee448dcfd928568defb1fad76c2a0f'))
check('exact_I2_005_pin',pin(i2)==dict(path=str(i2),bytes=126615,sha256='d520058d0ecdff02fa2f19b492fd0169ef511c40ceb9388bf17a98a6e7f43af8'))
layers=ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='FIXED_LAYERS' for t in n.targets)))
bad=[]
def controls(v,path=()):
    result=[]
    if type(v) is str and any(ord(c)<32 for c in v):result.append(dict(selector=list(path),value=v))
    elif type(v) is dict:
        for k,x in v.items():result+=controls(x,path+(k,))
    elif type(v) is list:
        for i,x in enumerate(v):result+=controls(x,path+(i,))
    return result
for layer,support in layers.items():
    for key in ('Source','API'):check('fixed_pin_'+layer+'_'+key,pin(Path(support[key]['path']))==support[key],support[key])
    data=json.loads(Path(support['API']['path']).read_bytes())
    rows=controls(data)
    if rows:bad.append(dict(layer=layer,API=support['API'],control_strings=rows))
check('actual_fixed_I11_API_control_literal_located',len(bad)==1 and bad[0]['layer']=='I11' and bad[0]['control_strings'][0]['selector']==['literal_case_catalogue',558,2,1],bad)
fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_time')
pattern=next(n.args[0].value for n in ast.walk(fn) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='fullmatch' and isinstance(n.args[0],ast.Constant))
sample='2026-10-25T00:00:00.'+'\u0660'*6+'+00:00'
check('stdlib_regex_reproduces_nonASCII_fraction_acceptance',re.fullmatch(pattern,sample) is not None and int('\u0660'*6)==0,dict(pattern=pattern,sample=sample))
annex=BASE/'caller_composition_audit_001'/'PROPOSED_HELD_CALLER_EXACT_CONTEXT_PORT_AND_I2_SEAM_ANNEX_001.json'
av=json.loads(annex.read_bytes())
check('adopted_C0_text_clause_recorded','C0 text' in av['strict_value_rules']['all_metadata'],av['strict_value_rules']['all_metadata'])
check('adopted_exact_utc6_clause_recorded','ffffff+00:00' in av['strict_value_rules']['utc6'],av['strict_value_rules']['utc6'])
findings=[dict(id='F01',status='SOURCE_COMPATIBILITY_BLOCKER',evidence=bad,finding='Every _Bound validates exact I11 API007 through Store.record -> _decode -> _tree; generic C0 refusal rejects its deliberate inert negative-test literal before any private path can complete.',required_correction='Separately clarify/adopt exact pinned API descriptive catalogue data policy; preserve field/context C0 rules or explicitly adopt any wider interpretation. Preserve caller002/I2_005 and bind the exact Source successor.'),dict(id='F02',status='EXACT_UTC_TYPED_BOUNDARY',finding='The _time regex uses Unicode \\d; an ASCII calendar/time with Arabic-Indic fractional digits passes fullmatch and int. Exact utc6 spelling should use ASCII [0-9].',required_correction='Use explicit ASCII digit groups, preserving6/7precision and valid calendar checks.')]
full=dict(schema_version=1,record_type='Independent_I12_caller002_I2_005_static_Source_findings_full',reviewer='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),verdict='REFUSE_SOURCE_PENDING_TWO_NARROW_CORRECTIONS',subjects=[pin(caller),pin(i2),pin(BASE/'caller'/'CURRENT_OWNER_HELD_RECEIPT_CALLER_INERT_API_002.json'),pin(BASE/'i2'/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_005.json'),pin(annex)],checks=checks,checks_passed=sum(c['passed'] for c in checks),checks_failed=sum(not c['passed'] for c in checks),findings=findings,method='Complete Source read plus actual fixed-pin metadata/AST/stdlib regex data audit. No target or fixture imported or called; the stdlib regex evidence does not invoke target _time.',public_and_original_entry_holds_intact=True,target_execution=False,operational_authority=False,scientific_authority=False,tests_executed=False,full_G01_closed=False,review_tool=pin(Path(__file__)))
proof=save(OUT/'INDEPENDENT_I12_CALLER002_I2_005_STATIC_FINDINGS_FULL_PROOF_001.json',full)
cap={k:full[k] for k in ('schema_version','reviewer','created_utc','verdict','subjects','checks_passed','checks_failed','findings','method','public_and_original_entry_holds_intact','target_execution','operational_authority','scientific_authority','tests_executed','full_G01_closed')}
cap.update(record_type='Independent_I12_caller002_I2_005_static_Source_findings_capsule',full_proof=proof)
capsule=save(OUT/'INDEPENDENT_I12_CALLER002_I2_005_STATIC_FINDINGS_CAPSULE_001.json',cap)
print(json.dumps(dict(capsule=capsule,full_proof=proof,checks_passed=full['checks_passed'],checks_failed=full['checks_failed']),sort_keys=True))
