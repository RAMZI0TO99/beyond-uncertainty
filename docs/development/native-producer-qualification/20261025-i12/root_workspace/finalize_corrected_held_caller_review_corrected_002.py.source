"""Additive correction of review-check representation/text matches, no target work."""
import ast
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
original=ROOT/'review_final_held_caller_protocol_set_001.py'
raw=original.read_bytes()
tree=ast.parse(raw)
assert all(n.module == 'pathlib' for n in tree.body if isinstance(n,ast.ImportFrom))
text=raw.decode('utf8')
text=text.replace("literal(trees[source],name)==a['inherited_schemas_extracted_from_actual_AST'][prefix]['value']", "json.dumps(literal(trees[source],name),sort_keys=True)==json.dumps(a['inherited_schemas_extracted_from_actual_AST'][prefix]['value'],sort_keys=True)")
text=text.replace("'unconditional typed refusal before parameter inspection' in a['literal_port_signatures']['hold_body']", "'Both precede parameter inspection' in a['literal_port_signatures']['hold_body'] and 'raise CallerError(E_ACTUAL_ENTRY_UNWIRED)' in a['literal_port_signatures']['hold_body']")
text=text.replace("SOURCE_FULL_PROOF_001.json", "SOURCE_FULL_PROOF_002.json").replace("SOURCE_CAPSULE_001.json", "SOURCE_CAPSULE_002.json")
text=text.replace("full=dict(schema_version=1,", "full=dict(review001_preserved_correction='Prior review001 has four false checks caused by this review tool: AST tuple-vs-JSON-list representation in three literals and one exact-text search mismatch. All original subject bytes stayed exact; Source/check signatures, closed key values and early double holds are rechecked here. No target replay/import occurred.',schema_version=1,")
path=ROOT/'review_final_held_caller_protocol_set_002.py'
with path.open('xb') as f:f.write(text.encode('utf8'))
print(json.dumps(dict(path=str(path),bytes=path.stat().st_size,sha256=hashlib.sha256(path.read_bytes()).hexdigest()),sort_keys=True))
