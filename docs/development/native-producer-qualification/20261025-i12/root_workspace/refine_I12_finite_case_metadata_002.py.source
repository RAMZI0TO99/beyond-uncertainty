"""Own case-spec metadata refinement only; fixture and targets remain unrun."""
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
path=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_001.json'
data=json.loads(path.read_text(encoding='utf8'))
for case in data['cases']:
    if case['name'] in ('schema_constructor_API13_version_int1','schema_held_generic_emitter_API14_version_int1'):
        case['name']=case['name'].replace('_int1','_int2')
        case['operations'][0][-1]=2
    if case['name']=='single_extra_role_observation':case['expected']='E_PIN_BYTES'
    if case['name']=='chronology_generation_receipt_before_facts':
        case['operations'].append(['set','generation',['actual_paired_metadata_inputs',0,'observed_utc'],'2026-10-25T00:00:09.000000+00:00'])
    case['first_typed_guard']=case['expected'] if case['expected']!='PASS' else 'No refusal; named positive assertions including exact closed result/flags/counters'
    if case['name']=='ordinary_shared7_index2':case['first_typed_guard']='E_OBSERVATION: declared size equality dominates index2 shared identity equality; same exact guarded size field'
    if case['name']=='ordinary_shared7_index6':case['first_typed_guard']='E_OBSERVATION: nlink==1 dominates index6 shared identity equality; same exact guarded link field'
    if case['name'].startswith('named_checks_'):case['first_typed_guard']='E_NODES: aggregate50000 tree budget dominates10000/10001 named-check semantic length guard; no widened positive maximum claim'
    if case['name']=='single_extra_role_observation':case['first_typed_guard']='E_PIN_BYTES: strongest authenticated phase-role65536 cap applied to ordinary pin before cap equality/raw read'
data['variant_to_exact_literal_cases']={}
for case in data['cases']:data['variant_to_exact_literal_cases'].setdefault(case['category'],[]).append(case['name'])
data['case_name_digest']=hashlib.sha256(('\n'.join(r['name'] for r in data['cases'])+'\n').encode()).hexdigest()
data['schema_version']=2
data['prior_literal_metadata_preserved']=dict(path=str(path),bytes=path.stat().st_size,sha256=hashlib.sha256(path.read_bytes()).hexdigest())
data['corrections']='Version1 API wrong-version cases use int2, not unchanged int1. Extra role observation strongestcap first guard is E_PIN_BYTES. Generation receipt earlier-than-facts case adjusts observation time coherently. No fixture/target run.'
data['not_applicable_and_colimits']=['Single29 has no staging/canonical pair or RENAME8 edge; applicable shared7 versus allowed independent API differences are explicit.','No resource_observation field exists in I12 packet/receipt envelopes; original resource60/RAM/disk predicates remain held in I8/I11 and are not claimed by I12.','Exact metadata2MiB/value depth48/node50000 boundaries are pure constructor tests; graph aggregate50k refusal separately uses open proof padding.','All fixed captured record bodies are nonspent Source/metadata data, separate from recorded75 whitelist observations; none of75spent bodies is read or replayed.']
raw=(json.dumps(data,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
target=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_002.json'
with target.open('xb') as f:f.write(raw)
print(json.dumps(dict(path=str(target),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),case_count=data['case_count'],case_name_digest=data['case_name_digest']),sort_keys=True))
