CAP=2097152
def pairs(items):
    result={}
    for k,v in items:
        if k in result: raise ValueError('duplicate JSON key')
        result[k]=v
    return result
def bad(value): raise ValueError('float/nonfinite')
def pin(path, raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def read(path):
    raw=path.read_bytes(); assert len(raw)<=CAP
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad),raw
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8');assert len(raw)<=CAP
    with path.open('xb') as f:f.write(raw)
    return pin(path,raw)
def schema(fields,record=None,version=None,notes=None):
    value=dict(closed=True,field_count=len(fields),fields=fields)
    if record:value['record_type']=record
    if version is not None:value['schema_version']=version
    if notes:value['notes']=notes
    return value

