    reviewer='/root/project_architecture', created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    verdict='REFUSE_SOURCE_FIXTURE001_SETUP_BLOCKER_AND_FINITE_ADOPTED_VARIANT_GAPS',
    subjects=subjects, checks=checks, checks_passed=len(checks)-failed, checks_failed=failed,
    finite_catalogue=dict(cases=880, positives=173, expected_refusals=707, names_sha256=digest),
    findings=gaps, review_tool=pin(__file__),
    limitations='Static Source/AST/read/hash only. No target or fixture module imported or called; no generated live bundles; no execution or qualification follows.',
    target_execution=False, operational_authority=False, scientific_authority=False,
    caller_or_I2_composition_qualified=False, full_G01_closed=False)
