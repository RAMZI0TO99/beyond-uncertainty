check('typed_kernel_exception_exact_classes', 'type(error) in (formats.I12Error,single.I12Error,peer.I12Error)' in segments['run'])
check('only_named_pass_after_case_success', segments['run'].index("rows.append(dict(name=spec['name'],passed=True))") <
