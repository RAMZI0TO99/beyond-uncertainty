            pin(W / 'i12/I12_FRESH_MEMORY_ONLY_FIXTURE_STATIC_AUTHOR_RECEIPT_001.json'),
            pin(W / 'I12_EXACT_OUTSIDE8_RECEIPT_FORMAT_AND_METADATA_GRAPH_PROTOCOL_002.json'),
            pin(W / 'I12_EXACT_PACKET_RESULT_ACTOR_AND_REFERENCE_TYPE_CLOSURE_COMPANION_001.json')]
