check('builder_finish_graph_copy', 'return copy.deepcopy(dict(packet=packet,records=list(unique.values())' in segments['_Build'])
check('case_spec_deepcopy_before_mutation', 'spec=copy.deepcopy(original)' in segments['run'])
check('case_spec_identity_disjoint', 'assert not _mutable_ids(spec).intersection(_mutable_ids(CASE_CATALOGUE))' in segments['run'])
check('global_fingerprint_after_every_case', 'assert global_snapshot==(_fingerprint(FIXED),_fingerprint(CASE_CATALOGUE))' in segments['run'])
check('mutation_before_after_assertion', 'assert before!=after' in segments['_change'] and
      'assert before!=_fingerprint((build.defs,build.packet))' in segments['_invoke'])
check('postmutation_before_after_assertion', "assert old!=_fingerprint(bundle) or spec['post']=='catalogue_wrong_hash'" in segments['_invoke'])
check('isolation_fixed_sibling_and_output_identities', all(x in segments['_invoke'] for x in [
    '_mutable_ids(a.defs).intersection(_mutable_ids(FIXED))',
