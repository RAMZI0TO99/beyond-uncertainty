    dict(id='F04', status='MISSING_ADOPTED_ALTERNATIVES', requirement='spent unknown identity / zero notwhitelisted / archivecap applied toordinary',
         missing=['unknown special spent path', 'zero ordinary bytes', 'zero special observation on nonempty spent identity',
                  'archive4MiB cap assigned to ordinary observation', 'wrong exact archive cap on actual archived spent row'],
         intended_guard='E_SPENT_IDENTITY or E_PIN_BYTES/E_OBSERVATION as exact first checked predicate; preserve vectors and body joins before it'),
    dict(id='F05', status='MISSING_ADOPTED_ALTERNATIVES', requirement='ordinary/spent vec types/shared/size/nlink/reparse/path/cap with coherent earlier guards',
         missing=['vector nonlist / wrong length / bool item', 'raw9 != path9', 'coherent nlink2', 'coherent reparse attribute',
                  'wrong declared cap with bytes/pin otherwise valid', 'ordinary required observation missing', 'spent malformed vector'],
