"""Independent read/hash/strict-JSON/AST review; no target import or call."""
import ast
import base64
import collections
import datetime as dt
import hashlib
import json
import os
from pathlib import Path

W = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015')
D = W / 'fixture_source_review_001'
P = W / 'i12/test_outside8_receipt_contract_memory_only_001.py'
checks = []

def check(name, ok, detail=None):
    checks.append(dict(name=name, passed=bool(ok), detail=detail))

def pin(path):
    path = Path(path)
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def pairs(rows):
    out = {}
    for key, value in rows:
        assert key not in out
        out[key] = value
    return out

def bad(value):
    raise ValueError('noninteger JSON number')

def load(path):
    return json.loads(Path(path).read_bytes().decode('utf8'), object_pairs_hook=pairs,
                      parse_float=bad, parse_constant=bad)

def wire(value):
    return (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()

def publish(path, value):
    raw = wire(value)
    assert len(raw) <= 2097152
    with path.open('xb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    assert path.read_bytes() == raw

raw = P.read_bytes()
tree = ast.parse(raw)
values = {node.targets[0].id: ast.literal_eval(node.value) for node in tree.body
          if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name)}
cases = values['CASE_CATALOGUE']
names = [c['name'] for c in cases]
mapping = values['VARIANT_TO_LITERAL_CASES']
fixed = values['FIXED']
metadata = load(W / 'i12/I12_FRESH_LITERAL_FIXTURE_CASE_CATALOGUE_001.json')
inventory = load(W / 'i12/I12_FRESH_FIXTURE_SOURCE_REGION_AND_LITERAL_INVENTORY_001.json')
receipt = load(W / 'i12/I12_FRESH_MEMORY_ONLY_FIXTURE_STATIC_AUTHOR_RECEIPT_001.json')
catalogue = load(W / 'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json')
protocol = load(W / 'I12_EXACT_OUTSIDE8_RECEIPT_FORMAT_AND_METADATA_GRAPH_PROTOCOL_002.json')
imports = [n.names[0].name for n in tree.body if isinstance(n, ast.Import)]
functions = {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
segments = {name: ast.get_source_segment(raw.decode(), node) for name, node in functions.items()}
check('fixture_exact_frozen_bytes', pin(P) == receipt['fixture'] == inventory['fixture'] == metadata['fixture'])
check('fixture_bounded_source', len(raw) <= 2097152)
check('only_declared_stdlib_imports', imports == ['base64', 'copy', 'hashlib', 'json', 'types'])
check('no_from_imports', not any(isinstance(n, ast.ImportFrom) for n in ast.walk(tree)))
check('only_literals_imports_definitions_at_module_level', all(
    isinstance(n, (ast.Import, ast.Assign, ast.FunctionDef, ast.ClassDef)) or
    isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant) and isinstance(n.value.value, str)
    for n in tree.body))
check('no_open_exec_eval_importlib_subprocess_in_fixture', not any(
    isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id in
    {'open', 'exec', 'eval', '__import__', 'compile'} for n in ast.walk(tree)))
check('880_unique_literal_names', len(cases) == len(set(names)) == 880)
digest = hashlib.sha256(('\n'.join(names) + '\n').encode()).hexdigest()
check('exact_case_digest', digest == values['CASE_NAME_DIGEST'] == metadata['case_name_digest'] == inventory['case_name_digest'])
check('literal_catalogue_equals_saved_catalogue', cases == metadata['cases'])
check('literal_variant_map_equals_saved', mapping == metadata['variant_to_exact_literal_cases'])
check('all_variant_names_existing', set(n for group in mapping.values() for n in group) == set(names))
counts = collections.Counter(c['expected'] == 'PASS' for c in cases)
check('173_positive_707_refusal', counts[True] == 173 and counts[False] == 707)
check('initial_three_isolation_controls', [c['route'] for c in cases[:3]] == ['isolation'] * 3 and
      [c['mode'] for c in cases[:3]] == ['positive', 'negative', 'sibling'])
for i, c in enumerate(cases, 1):
    check('literal_case_%04d_closed_header' % i, all(type(c[k]) is str and c[k]
          for k in ('name', 'category', 'expected', 'route', 'first_typed_guard')),
          dict(name=c['name'], expected=c['expected']))
    check('literal_case_%04d_variant_membership' % i,
          c['name'] in mapping[c['category']], c['category'])
    for operation in c.get('operations', []):
        check('literal_case_%04d_operation_shape_%s' % (i, len(checks)),
              type(operation) is list and len(operation) >= 3 and
              operation[0] in {'delete', 'set', 'ref', 'append', 'root_set'} and
              type(operation[1]) is str and type(operation[2]) is list)
for label, row in fixed.items():
    body = base64.b64decode(row['body64'], validate=True)
    check('fixed_%s_whole_body' % label,
          len(body) == row['pin']['bytes'] and hashlib.sha256(body).hexdigest() == row['pin']['sha256'])
    check('fixed_%s_actual_current_read' % label, pin(row['pin']['path']) == row['pin'])
check('fixed_capture_not_spent_bodies', not {row['pin']['path'] for row in fixed.values()} &
      {row['path'] for row in catalogue['spent_pin75']})
for group in ('bind_exact_kernel_sources', 'bind_exact_kernel_APIs'):
    for name, p in inventory[group].items():
        check(group + '_' + name, pin(p['path']) == p)
check('builder_fixed_deepcopy', 'self.fixed=copy.deepcopy(FIXED)' in segments['_Build'])
check('builder_catalogue_deepcopy', 'self.catalogue=copy.deepcopy(catalogue)' in segments['_Build'])
check('builder_resolve_copy_return', 'return copy.deepcopy(self.memo[label])' in segments['_Build'] and
