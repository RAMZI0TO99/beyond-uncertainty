"""Read captured metadata, no target or fixture calls."""
import base64
import json
from pathlib import Path
root=Path(__file__).parent
fixed=json.loads((root/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json').read_text(encoding='utf8'))
old=json.loads(base64.b64decode(fixed['old_selection']['body64']).decode('utf8'))
rows={row['role']:row for row in old['rows']}
for role in ('metadata_peer','metadata_bound_review','phase_peer','pipeline_peer','checker_peer'):
    predecessor=json.loads(base64.b64decode(fixed['predecessor_'+role]['body64']).decode('utf8'))
    print(json.dumps(dict(role=role,source_author=predecessor.get('source_author'),row_retained=rows[role]['retained_semantic_Source_author']),sort_keys=True))
