"""Root stdlib-only dated outcome and proposed navigation authoring."""
import datetime as dt
import hashlib
import json
import os
from pathlib import Path

R = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002')
W = R / 'receipt_caller_integration_015'
REPO = Path(r'D:\Aenv\pro2\github-portable-20261012-001')
MANAGED = Path('docs/development/native-producer-qualification/20261025-i12')


def pin(p):
    b = p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())


def managed(p):
    relative = p.relative_to(W) if p.is_relative_to(W) else Path('root_workspace') / p.relative_to(R)
    if p.suffix == '.py':
        relative = Path(str(relative)+'.source')
    return (MANAGED/relative).as_posix()


def reference(p):
    return dict(working_pin=pin(p),managed_path=managed(p))


def save(p,value):
    scope = json.loads((R/'ROOT_CURRENT_I12_RECEIPT_CALLER_SOURCE_SCOPE_001.json').read_bytes())
    assert (dt.datetime.fromisoformat(scope['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
    assert not os.path.lexists(p)
    p.parent.mkdir(parents=True,exist_ok=True)
    raw=(json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    assert len(raw)<=2097152
    with p.open('xb') as h:
        assert h.write(raw)==len(raw)
        h.flush()
        os.fsync(h.fileno())
    return pin(p)


