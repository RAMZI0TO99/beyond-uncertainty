ss=json.loads(source_scope.read_bytes())
assert (dt.datetime.fromisoformat(ss['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
value=dict(schema_version=1,record_type='Root_I12_final_held_caller003_I2_006_different_Source_review_adoption',
    author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
    verdict='ACCEPT_EXACT_HELD_CALLER003_I2_006_SOURCE_PREPARATION_ONLY',
    Source=own['Source'],API=own['API'],caller_Source=own['caller_Source'],caller_API=own['caller_API'],complete_inverse=own['complete_inverse'],
    current_Source_scope=pin(source_scope),exact_four_subject_protocol_adoption=pin(W/'ROOT_I12_HELD_CALLER_I2_FOUR_SUBJECT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'),
    exact_I11_API_descriptive_subtree_protocol_adoption=pin(W/'ROOT_I12_EXACT_I11_API_DESCRIPTIVE_SUBTREE_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'),
    genuine_different_Source_review=pin(sibling_path),different_full_proof=sibling['full_proof'],
    fresh_review_outside_both_current_Source_author_trees=pin(fresh_path),fresh_full_proof=fresh['full_proof'],
    own_whole_byte_and_AST_verification=pin(own_path),checks=dict(sibling_Source=350,fresh_Source=490,Root_protected_bytes_AST=221,failed=0),
    prepared_ports=['I7','I8','I9','I11','I12_single','I12_peer'],
    preserved=dict(original_functions_classes=67,original_assignments=90,complete003_004_005_Source_and_API_inverses=True,
        original_canonical_dependency_false_guard_path_pin_cap_read_prefix=True,original_admit_body_after_two_holds=True,
        all_public_caller_entries_double_held=True,all_original_algorithms_and_caps=True),
    new_caller_Source_bytes=65523,new_caller_Source_cap_bytes=65536,inherited_I2_Source_cap_bytes=2097152,
    scope='Read/hash/strict JSON/AST/compile and exact Source preparation only. No caller/I2/private path or any old target is imported/called/tested. Future complete binding-manifest review, authentic loader, producer/publisher contracts and current lawful admission remain separate.',
    current_request_and_prior_dependency_requests_distinct=True,exact_I11_catalogue_data_exception_only=True,
    current_context_and_operative_metadata_C0_checks_preserved=True,ASCII_UTC_digits=True,
    private_generation_still_blocked_by_I2_admit=True,I7_actual_IO_still_held=True,I6_actual45_adapter_still_unqualified=True,
    selected_peer_helper_requires_completed_dependency9_context=True,canonical_peer_publication_still_unsupported=True,
