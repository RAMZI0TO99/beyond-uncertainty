"""Root own stdlib-only adoption of exact independently reviewed held Source."""
import datetime as dt
import hashlib
import json
from pathlib import Path

R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-002')
W=R/'receipt_caller_integration_015'


def pin(p):
    b=p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())


def review(path,sha,count,who):
    assert pin(path)['sha256']==sha
    v=json.loads(path.read_bytes())
    assert v['reviewer']==who and v['verdict'].startswith('PASS_')
    assert type(v['checks_passed']) is int and v['checks_passed']==count
    assert type(v['checks_failed']) is int and v['checks_failed']==0
    assert v['target_execution'] is False and v['operational_authority'] is False
    fp=Path(v['full_proof']['path'])
    assert pin(fp)==v['full_proof']
    f=json.loads(fp.read_bytes())
    assert len(f['checks'])==count and len({x['name'] for x in f['checks']})==count and all(x['passed'] is True for x in f['checks'])
    assert f['reviewer']==who and f['verdict']==v['verdict']
    return v


