"""Root stdlib-only saved evidence adoption; no target imports or replay."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path

W = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015')
D = W / 'owned_memory_runs/attempt001'


def pin(path):
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def load(path):
    return json.loads(path.read_bytes())


c = W / 'saved_result_different_review_001/INDEPENDENT_I12_ONCE001_SAVED_RESULTS_CAPSULE_001.json'
assert pin(c)['sha256'] == '72b1e18119ef44ffe74c9439da38343bee337a12204df58237ceea60d0a5f839'
review = load(c)
assert review['reviewer'] == '/root/project_architecture' and review['verdict'].startswith('PASS_')
assert type(review['checks_passed']) is int and review['checks_passed'] == 1210
assert type(review['checks_failed']) is int and review['checks_failed'] == 0
fp = Path(review['full_proof']['path'])
assert pin(fp) == review['full_proof']
full = load(fp)
assert len(full['checks']) == 1210 and all(x['passed'] is True for x in full['checks'])
assert len({x['name'] for x in full['checks']}) == 1210
assert full['reviewer'] == review['reviewer'] and full['verdict'] == review['verdict']
s, o = load(D/'SUPERVISOR_RESULT_001.json'), load(D/'ROOT_OUTER_EXECUTION_RESULT_001.json')
console = load(D/'ROOT_SUPERVISOR_STDOUT_001.txt')
child = load(D/'CHILD_RESULT_001.json')
assert console['accepted'] is True and console['refusal'] is None
assert o['actual_parent_exit_code'] == s['exit_code'] == 0
assert s['actual_case_catalogue_valid'] is True and s['child_result']['value'] == child
assert child['passed'] == 1089 and child['failed'] == 0 and child['metadata_only'] is True
for value in (s,o):
    assert value['reaped'] is True and value['streams_drained'] is True
    assert value['terminated'] is False and value['killed'] is False
    assert all(value[k] is False for k in ('actual_family_publication','target_execution','operational_authority','scientific_authority'))
assert all(s['actual_stream_EOF'].values()) and all(x is None for x in s['stream_pump_errors'].values())
assert o['outer_timeout'] is False and o['output_cap_refused'] is False
assert console['final_elapsed_nanoseconds'] == 33375000000 and o['elapsed_nanoseconds'] == 33500000000
fixture = W/'i12/test_outside8_receipt_contract_memory_only_003.py'
t = ast.parse(fixture.read_bytes())
specs = ast.literal_eval(next(n.value for n in t.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='CASE_CATALOGUE' for x in n.targets)))
names = [x['name'] for x in specs]
assert [x['name'] for x in child['cases']] == names and all(x['passed'] is True for x in child['cases'])
assert len(names) == len(set(names)) == 1089
assert sum(x['expected']=='PASS' for x in specs) == 177
events = [json.loads(x) for x in (D/'CHILD_STDOUT_001.txt').read_bytes().splitlines()]
assert events[0] == dict(event='SUITE_ENTRY',case_count=1089)
assert [x['name'] for x in events[1:-1]] == names and all(x['event']=='CASE_PASS' for x in events[1:-1])
assert events[-1] == dict(event='SUITE_COMPLETE',passed=1089,failed=0)
value = dict(schema_version=1,record_type='Root_I12_once001_different_saved_results_adoption',author='/root',
    created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
    verdict='ACCEPT_EXACT_I12_FORMAT36_GENERIC9_PEER5_SYNTHETIC_METADATA_RESULTS_ONLY',
    different_saved_results_review=pin(c),full_proof=review['full_proof'],independent_checks=1210,checks_failed=0,
    fixture=pin(fixture),Source_adoption=pin(W/'ROOT_I12_PURE_FIXTURE003_SUPERVISOR003_OUTER002_SOURCE_ADOPTION_001.json'),
    consumed_once_scope=pin(W/'ROOT_I12_ONCE_SYNTHETIC_MEMORY_SCOPE_001.json'),
    supervisor_result=pin(D/'SUPERVISOR_RESULT_001.json'),child_result=pin(D/'CHILD_RESULT_001.json'),
    child_stdout=pin(D/'CHILD_STDOUT_001.txt'),child_stderr=pin(D/'CHILD_STDERR_001.txt'),
    saved_final_supervisor_console=pin(D/'ROOT_SUPERVISOR_STDOUT_001.txt'),
    Root_outer_execution_witness=pin(D/'ROOT_OUTER_EXECUTION_RESULT_001.json'),
    actual_tool_exit_and_custody_closeout=pin(W/'ROOT_I12_ONCE001_ACTUAL_TOOL_EXIT_AND_CUSTODY_CLOSEOUT_001.json'),
    accepted_cases=dict(passed=1089,failed=0,positive=177,expected_refusals=912),
    accepted_metadata_domains=dict(outside8_format_roles=36,constructor_record_kinds=9,generic_single_graph_roles=9,selected_peer_author_receipt_graph_roles=5),
    inner_final_elapsed_nanoseconds=33375000000,outer_elapsed_nanoseconds=33500000000,
    original_inner_budgets=s['budgets'],suite_invocations=1,owned_child_pid=294540,owned_supervisor_pid=296972,
    owned_reaped_and_drained=True,all_stream_EOF=True,stream_errors_kill_timeout_cap_refusals=False,
    limitations=['Format/schema and declared metadata graph joins only. Historical or synthetic metadata are not physical measurement or human-origin authentication.',
        'Generic9 is not the original M3 dependency DAG. Six closed22 M3 producer/publisher roles and profile/static dependencies remain unsupported.',
        'Selected peer author receipts are not canonical peer publication receipts; all five canonical peer routes remain typed unsupported.',
        'Caller/I2 Source integration remains unrun; I6 domain, I7 actual ports, authentic loader, owner/lease/physical/human eligibility and full I2/G01 remain unqualified.',
        'All75 spent identities stay unreplayed; actual6, family publication, Native8, Parser, runtime and science remain held.'],
    new_pure_synthetic_tests_executed=True,old_I0_through_I11_target_tests_executed=False,
    actual_producer_caller_qualified=False,full_I2_G01_closed=False,Native8_Parser_runtime_science_qualified=False,
    original75_spent_identities_unreplayed=True,whole_host_quiet_or_native_PID_absence_proved=False,
    target_execution=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
out = W/'ROOT_I12_ONCE001_DIFFERENT_SAVED_RESULTS_ADOPTION_001.json'
with out.open('xb') as h:
    h.write((json.dumps(value,indent=2,sort_keys=True)+'\n').encode())
print(json.dumps(pin(out)))
