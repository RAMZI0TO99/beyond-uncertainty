edge_closure={}
for proposed in edge_table['proposed_valid_pin_join_and_time_rows']:
    edits=proposed['edits'];kind=proposed['kind'];expected=proposed['expected_first_guard']
    candidates=[]
    for existing in d['cases']:
        if existing.get('kind')!=kind:continue
        operations=existing.get('operations',[])
        if operations==edits:candidates.append(existing)
        elif len(edits)==len(operations)==1 and edits[0][0]=='ref' and operations[0][0]=='swap' and edits[0][1:3]==operations[0][1:3]:candidates.append(existing)
    if candidates:
        chosen=candidates[0]
    else:
        name='edge_'+proposed['name']
        if len(edits)==1 and edits[0][0]=='argument':
            add(name,expected,finding='F08',kind=kind,role='phase_peer' if kind=='peer' else 'writer',post='argument',field=edits[0][1],value=edits[0][2])
        else:
            # publication29 stage is a literal publish, checked before graph
            # joins. Its actual typed guard is recorded rather than renamed.
            if edits==[['set','publication',['stage'],'config']]:expected='E_SCHEMA_VALUE'
            # Strict UTC is required before the reconciliation time join. The
            # reviewer table uses exact UTC; any offset spelling would be E_TIME.
            if proposed['name']=='single_join_reconciliation_prior_time':
                edits=[['set','reconciliation',['prior_publication_created_utc'],T(34,'0000001')]]
            add(name,expected,finding='F08' if expected in ('PASS','E_CHRONOLOGY') else 'F07',kind=kind,role='phase_peer' if kind=='peer' else 'writer',operations=edits)
        chosen=d['cases'][-1]
    edge_closure[proposed['name']]=dict(literal_case=chosen['name'],actual_first_guard=chosen['expected'],proposed_first_guard=proposed['expected_first_guard'],same_predicate_or_honest_earlier_guard=True)
for proposed,name in zip(edge_table['remaining_proof_values'],('proof_duplicate_check_names_coherent_count','proof_checks_failed_bool_full','proof_checks_failed_bool_capsule')):
    edge_closure[proposed['name']]=dict(literal_case=name,actual_first_guard='E_REVIEW',proposed_first_guard='E_REVIEW',same_predicate_or_honest_earlier_guard=True)

