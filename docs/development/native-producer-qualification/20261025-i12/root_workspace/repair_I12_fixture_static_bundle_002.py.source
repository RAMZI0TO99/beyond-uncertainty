closure={}
def add(name,expected='PASS',finding='F02',kind='single',role='writer',route='graph',**kw):
    assert name not in {r['name'] for r in d['cases']}
    row=dict(name=name,expected=expected,category='STATIC_'+finding,route=route,kind=kind,role=role,first_typed_guard=expected if expected!='PASS' else 'Exact positive metadata result assertions',**kw)
    d['cases'].append(row);closure.setdefault(finding,[]).append(name)
def opcase(name,expected,label,path,value,**kw):
    add(name,expected,operations=[['set',label,path,value]],**kw)
def swap(name,expected,label,path,**kw):
    add(name,expected,operations=[['swap',label,path]],**kw)

# F01: only format-only uncaptured descriptor roles get explicit synthetic data.
closure['F01']=[r['name'] for r in d['cases'] if r['category']=='P_FORMAT36']
for part in ('capsule','full'):
