ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
OUT=BASE/'i12'
CAP=2097152
def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode()
    assert len(raw)<=CAP
    with path.open('xb') as f:f.write(raw)
    return pin(path,raw)
def T(s,f='000000'):return '2026-10-25T00:00:'+str(s).zfill(2)+'.'+f+'+00:00'

prior=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_003.json'
d=json.loads(prior.read_text(encoding='utf8'))
