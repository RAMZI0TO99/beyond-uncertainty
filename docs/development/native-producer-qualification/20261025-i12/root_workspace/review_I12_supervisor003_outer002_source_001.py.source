 'owned_only_terminate_and_kill':"proc.terminate(); terminated = True" in text and "proc.kill(); killed = True" in text,
 'bounded5_5_cleanup_within60':text.count("min(5, 60 - (time.monotonic() - start))")>=3,
 'final_reap_timeout_witness_not_escape':"reason = 'FINAL_REAP_TIMEOUT'" in text and "reaped=proc.returncode is not None" in text,
