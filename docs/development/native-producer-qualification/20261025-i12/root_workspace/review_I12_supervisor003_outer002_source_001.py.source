 'no_frozen_interpreter_fallback':"pinned general-host runtime; no frozen interpreter fallback" in text,
 'actual_authority_flags_false':all(k+'=False' in text for k in ('target_execution','operational_authority','scientific_authority','actual_family_publication')),
