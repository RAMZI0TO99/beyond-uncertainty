check('LF_names_digest_distinct_and_exact',hashlib.sha256(('\n'.join(names)+'\n').encode()).hexdigest()=='803dcd7d5ff30cd4d7c047cd3f6fbcca96532129e2feeb9510ae2995066b83db')
