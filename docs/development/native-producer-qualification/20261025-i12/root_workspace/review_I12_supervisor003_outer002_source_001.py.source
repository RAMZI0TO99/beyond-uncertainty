check('supervisor002_to003_all_function_AST_identical',funcs(st)==funcs(oldtree))
check('supervisor_only_fixture_literal_binding_changed',all(literal(st,n)==literal(oldtree,n) for n in ('SOURCES','CATALOGUE','BUDGETS','EXPECTED_CASE_COUNT','EXPECTED_CASE_NAMES_SHA256','SCOPE_KEYS','OUTPUT_KEYS')))
check('preserved_supervisor002_pin',pin(BASE/'ROOT_I12_ONCE_MEMORY_SUPERVISOR_002.py',old)['sha256']=='67e0ad8b21b2a8a31b652ce3bb92db7de629e4976fe10e2ebf105df79e695038')
