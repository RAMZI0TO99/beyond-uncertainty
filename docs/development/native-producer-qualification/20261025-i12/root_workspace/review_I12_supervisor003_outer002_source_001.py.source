 'outer_no_second_scope_read':otext.count('scope_path.read_bytes()')==0,
 'outer_exact_supervisor_runtime_pins':"pin(supervisor[\"path\"]) != supervisor or pin(sys.executable) != value[\"runtime\"]" in otext,
 'outer_actual_process_exit_custody_saved':"actual_parent_exit_code" in otext and "streams_drained" in otext and "owned_supervisor_pid" in otext,
 'outer_single_launch_no_retry':otext.count('subprocess.Popen(')==1,
 'outer75_5_5_witness_not_inner_widening':"communicate(timeout=75)" in otext and otext.count('communicate(timeout=5)')==2 and 'synthetic_supervisor_total_seconds_unchanged\": 60' in otext,
 'outer_resource_floors_exact':"1073741824" in otext and "10737418240" in otext,
 'outer_no_host_quiet_claim':"whole_host_quiet_or_PID_absence_proved\": False" in otext,
}
for name,ok in clauses.items():check(name,ok)
