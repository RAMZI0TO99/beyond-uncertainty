 'exclusive_claim_precedes_child_launch':text.index("claim = write_new(outputs['claim']")<text.index('proc = subprocess.Popen'),
 'child_claim_parent_pid_join':"claim['parent_pid'] == os.getppid()" in text,
 'child_entry_precedes_module_import':text.index("write_new(outputs['child_entry']")<text.index("formats = load_new("),
 'isolated_child_flags':"sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1" in text,
 'fixed_source_buffer_exec':"exec(compile(raw, pin['path'], 'exec'), module.__dict__)" in text,
 'exact_ModuleType_carrier':"module = types.ModuleType(name)" in text,
