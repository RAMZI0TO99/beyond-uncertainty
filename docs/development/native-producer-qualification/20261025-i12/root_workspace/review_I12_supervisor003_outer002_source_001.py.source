 'stdout_stderr_bounded_pumps':"counts[name] > 2097152" in text and "remaining = 2097152 - len(buffers[name])" in text,
 'real_EOF_and_pump_error_distinction':"drained = threads_finished and all(stream_eof.values()) and not any(pump_errors.values())" in text,
