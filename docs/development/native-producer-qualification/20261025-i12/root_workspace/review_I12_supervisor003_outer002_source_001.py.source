def check(name,ok,evidence=None):checks.append(dict(name=name,passed=bool(ok),evidence=evidence))
def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def raw(path):
    with path.open('rb') as f:b=f.read(2097153)
    assert 0<len(b)<=2097152
    return b
def literal(tree,name):
    return ast.literal_eval(next(n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets)))
def save(path,value):
    b=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode();assert len(b)<=2097152
    with path.open('xb') as f:f.write(b)
    return pin(path,b)
