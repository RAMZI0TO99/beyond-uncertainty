"""Independent metadata-only review. Target bytes are never imported or evaluated."""
import ast
import base64
import datetime as dt
import hashlib
import json
from pathlib import Path

OUT = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\final_independent_review_001')
P = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015')
REVIEWER = '/root/i12_final_review'
CHECKS = []
def sha(raw):
    return hashlib.sha256(raw).hexdigest()
def fact(path):
    raw = Path(path).read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=sha(raw))
def check(name, value, evidence=None):
    if any(c['name'] == name for c in CHECKS):
        raise ValueError('duplicate review check: ' + name)
    row = dict(name=name, passed=value is True)
    if evidence is not None:
        row['evidence'] = evidence
    CHECKS.append(row)
def pairs(items):
    result = {}
    for k, v in items:
        if k in result:
            raise ValueError('duplicate JSON key')
        result[k] = v
    return result
def no_number(value):
    raise ValueError('noninteger JSON number')
def strict(raw):
    text = raw.decode('utf-8', 'strict')
    if text.startswith('\ufeff'):
        raise ValueError('BOM')
    value = json.loads(text, object_pairs_hook=pairs, parse_float=no_number, parse_constant=no_number)
    def tree(v):
        if type(v) is str:
            if any(0xD800 <= ord(c) <= 0xDFFF for c in v):
                raise ValueError('surrogate')
        elif type(v) is dict:
            for k, item in v.items():
                tree(k); tree(item)
        elif type(v) is list:
            for item in v:
                tree(item)
        elif v is not None and type(v) not in (int, bool):
            raise ValueError('JSON type')
    tree(value)
    return value
def read_json(path):
    return strict(Path(path).read_bytes())
def pinned(pin, label):
    raw = Path(pin['path']).read_bytes()
    check(label + '.whole_bytes', len(raw) == pin['bytes'] and sha(raw) == pin['sha256'], pin)
    return raw
def source(pin, label):
    raw = pinned(pin, label)
    text = raw.decode('utf-8', 'strict')
    tree = ast.parse(text, filename=pin['path'])
    compile(tree, pin['path'], 'exec')
    check(label + '.AST_and_compile_only', True)
    return raw, text, tree
def names(tree):
    return {n.name:n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
def assignments(tree):
    result = {}
    for n in tree.body:
        if isinstance(n, ast.Assign):
            for t in n.targets:
                if isinstance(t, ast.Name):
                    result[t.id] = n
    return result
def literal(tree, name):
    return ast.literal_eval(assignments(tree)[name].value)
def segment(text, node):
    return ast.get_source_segment(text, node)
def dump(node):
    return ast.dump(node, include_attributes=False)
def normalized(node):
    return ast.unparse(node)
def method(tree, cls, name):
    return next(n for n in names(tree)[cls].body if isinstance(n, ast.FunctionDef) and n.name == name)
def has(node, fragment):
    return fragment in normalized(node)
def fragments(node, group, entries):
    for label, fragment in entries:
        check(group + '.' + label, has(node, fragment), fragment)
def double_hold(node, flag, error):
    return (len(node.body) >= 2 and isinstance(node.body[0], ast.If)
        and dump(node.body[0].test) == dump(ast.parse('not ' + flag, mode='eval').body)
        and len(node.body[0].body) == 1 and isinstance(node.body[0].body[0], ast.Raise)
        and dump(node.body[0].body[0].exc) == dump(ast.parse(error + "('E_ACTUAL_ENTRY_HELD')", mode='eval').body)
        and not node.body[0].orelse and isinstance(node.body[1], ast.Raise)
        and dump(node.body[1].exc) == dump(ast.parse(error + "('E_ACTUAL_ENTRY_UNWIRED')", mode='eval').body))

