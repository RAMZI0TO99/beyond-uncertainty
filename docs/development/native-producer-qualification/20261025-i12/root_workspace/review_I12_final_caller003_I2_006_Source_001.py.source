class Expand(ast.NodeTransformer):
    def visit_Call(self,node):
        self.generic_visit(node)
        if isinstance(node.func,ast.Name) and node.func.id in ('_value','_binding','_shape'):
            assert len(node.args)==1 and not node.keywords
            return ast.Call(func=ast.Name(id='_need',ctx=ast.Load()),args=[node.args[0],ast.Constant(value={'_value':'E_CONTEXT_VALUE','_binding':'E_BINDING_SOURCE_PIN','_shape':'E_CONTEXT_SCHEMA'}[node.func.id])],keywords=[])
        return node
