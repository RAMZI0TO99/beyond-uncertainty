checks=[]
def check(name,ok,evidence=None):
    checks.append(dict(name=name,passed=bool(ok),evidence=evidence))
def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def pairs(items):
    value={}
    for k,v in items:
        if k in value:raise ValueError('duplicate')
        value[k]=v
    return value
def bad(value):raise ValueError('float/nonfinite')
def strict(path):
    raw=path.read_bytes();assert len(raw)<=CAP
    value=json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    def tree(v):
        if type(v) is str:assert not any(0xD800<=ord(c)<=0xDFFF for c in v)
        elif type(v) is dict:
            for k,x in v.items():tree(k);tree(x)
        elif type(v) is list:
            for x in v:tree(x)
    tree(value);return value,raw
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode('utf8');assert len(raw)<=CAP
    with path.open('xb') as f:f.write(raw)
    return pin(path,raw)
