"""Own additive literal variant metadata author, not fixture execution."""
import base64
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
prior=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_002.json'
d=json.loads(prior.read_text(encoding='utf8'))
fixed=json.loads((ROOT/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json').read_text(encoding='utf8'))
old=json.loads(base64.b64decode(fixed['old_selection']['body64']).decode())
writer=next(i for i,r in enumerate(old['rows']) if r['role']=='writer')
composer=next(i for i,r in enumerate(old['rows']) if r['role']=='composer')
def add(name,expected='PASS',category='B_ADOPTED_EXPLICIT',kind='single',role='writer',route='graph',**kw):
    assert name not in {r['name'] for r in d['cases']}
    d['cases'].append(dict(name=name,expected=expected,category=category,route=route,kind=kind,role=role,first_typed_guard=expected if expected!='PASS' else 'No refusal; coherent equality/limit boundary and exact metadata result assertions',**kw))
def T(second,fraction='000000'):return '2026-10-25T00:00:'+str(second).zfill(2)+'.'+fraction+'+00:00'
for name,label,second in [('code_before_generation','generation_decision',4),('decision_facts','generation_facts',10),('facts_receipt','generation',11),('draft_full_capsule','draft_capsule',20),('draft_capsule_adoption','draft_adoption',21),('draft_adoption_publication_decision','publication_decision',22),('publication_decision_facts','publication_facts',30),('publication_facts_request','request',31),('publication_canonical_full','canonical_full',34),('canonical_full_capsule','canonical_capsule',40),('canonical_capsule_adoption','canonical_adoption',41),('canonical_adoption_recon','reconciliation',42),('recon_full','reconciliation_full',43),('recon_full_capsule','reconciliation_capsule',44),('recon_capsule_adoption','reconciliation_adoption',45)]:
    add('chronology_equal_'+name,operations=[['set',label,['created_utc'],T(second)]])
add('chronology_equal_generation_receipt_review',operations=[['set','draft_full',['created_utc'],T(12)],['set','generation_full',['created_utc'],T(12)]])
for name,value in [('request_canonical_birth',32),('canonical_birth_publication',34)]:add('chronology_equal_'+name,operations=[['set','reconciliation',['canonical_Source_birth_utc'],T(value)]])
add('chronology_equal_final_now',post='argument',field='now_utc',value=T(46))
for name,label,second in [('decision_after_facts','generation_decision',11),('facts_after_receipt','generation_facts',12),('receipt_after_review','generation',20),('draft_capsule_after_adoption','draft_capsule',22),('draft_adopt_after_pubdecision','draft_adoption',30),('pubdecision_after_facts','publication_decision',31),('pubfacts_after_request','publication_facts',32),('request_after_birth','request',33),('recon_after_full','reconciliation',44)]:
    add('chronology_one_tick_'+name,'E_CHRONOLOGY',operations=[['set',label,['created_utc'],T(second,'0000001')]])
add('chronology_one_tick_pub_after_delta_full','E_CHRONOLOGY',operations=[['set','publication',['created_utc'],T(40,'0000001')],['set','reconciliation',['prior_publication_created_utc'],T(40,'0000001')]])
for name,label,second in [('code_decision','decision',4),('decision_content_full','content_full',10),('content_adopt_proposal_full','proposal_full',22),('proposal_adopt_witness','serialization',26),('witness_inverse','inverse',30),('inverse_receipt','receipt',31)]:
    add('peer_chronology_equal_'+name,kind='peer',role='phase_peer',operations=[['set',label,['created_utc'],T(second)]])
add('peer_chronology_equal_now',kind='peer',role='phase_peer',post='argument',field='now_utc',value=T(32))
for field in ('preparation_Source_author','retained_semantic_Source_author'):
    add('successor_actor_null_'+field,'E_ACTOR',operations=[['set','selection',['rows',writer,field],None]])
add('composer_carry_nonnull_draft','E_SELECTION',operations=[['set','selection',['rows',composer,'draft_path'],'D:\\I12\\illegal_composer.json']])
add('proof_open_extra_metadata',operations=[['set','canonical_capsule',['extra_metadata'],{'unrecognized':'inert data'}],['set','canonical_full',['extra_metadata'],{'unrecognized':['inert data']}],['set','canonical_adoption',['extra_metadata'],{'unrecognized':False}]])
add('source_editor512',post='argument',field='source_editor',value='/root/'+'a'*506)
add('source_editor513','E_ACTOR',post='argument',field='source_editor',value='/root/'+'a'*507)
parts=[];remaining=32767-3
while remaining>255:
    parts.append('a'*255);remaining-=256
parts.append('a'*remaining)
longpath='D:\\'+'\\'.join(parts);assert len(longpath)==32767
add('constructor_native_path32767',route='format',record_kind='single_request14_v2',label='request',operations=[['set','request',['canonical_path'],longpath]])
d['case_count']=len(d['cases']);d['case_name_digest']=hashlib.sha256(('\n'.join(r['name'] for r in d['cases'])+'\n').encode()).hexdigest()
d['counts']=dict(positive=sum(r['expected']=='PASS' for r in d['cases']),expected_refusals=sum(r['expected']!='PASS' for r in d['cases']))
d['variant_to_exact_literal_cases']={}
for case in d['cases']:d['variant_to_exact_literal_cases'].setdefault(case['category'],[]).append(case['name'])
d['prior_literal_metadata_preserved']=dict(path=str(prior),bytes=prior.stat().st_size,sha256=hashlib.sha256(prior.read_bytes()).hexdigest())
d['schema_version']=3
d['boundary_completeness']='Added coherent equality edges, one100ns tick invalid chronology edges, null successor/composer exception, exact path32767 and actor512/513, open proof extras. Existing003kernel strictguards unchanged. Still no target/fixture import/call.'
raw=(json.dumps(d,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=ROOT/'I12_FRESH_FINITE_CASE_CATALOGUE_METADATA_003.json'
with path.open('xb') as f:f.write(raw)
print(json.dumps(dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),case_count=d['case_count'],case_name_digest=d['case_name_digest'],counts=d['counts']),sort_keys=True))
