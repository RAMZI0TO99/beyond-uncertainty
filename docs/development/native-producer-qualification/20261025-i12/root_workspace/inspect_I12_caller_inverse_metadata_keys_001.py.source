"""Own read-only metadata inspection; no target import/call."""
import json
from pathlib import Path
path=Path(__file__).parent/'receipt_caller_integration_015'/'i2'/'I2_SOURCE003_TO005_COMPLETE_INVERSE_AND_PROTECTED_BYTES_AST_001.json'
data=json.loads(path.read_bytes())
for key,value in data.items():
    if type(value) is str:summary=('str '+str(len(value))) if len(value)>200 else value
    elif type(value) is list:summary=dict(type='list',length=len(value),first=value[:1])
    elif type(value) is dict:summary=dict(type='dict',keys=list(value))
    else:summary=value
    print(json.dumps(dict(key=key,summary=summary),sort_keys=True))
