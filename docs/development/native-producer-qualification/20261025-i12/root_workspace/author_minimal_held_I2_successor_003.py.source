"""Own read/AST/Source authoring; never imports or calls any I2/caller target."""
import ast
import base64
import datetime as dt
import hashlib
import json
import os
from pathlib import Path

W = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015')
D = W / 'i2'
D.mkdir(exist_ok=True)
AUDIT = W / 'caller_composition_audit_001'


def pin(path):
    path = Path(path)
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def load(path):
    return json.loads(Path(path).read_bytes())


def wire(value):
    return (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()


def publish(path, raw):
    with path.open('xb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
    assert path.read_bytes() == raw


base_protocol = load(AUDIT / 'PROPOSED_HELD_RECEIPT_CALLER_COMPOSITION_SOURCE_PROTOCOL_001.json')
source_read_pin = base_protocol['pinned_inputs']['I2_Source003']
api_read_pin = base_protocol['pinned_inputs']['I2_API003']
old = Path(source_read_pin['path']).read_bytes()
old_api_raw = Path(api_read_pin['path']).read_bytes()
old_api = json.loads(old_api_raw)
old_declared_source = old_api['Source']
old_declared_api = pin(Path(old_declared_source['path']).parent / Path(api_read_pin['path']).name)
assert old == Path(old_declared_source['path']).read_bytes()
assert old_api_raw == Path(old_declared_api['path']).read_bytes()
assert pin(source_read_pin['path']) == source_read_pin and pin(api_read_pin['path']) == api_read_pin
caller_source = pin(W / 'caller/compose_current_owner_receipt_caller_003.py')
caller_api = pin(W / 'caller/CURRENT_OWNER_HELD_RECEIPT_CALLER_INERT_API_003.json')
new_source_path = D / 'build_M3_metadata_current_owner_deferred_006.py'
new_api_path = D / 'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_006.json'
inventory_path = D / 'I2_SOURCE003_TO006_COMPLETE_INVERSE_AND_PROTECTED_BYTES_AST_001.json'
receipt_path = D / 'I2_HELD_RECEIPT_CALLER_SOURCE_ACTUAL_AUTHOR_RECEIPT_003.json'
assert all(not p.exists() for p in [new_source_path, new_api_path, inventory_path, receipt_path])
text = old.decode('utf-8')
transforms = []


def replace(before, after, why):
    global text
    assert text.count(before) == 1, why
    text = text.replace(before, after, 1)
    transforms.append(dict(reason=why, removed_utf8=before, inserted_utf8=after))


first_line = text.splitlines(keepends=True)[0]
replace(first_line, repr('Held owner-v2 M3 Source successor; actual physical Source editor /root/project_architecture. '
    'Protected original Source003 editor /root/i10_caller_frontier retained as dated attribution; all historical '
    'M3/Pipeline and payload semantic nominals preserved. Every stage is unconditionally held before I0/gate/IO. '
    'The receipt caller hook is prepared Source only; no actual composition qualification.') + '\n', 'truthful docstring provenance')
replace('import stat\n', 'import stat\nimport types\n', 'declared stdlib mechanical module types')
replace("HERE = Path('D:\\\\Aenv\\\\pro2\\\\WORK\\\\resume-20261017-001\\\\producer_caller_qualification_013\\\\i2')",
        'HERE = Path(' + repr(str(D)) + ')', 'new Source-only output namespace')
replace("SELF = HERE/'build_M3_metadata_current_owner_deferred_003.py'",
        "SELF = HERE/'build_M3_metadata_current_owner_deferred_006.py'", 'new self identity')
replace("API_PATH = HERE/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_003.json'",
        "API_PATH = HERE/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_006.json'", 'new API identity')
replace("\nEDITOR = '/root/i10_caller_frontier'\n", "\nEDITOR = '/root/project_architecture'\n", 'new actual Source author')
replace("BINDING_SOURCE_EDITOR = '/root/i10_caller_frontier'", "BINDING_SOURCE_EDITOR = '/root/project_architecture'",
        'new actual binding Source editor')
marker = 'EXTERNAL_CANONICAL_RECEIPT_ABI_QUALIFIED = False\n'
added = marker + (
    'I2_RECEIPT_CALLER_OPERATIONAL_ENTRY_QUALIFIED = False\n'
    "IMMEDIATE_PREDECESSOR_BINDING_SOURCE_EDITOR = '/root/project_architecture'\n"
    '_I12_HELD_CALLER_MODULE = None\n'
    '_I12_HELD_CALLER_SOURCE = ' + repr(caller_source) + '\n'
    '_I12_HELD_CALLER_API = ' + repr(caller_api) + '\n'
    "_I12_HELD_CALLER_NAME = '_held_current_owner_receipt_caller'\n")
replace(marker, added, 'literal held caller code identities and private session slot')
old_tree = ast.parse(old)
functions = {node.name: node for node in old_tree.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))}
lines = text.splitlines(keepends=True)
start = text.index('def canonical_dependency(support, rows, selection_pin):\n')
end = text.index('\n\ndef assignments(data):', start)
old_canonical = text[start:end]
prefix = old_canonical[:old_canonical.index('    receipt = strict_source_json')]
new_canonical = prefix + '''    caller = _I12_HELD_CALLER_MODULE
    if type(caller) is not types.ModuleType:
        raise I2ReceiptCallerError('E_GENERATION_SESSION_REQUIRED')
    for pin, field, body_field in ((_I12_HELD_CALLER_SOURCE, '__source_pin__', '__source_bytes__'),
                                    (_I12_HELD_CALLER_API, '__api_pin__', '__api_bytes__')):
        body = getattr(caller, body_field, None)
        if (getattr(caller, field, None) != pin or type(body) is not bytes or
                len(body) != pin['bytes'] or hashlib.sha256(body).hexdigest() != pin['sha256']):
            raise I2ReceiptCallerError('E_BINDING_SOURCE_PIN')
    dispatch = caller.__dict__.get('_I2_canonical_dependency_dispatch')
    if (caller.__name__ != _I12_HELD_CALLER_NAME or caller.__file__ != _I12_HELD_CALLER_SOURCE['path'] or
            type(dispatch) is not types.FunctionType or dispatch.__name__ != '_I2_canonical_dependency_dispatch' or
            dispatch.__globals__ is not caller.__dict__ or dispatch.__code__.co_filename != caller.__file__):
        raise I2ReceiptCallerError('E_BINDING_SOURCE_PIN')
    answer = caller._I2_canonical_dependency_dispatch(support=support, rows=rows, selection_pin=selection_pin)
    if (type(answer) is not tuple or len(answer) != 2 or type(answer[0]) is not dict or
            type(answer[1]) is not bytes or answer[0] != pin_original or answer[1] != raw):
        raise I2ReceiptCallerError('E_LAYER_CONTEXT_JOIN')
    return pin_original, raw
'''
# Keep the original selected pin variable independent of the metadata-check loop.
new_canonical = new_canonical.replace('    caller = _I12_HELD_CALLER_MODULE\n',
    '    pin_original = pin\n    caller = _I12_HELD_CALLER_MODULE\n', 1)
local_error = '''class I2ReceiptCallerError(ValueError):
    """Typed errors for new held caller paths only; no target load required."""
    __slots__ = ('code',)

    def __init__(self, code):
        self.code = code
        super().__init__(code)


'''
replace(old_canonical, local_error + new_canonical, 'only legacy external receipt interpretation replaced; selected pin checks and false ABI guard retained')
hold = '''def admit(args):
    if not I2_RECEIPT_CALLER_OPERATIONAL_ENTRY_QUALIFIED:
        raise I2ReceiptCallerError('E_ACTUAL_ENTRY_HELD')
    raise I2ReceiptCallerError('E_ACTUAL_ENTRY_UNWIRED')
'''
replace('def admit(args):\n', hold, 'first admit statements unconditionally hold even zero-dependency templates before reads/gate/imports')
new = text.encode('utf-8')
assert len(new) <= 2097152
new_tree = ast.parse(new)
compile(new, str(new_source_path), 'exec')  # Not executed.
new_functions = {node.name: node for node in new_tree.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))}
protected = []
for name, node in functions.items():
    if name not in ('canonical_dependency', 'admit'):
        assert ast.dump(node, include_attributes=False) == ast.dump(new_functions[name], include_attributes=False), name
        old_piece = b''.join(old.splitlines(keepends=True)[node.lineno-1:node.end_lineno])
        nn = new_functions[name]
        new_piece = b''.join(new.splitlines(keepends=True)[nn.lineno-1:nn.end_lineno])
        assert old_piece == new_piece, name
        protected.append(dict(name=name, bytes=len(old_piece), sha256=hashlib.sha256(old_piece).hexdigest()))
assert ast.dump(ast.Module(body=functions['admit'].body, type_ignores=[]), include_attributes=False) == ast.dump(
    ast.Module(body=new_functions['admit'].body[2:], type_ignores=[]), include_attributes=False)
allowed_assignments = {'HERE', 'SELF', 'API_PATH', 'EDITOR', 'BINDING_SOURCE_EDITOR'}
def assignments(tree):
    return {node.targets[0].id: node for node in tree.body if isinstance(node, ast.Assign) and
            len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)}
old_assign, new_assign = assignments(old_tree), assignments(new_tree)
for name, node in old_assign.items():
    if name not in allowed_assignments:
        assert ast.dump(node, include_attributes=False) == ast.dump(new_assign[name], include_attributes=False), name
assert ast.literal_eval(new_assign['EXTERNAL_CANONICAL_RECEIPT_ABI_QUALIFIED'].value) is False
source_pin = dict(path=str(new_source_path), bytes=len(new), sha256=hashlib.sha256(new).hexdigest())
api = json.loads(old_api_raw)
api.update(Source=source_pin, author='/root/project_architecture', actual_binding_Source_editor='/root/project_architecture',
    created_utc=dt.datetime.now(dt.timezone.utc).isoformat(), tests_executed=False,
    immediate_predecessor_actual_binding_Source_editor='/root/project_architecture',
    immediate_predecessor_Source=pin(D/'build_M3_metadata_current_owner_deferred_005.py'),
    immediate_predecessor_API=pin(D/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_005.json'),
    protected_original_Source003=old_declared_source, protected_original_API003=old_declared_api,
    external_canonical_receipt_ABI_qualified=False,
    I12_held_caller_Source_integration=dict(caller_Source=caller_source, caller_API=caller_api,
        dispatcher='_I2_canonical_dependency_dispatch', session_slot='_I12_HELD_CALLER_MODULE',
        caller_module_name='_held_current_owner_receipt_caller', I2_module_name='_held_current_owner_M3_producer',
        local_error_class='I2ReceiptCallerError', admit_hold='LiteralFalse plus unconditional refusal before original body',
        full_I2_G01_closed=False, semantic_composition_tested=False, actual_loader_qualified=False,
        operational_authority=False, target_execution=False,
        exact_protocol_Root_adoption=pin(W/'ROOT_I12_HELD_CALLER_I2_FOUR_SUBJECT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'),
        cap_domain_clarification=pin(W/'ROOT_I12_NEW_PURE_MODULE_AND_INHERITED_CODE_CAP_DOMAIN_CLARIFICATION_001.json')))
api_raw = wire(api)
inventory = dict(record_type='I2_Source003_to006_complete_inverse_and_protected_bytes_AST', schema_version=1,
    author='/root/project_architecture', created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    prior_Source=old_declared_source, prior_API=old_declared_api, managed_read_Source=source_read_pin,
    managed_read_API=api_read_pin, new_Source=source_pin, complete_prior_Source_base64=base64.b64encode(old).decode(),
    complete_prior_API_base64=base64.b64encode(old_api_raw).decode(), transformations=transforms,
    protected_functions_and_classes=protected, protected_function_count=len(protected),
    unchanged_admit_original_body_AST=True, canonical_signature_and_prefix_retained=True,
    unchanged_existing_assignments_except=sorted(allowed_assignments), original_assignment_count=len(old_assign),
    unchanged_assignment_count=len(old_assign)-len(allowed_assignments),
    added_names=sorted(set(new_functions)-set(functions)), added_assignments=sorted(set(new_assign)-set(old_assign)),
    previous_held_Source004=pin(D/'build_M3_metadata_current_owner_deferred_004.py'),
    previous_held_API004=pin(D/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_004.json'),
    complete_previous_held_Source004_base64=base64.b64encode((D/'build_M3_metadata_current_owner_deferred_004.py').read_bytes()).decode(),
    complete_previous_held_API004_base64=base64.b64encode((D/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_004.json').read_bytes()).decode(),
    previous_held_Source005=pin(D/'build_M3_metadata_current_owner_deferred_005.py'),
    previous_held_API005=pin(D/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_005.json'),
    complete_previous_held_Source005_base64=base64.b64encode((D/'build_M3_metadata_current_owner_deferred_005.py').read_bytes()).decode(),
    complete_previous_held_API005_base64=base64.b64encode((D/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_005.json').read_bytes()).decode(),
    all_original_render_codec_inverse_gates_writes_caps_dependency_algorithms_unchanged=True,
    existing_Source_cap_2097152_unchanged=True, all_retained_semantic_nominals_unchanged=True,
    no_target_imports_calls_tests=True, target_execution=False, operational_authority=False, scientific_authority=False)
assert len(api_raw) <= 2097152 and len(wire(inventory)) <= 2097152
publish(new_source_path, new)
publish(new_api_path, api_raw)
publish(inventory_path, wire(inventory))
receipt = dict(record_type='Actual_I2_held_caller_Source_successor_author_receipt', schema_version=1,
    author='/root/project_architecture', created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    Source=pin(new_source_path), API=pin(new_api_path), inverse=pin(inventory_path), caller_Source=caller_source,
    caller_API=caller_api, author_tool=pin(__file__), prior_Source=old_declared_source, prior_API=old_declared_api,
    preserved_protected_function_count=len(protected), original_admit_body_preserved_after_hold=True,
    original_assignment_count=len(old_assign), protected_assignment_count=len(old_assign)-len(allowed_assignments),
    actual_new_Source_editor='/root/project_architecture', immediate_prior_actual_editor='/root/project_architecture',
    protected_original_basis_actual_editor='/root/i10_caller_frontier',
    historical_and_payload_semantic_nominals_retained=True, target_imports=0, target_calls=0,
    target_execution=False, tests_executed=False, operational_authority=False, scientific_authority=False,
    external_canonical_receipt_ABI_qualified=False, actual_loader_qualified=False, full_I2_G01_closed=False)
publish(receipt_path, wire(receipt))
print(json.dumps(dict(Source=pin(new_source_path), API=pin(new_api_path), inverse=pin(inventory_path), receipt=pin(receipt_path))))
