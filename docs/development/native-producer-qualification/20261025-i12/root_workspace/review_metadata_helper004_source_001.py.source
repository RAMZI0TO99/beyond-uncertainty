"""Independent metadata publisher Source review, read/AST only; no helper execution."""
import ast
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-002')
P=R/'prepare_I12_managed_candidate_004.py'
def pin(p):
    raw=p.read_bytes();return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
raw=P.read_bytes();tree=ast.parse(raw)
functions={n.name:ast.get_source_segment(raw.decode(),n) for n in tree.body if isinstance(n,ast.FunctionDef)}
checks=[]
def check(name,yes):checks.append(dict(name=name,passed=bool(yes)))
check('exact_frozen004',pin(P)['sha256']=='d0938666ff214029ac42402a0e3bc93214c78bc047f3b0bfae53e8f69582b157')
check('only_stdlib_imports',all((isinstance(n,ast.Import) and all(x.name in {'datetime','hashlib','json','os','sys'}for x in n.names)) or
                             (isinstance(n,ast.ImportFrom) and n.module=='pathlib') for n in tree.body if isinstance(n,(ast.Import,ast.ImportFrom))))
check('no_target_imports_calls_or_native_tools',not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in {'exec','eval','compile','__import__'} for n in ast.walk(tree)))
check('source_paths_literal_fixed',all(s in raw.decode() for s in ['github-portable-20261012-001','20261025-i12','ROOT_CURRENT_I12_RECEIPT_CALLER_SOURCE_SCOPE_001.json']))
check('all_read_paths_ordinary',all(s in functions['body'] for s in ['path.is_absolute()','p.lstat()','not p.is_symlink()','st_file_attributes','a.st_nlink == 1']))
check('bounded_two_complete_reads',functions['body'].count('h.read(CAP + 1)')==2 and 'raw == again' in functions['body'])
check('stable_identity_metadata',all(s in functions['body']for s in ['st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','len(raw) == a.st_size == b.st_size']))
check('scope_now_after_retained_scope_read',functions['fresh'].index('raw = body(SCOPE)')<functions['fresh'].index('now = dt.datetime.now'))
check('scope_pin_same_retained_bytes', 'return pin(SCOPE, raw)' in functions['fresh'])
check('scope_original60_reserve',"total_seconds() > 60"in functions['fresh'])
check('scope_source_only_root_flags',all(s in functions['fresh']for s in ["scope['author'] == '/root'","scope['target_execution'] is False","scope['operational_authority'] is False"]))
check('save_unused_lexists_twice',functions['save'].count('not os.path.lexists(path)')==2)
check('save_ordinary_parent_pre_and_post_mkdir',functions['save'].count('not parent.is_symlink()')==2)
check('save_fresh_before_mkdir',functions['save'].index('fresh()')<functions['save'].index('path.parent.mkdir'))
check('save_fresh_before_exclusive_open',functions['save'].rindex('fresh()')<functions['save'].index("path.open('xb')"))
check('exclusive_write_fsync_readback',all(s in functions['save']for s in ["path.open('xb')",'h.write(raw) == len(raw)','h.flush()','os.fsync(h.fileno())','body(path) == raw']))
check('baseline149_6_2_explicit',all(s in functions['baseline']for s in ["len(value['status_records']) == 149","len(value['primary_documents']) == 6","len(value['canonical_manifests']) == 2"]))
check('baseline_pointer_and_whole_pins',"value['current_workspace_pointer']"in functions['baseline'] and "pin(Path(p['path'])) == p"in functions['baseline'])
check('prepared_nav_dedicated_directory',"nav.is_relative_to(PUB) and nav.is_file()"in functions['prepare'])
check('prepare_unused_dest_nav_lexists',"not os.path.lexists(DEST)"in functions['prepare'] and "not os.path.lexists(REPO / 'CONTINUE_CURRENT_I12_20261025.json')"in functions['prepare'])
check('metadata_inert_allowlist_only',"('.json', '.py', '.txt', '.source', '.draft')"in functions['prepare'])
check('python_suffix_only_no_byte_transform',"Path(str(relative) + '.source')"in functions['prepare'])
check('bounded512_64MiB_inventory',"len(rows) <= 512"in functions['prepare'] and '<= 67108864'in functions['prepare'])
check('casefold_destination_uniqueness',"x['destination'].casefold()"in functions['prepare'])
check('preflight_all_absent_before_candidate',"all(not os.path.lexists(x['destination'])"in functions['prepare'])
check('adoption_exact_candidate_pin',"occurs(adopted, candidate_pin)"in functions['publish'])
check('same_reviewed_helper',"value['publication_helper'] == pin(Path(__file__))"in functions['publish'])
check('fixed_index_destination',"index == DEST / 'MANAGED_I12_PORTABILITY_INDEX_001.json'"in functions['publish'])
check('publish_destination_containment',"destination.is_relative_to(DEST) or destination == REPO / 'CONTINUE_CURRENT_I12_20261025.json'"in functions['publish'])
check('all_sources_preflight_before_first_copy',functions['publish'].index("pin(source) == row['source']")<functions['publish'].index('actual = []'))
check('source_rechecked_at_copy',"pin(Path(row['source']['path']), raw) == row['source']"in functions['publish'])
check('index_and_receipt_same_guarded_save',"index_pin = save(index, wire(indexed))"in functions['publish'] and "receipt_pin = save(PUB / 'ROOT_I12_ACTUAL_MANAGED_CREATION_RECEIPT_001.json'"in functions['publish'])
check('baseline_rechecked_after_creation',"final_preservation=baseline()"in functions['publish'])
check('partial_failure_no_delete_rollback',not any(isinstance(n,ast.Attribute) and n.attr in {'unlink','rmdir','remove','replace','rename'} for n in ast.walk(tree)))
check('no_git_stage_commit_push',all(s not in raw.decode()for s in ['subprocess','git add','git commit','git push']))
check('reporting_all_authority_false',all(s in functions['publish']for s in ['target_execution=False','operational_authority=False','scientific_authority=False','actual_family_publication=False']))
assert all(c['passed']for c in checks),[c for c in checks if not c['passed']]
baseline=R/'ROOT_I12_INITIAL_REPOSITORY_BYTES_BASELINE_001.json'
scope=R/'ROOT_CURRENT_I12_RECEIPT_CALLER_SOURCE_SCOPE_001.json'
result=dict(schema_version=1,record_type='Independent_Root_metadata_publication_helper004_Source_review',
    reviewer='/root/project_architecture',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    verdict='PASS_SOURCE_ADDITIVE_INERT_METADATA_HELPER004_ONLY',subjects=[pin(P),pin(baseline),pin(scope)],
    checks=checks,checks_passed=len(checks),checks_failed=0,
    prior003_source=pin(R/'prepare_I12_managed_candidate_003.py'),
    resolved_findings=['Reserve renewed in save before mkdir/exclusive open, also candidate/index/receipt paths',
                       'Exact primary6/canonical2 counts checked', 'Initial destination/nav absence uses lexists'],
    scope='Static Source acceptance only. Future exact candidate, its genuine review and Root adoption are still required before publication. No candidate/managed write performed by reviewer. Actual readback needs a separate saved-results review.',
    limits='Containment is literal dedicated destination plus exact candidate/adoption joins; no loader, physical provenance, whole-host quiet or target qualification claim. Partial created files remain on refusal, no rollback.',
    target_execution=False,operational_authority=False,scientific_authority=False)
D=R/'metadata_publication_helper_review_001';D.mkdir(exist_ok=True)
q=D/'INDEPENDENT_ROOT_METADATA_PUBLICATION_HELPER004_SOURCE_CAPSULE_001.json'
b=(json.dumps(result,sort_keys=True,indent=2)+'\n').encode()
with q.open('xb')as s:s.write(b);s.flush();os.fsync(s.fileno())
assert q.read_bytes()==b
print(json.dumps(dict(capsule=pin(q),checks=len(checks))))
