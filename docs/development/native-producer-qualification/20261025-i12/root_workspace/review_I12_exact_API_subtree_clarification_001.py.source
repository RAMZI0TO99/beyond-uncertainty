"""Different read/hash/strict-JSON protocol reviewer; no target import/call."""
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
OUT=BASE/'caller_API_subtree_protocol_different_review_001'
OUT.mkdir(exist_ok=False)
checks=[]
def check(name,ok,evidence=None):checks.append(dict(name=name,passed=bool(ok),evidence=evidence))
def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def pairs(rows):
    out={}
    for k,v in rows:
        if k in out:raise ValueError('duplicate')
        out[k]=v
    return out
def reject(v):raise ValueError('noninteger JSON')
def load(path):
    with path.open('rb') as f:b=f.read(2097153)
    assert 0<len(b)<=2097152
    v=json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
    return v,b
def save(path,v):
    raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
    with path.open('xb') as f:f.write(raw)
    return pin(path,raw)
path=BASE/'ROOT_I12_EXACT_I11_API_DESCRIPTIVE_SUBTREE_PROTOCOL_CLARIFICATION_001.json'
v,b=load(path)
check('exact_Root_proposed_clarification_pin',(len(b),hashlib.sha256(b).hexdigest())==(6425,'1a57bdefa5f9c8f8348543cefb0ac91dd33cf8da66e217fe996bd09a3d946530'),pin(path,b))
check('exact_Root_author_version_type',v['author']=='/root' and type(v['schema_version']) is int and v['schema_version']==1 and v['record_type']=='Root_I12_exact_I11_API_descriptive_subtree_protocol_clarification')
for key in ('accepted_four_subject_protocol_adoption','current_Source_scope','exact_annex','exact_fixed_I11_API','exact_prior_held_caller_Source'):
    p=v[key];actual=pin(Path(p['path']))
    check('actual_subject_pin_'+key,actual==p,p)
check('exact_full_fact3_selector',v['exact_exception_selector']==dict(record_pin=v['exact_fixed_I11_API'],root_field='literal_case_catalogue'))
api,apib=load(Path(v['exact_fixed_I11_API']['path']))
selector=v['observed_compatibility_evidence']['C0_selector'];value=api
for part in selector:value=value[part]
check('actual_C0_descriptive_negative_vector',type(value) is str and any(ord(c)<32 for c in value),dict(selector=selector,value=value))
for selector in v['observed_compatibility_evidence']['actor_example_selectors']:
    item=api
    for part in selector:item=item[part]
    check('actual_nonactor_negative_examples_'+'_'.join(map(str,selector)),type(item) is dict and any(x is False for x in item.values()),dict(selector=selector,value=item))
scope,_=load(Path(v['current_Source_scope']['path']))
now=dt.datetime.now(dt.timezone.utc)
check('current_Source_scope_window',dt.datetime.fromisoformat(scope['interval_start'])<=now<dt.datetime.fromisoformat(scope['interval_end']))
check('Root_scope_authority_held',scope['author']=='/root' and scope['target_execution'] is False and scope['operational_authority'] is False)
rules=v['exact_rules']
requirements=[('exact pin only, no arbitrary exemption',0,('complete exact fact3 equality','No path-only','caller boolean')),('root subtree only',1,('root literal_case_catalogue','any other record','nested occurrence','no exception')),('entire subtree still strictly bounded/countable',2,('whole hash','no BOM/floats/nonfinite/surrogates','depth48','shared50000','Count every parsed node')),('context/otherpart C0 retained',3,('only inside','all other ordinary records','all other parts','retain')),('semantic discovery opaque only exact subtree',4,('Exclude only this exact descriptive subtree','author derivation','pin/reference/edge','Do not compile')),('operative API provenance mandatory',5,('Source, author, editor','code5 review/adoption','false authority')),('copy/cache same boundary, preserve inert bytes',6,('decoding/copy/cache','same exact record/root-field boundary','no inherited allow flag')),('budgets/rosters not widened',7,('shared aggregate node counter','256records/32MiB','2MiB','Never hide examples','truncate')),('ASCII time restores contract',8,('ASCII[0-9]','existing exact-spelling')),('Source authoring review then Root adoption',9,('only after different Source review','separate Root adoption','65536','2097152')),('all operational gates held',10,('No original or new caller/I2 import/function/main/test','Public literal-false','unconditional second refusals'))]
for name,index,terms in requirements:check(name,all(term in rules[index] for term in terms),rules[index])
for key in ('target_execution','operational_authority','scientific_authority','actual_family_publication','authentic_loader_qualified','full_I2_G01_closed','tests_executed'):check('authority_false_'+key,v[key] is False)
for key in ('current_context_C0_policy_unchanged','other_fixed_API_policy_unchanged','shared_node_and_byte_budgets_unchanged','whole_API_bytes_preserved'):check('retained_'+key,v[key] is True)
full=dict(schema_version=1,record_type='Independent_I12_exact_API_descriptive_subtree_protocol_Source_review_full',reviewer='/root/i2_resume_gap',created_utc=now.isoformat(),verdict='PASS_SOURCE_EXACT_I11_API_ROOT_CATALOGUE_ONLY_CLARIFICATION' if all(c['passed'] for c in checks) else 'REFUSE_SOURCE',checks=checks,checks_passed=sum(c['passed'] for c in checks),checks_failed=sum(not c['passed'] for c in checks),subjects=[pin(path,b)],method='Genuine full protocol read and exact referenced bytes/strict JSON/control-vector data inspection. No target, caller, fixture, supervisor or old module imported/called.',Root_adoption_still_required=True,operational_authority=False,target_execution=False,scientific_authority=False,tests_executed=False,full_G01_closed=False,review_tool=pin(Path(__file__)))
proof=save(OUT/'INDEPENDENT_I12_EXACT_API_SUBTREE_PROTOCOL_SOURCE_FULL_PROOF_001.json',full)
cap={k:full[k] for k in ('schema_version','reviewer','created_utc','verdict','checks_passed','checks_failed','subjects','method','Root_adoption_still_required','operational_authority','target_execution','scientific_authority','tests_executed','full_G01_closed')}
cap.update(record_type='Independent_I12_exact_API_descriptive_subtree_protocol_Source_review_capsule',full_proof=proof)
capsule=save(OUT/'INDEPENDENT_I12_EXACT_API_SUBTREE_PROTOCOL_SOURCE_CAPSULE_001.json',cap)
print(json.dumps(dict(capsule=capsule,full_proof=proof,checks_passed=full['checks_passed'],checks_failed=full['checks_failed'],failed=[c for c in checks if not c['passed']]),sort_keys=True))
