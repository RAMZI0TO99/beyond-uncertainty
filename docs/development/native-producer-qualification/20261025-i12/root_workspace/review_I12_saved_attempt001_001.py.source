checks=[]

def check(name, yes, detail=None):
    checks.append(dict(name=name,passed=bool(yes),detail=detail))

def pin(p):
    p=Path(p);raw=p.read_bytes()
    return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def pairs(items):
    value={}
    for key,child in items:
        assert key not in value
        value[key]=child
    return value

def bad(value):
    raise ValueError('noninteger JSON numeric value')

def load(p):
    raw=Path(p).read_bytes()
    assert len(raw)<=2097152 and not raw.startswith(b'\xef\xbb\xbf')
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def wire(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode()

def occurs(value,p):
    if type(value)is dict:return value==p or any(occurs(v,p)for v in value.values())
    return type(value)is list and any(occurs(v,p)for v in value)

def all_fact3(value):
    if type(value)is dict:
        if set(value)=={'path','bytes','sha256'}:yield value
        else:
            for v in value.values():yield from all_fact3(v)
    elif type(value)is list:
        for v in value:yield from all_fact3(v)

