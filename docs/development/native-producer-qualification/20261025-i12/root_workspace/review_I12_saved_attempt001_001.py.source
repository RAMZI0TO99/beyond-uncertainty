def publish(path,v):
    b=(json.dumps(v,indent=2,sort_keys=True)+'\n').encode();assert len(b)<=2097152
    with path.open('xb')as s:s.write(b);s.flush();os.fsync(s.fileno())
    assert path.read_bytes()==b
