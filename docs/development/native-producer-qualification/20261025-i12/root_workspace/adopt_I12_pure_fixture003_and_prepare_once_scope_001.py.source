"""Root stdlib-only Source adoption and fresh synthetic scope metadata authoring."""
import ast
import datetime as dt
import hashlib
import json
import os
from pathlib import Path

R = Path(r'D:\Aenv\pro2\WORK\resume-20261025-002')
W = R / 'receipt_caller_integration_015'


def pin(path):
    raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def read(fact):
    p = Path(fact['path'])
    assert pin(p) == fact
    return p.read_bytes()


def save(path, value):
    raw = (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + '\n').encode()
    assert 0 < len(raw) <= 2097152
    with path.open('xb') as h:
        assert h.write(raw) == len(raw)
        h.flush()
        os.fsync(h.fileno())
    return pin(path)


def occurs(value, fact):
    if type(value) is dict:
        if value == fact:
            return True
        return any(occurs(x, fact) for x in value.values())
    return type(value) is list and any(occurs(x, fact) for x in value)


def review(path, expected_sha, expected_count, reviewer):
    assert pin(path)['sha256'] == expected_sha
    value = json.loads(path.read_bytes())
    assert value['reviewer'] == reviewer and value['verdict'].startswith('PASS_')
    assert type(value['checks_passed']) is int and value['checks_passed'] == expected_count
    assert type(value['checks_failed']) is int and value['checks_failed'] == 0
    assert all(value[k] is False for k in ('target_execution', 'tests_executed', 'operational_authority', 'scientific_authority', 'actual_family_publication'))
    full = json.loads(read(value['full_proof']))
    checks = full['checks']
    assert len(checks) == expected_count and all(x['passed'] is True for x in checks)
    assert len({x['name'] for x in checks}) == len(checks)
    assert full['reviewer'] == reviewer and full['verdict'] == value['verdict']
    assert type(full['checks_failed']) is int and full['checks_failed'] == 0
    return value


now = dt.datetime.now(dt.timezone.utc)
source_scope = R / 'ROOT_CURRENT_I12_RECEIPT_CALLER_SOURCE_SCOPE_001.json'
ss = json.loads(source_scope.read_bytes())
assert ss['target_execution'] is False and ss['operational_authority'] is False
assert dt.datetime.fromisoformat(ss['interval_start']) <= now and (dt.datetime.fromisoformat(ss['interval_end']) - now).total_seconds() > 660
