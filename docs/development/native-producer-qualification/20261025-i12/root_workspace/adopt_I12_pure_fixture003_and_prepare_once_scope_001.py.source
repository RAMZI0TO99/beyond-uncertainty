assert all(occurs(sv, p) for p in (supervisor, outer))
ft = ast.parse(read(fixture))
case_specs = ast.literal_eval(next(n.value for n in ft.body if isinstance(n, ast.Assign) and
    any(isinstance(t, ast.Name) and t.id == 'CASE_CATALOGUE' for t in n.targets)))
names = [c['name'] for c in case_specs]
assert len(names) == 1089 and len(set(names)) == 1089
positive = sum(c['expected'] == 'PASS' for c in case_specs)
assert positive == 177
lf_hash = hashlib.sha256(('\n'.join(names) + '\n').encode()).hexdigest()
json_hash = hashlib.sha256(json.dumps(names, separators=(',', ':'), ensure_ascii=True).encode()).hexdigest()
assert lf_hash == '803dcd7d5ff30cd4d7c047cd3f6fbcca96532129e2feeb9510ae2995066b83db'
assert json_hash == 'bab65d3db0775715f6b89bdc361fff299e88d2f31ff6e63715d9c185e1cb17fe'
