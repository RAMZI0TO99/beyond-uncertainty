def pin(path,raw=None):
    raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def pairs(items):
    result={}
    for k,v in items:
        if k in result:raise ValueError('duplicate JSON name')
        result[k]=v
    return result
def bad(value):raise ValueError('noninteger JSON number')
def strict(path):
    raw=path.read_bytes();assert len(raw)<=CAP
    value=json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    def walk(v):
        if type(v) is str:assert not any(0xD800<=ord(c)<=0xDFFF for c in v)
        elif type(v) is dict:
            for k,x in v.items():walk(k);walk(x)
        elif type(v) is list:
            for x in v:walk(x)
    walk(value);return value,raw
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(raw)<=CAP
    with path.open('xb') as handle:handle.write(raw)
    return pin(path,raw)
def literal(tree,name):
    node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    value=node.value
    if isinstance(value,ast.Call) and isinstance(value.func,ast.Name) and value.func.id=='frozenset':value=value.args[0]
    return ast.literal_eval(value)
def source(path):
    raw=path.read_bytes();return raw,ast.parse(raw)

