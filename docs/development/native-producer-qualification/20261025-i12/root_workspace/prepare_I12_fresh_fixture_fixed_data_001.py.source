"""Own read/hash metadata capture for fresh fixture Source literals, no fixture run."""
import base64
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
BASE=ROOT/'receipt_caller_integration_015'
OUT=BASE/'i12'
c=json.loads((BASE/'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json').read_text(encoding='utf8'))
def pin(path,raw):return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
fixed={}
def capture(label,expected):
    path=Path(expected['path']);raw=path.read_bytes();assert pin(path,raw)==expected and 0<len(raw)<=2097152
    fixed[label]=dict(pin=dict(expected),body64=base64.b64encode(raw).decode('ascii'))
    return raw
old=json.loads(capture('old_selection',c['current_historical_selection_pin']).decode('utf8'))
inventory=json.loads(capture('m3_inventory',c['M3_inventory17_pin']).decode('utf8'))
capture('historical_inventory',dict(path=r'D:\Aenv\pro2\WORK\resume-20261007-001\generation\observer010_lease009_root_001\ROOT_STEP077_FINAL_DATED_COMPLETE_SOURCE_STATE_SELECTION_001.json',bytes=23858,sha256='637da5caf2e7875fa84e5d54939b2cd8ae79377f372328597cc8b6b5cdbd0f5e'))
basis={r['role']:r['available_basis'] for r in inventory['roles']}
rows={r['role']:r for r in old['rows']}
for role in c['generic9_roles']+c['peer_format_roles']:
    expected=basis[role] if role in basis else rows[role]['predecessor']
    assert expected['bytes']<=c['ROLE_SOURCE_CAPS'][role]
    capture('predecessor_'+role,expected)
for label,name in (('constructor_source','receipt_contract_formats_003.py'),('constructor_api','CURRENT_OWNER_OUTSIDE8_RECEIPT_FORMAT_CONSTRUCTOR_INERT_API_003.json'),('emitter_source','declare_generic_single_emitter_source_only_001.py'),('emitter_api','CURRENT_OWNER_GENERIC_SINGLE_EMITTER_DECLARATION_INERT_API_003.json')):
    path=OUT/name;raw=path.read_bytes();capture(label,pin(path,raw))
path=Path(r'D:\Aenv\pro2\github-portable-20261012-001\docs\development\native-interface-implementation\20261015-i5\prepare_pipeline_utility_checker_metadata_current_owner_deferred_003.py.source')
capture('large_held_code_source',dict(path=str(path),bytes=182147,sha256='b46661de89ffce005c8cb41da42d98da4f9f5b5e43ec4a1a5de4e6f9771b79a7'))
raw=(json.dumps(fixed,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=ROOT/'I12_FRESH_FIXTURE_FIXED_RECORD_LITERAL_DATA_001.json'
with path.open('xb') as f:f.write(raw)
print(json.dumps(dict(fixed=pin(path,raw),record_count=len(fixed),total_raw_bytes=sum(row['pin']['bytes'] for row in fixed.values()),target_imports=0,target_calls=0,tests_executed=False),sort_keys=True))
