value=dict(schema_version=1,record_type='proposed_I12_fixed_physical_kernel_Source_editor_actor_exclusion_clarification',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),protocol=pin(OUT/'I12_EXACT_OUTSIDE8_RECEIPT_FORMAT_AND_METADATA_GRAPH_PROTOCOL_002.json'),catalogue=pin(OUT/'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json'),companion=pin(OUT/'I12_EXACT_PACKET_RESULT_ACTOR_AND_REFERENCE_TYPE_CLOSURE_COMPANION_001.json'),fixed_actual_kernel_Source_editor='/root/i2_resume_gap',normative_rule='Each new I12 graph kernel Source fixes its own actual physical Source editor /root/i2_resume_gap as a literal, independently included in every different-review exclusion union. This is additional to public source_editor (which may be /root/project_architecture), constructor/emitter support editors and all independently derived actors. Mutable or synthetic packet/API/support/source_editor values can never erase this fixed actual kernel author. Descendant/casefold exclusions apply. It is Source provenance and metadata independence policy only, not human identity authentication or actual authority.',fixture_variants=['reviewer equals fixed kernel editor with packet actual_content_authors empty and constructor/emitter editors changed to other synthetic actors => typed actor refusal','reviewer fixed editor descendant or casefold alias => typed actor refusal','independent reviewer under unrelated child remains eligible; Root child slash-boundary sibling allowed'],no_schema_expansion=True,prior_bytes_preserved=True,target_Source_authored=False,target_imports=0,target_calls=0,tests_executed=False,operational_authority=False,scientific_authority=False,author_tool=pin(Path(__file__)))
path=OUT/'I12_FIXED_PHYSICAL_KERNEL_EDITOR_EXCLUSION_CLARIFICATION_001.json'
raw=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode('utf8');assert len(raw)<=2097152
with path.open('xb') as f:f.write(raw)
print(json.dumps(pin(path),sort_keys=True))
