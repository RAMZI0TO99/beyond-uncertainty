PHYSICAL_PROVENANCE_QUALIFIED = False
CALLER_MODULE_NAME = '_held_current_owner_receipt_caller'
I2_MODULE_NAME = '_held_current_owner_M3_producer'
FIXED_LAYERS = {}  # Authoring machinery installs exact literal six-layer pins.
FIXED_CATALOGUE_PIN = None  # Exact final catalogue002, never a caller override.
FIXED_CONTEXT_ANNEX_PIN = None
FIXED_RESULT_COMPANION_PIN = None
FIXED_CURRENT_SELECTION_PIN = None
SCHEMAS = {'fact3': ('path', 'bytes', 'sha256'), 'record2': ('pin', 'body')}
I12_CONSTANTS = {}
I12_RESULT_JOINS = {}
I9_FALSE_FLAGS = ()
ROLE_CAPS = {}
STAGE_ROLES = {}
GENERIC9 = ('writer', 'whole_before', 'whole_after', 'whole_after_writer',
            'pipeline', 'utility', 'checker', 'binding', 'checker_config')
PEER5 = ('metadata_peer', 'metadata_bound_review', 'phase_peer',
         'pipeline_peer', 'checker_peer')
UNPORTED_CLOSED22 = ('capture_template', 'metadata_manifest', 'plan',
                    'metadata_binding', 'capture_bound', 'phase_binding')
FINITE8 = ()
_ACTIVE_GENERATION_SESSION = None


class CallerError(ValueError):
    __slots__ = ('code',)

    def __init__(self, code):
        self.code = code
        super().__init__(code)


def _need(value, code):
    if not value:
        raise CallerError(code)


def generate_current_owner_stage(*, context):
    if not CALLER_OPERATIONAL_ENTRY_QUALIFIED:
        raise CallerError('E_ACTUAL_ENTRY_HELD')
    raise CallerError('E_ACTUAL_ENTRY_UNWIRED')


def validate_current_prewrite_and_publish(*, context):
    if not CALLER_OPERATIONAL_ENTRY_QUALIFIED:
        raise CallerError('E_ACTUAL_ENTRY_HELD')
    raise CallerError('E_ACTUAL_ENTRY_UNWIRED')


def reconcile_current_publication(*, context):
    if not CALLER_OPERATIONAL_ENTRY_QUALIFIED:
        raise CallerError('E_ACTUAL_ENTRY_HELD')
    raise CallerError('E_ACTUAL_ENTRY_UNWIRED')


def require_actual_receipt_caller_admission(*args, **kwargs):
    if not CALLER_OPERATIONAL_ENTRY_QUALIFIED:
        raise CallerError('E_ACTUAL_ENTRY_HELD')
    raise CallerError('E_ACTUAL_ENTRY_UNWIRED')


def _wire(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                       ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')


def _tree(value, depth=0, count=None, c0=False):
    if count is None:
        count = [0]
    count[0] += 1
    _need(depth <= 48 and count[0] <= 50000, 'E_CONTEXT_VALUE')
    typ = type(value)
    if typ is dict:
        _need(all(type(k) is str for k in value), 'E_CONTEXT_VALUE')
        for key, item in value.items():
            _tree(key, depth + 1, count, c0 is True)
            _tree(item, depth + 1, count, c0 is True or depth == 0 and key == c0)
    elif typ is list:
        for item in value:
            _tree(item, depth + 1, count, c0)
    elif typ is str:
        _need(not any((ord(c) < 32 and c0 is not True) or 0xD800 <= ord(c) <= 0xDFFF for c in value),
              'E_CONTEXT_VALUE')
    else:
        _need(value is None or typ in (bool, int), 'E_CONTEXT_VALUE')
    return value


def _pairs(items):
    out = {}
    for key, value in items:
        _need(key not in out, 'E_CONTEXT_VALUE')
        out[key] = value
    return out


def _bad_number(value):
    raise CallerError('E_CONTEXT_VALUE')


def _decode(body, count=None, pin=None):
    _need(type(body) is bytes and 0 < len(body) <= 2097152, 'E_CONTEXT_VALUE')
    try:
        text = body.decode('utf-8', 'strict')
        _need(not text.startswith('\ufeff'), 'E_CONTEXT_VALUE')
        value = json.loads(text, object_pairs_hook=_pairs,
                           parse_float=_bad_number, parse_constant=_bad_number)
    except (UnicodeError, json.JSONDecodeError, ValueError) as error:
        if isinstance(error, CallerError):
            raise
        raise CallerError('E_CONTEXT_VALUE') from None
    described = (_same(pin, FIXED_LAYERS['I11']['API']) and
        len(body) == pin['bytes'] and hashlib.sha256(body).hexdigest() == pin['sha256'])
    if described:
        _need(type(value) is dict and 'literal_case_catalogue' in value, 'E_CONTEXT_VALUE')
    return _tree(value, count=count, c0='literal_case_catalogue' if described else False)


def _copy(value, count=None):
    _tree(value, count=count)
    return json.loads(_wire(value), object_pairs_hook=_pairs)


def _closed(value, schema):
    keys = SCHEMAS[schema] if type(schema) is str else schema
    _need(type(value) is dict and all(type(key) is str for key in value) and
          set(value) == set(keys), 'E_CONTEXT_SCHEMA')
    return value


def _same(left, right):
    return type(left) is type(right) and _wire(left) == _wire(right)


def _path(value):
    _need(type(value) is str and 3 < len(value) <= 32767 and
          re.fullmatch(r'[A-Z]:\\[^/]+', value) is not None, 'E_CONTEXT_VALUE')
    reserved = {'CON', 'PRN', 'AUX', 'NUL', 'CLOCK$',
                *('COM' + str(n) for n in range(1, 10)),
                *('LPT' + str(n) for n in range(1, 10))}
    _need(all(p and p not in ('.', '..') and p[-1] not in '. ' and
              p.split('.')[0].upper() not in reserved and
              re.search(r'[\x00-\x1f/:"<>|?*]', p) is None
              for p in value[3:].split('\\')), 'E_CONTEXT_VALUE')
    return value


def _pin(value, cap=2097152):
    _closed(value, 'fact3')
    _path(value['path'])
    _need(type(value['bytes']) is int and 0 < value['bytes'] <= cap and
          type(value['sha256']) is str and
          re.fullmatch('[0-9a-f]{64}', value['sha256']) is not None,
          'E_RECORD_STORE')
    return value


def _actor(value, root=True):
    _need(type(value) is str and len(value.encode('utf-8')) <= 256 and
          ((root and value == '/root') or
           re.fullmatch(r'/root(?:/[A-Za-z0-9_-]+)+', value) is not None),
          'E_CONTEXT_VALUE')
    return value


def _time(value, six=False):
    _need(type(value) is str, 'E_CONTEXT_VALUE')
    match = re.fullmatch(r'([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})\.([0-9]{6,7})\+00:00', value)
    _need(match is not None and (not six or len(match[2]) == 6), 'E_CONTEXT_VALUE')
    try:
        stamp = dt.datetime.fromisoformat(match[1] + '+00:00')
        delta = stamp - dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc)
    except ValueError:
        raise CallerError('E_CONTEXT_VALUE') from None
    return (delta.days * 86400 + delta.seconds) * 10000000 + int(match[2].ljust(7, '0'))


def _pins(values, maximum=256, minimum=0):
    _need(type(values) is list and minimum <= len(values) <= maximum, 'E_CONTEXT_SCHEMA')
    for pin in values:
        _pin(pin)
    paths = [p['path'] for p in values]
    _need(paths == sorted(paths) and len({p.casefold() for p in paths}) == len(paths),
          'E_RECORD_STORE')
    return values


def _paths(values, maximum=18, minimum=0):
    _need(type(values) is list and minimum <= len(values) <= maximum, 'E_CONTEXT_SCHEMA')
    for value in values:
        _path(value)
    _need(values == sorted(values) and len({p.casefold() for p in values}) == len(values),
          'E_RECORD_STORE')
    return values


def _support(value, schema):
    _closed(value, schema)
    for key, pin in value.items():
        if key == 'editor':
            _actor(pin, False)
        elif key == 'role':
            _need(type(pin) is str, 'E_CONTEXT_SCHEMA')
        else:
            _pin(pin)
    return value


class _Store:
    def __init__(self, records, count):
        _need(type(records) is list and 0 < len(records) <= 256, 'E_RECORD_STORE')
        self.items, self.cache, self.total = {}, {}, 0
        self.count = count
        for entry in records:
            _closed(entry, 'record2')
            pin = _copy(_pin(entry['pin']), count)
            body = entry['body']
            _need(type(body) is bytes and len(body) == pin['bytes'] and
                  hashlib.sha256(body).hexdigest() == pin['sha256'], 'E_RECORD_STORE')
            key = pin['path'].casefold()
            _need(key not in self.items, 'E_RECORD_STORE')
            self.items[key] = (pin, body)
            self.total += len(body)
        _need(self.total <= 33554432, 'E_RECORD_STORE')

    def body(self, pin, cap=2097152):
        pin = _pin(pin, cap)
        row = self.items.get(pin['path'].casefold())
        _need(row is not None and _same(row[0], pin), 'E_RECORD_STORE')
        return row[1]

    def record(self, pin):
        body = self.body(pin)
        key = pin['path'].casefold()
        if key not in self.cache:
            self.cache[key] = _decode(body, self.count, pin)
        return copy.deepcopy(self.cache[key])

    def read_record(self, pin):
        return self.body(pin)

    def project(self, pins):
        _pins(pins, minimum=1)
        return [dict(pin=_copy(p), body=self.body(p)) for p in pins]


def _occurs(value, pin):
    if type(value) is dict:
        if set(value) == {'path', 'bytes', 'sha256'} and _same(value, pin):
            return True
        return any(_occurs(item, pin) for item in value.values())
    if type(value) is list:
        return any(_occurs(item, pin) for item in value)
    return False


def _noauth(value):
    _need(type(value) is dict and value.get('target_execution') is False and
          value.get('operational_authority') is False, 'E_BINDING_SOURCE_PIN')


def _derive_authors(value, out, is_review=False):
    if type(value) is list:
        for item in value:
            _derive_authors(item, out, is_review)
    elif type(value) is dict:
        review = is_review or ('reviewer' in value and 'full_proof' in value) or 'checks' in value
        names = {'source_author', 'Source_author', 'actual_Source_editor',
                 'physical_Source_editor', 'source_editor', 'metadata_Source_worker',
                 'retained_semantic_Source_author', 'content_author',
                 'preparation_Source_author', 'genuine_content_author_and_reviewer',
                 'physical_actor', 'physical_selected_byte_editor',
                 'physical_receipt_author', 'actual_binding_Source_editor',
                 'historical_binding_Source_editor', 'historical_metadata_Source_editor',
                 'actual_implementation_Source_editor', 'historical_implementation_Source_editor',
                 'publication_helper_physical_Source_editor', 'inherited_reader_Source_editor',
                 'inherited_no_overwrite_writer_Source_editor', 'canonical_physical_actor'}
        names.update(('original_peer_source_author_nominal', 'retained_payload_semantic_Source_author',
                      'actual_content_actor', 'implementation_Source_editor'))
        for key, item in value.items():
            if key in ('approved_original_schema_updates', 'canonical_dependencies',
                       'actual_reversal_FILEs', 'current_content_evidence_support',
                       'implementation_support'):
                continue
            if key in names and item is not None:
                out.add(_actor(item).casefold())
            elif key == 'author' and not review:
                if type(item) is str and item.startswith('/root'):
                    out.add(_actor(item).casefold())
            if key not in ('reviewer', 'reviewer_agent'):
                _derive_authors(item, out, review)


def _author_graph(store, roots, excluded):
    metadata_keys = {'API', 'full_proof', 'different_review', 'Root_adoption',
        'Source_review', 'source_review', 'publisher_API', 'publisher_Source_review',
        'publisher_Root_adoption', 'publisher_different_Source_review',
        'publisher_Root_Source_adoption', 'facts', 'generation_facts',
        'publication_facts', 'stage_decision', 'generation_stage_decision',
        'publication_stage_decision', 'generation_receipt', 'author_receipt',
        'receipt', 'selection', 'current_selection', 'current_owner_scope',
        'owner_scope', 'owner_support_manifest', 'subject', 'expected', 'packet',
        'request', 'original_request', 'original_publication', 'publication',
        'reconciliation', 'late_reconciliation', 'reconciliation_review',
        'reconciliation_Root_adoption', 'content_decision', 'decision',
        'serialization_witness', 'inverse_evidence', 'context',
        'actual_Root_late_facts', 'actual_Source_packet', 'actual_genuine_content_decision',
        'actual_Root_serialization_witness', 'actual_complete_predecessor_inverse',
        'actual_Root_content_adoption', 'canonical_delta_Root_adoption',
        'actual_canonical_delta_Source_review', 'content_review', 'proposal_review',
        'canonical_review', 'canonical_Root_adoption', 'execution_witness'}
    visited = set()
    raw_paths = {fixed['Source']['path'].casefold() for fixed in FIXED_LAYERS.values()
                 if type(fixed) is dict}
    def raw_pins(value):
        if type(value) is dict:
            for key, item in value.items():
                if (key in ('Source', 'tool_source', 'publisher_source', 'constructor_Source',
                           'emitter_Source', 'draft', 'predecessor', 'canonical',
                           'canonical_Source', 'exact_draft_Source', 'proposal') and type(item) is dict and
                        set(item) == {'path', 'bytes', 'sha256'}):
                    raw_paths.add(item['path'].casefold())
                elif key in ('canonical_path', 'draft_path') and type(item) is str:
                    raw_paths.add(item.casefold())
                raw_pins(item)
        elif type(value) is list:
            for item in value:
                raw_pins(item)
    def walk(value, name=None):
        if type(value) is dict:
            if set(value) == {'path', 'bytes', 'sha256'}:
                if name not in metadata_keys:
                    return
                key = value['path'].casefold()
                if key in visited or key in raw_paths:
                    return
                visited.add(key)
                record = store.record(value)
                if _same(value, FIXED_LAYERS['I11']['API']):
                    record.pop('literal_case_catalogue')
                raw_pins(record)
                _derive_authors(record, excluded)
                walk(record)
            else:
                for key, item in value.items():
                    if key not in ('approved_original_schema_updates', 'canonical_dependencies',
                                   'actual_reversal_FILEs', 'current_content_evidence_support',
                                   'implementation_support'):
                        walk(item, key)
        elif type(value) is list:
            for item in value:
                walk(item, name)
    raw_pins(roots)
    walk(roots)


class _Bound:
    def __init__(self, common, store, context):
        self.c, self.s = common, store
        self.now = _time(common['now_utc'], six=True)
        self.excluded = {'/root', SOURCE_EDITOR, FIXED_KERNEL_EDITOR, HISTORICAL_I2_EDITOR}
        self.excluded.update(a.casefold() for a in common['actual_content_authors'])
        self.modules = {}
        self.catalogue_bytes = store.body(FIXED_CATALOGUE_PIN)
        self.catalogue = store.record(FIXED_CATALOGUE_PIN)
        # Follow named metadata graph edges only; unused supplied bodies stay raw.
        _author_graph(store, context, self.excluded)
        manifest_support = common['binding_support']
        self.manifest = _closed(store.record(manifest_support['subject']), 'binding_manifest')
        m = self.manifest
        _need(m['schema_version'] == 1 and type(m['schema_version']) is int and
              m['record_type'] == 'Root_held_receipt_caller_complete_Source_binding_manifest' and
              m['Root_thread'] == common['root_thread'], 'E_BINDING_SOURCE_PIN')
        _time(m['created_utc'])
        _closed(m['qualification'], 'binding_flags')
        _need(all(v is False for v in m['qualification'].values()), 'E_BINDING_SOURCE_PIN')
        _support(m['caller_support'], 'code5')
        _support(m['I2_support'], 'code5')
        _need(m['caller_support']['editor'] == m['I2_support']['editor'] == SOURCE_EDITOR,
              'E_BINDING_SOURCE_PIN')
        _closed(m['layers'], 'layer_bindings')
        _need(set(FIXED_LAYERS) == set(m['layers']) ==
              {'I7', 'I8', 'I9', 'I11', 'I12_single', 'I12_peer'}, 'E_BINDING_SOURCE_PIN')
        for key, support in m['layers'].items():
            _support(support, 'code5')
            fixed = FIXED_LAYERS[key]
            _need(type(fixed) is dict and _same(support['Source'], fixed['Source']) and
                  _same(support['API'], fixed['API']) and support['editor'] == fixed['editor'],
                  'E_BINDING_SOURCE_PIN')
        all_supports = [m['caller_support'], m['I2_support'], *m['layers'].values()]
        for support in all_supports:
            self.excluded.add(support['editor'].casefold())
        for support in all_supports:
            self.code(support)
        subjects = [manifest_support['subject'], *[p for s in all_supports for p in (s['Source'], s['API'])]]
        review = self.review(manifest_support['different_review'], subjects, True)
        self.adopt(manifest_support['Root_adoption'], subjects, manifest_support['different_review'], review)

    def review(self, pin, subjects, code=False):
        for subject in subjects:
            self.s.body(subject)
        value = self.s.record(pin)
        _noauth(value)
        who = _actor(value.get('reviewer'), False).casefold()
        _need(all(who != a and (a == '/root' or not who.startswith(a + '/'))
                  for a in self.excluded), 'E_BINDING_SOURCE_PIN')
        verdict = value.get('verdict')
        _need(type(verdict) is str and verdict.startswith('PASS_') and
              (not code or 'SOURCE' in verdict.upper()) and
              type(value.get('checks_failed')) is int and value['checks_failed'] == 0 and
              all(_occurs(value, p) for p in subjects), 'E_BINDING_SOURCE_PIN')
        full_pin = _pin(value.get('full_proof'))
        full = self.s.record(full_pin)
        _noauth(full)
        checks = full.get('checks')
        _need(type(checks) is list and 0 < len(checks) <= 10000, 'E_BINDING_SOURCE_PIN')
        names = []
        for check in checks:
            _need(type(check) is dict and type(check.get('name')) is str and
                  bool(check['name']) and check.get('passed') is True, 'E_BINDING_SOURCE_PIN')
            names.append(check['name'])
        _need(all(type(v.get('checks_passed')) is int and v['checks_passed'] == len(checks)
                  for v in (value, full)) and
              len(set(names)) == len(names) and full.get('reviewer') == value['reviewer'] and
              full.get('verdict') == verdict and type(full.get('checks_failed')) is int and
              full['checks_failed'] == 0 and all(_occurs(full, p) for p in subjects) and
              _time(full.get('created_utc')) <= _time(value.get('created_utc')) <= self.now,
              'E_BINDING_SOURCE_PIN')
        return value, full, full_pin

    def adopt(self, pin, subjects, review_pin, review):
        value = self.s.record(pin)
        _noauth(value)
        _need(value.get('author') == '/root' and type(value.get('verdict')) is str and
              value['verdict'].startswith('ACCEPT_') and all(_occurs(value, p) for p in
              [*subjects, review_pin, review[2], self.c['owner_support']['current_owner_scope'],
               self.c['selection_support']['selection']]) and
              _time(review[0].get('created_utc')) <= _time(value.get('created_utc')) <= self.now,
              'E_BINDING_SOURCE_PIN')
        return value

    def code(self, support):
        self.s.body(support['Source'])
        api = self.s.record(support['API'])
        _need(type(api) is dict and type(api.get('schema_version')) is int and type(api.get('record_type')) is str and
              api.get('author') == support['editor'] and
              _same(_pin(api.get('Source', api.get('publisher_Source', api.get('module')))), support['Source']) and
              api.get('operational_authority') is False and api.get('scientific_authority') is False,
              'E_BINDING_SOURCE_PIN')
        if support is self.manifest['caller_support']:
            version, tag, editor, flags = (1, 'Root_owner_v2_held_receipt_caller_inert_API',
                'actual_Source_editor', ('target_execution', 'tests_executed', 'caller_qualified',
                'producer_qualified', 'authentic_loader_qualified', 'physical_provenance_qualified',
                'human_origin_authenticated', 'full_I2_G01_closed', 'actual_family_publication'))
        elif support is self.manifest['I2_support']:
            version, tag, editor, flags = (2, 'Root_owner_v2_M3_deferred_metadata_inert_API',
                'actual_binding_Source_editor', ('target_execution', 'tests_executed',
                'external_canonical_receipt_ABI_qualified', 'runtime_eligibility',
                'actual_I2_or_I0_or_I1_import_call_entry', 'actual_eight_TEMPLATE_BOUND_Source_generated'))
        else:
            version, tag, editor, flags = api['schema_version'], api['record_type'], 'author', ()
        _need(api['schema_version'] == version and api['record_type'] == tag and
              api.get(editor) == support['editor'] and all(api.get(k) is False for k in flags),
              'E_BINDING_SOURCE_PIN')
        subjects = [support['Source'], support['API']]
        review = self.review(support['different_review'], subjects, True)
        self.adopt(support['Root_adoption'], subjects, support['different_review'], review)

    def layer(self, key):
        _need(key in FIXED_LAYERS, 'E_BINDING_SOURCE_PIN')
        if key not in self.modules:
            support = self.manifest['layers'][key]
            raw = self.s.body(support['Source'])
            name = '_held_receipt_fixed_' + key
            _need(name not in sys.modules, 'E_BINDING_SOURCE_PIN')
            module = types.ModuleType(name)
            module.__file__ = support['Source']['path']
            module.__source_pin__ = _copy(support['Source'])
            module.__source_bytes__ = raw
            sys.modules[name] = module
            try:
                exec(compile(raw, module.__file__, 'exec'), module.__dict__)
            finally:
                _need(sys.modules.get(name) is module, 'E_BINDING_SOURCE_PIN')
                del sys.modules[name]
            self.modules[key] = module
        return self.modules[key]


def _common(value, store):
    _closed(value, 'common')
    _need(type(value['root_thread']) is str and
          re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', value['root_thread']) is not None and
          value['source_editor'] == SOURCE_EDITOR, 'E_CONTEXT_VALUE')
    _time(value['now_utc'], six=True)
    for key, schema in [('binding_support', 'support3'), ('owner_support', 'owner3'),
                        ('lease_support', 'lease5'), ('selection_support', 'selection3')]:
        _support(value[key], schema)
    for key in ('owner_support_manifest', 'publisher_catalogue', 'historical_selection_inventory', 'M3_inventory'):
        store.body(_pin(value[key]))
    authors = value['actual_content_authors']
    _need(type(authors) is list and len(authors) <= 256, 'E_CONTEXT_SCHEMA')
    for actor in authors:
        _actor(actor)
    _need(len({x.casefold() for x in authors}) == len(authors), 'E_CONTEXT_VALUE')
    _closed(value['resource'], 'resource3')
    _time(value['resource']['observed_utc'], six=True)
    _need(all(type(value['resource'][k]) is int and value['resource'][k] >= 0
              for k in ('available_RAM_bytes', 'free_disk_bytes')), 'E_CONTEXT_VALUE')
    selection = store.record(value['selection_support']['selection'])
    _closed(selection, 'selection13')
    _need(type(selection['schema_version']) is int and selection['schema_version'] == 2 and
          selection['record_type'] == 'Root_owner_v2_actual_separate_future45_Source_path_selection' and
          selection['author'] == '/root' and selection['operational_authority'] is False and
          selection['target_execution'] is False and type(selection['selected_Source_nonce']) is str and
          re.fullmatch('[0-9a-f]{32}', selection['selected_Source_nonce']) is not None,
          'E_LAYER_CONTEXT_JOIN')
    _time(selection['created_utc'])
    _path(selection['derived_launcher_runtime_path'])
    _need(_same(selection['current_owner_scope'], value['owner_support']['current_owner_scope']) and
          _same(selection['new_canonical_lease'], value['lease_support']['canonical']), 'E_LAYER_CONTEXT_JOIN')
    _join(store.record(value['owner_support_manifest']), value['owner_support'])
    _join(selection['current_selection'], FIXED_CURRENT_SELECTION_PIN)
    _join(selection['current_complete45_inventory'], value['historical_selection_inventory'])
    historical = store.record(FIXED_CURRENT_SELECTION_PIN)
    _need(type(historical) is dict and type(historical.get('rows')) is list, 'E_LAYER_CONTEXT_JOIN')
    composers = [r for r in historical['rows'] if type(r) is dict and r.get('role') == 'composer']
    _need(len(composers) == 1, 'E_LAYER_CONTEXT_JOIN')
    rows = selection['rows']
    _need(type(rows) is list and len(rows) == 45, 'E_LAYER_CONTEXT_JOIN')
    result = {}
    for row in rows:
        _closed(row, 'selection_row9')
        role = row['role']
        _need(type(role) is str and role not in result, 'E_LAYER_CONTEXT_JOIN')
        _path(row['canonical_path'])
        _pin(row['predecessor'], 2097152)
        if role == 'composer':
            _join(row, composers[0])
            _need(row['draft_path'] is None and row['selected_ordinal'] is None and
                  row['preparation_Source_author'] is None and row['retained_semantic_Source_author'] is None and
                  row['must_change_Source_bytes'] is False and row['source_cap'] == 65536 and
                  row['canonical_path'] == row['predecessor']['path'], 'E_LAYER_CONTEXT_JOIN')
        else:
            _need(role in ROLE_CAPS and type(row['source_cap']) is int and
                  row['source_cap'] == ROLE_CAPS[role] and type(row['selected_ordinal']) is int and
                  row['selected_ordinal'] > 0 and row['must_change_Source_bytes'] is True,
                  'E_LAYER_CONTEXT_JOIN')
            _path(row['draft_path'])
            _actor(row['preparation_Source_author'], False)
            _actor(row['retained_semantic_Source_author'])
            _pin(row['predecessor'], row['source_cap'])
        result[role] = row
    _need(set(result) == set(ROLE_CAPS) | {'composer'} and
          len({r['canonical_path'].casefold() for r in rows}) == 45 and
          len({r['draft_path'].casefold() for r in rows if r['role'] != 'composer'}) == 44,
          'E_LAYER_CONTEXT_JOIN')
    return result


def _start(context, records, schema):
    count = [0]
    context = _copy(context, count)
    store = _Store(records, count)
    _bootstrap(store)
    _closed(context, schema)
    rows = _common(context['common'], store)
    bound = _Bound(context['common'], store, context)
    return context, store, rows, bound


def _bootstrap(store):
    global SCHEMAS, I12_CONSTANTS, I12_RESULT_JOINS, ROLE_CAPS, STAGE_ROLES
    global FINITE8, FIXED_CURRENT_SELECTION_PIN, I9_FALSE_FLAGS
    # Exact reviewed contract data, all within the same finite-store budgets.
    annex = store.record(FIXED_CONTEXT_ANNEX_PIN)
    result = store.record(FIXED_RESULT_COMPANION_PIN)
    catalogue = store.record(FIXED_CATALOGUE_PIN)
    shapes = annex['closed_shapes']
    _need(type(shapes) is dict, 'E_BINDING_SOURCE_PIN')
    schemas = {key: tuple(value['exact_keys']) for key, value in shapes.items()
               if type(value) is dict and 'exact_keys' in value}
    inherited = annex['inherited_schemas_extracted_from_actual_AST']
    I9_FALSE_FLAGS = tuple(inherited['I9.I9_PERMANENT_FALSE']['value'])
    for key, source in [('selection13', 'selection13_v2'), ('selection_row9', 'selection_row9'),
                        ('expected18', 'expected18'), ('purpose6', 'stage_purpose6'),
                        ('request21', 'batch_request21_v2'), ('request_row10', 'batch_request_row10_v2'),
                        ('publication43', 'batch_publication43_v2'), ('reconciliation26', 'reconciliation26_v2')]:
        schemas[key] = tuple(inherited['I11.' + source]['keys'])
    schemas['facts21'] = ('Root_thread', 'author', 'binding_supports', 'canonical_publication',
        'created_utc', 'current_owner_scope', 'dependencies', 'lease_support', 'native_Parser_authority',
        'operational_authority', 'operational_choices', 'predecessor_inventory', 'record_type', 'role',
        'role_selections', 'schema_version', 'selection_support', 'source_only', 'stage', 'target_execution', 'tool_support')
    rows = result['I9_exact_result_rows']
    schemas['i9_group7'] = tuple(rows['stage_group7']['exact_keys'])
    schemas['i9_artifact8'] = tuple(rows['artifact8']['exact_keys'])
    schemas['selected_peer_context2'] = ('common', 'prior_dependency')
    schemas['layer_bindings'] = tuple(result['fixed_module_partition']['caller_literal_layer_keys'])
    SCHEMAS = schemas
    I12_CONSTANTS = result['I12_result_constants']
    I12_RESULT_JOINS = result['I12_result_joins']
    ROLE_CAPS = catalogue['ROLE_SOURCE_CAPS']
    FINITE8 = tuple(catalogue['finite8_roles'])
    STAGE_ROLES = rows['stage_role_sets']
    FIXED_CURRENT_SELECTION_PIN = catalogue['current_historical_selection_pin']


def _view(value):
    _need(callable(getattr(value, 'to_dict', None)), 'E_LAYER_CONTEXT_JOIN')
    out = value.to_dict()
    _tree(out)
    _need(type(out) is dict, 'E_LAYER_CONTEXT_JOIN')
    return out


def _false(value, names):
    _need(all(value.get(name) is False for name in names), 'E_LAYER_CONTEXT_JOIN')


def _join(left, right):
    _need(_same(left, right), 'E_LAYER_CONTEXT_JOIN')


def _required(stage, role):
    if stage == 'templates':
        return set()
    if stage == 'manifest':
        return set(STAGE_ROLES['templates']) | {'profile'}
    if stage == 'capture':
        return {'capture_template', 'metadata_manifest', 'profile', 'static', 'metadata_peer'}
    if stage == 'phase_bound' and role in FINITE8 and role.endswith('_bound'):
        return {role.replace('_bound', '_template'), 'capture_bound', 'metadata_binding', 'metadata_bound_review'}
    if stage == 'phase_binding':
        return set(FINITE8) | {'capture_bound', 'metadata_binding', 'metadata_bound_review'}
    raise CallerError('E_CONTEXT_VALUE')


def _descriptor(d, store):
    _closed(d, 'prior_dependency_context')
    _support(d['dependency'], 'dependency9')
    _need(type(d['role']) is str and d['dependency']['role'] == d['role'], 'E_CONTEXT_SCHEMA')
    _pins(d['record_pins'], minimum=1)
    for p in d['record_pins']:
        store.body(p)
    if d['kind'] == 'finite8':
        _need(d['role'] in FINITE8 and d['packet'] is None, 'E_CONTEXT_SCHEMA')
        _pin(d['expected'])
    else:
        _need(d['kind'] in ('generic_single', 'selected_peer_descriptor') and
              d['expected'] is None, 'E_CONTEXT_SCHEMA')
        _pin(d['packet'])
    return d


def _prior(d, common, store, rows, bound, current_request=None, outputs=()):
    d = _descriptor(d, store)
    role = d['role']
    _need(role in rows and role != 'composer', 'E_UNSUPPORTED_PRODUCER_ROUTE')
    if role in UNPORTED_CLOSED22 or role in ('profile', 'static'):
        raise CallerError('E_UNSUPPORTED_PRODUCER_ROUTE')
    if role in PEER5 or d['kind'] == 'selected_peer_descriptor':
        raise CallerError('E_UNSUPPORTED_CANONICAL_PEER_PUBLICATION_ROUTE')
    dep = d['dependency']
    row = rows[role]
    raw = store.body(dep['canonical'], row['source_cap'])
    _need(dep['canonical']['path'] == row['canonical_path'] and
          dep['canonical']['sha256'] != row['predecessor']['sha256'], 'E_LAYER_CONTEXT_JOIN')
    forbidden = {p.casefold() for p in outputs}
    for p in d['record_pins']:
        _need(p['path'].casefold() not in forbidden and
              (current_request is None or not _same(p, current_request)), 'E_DEPENDENCY_NOT_PRIOR')
    if d['kind'] == 'finite8':
        expected = _closed(store.record(d['expected']), 'expected18')
        module = bound.layer('I11')
        result = module.validate_finite8_canonical_receipt_metadata(
            dependency=dep, expected=expected, records=store.project(d['record_pins']),
            expected_root_thread=common['root_thread'], source_editor=common['source_editor'],
            now_utc=common['now_utc'])
        value = _view(result)
        for key, wanted in [('role', role), ('dependency', dep), ('canonical', dep['canonical']),
                            ('request', expected['request']), ('original_publication', dep['original_publication']),
                            ('reconciliation', dep['late_reconciliation']), ('draft', expected['selected_draft']),
                            ('predecessor', row['predecessor']), ('author_receipt', dep['author_receipt']),
                            ('selection', common['selection_support']['selection']),
                            ('current_owner_scope', common['owner_support']['current_owner_scope']),
                            ('lease', common['lease_support']['canonical']),
                            ('publisher_catalogue', common['publisher_catalogue']),
                            ('historical_selection_inventory', common['historical_selection_inventory']),
                            ('M3_inventory', common['M3_inventory']), ('validated_now_utc', common['now_utc'])]:
            _join(value.get(key), wanted)
        _need(value.get('metadata_only') is True and value.get('finite8_receipt_ABI_metadata_validated') is True,
              'E_LAYER_CONTEXT_JOIN')
        prior_request = _closed(store.record(expected['request']), 'request21')
        _join(value.get('batch_roles'), [item['role'] for item in prior_request['rows']])
        _need(type(value.get('verified_record_count')) is int and
              value['verified_record_count'] == len(d['record_pins']) and
              type(value.get('verified_record_bytes')) is int and
              value['verified_record_bytes'] == sum(len(store.body(p)) for p in d['record_pins']),
              'E_LAYER_CONTEXT_JOIN')
        _false(value, ('actual_admission', 'owner_lease_qualified', 'producer_qualified', 'caller_qualified',
                       'physical_origin_authenticated', 'human_origin_authenticated',
                       'nested_dependency_authority_qualified', 'new_grants_issued',
                       'operational_authority', 'scientific_authority'))
    else:
        _need(role in GENERIC9, 'E_UNSUPPORTED_PRODUCER_ROUTE')
        module = bound.layer('I12_single')
        result = module.validate_generic_single_dependency_metadata(
            packet=store.body(d['packet']), records=store.project(d['record_pins']),
            catalogue_bytes=bound.catalogue_bytes, expected_root_thread=common['root_thread'],
            source_editor=common['source_editor'], now_utc=common['now_utc'])
        value, packet = _i12_result(result, 'single', d, common, store, bound)
        mapping = dict(role='role', canonical='canonical', author_receipt='generation_receipt',
                       original_publication='publication', late_reconciliation='reconciliation')
        for key, target in mapping.items():
            _join(dep[key], packet[target])
        for key, target, parent in [('different_review', 'different_review', 'canonical_support'),
                                    ('Root_adoption', 'Root_adoption', 'canonical_support'),
                                    ('reconciliation_review', 'different_review', 'reconciliation_support'),
                                    ('reconciliation_Root_adoption', 'Root_adoption', 'reconciliation_support')]:
            _join(dep[key], packet[parent][target])
        _join(value['predecessor'], row['predecessor'])
        _need(value['draft']['path'] == row['draft_path'] and value['canonical']['path'] == row['canonical_path'],
              'E_LAYER_CONTEXT_JOIN')
    return _copy(dep['canonical']), raw


def _i12_result(raw, kind, d, common, store, bound):
    value = _decode(raw)
    schemas = bound.catalogue['schemas']
    schema = schemas[kind + '_result49']
    _closed(value, schema['fields'])
    _need(_wire(value) == raw and type(value['schema_version']) is int and
          value['schema_version'] == 1 and value['record_type'] == schema['record_type'], 'E_LAYER_CONTEXT_JOIN')
    packet = store.record(d['packet'])
    _closed(packet, schemas['single_packet22' if kind == 'single' else 'peer_packet20']['fields'])
    for key, selector in I12_RESULT_JOINS[kind].items():
        want = packet
        for part in selector.split('.')[1:]:
            _need(type(want) is dict and part in want, 'E_CONTEXT_SCHEMA')
            want = want[part]
        _join(value[key], want)
    for key, want in [('role', d['role']), ('current_owner_scope', common['owner_support']['current_owner_scope']),
                      ('selection', common['selection_support']['selection']), ('lease', common['lease_support']['canonical']),
                      ('validated_now_utc', common['now_utc'])]:
        _join(value[key], want)
    _join(packet['root_thread'], common['root_thread'])
    _false(value, I12_CONSTANTS['authority_false_flags'])
    _need(value['metadata_only'] is True and value['format_validated'] is True and
          value['producer_route_status'] == 'UNWIRED' and
          type(value['verified_record_count']) is int and value['verified_record_count'] == len(d['record_pins']) and
          type(value['verified_record_bytes']) is int and
          value['verified_record_bytes'] == sum(len(store.body(p)) for p in d['record_pins']), 'E_LAYER_CONTEXT_JOIN')
    prefix = 'single' if kind == 'single' else 'peer'
    _join(value['unwired_obligations'], I12_CONSTANTS[prefix + '_unwired_obligations'])
    _need(type(value['recorded_spent_observation_count']) is int and
          value['recorded_spent_observation_count'] == I12_CONSTANTS[prefix + '_spent_observation_count'] and
          type(value['exact_spent_whitelist_matches']) is int and
          value['exact_spent_whitelist_matches'] == I12_CONSTANTS[prefix + '_exact_spent_whitelist_matches'],
          'E_LAYER_CONTEXT_JOIN')
    if kind == 'single':
        _need(value['single29_metadata_graph_validated'] is True and
              value['canonical_dependency_ABI_metadata_validated'] is True, 'E_LAYER_CONTEXT_JOIN')
    else:
        _need(value['selected_peer27_metadata_graph_validated'] is True and
              value['canonical_dependency_ABI_metadata_validated'] is False and
              value['held_context_route_present'] is (d['role'] == 'phase_peer'), 'E_LAYER_CONTEXT_JOIN')
    return value, packet


def _selected_peer_descriptor_impl(*, context, records):
    context, store, rows, bound = _start(context, records, 'selected_peer_context2')
    d = _descriptor(context['prior_dependency'], store)
    _need(d['kind'] == 'selected_peer_descriptor' and d['role'] in PEER5, 'E_CONTEXT_SCHEMA')
    module = bound.layer('I12_peer')
    common = context['common']
    result = module.validate_selected_peer_receipt_metadata(
        packet=store.body(d['packet']), records=store.project(d['record_pins']),
        catalogue_bytes=bound.catalogue_bytes, expected_root_thread=common['root_thread'],
        source_editor=common['source_editor'], now_utc=common['now_utc'])
    value, packet = _i12_result(result, 'peer', d, common, store, bound)
    _join(value['predecessor'], rows[d['role']]['predecessor'])
    _need(value['draft']['path'] == rows[d['role']]['draft_path'], 'E_LAYER_CONTEXT_JOIN')
    return MetadataView(dict(kind='peer_descriptor_only', metadata=value))


class MetadataView(tuple):
    def __new__(cls, value):
        value = _copy(value)
        value['metadata_only'] = True
        for key in ('actual_admission', 'producer_qualified', 'caller_qualified',
                    'physical_origin_authenticated', 'human_origin_authenticated',
                    'authentic_loader_qualified', 'physical_provenance_qualified',
                    'operational_authority', 'scientific_authority'):
            value[key] = False
        return tuple.__new__(cls, (_wire(value),))

    def to_dict(self):
        return _decode(self[0])


class _Session:
    __slots__ = ('_generation_bytes', '_record_pairs', '_manifest_bytes', '_prior_index',
                 '_i2_producer', '_caller_module')

    def __init__(self, generation, store, bound, producer, caller):
        self._generation_bytes = _wire(generation)
        self._record_pairs = tuple((_wire(p), b) for p, b in store.items.values())
        self._manifest_bytes = _wire(bound.manifest)
        self._prior_index = tuple((d['role'], _wire(d)) for d in generation['prior_dependencies'])
        self._i2_producer, self._caller_module = producer, caller

    def __setattr__(self, name, value):
        _need(name in self.__slots__ and not hasattr(self, name), 'E_GENERATION_SESSION_MISMATCH')
        object.__setattr__(self, name, value)


def _mechanical_module(module, support, store, names, expected_name):
    _need(type(module) is types.ModuleType and module.__name__ == expected_name and
          getattr(module, '__file__', None) == support['Source']['path'] and
          _same(getattr(module, '__source_pin__', None), support['Source']) and
          type(getattr(module, '__source_bytes__', None)) is bytes and
          module.__source_bytes__ == store.body(support['Source']), 'E_BINDING_SOURCE_PIN')
    for name in names:
        fn = module.__dict__.get(name)
        _need(type(fn) is types.FunctionType and fn.__name__ == name and
              fn.__globals__ is module.__dict__ and fn.__code__.co_filename == module.__file__,
              'E_BINDING_SOURCE_PIN')


def _generation_impl(*, context, records, i2_producer, i2_arguments):
    global _ACTIVE_GENERATION_SESSION
    context, store, rows, bound = _start(context, records, 'generation_context')
    common = context['common']
    _need(type(context['stage']) is str and (context['role'] is None or type(context['role']) is str) and
          context['stage'] in STAGE_ROLES and
          ((context['stage'] == 'phase_bound' and context['role'] in FINITE8 and context['role'].endswith('_bound')) or
           (context['stage'] != 'phase_bound' and context['role'] is None)), 'E_CONTEXT_SCHEMA')
    _support(context['stage_support'], 'stage_support3')
    _join(context['facts'], context['stage_support']['facts'])
    _pins(context['expected_input_pins'], minimum=1)
    _paths(context['expected_output_paths'], 15, 1)
    facts = store.record(context['facts'])
    _closed(facts, 'facts21')
    _need(type(facts['schema_version']) is int and facts['schema_version'] == 2 and
          facts['record_type'] == 'Root_owner_v2_exact_M3_Source_stage_purpose_and_facts' and
          facts['author'] == '/root' and facts['source_only'] is True and
          all(facts[k] is False for k in ('target_execution', 'operational_authority',
              'canonical_publication', 'native_Parser_authority')), 'E_LAYER_CONTEXT_JOIN')
    _join(facts['Root_thread'], common['root_thread'])
    _join(facts['predecessor_inventory'], common['M3_inventory'])
    _join(facts['tool_support'], {k: bound.manifest['I2_support'][k] for k in SCHEMAS['code4']})
    for key, want in [('stage', context['stage']), ('role', context['role']),
                      ('current_owner_scope', common['owner_support']['current_owner_scope'])]:
        _join(facts[key], want)
    _join(facts['lease_support'], common['lease_support'])
    _join(facts['selection_support'], common['selection_support'])
    descriptors = context['prior_dependencies']
    _need(type(descriptors) is list and len(descriptors) <= 44, 'E_CONTEXT_SCHEMA')
    for descriptor in descriptors:
        _descriptor(descriptor, store)
    _need({d['role'] for d in descriptors} == _required(context['stage'], context['role']) and
          len(descriptors) == len(_required(context['stage'], context['role'])), 'E_CONTEXT_SCHEMA')
    _join(facts['dependencies'], [d['dependency'] for d in descriptors])
    stage_roles = [context['role']] if context['stage'] == 'phase_bound' else STAGE_ROLES[context['stage']]
    here = bound.manifest['I2_support']['Source']['path'].rsplit('\\', 1)[0]
    exact_outputs = []
    for output_role in stage_roles:
        draft_path = rows[output_role]['draft_path']
        exact_outputs.extend([draft_path,
            here + '\\stage_receipts\\ROOT_CURRENT_OWNER_' + output_role.upper() + '_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json',
            here + '\\source_diffs\\' + draft_path.rsplit('\\', 1)[1] + '.diff'])
    _join(context['expected_output_paths'], sorted(exact_outputs))
    _need(not {p['path'].casefold() for p in context['expected_input_pins']} &
              {p.casefold() for p in exact_outputs}, 'E_STAGE_PURPOSE_CYCLE')
    for d in descriptors:
        _prior(d, common, store, rows, bound, outputs=context['expected_output_paths'])
    _closed(i2_arguments, 'I2_arguments13')
    args = _copy(i2_arguments)
    manifest = bound.manifest
    for key, want in [('expected_root_thread', common['root_thread']), ('stage', context['stage']),
                      ('physical_actor', '/root'), ('facts', context['facts']['path']),
                      ('expected_facts_sha256', context['facts']['sha256']),
                      ('facts_review', context['stage_support']['different_review']['path']),
                      ('expected_facts_review_sha256', context['stage_support']['different_review']['sha256']),
                      ('facts_Root_adoption', context['stage_support']['Root_adoption']['path']),
                      ('expected_facts_Root_adoption_sha256', context['stage_support']['Root_adoption']['sha256']),
                      ('owner_support_manifest', common['owner_support_manifest']['path']),
                      ('expected_owner_support_manifest_sha256', common['owner_support_manifest']['sha256']),
                      ('expected_self_sha256', manifest['I2_support']['Source']['sha256']),
                      ('expected_API_sha256', manifest['I2_support']['API']['sha256'])]:
        _join(args[key], want)
    for key in ('owner_support_manifest', 'facts', 'facts_review', 'facts_Root_adoption'):
        args[key] = Path(args[key])
    _mechanical_module(i2_producer, manifest['I2_support'], store,
                       ('execute_stage', 'admit', 'canonical_dependency'), I2_MODULE_NAME)
    caller = sys.modules.get(__name__)
    _mechanical_module(caller, manifest['caller_support'], store,
                       ('_generation_impl', '_I2_canonical_dependency_dispatch'), CALLER_MODULE_NAME)
    _need(_ACTIVE_GENERATION_SESSION is None and
          getattr(i2_producer, '_I12_HELD_CALLER_MODULE', None) is None,
          'E_GENERATION_SESSION_MISMATCH')
    session = _Session(context, store, bound, i2_producer, caller)
    _ACTIVE_GENERATION_SESSION = session
    i2_producer._I12_HELD_CALLER_MODULE = caller
    try:
        # New I2 admit remains unconditional refusal; no generation success claim.
        return i2_producer.execute_stage(argparse.Namespace(**args))
    finally:
        i2_producer._I12_HELD_CALLER_MODULE = None
        _ACTIVE_GENERATION_SESSION = None


def _I2_canonical_dependency_dispatch(*, support, rows, selection_pin):
    session = _ACTIVE_GENERATION_SESSION
    _need(type(session) is _Session, 'E_GENERATION_SESSION_REQUIRED')
    _need(session._caller_module is sys.modules.get(__name__) and
          getattr(session._i2_producer, '_I12_HELD_CALLER_MODULE', None) is session._caller_module,
          'E_GENERATION_SESSION_MISMATCH')
    context = _decode(session._generation_bytes)
    records = [dict(pin=_decode(p), body=b) for p, b in session._record_pairs]
    context, store, selected_rows, bound = _start(context, records, 'generation_context')
    _join(bound.manifest, _decode(session._manifest_bytes))
    _need(_same(rows, selected_rows) and
          _same(selection_pin, context['common']['selection_support']['selection']),
          'E_GENERATION_SESSION_MISMATCH')
    matches = [d for role, body in session._prior_index for d in [_decode(body)]
               if role == support.get('role') and _same(d['dependency'], support)]
    _need(len(matches) == 1 and matches[0]['role'] in _required(context['stage'], context['role']),
          'E_GENERATION_SESSION_MISMATCH')
    return _prior(matches[0], context['common'], store, rows, bound,
                  outputs=context['expected_output_paths'])


def _trusted(value, schema, store, common, bound):
    _closed(value, schema)
    _pins(value['expected_inputs'], 252 if schema == 'I8_trusted10' else 256, 1)
    _paths(value['expected_output_paths'], 18, 1 if schema == 'I8_trusted10' else 0)
    births = value['recorded_births_ns']
    _need(type(births) is dict and len(births) <= 256 and
          all(type(n) is int and n > 0 for n in births.values()), 'E_CONTEXT_SCHEMA')
    for path in births:
        _path(path)
    for pin in value['expected_inputs']:
        store.body(pin)
    _need(all(p['path'].casefold() not in {s.casefold() for s in value['expected_output_paths']}
              for p in value['expected_inputs']), 'E_STAGE_PURPOSE_CYCLE')
    if schema == 'I8_trusted10':
        _support(value['owner_support'], 'owner3')
        _join(value['owner_support'], common['owner_support'])
        for key in ('lease_producer_support', 'publisher_support'):
            _support(value[key], 'code4')
        for key in ('continuing_owner', 'owner_review', 'purpose_full_proof'):
            store.body(_pin(value[key]))
        _pins(value['historical_leases'], 4, 4)
    else:
        for key, wanted in [('current_owner_scope', common['owner_support']['current_owner_scope']),
                            ('canonical_lease', common['lease_support']['canonical']),
                            ('selection', common['selection_support']['selection']), ('M3_predecessor_inventory', common['M3_inventory'])]:
            _join(value[key], wanted)
        _support(value['producer_support'], 'code4')
        _actor(value['producer_Source_editor'], False)
        _need(type(value['actual_content_authors']) is list and len(value['actual_content_authors']) <= 32,
              'E_CONTEXT_SCHEMA')
        for actor in value['actual_content_authors']:
            _actor(actor)
        _need(len({a.casefold() for a in value['actual_content_authors']}) == len(value['actual_content_authors']),
              'E_CONTEXT_SCHEMA')
        # Conservative complete author closure, including all45/prior/proof/code
        # roles; an inherited32 limit that cannot contain it is a typed refusal.
        _need(len(bound.excluded) <= 32, 'E_CONTEXT_SCHEMA')
        _join(value['actual_content_authors'], sorted(bound.excluded))
        supports = value['stage_supports']
        _need(type(supports) is dict and 0 < len(supports) <= 8, 'E_CONTEXT_SCHEMA')
        valid_keys = {'templates', 'manifest', 'capture', 'phase_binding'} | {
            'phase_bound:' + role for role in FINITE8 if role.endswith('_bound')}
        _need(set(supports) <= valid_keys, 'E_CONTEXT_SCHEMA')
        for support in supports.values():
            _support(support, 'stage_support3')


def _i9_join(value, context, store, rows, request=None, stage=None, role=None):
    common, trusted = context['common'], context['I9_trusted']
    for key, wanted in [('request', request), ('current_owner_scope', common['owner_support']['current_owner_scope']),
                        ('canonical_lease', common['lease_support']['canonical']), ('selection', common['selection_support']['selection']),
                        ('producer_support', trusted['producer_support']), ('M3_predecessor_inventory', common['M3_inventory']),
                        ('expected_output_paths', trusted['expected_output_paths']), ('validated_now_utc', common['now_utc'])]:
        _join(value.get(key), wanted)
    _false(value, I9_FALSE_FLAGS)
    _need(value.get('metadata_only') is True and value.get('recorded_M3_semantics_validated') is True and
          value.get('frozen_detached') is True, 'E_LAYER_CONTEXT_JOIN')
    groups = value.get('validated_stage_groups')
    _need(type(groups) is list and 0 < len(groups) <= 8, 'E_LAYER_CONTEXT_JOIN')
    actual = {}
    for group in groups:
        _closed(group, 'i9_group7')
        _need(type(group['stage']) is str and
              (group['role'] is None or type(group['role']) is str), 'E_LAYER_CONTEXT_JOIN')
        key = group['stage'] + (':' + group['role'] if group['role'] is not None else '')
        _need(key not in actual and key in trusted['stage_supports'], 'E_LAYER_CONTEXT_JOIN')
        actual[key] = group
        support = trusted['stage_supports'][key]
        for k, target in [('facts', 'facts'), ('stage_review', 'different_review'), ('stage_Root_adoption', 'Root_adoption')]:
            _join(group[k], support[target])
        artifacts = group['artifacts']
        _need(type(artifacts) is list, 'E_LAYER_CONTEXT_JOIN')
        expected_roles = [group['role']] if group['stage'] == 'phase_bound' else STAGE_ROLES.get(group['stage'])
        _need(expected_roles is not None and [a.get('role') for a in artifacts if type(a) is dict] == expected_roles and
              len(artifacts) == len(expected_roles), 'E_LAYER_CONTEXT_JOIN')
        purpose = _closed(group['stage_purpose'], 'purpose6')
        _join(purpose['facts'], group['facts'])
        _join(purpose['stage'], group['stage'])
        _join(purpose['role'], group['role'])
        for artifact in artifacts:
            _closed(artifact, 'i9_artifact8')
            _need(type(artifact['role']) is str and artifact['role'] in rows, 'E_LAYER_CONTEXT_JOIN')
            row = rows[artifact['role']]
            _join(artifact['predecessor'], row['predecessor'])
            _need(artifact['draft']['path'] == row['draft_path'] and artifact['canonical_path'] == row['canonical_path'],
                  'E_LAYER_CONTEXT_JOIN')
            for name in ('draft', 'diff', 'author_receipt', 'actual_diff_removed_byte_basis'):
                store.body(_pin(artifact[name], row['source_cap'] if name == 'draft' else 2097152))
            inverse = artifact['explicit_inverse_artifacts']
            _need(type(inverse) is list and len(inverse) <= 512, 'E_LAYER_CONTEXT_JOIN')
            for pin in inverse:
                store.body(_pin(pin))
            _need(len({p['path'].casefold() for p in inverse}) == len(inverse), 'E_LAYER_CONTEXT_JOIN')
    if request is None:
        _need(set(actual) == {stage + (':' + role if role is not None else '')}, 'E_LAYER_CONTEXT_JOIN')
    else:
        requested = store.record(request)['rows']
        keys = {'templates' if item['role'].endswith('_template') else 'phase_bound:' + item['role'] for item in requested}
        _need(set(actual) == keys, 'E_LAYER_CONTEXT_JOIN')
        artifacts = [a for group in groups for a in group['artifacts']]
        for item in requested:
            matches = [a for a in artifacts if a['role'] == item['role']]
            _need(len(matches) == 1, 'E_LAYER_CONTEXT_JOIN')
            _join(matches[0]['draft'], item['draft'])
            _join(matches[0]['author_receipt'], item['author_receipt'])


def _recorded_stage_impl(*, context, records):
    context, store, rows, bound = _start(context, records, 'recorded_stage_context')
    common = context['common']
    _required(context['stage'], context['role'])
    _need(type(context['prior_dependencies']) is list and len(context['prior_dependencies']) <= 44,
          'E_CONTEXT_SCHEMA')
    _trusted(context['I9_trusted'], 'I9_trusted11', store, common, bound)
    for d in context['prior_dependencies']:
        _prior(d, common, store, rows, bound)
    module = bound.layer('I9')
    result = module.validate_recorded_M3_stage_semantics(
        stage=context['stage'], role=context['role'], trusted_bindings=context['I9_trusted'],
        read_record=store.read_record, expected_root_thread=common['root_thread'],
        source_editor=common['source_editor'], now_utc=common['now_utc'])
    value = _view(result)
    _i9_join(value, context, store, rows, stage=context['stage'], role=context['role'])
    return MetadataView(dict(kind='recorded_stage', I9_metadata=value))


def _prewrite_impl(*, context, records):
    context, store, rows, bound = _start(context, records, 'prewrite_context')
    common = context['common']
    request_pin = _pin(context['current_request'])
    request = _closed(store.record(request_pin), 'request21')
    requested = request['rows']
    _need(type(requested) is list and 0 < len(requested) <= 4, 'E_LAYER_CONTEXT_JOIN')
    for item in requested:
        _closed(item, 'request_row10')
    names = [r['role'] for r in requested]
    _need(all(type(r) is str and r in FINITE8 for r in names), 'E_CONTEXT_SCHEMA')
    _need(len(names) == len(requested) and len(set(names)) == len(names) and
          names == [r for r in FINITE8 if r in names] and
          not any(r.endswith('_template') and r.replace('_template', '_bound') in names for r in names),
          'E_LAYER_CONTEXT_JOIN')
    for schema in ('I8_trusted10', 'I9_trusted11'):
        _trusted(context['I8_trusted' if schema.startswith('I8') else 'I9_trusted'], schema, store, common, bound)
    _support(context['publication_purpose'], 'support3')
    i8b, i9b = context['I8_trusted'], context['I9_trusted']
    _join(request['Root_thread'], common['root_thread'])
    _join(request['current_owner_support'], common['owner_support'])
    _join(request['new_lease_support'], common['lease_support'])
    _support(request['Root_future_path_selection_support'], 'support3')
    _join(request['Root_future_path_selection_support'], dict(
        subject=common['selection_support']['selection'],
        different_review=common['selection_support']['different_review'],
        Root_adoption=common['selection_support']['Root_adoption']))
    _support(request['predecessor_inventory_support'], 'support3')
    _join(request['predecessor_inventory_support']['subject'], common['publisher_catalogue'])
    producer = {k: bound.manifest['I2_support'][k] for k in SCHEMAS['code4']}
    publisher = {k: bound.manifest['layers']['I7'][k] for k in SCHEMAS['code4']}
    _closed(request['producer_supports'], ('M3',))
    _join(request['producer_supports']['M3'], producer)
    _join(i9b['producer_support'], producer)
    _join(i9b['producer_Source_editor'], bound.manifest['I2_support']['editor'])
    _join(i8b['publisher_support'], publisher)
    for key, wanted in [('publisher_source', publisher['Source']), ('publisher_API', publisher['API']),
                        ('publisher_Source_review', publisher['different_review']),
                        ('publisher_Root_adoption', publisher['Root_adoption'])]:
        _join(request[key], wanted)
    _join(i8b['expected_output_paths'], i9b['expected_output_paths'])
    aux = list(context['publication_purpose'].values()) + [i8b['purpose_full_proof']]
    roster = i8b['expected_inputs'] + aux
    _need(len(roster) <= 256 and len({p['path'].casefold() for p in roster}) == len(roster) and
          set(i8b['recorded_births_ns']) == {p['path'] for p in roster} and
          set(i9b['recorded_births_ns']) == {p['path'] for p in i9b['expected_inputs']}, 'E_STAGE_PURPOSE_CYCLE')
    for pin in roster:
        store.body(pin)
    shared = set(i8b['recorded_births_ns']) & set(i9b['recorded_births_ns'])
    _need(all(i8b['recorded_births_ns'][p] == i9b['recorded_births_ns'][p] for p in shared), 'E_LAYER_CONTEXT_JOIN')
    _need(type(context['prior_dependencies']) is list and len(context['prior_dependencies']) <= 44,
          'E_CONTEXT_SCHEMA')
    for d in context['prior_dependencies']:
        _prior(d, common, store, rows, bound, request_pin, i8b['expected_output_paths'])
    i8, i9, i7 = bound.layer('I8'), bound.layer('I9'), bound.layer('I7')
    resource = common['resource']
    i8_resource = dict(observed_utc=resource['observed_utc'], available_RAM_bytes=resource['available_RAM_bytes'],
                       disk_free_bytes=resource['free_disk_bytes'])
    result8 = i8.validate_current_owner_M3_prewrite_metadata(
        request_pin=request_pin, purpose_support=context['publication_purpose'], trusted_bindings=i8b,
        read_record=store.read_record, expected_root_thread=common['root_thread'], source_editor=common['source_editor'],
        now_utc=common['now_utc'], resource_observation=i8_resource)
    result9 = i9.validate_recorded_M3_prewrite_semantics(
        request_pin=request_pin, trusted_bindings=i9b, read_record=store.read_record,
        expected_root_thread=common['root_thread'], source_editor=common['source_editor'], now_utc=common['now_utc'])
    value8, value9 = _view(result8), _view(result9)
    for key, want in [('request', request_pin), ('purpose', context['publication_purpose']['subject']),
                      ('owner_support', common['owner_support']), ('canonical_lease', common['lease_support']['canonical']),
                      ('selected_roles', names), ('output_paths', i8b['expected_output_paths']),
                      ('verified_input_pins', i8b['expected_inputs']), ('validated_now_utc', common['now_utc'])]:
        _join(value8.get(key), want)
    _false(value8, ('actual_admission', 'caller_qualified', 'human_origin_authenticated',
                    'lease_native_provenance_authenticated', 'new_grants_issued', 'physical_origin_authenticated',
                    'producer_qualified', 'operational_authority', 'scientific_authority'))
    _need(value8.get('metadata_only') is True and value8.get('frozen_detached') is True, 'E_LAYER_CONTEXT_JOIN')
    _i9_join(value9, context, store, rows, request=request_pin)
    selected = [rows[r] for r in names]
    material = {item['role']: store.body(item['draft'], 65536) for item in requested}
    plan = i7.build_finite8_prewrite_metadata_plan(request=request, selected_rows=selected,
        draft_material=material, output_paths=i8b['expected_output_paths'])
    plan_value = _view(plan)
    _join(plan_value.get('request'), request)
    _join(plan_value.get('selected_rows'), selected)
    _join(sorted(plan_value.get('output_paths', [])), i8b['expected_output_paths'])
    expected_candidates = [dict(role=item['role'], declared_candidate=dict(path=item['canonical_path'],
        bytes=item['draft']['bytes'], sha256=item['draft']['sha256']), predecessor=rows[item['role']]['predecessor'],
        draft=item['draft']) for item in requested]
    _join(plan_value.get('declared_candidates'), expected_candidates)
    return MetadataView(dict(kind='prewrite', I8_metadata=value8, I9_metadata=value9, I7_plan=plan_value))


def _publication_impl(*, context, records):
    metadata = _prewrite_impl(context=context, records=records)
    context, store, rows, bound = _start(context, records, 'prewrite_context')
    if not REAL_IO_BINDINGS_QUALIFIED:
        raise CallerError('E_REAL_IO_BINDINGS_UNQUALIFIED')
    raise CallerError('E_REAL_IO_BINDINGS_UNQUALIFIED')
    # Explicit prospective intent only: old I7 has no accepted production ABI.
    i7 = bound.layer('I7')
    values = metadata.to_dict()
    return i7.publish_current_owner_finite8(request_pin=context['current_request'],
        request=store.record(context['current_request']), metadata_plan=values['I7_plan'],
        owner_lease_purpose_metadata=values['I8_metadata'], recorded_semantics_metadata=values['I9_metadata'])


def _postbirth_publication_impl(*, context, records):
    context, store, rows, bound = _start(context, records, 'postbirth_publication_context')
    request = _closed(store.record(context['original_request']), 'request21')
    record = _closed(store.record(context['record']), 'publication43')
    store.body(context['execution_witness'])
    _path(context['expected_publication_path'])
    _need(context['record']['path'] == context['expected_publication_path'], 'E_LAYER_CONTEXT_JOIN')
    _join(record['actual_Root_request'], context['original_request'])
    _join(record['current_owner_scope'], context['common']['owner_support']['current_owner_scope'])
    _join(record['Root_future_path_selection'], context['common']['selection_support']['selection'])
    _join(record['actual_new_lease'], context['common']['lease_support']['canonical'])
    i7 = bound.layer('I7')
    result = i7.construct_publication43(record=record, request=request)
    return MetadataView(dict(kind='finite8_postbirth_publication_metadata', I7_metadata=_view(result)))


def _reconciliation_impl(*, context, records):
    context, store, rows, bound = _start(context, records, 'postbirth_reconciliation_context')
    request = _closed(store.record(context['original_request']), 'request21')
    publication = _closed(store.record(context['original_publication']), 'publication43')
    record = _closed(store.record(context['reconciliation_record']), 'reconciliation26')
    _need(record['record_type'] == 'Root_owner_v2_verified_prior_finite8_M3_Source_publication_reconciliation',
          'E_LAYER_CONTEXT_JOIN')
    store.body(context['execution_witness'])
    _join(record['initial_actual_Root_request'], context['original_request'])
    _join(record['initial_actual_canonical_publication_receipt'], context['original_publication'])
    _join(record['initial_actual_execution_witness'], context['execution_witness'])
    _join(record['actual_canonical_delta_Source_review'], context['canonical_delta_review'])
    _join(record['canonical_delta_Root_adoption'], context['canonical_delta_Root_adoption'])
    for key, want in [('current_owner_scope', context['common']['owner_support']['current_owner_scope']),
                      ('Root_future_path_selection', context['common']['selection_support']['selection']),
                      ('new_canonical_lease', context['common']['lease_support']['canonical'])]:
        _join(record[key], want)
    _need(context['reconciliation_record']['path'] == _path(context['expected_reconciliation_path']), 'E_LAYER_CONTEXT_JOIN')
    subjects = [context['original_request'], context['original_publication'], context['execution_witness'],
                record['canonical_Source'], record['exact_draft_Source']]
    review = bound.review(context['canonical_delta_review'], subjects)
    bound.adopt(context['canonical_delta_Root_adoption'], subjects, context['canonical_delta_review'], review)
    _need(_time(publication['created_utc']) <= _time(review[1]['created_utc']) <=
          _time(record['created_utc']) <= _time(context['common']['now_utc']), 'E_LAYER_CONTEXT_JOIN')
    i7 = bound.layer('I7')
    result = i7.construct_reconciliation26(record=record, original_publication=publication, request=request)
    metadata = MetadataView(dict(kind='finite8_postbirth_reconciliation_metadata', I7_metadata=_view(result)))
    # I6's actual45/historical45 domain assumption remains explicitly unqualified.
    if not REAL_IO_BINDINGS_QUALIFIED:
        raise CallerError('E_POSTBIRTH_ADAPTER_UNQUALIFIED')
    raise CallerError('E_POSTBIRTH_ADAPTER_UNQUALIFIED')
    return i7.reconcile_current_owner_finite8(original_request_pin=context['original_request'],
        original_publication_pin=context['original_publication'], execution_witness_pin=context['execution_witness'],
        reconciliation_metadata=metadata.to_dict())
