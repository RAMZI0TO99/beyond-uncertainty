KNOWN_TYPE_DESCRIPTORS = ('I5_closed9_lease_support', 'actor', 'actor (historical nominal only)', 'actor_child', 'actor_child equals actual content actor', 'actor_child equals author', 'base64', 'builtin_bool equal role==phase_peer', 'builtin_bytes', 'builtin_int', 'builtin_int0', 'builtin_int1', 'builtin_int75', 'canonical_UUID', 'code_support5', 'decision_support3', 'enum:render|binding|config', 'enum:render|binding|config|publish', 'exact generic9 role list', 'exact ordered constructor_implemented_record_kinds in catalogue002', 'exact ordered list from companion by result kind', 'exact peer_format_roles list', 'fact3', 'false', 'generic9_role', 'generic9_role at graph; other source_role gives E_UNSUPPORTED_PRODUCER_ROUTE', 'int2', 'list(recorded_observation12 | fixed_spent_observation10)', 'list(recorded_observation12)', 'list9_builtin_int', 'list_actor_additive', 'list_builtin_int', 'literal:/root', 'literal:ACCEPT_CURRENT_CANONICAL_SOURCE_DELTA_AND_VERIFIED_PRIOR_ROOT_PUBLICATION_ONLY', 'literal:ADMIT_SEPARATE_CURRENT_OWNER_LAWFUL_COHORT_METADATA_STAGE', 'literal:Fresh verification of the precisely named prior real Root publication; this reconciliation performs only its own metadata create-once write.', 'literal:PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY', 'literal:PASS_STATIC_SELECTED_PEER_METADATA_CONTENT_ONLY', 'literal:PUBLISH_EXACT_REVIEWED_SOURCE_ONLY_SELECTED_ROLE', 'literal:Root_owner_v2_selected_role_Source_canonical_publication', 'literal:Root_owner_v2_selected_role_deferred_metadata_stage_receipt', 'literal:Root_owner_v2_selected_role_exact_reviewed_Source_publication_request', 'literal:UNWIRED', 'literal:phase_peer', 'literal:publish', 'literal:validate_generic_single_dependency_metadata', 'literal:validate_selected_peer_receipt_metadata', 'literal_record_type', 'native_path', 'nonnegative_builtin_int<=256', 'nonnegative_builtin_int<=33554432', 'null', 'opaque_json_object', 'opaque_json_object (bounded metadata data; no dependency qualification or recursion)', 'ordinary_pin', 'ordinary_pin for phase_peer;null otherwise', 'ordinary_pin for publish;null otherwise', 'ordinary_pin phase_peer;null otherwise', 'outside8_role', 'peer_role', 'peer_role excluding phase_peer', 'phase_parser_support9_v2 (reference shape only)', 'pin_list equal actual_support_fact3s', 'pin_list nonempty', 'pin_list nonempty<=512', 'pin_list<=512; recorded references only', 'positive_builtin_int<=held_cap', 'proposal_support3', 'publication_details5', 'publication_stage_support6 when stage=publish; opaque_json_object otherwise', 'review_support2', 'sha256', 'subject_support3', 'true', 'utc')
SINGLE_UNWIRED = ('ACTUAL_GENERIC_PRODUCER_UNQUALIFIED', 'ACTUAL_GENERIC_PUBLISHER_UNQUALIFIED', 'ACTUAL_SINGLE_RECONCILIATION_EMITTER_UNWIRED', 'HUMAN_REVIEW_NOT_AUTHENTICATED', 'PHYSICAL_METADATA_NOT_MEASURED', 'CURRENT_OWNER_AND_LEASE_ELIGIBILITY_UNQUALIFIED', 'FULL_I2_G01_OPEN', 'ACTUAL_FAMILY_NATIVE8_PARSER_RUNTIME_SCIENCE_HELD')
