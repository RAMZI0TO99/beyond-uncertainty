CATALOGUE_PIN = {'path': r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015\I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json', 'bytes': CATALOGUE_BYTES, 'sha256': CATALOGUE_SHA256}
