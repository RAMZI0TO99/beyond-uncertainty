class I12Error(ValueError):
    def __init__(self, code):
        self.code = code
        super().__init__(code)


def _need(ok, code):
    if not ok:
        raise I12Error(code)


def _tree(value, counter, depth=0):
    _need(depth <= 48, 'E_DEPTH')
    counter[0] += 1
    _need(counter[0] <= 50000, 'E_NODES')
    if value is None or type(value) in (bool, int):
        return
    if type(value) is str:
        _need(not any(0xD800 <= ord(c) <= 0xDFFF for c in value), 'E_VALUE')
        return
    if type(value) is list:
        for child in value:
            _tree(child, counter, depth + 1)
        return
    if type(value) is dict:
        for key, child in value.items():
            _need(type(key) is str, 'E_VALUE')
            _tree(key, counter, depth + 1)
            _tree(child, counter, depth + 1)
        return
    raise I12Error('E_VALUE')


def _wire(value):
    try:
        return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
    except (TypeError, ValueError, UnicodeError, RecursionError):
        raise I12Error('E_JSON') from None


def _pairs(items):
    value = {}
    for key, child in items:
        _need(key not in value, 'E_DUPLICATE_JSON_KEY')
        value[key] = child
    return value


def _bad_number(value):
    raise I12Error('E_JSON_NUMBER')


def _decode(raw, counter, byte_code='E_METADATA_CAP'):
    _need(type(raw) is bytes and 0 < len(raw) <= CAP, byte_code)
    try:
        value = json.loads(raw.decode('utf8'),object_pairs_hook=_pairs,parse_float=_bad_number,parse_constant=_bad_number)
    except I12Error:
        raise
    except (ValueError, UnicodeError, RecursionError):
        raise I12Error('E_JSON') from None
    _tree(value, counter)
    return value


def _same(a, b):
    return _wire(a) == _wire(b)


def _closed(value, keys, code='E_SCHEMA'):
    _need(type(value) is dict and all(type(key) is str for key in value) and set(value) == set(keys), code)
    return value


def _path(value):
    _need(type(value) is str and 3 < len(value) <= 32767 and re.fullmatch(r'[A-Z]:\\[^/]+',value) is not None, 'E_PATH')
    _need(not any(ord(c) < 32 or ord(c) == 127 for c in value) and ':' not in value[2:], 'E_PATH')
    for part in value[3:].split('\\'):
        _need(bool(part) and part not in ('.','..') and not part.endswith((' ','.')) and
              not any(c in part for c in '<>"|?*') and
              re.fullmatch(r'(CON|PRN|AUX|NUL|CLOCK\$|COM[1-9]|LPT[1-9])(?:\..*)?',part,re.I) is None, 'E_PATH')
    return value


def _pin(value, cap=CAP):
    _closed(value, ('path','bytes','sha256'), 'E_PIN')
    _path(value['path'])
    _need(type(cap) is int and 0 < cap <= CAP and type(value['bytes']) is int and 0 < value['bytes'] <= cap, 'E_PIN_BYTES')
    _need(type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}',value['sha256']) is not None, 'E_PIN_SHA256')
    return value


def _actor(value, child=False):
    _need(type(value) is str and len(value) <= 512 and re.fullmatch(r'/root(?:/[A-Za-z0-9_-]+)*',value) is not None and
          (not child or value.casefold() != '/root'), 'E_ACTOR')
    return value


def _time(value):
    _need(type(value) is str, 'E_TIME')
    m = re.fullmatch(r'([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})\.([0-9]{6,7})\+00:00',value)
    _need(m is not None, 'E_TIME')
    try:
        instant = datetime.datetime(*(int(m[i]) for i in range(1,7)))
    except ValueError:
        raise I12Error('E_TIME') from None
    seconds = (instant - datetime.datetime(1,1,1)).days*86400 + instant.hour*3600 + instant.minute*60 + instant.second
    return seconds*10000000 + int(m[7].ljust(7,'0'))


def _pin_list(value, nonempty=False):
    _need(type(value) is list and int(nonempty) <= len(value) <= 512, 'E_PIN_LIST')
    paths = []
    for pin in value:
        _pin(pin); paths.append(pin['path'].casefold())
    _need(len(set(paths)) == len(paths), 'E_PIN_LIST')
    return value


def _catalogue(raw):
    _need(type(raw) is bytes and len(raw) == CATALOGUE_BYTES and hashlib.sha256(raw).hexdigest() == CATALOGUE_SHA256, 'E_CATALOGUE_PIN')
    value = _decode(raw, [0])
    _need(type(value) is dict and value.get('revision') == 2 and value.get('record_type') == 'I12_exact_receipt_contract_schema_and_fixed_data_catalogue', 'E_CATALOGUE_PIN')
    return value


def _typed(value, typ, catalogue, context):
    """Interpret only the finite adopted catalogue DSL; no eval or import."""
    _need(type(typ) is str and typ in KNOWN_TYPE_DESCRIPTORS, 'E_UNSUPPORTED_FIELD_TYPE')
    if typ in catalogue['schemas']:
        return _schema(value, typ, catalogue)
    if typ == 'literal_record_type':
        return
    if typ.startswith('literal:'):
        _need(type(value) is str and value == typ[8:], 'E_SCHEMA_VALUE'); return
    if typ == 'false':
        _need(value is False, 'E_AUTHORITY'); return
    if typ == 'true':
        _need(value is True, 'E_SCHEMA_VALUE'); return
    if typ == 'null':
        _need(value is None, 'E_SCHEMA_VALUE'); return
    if typ == 'int2' or typ == 'builtin_int1':
        _need(type(value) is int and value == (2 if typ == 'int2' else 1), 'E_VERSION'); return
    if typ == 'utc':
        _time(value); return
    if typ == 'native_path':
        _path(value); return
    if typ.startswith('ordinary_pin'):
        if value is None and ('null' in typ or 'None' in typ):
            return
        _pin(value); return
    if typ.startswith('actor'):
        _actor(value, typ.startswith('actor_child')); return
    if typ == 'sha256':
        _need(type(value) is str and re.fullmatch('[0-9a-f]{64}', value) is not None, 'E_PIN_SHA256'); return
    if typ == 'base64':
        _need(type(value) is str and value.isascii(), 'E_INVERSE')
        try:
            raw=base64.b64decode(value,validate=True)
        except (ValueError,UnicodeError):
            raise I12Error('E_INVERSE') from None
        _need(base64.b64encode(raw).decode('ascii')==value, 'E_INVERSE'); return
    if typ.startswith('opaque_json_object'):
        _need(type(value) is dict, 'E_SCHEMA_VALUE'); return
    if typ == 'builtin_bytes':
        _need(type(value) is bytes, 'E_VALUE'); return
    if typ.startswith('positive_builtin_int'):
        _need(type(value) is int and 0 < value <= CAP, 'E_PIN_BYTES'); return
    if typ == 'builtin_int':
        _need(type(value) is int, 'E_SCHEMA_VALUE'); return
    if typ == 'list_builtin_int' or typ == 'list9_builtin_int':
        _need(type(value) is list and all(type(v) is int for v in value) and (typ != 'list9_builtin_int' or len(value) == 9), 'E_OBSERVATION'); return
    if typ.startswith('pin_list'):
        _pin_list(value, 'nonempty' in typ); return
    if typ == 'source_role' or typ.startswith('outside8_role') or typ.startswith('generic9_role') or typ.startswith('peer_role'):
        allowed = set(catalogue['ROLE_SOURCE_CAPS'])
        if typ.startswith('outside8_role'): allowed -= set(catalogue['finite8_roles'])
        if typ.startswith('generic9_role'): allowed = set(catalogue['generic9_roles'])
        if typ.startswith('peer_role'): allowed = set(catalogue['peer_format_roles'])
        if 'excluding phase_peer' in typ: allowed.discard('phase_peer')
        _need(type(value) is str and value in allowed, 'E_UNSUPPORTED_PRODUCER_ROUTE'); return
    if typ.startswith('enum:'):
        _need(type(value) is str and value in typ[5:].split('|'), 'E_SCHEMA_VALUE'); return
    if typ == 'publication_stage_support6 when stage=publish; opaque_json_object otherwise':
        if context['stage'] == 'publish': _schema(value,'publication_stage_support6',catalogue)
        else: _need(type(value) is dict, 'E_SCHEMA_VALUE')
        return
    if typ.startswith('list(recorded_observation12'):
        _need(type(value) is list and len(value) <= 512, 'E_OBSERVATION')
        for observation in value:
            _need(type(observation) is dict, 'E_OBSERVATION')
            _need('exact_spent_exception' not in observation or 'fixed_spent_observation10' in typ, 'E_OBSERVATION')
            name = 'fixed_spent_observation10' if 'exact_spent_exception' in observation else 'recorded_observation12'
            _schema(observation,name,catalogue)
        return
    if typ.startswith('phase_parser_support9_v2'):
        _schema(value,'phase_parser_support9_v2',catalogue); return
    if typ == 'exact ordered constructor_implemented_record_kinds in catalogue002':
        _need(_same(value,catalogue['constructor_implemented_record_kinds']), 'E_SCHEMA_VALUE'); return
    if typ == 'exact generic9 role list':
        _need(_same(value,catalogue['generic9_roles']), 'E_SCHEMA_VALUE'); return
    if typ == 'exact peer_format_roles list':
        _need(_same(value,catalogue['peer_format_roles']), 'E_SCHEMA_VALUE'); return
    if typ == 'canonical_UUID':
        _need(type(value) is str and re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',value) is not None, 'E_ROOT_THREAD'); return
    if typ == 'list_actor_additive':
        _need(type(value) is list and len(value) <= 512, 'E_ACTOR')
        for actor in value: _actor(actor)
        _need(len({x.casefold() for x in value}) == len(value), 'E_ACTOR'); return
    if typ in ('builtin_int0','builtin_int75'):
        _need(type(value) is int and value==(0 if typ=='builtin_int0' else 75), 'E_SCHEMA_VALUE'); return
    if typ.startswith('nonnegative_builtin_int<='):
        _need(type(value) is int and 0<=value<=int(typ.split('<=')[1]), 'E_SCHEMA_VALUE'); return
    if typ == 'builtin_bool equal role==phase_peer':
        _need(type(value) is bool and value==(context['role']=='phase_peer'), 'E_SCHEMA_VALUE'); return
    if typ == 'exact ordered list from companion by result kind':
        expected=list(PEER_UNWIRED if context['record_type']=='I12_selected_peer_author_receipt_metadata_view' else SINGLE_UNWIRED)
        _need(_same(value,expected), 'E_SCHEMA_VALUE'); return
    raise I12Error('E_UNSUPPORTED_FIELD_TYPE')


def _schema(value, name, catalogue):
    spec = catalogue['schemas'][name]
    _closed(value,spec['fields'])
    if 'schema_version' in spec:
        _need(type(value.get('schema_version')) is int and value['schema_version'] == spec['schema_version'], 'E_VERSION')
    if 'record_type' in spec:
        _need(type(value.get('record_type')) is str and value['record_type'] == spec['record_type'], 'E_RECORD_TYPE')
    for key, typ in spec['fields'].items():
        _typed(value[key],typ,catalogue,value)
    if name in ('phase_content_decision15_v2','generic_peer_content_decision13_v2'):
        _need(value['author']==value['reviewer'] and _same(value['actual_current_Source_inputs'],value['actual_support_fact3s']), 'E_RECORD_JOIN')
    if name in ('constructor_API13','held_generic_emitter_API14','single_graph_API13','peer_graph_API13'):
        _need(value['actual_Source_editor']==value['author'], 'E_RECORD_JOIN')
    if name=='peer_inverse12_v2':
        rebuilt=base64.b64decode(value['complete_predecessor_bytes_base64'],validate=True)
        _need(len(rebuilt)==value['predecessor']['bytes'] and hashlib.sha256(rebuilt).hexdigest()==value['inverse_sha256']==value['predecessor']['sha256'], 'E_INVERSE')
    if name in ('recorded_observation12','fixed_spent_observation10'):
        for key in ('raw9','path9','descriptor9'):
            _need(len(value[key])==9, 'E_OBSERVATION')
        a,b=value['path9'],value['descriptor9']
        _need(value['raw9']==a and a[2]==b[2]==value['bytes'] and a[6]==b[6]==1 and a[5]&0o170000==b[5]&0o170000==0o100000 and not(a[7]&0x400 or b[7]&0x400) and all(a[i]==b[i] for i in catalogue['ordinary_observation_shared7']), 'E_OBSERVATION')
        if name=='recorded_observation12':
            _pin({k:value[k] for k in ('path','bytes','sha256')},value['cap'])
            _need(value['shared_identity_indexes']==catalogue['ordinary_observation_shared7'] and value['shared_descriptor7']==[b[i] for i in catalogue['ordinary_observation_shared7']], 'E_OBSERVATION')
        else:
            fixed={p['path']:p for p in catalogue['spent_pin75']}
            archive={p['path'] for p in catalogue['archival_spent2']}
            _need(value['path'] in fixed, 'E_SPENT_IDENTITY')
            pin=fixed[value['path']]
            _need(value['bytes']==pin['bytes'] and value['sha256']==pin['sha256'] and value['cap']==(4194304 if value['path'] in archive else CAP), 'E_SPENT_IDENTITY')
    return value



HISTORICAL_SELECTION45_PIN = {'path': r'D:\Aenv\pro2\WORK\resume-20261007-001\generation\observer010_lease009_root_001\ROOT_STEP077_FINAL_DATED_COMPLETE_SOURCE_STATE_SELECTION_001.json', 'bytes': 23858, 'sha256': '637da5caf2e7875fa84e5d54939b2cd8ae79377f372328597cc8b6b5cdbd0f5e'}


class _Store:
    def __init__(self, records, counter):
        _need(type(records) is list and 0 < len(records) <= 256, 'E_RECORD_COUNT')
        self.counter, self.bodies, self.pins, self.cache = counter, {}, {}, {}
        self.total = 0
        folded = set()
        for row in records:
            _closed(row, ('pin','body'), 'E_RECORD_SCHEMA')
            pin = _pin(row['pin'])
            raw = row['body']
            _need(type(raw) is bytes, 'E_RECORD_BODY')
            _need(0 < len(raw) <= CAP and len(raw) == pin['bytes'], 'E_RECORD_LENGTH')
            _need(hashlib.sha256(raw).hexdigest() == pin['sha256'], 'E_RECORD_HASH')
            self.total += len(raw)
            _need(self.total <= 33554432, 'E_RECORD_TOTAL')
            key = pin['path']
            _need(key.casefold() not in folded, 'E_RECORD_ALIAS')
            folded.add(key.casefold())
            self.pins[key] = _decode(_wire(pin),counter)
            self.bodies[key] = raw
    def raw(self, pin, cap=CAP):
        _pin(pin,cap)
        _need(pin['path'] in self.pins and _same(self.pins[pin['path']],pin), 'E_RECORD_MISSING')
        return self.bodies[pin['path']]
    def record(self, pin, schema=None):
        raw = self.raw(pin)
        key = pin['path']
        if key not in self.cache:
            self.cache[key] = _decode(raw,self.counter)
        value = self.cache[key]
        _need(type(value) is dict, 'E_SCHEMA')
        return value


def _occurs(value, pin):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'} and _same(value,pin):
            return True
        return any(_occurs(v,pin) for v in value.values())
    if type(value) is list:
        return any(_occurs(v,pin) for v in value)
    return False


def _noauth(value):
    _need(value.get('target_execution') is False and value.get('operational_authority') is False, 'E_AUTHORITY')
    for key in ('target_execution','operational_authority','scientific_authority','actual_admission','actual_entry006','runtime_acceptance','science_acceptance','physical_IO_qualified','human_review_authenticated'):
        if key in value:
            _need(value[key] is False, 'E_AUTHORITY')


class _Graph:
    def __init__(self, *, packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc, peer):
        self.c = _catalogue(catalogue_bytes)
        self.counter = [0]
        _need(type(packet) is bytes, 'E_PACKET_BYTES')
        self.p = _decode(packet,self.counter,'E_PACKET_BYTES')
        _schema(self.p,'peer_packet20' if peer else 'single_packet22',self.c)
        self.peer = peer
        self.now_text,self.now = now_utc,_time(now_utc)
        self.editor = _actor(source_editor,True)
        _need(type(expected_root_thread) is str and re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',expected_root_thread) is not None and self.p['root_thread'] == expected_root_thread, 'E_ROOT_THREAD')
        self.s = _Store(records,self.counter)
        self.scope,self.lease,self.selection_pin = self.p['owner_scope'],self.p['lease'],self.p['selection_support']['subject']
        self.s.raw(self.scope);self.s.raw(self.lease)
        self.selection = self.s.record(self.selection_pin)
        self._selection()
        self.role = self.p['role']
        self.row = self.rows[self.role]
        self.cap = self.c['ROLE_SOURCE_CAPS'][self.role]
        self.s.raw(self.p['draft'],self.cap);self.s.raw(self.p['predecessor'],self.cap)
        _need(self.p['draft']['path'] == self.row['draft_path'] and _same(self.p['predecessor'],self.row['predecessor']), 'E_SELECTED_MATERIAL')
        _need(self.p['draft']['sha256'] != self.p['predecessor']['sha256'], 'E_SELECTED_MATERIAL')
        self.excluded = {'/root',ACTUAL_SOURCE_EDITOR.casefold(),self.editor.casefold()}
        for actor in self.p['actual_content_authors']:
            self.excluded.add(_actor(actor).casefold())
        for role,row in self.rows.items():
            if role != 'composer':
                self.excluded.add(_actor(row['preparation_Source_author']).casefold())
                self.excluded.add(_actor(row['retained_semantic_Source_author']).casefold())
        self.codes = [('constructor',self.p['constructor_support'],'constructor_API13')]
        if not peer:self.codes.append(('emitter',self.p['emitter_support'],'held_generic_emitter_API14'))
        for name,support,schema in self.codes:
            _schema(support,'code_support5',self.c)
            self.s.raw(support['Source'],65536)
            api = self.record(support['API'],schema)
            _need(_same(api['Source'],support['Source']) and api['author'] == api['actual_Source_editor'] == support['editor'] and _same(api['protocol'],PROTOCOL_PIN) and _same(api['catalogue'],CATALOGUE_PIN), 'E_CODE_API')
            self.excluded.add(_actor(support['editor'],True).casefold())
            self.excluded.add(_actor(api['author'],True).casefold())
        self._proof_author_slots()
    def record(self,pin,schema=None):
        value=self.s.record(pin)
        if schema:_schema(value,schema,self.c)
        return value
    def _selection(self):
        value=self.selection
        _closed(value,('author','created_utc','current_complete45_inventory','current_owner_scope','current_selection','derived_launcher_runtime_path','new_canonical_lease','operational_authority','record_type','rows','schema_version','selected_Source_nonce','target_execution'))
        _need(type(value['schema_version']) is int and value['schema_version']==2 and value['record_type']=='Root_owner_v2_actual_separate_future45_Source_path_selection' and value['author']=='/root', 'E_SELECTION')
        _noauth(value);_time(value['created_utc']);_path(value['derived_launcher_runtime_path'])
        _need(type(value['selected_Source_nonce']) is str and re.fullmatch('[0-9a-f]{32}',value['selected_Source_nonce']) is not None, 'E_SELECTION')
        _need(_same(value['current_owner_scope'],self.scope) and _same(value['new_canonical_lease'],self.lease) and _same(value['current_selection'],self.c['current_historical_selection_pin']), 'E_INVENTORY_DOMAIN')
        old=self.s.record(value['current_selection'])
        _need(type(old.get('rows')) is list and len(old['rows'])==45, 'E_SELECTION')
        prior={}
        for row in old['rows']:
            _need(type(row) is dict and type(row.get('role')) is str and row['role'] not in prior, 'E_SELECTION')
            prior[row['role']]=row
        _need(set(prior)==set(self.c['ROLE_SOURCE_CAPS'])|{'composer'}, 'E_SELECTION')
        inventory=self.s.record(self.c['M3_inventory17_pin'])
        _need(type(inventory.get('roles')) is list and len(inventory['roles'])==17, 'E_INVENTORY_DOMAIN')
        basis={}
        for row in inventory['roles']:
            _need(type(row) is dict and type(row.get('role')) is str and 'available_basis' in row and row['role'] not in basis, 'E_INVENTORY_DOMAIN')
            basis[row['role']]=_pin(row['available_basis'],self.c['ROLE_SOURCE_CAPS'].get(row['role'],CAP))
        _need(_same(value['current_complete45_inventory'],HISTORICAL_SELECTION45_PIN), 'E_INVENTORY_DOMAIN')
        historical=self.s.record(value['current_complete45_inventory'])
        _need(value['current_complete45_inventory'] != value['current_selection'] and value['current_complete45_inventory'] != self.c['M3_inventory17_pin'] and type(historical) is dict, 'E_INVENTORY_DOMAIN')
        self.rows={};canonical=set();drafts=set()
        _need(type(value['rows']) is list and len(value['rows'])==45, 'E_SELECTION')
        for row in value['rows']:
            _closed(row,('canonical_path','draft_path','must_change_Source_bytes','predecessor','preparation_Source_author','retained_semantic_Source_author','role','selected_ordinal','source_cap'))
            role=row['role']
            _need(type(role) is str and role in prior and role not in self.rows, 'E_SELECTION')
            cap=65536 if role=='composer' else self.c['ROLE_SOURCE_CAPS'][role]
            _need(type(row['source_cap']) is int and row['source_cap']==cap, 'E_SELECTION')
            _pin(row['predecessor'],cap);_path(row['canonical_path'])
            if role=='composer':
                _need(_same(row,prior[role]) and row['draft_path'] is None and row['selected_ordinal'] is None and row['preparation_Source_author'] is None and row['retained_semantic_Source_author'] is None and row['must_change_Source_bytes'] is False and row['canonical_path']==row['predecessor']['path'], 'E_SELECTION')
            else:
                _path(row['draft_path']);_actor(row['preparation_Source_author']);_actor(row['retained_semantic_Source_author'])
                _need(row['must_change_Source_bytes'] is True and type(row['selected_ordinal']) is int and 0<row['selected_ordinal']<1000 and row['canonical_path']!=row['predecessor']['path'] and row['canonical_path'].rsplit('\\',1)[-1]==row['draft_path'].rsplit('\\',1)[-1] and row['retained_semantic_Source_author']==prior[role].get('retained_semantic_Source_author'), 'E_SELECTION')
                _need(row['draft_path'].casefold() not in drafts, 'E_SELECTION');drafts.add(row['draft_path'].casefold())
                if role in basis:_need(_same(row['predecessor'],basis[role]), 'E_SELECTION')
            _need(row['canonical_path'].casefold() not in canonical, 'E_SELECTION');canonical.add(row['canonical_path'].casefold())
            self.rows[role]=row
        _need(set(self.rows)==set(prior), 'E_SELECTION')
        _need(not canonical.intersection(drafts), 'E_SELECTION')
    def _proof_author_slots(self, extra=()):
        # Designated proof edges only. Reviewer/author-in-reviewer-role is excluded
        # from this scan, so a review does not exclude itself as an author.
        author_keys=('source_author','Source_author','actual_Source_editor','physical_Source_editor','source_editor','metadata_Source_worker','retained_semantic_Source_author','content_author')
        pending=list(extra)
        for name,support,schema in self.codes:
            pending.extend((support['different_review'],support['Root_adoption']))
        for support_key in ('selection_support','canonical_support','reconciliation_support','content_support','proposal_support'):
            if support_key in self.p:
                support=self.p[support_key]
                pending.extend((support['different_review'],support['Root_adoption']))
        def author_slots(value):
            if type(value) is dict:
                for key,child in value.items():
                    if key in author_keys:self.excluded.add(_actor(child).casefold())
                    else:author_slots(child)
            elif type(value) is list:
                for child in value:author_slots(child)
        seen=set()
        for pin in pending:
            key=_pin(pin)['path']
            if key in seen:continue
            seen.add(key);v=self.s.record(pin)
            author_slots(v)
            if 'full_proof' in v:
                full=self.s.record(_pin(v['full_proof']))
                author_slots(full)
    def add_actors(self,*records):
        keys=('author','physical_actor','physical_Source_editor','physical_selected_byte_editor','physical_receipt_author','metadata_Source_worker','retained_semantic_Source_author','genuine_content_author_and_reviewer','original_peer_source_author_nominal')
        for v in records:
            for k in keys:
                if k in v:self.excluded.add(_actor(v[k]).casefold())
    def review(self,pin,subjects,code=False):
        for subject in subjects:self.s.raw(subject)
        capsule=self.s.record(pin);_noauth(capsule)
        who=_actor(capsule.get('reviewer'),True);key=who.casefold()
        _need(all(key!=a and (a=='/root' or not key.startswith(a+'/')) for a in self.excluded), 'E_REVIEWER')
        verdict=capsule.get('verdict')
        _need(type(verdict) is str and verdict.startswith('PASS_') and (not code or 'SOURCE' in verdict.upper()) and type(capsule.get('checks_failed')) is int and capsule['checks_failed']==0, 'E_REVIEW')
        full_pin=_pin(capsule.get('full_proof'));full=self.s.record(full_pin);_noauth(full)
        _need(full.get('reviewer')==who and full.get('verdict')==verdict and type(full.get('checks_failed')) is int and full['checks_failed']==0, 'E_REVIEW')
        checks=full.get('checks')
        _need(type(checks) is list and 0<len(checks)<=10000, 'E_REVIEW')
        names=[]
        for check in checks:
            _need(type(check) is dict and type(check.get('name')) is str and bool(check['name']) and check.get('passed') is True, 'E_REVIEW')
            names.append(check['name'])
        _need(len(names)==len(set(names)) and type(capsule.get('checks_passed')) is int and type(full.get('checks_passed')) is int and capsule['checks_passed']==full['checks_passed']==len(checks)>0, 'E_REVIEW')
        for v in (capsule,full):_need(all(_occurs(v,p) for p in subjects), 'E_REVIEW_COVERAGE')
        ft,ct=_time(full.get('created_utc')),_time(capsule.get('created_utc'))
        _need(ft<=ct<=self.now, 'E_CHRONOLOGY')
        return dict(capsule=capsule,full=full,full_pin=full_pin,full_time=ft,capsule_time=ct)
    def adopt(self,pin,subjects,review_pin,review):
        v=self.s.record(pin);_noauth(v)
        _need(v.get('author')=='/root' and type(v.get('verdict')) is str and v['verdict'].startswith('ACCEPT_'), 'E_ADOPTION')
        _need(all(_occurs(v,p) for p in [*subjects,review_pin,review['full_pin'],self.scope,self.selection_pin]), 'E_ADOPTION_COVERAGE')
        t=_time(v.get('created_utc'));_need(review['capsule_time']<=t<=self.now, 'E_CHRONOLOGY')
        return t
    def support(self,support,subjects,code=False):
        r=self.review(support['different_review'],subjects,code)
        t=self.adopt(support['Root_adoption'],subjects,support['different_review'],r)
        return r,t
    def prepare_proofs(self):
        latest=0
        for name,support,schema in self.codes:
            r,t=self.support(support,[support['Source'],support['API']],True);latest=max(latest,t)
        r,t=self.support(self.p['selection_support'],[self.selection_pin,self.lease])
        _need(_time(self.selection['created_utc'])<=r['full_time'], 'E_CHRONOLOGY')
        return max(latest,t)
    def observations(self,values,required,spent=False,before=None):
        _need(type(values) is list and len(values)<=512, 'E_OBSERVATION')
        paths=set();ordinary={};matched=set()
        fixed={p['path']:p for p in self.c['spent_pin75']}
        empty={p['path'] for p in self.c['empty_spent11']}
        archive={p['path'] for p in self.c['archival_spent2']}
        for v in values:
            _need(type(v) is dict, 'E_OBSERVATION')
            special='exact_spent_exception' in v
            _schema(v,'fixed_spent_observation10' if special else 'recorded_observation12',self.c)
            path=_path(v['path']);_need(path.casefold() not in paths, 'E_OBSERVATION');paths.add(path.casefold())
            _need(type(v['bytes']) is int and type(v['cap']) is int, 'E_OBSERVATION')
            if special:
                _need(spent and path in fixed, 'E_SPENT_IDENTITY')
                fp=fixed[path]
                _need(v['bytes']==fp['bytes'] and v['sha256']==fp['sha256'] and v['cap']==(4194304 if path in archive else CAP) and (v['bytes']>0 or path in empty), 'E_SPENT_IDENTITY')
                matched.add(path)
            else:
                caps=[cap for p,cap in required if p['path']==path]
                for role,row in self.rows.items():
                    if path in (row['canonical_path'],row['draft_path'],row['predecessor']['path']):caps.append(65536 if role=='composer' else self.c['ROLE_SOURCE_CAPS'][role])
                rolecap=min(caps) if caps else v['cap']
                pin=_pin({k:v[k] for k in ('path','bytes','sha256')},rolecap)
                _need(v['cap']==rolecap and 0<v['bytes']<=v['cap']<=CAP, 'E_OBSERVATION')
                self.s.raw(pin,rolecap);ordinary[path]=pin
            for key in ('raw9','path9','descriptor9'):
                _need(type(v[key]) is list and len(v[key])==9 and all(type(x) is int for x in v[key]), 'E_OBSERVATION')
            a,b=v['path9'],v['descriptor9']
            _need(v['raw9']==a and v['two_read_match'] is True and a[2]==b[2]==v['bytes'] and a[6]==b[6]==1 and a[5]&0o170000==b[5]&0o170000==0o100000 and not(a[7]&0x400 or b[7]&0x400) and all(a[i]==b[i] for i in self.c['ordinary_observation_shared7']), 'E_OBSERVATION')
            if not special:
                _need(v['both_full_API9_independently_stable'] is True and v['shared_identity_indexes']==self.c['ordinary_observation_shared7'] and v['shared_descriptor7']==[b[i] for i in self.c['ordinary_observation_shared7']], 'E_OBSERVATION')
            t=_time(v['observed_utc']);_need(t<=(self.now if before is None else before), 'E_CHRONOLOGY')
        _need(all(p['path'] in ordinary and _same(ordinary[p['path']],p) for p,cap in required), 'E_OBSERVATION_COVERAGE')
        if spent is True:_need(matched==set(fixed), 'E_SPENT_SET')
        return len(matched)
    def result(self,peer):
        p=self.p
        value=dict(schema_version=1,record_type='I12_selected_peer_author_receipt_metadata_view' if peer else 'I12_generic_single_dependency_metadata_view',role=self.role,selection=self.selection_pin,current_owner_scope=self.scope,lease=self.lease,constructor_Source=p['constructor_support']['Source'],constructor_API=p['constructor_support']['API'],verified_record_count=len(self.s.bodies),verified_record_bytes=self.s.total,recorded_spent_observation_count=0 if peer else 75,exact_spent_whitelist_matches=0 if peer else 75,validated_now_utc=self.now_text,metadata_only=True,format_validated=True,producer_route_status='UNWIRED')
        value.update({key:False for key in FALSE_FLAGS})
        if peer:
            for key in ('receipt','draft','predecessor','proposal','content_decision','serialization_witness','inverse_evidence','recipe_sources','current_source_inputs','context'):value[key]=p[key]
            value.update(content_review=p['content_support']['different_review'],content_Root_adoption=p['content_support']['Root_adoption'],proposal_review=p['proposal_support']['different_review'],proposal_Root_adoption=p['proposal_support']['Root_adoption'],held_context_route_present=self.role=='phase_peer',selected_peer27_metadata_graph_validated=True,canonical_dependency_ABI_metadata_validated=False,unwired_obligations=['ACTUAL_SELECTED_PEER_PRODUCER_UNWIRED','CANONICAL_PEER_PUBLISHER_ROUTE_UNWIRED','CONTENT_AND_INVERSE_ALGORITHM_SEMANTICS_UNQUALIFIED','HUMAN_REVIEW_NOT_AUTHENTICATED','PHYSICAL_METADATA_NOT_MEASURED','CURRENT_OWNER_AND_LEASE_ELIGIBILITY_UNQUALIFIED','FULL_I2_G01_OPEN','ACTUAL_FAMILY_NATIVE8_PARSER_RUNTIME_SCIENCE_HELD'])
        else:
            for key in ('request','generation_receipt','generation_facts','publication_facts','canonical','draft','predecessor','reconciliation'):value[key]=p[key]
            value.update(original_publication=p['publication'],canonical_review=p['canonical_support']['different_review'],canonical_Root_adoption=p['canonical_support']['Root_adoption'],reconciliation_review=p['reconciliation_support']['different_review'],reconciliation_Root_adoption=p['reconciliation_support']['Root_adoption'],emitter_Source=p['emitter_support']['Source'],emitter_API=p['emitter_support']['API'],single29_metadata_graph_validated=True,canonical_dependency_ABI_metadata_validated=True,unwired_obligations=['ACTUAL_GENERIC_PRODUCER_UNQUALIFIED','ACTUAL_GENERIC_PUBLISHER_UNQUALIFIED','ACTUAL_SINGLE_RECONCILIATION_EMITTER_UNWIRED','HUMAN_REVIEW_NOT_AUTHENTICATED','PHYSICAL_METADATA_NOT_MEASURED','CURRENT_OWNER_AND_LEASE_ELIGIBILITY_UNQUALIFIED','FULL_I2_G01_OPEN','ACTUAL_FAMILY_NATIVE8_PARSER_RUNTIME_SCIENCE_HELD'])
        _schema(value,self.c['result_schema_names']['peer' if peer else 'single'],self.c)
        raw=_wire(value);_need(len(raw)<=CAP,'E_METADATA_CAP')
        return raw

class _Single(_Graph):
    def validate(self):
        p,c=self.p,self.c
        request=self.record(p['request'])
        publication=self.record(p['publication'])
        for value,schema in ((request,'single_request14_v2'),(publication,'single_publication29_v2')):
            _need(value.get('record_type')==c['schemas'][schema]['record_type'], 'E_UNSUPPORTED_PUBLICATION_ABI')
            _schema(value,schema,c)
        generation=self.record(p['generation_receipt'],'generic_stage_receipt29_v2')
        gf=self.record(p['generation_facts'],'generic_late_facts26_v2')
        pf=self.record(p['publication_facts'],'generic_late_facts26_v2')
        gd=self.record(p['generation_stage_decision'],'generic_stage_decision14_v2')
        pd=self.record(p['publication_stage_decision'],'generic_stage_decision14_v2')
        recon=self.record(p['reconciliation'],'single_reconciliation26_v2')
        self.add_actors(request,publication,generation,gf,pf,gd,pd,recon)
        stage='binding' if self.role=='binding' else 'config' if self.role=='checker_config' else 'render'
        support=_schema(pf['stage_support'],'publication_stage_support6',c)
        self._proof_author_slots([support[k] for k in ('draft_Source_review','draft_Root_adoption','generation_receipt_review','generation_receipt_Root_adoption')])
        earliest=self.prepare_proofs()
        emitter=p['emitter_support']
        for value,expected_stage in ((gf,stage),(pf,'publish'),(gd,stage),(pd,'publish'),(generation,stage),(publication,'publish')):
            _need(value['role']==self.role and value['stage']==expected_stage and _same(value['current_owner_scope'],self.scope) and _same(value['Root_selection'],self.selection_pin) and _same(value['tool_source'],emitter['Source']), 'E_SINGLE_JOIN')
        for value in (gf,pf,generation,publication):
            _need(value['metadata_Source_worker']==self.row['preparation_Source_author'], 'E_ACTOR_JOIN')
            _need(_same(value['predecessor'],p['predecessor']), 'E_SINGLE_JOIN')
            if 'retained_semantic_Source_author' in value:
                _need(value['retained_semantic_Source_author']==self.row['retained_semantic_Source_author'], 'E_ACTOR_JOIN')
            lease_support=_schema(value['lawful_lease_support'],'I5_closed9_lease_support',c)
            _need(_same(lease_support['canonical'],self.lease) and _same(lease_support,gf['lawful_lease_support']), 'E_SINGLE_JOIN')
            for pin in lease_support.values():self.s.raw(pin)
        for value in (gf,pf):
            _need(_same(value['tool_review'],emitter['different_review']) and _same(value['tool_Root_adoption'],emitter['Root_adoption']) and _same(value['selection_review'],p['selection_support']['different_review']) and _same(value['selection_Root_adoption'],p['selection_support']['Root_adoption']), 'E_SINGLE_JOIN')
        for value in (generation,publication):
            _need(_same(value['tool_Source_review'],emitter['different_review']) and _same(value['tool_Root_adoption'],emitter['Root_adoption']) and _same(value['draft'],p['draft']), 'E_SINGLE_JOIN')
        for value in (gd,pd):_need(_same(value['lawful_lease'],self.lease), 'E_SINGLE_JOIN')
        _need(_same(gf['stage_decision'],p['generation_stage_decision']) and _same(pf['stage_decision'],p['publication_stage_decision']) and _same(generation['actual_Root_late_facts'],p['generation_facts']) and _same(publication['actual_Root_late_facts'],p['publication_facts']), 'E_SINGLE_JOIN')
        _need(gf['publication_request'] is None and _same(pf['publication_request'],p['request']) and generation['original_request'] is None and generation['canonical'] is None, 'E_SINGLE_JOIN')
        _need(_same(request['current_owner_scope'],self.scope) and _same(request['Root_selection'],self.selection_pin) and request['role']==self.role and _same(request['draft'],p['draft']) and request['canonical_path']==self.row['canonical_path'], 'E_SINGLE_JOIN')
        _need(_same(request['Source_review'],support['draft_Source_review']) and _same(request['Root_adoption'],support['draft_Root_adoption']) and _same(publication['original_request'],p['request']), 'E_SINGLE_JOIN')
        _need(_same(support['draft'],p['draft']) and _same(support['generation_receipt'],p['generation_receipt']), 'E_SINGLE_JOIN')
        details=_schema(publication['details'],'publication_details5',c)
        for key,pin in (('generation_receipt',p['generation_receipt']),('different_draft_Source_review',support['draft_Source_review']),('Root_draft_adoption',support['draft_Root_adoption']),('original_request',p['request'])):
            _need(_same(details[key],pin), 'E_SINGLE_JOIN')
        canonical=_pin(p['canonical'],self.cap)
        _need(canonical['path']==self.row['canonical_path'] and _same(publication['canonical'],canonical) and canonical['path']!=p['draft']['path'] and canonical['path']!=p['predecessor']['path'] and self.s.raw(canonical,self.cap)==self.s.raw(p['draft'],self.cap), 'E_SELECTED_MATERIAL')
        self.observations(generation['actual_paired_metadata_inputs'],[(p['draft'],self.cap)],spent='optional',before=_time(generation['created_utc']))
        self.observations(publication['actual_paired_metadata_inputs'],[(p['draft'],self.cap),(canonical,self.cap)],spent=True,before=_time(publication['created_utc']))
        draft_review,draft_time=self.support(dict(different_review=support['draft_Source_review'],Root_adoption=support['draft_Root_adoption']),[p['draft']])
        gen_review,gen_time=self.support(dict(different_review=support['generation_receipt_review'],Root_adoption=support['generation_receipt_Root_adoption']),[p['generation_receipt']])
        gd_t,gf_t,gen_t=(_time(v['created_utc']) for v in (gd,gf,generation))
        pd_t,pf_t,req_t,pub_t=(_time(v['created_utc']) for v in (pd,pf,request,publication))
        _need(earliest<=gd_t<=gf_t<=gen_t<=min(draft_review['full_time'],gen_review['full_time']) and max(draft_time,gen_time)<=pd_t<=pf_t<=req_t<=pub_t<=self.now, 'E_CHRONOLOGY')
        for key,pin in (('canonical_Source',canonical),('exact_draft_Source',p['draft']),('initial_actual_Root_request',p['request']),('initial_actual_canonical_publication_receipt',p['publication']),('initial_actual_execution_witness',p['execution_witness']),('current_owner_scope',self.scope),('Root_future_path_selection',self.selection_pin),('new_canonical_lease',self.lease),('prior_actual_publisher_Source',emitter['Source']),('actual_canonical_delta_Source_review',p['canonical_support']['different_review']),('canonical_delta_Root_adoption',p['canonical_support']['Root_adoption'])):
            _need(_same(recon[key],pin), 'E_RECONCILIATION_JOIN')
        _need(recon['prior_publication_created_utc']==publication['created_utc'], 'E_RECONCILIATION_JOIN')
        self.observations(recon['actual_input_observations'],[],before=_time(recon['created_utc']))
        subjects=[canonical,p['draft'],p['generation_receipt'],p['request'],p['publication'],p['execution_witness'],self.scope,self.selection_pin]
        canonical_review,canonical_time=self.support(p['canonical_support'],subjects)
        birth=_time(recon['canonical_Source_birth_utc']);recon_time=_time(recon['created_utc'])
        _need(req_t<=birth<=pub_t<=canonical_review['full_time']<=canonical_time<=recon_time, 'E_CHRONOLOGY')
        recon_review,recon_adopt=self.support(p['reconciliation_support'],[p['reconciliation'],canonical,p['publication'],self.scope,self.selection_pin])
        _need(recon_time<=recon_review['full_time']<=recon_adopt<=self.now, 'E_CHRONOLOGY')
        return self.result(False)


def validate_generic_single_dependency_metadata(*, packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc):
    return _Single(packet=packet,records=records,catalogue_bytes=catalogue_bytes,expected_root_thread=expected_root_thread,source_editor=source_editor,now_utc=now_utc,peer=False).validate()


def execute_stage(*args, **kwargs):
    raise I12Error('E_ACTUAL_ENTRY_UNWIRED')
