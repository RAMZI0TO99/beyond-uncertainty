def pin(path):
    path = Path(path)
    raw = path.read_bytes()
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}


def data(rel):
    return json.loads((REPO / rel).read_bytes())


def literal_constants(rel, names):
    """Parse source as data. literal_eval only named literal assignment values."""
    tree = ast.parse((REPO / rel).read_bytes())
    result = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in names:
                value = node.value
                if isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id == 'frozenset' and len(value.args) == 1:
                    value = value.args[0]
                result[name] = ast.literal_eval(value)
    if set(result) != set(names):
        raise ValueError('named literal constant inventory incomplete')
    return result


