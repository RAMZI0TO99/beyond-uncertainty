"""Static narrow fixture006 correction author; no target import/call/test."""
import ast
import base64
import datetime as dt
import hashlib
import json
from pathlib import Path

HERE=Path(__file__).parent;OUT=HERE/'i11';CAP=2097152
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def create(path,raw):
    assert 0<len(raw)<=CAP,(path,len(raw))
    with path.open('xb') as handle:handle.write(raw)
    return pin(path)
def assignment(text,name):
    node=next(n for n in ast.parse(text).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    return node,ast.literal_eval(node.value)
def replace_assignment(text,name,value):
    node,_=assignment(text,name);lines=text.splitlines(keepends=True)
    return ''.join(lines[:node.lineno-1])+name+' = '+repr(value)+'\n'+''.join(lines[node.end_lineno:])

source=OUT/'validate_finite8_canonical_receipt_metadata_003.py'
old_fixture=OUT/'test_finite8_canonical_receipt_metadata_memory_only_005.py'
old_api=OUT/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_005.json'
fixture=old_fixture.read_text(encoding='utf8')
old=r"path=HOME+'\facts-fresh-clone.json'"
new=r"path=HOME+r'\facts-fresh-clone.json'"
assert fixture.count(old)==1;fixture=fixture.replace(old,new,1)
_,cases=assignment(fixture,'CASE_CATALOGUE')
_,mapping=assignment(fixture,'PROTOCOL_VARIANT_CASE_MAPPING')
_,covered=assignment(fixture,'FINAL_VARIANT_GAP_TABLE_COVERAGE')
_,reach=assignment(fixture,'SOURCE_ONLY_REACHABILITY')
name='stage_purpose_actual_bool_version'
case=(name,'record',['receipt:WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_template',['steps','metadata_Source_provenance','stage_purpose','schema_version'],True],'E_STAGE_PURPOSE')
assert type(case[2][2]) is bool and name not in {c[0] for c in cases}
cases.append(case);mapping['N03']['case_names'].append(name)
covered['stage_purpose_bool_version']=dict(case_names=[name],expected_error='E_STAGE_PURPOSE',first_guard_note='Actual builtin boolTrue at stage_purpose.schema_version; distinct from existing integer1 case despite Python True==1.')
reach.update(receipt_wrong_facts_pin='Fresh clone suffix AST constant is literal backslash + facts-fresh-clone.json, with no form-feed/C0. Clone valid facts body under a new supplied path; stage support pin mismatch reaches E_STAGE_PURPOSE.',stage_purpose_actual_bool_version='Literal catalogue AST type is boolTrue, never integer1 reuse; strict purpose version type check reaches E_STAGE_PURPOSE.')
for key,value in [('CASE_CATALOGUE',cases),('PROTOCOL_VARIANT_CASE_MAPPING',mapping),('FINAL_VARIANT_GAP_TABLE_COVERAGE',covered),('SOURCE_ONLY_REACHABILITY',reach)]:fixture=replace_assignment(fixture,key,value)
raw=fixture.encode();tree=ast.parse(raw);compile(raw,'<fixture006 data compile>','exec')
suffixes=[n.value for n in ast.walk(tree) if isinstance(n,ast.Constant) and type(n.value) is str and n.value.endswith('facts-fresh-clone.json') and len(n.value)<64]
assert suffixes==['\\facts-fresh-clone.json'] and all(ord(c)>=32 for c in suffixes[0])
_,literal=assignment(fixture,'CASE_CATALOGUE');assert literal==cases and type(next(c for c in literal if c[0]==name)[2][2]) is bool
names={c[0] for c in cases};assert len(names)==len(cases)
for value in mapping.values():assert set(value['case_names'])<=names
for value in covered.values():assert set(value['case_names'])<=names
sp=pin(source);assert sp['sha256']=='51f71572b21d76063300a33eeaddc578d19892721ff59cb027faeee335a44f3f'
fp=create(OUT/'test_finite8_canonical_receipt_metadata_memory_only_006.py',raw)
api=json.loads(old_api.read_bytes());api.update(Source=sp,fixture_Source=fp,created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),literal_case_catalogue=cases,literal_case_count=len(cases),
    protocol_variant_case_mapping=mapping,Source_only_guard_reachability=reach,final_variant_gap_table_coverage=covered,fixture005_preserved=pin(old_fixture),API005_preserved=pin(old_api),
    correction_author_tool=pin(Path(__file__)),fixture006_correction='Fresh facts clone path uses raw literal backslash. Actual boolTrue purpose-version case is separate from integer1 and mapped exactly. No validator semantic change or target execution.')
ap=create(OUT/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_006.json',(json.dumps(api,sort_keys=True,indent=2)+'\n').encode())
regions=[]
for path,body in ((source,source.read_bytes()),(Path(fp['path']),raw)):
    lines=body.splitlines(keepends=True)
    for n in ast.parse(body).body:
        if isinstance(n,(ast.FunctionDef,ast.ClassDef)):
            part=b''.join(lines[n.lineno-1:n.end_lineno]);regions.append(dict(path=str(path),name=n.name,first_line=n.lineno,last_line=n.end_lineno,bytes=len(part),sha256=hashlib.sha256(part).hexdigest()))
inv=dict(schema_version=1,record_type='I11_fixture006_complete_predecessor_inverse_and_exact_regions',author='/root/i2_resume_gap',Source=sp,fixture=fp,API=ap,
    complete_predecessors=[dict(pin=pin(p),complete_bytes_base64=base64.b64encode(p.read_bytes()).decode()) for p in (old_fixture,old_api)],regions=regions,case_catalogue=cases,literal_case_count=len(cases),new_cases=[case],
    exact_variant_mapping=mapping,final_variant_gap_table=api['final_variant_gap_table'],final_variant_gap_table_coverage=covered,Source_only_guard_reachability=reach,
    AST_literal_bool_type_verified=True,AST_literal_clone_path_without_control_characters_verified=True,author_tool=pin(Path(__file__)),tests_executed=False,target_execution=False,validator003_preserved=sp,old_targets_changed=False)
ip=create(OUT/'I11_EXACT_SOURCE_REGION_AND_NO_OLD_TARGET_CHANGE_INVENTORY_006.json',(json.dumps(inv,sort_keys=True,indent=2)+'\n').encode())
receipt=dict(schema_version=1,record_type='I11_fixture006_static_narrow_literal_correction_author_receipt',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    Source=sp,fixture=fp,API=ap,inventory=ip,author_tool=pin(Path(__file__)),predecessors=[pin(old_fixture),pin(old_api)],literal_case_count=len(cases),final_variant_gap_table_rows=len(covered),
    AST_literal_catalogue_verified=True,actual_bool_version_type_verified=True,clone_suffix_backslash_no_C0_verified=True,all_created_artifacts_below_2MiB=True,
    target_imports=0,target_calls=0,tests_executed=False,target_execution=False,old_target_changes=False,operational_authority=False,scientific_authority=False,full_G01_closed=False)
rp=create(OUT/'I11_FINITE8_CANONICAL_RECEIPT_METADATA_SOURCE_AUTHOR_RECEIPT_006.json',(json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(Source=sp,fixture=fp,API=ap,inventory=ip,receipt=rp,literal_cases=len(cases),tests_executed=False),sort_keys=True))
