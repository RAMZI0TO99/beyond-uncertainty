"""Static supervisor006 + saved-refusal repair binding author; no target calls."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path
HERE=Path(__file__).parent
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def create(path,raw):
    assert 0<len(raw)<=2097152
    with path.open('xb') as handle:handle.write(raw)
    return pin(path)
def literal(text,name):
    node=next(n for n in ast.parse(text).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    return node,ast.literal_eval(node.value)
def assign(text,name,value):
    node,_=literal(text,name);lines=text.splitlines(keepends=True)
    return ''.join(lines[:node.lineno-1])+name+' = '+repr(value)+'\n'+''.join(lines[node.end_lineno:])
old=HERE/'ROOT_I11_ONCE_MEMORY_SUPERVISOR_005.py';text=old.read_text(encoding='utf8')
fixture=pin(HERE/'i11'/'test_finite8_canonical_receipt_metadata_memory_only_007.py')
_,cases=literal(Path(fixture['path']).read_text(encoding='utf8'),'CASE_CATALOGUE')
digest=hashlib.sha256(json.dumps([c[0] for c in cases],separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
for key,value in [('FIXTURE',fixture),('EXPECTED_CASE_COUNT',len(cases)),('EXPECTED_CASE_NAMES_SHA256',digest)]:text=assign(text,key,value)
assert text.count("'_i11_new_fixture_006'")==1;text=text.replace("'_i11_new_fixture_006'","'_i11_new_fixture_007'",1)
raw=text.encode();ast.parse(raw);compile(raw,'<supervisor006 data compile>','exec')
sp=create(HERE/'ROOT_I11_ONCE_MEMORY_SUPERVISOR_006.py',raw)
old_receipt=HERE/'I11_SUPERVISOR005_STATIC_SOURCE_AUTHOR_RECEIPT_001.json';receipt=json.loads(old_receipt.read_bytes())
receipt.update(record_type='I11_supervisor006_static_owned_input_repair_binding_author_receipt',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),supervisor=sp,fixture=fixture,
    API=pin(HERE/'i11'/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_007.json'),previous_supervisor=pin(old),previous_author_receipt=pin(old_receipt),author_tool=pin(Path(__file__)),
    literal_case_count=len(cases),case_names_sha256=digest,correction='Only exact fresh fixture007 pin/count/name-digest and synthetic module-name binding change; once/60-50-10-5/EOF/custody Source unchanged. Actual attempt001 is preserved and cannot be replayed.',tests_executed=False,target_execution=False)
rp=create(HERE/'I11_SUPERVISOR006_STATIC_SOURCE_AUTHOR_RECEIPT_001.json',(json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
saved=[pin(p) for p in sorted((HERE/'owned_memory_runs'/'attempt001').iterdir()) if p.is_file()]
reviews=[pin(HERE/'results_review_attempt001'/'INDEPENDENT_I11_ATTEMPT001_SAVED_REFUSAL_CAPSULE_001.json'),
         pin(HERE/'results_review_attempt001'/'INDEPENDENT_I11_ATTEMPT001_SAVED_REFUSAL_FULL_PROOF_001.json'),
         pin(HERE/'ROOT_I11_ATTEMPT001_SAVED_REFUSAL_DIFFERENT_REVIEW_ADOPTION_001.json')]
binding=dict(schema_version=1,record_type='I11_fixture007_input_ownership_repair_exact_saved_refusal_binding',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
    Source=receipt['module'],fixture=fixture,API=receipt['API'],supervisor=sp,supervisor_author_receipt=rp,
    repair_author_receipt=pin(HERE/'i11'/'I11_FINITE8_CANONICAL_RECEIPT_METADATA_SOURCE_AUTHOR_RECEIPT_007.json'),saved_attempt001=saved,saved_refusal_review_and_Root_adoption=reviews,
    actual_CASE_PASS_events=271,first_shared_global_corruption_case_number=270,setup_failure_case_number=272,setup_failure_case_name='closed_fact3_missing_sha256',later_cases_unentered=389,
    independent_271_case_qualification_established=False,kernel_failure_demonstrated=False,old_attempt_or_fixture_replayed=False,
    repair='Copy fixed pin dictionaries and C literal subtree, deepcopy complete returned bundle, deepcopy every case spec. New positive/negative controls verify global snapshots and disjoint mutable identities across globals and sibling/fresh bundles.',
    proposed_fresh_case_count=len(cases),proposed_fresh_case_names_sha256=digest,new_fixture_imported_or_called=False,new_suite_executed=False,
    next_entry_requires='Genuine different Source review, Root adoption, fresh one-use scope and resource/peer scheduling; no automatic retry.',
    target_execution=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,full_G01_closed=False)
bp=create(HERE/'I11_FIXTURE007_REPAIR_EXACT_SAVED_REFUSAL_BINDING_001.json',(json.dumps(binding,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(supervisor=sp,receipt=rp,saved_refusal_binding=bp,literal_case_count=len(cases),case_names_sha256=digest,tests_executed=False),sort_keys=True))
