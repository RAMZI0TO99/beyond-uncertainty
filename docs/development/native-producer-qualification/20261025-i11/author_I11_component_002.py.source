def pin(path):
    raw=Path(path).read_bytes()
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def create(path,body):
    with path.open('xb') as handle:handle.write(body)
    return pin(path)


def replace_once(text,old,new):
    if text.count(old)!=1:raise ValueError('exact Source edit not unique: '+old[:100])
    return text.replace(old,new,1)


def assignment(text,name):
    tree=ast.parse(text)
    node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    return node,ast.literal_eval(node.value)


def replace_assignment(text,name,value):
    node,_=assignment(text,name)
    lines=text.splitlines(keepends=True)
    return ''.join(lines[:node.lineno-1])+name+' = '+repr(value)+'\n'+''.join(lines[node.end_lineno:])


