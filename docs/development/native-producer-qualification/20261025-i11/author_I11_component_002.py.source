def mutate(bundle, edits=(), body_edits=()):
    """Fresh finite DAG mutation: assert intended difference, rehash parents.
    Source001 helper is preserved in its complete predecessor bytes.
    """
    bundle=copy.deepcopy(bundle)
    store={r['pin']['path']:r for r in bundle['records']}
    values={p:json.loads(store[p]['body']) for p in bundle['_json_paths']}
    changed=set()
    for mark,path,value,delete in edits:
        target=bundle['_marks'].get(mark,mark)
        before=_wire(values[target])
        if path is None:
            values[target]=value
        else:
            node=values[target]
            for key in path[:-1]:node=node[key]
            if delete:
                assert path[-1] in node,'fixture delete must exist'
                del node[path[-1]]
            else:
                assert _wire(node.get(path[-1]) if type(node) is dict else node[path[-1]])!=_wire(value),'fixture mutation must differ'
                node[path[-1]]=value
        assert _wire(values[target])!=before,'fixture record mutation must change bytes'
        changed.add(target)
    for path,raw in body_edits:
        assert type(raw) is bytes and raw!=store[path]['body'],'fixture raw mutation must differ'
        values[path]=raw;changed.add(path)
    assert changed,'fixture mutation needs actual edit'
    memo={};active=set()
    def resolve(value):
        if type(value) is dict:
            path=value.get('path')
            if set(value)=={'path','bytes','sha256'} and path in values:return build(path)['pin']
            result={k:resolve(v) for k,v in value.items()}
            # Recorded observations retain their extra fields; update only actual
            # resized Source pair data so cap controls reach role admission.
            base=path[:-8] if type(path) is str and path.endswith('.staging') else path
            if set(('path','bytes','sha256','path9','descriptor9','raw9')).issubset(result) and base in dict(body_edits):
                raw=dict(body_edits)[base];result['bytes']=len(raw);result['sha256']=hashlib.sha256(raw).hexdigest()
                for key in ('path9','descriptor9','raw9'):result[key][2]=len(raw)
                result['shared_descriptor7']=[result['descriptor9'][i] for i in C['literals']['SHARED7']]
            return result
        if type(value) is list:return [resolve(v) for v in value]
        return value
    def build(path):
        if path in memo:return memo[path]
        assert path not in active,'fixture DAG cycle'
        active.add(path);raw=values[path] if type(values[path]) is bytes else _wire(resolve(values[path]));active.remove(path)
        memo[path]=dict(pin=_pin(path,raw),body=raw);return memo[path]
    for path in values:build(path)
    for path in changed:assert memo[path]['body']!=store[path]['body'],'fixture target changed after reconstruction'
    bundle['dependency']=resolve(bundle['dependency']);bundle['expected']=resolve(bundle['expected'])
    bundle['records']=[memo.get(path,row) for path,row in store.items()]
    return bundle


