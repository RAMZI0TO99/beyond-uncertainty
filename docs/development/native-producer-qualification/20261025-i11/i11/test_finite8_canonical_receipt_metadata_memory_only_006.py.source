    catalogue = dict(schema_version=1, record_type='Root_Source024_actual45_predecessor_Source_pin_inventory', author='/root', created_utc=_time(5),
                     Source024=l['catalogue_Source024_provenance_pin'], current_selection=l['current_selection_pin'], exact_original_guard_constants=l['original_guards'],
                     operational_authority=False, target_execution=False, whole_cohort_or_runtime_acceptance=False,
                     roles=[dict(role=r['role'], source=r['predecessor'], source_cap=r['source_cap']) for r in rows])
    catalogue_pin=b.put(ROOT+'\\catalogue.json',catalogue); b.marks['catalogue']=catalogue_pin['path']
    cr,ca=b.proof('catalogue',[catalogue_pin],scope,sp,6)
    catalogue_support=dict(subject=catalogue_pin,different_review=cr,Root_adoption=ca)
    producer_source=b.raw(HOME+'\\producer.py',b'# synthetic held producer bytes; never executed\n')
    producer_api=b.put(HOME+'\\producer_api.json',dict(schema_version=2,record_type='Root_owner_v2_M3_deferred_metadata_inert_API',author=producer_editor,
                       actual_binding_Source_editor=producer_editor,Source=producer_source,external_canonical_receipt_ABI_qualified=False,
                       historical_binding_Source_editor='/root/pipeline_source_editor',historical_metadata_Source_editor='/root/m3_source_editor',retained_payload_semantic_Source_author='/root/selector_prep'))
    pr,pa=b.proof('producer',[producer_source,producer_api],scope,sp,1)
    producer=dict(Source=producer_source,API=producer_api,editor=producer_editor,different_review=pr,Root_adoption=pa)
    publisher_source=b.raw(ROOT+'\\publisher.py',b'# synthetic held publisher bytes; never executed\n')
    publisher_api=b.put(ROOT+'\\publisher_api.json',dict(schema_version=1,record_type='current_owner_finite8_M3_held_publisher_and_owned_IO_inert_API',author=publisher_editor,
