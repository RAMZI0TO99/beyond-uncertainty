                       stage=stage,role=fact_role,current_owner_scope=scope,tool_support=tool,lease_support=lease_support,
                       selection_support=dict(selection=sp,different_review=sr,Root_adoption=sa),predecessor_inventory=l['M3_inventory17_pin'],dependencies=deps,
                       operational_choices={},binding_supports={},role_selections={},source_only=True,target_execution=False,operational_authority=False,canonical_publication=False,native_Parser_authority=False)
            fp=b.put(HOME+'\\facts-'+stage_key+'.json',facts)
            inputs=[fp,sp,lease,manifest,*owner.values(),*tool.values(),*lease_support.values(),sr,sa,l['M3_inventory17_pin']]
            for dep in deps:
                inputs.extend(v for k,v in dep.items() if k!='role')
            inputs={p['path']:p for p in inputs}
            out_roles=l['templates5'] if template else [role]
            outputs=[]
            for output_role in out_roles:
                draft=selected_rows[output_role]['draft_path']
                outputs += [draft,HOME+'\\source_diffs\\'+draft.rsplit('\\',1)[-1]+'.diff',HOME+'\\stage_receipts\\ROOT_CURRENT_OWNER_'+output_role.upper()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json']
            purpose=dict(schema_version=2,stage=stage,role=fact_role,facts=fp,inputs=[inputs[k] for k in sorted(inputs)],output_paths=sorted(outputs))
            fr,fa=b.proof('stage-'+stage_key,[fp,*purpose['inputs']],scope,sp,11,purpose)
            stage_cache[stage_key]=(fp,purpose,fr,fa)
        fp,purpose,fr,fa=stage_cache[stage_key]
        stage_supports[role]=dict(facts=fp,different_review=fr,Root_adoption=fa)
        raw=('# synthetic proposed '+role+'\n').encode()
        draft=b.raw(row['draft_path'],raw);drafts[role]=draft
        canonical=b.raw(row['canonical_path'],raw)
        diff=b.raw(HOME+'\\source_diffs\\'+row['draft_path'].rsplit('\\',1)[-1]+'.diff',b'--- synthetic\n+++ synthetic\n')
        receipt=dict(schema_version=2,record_type='Root_owner_v2_actual_deferred_M3_Source_draft_author_receipt',author='/root',actual_physical_Source_editor='/root',
                     created_utc=_time(15),role=role,current_owner_scope=scope,Root_future_path_selection=sp,actual_Source_packet=fp,
                     canonical_publication=False,complete_current_predecessor_byte_inverse=True,different_actual_generated_Source_review_pending=True,
                     draft=draft,predecessor=row['predecessor'],diff=diff,finite_actual_Source_observations=[],new_canonical_lease=lease,operational_authority=False,
                     original_fixtures_and_runtime_admission=False,retained_semantic_Source_author=row['retained_semantic_Source_author'],target_execution=False,
                     steps=dict(complete_inverse={},actual_diff_removed_byte_basis={},actual_check_codec={},metadata_Source_provenance=dict(Source=producer_source,API=producer_api,
                     actual_implementation_Source_editor=producer_editor,historical_implementation_Source_editor='/root/pipeline_source_editor',stage_purpose=purpose,
                     resource_observation=dict(observed_utc=_time(14),available_RAM_bytes=1073741824,free_disk_bytes=10737418240))))
        rp=b.put(HOME+'\\stage_receipts\\ROOT_CURRENT_OWNER_'+role.upper()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json',receipt);receipts[role]=rp
        rr,ra=b.proof('draft-'+role,[draft,rp,diff],scope,sp,16)
        wanted.append(dict(role=role,draft=draft,canonical_path=canonical['path'],author_receipt=rp,source_review=rr,Root_adoption=ra,
                           physical_Source_editor='/root',metadata_Source_worker=producer_editor,retained_semantic_Source_author=row['retained_semantic_Source_author'],source_cap=65536))
        actual.append(dict(role=role,predecessor=row['predecessor'],draft=draft,canonical=canonical,author_receipt=rp,exact_Source_review=rr,Root_Source_review_adoption=ra,
                           physical_Source_editor='/root',metadata_Source_worker=producer_editor,retained_semantic_Source_author=row['retained_semantic_Source_author'],canonical_physical_actor='/root',source_cap=65536,
                           actual_publication_metadata_APIs=dict(staging=_observation(canonical,True),canonical=_observation(canonical))))
    request=dict(schema_version=2,record_type='Root_owner_v2_finite8_M3_Source_canonical_publication_request',author='/root',Root_thread=THREAD,created_utc=_time(20),request_id='synthetic-memory-only',
                 Root_future_path_selection_support=selection_support,current_owner_support=owner,new_lease_support=lease_support,predecessor_inventory_support=catalogue_support,
                 producer_supports=dict(M3=tool),publication_receipt_path=ROOT+'\\publication.json',publisher_API=publisher_api,publisher_Root_adoption=qa,publisher_Source_review=qr,publisher_source=publisher_source,
                 rows=wanted,canonical_publication_selected=True,source_only=True,target_execution=False,operational_authority=False)
    request_pin=b.put(ROOT+'\\request.json',request);b.marks['request']=request_pin['path']
    publication={k:False for k in C['schemas']['batch_publication43_v2']['keys']}
    publication.update(schema_version=2,record_type='Root_owner_v2_finite8_M3_Source_canonical_publication',author='/root',Root_thread=THREAD,created_utc=_time(22),request_id=request['request_id'],
                       verdict=l['publication_verdict'],actual_Root_request=request_pin,current_owner_scope=scope,current_owner_support=owner,Root_future_path_selection=sp,Root_future_path_selection_acceptance=selection_support,
                       actual_new_lease=lease,actual_new_lease_support=lease_support,predecessor_inventory_support=catalogue_support,producer_supports=dict(M3=tool),publisher_source=publisher_source,publisher_API=publisher_api,
                       publisher_different_Source_review=qr,publisher_Root_Source_adoption=qa,publication_helper_physical_Source_editor=publisher_editor,inherited_Source022_publisher=l['historical_publisher_provenance'],
                       inherited_reader_Source_editor='/root/runtime_audit',inherited_no_overwrite_writer_Source_editor='/root/m3_source_editor',canonical_physical_actor='/root',published=actual,published_count=len(actual),
                       composer_carried=selected_rows['composer']['predecessor'],topology=dict(selected45=45,successor44=44,composer_carry1=1,model_replace41=41,model_carry26=26,table_replace20=20,table_carry26=26),
                       complete_input_postreads=[],canonical_publication=True,publication_reserve_seconds=60,original_numerical_guards=l['original_guards'],immutable_historical_leases=l['historical_leases_immutable'],
