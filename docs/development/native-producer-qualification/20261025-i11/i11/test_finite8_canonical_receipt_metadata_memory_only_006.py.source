sed_recorded_observation12_missing_observed_utc', 'closed_recorded_observation12_missing_path', 'closed_recorded_observation12_missing_path9', 'closed_recorded_observation12_missing_raw9', 'closed_recorded_observation12_missing_sha256', 'closed_recorded_observation12_missing_shared_descriptor7', 'closed_recorded_observation12_missing_shared_identity_indexes', 'closed_recorded_observation12_missing_two_read_match', 'closed_recorded_observation12_unknown']}, 'recorded_publication_pair2': {'public_cases': ['closed_recorded_publication_pair2_missing_canonical', 'closed_recorded_publication_pair2_missing_staging', 'closed_recorded_publication_pair2_unknown']}, 'publisher_actual45_catalogue11': {'public_cases': ['closed_publisher_actual45_catalogue11_missing_Source024', 'closed_publisher_actual45_catalogue11_missing_author', 'closed_publisher_actual45_catalogue11_missing_created_utc', 'closed_publisher_actual45_catalogue11_missing_current_selection', 'closed_publisher_actual45_catalogue11_missing_exact_original_guard_constants', 'closed_publisher_actual45_catalogue11_missing_operational_authority', 'closed_publisher_actual45_catalogue11_missing_record_type', 'closed_publisher_actual45_catalogue11_missing_roles', 'closed_publisher_actual45_catalogue11_missing_schema_version', 'closed_publisher_actual45_catalogue11_missing_target_execution', 'closed_publisher_actual45_catalogue11_missing_whole_cohort_or_runtime_acceptance', 'closed_publisher_actual45_catalogue11_unknown']}, 'publisher_catalogue_row3': {'public_cases': ['closed_publisher_catalogue_row3_missing_role', 'closed_publisher_catalogue_row3_missing_source', 'closed_publisher_catalogue_row3_missing_source_cap', 'closed_publisher_catalogue_row3_unknown']}, 'batch_request21_v2': {'public_cases': ['missing_request_Root_future_path_selection_support', 'missing_request_Root_thread', 'missing_request_current_owner_support', 'missing_request_author', 'missing_request_canonical_publication_selected', 'missing_request_created