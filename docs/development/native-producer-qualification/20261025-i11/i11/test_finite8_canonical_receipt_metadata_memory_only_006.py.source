    publication_pin=b.put(ROOT+'\\publication.json',publication);b.marks['publication']=publication_pin['path']
    witness=b.put(ROOT+'\\witness.json',dict(opaque_synthetic_data=True))
    chosen=next(r for r in actual if r['role']==selected)
    delta_subjects=[chosen['canonical'],chosen['draft'],chosen['author_receipt'],request_pin,publication_pin,witness]
    dr,da=b.proof('delta',delta_subjects,scope,sp,23)
    recon={k:False for k in C['schemas']['reconciliation26_v2']['keys']}
    recon.update(schema_version=2,record_type='Root_owner_v2_verified_prior_finite8_M3_Source_publication_reconciliation',author='/root',created_utc=_time(26),verdict=l['reconciliation_verdict'],
                 canonical_Source=chosen['canonical'],exact_draft_Source=chosen['draft'],initial_actual_Root_request=request_pin,initial_actual_canonical_publication_receipt=publication_pin,
                 initial_actual_execution_witness=witness,current_owner_scope=scope,Root_future_path_selection=sp,new_canonical_lease=lease,prior_actual_publisher_Source=publisher_source,
                 actual_canonical_delta_Source_review=dr,canonical_delta_Root_adoption=da,prior_publication_created_utc=_time(22),canonical_Source_birth_utc=_time(21),
                 actual_input_observations=[],canonical_publication=True,canonical_publication_flag_scope=l['reconciliation_flag_scope'])
    recon_pin=b.put(ROOT+'\\reconciliation.json',recon);b.marks['reconciliation']=recon_pin['path']
    xr,xa=b.proof('recon',[recon_pin,chosen['canonical'],publication_pin],scope,sp,27)
    dependency=dict(role=selected,canonical=chosen['canonical'],author_receipt=chosen['author_receipt'],different_review=dr,Root_adoption=da,original_publication=publication_pin,
                    late_reconciliation=recon_pin,reconciliation_review=xr,reconciliation_Root_adoption=xa)
    expected=dict(root_thread=THREAD,owner_support=owner,owner_support_manifest=manifest,selection=sp,lease_support=lease_support,producer_support=producer,publisher_support=publisher,
                  actual_content_authors=[],stage_supports=stage_supports,request=request_pin,original_publication=publication_pin,execution_witness=witness,
                  selected_canonical=chosen['canonical'],selected_draft=chosen['draft'],selected_predecessor=chosen['predecessor'],publisher_catalogue=catalogue_pin,
                  historical_selection_inventory=l['historical_selection45_pin'],M3_inventory=l['M3_inventory17_pin'])
    for role,rp in receipts.items():b.marks['receipt:'+role]=rp['path']
    for role,ss in stage_supports.items():b.marks['facts:'+role]=ss['facts']['path']
    return dict(dependency=dependency,expected=expected,records=[dict(pin=p,body=body) for p,body in b.store.values()],expected_root_thread=THREAD,source_editor=EDITOR,now_utc=NOW,
                _json_paths=sorted(b.json_paths),_marks=b.marks)


def mutate(bundle, edits=(), body_edits=()):
    """Fresh finite DAG mutation: assert intended difference, rehash parents.
    Source001 helper is preserved in its complete predecessor bytes.
    """
    bundle=copy.deepcopy(bundle)
    store={r['pin']['path']:r for r in bundle['records']}
    values={p:json.loads(store[p]['body']) for p in bundle['_json_paths']}
    changed=set()
    for mark,path,value,delete in edits:
        target=bundle['_marks'].get(mark,mark)
        before=_wire(values[target])
        if path is None:
            values[target]=value
        else:
            node=values[target]
            for key in path[:-1]:node=node[key]
            if delete:
                assert path[-1] in node,'fixture delete must exist'
                del node[path[-1]]
            else:
                assert _wire(node.get(path[-1]) if type(node) is dict else node[path[-1]])!=_wire(value),'fixture mutation must differ'
                node[path[-1]]=value
        assert _wire(values[target])!=before,'fixture record mutation must change bytes'
        changed.add(target)
    for path,raw in body_edits:
        assert type(raw) is bytes and raw!=store[path]['body'],'fixture raw mutation must differ'
        values[path]=raw;changed.add(path)
    assert changed,'fixture mutation needs actual edit'
    memo={};active=set()
    def resolve(value):
        if type(value) is dict:
            path=value.get('path')
            if set(value)=={'path','bytes','sha256'} and path in values:return build(path)['pin']
            result={k:resolve(v) for k,v in value.items()}
            # Recorded observations retain their extra fields; update only actual
            # resized Source pair data so cap controls reach role admission.
            base=path[:-8] if type(path) is str and path.endswith('.staging') else path
            if set(('path','bytes','sha256','path9','descriptor9','raw9')).issubset(result) and base in dict(body_edits):
                raw=dict(body_edits)[base];result['bytes']=len(raw);result['sha256']=hashlib.sha256(raw).hexdigest()
                for key in ('path9','descriptor9','raw9'):result[key][2]=len(raw)
                result['shared_descriptor7']=[result['descriptor9'][i] for i in C['literals']['SHARED7']]
            return result
        if type(value) is list:return [resolve(v) for v in value]
        return value
    def build(path):
        if path in memo:return memo[path]
        assert path not in active,'fixture DAG cycle'
        active.add(path);raw=values[path] if type(values[path]) is bytes else _wire(resolve(values[path]));active.remove(path)
        memo[path]=dict(pin=_pin(path,raw),body=raw);return memo[path]
    for path in values:build(path)
    for path in changed:assert memo[path]['body']!=store[path]['body'],'fixture target changed after reconstruction'
    bundle['dependency']=resolve(bundle['dependency']);bundle['expected']=resolve(bundle['expected'])
    bundle['records']=[memo.get(path,row) for path,row in store.items()]
    return bundle


def change(bundle, mark, path, value=None, delete=False, raw_body=None):
    if raw_body is not None:
        target=bundle['_marks'][mark]
        return mutate(bundle,body_edits=[(target,raw_body)])
    return mutate(bundle,edits=[(mark,path,value,delete)])

def invoke(component,bundle):
    return component.validate_finite8_canonical_receipt_metadata(**{k:v for k,v in bundle.items() if not k.startswith('_')})


def run_cases(component, emit):
    results=[]
    def check(name, work, error=None):
        try:
            value=work()
        except component.I11Error as exc:
            assert error is not None and exc.code in (error if type(error) is tuple else (error,)),(name,'wrong refusal',exc.code,error)
        else:
            assert error is None,(name,'expected refusal',error)
            if value is not None:
                data=value.to_dict()
                assert data['metadata_only'] is True and data['finite8_receipt_ABI_metadata_validated'] is True
                assert all(data[k] is False for k in component.FALSE_RESULT)
        results.append(dict(name=name,passed=True));emit(name)
    for spec in CASE_CATALOGUE:
        name,kind,args,error=spec
        if kind=='positive':
            names=[ROLES[i] for i in args]
            check(name,lambda names=names:invoke(component,make_bundle(names)),error)
        elif kind=='selector':
            check(name,lambda i=args[0]:invoke(component,make_bundle([ROLES[i]],ROLES[i])),error)
        elif kind=='record':
            mark,path,value=args
            check(name,lambda mark=mark,path=path,value=value:invoke(component,change(make_bundle(),mark,path,value)),error)
        elif kind=='delete':
            mark,path=args
            check(name,lambda mark=mark,path=path:invoke(component,change(make_bundle(),mark,path,delete=True)),error)
        elif kind=='schema_variant':
            location,mark,path,key,operation=args
            def schema_case(location=location,mark=mark,path=path,key=key,operation=operation):
                bundle=make_bundle()
                if location=='record':
                    if operation=='delete':return invoke(component,change(bundle,mark,path+[key],delete=True))
                    return invoke(component,change(bundle,mark,path+['I11_unknown_key'],False))
                root=bundle['records'][0] if location=='store' else (bundle if location=='argument' else bundle[location])
                node=root
                for part in path:node=node[part]
                before=repr(node)
                if operation=='delete':del node[key]
                else:node['I11_unknown_key']=False
                assert repr(node)!=before,'fixture input mutation differs'
                return invoke(component,bundle)
            check(name,schema_case,error)
        elif kind=='multi_record':
            indexes,edits,*declared=args
            def multi_case():
                bundle=make_bundle([ROLES[i] for i in indexes])
                if declared:bundle['expected']['actual_content_authors']=declared[0]
                return invoke(component,mutate(bundle,edits=edits))
            check(name,multi_case,error)
        elif kind=='whole_record':
            mark,value=args
            check(name,lambda mark=mark,value=value:invoke(component,mutate(make_bundle(),edits=[(mark,None,value,False)])),error)
        elif kind=='extended_coverage':
            mark=args[0]
            def coverage_case(mark=mark):
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']}
                target=bundle['expected']['producer_support']['Source']
                path=bundle['_marks'][mark];record=json.loads(store[path]['body'])
                count=[0]
                def extend(v):
                    if type(v) is dict:
                        if set(v)=={'path','bytes','sha256'} and v==target:
                            count[0]+=1;return dict(v,extended_observation_only=True)
                        return {k:extend(x) for k,x in v.items()}
                    if type(v) is list:return [extend(x) for x in v]
                    return v
                changed=extend(record);assert count[0]>0 and changed!=record
                return invoke(component,mutate(bundle,edits=[(mark,None,changed,False)]))
            check(name,coverage_case,error)
        elif kind=='subclass':
            def subclass_case(which=args[0]):
                bundle=make_bundle()
                if which=='dict':bundle['dependency']=type('OwnedDict',(dict,),{})(bundle['dependency'])
                elif which=='list':bundle['expected']['actual_content_authors']=type('OwnedList',(list,),{})([])
                elif which=='str':bundle['expected']['root_thread']=type('OwnedStr',(str,),{})(THREAD)
                elif which=='int':bundle['expected']['selected_canonical']['bytes']=type('OwnedInt',(int,),{})(bundle['expected']['selected_canonical']['bytes'])
                elif which=='bytes':bundle['records'][0]['body']=type('OwnedBytes',(bytes,),{})(bundle['records'][0]['body'])
                else:raise AssertionError('unknown subclass variant')
                return invoke(component,bundle)
            check(name,subclass_case,error)
        elif kind=='phase_size':
            def size_case(size=args[0]):
                bundle=make_bundle();body=b'x'*size
                return invoke(component,mutate(bundle,body_edits=[(bundle['expected']['selected_canonical']['path'],body),(bundle['expected']['selected_draft']['path'],body)]))
            check(name,size_case,error)
        elif kind=='check_count':
            count=args[0]
            check(name,lambda count=count:invoke(component,change(make_bundle(),'producer_full',['checks'],[dict(name='check_'+str(i),passed=True) for i in range(count)])),error)
        elif kind=='nested_cap':
            def nested_cap_case():
                bundle=make_bundle([ROLES[4]])
                return invoke(component,change(bundle,'facts:'+ROLES[4],['dependencies',0,'canonical','bytes'],65537))
            check(name,nested_cap_case,error)
        elif kind=='rename_phase':
            def rename_case(index=args[0],variant=args[1]):
                bundle=make_bundle([ROLES[index]])
                store={r['pin']['path']:r for r in bundle['records']}
                rows=json.loads(store[bundle['_marks']['selection']]['body'])['rows']
                pos=next(i for i,r in enumerate(rows) if r['role']==ROLES[index]);row=rows[pos]
                leaf=row['canonical_path'].rsplit('\\',1)[-1]
                if variant=='prefix':leaf='unrelated-'+leaf
                elif variant=='case':leaf=leaf.replace('.TEMPLATE.ps1','.template.ps1').replace('.BOUND.ps1','.bound.ps1')
                elif variant=='suffix':leaf=leaf.replace('.TEMPLATE.ps1','.BOUND.ps1') if index<4 else leaf.replace('.BOUND.ps1','.TEMPLATE.ps1')
                else:raise AssertionError('unknown basename variant')
                return invoke(component,mutate(bundle,edits=[('selection',['rows',pos,'canonical_path'],row['canonical_path'].rsplit('\\',1)[0]+'\\'+leaf,False),
                     ('selection',['rows',pos,'draft_path'],row['draft_path'].rsplit('\\',1)[0]+'\\'+leaf,False)]))
            check(name,rename_case,error)
        elif kind=='join_refs':
            def join_case():
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']};edits=[]
                for mark,path,ref in args:
                    value=bundle
                    for part in ref:value=value[part]
                    edits.append((mark,path,copy.deepcopy(value),False))
                return invoke(component,mutate(bundle,edits=edits))
            check(name,join_case,error)
        elif kind=='expected_ref':
            path,ref=args
            def expected_ref_case():
                bundle=make_bundle();value=bundle
                for part in ref:value=value[part]
                node=bundle['expected']
                for part in path[:-1]:node=node[part]
                assert node[path[-1]]!=value;node[path[-1]]=copy.deepcopy(value)
                return invoke(component,bundle)
            check(name,expected_ref_case,error)
        elif kind=='stage_input':
            def stage_input_case(action=args[0]):
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']}
                role=ROLES[0];mark='receipt:'+role;receipt=json.loads(store[bundle['_marks'][mark]]['body'])
                purpose=copy.deepcopy(receipt['steps']['metadata_Source_provenance']['stage_purpose'])
                if action=='self_output':purpose['inputs'].append(bundle['expected']['selected_draft'])
                elif action=='duplicate':purpose['inputs'].append(purpose['inputs'][0])
                elif action=='omit':purpose['inputs']=[p for p in purpose['inputs'] if p!=bundle['expected']['lease_support']['canonical']]
                else:raise AssertionError('unknown owned stage input variant')
                purpose['inputs'].sort(key=lambda p:p['path'])
                subjects=[purpose['facts'],*purpose['inputs']]
                edits=[(mark,['steps','metadata_Source_provenance','stage_purpose'],purpose,False)]
                for suffix in ('full','capsule','adoption'):
                    proof_mark='stage-templates_'+suffix
                    edits.extend([(proof_mark,['exact_M3_Source_stage_purpose'],purpose,False),(proof_mark,['subjects'],subjects,False)])
                return invoke(component,mutate(bundle,edits=edits))
            check(name,stage_input_case,error)

        elif kind=='pin_scalar':
            def pin_scalar_case(field=args[0],value=args[1]):
                bundle=make_bundle();before=copy.deepcopy(bundle['records'][0]['pin'])
                if value=='UPPERCASE':
                    value=before['sha256'].upper();assert value!=before['sha256']
                assert before[field]!=value;bundle['records'][0]['pin'][field]=value
                return invoke(component,bundle)
            check(name,pin_scalar_case,error)
        elif kind=='same_length_hash':
            def same_length_case():
                bundle=make_bundle();row=bundle['records'][0];before=row['body']
                row['body']=before[:-1]+bytes([before[-1]^1])
                assert len(row['body'])==row['pin']['bytes'] and row['body']!=before
                assert hashlib.sha256(row['body']).hexdigest()!=row['pin']['sha256']
                return invoke(component,bundle)
            check(name,same_length_case,error)
        elif kind=='store_case_alias':
            def alias_store_case():
                bundle=make_bundle();row=copy.deepcopy(bundle['records'][0]);before=row['pin']['path']
                row['pin']['path']=before[:3]+before[3:].swapcase()
                assert row['pin']['path']!=before and row['pin']['path'].casefold()==before.casefold()
                row['body']=row['body']+b' conflicting alias';row['pin']=_pin(row['pin']['path'],row['body'])
                bundle['records'].append(row)
                return invoke(component,bundle)
            check(name,alias_store_case,error)
        elif kind in ('selection_control','catalogue_control'):
            def rows_control_case(which=kind,action=args[0]):
                bundle=make_bundle();mark='selection' if which=='selection_control' else 'catalogue'
                store={r['pin']['path']:r for r in bundle['records']}
                record=json.loads(store[bundle['_marks'][mark]]['body']);key='rows' if mark=='selection' else 'roles'
                rows=copy.deepcopy(record[key])
                if action=='count44':return invoke(component,change(bundle,mark,[key],rows[:-1]))
                if action=='duplicate_role':rows[-1]=copy.deepcopy(rows[0]);return invoke(component,change(bundle,mark,[key],rows))
                if action=='must_change_false':
                    i=next(i for i,r in enumerate(rows) if r['role']==ROLES[0]);return invoke(component,change(bundle,mark,[key,i,'must_change_Source_bytes'],False))
                if action=='Source024':return invoke(component,change(bundle,mark,['Source024'],bundle['expected']['selected_draft']))
                if action=='predecessor':return invoke(component,change(bundle,mark,[key,0,'source'],bundle['expected']['selected_draft']))
                if action=='cap':return invoke(component,change(bundle,mark,[key,0,'source_cap'],rows[0]['source_cap']-1))
                raise AssertionError('unknown owned rows control')
            check(name,rows_control_case,error)
        elif kind=='phase_bytes':
            def phase_bytes_case(action=args[0]):
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']};e=bundle['expected']
                canonical,draft=e['selected_canonical']['path'],e['selected_draft']['path']
                if action=='differ':
                    body=store[canonical]['body']+b' changed only canonical\n'
                    assert body!=store[draft]['body']
                    return invoke(component,mutate(bundle,body_edits=[(canonical,body)]))
                body=store[e['selected_predecessor']['path']]['body']
                assert body!=store[canonical]['body'] and body!=store[draft]['body']
                return invoke(component,mutate(bundle,body_edits=[(canonical,body),(draft,body)]))
            check(name,phase_bytes_case,error)
        elif kind=='coherent_rename':
            def rename_only_case():
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']}
                pair=json.loads(store[bundle['_marks']['publication']]['body'])['published'][0]['actual_publication_metadata_APIs']
                canonical=copy.deepcopy(pair['canonical']);canonical['path9'][1]+=1;canonical['raw9'][1]+=1;canonical['descriptor9'][1]+=1
                canonical['shared_descriptor7']=[canonical['descriptor9'][i] for i in C['literals']['SHARED7']]
                assert canonical['raw9']==canonical['path9']
                assert all(canonical['path9'][i]==canonical['descriptor9'][i] for i in C['literals']['SHARED7'])
                assert all(canonical['descriptor9'][i]==canonical['shared_descriptor7'][j] for j,i in enumerate(C['literals']['SHARED7']))
                assert [i for i in C['literals']['RENAME8'] if pair['staging']['descriptor9'][i]!=canonical['descriptor9'][i]]==[1]
                return invoke(component,change(bundle,'publication',['published',0,'actual_publication_metadata_APIs','canonical'],canonical))
            check(name,rename_only_case,error)
        elif kind=='resource_age_only':
            def resource_age_only_case():
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']};edits=[]
                def shift(value):
                    if type(value) is str and value.startswith('2026-10-25T08:00:') and int(value[17:19])>=15:
                        return value.replace('T08:00:','T08:01:',1)
                    if type(value) is dict:return {k:shift(v) for k,v in value.items()}
                    if type(value) is list:return [shift(v) for v in value]
                    return value
                for path in bundle['_json_paths']:
                    before=json.loads(store[path]['body']);after=shift(before)
                    if after!=before:edits.append((path,None,after,False))
                receipt=json.loads(store[bundle['_marks']['receipt:'+ROLES[0]]]['body']);shifted=shift(receipt)
                obs=shifted['steps']['metadata_Source_provenance']['resource_observation']['observed_utc']
                assert obs==_time(14) and shifted['created_utc']=='2026-10-25T08:01:15.000000+00:00'
                assert _time(10)<=obs and shifted['created_utc']>obs
                assert shifted['steps']['metadata_Source_provenance']['resource_observation']['available_RAM_bytes']==1073741824
                assert shifted['steps']['metadata_Source_provenance']['resource_observation']['free_disk_bytes']==10737418240
                bundle=mutate(bundle,edits=edits);bundle['now_utc']='2026-10-25T08:01:30.000000+00:00'
                return invoke(component,bundle)
            check(name,resource_age_only_case,error)
        elif kind=='outside8_actor':
            def outside8_actor_case(mark=args[0],alias=args[1]):
                bundle=make_bundle();assert bundle['expected']['actual_content_authors']==[]
                store={r['pin']['path']:r for r in bundle['records']};selection=json.loads(store[bundle['_marks']['selection']]['body'])
                pos=next(i for i,r in enumerate(selection['rows']) if r['role']=='child')
                actor='/root/outside8_fresh_actor';before=selection['rows'][pos]['preparation_Source_author']
                assert actor!=before and 'child' not in ROLES
                who=actor if alias=='exact' else actor+'/descendant' if alias=='descendant' else '/root/'+actor[6:].upper()
                assert who.casefold()==actor.casefold() or who.casefold().startswith(actor.casefold()+'/')
                return invoke(component,mutate(bundle,edits=[('selection',['rows',pos,'preparation_Source_author'],actor,False),(mark,['reviewer'],who,False)]))
            check(name,outside8_actor_case,error)


        elif kind=='custom_mapping':
            def custom_mapping_case():
                bundle=make_bundle();touched=[]
                class NeverReadMapping:
                    def keys(self):touched.append('keys');raise AssertionError('validator invoked custom mapping')
                    def __iter__(self):touched.append('iter');raise AssertionError('validator iterated custom mapping')
                    def __getitem__(self,key):touched.append('getitem');raise AssertionError('validator indexed custom mapping')
                bundle['dependency']=NeverReadMapping()
                try:return invoke(component,bundle)
                finally:assert touched==[],'custom mapping methods must remain uncalled'
            check(name,custom_mapping_case,error)
        elif kind=='store_string':
            def string_body_case():
                bundle=make_bundle();before=bundle['records'][0]['body'];bundle['records'][0]['body']=repr(before)
                assert type(before) is bytes and type(bundle['records'][0]['body']) is str
                return invoke(component,bundle)
            check(name,string_body_case,error)
        elif kind in ('selected_row','selected_predecessor'):
            def selected_row_case(which=kind):
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']}
                selection=json.loads(store[bundle['_marks']['selection']]['body'])
                pos=next(i for i,r in enumerate(selection['rows']) if r['role']==ROLES[0])
                field,value=args if which=='selected_row' else ('predecessor',bundle['expected']['producer_support']['Source'])
                return invoke(component,change(bundle,'selection',['rows',pos,field],value))
            check(name,selected_row_case,error)
        elif kind=='facts_clone':
            def facts_clone_case():
                bundle=make_bundle();role=ROLES[0];store={r['pin']['path']:r for r in bundle['records']}
                original=bundle['expected']['stage_supports'][role]['facts'];body=store[original['path']]['body']
                path=HOME+r'\facts-fresh-clone.json';clone=_pin(path,body)
                assert path not in store and clone!=original
                bundle['records'].append(dict(pin=clone,body=body));bundle['_json_paths'].append(path)
                return invoke(component,change(bundle,'receipt:'+role,['actual_Source_packet'],clone))
            check(name,facts_clone_case,error)
        elif kind=='adoption_pointer':
            def pointer_adoption_case():
                bundle=make_bundle();support=bundle['expected']['producer_support']
                pointers=[support['different_review'],support['Root_adoption']]
                # Self pointer would create a synthetic cycle; use full proof
                # and capsule only, each retaining Source/API body data elsewhere.
                store={r['pin']['path']:r for r in bundle['records']}
                capsule=json.loads(store[bundle['_marks']['producer_capsule']]['body'])
                pointers=[support['different_review'],capsule['full_proof']]
                assert all(p not in (support['Source'],support['API']) for p in pointers)
                return invoke(component,change(bundle,'producer_adoption',['subjects'],pointers))
            check(name,pointer_adoption_case,error)
        elif kind=='coherent_size':
            def coherent_size_case():
                bundle=make_bundle();store={r['pin']['path']:r for r in bundle['records']}
                pair=json.loads(store[bundle['_marks']['publication']]['body'])['published'][0]['actual_publication_metadata_APIs']
                canonical=copy.deepcopy(pair['canonical'])
                for key in ('path9','raw9','descriptor9'):canonical[key][2]+=1
                canonical['shared_descriptor7']=[canonical['descriptor9'][i] for i in C['literals']['SHARED7']]
                assert canonical['raw9']==canonical['path9']
                assert all(canonical['path9'][i]==canonical['descriptor9'][i] for i in C['literals']['SHARED7'])
                assert canonical['path9'][2]!=canonical['bytes']
                return invoke(component,change(bundle,'publication',['published',0,'actual_publication_metadata_APIs','canonical'],canonical))
            check(name,coherent_size_case,error)

        elif kind=='arg':
            field,value=args
            def arg_case(field=field,value=value):
                bundle=make_bundle();bundle[field]=value;return invoke(component,bundle)
            check(name,arg_case,error)
        elif kind=='dependency':
            field,value=args
            def dep_case(field=field,value=value):
                bundle=make_bundle();bundle['dependency'][field]=value;return invoke(component,bundle)
            check(name,dep_case,error)
        elif kind=='expected':
            path,value=args
            def expected_case(path=path,value=value):
                bundle=make_bundle();node=bundle['expected']
                for key in path[:-1]:node=node[key]
                node[path[-1]]=value
                return invoke(component,bundle)
            check(name,expected_case,error)
        elif kind=='expected_large':
            def large_case():
                bundle=make_bundle();bundle['expected']['actual_content_authors']=['/root/a']*50001
                return invoke(component,bundle)
            check(name,large_case,error)
        elif kind=='expected_depth':
            def depth_case():
                deep=None
                for _ in range(50):deep=[deep]
                bundle=make_bundle();bundle['expected']['actual_content_authors']=deep
                return invoke(component,bundle)
            check(name,depth_case,error)
        elif kind=='raw_json':
            raw=b'\xff' if args[0]=='INVALID_UTF8' else args[0].encode('utf8')
            check(name,lambda raw=raw:invoke(component,change(make_bundle(),'request',[],raw_body=raw)),error)
        elif kind=='authority':
            def authority_case(toggle=args[0]):
                before=component.ACTUAL_ENTRY_QUALIFIED
                try:
                    component.ACTUAL_ENTRY_QUALIFIED=toggle
                    return component.require_actual_finite8_canonical_dependency_admission(object())
                finally:component.ACTUAL_ENTRY_QUALIFIED=before
            check(name,authority_case,error)
        elif kind=='immutable':
            def immutable_case():
                bundle=make_bundle();view=invoke(component,bundle);original=view.to_dict()
                bundle['expected']['actual_content_authors'].append('/root/mutated');other=view.to_dict();other['role']='bad'
                assert view.to_dict()==original and view.actual_admission is False and view.metadata_only is True
                return view
            check(name,immutable_case,error)
        elif kind=='store':
            def store_case(action=args[0]):
                bundle=make_bundle()
                if action=='duplicate':bundle['records'].append(copy.deepcopy(bundle['records'][0]))
                elif action=='body':bundle['records'][0]['body']+=b'!'
                elif action=='bytearray':bundle['records'][0]['body']=bytearray(bundle['records'][0]['body'])
                elif action=='missing':bundle['records']=[r for r in bundle['records'] if r['pin']['path']!=bundle['expected']['request']['path']]
                elif action=='257':bundle['records']=[bundle['records'][0]]*257
                elif action=='256':
                    while len(bundle['records'])<256:
                        path=ROOT+'\\unused\\body-'+str(len(bundle['records']))+'.data';body=b'\xff raw data'
                        bundle['records'].append(dict(pin=_pin(path,body),body=body))
                elif action=='2MiB':
                    body=b'x'*2097152;path=ROOT+'\\unused\\cap.data';bundle['records'].append(dict(pin=_pin(path,body),body=body))
                elif action=='2MiB+1':
                    body=b'x'*2097153;path=ROOT+'\\unused\\cap.data';bundle['records'].append(dict(pin=_pin(path,body),body=body))
                elif action=='32MiB+':
                    for i in range(17):
                        body=b'x'*2097152;path=ROOT+'\\unused\\total-'+str(i)+'.data';bundle['records'].append(dict(pin=_pin(path,body),body=body))
                return invoke(component,bundle)
            check(name,store_case,error)
        else:raise AssertionError('unknown owned case kind '+kind)
    assert len(results)==len(CASE_CATALOGUE) and len({r['name'] for r in results})==len(results)
    return dict(schema_version=1,record_type='I11_owned_synthetic_memory_case_results',cases=results,passed=len(results),failed=0,
                metadata_only=True,actual_family_publication=False,target_execution=False,operational_authority=False,scientific_authority=False)


