    manifest = b.put(ROOT + '\\owner_manifest.json', owner)
    lease = b.put(ROOT + '\\lease.json', dict(author='/root', created_utc=_time(0), target_execution=False, operational_authority=False))
    lease_support = {key: lease for key in C['schemas']['lease_support5']['keys']}
    rows = []
    producer_editor, publisher_editor = '/root/synthetic_producer', '/root/synthetic_publisher'
    for prior in old['rows']:
        row = copy.deepcopy(prior); role = row['role']
        if role != 'composer':
            row['predecessor'] = basis[role] if role in basis else prior['predecessor']
            row['selected_ordinal'] = prior['selected_ordinal'] + 1
            leaf = prior['canonical_path'].rsplit('\\', 1)[-1]
            hits = [m for m in re.finditer(r'[0-9]{3}(?![0-9])', leaf) if int(m[0]) == prior['selected_ordinal']]
            if len(hits) == 1:
                m = hits[0]; leaf = leaf[:m.start()] + str(row['selected_ordinal']).zfill(3) + leaf[m.end():]
            else:
                leaf = 'synthetic-' + role + '-' + str(row['selected_ordinal']).zfill(3) + '.data'
            row['canonical_path'] = prior['canonical_path'].rsplit('\\', 1)[0] + '\\' + leaf
            row['draft_path'] = ROOT + '\\generation\\fixture-only\\drafts\\' + leaf
            row['preparation_Source_author'] = producer_editor
            row['must_change_Source_bytes'] = True
        rows.append(row)
    selected_rows = {r['role']: r for r in rows}
    selection = dict(schema_version=2, record_type='Root_owner_v2_actual_separate_future45_Source_path_selection', author='/root', created_utc=_time(5),
                     current_owner_scope=scope, current_complete45_inventory=l['historical_selection45_pin'], current_selection=l['current_selection_pin'],
                     derived_launcher_runtime_path=ROOT+'\\unborn-runtime.py', new_canonical_lease=lease, operational_authority=False,
                     rows=rows, selected_Source_nonce='0'*32, target_execution=False)
