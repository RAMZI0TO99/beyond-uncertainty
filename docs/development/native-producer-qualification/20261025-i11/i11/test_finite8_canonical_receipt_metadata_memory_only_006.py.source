def _time(n):
    return '2026-10-25T08:00:' + str(n).zfill(2) + '.000000+00:00'


def _wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True) + '\n').encode('utf8')


def _pin(path, body):
    return dict(path=path, bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


def _observation(pin, staging=False):
    p = dict(pin)
    if staging:
        p['path'] += '.staging'
    vector = [1, 77, p['bytes'], 9, 10 if staging else 11, 0o100666, 1, 32, 1]
    return dict(**p, cap=65536, path9=vector, raw9=vector[:], descriptor9=vector[:],
                shared_identity_indexes=C['literals']['SHARED7'], shared_descriptor7=[vector[i] for i in C['literals']['SHARED7']],
                both_full_API9_independently_stable=True, two_read_match=True, observed_utc=_time(22))


class _Build:
    def __init__(self):
        self.store = {}
        self.json_paths = set()
        self.marks = {}
        for row in FIXED:
            body = base64.b64decode(row['base64'])
            self.store[row['pin']['path']] = (row['pin'], body)

    def raw(self, path, body):
        if path in self.store:
            assert self.store[path][1] == body, 'owned fixture duplicate path bytes'
            return self.store[path][0]
        pin = _pin(path, body)
        self.store[path] = pin, body
        return pin

    def put(self, path, value):
        p = self.raw(path, _wire(value))
        self.json_paths.add(path)
        return p

    def proof(self, name, subjects, scope, selection, start, purpose=None):
        full = dict(reviewer='/root/independent_review', verdict='PASS_SYNTHETIC_SOURCE_ONLY', checks_failed=0,
                    created_utc=_time(start), target_execution=False, operational_authority=False,
                    subjects=subjects, checks=[dict(name='whole_synthetic_metadata', passed=True)])
        if purpose is not None:
            full['exact_M3_Source_stage_purpose'] = purpose
        fp = self.put(ROOT + '\\proofs\\' + name + '.full.json', full)
        capsule = {k: v for k, v in full.items() if k != 'checks'}
        capsule.update(full_proof=fp, created_utc=_time(start + 1))
        cp = self.put(ROOT + '\\proofs\\' + name + '.capsule.json', capsule)
        adoption = dict(author='/root', verdict=C['literals']['stage_verdict'] if purpose is not None else 'ACCEPT_SYNTHETIC_SOURCE_METADATA_ONLY',
                        created_utc=_time(start + 2), target_execution=False, operational_authority=False,
                        subjects=subjects, different_review=cp, full_proof=fp, current_owner_scope=scope, selection=selection)
        if purpose is not None:
            adoption['exact_M3_Source_stage_purpose'] = purpose
        ap = self.put(ROOT + '\\proofs\\' + name + '.adoption.json', adoption)
        self.marks[name + '_full'] = fp['path']; self.marks[name + '_capsule'] = cp['path']; self.marks[name + '_adoption'] = ap['path']
        return cp, ap


def make_bundle(names=None, selected=None):
    b = _Build(); l = C['literals']
    names = list(names or ROLES[:1]); selected = selected or names[0]
    old = json.loads(b.store[l['current_selection_pin']['path']][1])
