def add(group,name,kind,args,error,note=None):
    match=next((c for c in cases+new_cases if c[1:]==(kind,args,error)),None)
    actual=match[0] if match else name
    if match is None:new_cases.append((name,kind,args,error))
    if actual not in mapping[group]['case_names']:mapping[group]['case_names'].append(actual)
    covered[name]=dict(case_names=[actual],expected_error=error,first_guard_note=note or next((r['intended_first_guard'] for r in gap['rows'] if r['proposed_case_name']==name),''))
    return actual
