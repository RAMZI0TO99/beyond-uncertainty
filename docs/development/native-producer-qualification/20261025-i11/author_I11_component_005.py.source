                pos=next(i for i,r in enumerate(selection['rows']) if r['role']==ROLES[0])
                field,value=args if which=='selected_row' else ('predecessor',bundle['expected']['producer_support']['Source'])
                return invoke(component,change(bundle,'selection',['rows',pos,field],value))
