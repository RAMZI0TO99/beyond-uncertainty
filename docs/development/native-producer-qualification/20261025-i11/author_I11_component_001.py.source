             Source=sp,API=ap,fixture=fp,inventory=ip,author_tool=f3(__file__),protocol_adoption=f3(HERE/'ROOT_I11_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'),
             author_operations='Own read/hash/JSON/AST/compile metadata authoring only; no emitted program imports/calls/tests.',
