         Source=sp,fixture_Source=fp,protocol=f3(PROTOCOL),protocol_adoption=f3(HERE/'ROOT_I11_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'),
         clarifications=[f3(HERE/'ROOT_I11_PROTOCOL001_EXACT_API_AND_RECORDED_CHRONOLOGY_CLARIFICATION_001.json'),f3(HERE/'ROOT_I11_PROTOCOL001_ACTOR_CLOSURE_AND_COMPOSER_CLARIFICATION_001.json')],
