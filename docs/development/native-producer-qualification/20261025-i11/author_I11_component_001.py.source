            purpose=dict(schema_version=2,stage=stage,role=fact_role,facts=fp,inputs=[inputs[k] for k in sorted(inputs)],output_paths=sorted(outputs))
            fr,fa=b.proof('stage-'+stage_key,[fp,*purpose['inputs']],scope,sp,11,purpose)
            stage_cache[stage_key]=(fp,purpose,fr,fa)
        fp,purpose,fr,fa=stage_cache[stage_key]
        stage_supports[role]=dict(facts=fp,different_review=fr,Root_adoption=fa)
        raw=('# synthetic proposed '+role+'\n').encode()
