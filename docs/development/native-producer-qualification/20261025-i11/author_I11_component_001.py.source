            facts=dict(schema_version=2,record_type='Root_owner_v2_exact_M3_Source_stage_purpose_and_facts',author='/root',Root_thread=THREAD,created_utc=_time(10),
                       stage=stage,role=fact_role,current_owner_scope=scope,tool_support=tool,lease_support=lease_support,
