fixed = []
paths = [P['exact_literals'][name] for name in ('current_selection_pin','historical_selection45_pin','M3_inventory17_pin','catalogue_Source024_provenance_pin','historical_publisher_provenance')]
paths += P['exact_literals']['historical_leases_immutable']
old = json.loads(Path(P['exact_literals']['current_selection_pin']['path']).read_bytes())
inventory = json.loads(Path(P['exact_literals']['M3_inventory17_pin']['path']).read_bytes())
basis = {r['role']: r['available_basis'] for r in inventory['roles']}
paths += [basis[r] for r in P['exact_literals']['finite8_role_order']]
paths += [r['predecessor'] for r in old['rows'] if r['role']=='composer']
seen=set()
for p in paths:
    if p['path'] in seen:continue
    raw=Path(p['path']).read_bytes()
    if len(raw)!=p['bytes'] or hashlib.sha256(raw).hexdigest()!=p['sha256']:raise ValueError('fixed data differs '+p['path'])
    fixed.append(dict(pin=p,base64=base64.b64encode(raw).decode('ascii')));seen.add(p['path'])

source = KERNEL.replace('__CONTRACT__', repr(CONTRACT)).lstrip().encode('utf8')
fixture = FIXTURE.replace('__CONTRACT__', repr(CONTRACT)).replace('__FIXED__', repr(fixed)).replace('__CASES__', repr(cases)).lstrip().encode('utf8')
compile(source, '<new I11 Source data compile>', 'exec')
compile(fixture, '<new I11 fixture Source data compile>', 'exec')
fixture_ast = ast.parse(fixture)
literal_catalogue = next(ast.literal_eval(n.value) for n in fixture_ast.body if isinstance(n, ast.Assign) and any(isinstance(t,ast.Name) and t.id=='CASE_CATALOGUE' for t in n.targets))
if literal_catalogue != cases or len({c[0] for c in literal_catalogue}) != len(cases):
    raise ValueError('authored fixture AST catalogue mismatch/duplicate')
