        review = self._review(wanted['source_review'], subjects)
        adoption = self._adopt(wanted['Root_adoption'], subjects, wanted['source_review'], review)
        _need(_time(code_adoption['created_utc']) <= _time(facts['created_utc']) <= born <= _time(review[1]['created_utc']) and
              _time(adoption['created_utc']) <= _time(self.request['created_utc']), 'E_CHRONOLOGY')
        pair = _closed(actual['actual_publication_metadata_APIs'], 'recorded_publication_pair2', 'E_OBSERVATION')
        self._observation(pair['canonical'], canonical, 65536)
        self._observation(pair['staging'], dict(canonical, path=canonical['path'] + '.staging'), 65536)
        for key in ('path9', 'descriptor9'):
            _need(all(pair['staging'][key][i] == pair['canonical'][key][i] for i in L['RENAME8']), 'E_OBSERVATION')

    def validate(self):
        code_adopted = self._code('producer', self.producer_api)
        publisher_adopted = self._code('publisher', self.publisher_api)
        self._header(); self._catalogue()
        _need(_time(publisher_adopted['created_utc']) <= _time(self.request['created_utc']), 'E_CHRONOLOGY')
        for wanted, actual in zip(self.request['rows'], self.publication['published']):
            self._row(wanted, actual, code_adopted)
        role = self.d['role']
        actual = next(r for r in self.publication['published'] if r['role'] == role)
        receipt = self.receipts[role]
        _need(_same(self.d['canonical'], self.e['selected_canonical']) and _same(actual['canonical'], self.e['selected_canonical']) and
              _same(actual['draft'], self.e['selected_draft']) and _same(actual['predecessor'], self.e['selected_predecessor']) and
              _same(self.d['author_receipt'], actual['author_receipt']), 'E_ROW_JOIN')
        recon = self.s.record(self.d['late_reconciliation'], 'reconciliation26_v2')
        _noauth(recon)
        _need(recon['author'] == '/root' and recon['verdict'] == L['reconciliation_verdict'] and recon['canonical_publication'] is True and
              recon['canonical_publication_flag_scope'] == L['reconciliation_flag_scope'] and
              all(recon[k] is False for k in L['RECON_FALSE_KEYS']), 'E_RECONCILIATION')
        for k, pin in (('canonical_Source', self.d['canonical']), ('exact_draft_Source', actual['draft']), ('initial_actual_Root_request', self.e['request']),
                       ('initial_actual_canonical_publication_receipt', self.e['original_publication']), ('initial_actual_execution_witness', self.e['execution_witness']),
                       ('current_owner_scope', self.scope), ('Root_future_path_selection', self.e['selection']), ('new_canonical_lease', self.lease),
                       ('prior_actual_publisher_Source', self.e['publisher_support']['Source']), ('actual_canonical_delta_Source_review', self.d['different_review']),
                       ('canonical_delta_Root_adoption', self.d['Root_adoption'])):
            _need(_same(recon[k], pin), 'E_RECONCILIATION_JOIN')
        _need(recon['prior_publication_created_utc'] == self.publication['created_utc'] and type(recon['actual_input_observations']) is list, 'E_RECONCILIATION_JOIN')
        for observation in recon['actual_input_observations']:
            self._observation(observation, {k: observation[k] for k in ('path', 'bytes', 'sha256')}, observation['cap'])
        subjects = [self.d['canonical'], actual['draft'], actual['author_receipt'], self.e['request'], self.e['original_publication'], self.e['execution_witness']]
        delta_review = self._review(self.d['different_review'], subjects)
        delta_adopted = self._adopt(self.d['Root_adoption'], subjects, self.d['different_review'], delta_review)
        _need(_time(self.request['created_utc']) <= _time(recon['canonical_Source_birth_utc']) <= _time(self.publication['created_utc']) <=
              _time(delta_review[1]['created_utc']) <= _time(delta_adopted['created_utc']) <= _time(recon['created_utc']), 'E_CHRONOLOGY')
        recon_subjects = [self.d['late_reconciliation'], self.d['canonical'], self.e['original_publication']]
        review = self._review(self.d['reconciliation_review'], recon_subjects)
        self._adopt(self.d['reconciliation_Root_adoption'], recon_subjects, self.d['reconciliation_review'], review)
        _need(_time(recon['created_utc']) <= _time(review[1]['created_utc']), 'E_CHRONOLOGY')
        out = dict(schema_version=1, record_type='finite8_canonical_receipt_ABI_metadata_view', role=role, dependency=self.d,
                   request=self.e['request'], original_publication=self.e['original_publication'], reconciliation=self.d['late_reconciliation'],
                   canonical=self.d['canonical'], draft=actual['draft'], predecessor=actual['predecessor'], author_receipt=actual['author_receipt'],
                   facts=receipt['actual_Source_packet'], selection=self.e['selection'], current_owner_scope=self.scope, lease=self.lease,
                   publisher_catalogue=self.e['publisher_catalogue'], historical_selection_inventory=self.e['historical_selection_inventory'],
                   M3_inventory=self.e['M3_inventory'], batch_roles=self.names, verified_record_count=len(self.s.items),
                   verified_record_bytes=self.s.total, validated_now_utc=self.now_text, metadata_only=True,
                   finite8_receipt_ABI_metadata_validated=True, unwired_obligations=list(OBLIGATIONS))
        out.update({k: False for k in FALSE_RESULT})
        return MetadataView(out)


def validate_finite8_canonical_receipt_metadata(*, dependency, expected, records, expected_root_thread, source_editor, now_utc):
    return _Validator(dependency, expected, records, expected_root_thread, source_editor, now_utc).validate()


def require_actual_finite8_canonical_dependency_admission(*args, **kwargs):
    if not ACTUAL_ENTRY_QUALIFIED:
        raise I11Error('E_ACTUAL_ENTRY_HELD')
    raise I11Error('E_ACTUAL_ENTRY_UNWIRED')
'''

FIXTURE = r'''
"""Fresh owned synthetic memory fixture. No project import or import-time action.
run_cases is entered only by a separately admitted supervisor after Source review.
Fixed historical JSON/Source bytes are inert data embedded by the Source author.
"""
import base64
import copy
import hashlib
import json
import re

C = __CONTRACT__
FIXED = __FIXED__
CASE_CATALOGUE = __CASES__
NOW = '2026-10-25T08:00:30.000000+00:00'
EDITOR = '/root/i2_resume_gap'
THREAD = '11111111-2222-3333-4444-555555555555'
HOME = r'D:\I11SyntheticMemoryOnly\producer'
ROOT = r'D:\I11SyntheticMemoryOnly'
ROLES = C['literals']['finite8_role_order']


def _time(n):
    return '2026-10-25T08:00:' + str(n).zfill(2) + '.000000+00:00'


def _wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True) + '\n').encode('utf8')


def _pin(path, body):
    return dict(path=path, bytes=len(body), sha256=hashlib.sha256(body).hexdigest())


def _observation(pin, staging=False):
    p = dict(pin)
    if staging:
        p['path'] += '.staging'
    vector = [1, 77, p['bytes'], 9, 10 if staging else 11, 0o100666, 1, 32, 1]
    return dict(**p, cap=65536, path9=vector, raw9=vector[:], descriptor9=vector[:],
                shared_identity_indexes=C['literals']['SHARED7'], shared_descriptor7=[vector[i] for i in C['literals']['SHARED7']],
                both_full_API9_independently_stable=True, two_read_match=True, observed_utc=_time(22))


class _Build:
    def __init__(self):
        self.store = {}
        self.json_paths = set()
        self.marks = {}
        for row in FIXED:
            body = base64.b64decode(row['base64'])
            self.store[row['pin']['path']] = (row['pin'], body)

    def raw(self, path, body):
        if path in self.store:
            assert self.store[path][1] == body, 'owned fixture duplicate path bytes'
            return self.store[path][0]
        pin = _pin(path, body)
        self.store[path] = pin, body
        return pin

    def put(self, path, value):
        p = self.raw(path, _wire(value))
        self.json_paths.add(path)
        return p

    def proof(self, name, subjects, scope, selection, start, purpose=None):
        full = dict(reviewer='/root/independent_review', verdict='PASS_SYNTHETIC_SOURCE_ONLY', checks_failed=0,
                    created_utc=_time(start), target_execution=False, operational_authority=False,
                    subjects=subjects, checks=[dict(name='whole_synthetic_metadata', passed=True)])
        if purpose is not None:
            full['exact_M3_Source_stage_purpose'] = purpose
        fp = self.put(ROOT + '\\proofs\\' + name + '.full.json', full)
        capsule = {k: v for k, v in full.items() if k != 'checks'}
        capsule.update(full_proof=fp, created_utc=_time(start + 1))
        cp = self.put(ROOT + '\\proofs\\' + name + '.capsule.json', capsule)
        adoption = dict(author='/root', verdict=C['literals']['stage_verdict'] if purpose is not None else 'ACCEPT_SYNTHETIC_SOURCE_METADATA_ONLY',
                        created_utc=_time(start + 2), target_execution=False, operational_authority=False,
                        subjects=subjects, different_review=cp, full_proof=fp, current_owner_scope=scope, selection=selection)
        if purpose is not None:
            adoption['exact_M3_Source_stage_purpose'] = purpose
        ap = self.put(ROOT + '\\proofs\\' + name + '.adoption.json', adoption)
        self.marks[name + '_full'] = fp['path']; self.marks[name + '_capsule'] = cp['path']; self.marks[name + '_adoption'] = ap['path']
        return cp, ap


def make_bundle(names=None, selected=None):
    b = _Build(); l = C['literals']
    names = list(names or ROLES[:1]); selected = selected or names[0]
    old = json.loads(b.store[l['current_selection_pin']['path']][1])
    inventory = json.loads(b.store[l['M3_inventory17_pin']['path']][1])
    basis = {r['role']: r['available_basis'] for r in inventory['roles']}
    scope = b.put(ROOT + '\\owner.json', dict(author='/root', target_execution=False, operational_authority=False))
    owner_review = b.put(ROOT + '\\owner_review.json', dict(author='/root', target_execution=False, operational_authority=False))
    owner_adopt = b.put(ROOT + '\\owner_adoption.json', dict(author='/root', target_execution=False, operational_authority=False))
    owner = dict(current_owner_scope=scope, different_current_owner_scope_Source_review=owner_review, current_owner_scope_Root_adoption=owner_adopt)
    manifest = b.put(ROOT + '\\owner_manifest.json', owner)
    lease = b.put(ROOT + '\\lease.json', dict(author='/root', created_utc=_time(0), target_execution=False, operational_authority=False))
    lease_support = {key: lease for key in C['schemas']['lease_support5']['keys']}
    rows = []
    producer_editor, publisher_editor = '/root/synthetic_producer', '/root/synthetic_publisher'
    for prior in old['rows']:
        row = copy.deepcopy(prior); role = row['role']
        if role != 'composer':
            row['predecessor'] = basis[role] if role in basis else prior['predecessor']
            row['selected_ordinal'] = prior['selected_ordinal'] + 1
            leaf = prior['canonical_path'].rsplit('\\', 1)[-1]
            hits = [m for m in re.finditer(r'[0-9]{3}(?![0-9])', leaf) if int(m[0]) == prior['selected_ordinal']]
            if len(hits) == 1:
                m = hits[0]; leaf = leaf[:m.start()] + str(row['selected_ordinal']).zfill(3) + leaf[m.end():]
            else:
                leaf = 'synthetic-' + role + '-' + str(row['selected_ordinal']).zfill(3) + '.data'
            row['canonical_path'] = prior['canonical_path'].rsplit('\\', 1)[0] + '\\' + leaf
            row['draft_path'] = ROOT + '\\generation\\fixture-only\\drafts\\' + leaf
            row['preparation_Source_author'] = producer_editor
            row['must_change_Source_bytes'] = True
        rows.append(row)
    selected_rows = {r['role']: r for r in rows}
    selection = dict(schema_version=2, record_type='Root_owner_v2_actual_separate_future45_Source_path_selection', author='/root', created_utc=_time(5),
                     current_owner_scope=scope, current_complete45_inventory=l['historical_selection45_pin'], current_selection=l['current_selection_pin'],
                     derived_launcher_runtime_path=ROOT+'\\unborn-runtime.py', new_canonical_lease=lease, operational_authority=False,
                     rows=rows, selected_Source_nonce='0'*32, target_execution=False)
    sp = b.put(ROOT+'\\selection.json', selection); b.marks['selection'] = sp['path']
    sr, sa = b.proof('selection', [sp, lease], scope, sp, 6)
    selection_support = dict(subject=sp, different_review=sr, Root_adoption=sa)
    catalogue = dict(schema_version=1, record_type='Root_Source024_actual45_predecessor_Source_pin_inventory', author='/root', created_utc=_time(5),
                     Source024=l['catalogue_Source024_provenance_pin'], current_selection=l['current_selection_pin'], exact_original_guard_constants=l['original_guards'],
                     operational_authority=False, target_execution=False, whole_cohort_or_runtime_acceptance=False,
                     roles=[dict(role=r['role'], source=r['predecessor'], source_cap=r['source_cap']) for r in rows])
    catalogue_pin=b.put(ROOT+'\\catalogue.json',catalogue); b.marks['catalogue']=catalogue_pin['path']
    cr,ca=b.proof('catalogue',[catalogue_pin],scope,sp,6)
    catalogue_support=dict(subject=catalogue_pin,different_review=cr,Root_adoption=ca)
    producer_source=b.raw(HOME+'\\producer.py',b'# synthetic held producer bytes; never executed\n')
    producer_api=b.put(HOME+'\\producer_api.json',dict(schema_version=2,record_type='Root_owner_v2_M3_deferred_metadata_inert_API',author=producer_editor,
                       actual_binding_Source_editor=producer_editor,Source=producer_source,external_canonical_receipt_ABI_qualified=False,
                       historical_binding_Source_editor='/root/pipeline_source_editor',historical_metadata_Source_editor='/root/m3_source_editor',retained_payload_semantic_Source_author='/root/selector_prep'))
    pr,pa=b.proof('producer',[producer_source,producer_api],scope,sp,1)
