                       operational_choices={},binding_supports={},role_selections={},source_only=True,target_execution=False,operational_authority=False,canonical_publication=False,native_Parser_authority=False)
            fp=b.put(HOME+'\\facts-'+stage_key+'.json',facts)
            inputs=[fp,sp,lease,manifest,*owner.values(),*tool.values(),*lease_support.values(),sr,sa,l['M3_inventory17_pin']]
