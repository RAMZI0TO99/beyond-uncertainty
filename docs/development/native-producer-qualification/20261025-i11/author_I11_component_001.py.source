ap=create(OUT/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_001.json',(json.dumps(api,sort_keys=True,indent=2)+'\n').encode())
regions=[]
for path,raw in ((Path(sp['path']),source),(Path(fp['path']),fixture)):
    tree=ast.parse(raw);lines=raw.splitlines(keepends=True)
    for node in tree.body:
        if isinstance(node,(ast.FunctionDef,ast.ClassDef)):
            region=b''.join(lines[node.lineno-1:node.end_lineno])
            regions.append(dict(path=str(path),name=node.name,first_line=node.lineno,last_line=node.end_lineno,bytes=len(region),sha256=hashlib.sha256(region).hexdigest()))
inv=dict(schema_version=1,record_type='I11_exact_Source_region_and_no_old_target_change_inventory',author='/root/i2_resume_gap',Source=sp,fixture=fp,API=ap,regions=regions,
         case_catalogue=cases,literal_case_count=len(cases),fixed_data_pins=[x['pin'] for x in fixed],
