_,reach=assignment(fixture,'SOURCE_ONLY_REACHABILITY')
new_cases=[('owned_input_graph_positive_global_and_sibling_isolation','input_isolation',['all_containers'],None),
           ('owned_input_graph_negative_pin_global_and_sibling_isolation','input_isolation',['negative_pin'],'E_PIN'),
           ('owned_input_graph_fresh_positive_after_negative','selector',[0],None)]
