reach.update(owned_input_graph='Fixed pin dicts and literal subtree are copied during construction; complete returned graph and every case spec are deep-copied. Positive/negative controls snapshot C/FIXED/catalogue/ROLES, assert no mutable container identity overlap with globals or sibling bundles, corrupt only one owned graph, and assert globals/sibling unchanged. Immutable bytes/strings are data and need not have distinct identities.',
             attempt001_saved_limit='Actual attempt001 emitted271 CASE_PASS events. Shared FIXED[0].pin mutation already affected cases270/271; case272 closed_fact3_missing_sha256 failed during setup before its validator call;389later cases unentered. Recorded events are not271 isolated intended-predicate qualifications. No kernel defect demonstrated; no old fixture replay.')
extra=r'''
        elif kind=='input_isolation':
            def input_isolation_case(action=args[0]):
                globals_before=copy.deepcopy((C,FIXED,CASE_CATALOGUE,ROLES))
                first=make_bundle();sibling=make_bundle();sibling_before=copy.deepcopy(sibling)
                def containers(value, found=None):
                    found={} if found is None else found
                    if type(value) in (dict,list,tuple):
                        if id(value) in found:return found
                        found[id(value)]=value
                        for child in value.values() if type(value) is dict else value:containers(child,found)
                    return found
                globals_containers=containers((C,FIXED,CASE_CATALOGUE,ROLES))
                first_containers=containers(first);sibling_containers=containers(sibling)
                # Tuple case rows are immutable; only mutable dict/list identity
                # must be owned. The traversal visits immutable tuple children.
                mutable=lambda found:{key for key,value in found.items() if type(value) in (dict,list)}
                assert mutable(first_containers).isdisjoint(mutable(globals_containers))
                assert mutable(sibling_containers).isdisjoint(mutable(globals_containers))
                assert mutable(first_containers).isdisjoint(mutable(sibling_containers))
                if action=='all_containers':
                    for value in first_containers.values():
                        if type(value) in (dict,list):value.clear()
                    assert (C,FIXED,CASE_CATALOGUE,ROLES)==globals_before
                    assert sibling==sibling_before
                    return invoke(component,sibling)
                assert action=='negative_pin'
                assert set(first['records'][0]['pin'])=={'path','bytes','sha256'}
                del first['records'][0]['pin']['bytes']
                assert set(first['records'][0]['pin'])=={'path','sha256'}
                try:return invoke(component,first)
                finally:
                    assert (C,FIXED,CASE_CATALOGUE,ROLES)==globals_before
                    assert sibling==sibling_before and set(sibling['records'][0]['pin'])=={'path','bytes','sha256'}
                    fresh=make_bundle()
                    assert fresh==sibling_before
            check(name,input_isolation_case,error)
'''
