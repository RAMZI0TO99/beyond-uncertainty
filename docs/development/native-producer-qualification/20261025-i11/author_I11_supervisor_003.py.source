source=replace(source,"    acceptance_elapsed = time.monotonic() - start\n    if acceptance_elapsed > 60:", "    acceptance_elapsed_ns = int((time.monotonic() - start) * 1000000000)\n    if acceptance_elapsed_ns > 60000000000:")
source=replace(source,"and acceptance_elapsed <= 60\n", "and acceptance_elapsed_ns <= 60000000000\n")
source=replace(source,"elapsed_milliseconds=int(acceptance_elapsed*1000), acceptance_elapsed_seconds=acceptance_elapsed", "elapsed_milliseconds=acceptance_elapsed_ns//1000000, acceptance_elapsed_nanoseconds=acceptance_elapsed_ns")
source=replace(source,"    write_new(outputs['supervisor_result'], wire(witness))\n    print(json.dumps(dict(accepted=accepted, supervisor_result=outputs['supervisor_result'], owned_pid=proc.pid, exit_code=proc.returncode)), flush=True)\n    return 0 if accepted else 1",'''    witness_pin = write_new(outputs['supervisor_result'], wire(witness))
    # Reporting boundary: no rewrite of the saved candidate. Final console and
