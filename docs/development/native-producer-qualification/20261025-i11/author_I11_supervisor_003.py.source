                          streams_drained=drained, total_budget_nanoseconds=60000000000)), flush=True)
    return 0 if final_accepted else 1''')
raw=source.encode();tree=ast.parse(raw);compile(raw,'<supervisor003 data compile>','exec')
assert not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='read_bytes' for n in ast.walk(tree))
