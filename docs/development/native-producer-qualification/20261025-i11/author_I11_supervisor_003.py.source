                              final_elapsed_milliseconds=int(final_elapsed*1000))), flush=True)
        return 1''')
old_cleanup='''    terminated = killed = False
    if proc.poll() is None:
        proc.terminate(); terminated = True
        try:
            proc.wait(timeout=max(0.001, min(5, 60 - (time.monotonic() - start))))
        except subprocess.TimeoutExpired:
            proc.kill(); killed = True
            proc.wait(timeout=max(0.001, min(5, 60 - (time.monotonic() - start))))
    else:
        proc.wait(timeout=5)
    for thread in threads:
        thread.join(timeout=max(0.001, min(1, 60 - (time.monotonic() - start))))'''
new_cleanup='''    terminated = killed = False
    custody_error = None
    if proc.poll() is None:
        try:
            proc.terminate(); terminated = True
            try:
                proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
            except subprocess.TimeoutExpired:
                proc.kill(); killed = True
                try:
                    proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
                except subprocess.TimeoutExpired:
                    reason = 'FINAL_REAP_TIMEOUT'
        except OSError as exc:
            custody_error = type(exc).__name__
            reason = 'OWNED_CLEANUP_REFUSAL'
    else:
        try:
            proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
