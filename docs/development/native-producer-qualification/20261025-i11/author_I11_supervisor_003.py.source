source=replace(source,"    claim_raw = ordinary(outputs['claim']).read_bytes()\n    need(0 < len(claim_raw) <= 2097152, 'bounded once claim')", "    claim_raw = read_limited(outputs['claim'])")
source=replace(source,"    proc = subprocess.Popen([sys.executable, '-I', '-S', '-B', str(Path(__file__)), '--child', str(scope_path), expected_hash],\n                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))",'''    try:
        proc = subprocess.Popen([sys.executable, '-I', '-S', '-B', str(Path(__file__)), '--child', str(scope_path), expected_hash],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
    except OSError as exc:
        elapsed = time.monotonic() - start
        refused = dict(schema_version=1, record_type='I11_owned_once_memory_supervisor_result', created_utc=utc(), scope=scope_pin,
