source=replace(source,"                   elapsed_milliseconds=int((time.monotonic()-start)*1000), budgets=BUDGETS, child_result=result,\n                   accepted_complete_new_synthetic_run=accepted, actual_family_publication=False, target_execution=False,", "                   elapsed_milliseconds=int(acceptance_elapsed*1000), acceptance_elapsed_seconds=acceptance_elapsed, budgets=BUDGETS, child_result=result,\n                   acceptance_at_record_preparation=accepted, final_acceptance_requires_saved_console_and_parent_exit0=True,\n                   child_launched=True, custody_error=custody_error, child_result_error=child_result_error,\n                   actual_family_publication=False, target_execution=False,")
# Float-free saved metadata: exact monotonic sample represented integer ns and
