            reason = 'FINAL_REAP_TIMEOUT'
    for thread in threads:
        thread.join(timeout=max(0, min(1, 60 - (time.monotonic() - start))))'''
source=replace(source,old_cleanup,new_cleanup)
source=replace(source,"    if os.path.lexists(outputs['child_result']):\n        path = ordinary(outputs['child_result']); body = path.read_bytes()\n        need(len(body) <= 2097152, 'bounded child result')\n        result = dict(pin=fact(path, body), value=decode(body))",'''    if os.path.lexists(outputs['child_result']):
