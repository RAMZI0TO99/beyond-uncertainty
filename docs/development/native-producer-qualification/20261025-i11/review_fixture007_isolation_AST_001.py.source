"""Read/hash/JSON/AST only: independent fixture007 ownership repair review."""
import ast
import base64
import copy
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path

BASE = Path(r"D:\Aenv\pro2\WORK\resume-20261025-001\i2_receipt_contract_014")
FILES = BASE / "i11"
OUT = BASE / "source_review_003"


def raw(path):
    with path.open("rb") as handle:
        data = handle.read(2097153)
    if len(data) > 2097152:
        raise ValueError("review read cap")
    return data


def pin(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())


def pairs(rows):
    out = {}
    for key, value in rows:
        if key in out:
            raise ValueError("duplicate JSON name")
        out[key] = value
    return out


def bad_number(value):
    raise ValueError("float/nonfinite token")


def read(path):
    return json.loads(raw(path).decode("utf8", "strict"), object_pairs_hook=pairs,
                      parse_float=bad_number, parse_constant=bad_number)


def constants(tree):
    value = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and isinstance(node.targets[0], ast.Name):
            try:
                value[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError, TypeError):
                pass
    return value


def save(path, value):
    data = (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n").encode()
    if len(data) > 2097152:
        raise ValueError("review output cap")
    with path.open("xb") as handle:
        handle.write(data)


def main():
    OUT.mkdir(exist_ok=True)
    checks = []
    inputs = {}
    def check(name, condition, detail=None):
        checks.append(dict(name=name, passed=bool(condition), detail=detail))
    def include(path):
        actual = pin(path)
        inputs[path.name] = actual
        return actual
    paths = {"Source": FILES / "validate_finite8_canonical_receipt_metadata_003.py",
             "fixture": FILES / "test_finite8_canonical_receipt_metadata_memory_only_007.py",
             "API": FILES / "CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_007.json",
             "inventory": FILES / "I11_EXACT_SOURCE_REGION_AND_NO_OLD_TARGET_CHANGE_INVENTORY_007.json",
             "author": FILES / "I11_FINITE8_CANONICAL_RECEIPT_METADATA_SOURCE_AUTHOR_RECEIPT_007.json",
             "supervisor": BASE / "ROOT_I11_ONCE_MEMORY_SUPERVISOR_006.py",
             "supervisor_author": BASE / "I11_SUPERVISOR006_STATIC_SOURCE_AUTHOR_RECEIPT_001.json",
             "refusal_binding": BASE / "I11_FIXTURE007_REPAIR_EXACT_SAVED_REFUSAL_BINDING_001.json"}
    for path in paths.values():
        include(path)
    prior_source_capsule = BASE / "source_review_002" / "INDEPENDENT_FINAL_I11_SOURCE_CAPSULE_001.json"
    prior_source_full = BASE / "source_review_002" / "INDEPENDENT_FINAL_I11_SOURCE_FULL_PROOF_001.json"
    prior_refusal_capsule = BASE / "results_review_attempt001" / "INDEPENDENT_I11_ATTEMPT001_SAVED_REFUSAL_CAPSULE_001.json"
    prior_refusal_full = BASE / "results_review_attempt001" / "INDEPENDENT_I11_ATTEMPT001_SAVED_REFUSAL_FULL_PROOF_001.json"
    refusal_adoption = BASE / "ROOT_I11_ATTEMPT001_SAVED_REFUSAL_DIFFERENT_REVIEW_ADOPTION_001.json"
    for path in (prior_source_capsule, prior_source_full, prior_refusal_capsule, prior_refusal_full, refusal_adoption):
        include(path)
        read(path)
    check("prior269_Source_proof_exact", pin(prior_source_full)["sha256"] == "eecc030ca63eee539360c96632a0bf94901e2cffeee618cd3fd3ec0cf1a21ddd" and read(prior_source_capsule)["check_count"] == 269 and read(prior_source_capsule)["checks_failed"] == 0)
    check("prior45_saved_refusal_exact", pin(prior_refusal_full)["sha256"] == "fb93e12a2a86c0829b08e9a4b6a7d7c83f9012c91f6de3f98ec88f904f86c9cd" and read(prior_refusal_capsule)["check_count"] == 45 and read(prior_refusal_capsule)["checks_failed"] == 0)
    check("unchanged_Source003_carried_without_reexploration", pin(paths["Source"]) == read(prior_source_full)["inputs"][paths["Source"].name] and pin(paths["Source"])["sha256"] == "51f71572b21d76063300a33eeaddc578d19892721ff59cb027faeee335a44f3f")
    author, api, inventory, binding, sup_author = [read(paths[k]) for k in ("author", "API", "inventory", "refusal_binding", "supervisor_author")]
    for k in ("Source", "fixture", "API", "inventory"):
        check("exact_author_pin:" + k, author[k] == pin(paths[k]))
    for k in ("Source", "fixture", "API"):
        check("exact_inventory_pin:" + k, inventory[k] == pin(paths[k]))
    check("API_Source_pin", api["Source"] == pin(paths["Source"]))
    for k in ("Source", "fixture", "API", "supervisor"):
        check("exact_repair_binding_pin:" + k, binding[k] == pin(paths[k]))
    check("exact_author_binding_pin", binding["repair_author_receipt"] == pin(paths["author"]))
    check("exact_supervisor_author_binding_pin", binding["supervisor_author_receipt"] == pin(paths["supervisor_author"]))
    for i, expected in enumerate(binding["saved_attempt001"]):
        check("saved_attempt001_unchanged:" + str(i), include(Path(expected["path"])) == expected)
    for i, expected in enumerate(binding["saved_refusal_review_and_Root_adoption"]):
        check("saved_refusal_proof_unchanged:" + str(i), include(Path(expected["path"])) == expected)
    check("all9_attempt_outputs_bound", len(binding["saved_attempt001"]) == 9)
    check("refusal_semantics_preserved", binding["actual_CASE_PASS_events"] == 271 and binding["first_shared_global_corruption_case_number"] == 270 and binding["setup_failure_case_number"] == 272 and binding["later_cases_unentered"] == 389 and binding["independent_271_case_qualification_established"] is False and binding["kernel_failure_demonstrated"] is False)
    old_fixture = FILES / "test_finite8_canonical_receipt_metadata_memory_only_006.py"
    old_supervisor = BASE / "ROOT_I11_ONCE_MEMORY_SUPERVISOR_005.py"
    include(old_fixture); include(old_supervisor)
    trees = [ast.parse(raw(p), filename=str(p)) for p in (old_fixture, paths["fixture"])]
    old, new = [constants(t) for t in trees]
    catalogue = new["CASE_CATALOGUE"]
    names = [r[0] for r in catalogue]
    digest = hashlib.sha256(json.dumps(names, separators=(",", ":"), ensure_ascii=True).encode()).hexdigest()
    check("exact664_unique_AST_literal_cases", len(catalogue) == len(set(names)) == 664 and author["literal_case_count"] == 664)
    check("exact_case_names_digest", digest == "a89888d006968e3b83f273f68fa175980e26c3c31aacef5f7ed12a0a90be6bb6")
    check("all_prior661_cases_unchanged", catalogue[3:] == old["CASE_CATALOGUE"])
    check("literal_C_FIXED_and_65map_unchanged", new["C"] == old["C"] and new["FIXED"] == old["FIXED"] and new["FINAL_VARIANT_GAP_TABLE_COVERAGE"] == old["FINAL_VARIANT_GAP_TABLE_COVERAGE"])
    check("inventory_literal_catalogue_exact", json.dumps(inventory["case_catalogue"], sort_keys=True) == json.dumps(catalogue, sort_keys=True))
    check("new_three_isolation_controls", catalogue[0][1:] == ("input_isolation", ["all_containers"], None) and catalogue[1][1:] == ("input_isolation", ["negative_pin"], "E_PIN") and catalogue[2][1:] == ("selector", [0], None))
    old_defs = {n.name: n for n in trees[0].body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    new_defs = {n.name: n for n in trees[1].body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    check("same_top_level_definitions", set(old_defs) == set(new_defs))
    for name in old_defs.keys() - {"_Build", "make_bundle", "run_cases"}:
        check("unchanged_prior_helper:" + name, ast.dump(old_defs[name]) == ast.dump(new_defs[name]))
    text = raw(paths["fixture"]).decode()
    check("copied_FIXED_pin_before_store", "owned_pin = copy.deepcopy(row['pin'])" in text and "self.store[owned_pin['path']] = (owned_pin, body)" in text)
    check("copied_C_literal_subtree", "l = copy.deepcopy(C['literals'])" in text)
    check("whole_return_graph_detached", "return copy.deepcopy(dict(dependency=dependency" in text)
    check("every_case_spec_detached", "name,kind,args,error=copy.deepcopy(spec)" in text)
    check("isolation_mutable_identity_disjointness", "mutable(first_containers).isdisjoint(mutable(globals_containers))" in text and "mutable(sibling_containers).isdisjoint(mutable(globals_containers))" in text and "mutable(first_containers).isdisjoint(mutable(sibling_containers))" in text)
    check("positive_clears_every_owned_container_only", "for value in first_containers.values():" in text and "value.clear()" in text and "return invoke(component,sibling)" in text)
    check("negative_pin_then_finally_checks", "del first['records'][0]['pin']['bytes']" in text and "assert fresh==sibling_before" in text and "assert (C,FIXED,CASE_CATALOGUE,ROLES)==globals_before" in text)
    class Normalize(ast.NodeTransformer):
        def visit_If(self, node):
            node = self.generic_visit(node)
            if ast.unparse(node.test) == "kind == 'input_isolation'":
                return node.orelse
            return node
        def visit_Assign(self, node):
            node = self.generic_visit(node)
            if isinstance(node.value, ast.Call) and ast.unparse(node.value) == "copy.deepcopy(spec)":
                node.value = ast.Name(id="spec", ctx=ast.Load())
            return node
    normalized = Normalize().visit(copy.deepcopy(new_defs["run_cases"]))
    check("all_prior_case_handlers_exact_AST", ast.dump(normalized) == ast.dump(old_defs["run_cases"]))
    check("fixture_no_new_imports", [ast.dump(n) for n in trees[0].body if isinstance(n,(ast.Import,ast.ImportFrom))] == [ast.dump(n) for n in trees[1].body if isinstance(n,(ast.Import,ast.ImportFrom))])
    check("fixture_no_target_IO_exec", not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in {"open","exec","eval","compile","__import__","input"} for n in ast.walk(trees[1])))
    for row in inventory["complete_predecessors"]:
        expected = row["pin"]
        data = base64.b64decode(row["complete_bytes_base64"], validate=True)
        check("complete_predecessor_inverse:" + Path(expected["path"]).name, include(Path(expected["path"])) == expected and data == raw(Path(expected["path"])))
    supers = [ast.parse(raw(p), filename=str(p)) for p in (old_supervisor,paths["supervisor"])]
    sup = constants(supers[1])
    check("supervisor_exact_new_pins", sup["SOURCE"] == pin(paths["Source"]) and sup["FIXTURE"] == pin(paths["fixture"]))
    check("supervisor_exact664_catalogue", sup["EXPECTED_CASE_COUNT"] == 664 and sup["EXPECTED_CASE_NAMES_SHA256"] == digest and sup_author["literal_case_count"] == 664)
    for k, path in (("module",paths["Source"]),("fixture",paths["fixture"]),("API",paths["API"]),("supervisor",paths["supervisor"])):
        check("supervisor_author_exact_pin:" + k, sup_author[k] == pin(path))
    prior_assign = {n.targets[0].id: n.value for n in supers[0].body if isinstance(n,ast.Assign) and isinstance(n.targets[0],ast.Name)}
    normalized_sup = copy.deepcopy(supers[1])
    for node in normalized_sup.body:
        if isinstance(node,ast.Assign) and isinstance(node.targets[0],ast.Name) and node.targets[0].id in {"FIXTURE","EXPECTED_CASE_COUNT","EXPECTED_CASE_NAMES_SHA256"}:
            node.value = copy.deepcopy(prior_assign[node.targets[0].id])
    for node in ast.walk(normalized_sup):
        if isinstance(node,ast.Constant) and node.value == "_i11_new_fixture_007":
            node.value = "_i11_new_fixture_006"
    check("supervisor_semantics_exact_prior_AST", ast.dump(normalized_sup) == ast.dump(supers[0]))
    check("supervisor_budgets_unchanged", sup_author["budgets"] == dict(total_seconds=60,wait_seconds=50,cleanup_seconds=10,reap_seconds=5,stdout_maximum_bytes=2097152,stderr_maximum_bytes=2097152))
    check("author_and_binding_hold_flags", all(value[k] is False for value in (author,binding,sup_author) for k in ("target_execution","operational_authority","scientific_authority")) and binding["new_suite_executed"] is False)
    observations = [
        "Read/hash/strict JSON/AST only; no successor import, call, generated live bundle or replay. The observed attempt001 remains preserved and unqualified.",
        "Whole kernel semantics carried through exact unchanged Source003 pin from prior269-check Source proof. This review audits only fixture ownership repair, its664-case binding, unchanged prior handlers and successor supervisor.",
        "The returned bundle graph is deepcopied as a whole; fixed pins and literal subtree are separately copied, and each case spec is copied before use. Global dictionaries/lists cannot be reached through a returned bundle by the inspected Source flow.",
        "New controls collect all dictionary/list/tuple object identities while retaining strong references, prove mutable identity disjointness against globals and a sibling, clear all first-bundle containers, require a healthy sibling positive, then test negative pin deletion with finally global/sibling/fresh equality and a following fresh positive. Actual outcomes remain unmeasured.",
        "All prior661 case definitions and prior handlers remain exact. P07 mapping additionally lists the new isolation negative as a related control; its literal expected result is E_PIN and it is also mapped underN05, not a metadata-positive claim.",
        "Supervisor006 differs from005 only in fixture pin/count/digest/module label. Exclusive once custody, actual EOF/error drains and60/50/10/5 reporting boundaries are unchanged.",
        "No next target entry follows this Source pass. Root adoption and a fresh once scope after actual peer completion/reaping or expiry are separately required; scope001 remains consumed. FullG01/I2 flags, producer/caller integration, family/native/Parser/runtime/science remain held.",
    ]
    failures = sum(not c["passed"] for c in checks)
    verdict = "PASS_SOURCE_FIXTURE007_INPUT_ISOLATION_AND_SUPERVISOR006_ONLY" if failures == 0 else "REFUSED_PENDING_REVIEW_CHECKS"
    full = dict(schema_version=1,record_type="independent_I11_fixture007_isolation_Source_full_proof",reviewer="/root/project_architecture",created_utc=datetime.now(timezone.utc).isoformat(),verdict=verdict,checks_failed=failures,checks=checks,inputs=inputs,reviewer_tool=pin(Path(__file__)),literal_case_count=664,literal_case_names_sha256=digest,observations=observations,tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False,full_G01_closed=False)
    full_path = OUT / "INDEPENDENT_I11_FIXTURE007_ISOLATION_SOURCE_FULL_PROOF_001.json"
    save(full_path,full)
    capsule = dict(schema_version=1,record_type="independent_I11_fixture007_isolation_Source_capsule",reviewer=full["reviewer"],created_utc=datetime.now(timezone.utc).isoformat(),verdict=verdict,check_count=len(checks),checks_failed=failures,full_proof=pin(full_path),inputs=inputs,literal_case_count=664,literal_case_names_sha256=digest,observations=observations,tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False,full_G01_closed=False)
    capsule_path = OUT / "INDEPENDENT_I11_FIXTURE007_ISOLATION_SOURCE_CAPSULE_001.json"
    save(capsule_path,capsule)
    print(json.dumps(dict(checks=len(checks),checks_failed=failures,failed_names=[c["name"] for c in checks if not c["passed"]],full_proof=pin(full_path),capsule=pin(capsule_path))))


if __name__ == "__main__":
    main()
