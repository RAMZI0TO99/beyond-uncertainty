"""Static supervisor005 binding author; no target import, launch or dry run."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path
HERE=Path(__file__).parent
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def create(path,raw):
    assert 0<len(raw)<=2097152
    with path.open('xb') as handle:handle.write(raw)
    return pin(path)
def literal(text,name):
    node=next(n for n in ast.parse(text).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    return node,ast.literal_eval(node.value)
def assign(text,name,value):
    node,_=literal(text,name);lines=text.splitlines(keepends=True)
    return ''.join(lines[:node.lineno-1])+name+' = '+repr(value)+'\n'+''.join(lines[node.end_lineno:])
old=HERE/'ROOT_I11_ONCE_MEMORY_SUPERVISOR_004.py';text=old.read_text(encoding='utf8')
fixture=pin(HERE/'i11'/'test_finite8_canonical_receipt_metadata_memory_only_006.py')
_,cases=literal(Path(fixture['path']).read_text(encoding='utf8'),'CASE_CATALOGUE')
digest=hashlib.sha256(json.dumps([c[0] for c in cases],separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
for key,value in [('FIXTURE',fixture),('EXPECTED_CASE_COUNT',len(cases)),('EXPECTED_CASE_NAMES_SHA256',digest)]:text=assign(text,key,value)
assert text.count("'_i11_new_fixture_005'")==1;text=text.replace("'_i11_new_fixture_005'","'_i11_new_fixture_006'",1)
raw=text.encode();ast.parse(raw);compile(raw,'<supervisor005 data compile>','exec')
sp=create(HERE/'ROOT_I11_ONCE_MEMORY_SUPERVISOR_005.py',raw)
old_receipt=HERE/'I11_SUPERVISOR004_STATIC_SOURCE_AUTHOR_RECEIPT_001.json'
receipt=json.loads(old_receipt.read_bytes())
receipt.update(record_type='I11_supervisor005_static_final_literal_correction_binding_author_receipt',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),supervisor=sp,fixture=fixture,
    API=pin(HERE/'i11'/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_006.json'),previous_supervisor=pin(old),previous_author_receipt=pin(old_receipt),author_tool=pin(Path(__file__)),
    literal_case_count=len(cases),case_names_sha256=digest,correction='Only exact fixture006 pin/count/name-digest and synthetic module name binding change; prior total budget/EOF/once/custody Source unchanged.',tests_executed=False,target_execution=False)
rp=create(HERE/'I11_SUPERVISOR005_STATIC_SOURCE_AUTHOR_RECEIPT_001.json',(json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(supervisor=sp,receipt=rp,literal_case_count=len(cases),case_names_sha256=digest,tests_executed=False),sort_keys=True))
