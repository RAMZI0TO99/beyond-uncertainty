"""Independent Source-only protocol review. No project Source is imported or called."""
import ast
import datetime as dt
import hashlib
import json
import os
from pathlib import Path, PureWindowsPath
import re
import sys

HERE = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013\protocol_review_002')
P = HERE.parent
REVIEWER = '/root/i10_producer_frontier'
CAP = 2097152
INPUTS, CHECKS = {}, []

def check(name, passed):
    assert type(name) is str and name and all(row['name'] != name for row in CHECKS)
    assert type(passed) is bool
    CHECKS.append(dict(name=name, passed=passed))

def fact(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def read(path, expected=None):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as h:
        raw = h.read(CAP+1)
    assert len(raw) <= CAP
    f = fact(path, raw)
    if expected is not None:
        assert f == expected
    assert str(path) not in INPUTS or INPUTS[str(path)] == f
    INPUTS[str(path)] = f
    return raw

def pairs(rows):
    out = {}
    for k, value in rows:
        assert k not in out
        out[k] = value
    return out

def load(raw):
    return json.loads(raw.decode('utf-8'), object_pairs_hook=pairs,
        parse_float=lambda _: (_ for _ in ()).throw(ValueError('float')),
        parse_constant=lambda _: (_ for _ in ()).throw(ValueError('constant')))

def pinload(pin):
    assert type(pin) is dict and set(pin) == {'path','bytes','sha256'}
    return load(read(pin['path'], pin))

def closed_pins(value):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'}:
            yield value
        else:
            for item in value.values():
                yield from closed_pins(item)
    elif type(value) is list:
        for item in value:
            yield from closed_pins(item)

def functions(tree):
    return {node.name:node for node in tree.body if isinstance(node,ast.FunctionDef)}

def literal_assignments(tree):
    out = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0],ast.Name):
            try:
                out[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError,TypeError):
                pass
    return out

def save(name, obj):
    raw = (json.dumps(obj,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    assert len(raw) <= CAP
    path = HERE/name
    with path.open('xb') as h:
        h.write(raw)
        h.flush()
        os.fsync(h.fileno())
    assert path.read_bytes() == raw
    return fact(path,raw)

