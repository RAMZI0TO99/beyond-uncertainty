check('accepted_I8_phase_role_suffix_and_exact_leaf_equality',"phase_suffix = '.TEMPLATE.ps1' if role.endswith('_template') else '.BOUND.ps1'" in i8_text and 'expected_leaf.endswith(phase_suffix)' in i8_text)
substitution_evidence = []
for row in expected_rows:
