    matches = [m for m in re.finditer(r'[0-9]{3}(?![0-9])',leaf) if int(m.group()) == row['previous_ordinal']]
    check(role+'_actual_previous_ordinal18_strict_int',type(row['previous_ordinal']) is int and row['previous_ordinal'] == 18)
    check(role+'_actual_old_ordinal_token_unique',len(matches) == 1)
    suffix = '.TEMPLATE.ps1' if role.endswith('_template') else '.BOUND.ps1'
    check(role+'_actual_old_leaf_has_expected_case_sensitive_suffix',leaf.endswith(suffix))
    derived = []
