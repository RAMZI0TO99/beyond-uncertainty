        m = matches[0]
        expected = leaf[:m.start()]+str(ordinal).zfill(3)+leaf[m.end():]
        check(role+'_derived_%03d_exact_inherited_leaf_rejected_by_old_I2_regex'%ordinal,re.fullmatch(r'.*_(\d{3})\.ps1',expected) is None)
