"""Root metadata-only current scope and whole-byte preservation; no target imports."""
import pathlib, json, hashlib, datetime, subprocess, os, ctypes, shutil

R = pathlib.Path(r'D:\Aenv\pro2')
O = R / 'WORK/resume-20261017-001/producer_caller_qualification_013'
P = R / 'WORK/resume-20261017-001/m3_prewrite_validation_012'
G = R / 'github-portable-20261012-001'
CAP = 2097152
BASE = '471105e8f77e8e8e06ccb54fb84d0821267e4213'
def read(p, cap=CAP):
    p = pathlib.Path(p)
    assert p.is_file() and not p.is_symlink() and p.stat().st_size <= cap
    with p.open('rb') as h:
        b = h.read(cap+1)
    assert len(b) <= cap
    return b
def fact(p):
    b = read(p)
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())
def pin(f, p=None, cap=CAP):
    b = read(p or f['path'], cap)
    assert len(b) == f['bytes'] and hashlib.sha256(b).hexdigest() == f['sha256']
    return b
def save(name, obj):
    b = (json.dumps(obj, indent=2, sort_keys=True, allow_nan=False)+'\n').encode()
    assert len(b) <= CAP
    with (O/name).open('xb') as h:
        h.write(b); h.flush(); os.fsync(h.fileno())
    print(json.dumps(fact(O/name)))
git = r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Git\cmd\git.exe'
env = dict(os.environ, GIT_OPTIONAL_LOCKS='0')
observed = {}
for key, args in [('HEAD', ['rev-parse','HEAD']), ('branch',['symbolic-ref','HEAD']), ('index',['diff','--cached','--name-only']), ('origin_main',['rev-parse','refs/remotes/origin/main'])]:
    r = subprocess.run([git, '-c','core.autocrlf=false','-c','core.safecrlf=false', *args], cwd=G, env=env, capture_output=True, timeout=60, check=True)
    assert not r.stderr
    observed[key] = r.stdout.decode().strip()
assert observed == dict(HEAD=BASE, branch='refs/heads/main', index='', origin_main=BASE)
f = fact(P/'ROOT_I9_RECORDED_M3_SEMANTICS_AND_MANAGED_PUBLICATION_FINAL_OUTCOME_001.json')
assert f['bytes'] == 444278 and f['sha256'] == '94cace6d5749641f6c37956a15a3f5fdfe7ab5f7c4a5786c0c482ed9c667c985'
final = json.loads(pin(f))
assert final['HEAD'] == BASE and final['normal_fast_forward_push_completed'] is True and final['local_remote_parity'] is True
s = json.loads(pin(final['scope']))
assert len(s['files']) == 533
for row in s['files']:
    b = pin(row['source'], G/row['managed_path'])
    if row['mode'] == 'prepend':
        assert b[row['prefix_bytes']:] == pin(row['saved_predecessor'])
baseline = json.loads(pin(s['preexisting608_byte_baseline']))
assert len(baseline['all_preexisting_file_bytes']) == 608
for row in baseline['all_preexisting_file_bytes']:
    cap = CAP
    if row['bytes'] > cap:
        assert row['bytes'] == 3483233 and row['sha256'] == 'e646afc11642d8df66cf7ef0aff26474ce45eaec23d08ecd16f17eaedae2b0e9'
        assert row['path'] == 'docs/development/closeout-evidence/root-docs-independent-major036/INDEPENDENT_MAJOR036_CREATION_REVIEW_001.json'
        cap = row['bytes']
    pin(row, G/row['path'], cap)
assert len(s['all_prior_I6_I7_I8_non_navigation_file_pins']) == 342
for row in s['all_prior_I6_I7_I8_non_navigation_file_pins']:
    pin(row)
for row in s['all_frozen_STEP080_sentinels']:
    pin(row['actual_current_pin'])
current = json.loads(pin(s['current36_Source_baseline']))
assert current['actual_present'] == 36
for row in current['current_45_identity_rows']:
    if row['canonical'] is None:
        assert not pathlib.Path(row['canonical_path']).exists()
    else:
        pin(row['canonical'])
class Memory(ctypes.Structure):
    _fields_ = [('length',ctypes.c_ulong),('load',ctypes.c_ulong), *[(n,ctypes.c_ulonglong) for n in ('total','available','page_total','page_available','virtual_total','virtual_available','extended')]]
m=Memory();m.length=ctypes.sizeof(m)
assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m))
disk=shutil.disk_usage(G).free
assert m.available >= 1073741824 and disk >= 10737418240
now=datetime.datetime.now(datetime.timezone.utc)
common=dict(schema_version=1, author='/root', created_utc=now.isoformat(), target_execution=False, tests_executed=False, operational_authority=False, scientific_authority=False)
