    all75_spent_no_replay_and_original_caps_guards_reserves_preserved=True,
    metadata_only_cap_bytes=CAP, phase_Source_cap_bytes=65536,model_export_cap_bytes=131072,
    current_dated_Source_present=36,current_dated_pending=9,frozen_STEP080_present=35,frozen_STEP080_pending=10,
