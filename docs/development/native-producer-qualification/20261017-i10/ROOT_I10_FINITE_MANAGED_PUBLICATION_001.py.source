"""Finite inert I10 documentation publisher. Source only until Root review/admission.

CLI: prepare; copy|stage|commit|push <exact-scope-sha256> <exact-publication-adoption-sha256>.
Never imports, compiles or invokes any project module, fixture or original target.
"""
import ast
import ctypes
import datetime
import hashlib
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import time

