GIT = r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Git\cmd\git.exe'
ENV = dict(os.environ, GIT_OPTIONAL_LOCKS='0')
SOURCE_SCOPE = dict(path=str(O/'ROOT_CURRENT_I10_PRODUCER_CALLER_SOURCE_SCOPE_001.json'), bytes=3057,
                    sha256='2ff31d90350eea57e1bcebbf719adff464e179ffbbc9d3107f42da6089de77ab')
PRIOR_FINAL = dict(path=str(R/'WORK/resume-20261017-001/m3_prewrite_validation_012/ROOT_I9_RECORDED_M3_SEMANTICS_AND_MANAGED_PUBLICATION_FINAL_OUTCOME_001.json'), bytes=444278,
                   sha256='94cace6d5749641f6c37956a15a3f5fdfe7ab5f7c4a5786c0c482ed9c667c985')
PRIOR_SCOPE = dict(path=str(R/'WORK/resume-20261017-001/m3_prewrite_validation_012/managed_preparation_001/candidates_001/EXACT_MANAGED_I9_RECORDED_M3_SEMANTICS_PUBLICATION_SCOPE_001.json'), bytes=369755,
                   sha256='6e5ff618921c455eba8a2387df55e7121c21231245541a0f7e0d42ef88752180')
SOURCE_ADOPTION = O/'ROOT_I10_SOURCE_DIFFERENT_REVIEW_ADOPTION_001.json'
RESULTS_ADOPTION = O/'ROOT_I10_RESULTS_DIFFERENT_REVIEW_ADOPTION_001.json'
PUBLICATION_ADOPTION = O/'ROOT_I10_PUBLICATION_DIFFERENT_REVIEW_ADOPTION_001.json'
TARGET_SOURCE = dict(path=str(O/'i2/build_M3_metadata_current_owner_deferred_003.py'), bytes=128160,
                     sha256='831d4ff98b04faeecd53361ecb5cd8a75dd2ac455907b7c426a093c68ea30f7e')
FIXTURE_SOURCE = dict(path=str(O/'i2/test_phase_successor_basename_memory_only_001.py'), bytes=33139,
                      sha256='bc9867c4235f2530db0383c07f39e67669dae7abd0506bf0191926c474fb3c46')
calls = []
step = None
scopepin = None
resource_checks = []


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')


def digest(body):
    return hashlib.sha256(body).hexdigest()


def wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False)+'\n').encode('utf-8')


def no_duplicates(items):
    result = {}
    for key, value in items:
        assert key not in result, 'duplicate JSON key'
        result[key] = value
    return result


def decode(body):
    return json.loads(body, object_pairs_hook=no_duplicates,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


def ordinary(path):
    path = pathlib.Path(path)
    assert path.is_absolute() and '..' not in path.parts
    for item in (path, *path.parents):
        if item.exists() or item.is_symlink():
            info = item.lstat()
            assert not stat.S_ISLNK(info.st_mode) and not (getattr(info, 'st_file_attributes', 0)&0x400), str(item)
    return path


def read(path, cap=CAP):
    path = ordinary(path)
    assert type(cap) is int and cap > 0 and path.is_file() and path.stat().st_size <= cap
    with path.open('rb') as handle:
        body = handle.read(cap+1)
    assert len(body) <= cap
    return body


def fact(path, body=None):
    path = pathlib.Path(path)
    if body is None:
        body = read(path)
    return dict(path=str(path), bytes=len(body), sha256=digest(body))


def pinned(value, path=None, cap=CAP):
    assert type(value) is dict and set(value) == {'path', 'bytes', 'sha256'}
    assert type(value['bytes']) is int and 0 <= value['bytes'] <= cap
    assert type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}', value['sha256'])
    body = read(path or value['path'], cap)
    assert len(body) == value['bytes'] and digest(body) == value['sha256'], str(path or value['path'])
    return body


def authority():
    value = decode(pinned(SOURCE_SCOPE))
    current = datetime.datetime.now(datetime.timezone.utc)
    assert datetime.datetime.fromisoformat(value['interval_start']) <= current
    assert current+datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(value['interval_end'])
    assert value['author'] == '/root' and value['publication_reserve_seconds'] == 60
    assert value['window_is_Source_scheduling_only_not_owner_or_execution_lease'] is True
    assert value['Pro3_coordination_required'] is False
    assert value['old_I0_through_I9_changes_or_invocations_authorized'] is False
    assert value['actual_selected_family_Source_publication_authorized'] is False
    assert value['managed_base_HEAD'] == BASE and value['target_execution'] is False
    return value


def resources():
    class Memory(ctypes.Structure):
        _fields_ = [('length', ctypes.c_ulong), ('load', ctypes.c_ulong),
                    *[(name, ctypes.c_ulonglong) for name in ('total', 'available', 'page_total', 'page_available',
                                                            'virtual_total', 'virtual_available', 'extended')]]
    start = time.monotonic()
    state = Memory()
    state.length = ctypes.sizeof(state)
    assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(state)) != 0
    disk = shutil.disk_usage(G).free
    assert time.monotonic()-start <= 60 and state.available >= 1073741824 and disk >= 10737418240
    result = dict(observed_utc=now(), available_RAM_bytes=int(state.available), disk_free_bytes=int(disk),
                  maximum_age_seconds=60, RAM_floor_bytes=1073741824, disk_floor_bytes=10737418240)
    return result


def gate():
    authority()
    result = resources()
    assert datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(result['observed_utc']) <= datetime.timedelta(seconds=60)
    if len(resource_checks) < 4096:
        resource_checks.append(result)
    else:
        raise RuntimeError('finite resource observation budget')
    return result


def put_new(path, body, mutation=True):
    path = ordinary(path)
    assert path.resolve().is_relative_to(O.resolve()) and type(body) is bytes and len(body) <= CAP
    assert not path.exists()
    if mutation:
        gate()
    path.parent.mkdir(parents=True, exist_ok=True)
    ordinary(path.parent)
    with path.open('xb') as handle:
        assert handle.write(body) == len(body)
        handle.flush()
        os.fsync(handle.fileno())
    assert read(path) == body
    return fact(path, body)


def save(name, value, failure=False):
    assert type(name) is str and pathlib.Path(name).name == name
    record = dict(schema_version=1, author='/root', created_utc=now(), **value)
    return put_new(O/name, wire(record), mutation=not failure)


def refuse_timeouts():
    assert not list(O.glob('ROOT_I10_OWNED_GIT_TIMEOUT_REFUSAL_*_001.json')), (
        'Saved owned Git timeout blocks every further mutation; independently reconcile unknown effects before a reviewed successor')


def git(arguments, allowed=(0,), mutation=False):
    assert type(arguments) is list and arguments and all(type(value) is str for value in arguments)
    if mutation:
        refuse_timeouts()
        gate()
    argv = [GIT, '-c', 'core.autocrlf=false', '-c', 'core.safecrlf=false', *arguments]
    assert len(subprocess.list2cmdline(argv)) < 30000
    started = now()
    process = subprocess.Popen(argv, cwd=G, env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               creationflags=subprocess.CREATE_NO_WINDOW)
    try:
        out, err = process.communicate(timeout=60)
    except subprocess.TimeoutExpired as timeout:
        cleanup_started = time.monotonic()
        out, err = timeout.output or b'', timeout.stderr or b''
        kill_error = None
        drained = False
        if process.poll() is None:
            try:
                process.kill()
            except BaseException as error:
                kill_error = type(error).__name__+': '+str(error)
        try:
            out, err = process.communicate(timeout=max(0, 5-(time.monotonic()-cleanup_started)))
            drained = True
        except subprocess.TimeoutExpired as cleanup:
            out, err = cleanup.output or out, cleanup.stderr or err
        code = process.poll()
        def capture(body):
            return dict(observed_bytes=len(body), saved_prefix_bytes=min(len(body), CAP),
                        saved_prefix_sha256=digest(body[:CAP]), overcap=len(body) > CAP)
        calls.append(dict(argv=argv, cwd=str(G), owned_process_PID=process.pid, started_utc=started,
                          completed_utc=now(), timed_out=True, owned_child_exit_code=code,
                          owned_exact_child_reaped=code is not None, owned_exact_child_kill_error=kill_error,
                          streams_drained=drained, stdout=capture(out), stderr=capture(err),
                          descendant_or_whole_Job_cleanup_verified=False, effects_after_timeout='UNKNOWN',
                          automatic_retry_authorized=False))
        save('ROOT_I10_OWNED_GIT_TIMEOUT_REFUSAL_'+step.upper()+'_001.json',
             dict(record_type='Root_I10_owned_Git_timeout_refusal', mode=step, scope=scopepin,
                  timeout_seconds=60, shared_owned_child_cleanup_seconds=5, actual_Git_calls=calls,
                  requires_independent_read_only_effect_reconciliation=True, all_further_mutation_blocked=True,
                  original_project_target_execution=False, operational_authority=False, scientific_authority=False), failure=True)
        raise RuntimeError('Owned Git timed out; effects unknown, scope not retried') from timeout
    calls.append(dict(argv=argv, cwd=str(G), owned_process_PID=process.pid, started_utc=started, completed_utc=now(),
                      exit_code=process.returncode, timed_out=False, owned_exact_child_reaped=True, streams_drained=True,
                      stdout_bytes=len(out), stdout_sha256=digest(out), stderr_bytes=len(err), stderr_sha256=digest(err),
                      stdout=out.decode('utf-8', errors='replace') if arguments[0] != 'show' and len(out) <= 16384 else None,
                      stderr=err.decode('utf-8', errors='replace') if len(err) <= 16384 else None,
                      native_Job_or_whole_host_proof=False))
    assert len(out) <= CAP and len(err) <= CAP, 'finite Git output cap exceeded'
    assert process.returncode in allowed, calls[-1]
    return out


def adoption(path, phase):
    value_pin = fact(path)
    value = decode(pinned(value_pin))
    assert value['author'] == '/root' and value['phase'] == phase
    assert value['verdict'] == 'ACCEPT_I10_'+phase+'_LIMITED_SOURCE_AND_SYNTHETIC_KERNEL_ONLY'
    assert value['target_execution'] is False and value['tests_executed'] is False
    assert value['source_scope'] == SOURCE_SCOPE and value['all_actual_review_inputs_rehashed'] is True
    assert value['actual_I2_producer_or_I0_I1_entry_qualified'] is False
    assert value['external_canonical_receipt_ABI_qualified'] is False
    assert type(value['subjects']) is list and value['subjects']
    for subject in value['subjects']:
        pinned(subject)
    return value_pin, value


def qualification():
    source_pin, source = adoption(SOURCE_ADOPTION, 'SOURCE')
    result_pin, results = adoption(RESULTS_ADOPTION, 'RESULTS')
    for subject in (TARGET_SOURCE, FIXTURE_SOURCE):
        pinned(subject)
        assert subject in source['subjects']
    assert source_pin in results['subjects']
    child_pin = fact(O/'ROOT_I10_ACTUAL_PURE_KERNEL_CHILD_RESULT_001.json')
    supervisor_pin = fact(O/'ROOT_I10_ACTUAL_PURE_KERNEL_SUPERVISOR_RESULT_001.json')
    child = decode(pinned(child_pin))
    supervisor = decode(pinned(supervisor_pin))
    assert child_pin in results['subjects'] and supervisor_pin in results['subjects']
    assert child['record_type'] == 'Root_I10_actual_pure_AST_kernel_child_result'
    assert child['Source'] == TARGET_SOURCE and child['fixture'] == FIXTURE_SOURCE
    assert child['all_cases_passed'] is True and type(child['actual_case_count']) is int and child['actual_case_count'] == 134
    assert child['audit_blocked_events'] == [] and child['error'] is None and child['tests_executed'] is True
    assert child['original_I2_import_call_or_entry'] is False and child['only_two_new_successor_AST_kernel_functions_executed'] is True
    counts = child['kernel_function_calls']
    assert set(counts) == {'need', 'require_phase_successor_basename'} and all(type(number) is int and number > 0 for number in counts.values())
    fixture_tree = ast.parse(pinned(FIXTURE_SOURCE))
    name_rows = [ast.literal_eval(node.value) for node in fixture_tree.body if isinstance(node, ast.Assign)
                 and any(isinstance(target, ast.Name) and target.id == 'CASE_NAMES' for target in node.targets)]
    assert len(name_rows) == 1 and type(name_rows[0]) is tuple and len(name_rows[0]) == len(set(name_rows[0])) == 134
    cases = child['cases']
    assert type(cases) is list and len(cases) == 134
    assert all(type(row) is dict and set(row) == {'name', 'passed'} and type(row['name']) is str and row['passed'] is True for row in cases)
    assert tuple(row['name'] for row in cases) == name_rows[0]
    assert supervisor['all_cases_passed'] is True and supervisor['owned_child_exit_code'] == 0
    assert supervisor['timed_out'] is False and supervisor['owned_child_reaped'] is True and supervisor['streams_drained'] is True
    assert supervisor['cleanup_error'] is None and supervisor['failure'] is None and supervisor['streams_overcap'] is False
    assert supervisor['child_result'] == child_pin and supervisor['scope'] == child['scope']
    assert supervisor['scope_spent'] is True and supervisor['automatic_retry_authorized'] is False
    stdout_pin, stderr_pin = supervisor['stdout'], supervisor['stderr']
    assert stdout_pin in results['subjects'] and stderr_pin in results['subjects']
    assert decode(pinned(stdout_pin)) == child and pinned(stderr_pin) == b''
    api = decode(read(O/'i2/CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_003.json'))
    assert api['Source'] == TARGET_SOURCE and api['external_canonical_receipt_ABI_qualified'] is False
    return dict(Source_adoption=source_pin, results_adoption=result_pin, child_result=child_pin,
                supervisor_result=supervisor_pin, Source=TARGET_SOURCE, fixture=FIXTURE_SOURCE,
                actual_case_count=134, all_cases_passed=True, pure_kernel_test_runs=1,
                full_I2_import_or_entry=False, external_canonical_receipt_ABI_qualified=False)


def prior_state():
    final = decode(pinned(PRIOR_FINAL))
    prior = decode(pinned(PRIOR_SCOPE))
    assert final['HEAD'] == final['remote_main'] == BASE and final['normal_fast_forward_push_completed'] is True
    assert final['scope'] == PRIOR_SCOPE and len(prior['files']) == prior['managed_file_count'] == 533
    assert prior['preexisting608_byte_baseline']['sha256'] == '315cce6ac373b917213cd13e4f4059200b94de7cadb1f0b7bd9b501f9b745c44'
    assert len(prior['all_prior_I6_I7_I8_non_navigation_file_pins']) == 342
    assert len(prior['all_frozen_STEP080_sentinels']) == 8
    return prior


def preserve(prior, scope=None):
    baseline = decode(pinned(prior['preexisting608_byte_baseline']))
    historical = baseline['all_preexisting_file_bytes']
    assert len(historical) == 608
    for row in historical:
        size = row['bytes']
        if size > CAP:
            assert size == 3483233 and row['sha256'] == 'e646afc11642d8df66cf7ef0aff26474ce45eaec23d08ecd16f17eaedae2b0e9'
            assert row['path'] == 'docs/development/closeout-evidence/root-docs-independent-major036/INDEPENDENT_MAJOR036_CREATION_REVIEW_001.json'
        pinned(row, path=G/row['path'], cap=max(1, size))
    for row in prior['all_prior_I6_I7_I8_non_navigation_file_pins']:
        pinned(row)
    for row in prior['all_frozen_STEP080_sentinels']:
        pinned(row['actual_current_pin'])
    source_baseline = decode(pinned(prior['current36_Source_baseline']))
    assert source_baseline['actual_present'] == 36 and len(source_baseline['current_45_identity_rows']) == 45
    present = absent = 0
    for row in source_baseline['current_45_identity_rows']:
        if row['canonical'] is not None:
            pinned(row['canonical'])
            present += 1
        else:
            assert not pathlib.Path(row['canonical_path']).exists()
            absent += 1
    assert (present, absent) == (36, 9)
    successor_nav = {} if scope is None else {row['managed_path']:row for row in scope['files'] if row['mode'] == 'prepend'}
    for row in prior['files']:
        name = row['managed_path']
        actual = read(G/name)
        previous = pinned(row['source'])
        if name in NAV and actual != previous:
            successor = successor_nav[name]
            assert actual == pinned(successor['source'])
            assert actual[successor['prefix_bytes']:] == previous == pinned(successor['saved_predecessor'])
        else:
            assert actual == previous
    return dict(checked_utc=now(), all608_historical_whole_bytes_exact=True,
                historical_total_bytes=sum(row['bytes'] for row in historical),
                all342_prior_I6_I7_I8_non_navigation_bytes_exact=True, all8_STEP080_sentinels_exact=True,
                all36_current_Source_bytes_exact=True, all9_pending_canonical_paths_absent=True,
                all533_prior_I9_files_preserved_except_exact_navigation_prepends=True,
                all75_spent_identities_replay_not_authorized=True)


def main_branch():
    assert git(['symbolic-ref', 'HEAD']).decode().strip() == 'refs/heads/main'
    remote = git(['remote', 'get-url', '--push', 'origin']).decode().strip().rstrip('/').removesuffix('.git')
    assert remote == REMOTE
    assert not git(['config', '--get', 'core.hooksPath'], allowed=(0, 1)).strip()
    hook_directory = ordinary(G/'.git/hooks')
    assert hook_directory.is_dir() and not any(path.is_file() and not path.name.endswith('.sample') for path in hook_directory.iterdir())


def base_empty():
    main_branch()
    assert git(['rev-parse', 'HEAD']).decode().strip() == BASE
    assert git(['diff', '--cached', '--name-only']) == b''


def validate_rows(scope):
    assert scope['record_type'] == 'Root_I10_exact_finite_inert_managed_publication_scope' and scope['base_HEAD'] == BASE
    assert scope['source_scope'] == SOURCE_SCOPE and scope['publisher_Source'] == fact(SELF)
    assert scope['prior_I9_scope'] == PRIOR_SCOPE and scope['prior_I9_final_outcome'] == PRIOR_FINAL
    assert scope['original_project_target_execution'] is False and scope['actual_selected_family_Source_publication'] is False
    rows = scope['files']
    assert type(rows) is list and len(rows) == scope['managed_file_count']
    names = [row['managed_path'] for row in rows]
    assert names == sorted(names) and len(set(name.casefold() for name in names)) == len(names)
    assert sorted(row['managed_path'] for row in rows if row['mode'] == 'prepend') == sorted(NAV)
    for row in rows:
        name = row['managed_path']
        assert name in NAV or name.startswith(REL)
        assert '\\' not in name and '..' not in pathlib.PurePosixPath(name).parts
        assert not name.lower().endswith(('.py', '.ps1', '.exe', '.dll', '.cmd', '.bat'))
        assert row['mode'] in ('create', 'prepend')
        if row['mode'] == 'create':
            assert name.startswith(REL)
        candidate = pathlib.Path(row['source']['path'])
        assert candidate.resolve().is_relative_to(C.resolve())
        pinned(row['source'])
        if row['mode'] == 'prepend':
            assert type(row['prefix_bytes']) is int and row['prefix_bytes'] > 0
            assert pinned(row['source'])[row['prefix_bytes']:] == pinned(row['saved_predecessor'])
    return rows, names


def copies(scope):
    rows, names = validate_rows(scope)
    for row in rows:
        body = pinned(row['source'], path=G/row['managed_path'])
        if row['mode'] == 'prepend':
            assert body[row['prefix_bytes']:] == pinned(row['saved_predecessor'])
    return dict(all_managed_copy_whole_bytes_exact=True, file_count=len(names), all3_prior_navigation_suffixes_exact=True)


def exact_index(scope):
    rows, names = validate_rows(scope)
    observed = git(['diff', '--cached', '--name-only', '-z']).decode().split('\0')
    assert observed[-1] == '' and sorted(observed[:-1]) == names
    statuses = git(['diff', '--cached', '--name-status', '--no-renames', '-z']).decode().split('\0')
    assert statuses[-1] == ''
    statuses = statuses[:-1]
    assert len(statuses) == 2*len(rows)
    assert {statuses[index+1]:statuses[index] for index in range(0, len(statuses), 2)} == {
        row['managed_path']:('A' if row['mode'] == 'create' else 'M') for row in rows}
    for row in rows:
        body = git(['show', ':'+row['managed_path']])
        assert len(body) == row['source']['bytes'] and digest(body) == row['source']['sha256']
    return dict(exact_names_statuses_and_all_staged_blob_bytes=True, file_count=len(names),
                preserved_mixed_bytes_not_normalized=True, generic_whitespace_check_not_used=True)


def committed(scope, head):
    rows, names = validate_rows(scope)
    assert git(['rev-parse', 'HEAD']).decode().strip() == head
    parents = git(['rev-list', '--parents', '-n', '1', head]).decode().split()
    assert parents == [head, BASE]
    changed = git(['diff-tree', '--no-commit-id', '--name-only', '--no-renames', '-r', '-z', head]).decode().split('\0')
    assert changed[-1] == '' and sorted(changed[:-1]) == names
    assert git(['diff', '--cached', '--name-only']) == b''
    for row in rows:
        body = git(['show', head+':'+row['managed_path']])
        assert len(body) == row['source']['bytes'] and digest(body) == row['source']['sha256']
    return dict(exact_committed_names_and_all_blob_bytes=True, single_parent=BASE, empty_index=True, file_count=len(names))


def prepare():
    assert not P.exists(), 'No preparation replay or replacement'
    authority()
    refuse_timeouts()
    qualified = qualification()
    prior = prior_state()
    base_empty()
    assert git(['ls-remote', 'origin', 'refs/heads/main']).decode().split()[0] == BASE
    preservation = preserve(prior)
    sources = []
    for path in sorted(O.rglob('*'), key=lambda value: str(value)):
        relative = path.relative_to(O)
        if relative.parts[0] in ('managed_preparation_001', 'managed_review_001'):
            continue
        ordinary(path)
        if path.is_file():
            assert path.suffix.lower() in ('.py', '.ps1', '.json', '.txt', '.md', '.source', '.log', '.patch')
            sources.append(fact(path))
    assert sources and fact(SELF) in sources and qualified['Source_adoption'] in sources and qualified['results_adoption'] in sources
    assert fact(O/'ROOT_I10_PROTOCOL001_REFUSAL_AND_FACTUAL_CORRECTION_ADOPTION_001.json') in sources
    gate()
    P.mkdir()
    rows = []
    index_rows = []
    for source in sources:
        relative = pathlib.Path(source['path']).relative_to(O).as_posix()
        inert = relative+'.source' if pathlib.PurePosixPath(relative).suffix.lower() in ('.py', '.ps1') else relative
        name = REL+inert
        candidate = C/name
        candidate_pin = put_new(candidate, pinned(source))
        rows.append(dict(managed_path=name, mode='create', source=candidate_pin))
        index_rows.append(dict(original_source=source, candidate=candidate_pin, managed_path=name,
                               exact_original_bytes_preserved=True, executable_entry=False))
    index = dict(schema_version=1, record_type='I10_finite_inert_development_evidence_index', author='/root', created_utc=now(),
                 original_subtree=str(O), excluded_output_subtrees=['managed_preparation_001', 'managed_review_001'],
                 files=index_rows, original_file_count=len(sources), qualification=qualified,
                 programs_published_as_inert_Source=True, absolute_paths_are_dated_provenance=True,
                 target_execution=False, operational_authority=False, scientific_authority=False)
    index_pin = put_new(C/(REL+'evidence-index.json'), wire(index))
    rows.append(dict(managed_path=REL+'evidence-index.json', mode='create', source=index_pin))
    report = '''# Inherited M3 phase basename qualification

The new pure phase basename predicate passed 134/134 cases in one separately scoped memory run. Only the two reviewed AST kernel functions `need` and `require_phase_successor_basename` were executed; the complete I2 module, its selection routine, renderers and CLI were not imported or invoked. [Root Source adoption](ROOT_I10_SOURCE_DIFFERENT_REVIEW_ADOPTION_001.json), [saved-results adoption](ROOT_I10_RESULTS_DIFFERENT_REVIEW_ADOPTION_001.json) and the [evidence index](evidence-index.json) retain exact Source, fixture, runner, review and result pins.

The successor preserves authentic inherited `.TEMPLATE.ps1` and `.BOUND.ps1` names and changes only their selected three-digit ordinal. It authenticates the expected leaf against the current selection's prior canonical leaf and ordinal, retaining the strict later ordinal above018 and below1000. All68 other pre-existing functions remain byte exact; the selection function changes only its phase-name branch. The complete predecessor Source/API bytes and exact reverse edits are preserved. Both current Source editor constants identify the actual new author, separately from historical semantic provenance.

The earlier I1 expiry hypothesis was refused. PowerShell date conversion had displayed local offsets; direct raw Python JSON verification found all four pinned expiry strings already used compatible `+00:00`. No I1 Source changed, no I1 target ran, and no actual historical-expiry failure is claimed. The refused hypothesis, failed Source-author newline assumption and all later controls remain saved history.

This qualifies the narrow basename predicate and Source successor only. The external canonical receipt ABI flag remains false. Whole I2 producer execution, I1 lease entry, actual I7/I8/I9 caller and physical IO composition, real family publication, Native8, Parser, runtime and scientific execution remain unqualified. No lease, future family, canonical role or execution authority was issued.

The dated Source family remains36/45 with nine pending; frozen STEP080 remains35/45 with ten pending. All75 spent identities, original caps, clocks and reserves remain preserved. All608 historical bytes,342 I6-I8 files,533 prior I9 paths with complete navigation suffixes, eight frozen sentinels and36 current Sources remain exact.

Program copies use inert `.source` suffixes. Absolute paths are dated provenance. Later Root receipts and normal Git history record the finite documentation commit and push.
'''.encode('utf-8')
    report_pin = put_new(C/(REL+'I10_PHASE_BASENAME_QUALIFICATION.md'), report)
    rows.append(dict(managed_path=REL+'I10_PHASE_BASENAME_QUALIFICATION.md', mode='create', source=report_pin))
    prefix = ("**October17 I10 inherited M3 phase naming qualified.** The [phase basename checkpoint]("+REL+
              "I10_PHASE_BASENAME_QUALIFICATION.md) records134 passing pure AST kernel cases and the reviewed I2 Source successor. "
              "Whole producer/caller integration and the external canonical receipt ABI remain held; Native8, Parser, runtime and science remain unqualified. "
              "The I1 expiry hypothesis was refused; I1 is unchanged. Source remains36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode('utf-8')
    for name in NAV:
        previous = fact(G/name)
        predecessor = put_new(P/'predecessors'/name, pinned(previous))
        candidate = put_new(C/name, prefix+pinned(previous))
        rows.append(dict(managed_path=name, mode='prepend', source=candidate, predecessor=previous,
                         saved_predecessor=predecessor, prefix_bytes=len(prefix)))
    rows.sort(key=lambda row: row['managed_path'])
    scope = dict(schema_version=1, author='/root', created_utc=now(),
                 record_type='Root_I10_exact_finite_inert_managed_publication_scope', base_HEAD=BASE,
                 publisher_Source=fact(SELF), source_scope=SOURCE_SCOPE, prior_I9_scope=PRIOR_SCOPE, prior_I9_final_outcome=PRIOR_FINAL,
                 Root_Source_adoption=qualified['Source_adoption'], Root_results_adoption=qualified['results_adoption'],
                 qualification=qualified, candidate_sources=sources, files=rows, managed_file_count=len(rows),
                 new_file_count=len(rows)-3, navigation_prepend_count=3, evidence_index=index_pin, report=report_pin,
                 preexisting608_byte_baseline=prior['preexisting608_byte_baseline'],
                 all_prior_I6_I7_I8_non_navigation_file_pins=prior['all_prior_I6_I7_I8_non_navigation_file_pins'],
                 all_frozen_STEP080_sentinels=prior['all_frozen_STEP080_sentinels'], current36_Source_baseline=prior['current36_Source_baseline'],
                 preservation=preservation, current_dated_Source_present=36, current_dated_pending=9,
                 frozen_STEP080_present=35, frozen_STEP080_pending=10, actual_selected_family_Source_publication=False,
                 actual_case_count=134, original_project_target_execution=False, target_execution=False, tests_executed=False,
                 operational_authority=False, scientific_authority=False)
    validate_rows(scope)
    for source in sources:
        pinned(source)
    assert preserve(prior)['all533_prior_I9_files_preserved_except_exact_navigation_prepends'] is True
    scope_bytes = wire(scope)
    result = put_new(SCOPE_PATH, scope_bytes)
    print(json.dumps(result))


def public_admission(scope, public_hash):
    public_pin, public = adoption(PUBLICATION_ADOPTION, 'PUBLICATION')
    assert public_pin['sha256'] == public_hash
    assert scopepin in public['subjects'] and fact(SELF) in public['subjects']
    assert scope['Root_results_adoption'] in public['subjects']
    assert scope['Root_Source_adoption'] == fact(SOURCE_ADOPTION) and scope['Root_results_adoption'] == fact(RESULTS_ADOPTION)
    for source in scope['candidate_sources']:
        pinned(source)
    assert qualification() == scope['qualification']
    return public_pin


def receipt_common(scope, public_pin, prior):
    return dict(scope=scopepin, publisher_Source=fact(SELF), Root_publication_review_adoption=public_pin,
                Root_Source_adoption=scope['Root_Source_adoption'], Root_results_adoption=scope['Root_results_adoption'],
                readback=copies(scope), preservation=preserve(prior, scope), actual_Git_calls=calls,
                resource_observations=resource_checks, actual_pure_kernel_case_count=134, actual_pure_kernel_cases_passed=134,
                pure_kernel_test_runs=1, original_project_target_execution=False, original_tests_executed=False,
                full_I2_producer_import_call_or_entry=False, external_canonical_receipt_ABI_qualified=False,
                actual_caller_or_real_family_publication_admission=False, native_Parser_runtime_scientific_execution=False,
                new_lease_family_grants_paths_ordinals_native_Parser_results=None, operational_authority=False, scientific_authority=False)


def mutate(scope_hash, public_hash):
    global scopepin
    scopepin = fact(SCOPE_PATH)
    assert scopepin['sha256'] == scope_hash
    scope = decode(pinned(scopepin))
    rows, names = validate_rows(scope)
    refuse_timeouts()
    authority()
    public_pin = public_admission(scope, public_hash)
    prior = prior_state()
    main_branch()
    if step == 'copy':
        base_empty()
        assert git(['ls-remote', 'origin', 'refs/heads/main']).decode().split()[0] == BASE
        for row in rows:
            path = ordinary(G/row['managed_path'])
            assert path.resolve().is_relative_to(G.resolve())
            if row['mode'] == 'create':
                assert not path.exists()
            else:
                assert pinned(row['predecessor']) == pinned(row['saved_predecessor'])
                assert not path.with_name(path.name+'.i10-prepend001').exists()
        preserve(prior)
        for row in rows:
            body = pinned(row['source'])
            path = ordinary(G/row['managed_path'])
            gate()
            path.parent.mkdir(parents=True, exist_ok=True)
            ordinary(path.parent)
            if row['mode'] == 'create':
                with path.open('xb') as handle:
                    assert handle.write(body) == len(body)
                    handle.flush()
                    os.fsync(handle.fileno())
            else:
                pinned(row['predecessor'])
                temporary = path.with_name(path.name+'.i10-prepend001')
                with temporary.open('xb') as handle:
                    assert handle.write(body) == len(body)
                    handle.flush()
                    os.fsync(handle.fileno())
                assert read(temporary) == body
                pinned(row['predecessor'])
                gate()
                os.replace(temporary, path)
        print(json.dumps(save('ROOT_I10_ACTUAL_MANAGED_COPY_READBACK_RECEIPT_001.json',
                              dict(record_type='Root_I10_actual_finite_managed_copy', **receipt_common(scope, public_pin, prior)))))
    elif step == 'stage':
        base_empty()
        assert decode(read(O/'ROOT_I10_ACTUAL_MANAGED_COPY_READBACK_RECEIPT_001.json'))['scope'] == scopepin
        copies(scope)
        preserve(prior, scope)
        for offset in range(0, len(names), 64):
            git(['add', '--', *names[offset:offset+64]], mutation=True)
        index = exact_index(scope)
        print(json.dumps(save('ROOT_I10_ACTUAL_GIT_STAGING_RECEIPT_001.json',
                              dict(record_type='Root_I10_actual_finite_exact_staging', exact_index=index,
                                   **receipt_common(scope, public_pin, prior)))))
    elif step == 'commit':
        assert git(['rev-parse', 'HEAD']).decode().strip() == BASE
        assert decode(read(O/'ROOT_I10_ACTUAL_GIT_STAGING_RECEIPT_001.json'))['scope'] == scopepin
        exact_index(scope)
        copies(scope)
        preserve(prior, scope)
        git(['commit', '-m', 'Correct inherited M3 phase selection names'], mutation=True)
        head = git(['rev-parse', 'HEAD']).decode().strip()
        assert re.fullmatch('[0-9a-f]{40}', head) and head != BASE
        verification = committed(scope, head)
        print(json.dumps(save('ROOT_I10_ACTUAL_GIT_COMMIT_RECEIPT_001.json',
                              dict(record_type='Root_I10_actual_finite_exact_commit', HEAD=head, parent=BASE,
                                   exact_changed_paths=names, committed=verification, remote_push_completed=False,
                                   **receipt_common(scope, public_pin, prior)))))
    elif step == 'push':
        commit_pin = fact(O/'ROOT_I10_ACTUAL_GIT_COMMIT_RECEIPT_001.json')
        commit = decode(pinned(commit_pin))
        assert commit['scope'] == scopepin and commit['parent'] == BASE and commit['Root_publication_review_adoption'] == public_pin
        head = commit['HEAD']
        committed(scope, head)
        copies(scope)
        preserve(prior, scope)
        assert git(['ls-remote', 'origin', 'refs/heads/main']).decode().split()[0] == BASE
        git(['push', 'origin', 'HEAD:main'], mutation=True)
        assert git(['ls-remote', 'origin', 'refs/heads/main']).decode().split()[0] == head
        assert git(['rev-parse', 'refs/remotes/origin/main']).decode().strip() == head
        verification = committed(scope, head)
        print(json.dumps(save('ROOT_I10_PHASE_BASENAME_AND_MANAGED_PUBLICATION_FINAL_OUTCOME_001.json',
                              dict(record_type='Root_I10_actual_phase_basename_and_finite_managed_publication_final_outcome',
                                   HEAD=head, parent=BASE, remote_main=head, normal_fast_forward_push_completed=True,
                                   local_remote_tracking_parity=True, actual_published_path_count=len(rows), new_file_count=len(rows)-3,
                                   prior_navigation_full_suffixes=3, all_committed_blob_bytes_rechecked=True, committed=verification,
                                   commit_receipt=commit_pin, I10_phase_basename_and_docs_stage_complete=True,
                                   I1_expiry_hypothesis_refused_no_I1_changes=True, current_dated_Source_paths_present=36,
                                   current_dated_pending=9, frozen_STEP080_present=35, frozen_STEP080_pending=10,
                                   next='Qualify the remaining I2 external canonical receipt ABI and actual producer/caller composition before real publication; Native8, Parser, runtime and scientific execution remain held.',
                                   **receipt_common(scope, public_pin, prior)))))
    else:
        raise AssertionError(step)


def main():
    global step
    assert pathlib.Path(__file__).resolve() == SELF.resolve()
    assert sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.dont_write_bytecode
    assert len(sys.argv) >= 2
    step = sys.argv[1]
    assert step in ('prepare', 'copy', 'stage', 'commit', 'push')
    if step == 'prepare':
        assert len(sys.argv) == 2
        prepare()
    else:
        assert len(sys.argv) == 4 and all(re.fullmatch('[0-9a-f]{64}', value) for value in sys.argv[2:])
        mutate(sys.argv[2], sys.argv[3])


if __name__ == '__main__':
    main()
