def independent_contract_oracle(arguments):
    role,canonical,previous,old,new = arguments
    if type(role) is not str or role not in phase_roles or type(canonical) is not str or type(previous) is not str:
        return False
    if type(old) is not int or type(new) is not int or not 0 < old < new < 1000 or new <= 18:
        return False
    # Independent ASCII maximal-digit-run scan. I8's regex selects each run's final3
    # digits, including longer runs; this reproduces that declared grammar as data.
    positions = []
    start = 0
    while start < len(previous):
        if not '0' <= previous[start] <= '9':
            start += 1
            continue
        end = start
        while end < len(previous) and '0' <= previous[end] <= '9':
            end += 1
        if end-start >= 3 and int(previous[end-3:end]) == old:
            positions.append((end-3,end))
        start = end
    if len(positions) != 1:
        return False
    a,b = positions[0]
    expected = previous[:a]+format(new,'03d')+previous[b:]
    suffix = '.TEMPLATE.ps1' if role in new_literals['TEMPLATE_ROLES'][1:] else '.BOUND.ps1'
    return canonical == expected and canonical[-len(suffix):] == suffix

