HERE = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013\source_review_001')
P = HERE.parent
EDITOR = '/root/i10_caller_frontier'
REVIEWER = '/root/i10_producer_frontier'
CAP = 2097152
INPUTS, CHECKS = {}, []

def check(name, passed):
    assert type(name) is str and name and all(row['name'] != name for row in CHECKS)
    assert type(passed) is bool
    CHECKS.append(dict(name=name,passed=passed))

def fact(path,raw):
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def read(path,expected=None):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as h:
        raw = h.read(CAP+1)
    assert len(raw) <= CAP
    f = fact(path,raw)
    if expected is not None:
        assert f == expected, (f,expected)
    assert str(path) not in INPUTS or INPUTS[str(path)] == f
    INPUTS[str(path)] = f
    return raw

def pairs(rows):
    out = {}
    for name,value in rows:
        assert name not in out
        out[name] = value
    return out

def load(raw):
    return json.loads(raw.decode('utf-8'),object_pairs_hook=pairs,
        parse_float=lambda _: (_ for _ in ()).throw(ValueError('float')),
        parse_constant=lambda _: (_ for _ in ()).throw(ValueError('constant')))

def closed_pins(value):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'}:
            yield value
        else:
            for item in value.values():
                yield from closed_pins(item)
    elif type(value) is list:
        for item in value:
            yield from closed_pins(item)

def read_record(path,expected=None):
    value = load(read(path,expected))
    for pin in closed_pins(value):
        read(pin['path'],pin)
    return value

def functions(tree):
    out = {}
    for node in tree.body:
        if isinstance(node,ast.FunctionDef):
            out[node.name] = node
            for nested in ast.walk(node):
                if isinstance(nested,ast.FunctionDef) and nested is not node:
                    out[node.name+'.'+nested.name] = nested
    return out

def assignments(tree,literal=False):
    out = {}
    for node in tree.body:
        if isinstance(node,ast.Assign):
            for target in node.targets:
                if isinstance(target,ast.Name):
                    if literal:
                        try:
                            out[target.id] = ast.literal_eval(node.value)
                        except (ValueError,TypeError):
                            pass
                    else:
                        out[target.id] = node
    return out

def function_bytes(raw,node):
    lines = raw.splitlines(keepends=True)
    return b''.join(lines[node.lineno-1:node.end_lineno])

def save(name,obj):
    raw = (json.dumps(obj,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    assert len(raw) <= CAP
    path = HERE/name
    with path.open('xb') as h:
        h.write(raw)
        h.flush()
        os.fsync(h.fileno())
    assert path.read_bytes() == raw
    return fact(path,raw)

def required_fact(relative,size,digest):
    path = P/relative
    pin = dict(path=str(path),bytes=size,sha256=digest)
    return pin,read(path,pin)

