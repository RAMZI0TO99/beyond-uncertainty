"""Root exact current review adoption. No project target execution."""
import pathlib,json,hashlib,datetime,os,sys
O=pathlib.Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013');CAP=2097152
def read(p):
 p=pathlib.Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as h:b=h.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=read(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pinned(f):
 assert type(f) is dict and set(f)=={'path','bytes','sha256'} and type(f['bytes']) is int
 assert fact(f['path'])==f;return read(f['path'])
phase,cap_path,cap_hash=sys.argv[1:];assert phase in ('SOURCE','RESULTS','PUBLICATION')
cp=fact(cap_path);assert cp['sha256']==cap_hash
c=json.loads(pinned(cp));fullpin=c['full_proof'];full=json.loads(pinned(fullpin))
expected_reviewer='/root/i10_publication_review' if phase=='PUBLICATION' else '/root/i10_producer_frontier'
assert c['reviewer']==full['reviewer']==expected_reviewer
assert type(c['verdict']) is str and c['verdict']==full['verdict'] and c['verdict'].startswith('PASS_')
for x in (c,full):
 assert x['target_execution'] is False and x['tests_executed'] is False
 assert type(x['checks_failed']) is int and x['checks_failed']==0
checks=full['checks'];assert type(checks) is list and checks
assert all(type(k) is dict and type(k['name']) is str and k['passed'] is True for k in checks)
assert len({k['name'] for k in checks})==len(checks)
inputs=full['inputs'];assert type(inputs) is list and inputs
seen={}
for f in inputs:
 pinned(f);assert f['path'] not in seen or seen[f['path']]==f;seen[f['path']]=f
assert len(seen)==len(inputs)
pinned(c['reviewer_Source'])
assert seen.get(c['reviewer_Source']['path'])==c['reviewer_Source']
subjects=c['subjects'];assert type(subjects) is list and subjects
for f in subjects:assert seen.get(f['path'])==f
required=['ROOT_I10_EXACT_I2_PHASE_BASENAME_SUCCESSOR_PROTOCOL_002.json','ROOT_I10_PROTOCOL002_ACTUAL_SOURCE_EDITOR_BINDING_CLARIFICATION_001.json']
required += {
 'SOURCE':['i2/build_M3_metadata_current_owner_deferred_003.py','i2/test_phase_successor_basename_memory_only_001.py','ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_003.py'],
 'RESULTS':['ROOT_I10_ONCE_PURE_KERNEL_SCOPE_001.json','ROOT_I10_ACTUAL_PURE_KERNEL_CHILD_RESULT_001.json','ROOT_I10_ACTUAL_PURE_KERNEL_SUPERVISOR_RESULT_001.json','ROOT_I10_ACTUAL_PURE_KERNEL_STDOUT_001.txt','ROOT_I10_ACTUAL_PURE_KERNEL_STDERR_001.txt','ROOT_I10_SOURCE_DIFFERENT_REVIEW_ADOPTION_001.json'],
 'PUBLICATION':['managed_preparation_001/EXACT_I10_FINITE_MANAGED_PUBLICATION_SCOPE_001.json','ROOT_I10_FINITE_MANAGED_PUBLICATION_001.py','ROOT_I10_RESULTS_DIFFERENT_REVIEW_ADOPTION_001.json']
}[phase]
assert c['review_phase']==full['review_phase']==phase
assert c['record_type']=='Independent_I10_'+phase+'_Source_only_capsule'
assert full['record_type']=='Independent_I10_'+phase+'_Source_only_full_proof'
for name in required:assert fact(O/name) in subjects
if phase=='RESULTS':
 result=json.loads(read(O/'ROOT_I10_ACTUAL_PURE_KERNEL_CHILD_RESULT_001.json'))
 supervisor=json.loads(read(O/'ROOT_I10_ACTUAL_PURE_KERNEL_SUPERVISOR_RESULT_001.json'))
 assert result['all_cases_passed'] is True and result['actual_case_count']>0 and result['audit_blocked_events']==[]
 assert supervisor['all_cases_passed'] is True and supervisor['owned_child_exit_code']==0 and supervisor['timed_out'] is False
 assert supervisor['owned_child_reaped'] is True and supervisor['streams_drained'] is True and supervisor['cleanup_error'] is None

scope=json.loads(read(O/'ROOT_CURRENT_I10_PRODUCER_CALLER_SOURCE_SCOPE_001.json'))
now=datetime.datetime.now(datetime.timezone.utc)
assert now+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(scope['interval_end'])
x=dict(schema_version=1,record_type='Root_I10_actual_different_review_adoption',author='/root',created_utc=now.isoformat(),phase=phase,
 verdict='ACCEPT_I10_'+phase+'_LIMITED_SOURCE_AND_SYNTHETIC_KERNEL_ONLY',capsule=cp,full_proof=fullpin,reviewer_Source=c['reviewer_Source'],subjects=subjects,
 actual_unique_checks_passed=len(checks),actual_input_count=len(inputs),all_actual_review_inputs_rehashed=True,
 source_scope=fact(O/'ROOT_CURRENT_I10_PRODUCER_CALLER_SOURCE_SCOPE_001.json'),target_execution=False,tests_executed=False,
 actual_I2_producer_or_I0_I1_entry_qualified=False,external_canonical_receipt_ABI_qualified=False,
 operational_authority=False,scientific_authority=False)
b=(json.dumps(x,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(b)<=CAP;p=O/('ROOT_I10_'+phase+'_DIFFERENT_REVIEW_ADOPTION_001.json')
with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
print(json.dumps(fact(p)))
