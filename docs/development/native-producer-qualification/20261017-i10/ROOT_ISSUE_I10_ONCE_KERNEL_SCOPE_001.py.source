"""Root fresh one-use kernel scope only after genuine final Source adoption."""
import pathlib,json,hashlib,datetime,os,sys
O=pathlib.Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013')
def fact(p):
 b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
ad=fact(O/'ROOT_I10_SOURCE_DIFFERENT_REVIEW_ADOPTION_001.json');assert ad['sha256']==sys.argv[1]
a=json.loads(pathlib.Path(ad['path']).read_bytes());assert a['phase']=='SOURCE' and a['all_actual_review_inputs_rehashed'] is True
source=fact(O/'i2/build_M3_metadata_current_owner_deferred_003.py');fixture=fact(O/'i2/test_phase_successor_basename_memory_only_001.py');supervisor=fact(O/'ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_003.py')
assert source['sha256']=='831d4ff98b04faeecd53361ecb5cd8a75dd2ac455907b7c426a093c68ea30f7e'
assert fixture['sha256']=='bc9867c4235f2530db0383c07f39e67669dae7abd0506bf0191926c474fb3c46'
assert supervisor['sha256']=='5b09fe00d6ad6f8893f54d51a974f88fd78249f47cad5d4f17861e0d182ac587'
assert all(f in a['subjects'] for f in (source,fixture,supervisor))
now=datetime.datetime.now(datetime.timezone.utc);scope=fact(O/'ROOT_CURRENT_I10_PRODUCER_CALLER_SOURCE_SCOPE_001.json');current=json.loads(pathlib.Path(scope['path']).read_bytes());end=now+datetime.timedelta(minutes=5)
assert end+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(current['interval_end'])
assert not any(O.glob('ROOT_I10_ONCE_KERNEL_CLAIM_*.json'))
x=dict(schema_version=1,record_type='Root_I10_one_use_pure_AST_kernel_scope',author='/root',created_utc=now.isoformat(),ordinal=1,
 interval_start=now.isoformat(),interval_end=end.isoformat(),Source=source,fixture=fixture,supervisor=supervisor,Source_review_adoption=ad,source_scope=scope,
 exact_case_count=134,allowed_AST_definitions=['need','require_phase_successor_basename'],allowed_literal_constants=['TEMPLATE_ROLES','PHASE_BOUND_ROLES'],
 timeout_seconds=60,cleanup_seconds=5,event_cap=1000000,kernel_CHECKS_cap=4096,output_cap=2097152,
 original_I2_full_import_validate_selection_main_IO_or_entry_authorized=False,old_I0_I1_I3_through_I9_invocations_authorized=False,
 all75_spent_and_original_guards_preserved=True,automatic_retry_authorized=False,operational_authority=False,scientific_authority=False)
b=(json.dumps(x,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();p=O/'ROOT_I10_ONCE_PURE_KERNEL_SCOPE_001.json'
with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
print(json.dumps(fact(p)))
