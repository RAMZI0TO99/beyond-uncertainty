import pathlib,json,hashlib,datetime,os
O=pathlib.Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013')
def fact(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def create(name,t):
 p=O/name
 with p.open('xb') as h:h.write(t.encode());h.flush();os.fsync(h.fileno())
 return fact(p)
r=O/'ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_002.py';text=r.read_text(encoding='utf-8');needle='  p=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE,creationflags=subprocess.CREATE_NO_WINDOW)'
assert text.count(needle)==1
text=text.replace(needle,"  age=datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(resource['observed_utc'])\n  assert datetime.timedelta(0)<=age<=datetime.timedelta(seconds=60)\n"+needle)
needle=" except BaseException as e:failure=type(e).__name__+': '+str(e)"
assert text.count(needle)==1
text=text.replace(needle,""" except BaseException as e:
  failure=type(e).__name__+': '+str(e)
  if p is not None and p.poll() is None and not timedout:
   t=time.monotonic()
   try:p.kill()
   except BaseException as k:cleanup_error=type(k).__name__+': '+str(k)
   try:out,err=p.communicate(timeout=max(0,5-(time.monotonic()-t)));drained=True
   except subprocess.TimeoutExpired as k:out=k.output or out;err=k.stderr or err
""")
rp=create('ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_003.py',text)
a=O/'ROOT_ADOPT_I10_DIFFERENT_REVIEW_002.py';text=a.read_text(encoding='utf-8');assert text.count('ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_002.py')==1
ap=create('ROOT_ADOPT_I10_DIFFERENT_REVIEW_003.py',text.replace('ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_002.py','ROOT_I10_ONCE_PURE_KERNEL_SUPERVISOR_003.py'))
hp=create('ROOT_I10_UNRUN_CONTROL_FINAL_RESOURCE_AGE_HISTORY_001.json',json.dumps(dict(schema_version=1,author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),prior_supervisor=fact(r),supervisor=rp,prior_adopter=fact(a),adopter=ap,
 findings=['Enforce actual resource age0..60 seconds immediately before Popen, after claim fsync.','Kill/reap exact owned child within5seconds also on unexpected supervisor exceptions; no repeated cleanup after owned timeout.'],target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False),indent=2,sort_keys=True)+'\n')
print(json.dumps(dict(supervisor=rp,adopter=ap,history=hp)))
