phase_roles = source_values['TEMPLATE_ROLES'][1:]+source_values['PHASE_BOUND_ROLES']

def contract_stage_metadata(arguments):
    role,canonical,previous,old,new = arguments
    predicates = [type(role) is str and role in phase_roles]
    if not predicates[-1]:
        return False,1,0
    predicates.append(type(canonical) is str and type(previous) is str)
    if not predicates[-1]:
        return False,2,1
    predicates.append(type(old) is int and type(new) is int and 0 < old < new < 1000 and new > 18)
    if not predicates[-1]:
        return False,3,2
    positions = []
    cursor = 0
    while cursor < len(previous):
        if not '0' <= previous[cursor] <= '9':
            cursor += 1
            continue
        end = cursor
        while end < len(previous) and '0' <= previous[end] <= '9':
            end += 1
        if end-cursor >= 3 and int(previous[end-3:end]) == old:
            positions.append((end-3,end))
        cursor = end
    if len(positions) != 1:
        return False,4,3
    a,b = positions[0]
    expected = previous[:a]+format(new,'03d')+previous[b:]
    suffix = '.TEMPLATE.ps1' if role in source_values['TEMPLATE_ROLES'][1:] else '.BOUND.ps1'
    if not (canonical == expected and canonical[-len(suffix):] == suffix):
        return False,5,4
    return True,5,5

