fixture_text = '''"""New I10 pure memory fixture Source. No imports, top-level calls or full I2 entry.
Samples are synthetic string arguments; no path denotes an issued future family.
Only the reviewed require_phase_successor_basename and preserved need kernel run later.
"""
CASE_NAMES = '''+repr(case_names)+'\nCASES = '+repr(tuple(cases))+'''

def run_cases(kernel):
    predicate = kernel['require_phase_successor_basename']
    results = []
    for name, arguments, expected in CASES:
        try:
            returned = predicate(*arguments)
        except ValueError:
            accepted = False
        else:
            accepted = returned is None
        results.append({'name':name, 'passed':accepted is expected})
    return results
'''
fixture_raw = fixture_text.encode()
fixture_tree = ast.parse(fixture_raw)
assert len(fixture_tree.body) == 4
assert isinstance(fixture_tree.body[0],ast.Expr) and isinstance(fixture_tree.body[0].value,ast.Constant)
assert all(isinstance(n,ast.Assign) for n in fixture_tree.body[1:3])
assert isinstance(fixture_tree.body[3],ast.FunctionDef) and fixture_tree.body[3].name == 'run_cases'
assert ast.literal_eval(fixture_tree.body[1].value) == case_names
assert ast.literal_eval(fixture_tree.body[2].value) == tuple(cases)
assert not any(isinstance(n,(ast.Import,ast.ImportFrom)) for n in ast.walk(fixture_tree))
