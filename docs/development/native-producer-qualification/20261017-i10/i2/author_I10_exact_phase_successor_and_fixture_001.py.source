def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def pin(path, raw=None):
    if raw is None:
        raw = path.read_bytes()
    return dict(path=str(path), bytes=len(raw), sha256=sha(raw))

def exact(path, count, digest):
    raw = path.read_bytes()
    assert len(raw) == count and sha(raw) == digest, str(path)
    return raw

def wire(value):
    return (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True)+'\n').encode()

def create(path, raw):
    assert path.parent == HERE and not path.exists(), str(path)
    with path.open('xb') as handle:
        assert handle.write(raw) == len(raw)
    assert path.read_bytes() == raw
    return pin(path, raw)

protocol_raw = exact(PROTOCOL, 9740, '6fd15c9a5bf4f0bbcf5b99af33ee0eb245846dae3a1200e830cb697e877be355')
