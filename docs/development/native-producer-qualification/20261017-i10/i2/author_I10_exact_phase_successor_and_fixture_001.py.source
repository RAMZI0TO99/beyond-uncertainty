def functions(raw, tree):
    lines = raw.splitlines(keepends=True)
    result = {}
    def walk(nodes, prefix=''):
        for node in nodes:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                key = prefix+node.name
                if not isinstance(node, ast.ClassDef):
                    start = min([node.lineno]+[d.lineno for d in node.decorator_list])-1
                    body = b''.join(lines[start:node.end_lineno])
                    assert key not in result
                    result[key] = body
                walk(node.body, key+'.')
    walk(tree.body)
    return result

old_funcs = functions(old_raw, old_tree)
new_funcs = functions(new_raw, new_tree)
assert set(new_funcs) == set(old_funcs)|{'require_phase_successor_basename'}
assert new_funcs['validate_selection'] == old_funcs['validate_selection'].replace(before_branch.encode(), after_branch.encode(), 1)
