    case(prefix+'ordinal999', role, previous.replace('018','999'), previous, 18, 999, True)
    case(prefix+'wrong_prefix', role, 'X'+good, previous, 18, 19, False)
    case(prefix+'wrong_extension', role, good+'.txt', previous, 18, 19, False)
    case(prefix+'wrong_suffix_case', role, good.replace('.TEMPLATE.ps1','.template.ps1').replace('.BOUND.ps1','.bound.ps1'), previous, 18, 19, False)
    case(prefix+'generic_terminal_ps1', role, role.rsplit('_',1)[0]+'_019.ps1', previous, 18, 19, False)
    case(prefix+'wrong_ordinal', role, previous.replace('018','020'), previous, 18, 19, False)
    case(prefix+'old_identity', role, previous, previous, 18, 19, False)
    opposite = role.replace('_template','_bound') if role.endswith('_template') else role.replace('_bound','_template')
    case(prefix+'opposite_role_suffix', opposite, good, previous, 18, 19, False)
    case(prefix+'missing_previous_token', role, good, previous.replace('018','017'), 18, 19, False)
    case(prefix+'duplicate_previous_token', role, '018_'+good, '018_'+previous, 18, 19, False)

