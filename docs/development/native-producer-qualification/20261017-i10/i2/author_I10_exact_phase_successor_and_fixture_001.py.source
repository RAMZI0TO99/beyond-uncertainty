    matches = [m for m in re.finditer(r'[0-9]{3}(?![0-9])',previous_leaf)
               if int(m.group()) == previous_ordinal]
    need(len(matches) == 1, 'one exact current-selection previous ordinal occurrence')
    match = matches[0]
    expected_leaf = previous_leaf[:match.start()]+str(selected_ordinal).zfill(3)+previous_leaf[match.end():]
    phase_suffix = '.TEMPLATE.ps1' if role in TEMPLATE_ROLES[1:] else '.BOUND.ps1'
