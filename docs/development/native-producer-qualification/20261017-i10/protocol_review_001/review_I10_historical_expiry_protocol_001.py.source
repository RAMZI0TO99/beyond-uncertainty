"""Independent Source-only protocol review; project Sources remain inert data."""
import ast
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re

HERE = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\producer_caller_qualification_013\protocol_review_001')
P = HERE.parent
REVIEWER = '/root/i10_producer_frontier'
CAP = 2097152
INPUTS = {}
CHECKS = []

def check(name, value):
    assert type(name) is str and name and all(c['name'] != name for c in CHECKS)
    assert type(value) is bool
    CHECKS.append(dict(name=name, passed=value))

def fact(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def read(path, expected=None):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as h:
        raw = h.read(CAP+1)
    assert len(raw) <= CAP
    f = fact(path, raw)
    if expected is not None:
        assert f == expected
    assert str(path) not in INPUTS or INPUTS[str(path)] == f
    INPUTS[str(path)] = f
    return raw

def pairs(rows):
    out = {}
    for k, v in rows:
        assert k not in out
        out[k] = v
    return out

def load(raw):
    return json.loads(raw.decode('utf-8'), object_pairs_hook=pairs,
        parse_float=lambda _: (_ for _ in ()).throw(ValueError('float')),
        parse_constant=lambda _: (_ for _ in ()).throw(ValueError('constant')))

def pinload(pin):
    assert type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'}
    return load(read(pin['path'], pin))

def closed_pins(value):
    if type(value) is dict:
        if set(value) == {'path', 'bytes', 'sha256'}:
            yield value
        else:
            for item in value.values():
                yield from closed_pins(item)
    elif type(value) is list:
        for item in value:
            yield from closed_pins(item)

def functions(tree):
    return {node.name: node for node in tree.body if isinstance(node, ast.FunctionDef)}

def literals(tree):
    out = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            try:
                out[node.targets[0].id] = ast.literal_eval(node.value)
            except (ValueError, TypeError):
                pass
    return out

def save(name, obj):
    raw = (json.dumps(obj, indent=2, sort_keys=True, allow_nan=False)+'\n').encode()
    assert len(raw) <= CAP
    path = HERE/name
    with path.open('xb') as h:
        h.write(raw)
        h.flush()
        os.fsync(h.fileno())
    assert path.read_bytes() == raw
    return fact(path, raw)

protocol_path = P/'ROOT_I10_EXACT_I1_HISTORICAL_EXPIRY_SUCCESSOR_PROTOCOL_001.json'
protocol = load(read(protocol_path, dict(path=str(protocol_path), bytes=8024,
    sha256='6537231d2fa1f56a9732bd956a0233ef4179adb036a094e8367077429be9c4a1')))
protocol_pin = INPUTS[str(protocol_path)]
for pin in closed_pins(protocol):
    read(pin['path'], pin)
scope = pinload(protocol['source_scope'])
start = pinload(protocol['actual_start_preservation'])
for record in (scope, start):
    for pin in closed_pins(record):
        read(pin['path'], pin)
check('protocol_author_is_Root_and_actual_editor_is_distinct_from_reviewer', protocol['author'] == '/root' and protocol['source_author'] == '/root/i10_caller_frontier' and REVIEWER not in (protocol['author'], protocol['source_author']))
for record_name, record in [('protocol',protocol),('scope',scope),('start_preservation',start)]:
