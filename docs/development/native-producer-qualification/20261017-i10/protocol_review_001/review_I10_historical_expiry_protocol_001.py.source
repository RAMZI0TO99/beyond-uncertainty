    check('actual_immutable_lease_%03d_expiry_matches_existing_I1_moment_shape'%ordinal, matches)
    check('actual_immutable_lease_%03d_new_or_operational_grant_false'%ordinal, lease['operational_authority'] is False and lease['lease_is_owner_deadline'] is False)
    lease_shapes.append(dict(ordinal=ordinal,pin=pin,expiry=text,existing_moment_regex_accepts=matches))
check('required_actual_expiry_offset_defect_exists_in_declared_immutable_inputs', any(not row['existing_moment_regex_accepts'] for row in lease_shapes))
anchor_text = ast.get_source_segment(anchor_raw.decode(), anchor_functions['_anchor_ticks'])
anchor_calls = sorted(set(n.func.id for n in ast.walk(anchor_functions['_anchor_ticks']) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)))
check('complete_I2_anchor_is_available_as_one_pure_AST_definition', anchor_calls == ['int','need','type'] and '10000000' in anchor_text and "hours <= 23 and minutes <= 59" in anchor_text and 'offset' in anchor_text)
check('protocol_verbatim_anchor_and_single_callsite_only', 'complete exact I2 _anchor_ticks' in protocol['correction'] and 'replace ONLY' in protocol['correction'] and 'Do not change moment()' in protocol['correction'] and 'All other historical review/adoption timestamp callsites remain unchanged and unqualified' in protocol['correction'])
check('protocol_preserves_all_other_existing_Python_functions', 'Every pre-existing Python function whole Source exact except decision_and_support' in protocol['preserved_functions'])
check('protocol_native_two_literal_path_only_delta', 'All native entry bytes exact except two path literals' in protocol['preserved_functions'] and any('only replace ExpectedEntry and Tool literal paths' in row for row in protocol['finite_allowed_source_edits']))
native = read(protocol['prior_native_entry']['path'], protocol['prior_native_entry']).decode()
check('original_native_preflight_precedes_time_and_author_call', native.index('--mode preflight') < native.index('[DateTimeOffset]::UtcNow') < native.index('--mode author'))
check('original_native_UTC_roundtrip_pair_and_duration_retained', "$Format = 'o'" in native and '$NativeEnd = $NativeCreated.AddTicks($Duration * [long]10000000)' in native and '$Duration -gt 43200' in native)
check('protocol_caps_all_original_values', protocol['actual_cap_boundaries'] == dict(admission_reserve_seconds=1200,lease_body=65536,maximum_lease_seconds=43200,metadata_Source=2097152,model_export=131072,phase_Source=65536,publication_reserve_seconds=60))
synthetic = protocol['synthetic_qualification']
