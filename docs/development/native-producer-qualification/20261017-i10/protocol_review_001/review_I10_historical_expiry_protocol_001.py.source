check('synthetic_separate_Source_review_and_Root_scope_required', synthetic['new_fixture_Source_only_until_separate_review_and_Root_adoption'] is True and any('fresh one-use' in row and 'consumed before owned launch' in row for row in synthetic['fixture_runner_requirements']))
check('synthetic_deny_IO_audit_bounded_owned_launch_no_retry', any('audit denies filesystem/network/process/native' in row for row in synthetic['fixture_runner_requirements']) and any('at most60 seconds' in row and 'cleanup5 seconds' in row and 'no retry' in row for row in synthetic['fixture_runner_requirements']))
check('synthetic_independent_saved_result_review_no_rerun', any('Independently review actual saved result; no rerun' in row for row in synthetic['fixture_runner_requirements']))
check('synthetic_plan_offset_boundary_bad_inputs_strict_current_moment', len(synthetic['cases']) == 6 and any('one tick after' in row for row in synthetic['cases']) and any('offset hour24/minute60' in row for row in synthetic['cases']) and any('moment remains strict +00:00 only' in row for row in synthetic['cases']))
check('limited_qualification_excludes_clock_lease_I2_IO_native_parser_runtime_science', len(protocol['outside_this_slice']) == 4 and protocol['all_actual_lease_family_native_parser_grants'] is None)
interpretation = pinload(protocol['accepted_historical_interpretation'])
check('I8_accepted_interpretation_is_static_finding_not_actual_I1_run', 'Static planning found' in interpretation['qualification_findings'] and 'unchanged and unrun' in interpretation['qualification_findings'] and interpretation['target_execution'] is False)
self_raw = read(Path(__file__))
self_pin = INPUTS[str(Path(__file__))]
for key, pin in list(INPUTS.items()):
    assert fact(Path(key), Path(key).read_bytes()) == pin
check('final_all_actual_read_inputs_rehashed_unchanged', True)
failures = [row['name'] for row in CHECKS if not row['passed']]
assert failures == ['required_actual_expiry_offset_defect_exists_in_declared_immutable_inputs']
