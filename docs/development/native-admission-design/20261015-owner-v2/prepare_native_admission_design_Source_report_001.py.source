CAP=2097152
inputs={}

def read(path,expected=None):
    path=Path(path)
    if str(path) not in inputs:
        with path.open('rb') as f:
            a=f.read(CAP+1);f.seek(0);b=f.read(CAP+1)
        if a!=b or not 0<len(a)<=CAP:raise ValueError('Actual read drift/cap: '+str(path))
        inputs[str(path)]={'pin':{'path':str(path),'bytes':len(a),'sha256':hashlib.sha256(a).hexdigest()},'body':a,'two_entire_reads_equal':True}
    row=inputs[str(path)]
    if expected is not None and row['pin']!=expected:raise ValueError('Actual pin differs: '+str(path))
    return row['body']

def fact(path):read(path);return inputs[str(Path(path))]['pin']

def decode(body):
    def pairs(items):
        result={}
        for key,value in items:
            if key in result:raise ValueError('Duplicate JSON '+key)
            result[key]=value
        return result
    def reject(s):raise ValueError('Float/nonfinite JSON '+s)
    return json.loads(body.decode('utf-8'),object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)

def value(path):return decode(read(path))

def tuple_constant(path,name):
    tree=ast.parse(read(path),filename=str(path))
    selected=[node for node in tree.body if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in node.targets)]
    if len(selected)!=1:raise ValueError('Literal Source schema declaration not unique: '+name)
    expr=selected[0].value
    if isinstance(expr,ast.Call) and isinstance(expr.func,ast.Name) and expr.func.id=='frozenset':expr=expr.args[0]
    result=ast.literal_eval(expr)
    if not isinstance(result,(tuple,list)):raise ValueError('Not a literal key roster')
    return list(result)

def anchor(path,name,kind='python'):
    lines=read(path).decode('utf-8').splitlines()
    prefix='def '+name+'(' if kind=='python' else 'function '+name+'('
    found=[i+1 for i,line in enumerate(lines) if line.startswith(prefix)]
    if len(found)!=1:raise ValueError('Source function anchor not unique '+name)
    return {'source':fact(path),'line':found[0],'symbol':name,'Source_only_text_anchor':True}

