def check(value,name):checks.append({'name':name,'passed':bool(value)})
def sha(b):return hashlib.sha256(b).hexdigest()
def pin(p,b):return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def raw9(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',None),getattr(s,'st_birthtime_ns',None)]
def read(p,expected=None):
 p=Path(p);key=str(p)
 if key not in buffers:
  s=p.lstat();p9=raw9(s)
  check(stat.S_ISREG(s.st_mode) and not p.is_symlink() and s.st_nlink==1,key+': actual ordinary single-link input')
  check(0<s.st_size<=CAP,key+': finite original2MiB input read cap')
  with p.open('rb',buffering=0) as f:
   d9=raw9(os.fstat(f.fileno()));a=f.read(CAP+1);f.seek(0);b=f.read(CAP+1);da=raw9(os.fstat(f.fileno()))
  pa=raw9(p.lstat())
  check(a==b and len(a)==s.st_size,key+': actual paired whole byte reads exact')
  check(p9==pa,key+': full independent PythonPATH9 unchanged')
  check(d9==da,key+': full independent Pythonfd9 unchanged')
  check(all(p9[i]==d9[i] for i in (0,1,2,3,6,7,8)),key+': original shared7 identity indexes agree')
  buffers[key]=a;inputs[key]=dict(pin(p,a),path9_before=p9,path9_after=pa,descriptor9_before=d9,descriptor9_after=da,read_cap=CAP)
 a=buffers[key]
 if expected is not None:check(pin(p,a)==expected,key+': exact named actual fact3 pin')
 return a
def decode(b):
 def pairs(items):
  d={}
  for k,v in items:
   if k in d:raise ValueError('Duplicate JSON key '+k)
   d[k]=v
  return d
 def reject(v):raise ValueError('Forbidden JSON float/nonfinite '+v)
 return json.loads(b.decode('utf-8'),object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
def value(p):return decode(read(p['path'],p)) if isinstance(p,dict) else decode(read(p))
def fact(p):return pin(Path(p),read(p))
def literal(p,name):
 tree=ast.parse(read(p),filename=str(p));nodes=[n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets)]
 if len(nodes)!=1:raise ValueError('Literal roster not unique '+name)
 expr=nodes[0].value
 if isinstance(expr,ast.Call) and isinstance(expr.func,ast.Name) and expr.func.id=='frozenset':expr=expr.args[0]
 return list(ast.literal_eval(expr))
def moment(s):return dt.datetime.fromisoformat(s)
def emit(p,v):
 b=(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
 if len(b)>CAP:raise ValueError('Original2MiB output cap')
 with p.open('xb') as f:f.write(b)
 if p.read_bytes()!=b:raise ValueError('Own saved output byte mismatch')
 return pin(p,b)
