def read(p):
 p=pathlib.Path(p);assert p.stat().st_size<=CAP;b=p.read_bytes();assert len(b)<=CAP;return b
def fact(p):
 p=pathlib.Path(p);b=read(p);return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def pin(f):
 b=read(f['path']);assert len(b)==f['bytes'] and hashlib.sha256(b).hexdigest()==f['sha256'];return b
def emit(name,x):
 b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP;p=O/name
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 return fact(p)
