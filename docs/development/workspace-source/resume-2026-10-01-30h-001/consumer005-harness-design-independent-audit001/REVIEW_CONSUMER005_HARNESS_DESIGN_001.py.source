"""Owned stdlib AST/data/finite metadata review. No reviewed definitions execute."""
from pathlib import Path
from datetime import datetime, timezone
import ast
import hashlib
import itertools
import json
import os
import stat

ROOT = Path(r'D:\Aenv\pro2')
BASE = ROOT / 'resume-2026-10-01-30h-001'
DESIGN = BASE / 'consumer005-isolated-unit-harness-design001'
OUT = BASE / 'consumer005-harness-design-independent-audit001'
CAP = 4194304

def sha(value):
    return hashlib.sha256(value).hexdigest()

def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def pretty(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def once(path, value):
    with path.open('xb') as stream:
        stream.write(value)

def raw(value):
    return [getattr(value, name, None) for name in
            ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode',
             'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def cross(value):
    return [getattr(value, name, None) for name in
            ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_nlink')]

def read(path):
    before = path.lstat()
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1
    assert not getattr(before, 'st_file_attributes', 0) & 1024 and before.st_size <= CAP
    with path.open('rb') as stream:
        first = os.fstat(stream.fileno())
        assert cross(before) == cross(first)
        data = stream.read(CAP + 1)
        last = os.fstat(stream.fileno())
    after = path.lstat()
    assert raw(before) == raw(after) and raw(first) == raw(last)
    assert len(data) == before.st_size <= CAP
    return data, dict(path=str(path), bytes=len(data), sha256=sha(data),
                      path_raw9=raw(before), descriptor_raw9=raw(first))

