actual_names = set()
directory_rows = []
for parent in sorted(parents, key=str):
    names = sorted(parent.iterdir(), key=lambda path: path.name)
    directory_rows.append(dict(path=str(parent), direct_names=[path.name for path in names]))
    for path in names:
        if path.is_file():
            actual_names.add(str(path))
        else:
            assert path in parents
assert actual_names == declared and len(actual_names) == 41

def value(relative):
