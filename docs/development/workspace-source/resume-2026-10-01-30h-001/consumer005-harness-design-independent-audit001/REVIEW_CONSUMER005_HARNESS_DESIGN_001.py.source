    rows, locations = subtest_rows(namespace, three_lines, dispatch_order=True)
    encoded = canonical(rows)
    if encoded != value(artifact):
        expected_rows = json.loads(value(artifact))
        print(json.dumps(dict(rows=len(rows), expected=len(expected_rows), first_different=
              next(((i, a, b) for i, (a, b) in enumerate(zip(rows, expected_rows)) if a != b), None))))
    assert len(rows) == 780 and encoded == value(artifact)
    three_families.append(dict(namespace=namespace, rows=len(rows), bytes=len(encoded),
                               sha256=sha(encoded), over_receipt_cap=len(encoded)-262144,
                               family_counts={str(line): locations.count(line) for line in three_lines},
                               ordering='Unsealed AST dispatch-label table order; schema3 policy group order differs from binding loop order. Permutation preserves canonical list byte length; this is not an actual runtime ordered-event witness.',
