md = '''# Consumer005 harness design independent review

PASS_SOURCE_ONLY_HARNESS_DESIGN_WITH_REQUIRED_PRECISION_READER_GRAMMAR_AND_IMPLEMENTATION_CONDITIONS. No implementation, binding, timer or runtime approval.

