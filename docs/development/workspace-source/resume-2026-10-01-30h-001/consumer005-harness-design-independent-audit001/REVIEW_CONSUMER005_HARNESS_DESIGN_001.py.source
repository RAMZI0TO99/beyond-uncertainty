tree = ast.parse(test_bytes)
classes = []
for node in tree.body:
    if isinstance(node, ast.ClassDef):
        names = [method.name for method in node.body
                 if isinstance(method, ast.FunctionDef) and method.name.startswith('test_')]
        classes.append(dict(name=node.name, line=node.lineno,
                            bases=[ast.unparse(base) for base in node.bases],
                            keywords=[ast.unparse(keyword) for keyword in node.keywords],
                            direct_methods=names, direct_count=len(names)))
assert [row['direct_count'] for row in classes] == [19, 5]
assert all(row['bases'] == ['unittest.TestCase'] and not row['keywords'] for row in classes)
assert len({name for row in classes for name in row['direct_methods']}) == 24
assert all(row['name'] == stated['name'] and row['direct_methods'] == stated['direct_method_names']
           for row, stated in zip(classes, design['discovery']['classes']))
rebound = []
class_names = {row['name'] for row in classes}
for node in tree.body:
    targets = node.targets if isinstance(node, ast.Assign) else [node.target] if isinstance(node, ast.AnnAssign) else []
    if any(isinstance(target, ast.Name) and target.id in class_names for target in targets):
        rebound.append(node.lineno)
assert not rebound

parents_ast = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
sites = sorted([node for node in ast.walk(tree) if isinstance(node, ast.Call)
                and isinstance(node.func, ast.Attribute) and node.func.attr == 'subTest'],
               key=lambda node: node.lineno)
site_rows = []
site_nodes = {}
for site in sites:
    ancestor = site
    loops = []
    while ancestor in parents_ast:
        ancestor = parents_ast[ancestor]
        if isinstance(ancestor, ast.For):
            loops.append(ancestor)
        if isinstance(ancestor, ast.FunctionDef):
            method = ancestor.name
            break
    loops.reverse()
    site_rows.append(dict(line=site.lineno, method=method,
                          keyword_order=[keyword.arg for keyword in site.keywords],
                          loops=[dict(line=node.lineno, target=ast.unparse(node.target),
                                      iterable_AST=ast.unparse(node.iter)) for node in loops]))
    site_nodes[site.lineno] = (site, method, loops)
assert len(sites) == 17
assert {site.lineno: {keyword.arg: ast.unparse(keyword.value) for keyword in site.keywords}
        for site in sites} == {row['line']: row['kwargs'] for row in
                              design['event_transport_proposal']['subtest_AST_sites']}

# Derive case labels from literal return-list labels, never run schema3_policy_changes.
change_function = next(node for node in tree.body if isinstance(node, ast.FunctionDef)
                       and node.name == 'schema3_policy_changes')
case_labels = {}
for branch in change_function.body:
    if not isinstance(branch, ast.If):
        continue
    comparison = branch.test
    assert isinstance(comparison, ast.Compare)
    names = ast.literal_eval(comparison.comparators[0])
    names = (names,) if type(names) is str else names
    returned = next(node for node in branch.body if isinstance(node, ast.Return))
    labels = [ast.literal_eval(row.elts[0]) for row in returned.value.elts]
    for name in names:
        case_labels[name] = labels
assert set(case_labels) == set(binding['schema3_policy_names'])
assert sum(len(case_labels[name]) for name in binding['schema3_policy_names']) == 38

method_class = {method: row['name'] for row in classes for method in row['direct_methods']}
metaclass_cases = []
for node in tree.body:
    if isinstance(node, ast.ClassDef) and node.name == 'RawConsumerMetaclassIdentityRegressions':
        for method in node.body:
            if isinstance(method, ast.FunctionDef) and method.name.startswith('test_m'):
                call = method.body[0].value
                metaclass_cases.append((method.name, ast.literal_eval(call.args[0])))
assert [case for _, case in metaclass_cases] == ['M1', 'M2', 'M3', 'M4']

def assignments(site, method, loops, dispatch_order=False):
    answers = [dict()]
    for loop in loops:
        updated = []
        for environment in answers:
            if isinstance(loop.iter, ast.Name):
                token = loop.iter.id
                if token == 'policies':
                    domain = binding['new_policy_names'] if loop.lineno == 244 else list(case_labels) if dispatch_order else binding['schema3_policy_names']
                elif token == 'helpers':
                    domain = binding['new_helper_names'] if loop.lineno == 265 else binding['schema3_helper_names']
                elif token == 'cases':
                    domain = [(label, None) for label in case_labels[environment['name']]]
                else:
                    raise AssertionError(token)
            else:
                domain = ast.literal_eval(loop.iter)
            for item in domain:
                fresh = dict(environment)
                if isinstance(loop.target, ast.Name):
                    fresh[loop.target.id] = item
                else:
                    for target, part in zip(loop.target.elts, item):
                        fresh[target.id] = part
                updated.append(fresh)
        answers = updated
    if method == 'assert_metaclass_case_refused':
        return [(test_method, dict(environment, case=case)) for test_method, case in metaclass_cases
                for environment in answers]
    return [(method, environment) for environment in answers]

def subtest_rows(namespace, selected_lines=None, dispatch_order=False):
    rows = []
    row_sites = []
    for line, (site, method, loops) in site_nodes.items():
        if selected_lines is not None and line not in selected_lines:
            continue
        for actual_method, environment in assignments(site, method, loops, dispatch_order):
            identifier = namespace + '.' + method_class[actual_method] + '.' + actual_method
            params = [(keyword.arg, environment[keyword.value.id]) for keyword in site.keywords]
            suffix = '(' + ', '.join(key + '=' + repr(part) for key, part in params) + ')'
            rows.append(dict(event='subtest', id=identifier + ' ' + suffix,
                             parent_id=identifier, status='passed'))
            row_sites.append(line)
    return rows, row_sites

