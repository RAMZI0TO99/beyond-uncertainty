inputs = {name:(base/name).read_bytes() for name in names}
sha = lambda data: hashlib.sha256(data).hexdigest()
short = lambda name: sha(inputs[name])[:8]
assert json.loads(inputs[names[2]])['verdict'] == 'PASS_DOCUMENTATION_FROZEN_CREATION_SCOPE_ONLY'
assert json.loads(inputs[names[5]])['verdict'] == 'PASS_STATIC_METADATA_PREPARATION_ONLY'
assert json.loads(inputs[names[8]])['verdict'] == 'PASS_STATIC_BOUND_METADATA_ONLY'
assert json.loads(inputs[names[11]])['verdict'] == 'PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY'
assert json.loads(inputs[names[14]])['verdict'] == 'REFUSED_STATIC_SOURCE_UTILITY_PREPARATION'
now = datetime.now(timezone.utc)
assert now < datetime(2026,10,2,22,36,15,tzinfo=timezone.utc)
stamp = now.isoformat(timespec='microseconds')
assert not (base/'guard005-root-metadata-prep002/phase-before-005').exists()
assert not (base/'consumer-guard-test-runtime005/ROOT_LAUNCH_START_005.json').exists()
body = f'''# Major step024 - fresh metadata source bindings reviewed; review utility refused; consumer identity correction under audit

Recorded {stamp}. Owner local/private window ends **2026-10-02T22:36:15Z**.

[Major023 documentation peer](INDEPENDENT_DOCS_REFRESH_REVIEW_023.json), {short(names[2])},
accepted frozen creation scope:72 unique finite inputs and exact retained AGENTS
suffix190001, SESSION prefix316943 and RESOURCE prefix17894. No lateral append was
