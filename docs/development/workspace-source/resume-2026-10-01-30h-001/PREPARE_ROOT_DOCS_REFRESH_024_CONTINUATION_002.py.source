links=[]
for path,data in [(primary[0],header),(primary[1],handoff),(primary[2],start),
                  (checkpoint,body.encode()),(primary[3],entry),(primary[4],resource_entry)]:
    for target in re.findall(r'\]\(([^)]+)\)',data.decode()):
        resolved=(path.parent/target).resolve()
        assert resolved == checkpoint.resolve() or resolved.is_file(),(str(path),target)
        links.append(dict(document=path.relative_to(root).as_posix(),target=target,resolved_path=str(resolved)))
def once(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data);stream.flush();os.fsync(stream.fileno())
def row(path):
    data=path.read_bytes()
    return dict(path=path.relative_to(root).as_posix(),bytes=len(data),sha256=sha(data))
enc=lambda value:(json.dumps(value,indent=2,sort_keys=True,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
for name,data in inputs.items():
    assert (base/name).read_bytes()==data
    once(input_dir/'resume-2026-10-01-30h-001'/name,data)
for path,data in old.items():once(before_dir/path.relative_to(root),data)
once(checkpoint,body.encode())
for path,data in {primary[0]:header+old[primary[0]],primary[1]:handoff,primary[2]:start}.items():
    assert path.read_bytes()==old[path];path.write_bytes(data)
for path,data in [(primary[3],entry),(primary[4],resource_entry)]:
    assert path.read_bytes()==old[path]
    with path.open('ab') as stream:stream.write(data)
baseline=[]
for path,data in old.items():
    proof='exact_before_copy'
    if path.name=='AGENTS.md':assert path.read_bytes().endswith(data);proof='exact_retained_suffix'
    if path.name in ('SESSION.md','RESOURCE_COORDINATION.md'):
        assert path.read_bytes().startswith(data);proof='exact_retained_prefix'
    baseline.append(dict(primary=path.relative_to(root).as_posix(),before=row(before_dir/path.relative_to(root)),proof=proof))
once(base/'DOCS_REFRESH_BASELINE_024.json',enc(dict(schema_version=1,created_utc=stamp,files=baseline)))
pairs=[dict(original=row(base/name),copy=row(input_dir/'resume-2026-10-01-30h-001'/name)) for name in inputs]
once(base/'DOCS_REFRESH_INPUTS_024.json',enc(dict(schema_version=1,created_utc=stamp,inputs=pairs)))
declared=[*primary,checkpoint,base/'DOCS_REFRESH_BASELINE_024.json',base/'DOCS_REFRESH_INPUTS_024.json',
          *[before_dir/path.relative_to(root) for path in primary],
          *[input_dir/'resume-2026-10-01-30h-001'/name for name in inputs]]
facts=dict(metadata_prep002_source_bound_static_only=True,actual_phase_auth_or_capture_entered=False,
           actual_whole_or_ACK_or_unit_entered=False,GG5_review_utility001_refused_source_unrun=True,
           Consumer004_author_frozen_unapproved_equality_limit=True,Consumer004_680_new_contexts_planned_only=True,
           bounded_design_only_different_peer_pending=True,publication_native_implementation_authorized=False,
