           canonical_live_apply_fullQA_release_native_held=True,primary_docs_fixed_during_future_actual_proof=True)
audit=dict(schema_version=1,checkpoint=24,created_utc=stamp,status='AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW',
           files=[row(path) for path in declared],actual_input_count=len(pairs),maintained_links=links,facts=facts)
once(base/'DOCS_REFRESH_AUDIT_024.json',enc(audit))
print(json.dumps(dict(checkpoint_sha256=sha(checkpoint.read_bytes()),audit_sha256=sha(enc(audit)),
                      declared_files=len(declared),input_pairs=len(pairs),links=len(links))))
