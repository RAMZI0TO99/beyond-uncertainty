"""Owned finite documentation/AST/data review only. No reviewed code executes."""
from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,os,re,stat,ast

ROOT=Path(r'D:\Aenv\pro2');BASE=ROOT/'resume-2026-10-01-30h-001'
CAP=4194304
def sha(b):return hashlib.sha256(b).hexdigest()
def enc(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def once(p,b):
    with p.open('xb') as f:f.write(b)
def raw(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None)]
def read(p):
    a=p.lstat();assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not getattr(a,'st_file_attributes',0)&1024 and a.st_size<=CAP
    with p.open('rb') as f:
        b=os.fstat(f.fileno());data=f.read(CAP+1);c=os.fstat(f.fileno())
    d=p.lstat();assert raw(a)==raw(d) and raw(b)==raw(c) and len(data)==a.st_size
    return data,dict(path=str(p),bytes=len(data),sha256=sha(data),path_raw9=raw(a),descriptor_raw9=raw(b))
