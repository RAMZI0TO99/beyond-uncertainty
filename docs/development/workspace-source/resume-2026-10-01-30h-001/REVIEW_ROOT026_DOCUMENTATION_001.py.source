    if item['proof']=='exact_retained_suffix':
        assert current.endswith(old);added[item['primary']]=current[:-len(old)]
    elif item['proof']=='exact_retained_prefix':
        assert current.startswith(old);added[item['primary']]=current[len(old):]
    else:added[item['primary']]=current
    history.append(dict(path=item['primary'],before_bytes=len(old),before_sha256=sha(old),proof=item['proof'],verified=True))
cp='resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_026.md';added[cp]=data[str(ROOT/cp)]
links=[]
for document in ['AGENTS.md','HANDOFF.md','START_HERE.md',cp,'resume-2026-09-28-001/SESSION.md','resume-2026-10-01-30h-001/RESOURCE_COORDINATION.md']:
