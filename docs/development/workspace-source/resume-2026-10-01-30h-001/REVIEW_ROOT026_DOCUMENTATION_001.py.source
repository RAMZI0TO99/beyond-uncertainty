ab,ar=read(audit_path);assert sha(ab)=='024e2be1321032bc0599c123dc77040f85836bb31260f3eb30fa94b2ee27a2b3'
audit=json.loads(ab);pairs=json.loads(read(BASE/'DOCS_REFRESH_INPUTS_026.json')[0])['inputs']
