"""One-use Root source-only compact capsule choice; no target code executes."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib, json, os
base=Path('D:/Aenv/pro2/resume-2026-10-01-30h-001')
full=base/'consumer005-complete-static-audit001/INDEPENDENT_CONSUMER005_COMPLETE_SOURCE_REVIEW_001.json'
design=base/'consumer005-harness-design-independent-audit001/INDEPENDENT_CONSUMER005_HARNESS_DESIGN_REVIEW_001.json'
sha=lambda b:hashlib.sha256(b).hexdigest()
fullbytes=full.read_bytes();designbytes=design.read_bytes()
assert sha(fullbytes)=='5a283496929bffed9b022bff382719cbb918df94f5a5224b9c8022e237e9d096'
assert sha(designbytes)=='9f1b43f04ad3396c825865c6acaa706cd4bbc758059bc05ea5cf132f812e75cf'
assert len(fullbytes)==2553985 and len(json.loads(fullbytes))==38
now=datetime.now(timezone.utc);assert now<datetime(2026,10,2,22,36,15,tzinfo=timezone.utc)
record=dict(schema_version=1,record_type='root_consumer005_compact_source_capsule_choice',author='/root',
    created_utc=now.isoformat(timespec='microseconds'),source_author_owner='/root/native_frame_explorer',
    decision='AUTHOR_COMPACT_STATIC_SOURCE_CAPSULE_AND_PRECISION_ONLY_NO_HARNESS_IMPLEMENTATION',
    full_source_peer=dict(path=str(full),sha256=sha(fullbytes),bytes=len(fullbytes)),
    conditional_design_peer=dict(path=str(design),sha256=sha(designbytes),verdict=json.loads(designbytes)['verdict']),
    output_folder='consumer005-compact-source-capsule-prep001',new_capsule_maximum_bytes=131072,
    caps_changed=False,full_peer_reader_cap_widened=False,
    required_content=['Distinct source-only schema with explicit typed nominal core, genuine Python6 creation and no actual authority.',
      'Externally anchored full5a283 review, Source005 manifest/test/Raw004 and all five active consumer source roles, and current source/API/code-metadata facts.',
      'Direct two sibling classes19+5/no inherited duplication; all24 actual collection/results remain None or UNRUN.',
      'Exact predicate/body/import/default/guard preservation and M1-M4 preparation scope; existing Path limits remain explicit.',
      'Finite declared closure does not imply unknown-file absence, target execution, loaded/site/physical capture/Job/descendant readiness.',
      'Distinct precision supplement oldSource3TOP51/nestedraw_policy_facts12/selectedcore versusnewTOP38/missingoldstructures/2MiB over456833; preserve wrong originaldesign bytes.',
      'Document independently reproducible capsule derivation from authenticated full peer and frozen sources; preserve all selected original/copy bytes before writes.'],
    required_followup='Different Root or eligible peer must validate complete capsule/derivation/closure/limits before any harness source/reader implementation choice.',
    permitted_operations='Own stdlib metadata compositor/AST reads only; no target compiler, definitions, imports, calls, tests, Git, FFI, PS, actual bindings or operational records.',
    existing_harness_source_approved=False,event_row_grammar_approved=False,actual_collection=None,actual_result=None,
    operational_authority_granted=False,canonical_live_native_science_scope_changed=False)
path=base/'ROOT_CONSUMER005_CAPSULE_SOURCE_CHOICE_010.json';assert not path.exists()
data=(json.dumps(record,indent=2,sort_keys=True,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
with path.open('xb')as stream:stream.write(data);stream.flush();os.fsync(stream.fileno())
assert path.read_bytes()==data and full.read_bytes()==fullbytes and design.read_bytes()==designbytes
print(json.dumps(dict(path=str(path),sha256=sha(data),capsule_only=True,harness_implementation=False)))
