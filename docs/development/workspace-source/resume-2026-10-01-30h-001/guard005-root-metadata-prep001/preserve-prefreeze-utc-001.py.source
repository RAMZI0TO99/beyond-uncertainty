import hashlib
import json
from pathlib import Path

root = Path(r'D:\Aenv\pro2\resume-2026-10-01-30h-001\guard005-root-metadata-prep001')
destination = root / 'before-utc-correction-001'
destination.mkdir()
rows = []
for name in ('capture-guard005-root-metadata.TEMPLATE.py', 'METADATA_PREPARATION_CONTRACT_001.json', 'HANDOFF.md'):
    source = root / name
    before = source.read_bytes()
    target = destination / name
    with target.open('xb') as stream:
        stream.write(before)
    assert source.read_bytes() == before == target.read_bytes()
    assert source.stat().st_ino != target.stat().st_ino
    rows.append({'original_path': str(source), 'copy_path': str(target), 'sha256': hashlib.sha256(before).hexdigest(), 'bytes': len(before)})
record = {'schema_version': 1, 'author': '/root/bootstrap_stage', 'reason': 'Preserve initial draft before exact UTC fractional grammar and JSON-float refusal correction; no prepared definition executed.', 'files': rows, 'prepared_source_executed': False}
path = root / 'PREFREEZE_UTC_BEFORE_MANIFEST_001.json'
data = (json.dumps(record, sort_keys=True, indent=2) + '\n').encode('ascii')
with path.open('xb') as stream:
    stream.write(data)
print(hashlib.sha256(data).hexdigest())
