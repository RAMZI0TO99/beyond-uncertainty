    'isolated-guard-test-supervisor002/UNBOUND_MANIFEST_002.json',
    'isolated-guard-test-supervisor002/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_002.json',
    'isolated-guard-test-supervisor002/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_002.md',
