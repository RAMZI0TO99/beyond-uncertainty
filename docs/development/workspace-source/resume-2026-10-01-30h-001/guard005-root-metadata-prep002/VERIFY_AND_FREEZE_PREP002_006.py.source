    bound=text
    for key in ('BoundScriptSha256','BoundReviewSha256'):
        pattern='(?m)^\\$'+key+r' = \$null\r?$'
        assert len(re.findall(pattern,bound))==1
        bound=re.sub(pattern,lambda match:'$'+key+" = '"+'0'*64+"'"+ ('\r' if match.group().endswith('\r') else ''),bound)
    reverse=bound
    for key in ('BoundScriptSha256','BoundReviewSha256'):
        reverse=re.sub('(?m)^\\$'+key+r" = '[0-9a-f]{64}'\r?$",lambda match:'$'+key+' = $null'+ ('\r' if match.group().endswith('\r') else ''),reverse)
    assert reverse.encode('utf-8')==data
