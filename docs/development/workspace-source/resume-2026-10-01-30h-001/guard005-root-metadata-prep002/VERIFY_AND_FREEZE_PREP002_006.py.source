FIELDS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')

def observe(path):
    first=path.lstat()
    assert stat.S_ISREG(first.st_mode) and first.st_nlink==1 and not first.st_file_attributes & 0x400 and 0<=first.st_size<=67108864
    raw=lambda value:[getattr(value,key) for key in FIELDS]
    with path.open('rb') as stream:
        opened=os.fstat(stream.fileno());data=stream.read(first.st_size+1);last_open=os.fstat(stream.fileno())
    last=path.lstat();p,f=raw(first),raw(opened)
    assert p==raw(last) and f==raw(last_open) and p[:4]+p[5:]==f[:4]+f[5:] and p[4]==p[8] and len(data)==first.st_size
    return data,dict(path=str(path),sha256=hashlib.sha256(data).hexdigest(),bytes=len(data),path_raw9=p,descriptor_raw9=f)

def once(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii') if not isinstance(value,bytes) else value
    with (ROOT/name).open('xb') as stream:stream.write(data)
    assert observe(ROOT/name)[0]==data
    return hashlib.sha256(data).hexdigest()

def functions(data):
    return {node.name:ast.dump(node,include_attributes=False) for node in ast.parse(data).body if isinstance(node,ast.FunctionDef)}

def ps_function(text,name):
    marker='function '+name+'('
    start=text.index(marker)
    candidates=[position for token in ('\nfunction ','\nif ([IO.Path]') for position in [text.find(token,start+len(marker))] if position>=0]
    return text[start:min(candidates)]

