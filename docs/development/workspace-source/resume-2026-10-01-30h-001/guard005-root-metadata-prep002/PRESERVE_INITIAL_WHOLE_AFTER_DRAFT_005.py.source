"""Copies own unreviewed source drafts only; no copied definitions execute."""
import hashlib
import json
from pathlib import Path
root=Path(r'D:\Aenv\pro2\resume-2026-10-01-30h-001\guard005-root-metadata-prep002')
rows=[]
for name in ('PREPARE_WHOLE_AFTER_SOURCE_004.py','SUPERVISE_ROOT_WHOLE_AFTER_005.ps1','WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_005.ps1'):
    source=root/name
    data=source.read_bytes()
    target=root/('author-before-provenance-'+name+'.bytes')
    with target.open('xb') as stream: stream.write(data)
    assert target.read_bytes()==data and target.stat().st_ino!=source.stat().st_ino
    rows.append(dict(source=str(source),copy=str(target),bytes=len(data),sha256=hashlib.sha256(data).hexdigest()))
with (root/'AUTHOR_DRAFT_PRESERVATION_005.json').open('xb') as stream:
    stream.write((json.dumps(dict(schema_version=1,own_unreviewed_drafts_only=True,rows=rows,target_definitions_executed=False),sort_keys=True,indent=2)+'\n').encode('ascii'))
print('Own source drafts preserved; zero target definitions executed.')
