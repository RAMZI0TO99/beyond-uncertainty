function Pin([string]$Path,[string]$Expected,[long]$Cap) {
    if ($Expected -cnotmatch '^[0-9a-f]{64}$' -or $Cap -le 0) { throw 'Invalid exact pin/cap' }
    $item = Get-Item -LiteralPath $Path -Force
    if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $item.Length -gt $Cap) { throw 'Nonplain or oversized input' }
    $stream = [IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
    try {
        if ($stream.Length -ne $item.Length -or $stream.Length -gt $Cap) { throw 'Opened input size differs before allocation' }
        $memory = [IO.MemoryStream]::new()
        try {
            $buffer = [byte[]]::new(4096)
            do {
                $count = $stream.Read($buffer,0,$buffer.Length)
                if ($memory.Length + $count -gt $Cap) { throw 'Opened input cap exceeded' }
                $memory.Write($buffer,0,$count)
            } while ($count -gt 0)
            $bytes = $memory.ToArray()
        } finally { $memory.Dispose() }
    } finally { $stream.Dispose() }
    $hasher = [Security.Cryptography.SHA256]::Create()
    try { $hash = [BitConverter]::ToString($hasher.ComputeHash($bytes)).Replace('-','').ToLowerInvariant() } finally { $hasher.Dispose() }
    $last = Get-Item -LiteralPath $Path -Force
    if ($last.PSIsContainer -or ($last.Attributes -band [IO.FileAttributes]::ReparsePoint) -or
        $hash -cne $Expected -or $bytes.Length -ne $item.Length -or $item.Length -ne $last.Length -or
        $item.LastWriteTimeUtc.Ticks -ne $last.LastWriteTimeUtc.Ticks -or
        $item.CreationTimeUtc.Ticks -ne $last.CreationTimeUtc.Ticks -or $item.Attributes -ne $last.Attributes) { throw 'Input pin or FileInfo metadata drift' }
    # FileInfo does not establish nlink/inode/descriptor identity or an atomic retained execution lock.
    return ,$bytes
}

function Write-Once([string]$Path,$Record) {
    $bytes = [Text.UTF8Encoding]::new($false,$true).GetBytes(($Record | ConvertTo-Json -Compress -Depth 8) + "`n")
    if ($bytes.Length -gt 65536) { throw 'Parent receipt cap' }
    $stream = [IO.File]::Open($Path,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
    try { $stream.Write($bytes,0,$bytes.Length); $stream.Flush($true) } finally { $stream.Dispose() }
}

function Authorization-Stamp($Value) {
    if ($Value -isnot [string] -or $Value -cnotmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{7}\+00:00\z') { throw 'Authorization requires genuine canonical ROOT PowerShell UTC33' }
    $stamp = [DateTimeOffset]::ParseExact($Value,'o',[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None)
    if ($stamp.Offset -ne [TimeSpan]::Zero -or $stamp.ToString('o',[Globalization.CultureInfo]::InvariantCulture) -cne $Value) { throw 'Authorization UTC roundtrip differs' }
    return $stamp
}

function Exact-Object($Value,[string[]]$Keys,[string]$Label) {
    if ($Value -isnot [pscustomobject]) { throw ($Label+' object type differs') }
    $names=@($Value.PSObject.Properties.Name)
    if ($names.Count -ne $Keys.Count -or @($names | Where-Object { $Keys -cnotcontains $_ }).Count -ne 0) { throw ($Label+' closed keys differ') }
}
function Hex-Pin($Value) { return ($Value -is [string] -and $Value -cmatch '\A[0-9a-f]{64}\z') }
function Python-Stamp($Value) {
    if ($Value -isnot [string] -or $Value -cnotmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]{6})?\+00:00\z') { throw 'Python metadata UTC requires0or6 fractional digits' }
    $format=if($Value.Contains('.')){"yyyy-MM-dd'T'HH:mm:ss.ffffffzzz"}else{"yyyy-MM-dd'T'HH:mm:sszzz"}
    $valueStamp=[DateTimeOffset]::ParseExact($Value,$format,[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None)
    if ($valueStamp.Offset -ne [TimeSpan]::Zero -or $valueStamp.ToString($format,[Globalization.CultureInfo]::InvariantCulture) -cne $Value) { throw 'Python UTC canonical roundtrip differs' }
    return $valueStamp
}
function Decode-Captured([byte[]]$Bytes) { return ([Text.UTF8Encoding]::new($false,$true).GetString($Bytes) | ConvertFrom-Json) }
function Original-Pointer($Value,[string]$ExpectedPath) {
    Exact-Object $Value @('path','sha256') 'Original before pointer'
    if ($Value.path -isnot [string] -or $Value.path -cne $ExpectedPath -or -not (Hex-Pin $Value.sha256)) { throw 'Original before pointer role/pin differs' }
}
function Original-Context-Fresh($Authorization) {
    Original-Pointer $Authorization.runtime_snapshot (Join-Path $Meta 'phase-before-005\RUNTIME4_METADATA_SELECTION_005.json')
    Original-Pointer $Authorization.context_selection (Join-Path $Meta 'phase-before-005\OPAQUE_CURRENT_CONTEXT_005.json')
    $runtime=Decode-Captured (Pin $Authorization.runtime_snapshot.path $Authorization.runtime_snapshot.sha256 65536)
    Exact-Object $runtime @('captured_utc','context_selection','entries','schema_version','scope') 'Original runtime selection'
    $context=Decode-Captured (Pin $Authorization.context_selection.path $Authorization.context_selection.sha256 1048576)
    Exact-Object $context @('captured_utc','configurations','git_metadata','head','runtime_roles_projection_sha256','schema_version','scope','tracked_rows') 'Original opaque context'
    foreach($record in @($runtime,$context)) {
        if (($record.schema_version -isnot [int] -and $record.schema_version -isnot [long]) -or $record.schema_version -ne 1 -or $record.scope -isnot [string] -or $record.scope -cne $Scope) { throw 'Original context/runtime role types differ' }
        $age=([DateTimeOffset]::UtcNow-(Python-Stamp $record.captured_utc)).TotalSeconds
        if ($age -lt 0 -or $age -gt 600) { throw 'Original before600-second context expired; no refresh/replay' }
    }
    Original-Pointer $runtime.context_selection $Authorization.context_selection.path
    if ($runtime.context_selection.sha256 -cne $Authorization.context_selection.sha256 -or $runtime.captured_utc -cne $context.captured_utc -or $runtime.entries -isnot [array] -or $runtime.entries.Count -ne 4 -or $context.tracked_rows -isnot [array] -or $context.tracked_rows.Count -ne 742 -or $context.configurations -isnot [array] -or $context.configurations.Count -ne 55) { throw 'Original before runtime/context relationship differs' }
    if ($context.runtime_roles_projection_sha256 -isnot [string] -or $context.runtime_roles_projection_sha256 -cne '63761e1f122b54d1b75a6884588ec94b6ffd9228df409ccc812f20d94c9809dd') { throw 'Original runtime projection differs' }
    # Fresh actual-record review independently checks nested raw9/path/hash rows and canonical JSON; FileInfo checks are not an atomic lock.
}
function Whole-Before-Result($Authorization,[string]$Expected) {
    $value=Decode-Captured (Pin (Join-Path $Prep 'whole-runtime-before\result.json') $Expected 262144)
    Exact-Object $value @('schema_version','record_type','scope','phase','verdict','captured_utc','observer_sha256','static_review_sha256','profile_sha256','owner_sha256','runtime_snapshot_sha256','context_selection_sha256','source_snapshot_sha256','trees','observation_files','before_record_sha256','unit_receipt','target_execution','whole_site_loaded_closure_retained_lock_OS_Job_guaranteed') 'Actual whole-before result'
    foreach($key in @('record_type','scope','phase','verdict','observer_sha256','static_review_sha256','profile_sha256','owner_sha256','runtime_snapshot_sha256','context_selection_sha256','source_snapshot_sha256')) { if($value.$key -isnot [string]) { throw 'Whole-before nominal string differs' } }
    if (($value.schema_version -isnot [int] -and $value.schema_version -isnot [long]) -or $value.schema_version -ne 1 -or $value.record_type -cne 'consumer_guard_unit005_whole_metadata_result' -or $value.scope -cne $Scope -or $value.phase -cne 'before' -or $value.verdict -cne 'MATCHES_PINNED_BYTES_METADATA_TWICE' -or $value.observer_sha256 -cne $ObserverSha -or $value.static_review_sha256 -cne $ReviewSha -or $value.profile_sha256 -cne $ProfileSha -or $value.owner_sha256 -cne $OwnerSha -or $value.runtime_snapshot_sha256 -cne $Authorization.runtime_snapshot.sha256 -or $value.context_selection_sha256 -cne $Authorization.context_selection.sha256 -or -not (Hex-Pin $value.source_snapshot_sha256) -or $null -ne $value.before_record_sha256 -or $null -ne $value.unit_receipt -or $value.target_execution -isnot [bool] -or $value.target_execution -ne $false -or $value.whole_site_loaded_closure_retained_lock_OS_Job_guaranteed -isnot [bool] -or $value.whole_site_loaded_closure_retained_lock_OS_Job_guaranteed -ne $false) { throw 'Whole-before actual scope/source/pointer facts differ' }
    [void](Python-Stamp $value.captured_utc)
    Exact-Object $value.trees @('base','scripts') 'Expected two tree roles'
    if ($value.observation_files -isnot [array] -or $value.observation_files.Count -ne 4) { throw 'Four actual whole-before row streams required' }
    # Whole result is not accepted merely by these parent checks; independent full tree/row reconciliation is mandatory.
}
function Driver-Finished($Value,[string]$BeforePin) {
    Exact-Object $Value @('scope','accepted_copied_guard_units','result_sha256','collection_sha256','collected_methods','passed','reported_subtests','passing_subtests','root_ack_sha256','profile_sha256','source_peer_sha256','harness_static_peer_sha256','whole_before_result_sha256','evidence_initial','evidence_final','driver_sha256','direct_child_reaped','external_whole_after_acceptance_pending','canonical_fullQA_native_fit_authority','hard_Job_OS_sandbox_descendant_cleanup_proved') 'Actual driver finished receipt'
    foreach($key in @('scope','result_sha256','collection_sha256','root_ack_sha256','profile_sha256','source_peer_sha256','harness_static_peer_sha256','whole_before_result_sha256','driver_sha256')) { if($Value.$key -isnot [string]) { throw 'Driver receipt nominal string differs' } }
    foreach($key in @('result_sha256','collection_sha256','root_ack_sha256','profile_sha256','source_peer_sha256','harness_static_peer_sha256','whole_before_result_sha256','driver_sha256')) { if(-not (Hex-Pin $Value.$key)) { throw 'Driver receipt pin type differs' } }
    foreach($key in @('collected_methods','passed','reported_subtests','passing_subtests')) { if(($Value.$key -isnot [int] -and $Value.$key -isnot [long]) -or $Value.$key -lt 0) { throw 'Driver actual count type differs' } }
    foreach($key in @('accepted_copied_guard_units','direct_child_reaped','external_whole_after_acceptance_pending','canonical_fullQA_native_fit_authority','hard_Job_OS_sandbox_descendant_cleanup_proved')) { if($Value.$key -isnot [bool]) { throw 'Driver receipt nominal boolean differs' } }
    if ($Value.scope -cne $Scope -or $Value.accepted_copied_guard_units -ne $true -or $Value.collected_methods -ne 14 -or $Value.passed -ne 14 -or $Value.reported_subtests -ne $Value.passing_subtests -or $Value.profile_sha256 -cne $ProfileSha -or $Value.source_peer_sha256 -cne '54b19d3611ebb51bd6504a0ef6b23c689c86b5c5c163688be868fa51c0808050' -or $Value.harness_static_peer_sha256 -cne $ReviewSha -or $Value.whole_before_result_sha256 -cne $BeforePin -or $Value.driver_sha256 -cne '9f2add33e9dc9c2e3b3931f6565beede64ebe44baff5d07a519104afa6c0ab8d' -or $Value.direct_child_reaped -ne $true -or $Value.external_whole_after_acceptance_pending -ne $true -or $Value.canonical_fullQA_native_fit_authority -ne $false -or $Value.hard_Job_OS_sandbox_descendant_cleanup_proved -ne $false) { throw 'Actual accepted copied14 guard receipt required; no canonical/native authority' }
    if ($Value.evidence_initial -isnot [array] -or $Value.evidence_final -isnot [array] -or ($Value.evidence_initial | ConvertTo-Json -Compress -Depth 16) -cne ($Value.evidence_final | ConvertTo-Json -Compress -Depth 16)) { throw 'Driver initial/final evidence differs' }
    # Actual result/collection/events and genuine ROOT ACK are independently reviewed before this producer is authorized; no acceptance is inferred here.
}
function Root-Unit-Terminal([string]$Expected) {
    $value=Decode-Captured (Pin (Join-Path $Prep 'ROOT_LAUNCH_TERMINAL_005.json') $Expected 65536)
    Exact-Object $value @('schema_version','scope','finished_utc','exit_code','timed_out','capture_overflow','capture_drain_complete','direct_driver_reaped','failure','stdout_bytes','stderr_bytes','driver_sha256','root_ack_sha256','spent','canonical_qa_native_fit_authority','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound','automatic_cleanup_performed') 'Physical ROOT unit terminal'
    foreach($key in @('scope','driver_sha256','root_ack_sha256')) { if($value.$key -isnot [string]) { throw 'ROOT terminal nominal string differs' } }
    foreach($key in @('schema_version','exit_code','stdout_bytes','stderr_bytes')) { if(($value.$key -isnot [int] -and $value.$key -isnot [long]) -or $value.$key -lt 0) { throw 'ROOT terminal integer differs' } }
    foreach($key in @('timed_out','capture_overflow','capture_drain_complete','direct_driver_reaped','spent','canonical_qa_native_fit_authority','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound','automatic_cleanup_performed')) { if($value.$key -isnot [bool]) { throw 'ROOT terminal nominal boolean differs' } }
    if ($value.schema_version -ne 1 -or $value.scope -cne $Scope -or $value.exit_code -ne 0 -or $value.timed_out -ne $false -or $value.capture_overflow -ne $false -or $value.capture_drain_complete -ne $true -or $value.direct_driver_reaped -ne $true -or $null -ne $value.failure -or $value.stdout_bytes -gt 131072 -or $value.stderr_bytes -gt 131072 -or $value.driver_sha256 -cne '9f2add33e9dc9c2e3b3931f6565beede64ebe44baff5d07a519104afa6c0ab8d' -or -not (Hex-Pin $value.root_ack_sha256) -or $value.spent -ne $true -or $value.canonical_qa_native_fit_authority -ne $false -or $value.descendant_cleanup_guaranteed -ne $false -or $value.OS_Job_hard_memory_bound -ne $false -or $value.automatic_cleanup_performed -ne $false) { throw 'Physical ROOT unit terminal did not complete successful scoped first entry' }
    [void](Authorization-Stamp $value.finished_utc)
    return $value.root_ack_sha256
}
function After-Authorization($Record) {
    $keys = @('schema_version','record_type','author','scope','phase','created_utc','expires_utc','observer_sha256','profile_sha256','static_review_sha256','owner_sha256','runtime_snapshot','context_selection','before_record_sha256','unit_receipt')
    $names = @($Record.PSObject.Properties.Name)
    if ($Record -isnot [pscustomobject] -or $names.Count -ne 15 -or @($names | Where-Object { $keys -cnotcontains $_ }).Count -ne 0) { throw 'Whole-after authorization exact15 keys differ' }
    foreach ($name in @('record_type','author','scope','phase','observer_sha256','profile_sha256','static_review_sha256','owner_sha256')) {
        if ($Record.$name -isnot [string]) { throw 'Authorization nominal string differs' }
    }
    if (($Record.schema_version -isnot [int] -and $Record.schema_version -isnot [long]) -or $Record.schema_version -ne 1 -or
        $Record.record_type -cne 'consumer_guard_unit005_metadata_observation_authorization' -or
        $Record.author -cne '/root' -or $Record.scope -cne $Scope -or $Record.phase -cne 'after' -or
        $Record.observer_sha256 -cne $ObserverSha -or $Record.profile_sha256 -cne $ProfileSha -or
        $Record.static_review_sha256 -cne $ReviewSha -or $Record.owner_sha256 -cne $OwnerSha -or
        -not (Hex-Pin $Record.before_record_sha256)) { throw 'Whole-after authorization role/pins differ' }
    foreach ($name in @('runtime_snapshot','context_selection')) {
        $pointer = $Record.$name
        if ($pointer -isnot [pscustomobject] -or @($pointer.PSObject.Properties.Name).Count -ne 2 -or
            @($pointer.PSObject.Properties.Name | Where-Object { @('path','sha256') -cnotcontains $_ }).Count -ne 0 -or
            $pointer.path -isnot [string] -or $pointer.path.Length -eq 0 -or $pointer.path.Length -gt 32767 -or
            $pointer.sha256 -isnot [string] -or $pointer.sha256 -cnotmatch '^[0-9a-f]{64}$') { throw 'Whole-after pointer nominal shape differs' }
    }
    Original-Pointer $Record.unit_receipt $ReceiptCopy
    Whole-Before-Result $Record $Record.before_record_sha256
    $actualReceipt=Decode-Captured (Pin $ReceiptCopy $Record.unit_receipt.sha256 262144)
    Driver-Finished $actualReceipt $Record.before_record_sha256
    if ((Root-Unit-Terminal $ExpectedUnitTerminalSha256) -cne $actualReceipt.root_ack_sha256) { throw 'Physical ROOT terminal and scoped driver receipt ACK differ' }
    Original-Context-Fresh $Record
    $created = Authorization-Stamp $Record.created_utc
    $expires = Authorization-Stamp $Record.expires_utc
    $now = [DateTimeOffset]::UtcNow
    $ownerEnd = [DateTimeOffset]::Parse('2026-10-02T22:36:15Z',[Globalization.CultureInfo]::InvariantCulture)
    $age = ($now-$created).TotalSeconds
    if ($age -lt 0 -or $age -gt 600 -or ($expires-$created).TotalSeconds -le 0 -or
        ($expires-$created).TotalSeconds -gt 1800 -or $expires -gt $ownerEnd -or
        ($expires-$now).TotalSeconds -lt 315 -or ($ownerEnd-$now).TotalSeconds -lt 350) { throw 'Fresh authorization,315-second expiry and350-second owner reserves required' }
    return $now
}

if ([IO.Path]::GetFullPath($PSCommandPath) -cne (Join-Path $Meta 'SUPERVISE_ROOT_WHOLE_AFTER_005.ps1')) { throw 'Fixed whole-after supervisor path required' }
[void](Pin $PSCommandPath $ExpectedSelfSha256 65536)
[void](Pin $Python '5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed' 105816)
[void](Pin $Script $ObserverSha 26697)
[void](Pin $Profile $ProfileSha 65536)
[void](Pin $Review $ReviewSha 65536)
[void](Pin $Owner $OwnerSha 65536)
$authBytes = Pin $Auth $ExpectedAuthorizationSha256 65536
foreach ($path in @($Start,$Terminal,$Stdout,$Stderr,(Join-Path $Prep 'whole-runtime-after'))) {
    try { [void](Get-Item -LiteralPath $path -Force -ErrorAction Stop); throw 'One-use whole-after namespace exists' }
    catch [System.Management.Automation.ItemNotFoundException] { }
}
$authRecord = [Text.UTF8Encoding]::new($false,$true).GetString($authBytes) | ConvertFrom-Json
$now = After-Authorization $authRecord
$info = [Diagnostics.ProcessStartInfo]::new()
$info.FileName = $Python
$info.Arguments = '-I -S -B -X utf8 "' + $Script + '" --expected-self-sha256 ' + $ObserverSha + ' --expected-profile-sha256 ' + $ProfileSha + ' --authorization-path "' + $Auth + '" --authorization-sha256 ' + $ExpectedAuthorizationSha256 + ' --static-review-path "' + $Review + '"'
$info.WorkingDirectory = $Prep
$info.UseShellExecute = $false
$info.CreateNoWindow = $true
$info.RedirectStandardInput = $true
$info.RedirectStandardOutput = $true
$info.RedirectStandardError = $true
foreach ($name in @($info.EnvironmentVariables.Keys)) { if ($name -match '^(PYTHON|GIT_)') { $info.EnvironmentVariables.Remove($name) } }
$info.EnvironmentVariables['PYTHONDONTWRITEBYTECODE']='1'
foreach ($name in @('OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS')) { $info.EnvironmentVariables[$name]='1' }
$process = [Diagnostics.Process]::new()
$process.StartInfo = $info
$outFile = $null; $errFile = $null; $watch = [Diagnostics.Stopwatch]::new()
$started = $false; $reaped = $false; $drained = $false; $overflow = $false; $timedOut = $false; $failure = $null; $code = $null; $outBytes = 0; $errBytes = 0
Write-Once $Start ([ordered]@{schema_version=1;created_utc=$now.ToString('o');phase='after';authorization_sha256=$ExpectedAuthorizationSha256;supervisor_sha256=$ExpectedSelfSha256;observer_sha256=$ObserverSha;profile_sha256=$ProfileSha;static_review_sha256=$ReviewSha;metadata_only=$true;consumed=$true;expected_inventory_trees=2;expected_runtime_file_guards=4})
try {
    $outFile = [IO.File]::Open($Stdout,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
    $errFile = [IO.File]::Open($Stderr,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
    # Recheck actual UTC reserves after receipt/capture creation, immediately before entry.
    [void](After-Authorization $authRecord)
    $watch.Start()
    if (-not $process.Start()) { throw 'Whole-before direct child failed to start' }
    $started = $true
    $process.StandardInput.BaseStream.Close()
    $outBuffer = [byte[]]::new(4096); $errBuffer = [byte[]]::new(4096)
    $outTask = $process.StandardOutput.BaseStream.ReadAsync($outBuffer,0,4096)
    $errTask = $process.StandardError.BaseStream.ReadAsync($errBuffer,0,4096)
    $outDone = $false; $errDone = $false
    while (-not ($reaped -and $outDone -and $errDone)) {
        foreach ($channel in @('out','err')) {
            $task = if ($channel -ceq 'out') { $outTask } else { $errTask }
            $done = if ($channel -ceq 'out') { $outDone } else { $errDone }
            if (-not $done -and $task.IsCompleted) {
                $count = $task.GetAwaiter().GetResult()
                if ($count -eq 0) { if ($channel -ceq 'out') { $outDone=$true } else { $errDone=$true } }
                else {
                    $used = if ($channel -ceq 'out') { $outBytes } else { $errBytes }
                    $keep = [Math]::Min($count,65536-$used)
                    if ($channel -ceq 'out') { $outFile.Write($outBuffer,0,$keep); $outBytes += $keep; $outTask=$process.StandardOutput.BaseStream.ReadAsync($outBuffer,0,4096) }
                    else { $errFile.Write($errBuffer,0,$keep); $errBytes += $keep; $errTask=$process.StandardError.BaseStream.ReadAsync($errBuffer,0,4096) }
                    if ($keep -lt $count) { $overflow=$true }
                }
            }
        }
        if (($overflow -or $watch.Elapsed.TotalSeconds -ge 300) -and -not $process.HasExited) { $timedOut=($watch.Elapsed.TotalSeconds -ge 300); $process.Kill() }
        if ($process.HasExited) { $reaped=$process.WaitForExit(0); if ($reaped) { $code=$process.ExitCode } }
        if ($watch.Elapsed.TotalSeconds -ge 315) { throw 'Whole-before cooperative capture/reap budget exhausted' }
        Start-Sleep -Milliseconds 20
    }
    $drained=$true
} catch { $failure=$_.Exception.Message }
finally {
    if ($started -and -not $reaped) {
        try { if (-not $process.HasExited) { $process.Kill() }; $reaped=$process.WaitForExit(1000); if ($reaped) { $code=$process.ExitCode } }
        catch { $failure=([string]$failure)+'; direct child cleanup unproved' }
    }
    if ($null -ne $outFile) { $outFile.Dispose() }
    if ($null -ne $errFile) { $errFile.Dispose() }
    $process.Dispose()
    # Exit0 alone does not reconcile observer metadata. Neither tree observation nor descendant death is inferred.
    Write-Once $Terminal ([ordered]@{schema_version=1;finished_utc=[DateTimeOffset]::UtcNow.ToString('o');phase='after';exit_code=$code;timed_out=$timedOut;capture_overflow=$overflow;capture_drain_complete=$drained;direct_child_reaped=$reaped;failure=$failure;stdout_bytes=$outBytes;stderr_bytes=$errBytes;authorization_sha256=$ExpectedAuthorizationSha256;supervisor_sha256=$ExpectedSelfSha256;observer_sha256=$ObserverSha;profile_sha256=$ProfileSha;static_review_sha256=$ReviewSha;metadata_only=$true;spent=$true;expected_inventory_trees=2;expected_runtime_file_guards=4;whole_inventory_trees_observed=$null;runtime_file_guards_observed=$null;observer_result_reconciled=$false;whole_site_loaded_closure_guaranteed=$false;target_tests_executed=$false;operational_authority_granted=$false;native_authority_granted=$false;descendant_cleanup_guaranteed=$false;OS_Job_hard_memory_bound=$false;unconditional_physical_IO_deadline_guaranteed=$false})
}
if ($timedOut -or $overflow -or $failure -or -not $drained -or -not $reaped -or $code -ne 0) { throw 'Whole-before first entry refused; preserve every output; never replay' }
