        assert reversal.count(newtext)==1,(role,newtext)
        reversal=reversal.replace(newtext,oldtext)
    assert reversal.encode('utf-8')==ob
    ot=ast.parse(ob);nt=ast.parse(nb)
    oldfn=next(n for n in ot.body if isinstance(n,ast.FunctionDef) and n.name=='_raw_helper_value_identity')
    newfn=next(n for n in nt.body if isinstance(n,ast.FunctionDef) and n.name=='_raw_helper_value_identity')
