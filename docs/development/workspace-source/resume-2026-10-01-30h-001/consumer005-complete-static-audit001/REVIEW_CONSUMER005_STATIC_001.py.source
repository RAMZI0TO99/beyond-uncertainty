def sha(b):return hashlib.sha256(b).hexdigest()
def enc(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def once(p,b):
    with p.open('xb') as f:f.write(b)
def raw(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None)]
def read(p):
    a=p.lstat()
    assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not getattr(a,'st_file_attributes',0)&1024 and 0<=a.st_size<=CAP,str(p)
    with p.open('rb') as f:
        b=os.fstat(f.fileno());data=f.read(CAP+1);c=os.fstat(f.fileno())
    d=p.lstat()
    assert raw(a)==raw(d) and raw(b)==raw(c) and len(data)==a.st_size,str(p)
    assert [a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_nlink]==[b.st_dev,b.st_ino,b.st_size,b.st_mtime_ns,b.st_nlink],str(p)
    return data,dict(path=str(p),size=len(data),sha256=sha(data),path_raw9=raw(a),handle_raw9=raw(b))

