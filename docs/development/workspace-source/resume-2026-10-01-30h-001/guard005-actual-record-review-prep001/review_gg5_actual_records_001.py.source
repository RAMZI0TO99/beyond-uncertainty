    nominal(pointer(coord["root_response"]), FIXED["root_coord"][:2], "isolated/no-delivery Root response")
    whole_path, whole_pin = pointer(ack["whole_runtime_before"])
    nominal((whole_path, whole_pin), roles["whole_acceptance"], "actual whole acceptance pointer")
    whole = record(whole_path, whole_pin)
    exact(whole, ("schema_version", "scope", "captured_utc", "verifier", "whole_before_evidence", "unchanged_against_reviewed_runtime", "runtime_snapshot_sha256"), "whole acceptance7")
    nominal(whole["schema_version"], 1, "whole schema"); nominal(whole["scope"], SCOPE, "whole scope")
    nominal(whole["verifier"], "/root/window_docs", "different actual before reviewer")
    nominal(whole["unchanged_against_reviewed_runtime"], True, "actual whole acceptance")
    nominal(whole["runtime_snapshot_sha256"], runtime_pin, "whole runtime reference")
    fresh(whole["captured_utc"], selection["producer_roles"]["whole_acceptance"], 90)
    whole_result_path, whole_result_pin = pointer(whole["whole_before_evidence"])
    nominal(whole_result_path, PREP / "whole-runtime-before/result.json", "actual before result path")
    whole_result = record(whole_result_path, whole_result_pin, 262144)
    exact(whole_result, ("schema_version", "record_type", "scope", "phase", "verdict", "captured_utc", "observer_sha256", "static_review_sha256", "profile_sha256", "owner_sha256", "runtime_snapshot_sha256", "context_selection_sha256", "source_snapshot_sha256", "trees", "observation_files", "before_record_sha256", "unit_receipt", "target_execution", "whole_site_loaded_closure_retained_lock_OS_Job_guaranteed"), "whole result19")
    nominal(whole_result["schema_version"], 1, "whole result schema")
    nominal(whole_result["before_record_sha256"], None, "before no future record")
    nominal(whole_result["unit_receipt"], None, "before no future unit result")
    nominal(whole_result["whole_site_loaded_closure_retained_lock_OS_Job_guaranteed"], False, "no loaded/Job closure")
    nominal(whole_result["record_type"], "consumer_guard_unit005_whole_metadata_result", "whole result role")
    nominal(whole_result["phase"], "before", "before phase"); nominal(whole_result["scope"], SCOPE, "whole result scope")
    nominal(whole_result["verdict"], "MATCHES_PINNED_BYTES_METADATA_TWICE", "whole data verdict")
    for key, expected in (("runtime_snapshot_sha256", runtime_pin), ("profile_sha256", PROFILE_PIN), ("static_review_sha256", STATIC_PIN), ("owner_sha256", OWNER_PIN), ("observer_sha256", OBSERVER_PIN), ("target_execution", False)):
        nominal(whole_result[key], expected, "whole result binding: " + key)
    ticks(whole_result["captured_utc"], "python6")
    nominal(whole_result["source_snapshot_sha256"], sha(canonical(source_snapshot)), "whole source raw9 digest")
    nominal(whole_result["context_selection_sha256"], runtime["context_selection"]["sha256"], "whole context")
    nominal(whole_result["trees"], {"base": {"files": 5368, "directories": 504, "bytes": 155022742, "sha256": "0a5aff918e4a46fae2427a593261f8e3640ba439ba4ffebf5081b15eb7df6760"}, "scripts": {"files": 22, "directories": 0, "bytes": 2145329, "sha256": "baa95b3f7e3e50a9b388fca6c4fd238fb55fc2e62f4cdc07c1b7c57caa9a54ad"}}, "different-reviewer accepted two-tree canonical identities")
    files = whole_result["observation_files"]
    require(type(files) is list and len(files) == 4, "two trees/four evidence files")
    for row, expected_path in zip(files, (PREP / "whole-runtime-before" / (role + "-" + suffix + ".json") for role in ("base", "scripts") for suffix in ("first", "second"))):
        exact(row, ("path", "sha256", "bytes"), "whole observation row3")
        nominal(row["path"], str(expected_path), "whole file path")
        require(type(row["bytes"]) is int and 0 < row["bytes"] <= profile["whole_before_evidence_max_bytes"], "whole finite row cap")
        read(expected_path, row["sha256"], profile["whole_before_evidence_max_bytes"])
    auth = record(*roles["whole_auth"])
    exact(auth, ("schema_version", "record_type", "author", "scope", "phase", "created_utc", "expires_utc", "observer_sha256", "profile_sha256", "static_review_sha256", "owner_sha256", "runtime_snapshot", "context_selection", "before_record_sha256", "unit_receipt"), "whole auth15")
    for key, expected in (("schema_version", 1), ("record_type", "consumer_guard_unit005_metadata_observation_authorization"), ("author", "/root"), ("scope", SCOPE), ("phase", "before"), ("observer_sha256", OBSERVER_PIN), ("profile_sha256", PROFILE_PIN), ("static_review_sha256", STATIC_PIN), ("owner_sha256", OWNER_PIN), ("before_record_sha256", None), ("unit_receipt", None)):
        nominal(auth[key], expected, "before auth field")
    nominal(pointer(auth["runtime_snapshot"]), (runtime_path, runtime_pin), "auth/runtime")
    nominal(auth["context_selection"], runtime["context_selection"], "auth/context")
    auth_start, auth_end = ticks(auth["created_utc"], "powershell7"), ticks(auth["expires_utc"], "powershell7")
    result_time = ticks(whole_result["captured_utc"], "python6")
    require(auth_start <= result_time <= auth_end <= int(OWNER_END.timestamp()) * 10000000, "actual metadata completion within authorized producer clock interval")
    record_data = decode(fixed["bound_template"])
    record_data.update(common)
    record_data.update({"verdict": "PASS_BOUND_STATIC", "reviewer": REVIEWER, "root_ack_sha256": ack_pin, "runtime_snapshot_sha256": runtime_pin, "whole_runtime_before_sha256": whole_pin, "resource_snapshot_sha256": resource_pin, "coordination_ack_sha256": coord_pin})
    output = PREP / "INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_005.json"
    if phase == "late":
        bound_path, bound_pin = roles["bound_review"]
        nominal(bound_path, output, "actual bound22 path")
        nominal(record(bound_path, bound_pin), record_data, "actual bound22 from same inputs")
        launch_path, launch_pin = roles["root_launcher"]
        nominal(launch_path, PREP / "ROOT_FIRST_LAUNCH_005.ps1", "actual Root PS path")
        launch = read(launch_path, launch_pin, 65536)[0].decode("utf8")
        for name, expected in (("BoundDriverSha256", DRIVER_PIN), ("RootAckSha256", ack_pin), ("BoundReviewSha256", bound_pin)):
            pattern = "(?m)^\\$" + name + " = '[0-9a-f]{64}'\\r?$"
            matches = re.findall(pattern, launch)
            require(len(matches) == 1 and matches[0].rstrip("\r") == "$" + name + " = '" + expected + "'", "RootPS exact3 binding")
            launch = re.sub(pattern, lambda unused, n=name: "$" + n + " = $null", launch)
        nominal(launch.encode("utf8"), fixed["root_template"], "RootPS three-literal byte reversal")
        record_data = decode(fixed["late_template"])
        # This new reviewer deadline cannot extend or rewrite the existing ACK.
        # Use integer arithmetic, preserving the distinct genuine producer roles.
        review_now = dt.datetime.now(dt.timezone.utc)
        ack_floor = dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc) + dt.timedelta(microseconds=expires // 10)
        review_expiry = min(review_now + dt.timedelta(minutes=15), ack_floor)
        require(review_expiry - review_now >= dt.timedelta(seconds=450), "late review450s reserve")
        record_data.update({"verdict": "PASS_LATE_BOUND_ONLY", "reviewer": REVIEWER, "root_ack_sha256": ack_pin, "driver_sha256": DRIVER_PIN, "bound_review_sha256": bound_pin, "launch_sha256": launch_pin, "created_utc": review_now.isoformat(timespec="microseconds"), "expires_utc": review_expiry.isoformat(timespec="microseconds")})
        output = PREP / "INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_005.json"
    require(len(record_data) == (22 if phase == "bound" else 14), "closed output key count")
    absent(output)
    proof_path = OWN / ("ACTUAL_" + phase.upper() + "_REVIEW_OBSERVATION_001.json")
    absent(proof_path)
    for p, observed in list(observations.items()):
        read(path(p), observed["sha256"], observed["bytes"])
    check_runtime(runtime, profile)
    fresh(resource["captured_utc"], "powershell7", 60)
    require(now_ticks() + 4500000000 <= expires, "final owner/ACK reserve")
    for name in ("ROOT_LAUNCH_START_005.json", "ROOT_LAUNCH_TERMINAL_005.json", "ROOT_LAUNCH_STDOUT_005.txt", "ROOT_LAUNCH_STDERR_005.txt"):
        absent(PREP / name)
    absent(PROJECT / ".tmp/cg14-005")
    proof = {"schema_version": 1, "record_type": "gg5_actual_" + phase + "_review_observation", "reviewer": REVIEWER, "captured_utc": dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"), "selection_sha256": args.selection_sha256, "utility_sha256": args.expected_self_sha256, "unique_input_count": len(observations), "input_byte_raw9_digest": sha(canonical(observations)), "current_tracked_rows": 742, "configuration_rows": 55, "runtime_files": 4, "whole_tree_inventory_performed_by_this_utility": False, "two_tree_before_proof_accepted_by_different_reviewer": True, "target_execution": False, "input_resource_age_seconds_limit": 60, "context_age_seconds_limit": 90, "future_root_fresh_prelaunch_checks_required": True, "canonical_native_fullQA_lease_quiet_or_science_authority": False, "no_deadline_refresh_or_clock_reissue": True, "pro3_request_HELD_no_delivery_ACK_or_native_lease": True}
    proof_row = publish_once(proof_path, proof, 65536)
    output_row = publish_once(output, record_data, 65536)
    print(json.dumps({"review": output_row, "observation": proof_row, "scope": SCOPE, "target_execution": False}, sort_keys=True))


if __name__ == "__main__":
    main()
