def require(value, reason):
    if not value:
        raise ValueError(reason)


def sha(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False) + "\n").encode("ascii")


def exact(value, keys, reason):
    require(type(value) is dict and set(value) == set(keys), reason)


def nominal(value, expected, reason):
    require(type(value) is type(expected) and value == expected, reason)
    if type(expected) is dict:
        require(set(value) == set(expected), reason)
        for key in expected:
            nominal(value[key], expected[key], reason + ":" + key)
    elif type(expected) in (list, tuple):
        require(len(value) == len(expected), reason)
        for index, item in enumerate(expected):
            nominal(value[index], item, reason + ":" + str(index))


def hexpin(value, length=64):
    require(type(value) is str and re.fullmatch("[0-9a-f]{" + str(length) + "}", value), "exact SHA domain")
    return value


def unique(rows):
    out = {}
    for key, value in rows:
        require(key not in out, "duplicate JSON key")
        out[key] = value
    return out


def reject_number(unused):
    raise ValueError("floating/nonfinite JSON numbers prohibited")


def decode(data, canonical_bytes=False):
    require(type(data) is bytes, "JSON bytes")
    value = json.loads(data.decode("utf8", errors="strict"), object_pairs_hook=unique, parse_float=reject_number, parse_constant=reject_number)
    if canonical_bytes:
        require(data == canonical(value), "canonical compact ASCII plus LF required")
    return value


def path(value):
    require(type(value) is str and len(value) <= 1024, "nominal pathname")
    p = Path(value)
    require(p.is_absolute() and ".." not in p.parts and all(":" not in component for component in p.parts[1:]) and (p.is_relative_to(PROJECT) or str(p) in EXTERNAL_CONFIGS), "project-confined plain path or exact external configuration role")
    return p


def raw(info):
    values = [getattr(info, key, None) for key in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns", "st_mode", "st_nlink", "st_file_attributes", "st_birthtime_ns")]
    require(all(type(item) is int for item in values), "Windows raw9 exact integers")
    return values


def parents(p):
    out = []
    for parent in reversed(p.parents):
        info = parent.lstat()
        require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode) and not info.st_file_attributes & 0x400, "plain ancestor")
        out.append((str(parent), info.st_dev, info.st_ino))
    return out


def read(p, pin=None, maximum=2097152):
    p = path(str(p))
    require(type(maximum) is int and 0 <= maximum <= 8388608, "finite pre-read cap")
    if pin is not None:
        hexpin(pin)
    ancestors = parents(p)
    a = p.lstat(); ar = raw(a)
    require(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and not a.st_file_attributes & 0x400 and 0 <= a.st_size <= maximum, "plain bounded single-link file")
    require(a.st_ctime_ns == a.st_birthtime_ns, "path creation field")
    fd = os.open(p, os.O_RDONLY | os.O_BINARY)
    chunks = []; total = 0
    try:
        h = os.fstat(fd); hr = raw(h)
        require(stat.S_ISREG(h.st_mode) and h.st_nlink == 1 and not h.st_file_attributes & 0x400, "plain owned read handle")
        require(all(ar[i] == hr[i] for i in (0, 1, 2, 3, 6, 7, 8)), "canonical cross creation/identity")
        if a.st_mode != h.st_mode:
            role = EXECUTABLES.get(str(p).casefold())
            require(role is not None and pin == role[0] and a.st_size == role[1] and a.st_mode & 0o111 == 0o111 and h.st_mode & 0o111 == 0 and a.st_mode & ~0o111 == h.st_mode & ~0o111, "only fixed byte-pinned executable projection")
        while True:
            block = os.read(fd, min(1048576, maximum + 1 - total))
            if not block:
                break
            total += len(block); require(total <= maximum, "read cap")
            chunks.append(block)
        require(raw(os.fstat(fd)) == hr, "same-handle raw9 drift")
    finally:
        os.close(fd)
    require(raw(p.lstat()) == ar and parents(p) == ancestors, "same-path raw9/ancestor drift")
    data = b"".join(chunks)
    require(len(data) == a.st_size and (pin is None or sha(data) == pin), "byte pin/size")
    observation = {"bytes": len(data), "sha256": sha(data), "path_raw9": ar, "descriptor_raw9": hr}
    previous = observations.get(str(p))
    require(previous is None or previous == observation, "input changed between review observations")
    observations[str(p)] = observation
    return data, observation


def record(p, pin, maximum=65536):
    return decode(read(p, pin, maximum)[0])


def pointer(value):
    exact(value, ("path", "sha256"), "pointer2")
    return path(value["path"]), hexpin(value["sha256"])


def absent(p):
    parents(p)
    try:
        p.lstat()
    except FileNotFoundError:
        return
    raise ValueError("create-once role already exists: " + str(p))


def ticks(value, role):
    digits = 6 if role == "python6" else 7 if role == "powershell7" else None
    require(digits is not None and type(value) is str and re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{" + str(digits) + r"}\+00:00", value), "genuine producer UTC role")
    base = dt.datetime.strptime(value[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc)
    delta = base - dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc)
    return (delta.days * 86400 + delta.seconds) * 10000000 + int(value[20:20 + digits]) * (10 if digits == 6 else 1)


def now_ticks():
    return ticks(dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"), "python6")


def fresh(value, role, seconds):
    age = now_ticks() - ticks(value, role)
    require(0 <= age <= seconds * 10000000, "freshness budget exhausted")
    return age / 10000000


def metadata_row(p, value, maximum):
    exact(value, ("path", "sha256", "bytes", "path_raw9", "descriptor_raw9"), "closed metadata row5")
    nominal(value["path"], str(p), "fixed metadata path")
    require(type(value["bytes"]) is int and 0 <= value["bytes"] <= maximum, "nominal file size")
    for key in ("path_raw9", "descriptor_raw9"):
        require(type(value[key]) is list and len(value[key]) == 9 and all(type(x) is int for x in value[key]), "nominal raw9")
    _, observed = read(p, value["sha256"], maximum)
    nominal(observed, {key: value[key] for key in observed}, "actual byte/raw9 row")


def check_context(value, profile):
    exact(value, ("schema_version", "scope", "captured_utc", "head", "tracked_rows", "git_metadata", "configurations", "runtime_roles_projection_sha256"), "closed opaque8")
    nominal(value["schema_version"], 1, "context schema"); nominal(value["scope"], SCOPE, "context scope")
    nominal(value["runtime_roles_projection_sha256"], profile["runtime_roles_projection_sha256"], "roles projection")
    fresh(value["captured_utc"], "python6", 90); hexpin(value["head"], 40)
    cfg = profile["context_profile"]
    require(type(value["tracked_rows"]) is list and len(value["tracked_rows"]) == 742, "tracked742")
    names = [row["path"] for row in value["tracked_rows"]]
    require(all(type(x) is str for x in names) and names == sorted(names) and len({x.casefold() for x in names}) == 742 and sha(canonical(names)) == cfg["historical_authenticated_pathset_sha256"], "exact known742 pathset")
    for row in value["tracked_rows"]:
        rel = PurePosixPath(row["path"])
        require(not rel.is_absolute() and ".." not in rel.parts and rel.as_posix() == row["path"] and len(row["path"]) <= 399 and ":" not in row["path"] and "\\" not in row["path"], "safe relative current row")
        actual = dict(row); actual["path"] = str(Path(cfg["live_root"]) / row["path"])
        metadata_row(path(actual["path"]), actual, cfg["maximum_file_bytes"])
    expected_git = cfg["head_paths"] + cfg["optional_git_metadata_paths"]
    expected_config = [str(Path(parent) / name) for parent in cfg["configuration_parents"] for name in cfg["configuration_names"]]
    require(len(expected_config) == 55, "config55")
    for field, coverage in (("git_metadata", expected_git), ("configurations", expected_config)):
        require(type(value[field]) is list and [row["path"] for row in value[field]] == coverage, "finite optional coverage")
        for row in value[field]:
            exact(row, ("path", "exists", "identity"), "optional row3")
            require(type(row["exists"]) is bool, "nominal existence")
            if row["exists"]:
                metadata_row(path(row["path"]), row["identity"], cfg["maximum_git_metadata_bytes"])
            else:
                nominal(row["identity"], None, "absent identity"); absent(path(row["path"]))
                require(field != "git_metadata" or row["path"] not in cfg["head_paths"], "required HEAD role exists")
    branch = path(cfg["head_paths"][-1])
    pin = next(row["identity"]["sha256"] for row in value["git_metadata"] if row["path"] == str(branch))
    nominal(read(branch, pin, 128)[0].decode("ascii").strip(), value["head"], "observed HEAD bytes")


def reverse_literals(data, bindings):
    text = data.decode("utf8", errors="strict"); lines = text.splitlines(keepends=True)
    offsets = []; found = set()
    for node in ast.parse(text).body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name) and node.targets[0].id in bindings:
            name = node.targets[0].id
            require(name not in found and isinstance(node.value, ast.Constant), "single literal binding")
            nominal(node.value.value, bindings[name], "exact source binding value")
            found.add(name)
            start = sum(map(len, lines[:node.value.lineno - 1])) + node.value.col_offset
            end = sum(map(len, lines[:node.value.end_lineno - 1])) + node.value.end_col_offset
            offsets.append((start, end))
    require(found == set(bindings), "complete exact source bindings")
    for start, end in sorted(offsets, reverse=True):
        text = text[:start] + "None" + text[end:]
    return text.encode("utf8")


def source_inputs(profile, fixed):
    nominal(reverse_literals(fixed["driver"], {"SOURCE003_PEER_SHA256": SOURCE_PIN, "HARNESS_STATIC_PEER_SHA256": STATIC_PIN}), fixed["driver_template"], "two-literal driver reversal")
    nominal(sha(reverse_literals(fixed["observer"], {"HARNESS_STATIC_PEER_SHA256": STATIC_PIN})), profile["whole_observer"]["sha256"], "one-literal observer reversal")
    nominal(sha(fixed["source_manifest"]), profile["source_manifest_sha256"], "source manifest")
    source = decode(fixed["source_peer"])
    for key, expected in (("reviewer", "/root/keepawake_stage"), ("reviewer_agent", "/root/keepawake_stage"), ("source_author", "/root/bootstrap_stage"), ("source_authors", ["/root/raw_policy_worker", "/root/bootstrap_stage"]), ("verdict", "PASS_STATIC_SOURCE_AND_TESTS_ONLY"), ("manifest_sha256", SOURCE_MANIFEST_PIN), ("test_template_sha256", profile["test"]["sha256"]), ("source_bindings", profile["consumer_source_bindings"]), ("raw_policy_facts", profile["raw_policy_facts"])):
        nominal(source[key], expected, "immutable source peer core: " + key)
    static = decode(fixed["static"])
    static_model = {"schema_version": 1, "record_type": "consumer_guard_unit005_harness_static_review", "verdict": "PASS_STATIC_PREPARATION_ONLY", "scope": SCOPE, "author": AUTHOR, "reviewer": "/root/window_docs", "driver_template_sha256": TEMPLATE_PIN, "child_template_sha256": profile["child"]["sha256"], "source_manifest_sha256": SOURCE_MANIFEST_PIN, "consumer_source_peer_sha256": SOURCE_PIN, "profile_sha256": PROFILE_PIN, "source_projection_sha256": profile["source_projection_sha256"], "raw_source_sha256": profile["raw_source_sha256"], "test_sha256": profile["test"]["sha256"], "owner_sha256": OWNER_PIN, "runtime_manifest_sha256": profile["runtime_roles_projection_sha256"], "tests_executed": False, "target_definitions_executed": False, "native_authority": False}
    exact(static, set(static_model) | {"limitation"}, "closed immutable static20")
    for key, expected in static_model.items():
        nominal(static[key], expected, "static source fact: " + key)
    require(type(static["limitation"]) is str and 0 < len(static["limitation"]) <= 4096, "static source-only qualification")
    projection = profile["source_projection"]
    q = record(PREP / projection["path"], projection["sha256"], 2097152)
    result = []
    for row in q["entries"]:
        if not row["runtime_source_reobserve_required"]:
            continue
        left = path(row["original_path"]); rel = PurePosixPath(row["copy_path"])
        require(not rel.is_absolute() and ".." not in rel.parts, "confined source copy")
        right = PREP / str(rel)
        lb, lm = read(left, row["sha256"], row["bytes"])
        rb, rm = read(right, row["sha256"], row["bytes"])
        nominal(lb, rb, "source/copy bytes")
        nominal(lm, row["original_metadata"], "source raw9"); nominal(rm, row["copy_metadata"], "copy raw9")
        require(lm["path_raw9"][:2] != rm["path_raw9"][:2], "independent source/copy inode")
        result.append({"path": row["copy_path"], "original": lm, "copy": rm})
    return result


def check_runtime(value, profile):
    exact(value, ("schema_version", "scope", "captured_utc", "entries", "context_selection"), "closed runtime5")
    nominal(value["schema_version"], 1, "runtime schema"); nominal(value["scope"], SCOPE, "runtime scope")
    fresh(value["captured_utc"], "python6", 90)
    require(type(value["entries"]) is list and len(value["entries"]) == 4, "four files")
    for actual, fixed in zip(value["entries"], profile["runtime4_roles"]):
        nominal(actual["path"], fixed["path"], "fixed runtime path"); nominal(actual["sha256"], fixed["sha256"], "fixed runtime SHA")
        nominal(actual["bytes"], fixed["size"], "runtime size")
        metadata_row(path(actual["path"]), actual, fixed["size"])
    cp, cs = pointer(value["context_selection"])
    check_context(record(cp, cs, profile["context_profile"]["maximum_opaque_context_bytes"]), profile)


def metadata_source_closure(selection, roles, fixed):
    root = WORK / "guard005-root-metadata-prep002"
    nominal(roles["metadata_source_review"][0], root / "INDEPENDENT_METADATA_STATIC_REVIEW_005.json", "fixed new preparer peer")
    preparer = record(*roles["metadata_source_review"], maximum=2097152)
    nominal(preparer["verdict"], "PASS_STATIC_METADATA_PREPARATION_ONLY", "new metadata source scope")
    nominal(preparer["reviewer"], "/root/window_docs", "different metadata source reviewer")
    nominal(roles["metadata_source_binding"][0], root / "ACTUAL_SOURCE_BINDING_002.json", "actual binder provenance path")
    binding = record(*roles["metadata_source_binding"])
    exact(binding, ("schema_version", "binder", "template_sha256", "actual_script_sha256", "bindings", "role_selections", "exact_four_assignment_reversal", "exact17_function_ASTs", "actual_before_authorization", "actual_after_authorization", "target_capture_executed"), "actual metadata source binding11")
    for key, expected in (("schema_version", 1), ("binder", "/root"), ("template_sha256", sha(fixed["metadata_template"])), ("exact_four_assignment_reversal", True), ("exact17_function_ASTs", True), ("actual_before_authorization", None), ("actual_after_authorization", None), ("target_capture_executed", False)):
        nominal(binding[key], expected, "source binder field: " + key)
    plan = decode(fixed["metadata_binding_plan"])
    expected_bindings = dict(plan["bindings"])
    expected_bindings["preparer_static_review_sha256"] = roles["metadata_source_review"][1]
    require(len(expected_bindings) == 9, "finite metadata nine pins")
    for value in expected_bindings.values():
        hexpin(value)
    nominal(binding["bindings"], expected_bindings, "metadata nine actual source pins")
    nominal(binding["role_selections"], plan["role_selections"], "metadata exact three source roles")
    nominal(roles["metadata_bound_source"], (root / "capture-guard005-root-metadata.BOUND.py", binding["actual_script_sha256"]), "metadata actual source role")
    bound = read(*roles["metadata_bound_source"], maximum=65536)[0]
    old_text, new_text = fixed["metadata_template"].decode("utf8"), bound.decode("utf8")
    old_tree, new_tree = ast.parse(old_text), ast.parse(new_text)
    old_functions = [ast.dump(n, include_attributes=False) for n in old_tree.body if isinstance(n, ast.FunctionDef)]
    new_functions = [ast.dump(n, include_attributes=False) for n in new_tree.body if isinstance(n, ast.FunctionDef)]
    require(len(old_functions) == 17 and old_functions == new_functions, "metadata exact seventeen function ASTs")
    names = dict(plan["role_selections"], BINDINGS=expected_bindings)
    old_assignments = {n.targets[0].id: n.value for n in old_tree.body if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names}
    edits = []; found = set(); lines = new_text.splitlines(keepends=True)
    for n in new_tree.body:
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names:
            name = n.targets[0].id
            require(name not in found, "unique metadata assignment")
            nominal(ast.literal_eval(n.value), names[name], "exact metadata nine-plus-three binding")
            found.add(name)
            start = sum(map(len, lines[:n.value.lineno - 1])) + n.value.col_offset
            end = sum(map(len, lines[:n.value.end_lineno - 1])) + n.value.end_col_offset
            edits.append((start, end, ast.get_source_segment(old_text, old_assignments[name])))
    require(found == set(names) and len(edits) == 4, "four selected top-level assignments")
    for start, end, original in sorted(edits, reverse=True):
        new_text = new_text[:start] + original + new_text[end:]
    nominal(new_text.encode("utf8"), fixed["metadata_template"], "metadata exact nine-plus-three source byte reversal")
    nominal(roles["metadata_bound_review"][0], root / "INDEPENDENT_BOUND_METADATA_REVIEW_005.json", "actual metadata bound peer path")
    peer = record(*roles["metadata_bound_review"])
    exact(peer, ("actual_script_sha256", "metadata_only", "phase_set", "record_type", "reviewer", "schema_version", "source_author", "source_bindings", "verdict"), "metadata bound peer9")
    for key, expected in (("actual_script_sha256", binding["actual_script_sha256"]), ("metadata_only", True), ("phase_set", ["before", "after"]), ("record_type", "guard005_root_metadata_bound_source_review"), ("reviewer", "/root/window_docs"), ("schema_version", 1), ("source_author", "/root/bootstrap_stage"), ("source_bindings", expected_bindings), ("verdict", "PASS_STATIC_BOUND_METADATA_ONLY")):
        nominal(peer[key], expected, "actual different metadata bound peer: " + key)


def publish_once(p, value, maximum):
    data = canonical(value); require(len(data) <= maximum, "finite output")
    absent(p)
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_BINARY, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
    nominal(read(p, sha(data), maximum)[0], data, "review readback")
    return {"path": str(p), "sha256": sha(data), "bytes": len(data)}


def main():
    parser = argparse.ArgumentParser()
    for name in ("expected-self-sha256", "selection", "selection-sha256"):
        parser.add_argument("--" + name, required=True)
    args = parser.parse_args()
    require(os.name == "nt" and sys.version_info[:3] == (3, 13, 5) and sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1 and sys.flags.utf8_mode == 1 and sys.flags.optimize == 0, "isolated pinned metadata utility flags/version")
    nominal(Path(sys.executable).absolute(), BASE_PYTHON, "direct pinned metadata interpreter")
    read(BASE_PYTHON, "5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed", 105816)
    nominal(Path(__file__).absolute(), SELF, "fixed utility source")
    read(SELF, hexpin(args.expected_self_sha256), 131072)
    selection = record(path(args.selection), hexpin(args.selection_sha256))
    exact(selection, SELECTION_KEYS, "external selection6")
    nominal(selection["schema_version"], 1, "selection schema")
    nominal(selection["record_type"], "root_selected_gg5_actual_record_review_001", "selection role")
    require(selection["phase"] in ("bound", "late"), "known phase")
    phase = selection["phase"]
    exact(selection["roles"], SELECTION_ROLES, "selection fixed roles")
    exact(selection["producer_roles"], UTC_ROLES, "selected genuine producer roles")
    exact(selection["approval_cores"], APPROVAL_ROLES, "prior-stage independent actual review selections")
    for role in UTC_ROLES:
        require(selection["producer_roles"][role] in ("python6", "powershell7"), "finite producer role")
    roles = {}
    for role in SELECTION_ROLES:
        value = selection["roles"][role]
        if phase == "bound" and role in ("bound_review", "root_launcher"):
            nominal(value, None, "no future source binding cycle")
        else:
            roles[role] = pointer(value)
    fixed = {role: read(p, pin, maximum)[0] for role, (p, pin, maximum) in FIXED.items()}
    profile = decode(fixed["profile"])
    nominal(profile["scope"], SCOPE, "profile scope")
    require(now_ticks() < int(OWNER_END.timestamp()) * 10000000, "owner deadline")
    source_snapshot = source_inputs(profile, fixed)
    nominal(roles["root_writer"], FIXED["root_writer"][:2], "externally pinned distinct Root writer2")
    writer = fixed["root_writer"]
    nominal(writer.replace(b"guard005-root-metadata-prep002", b"guard005-root-metadata-prep001"), fixed["root_writer_before"], "only reviewed Meta path retarget; no other Root writer code")
    for role in APPROVAL_ROLES:
        approval = record(*roles[role], maximum=2097152)
        specification = selection["approval_cores"][role]
        exact(specification, ("keys", "values"), "selected exact review shape and core")
        require(type(specification["keys"]) is list and all(type(x) is str for x in specification["keys"]) and len(set(specification["keys"])) == len(specification["keys"]), "finite selected closed approval keys")
        exact(approval, specification["keys"], "actual closed stage review")
        core = specification["values"]
        require(type(core) is dict and len(core) >= 3 and type(core.get("verdict")) is str and core["verdict"].startswith("PASS") and core.get("reviewer") in ELIGIBLE and core["reviewer"] != REVIEWER, "externally selected different independent actual-stage approval")
        for key, expected in core.items():
            nominal(approval[key], expected, "prior-stage authentic actual review core: " + key)
        for key in ("created_utc", "captured_utc"):
            if key in approval:
                ticks(approval[key], selection["producer_roles"][role])
    metadata_source_closure(selection, roles, fixed)
    ack_path, ack_pin = roles["ack"]
    nominal(ack_path, PREP / "ROOT_EXECUTION_ACK_GUARD_UNIT005.json", "fixed actual ACK")
    ack = record(ack_path, ack_pin)
    template = record(PREP / "ROOT_EXECUTION_ACK_GUARD_UNIT005.TEMPLATE.json", "1ebff89c7ff924102d4ca97b93c96171dde4335a8ffc247fea71763a41bb9d50")
    exact(ack, template, "closed ACK22")
    for key, expected in template.items():
        if expected is not None:
            nominal(ack[key], expected, "ACK fixed nominal: " + key)
    common = {"driver_sha256": DRIVER_PIN, "harness_static_review_sha256": STATIC_PIN, "owner_sha256": OWNER_PIN, "child_sha256": profile["child"]["sha256"], "profile_sha256": PROFILE_PIN, "source_peer_sha256": SOURCE_PIN, "source_manifest_sha256": SOURCE_MANIFEST_PIN, "source_projection_sha256": profile["source_projection_sha256"]}
    for key, expected in common.items():
        nominal(ack[key], expected, "ACK current source field: " + key)
    nominal(ack["decision"], "execute_copied_consumer_guard_unit005_once", "ACK scope decision")
    created, expires = ticks(ack["created_utc"], "powershell7"), ticks(ack["expires_utc"], "powershell7")
    require(created <= now_ticks() and now_ticks() + 4500000000 <= expires <= int(OWNER_END.timestamp()) * 10000000 and 0 < expires - created <= 5 * 3600 * 10000000, "actual ACK owner/450s reserve")
    runtime_path, runtime_pin = pointer(ack["runtime_snapshot"])
    runtime = record(runtime_path, runtime_pin)
    check_runtime(runtime, profile)
    resource_path, resource_pin = pointer(ack["resource_snapshot"])
    resource = record(resource_path, resource_pin)
    exact(resource, ("schema_version", "scope", "captured_utc", "free_ram_bytes", "disk_free_bytes", "single_thread", "author"), "resource7")
    for key, expected in (("schema_version", 1), ("scope", SCOPE), ("single_thread", True), ("author", "/root")):
        nominal(resource[key], expected, "resource nominal")
    require(type(resource["free_ram_bytes"]) is int and resource["free_ram_bytes"] >= 1073741824 and type(resource["disk_free_bytes"]) is int and resource["disk_free_bytes"] >= 10737418240, "resource snapshot floors")
    fresh(resource["captured_utc"], "powershell7", 60)
    coord_path, coord_pin = pointer(ack["coordination_acknowledgement"])
    coord = record(coord_path, coord_pin)
    exact(coord, ("schema_version", "scope", "created_utc", "other_session_acknowledgement", "root_response", "live_execution_authorized"), "coordination6")
    nominal(coord["schema_version"], 1, "coord schema"); nominal(coord["scope"], SCOPE, "coord scope")
    nominal(coord["live_execution_authorized"], False, "no live execution/lease/quiet")
    ticks(coord["created_utc"], "powershell7")
