"""Distinct one-use documentation correction; preserve refused026 and all history."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib, json, os, re
root = Path('D:/Aenv/pro2')
base = root / 'resume-2026-10-01-30h-001'
before = base / 'root-docs-before-major027'
copies = base / 'root-docs-inputs-major027'
checkpoint = base / '30H_RESUME_CHECKPOINT_027.md'
names = [
    '30H_RESUME_CHECKPOINT_026.md', 'DOCS_REFRESH_AUDIT_026.json',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_026.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_026.md',
    'consumer-guard-test-runtime005/run-consumer-guard-unit005.py',
    'consumer-guard-test-runtime005/inputs/ACTUAL_SOURCE_PEER_003.json',
    'consumer005-complete-static-audit001/INDEPENDENT_CONSUMER005_COMPLETE_SOURCE_REVIEW_001.json',
    'consumer005-isolated-unit-harness-design001/HARNESS_SOURCE_DESIGN_001.json',
    'consumer005-isolated-unit-harness-design001/HARNESS_SOURCE_DESIGN_001.md',
    'guard005-root-metadata-prep002/independent-fast-metadata-readiness001/READY_COMMANDS_AND_RECORD_RULES_001.json',
    'guard005-root-metadata-prep002/independent-fast-metadata-readiness001/HANDOFF.md',
    'guard005-root-metadata-prep002/independent-fast-metadata-readiness001/READINESS_MANIFEST_001.json',
]
for path in (before, copies, checkpoint, base / 'DOCS_REFRESH_AUDIT_027.json'):
    assert not path.exists(), str(path)
inputs = {name: (base / name).read_bytes() for name in names}
sha = lambda data: hashlib.sha256(data).hexdigest()
peer = json.loads(inputs[names[2]])
assert peer['verdict'] == 'REFUSED_DOCUMENTATION_FROZEN_CREATION_SCOPE_ONLY'
old_peer = json.loads(inputs[names[5]])
new_peer = json.loads(inputs[names[6]])
assert len(old_peer) == 51 and len(old_peer['raw_policy_facts']) == 12
assert len(new_peer) == 38 and 'raw_policy_facts' not in new_peer
assert len(inputs[names[6]]) == 2553985 > 2097152
driver = inputs[names[4]].decode()
assert 'exact(facts, profile["raw_policy_facts"], "source003 authentic12 raw policy facts")' in driver
assert 'for key,value in profile["source003_peer_core"].items()' in driver
now = datetime.now(timezone.utc)
assert now < datetime(2026, 10, 2, 22, 36, 15, tzinfo=timezone.utc)
stamp = now.isoformat(timespec='microseconds')
absent = [base / 'guard005-root-metadata-prep002/ROOT_METADATA_AUTHORIZATION_BEFORE_005.json',
          base / 'guard005-root-metadata-prep002/phase-before-005',
          base / 'consumer-guard-test-runtime005/ROOT_WHOLE_BEFORE_AUTHORIZATION_005.json',
          base / 'consumer-guard-test-runtime005/ROOT_EXECUTION_ACK_GUARD_UNIT005.json',
          base / 'consumer-guard-test-runtime005/ROOT_LAUNCH_START_005.json', root / '.tmp/cg14-005']
for path in absent:
    assert not path.exists(), str(path)
old_body = inputs[names[0]].decode()
wrong = '''Its source peer reader
expects 12 keys and at most 2 MiB; the new complete peer has 38 keys and 2,553,985
bytes.'''
right = '''Its source peer reader
uses a general 2 MiB cap, selected typed top-level core fields, and an exact
12-key NESTED raw_policy_facts object. The old source peer has 51 top-level keys.
The new complete peer has 38 top-level keys and 2,553,985 bytes, and lacks that
old nested object and old selected core/source bindings. A direct reuse is
incompatible; there is no old exact-12 top-level schema guard.'''
assert old_body.count(wrong) == 1
body = old_body.replace(wrong, right)
body = body.replace('Its latest author report describes', 'Its earlier preserved author report describes')
body = body.replace('Its current common draft is 178,891 bytes and is not frozen or\naccepted.',
                    'That author-reported common draft was 178,891 bytes at the report,\n+was not frozen or accepted, and ongoing draft edits may change it.')
body = body.replace('# Major step026 - complete consumer source audit; isolated runtime preparations ready',
                    '# Major step027 - source-peer schema precision corrected; actual validation still unrun', 1)
body = re.sub(r'Recorded [^\n]+\. The local/private owner window ends',
              'Recorded ' + stamp + '. The local/private owner window ends', body, count=1)
precision = f'''\n[Documentation026 refusal](INDEPENDENT_DOCS_REFRESH_REVIEW_026.json),
{sha(inputs[names[2]])[:8]}, correctly refuses the earlier top-level schema
comparison. Root independently corroborated the exact old51/new38 counts,
the nested12 policy check and the 2 MiB overrun in read-only tool8ca42b.
The earlier checkpoint, five primary before copies and author harness design
remain preserved; their mistaken sentence is history, not accepted current
guidance. This distinct correction changes documentation only. The harness
design remains unapproved and requires its own precision supplement and
different design review before any future implementation. Runtime has not begun.
Window readiness001's Doc26 acceptance condition is superseded: a different
unconditional **Doc27 creation-scope PASS** is required before the timer.
At unit GO, BOTH original context and runtime age must be <=90 seconds,
leaving at least510 seconds for Root450 plus after60 nominal reserves.
The older450-remaining sentence alone is insufficient for those full budgets;
provider responsiveness and a physical deadline are still unproved.
'''
anchor = '\n\n[Documentation025 peer]'
assert body.count(anchor) == 1
body = body.replace(anchor, '\n' + precision + '\n[Documentation025 peer]', 1)
body = body.replace('Different documentation peer must accept\nthis checkpoint before',
                    'Different Doc27 documentation peer must accept\nthis checkpoint before')
primary = [root / 'AGENTS.md', root / 'HANDOFF.md', root / 'START_HERE.md',
           root / 'resume-2026-09-28-001/SESSION.md', base / 'RESOURCE_COORDINATION.md']
old = {path: path.read_bytes() for path in primary}
header = f'''**MAJOR STEP027 - DOC026 PRECISION REFUSAL PRESERVED; OLD SOURCE PEER51 TOP-LEVEL/NESTED12 DISTINCTION CORRECTED; ALL ACTUAL VALIDATION STILL UNRUN.**
Recorded {stamp}. Owner ends2026-10-02T22:36:15Z. Read [checkpoint027](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_027.md), HANDOFF, START_HERE and newest SESSION. DifferentDoc26peer e3fa4424 REFUSED the mistaken12-to38 top-level comparison. Rootread8ca42b corroborates old51topkeys/nestedraw_policy_facts exact12/selectedtypedcore; new38topkeys2553985 lacksoldnested/core and exceeds2MiB. Refused026/harnessdesign1/history stay exact. Distinct027 documentation correction only; sourceConsumer005 completeSTATIC acceptance and BEFORE006/AFTER002 scoped sourcePASS unchanged, mains/currenttests/freshphasesUNRUN. Window readiness001 Doc26 condition superseded by different unconditionalDoc27PASS beforetimer; BOTH originalcontext/runtimeage<=90 atunitGO leaves510 forRoot450+after60; resource60, provider/physicaldeadline limits unchanged. NextGG5oldConsumer3copied14only; futureConsumer5harness awaitsprecision/differentdesignpeer/choices. Canonical-Pro3HELD/no soleACK/lease/quiet/no sourceapply/native. Preserve frozen science/twins/epoch/attempts/history/caps/reserves/no-public/no-replay/monitorrestorecloseout. Earlier bytes remain exact history.

'''.encode()
handoff = re.sub(r'\]\(([^)]+)\)', lambda m: '](resume-2026-10-01-30h-001/' + m.group(1) + ')',
                 body.replace(body.split('\n')[0], '# Current pro2 handoff - major step027', 1)).encode()
start = b'''# Start here

Read [HANDOFF](HANDOFF.md), [checkpoint027](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_027.md) and newest [SESSION](resume-2026-09-28-001/SESSION.md).

Documentation026 was refused for a schema comparison mistake. The old source peer has 51 top-level keys and a nested exact12 policy object; the new peer has38 keys, different core/bindings and2,553,985bytes above the old2MiB reader cap. Checkpoint027 corrects the description while preserving the refused checkpoint and unapproved harness design.

Consumer005 source/causal preparation and fast BEFORE006/AFTER002 scoped source reviews remain accepted. All current tests and fresh actual phases are unrun. The prepared copied14 Consumer003 baseline may run only after different Doc27 creation PASS and ready callbacks. Keep BOTH original context/runtime age<=90 atGO (510remaining), resource60 and unchanged450+60 budgets; fix primary docs throughout before/unit/after. No replay or retimestamp.

Publication/native work is unfrozen source authoring with hard caps unchanged. Canonical live actions and Pro3 remain held without sole-executor ACK, lease or quiet. Owner ends2026-10-02T22:36:15Z; preserve science/history/epoch/spent attempts/no-public boundaries and monitor restoration at closeout.
'''
entry = f'''\n\n## {stamp} - ROOT MAJOR027: Doc26 schema precision refusal preserved and corrected before actual timer

[Checkpoint027](../resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_027.md). Doc26different e3fa4424 REFUSED creation-scope claim: oldsourcepeerTOP51/nestedraw_policy_factsEXACT12/selectedtypedcore, not12top-level. Rootindependent8ca42b corroborates; newTOP38/2553985>2097152/missingoldnested-core-bindings makesdirectreuseincompatible. Preserve026checkpoint/currentbeforecopies/unapprovedharnessdesign1/errorhistory; new027docsonly correction. Consumer005completeSourcePASS andBefore006/After002SourcePASS unchanged/currenttestsALLUNRUN/actualphasesABSENT. WindowreadinessDoc26condition supersededbydifferentunconditionalDoc27creationPASSbeforetimer. BOTH originalcontext/runtimeage<=90unitGO yields510forRoot450+after60/resource<=60throughspawn/provider-physicaldeadline-unproved/noTTLextend/no replayretimestamp. GG5oldConsumer3copied14only; futureSource5harnessprecision/differentpeer/choices ahead. Canonical-Pro3HELD/no soleACK-lease-quiet/no unrelatedstop/no sourceapply/native/science-twins-epoch-history-attempts-caps-reserves-pipedGO-noNonInteractive-no-public-no-push-no-replay/monitorrestorecloseout.
'''.encode()
resource = f'''\n\n### {stamp} - major027: documentation precision before timer

[Checkpoint027](30H_RESUME_CHECKPOINT_027.md). Doc26e3fa refused oldpeer top-level comparison, corrected to51top/nested12/new38 with real2MiB cap incompatibility. Allactualphasesabsent/testsUNRUN. DifferentDoc27creationPASS and readycallbacks requiredbeforetimer; BOTH originalcontext/runtimeage<=90atGO leaves510for450+60/resource60throughspawn; no physicaldeadline guarantee/TTLextension/replay. Canonical-Pro3holds/no soleACK/lease/quiet. Monitorrestorecloseout remainsdue.
'''.encode()
links = []
for path, data in [(primary[0], header), (primary[1], handoff), (primary[2], start),
                   (checkpoint, body.encode()), (primary[3], entry), (primary[4], resource)]:
    for target in re.findall(r'\]\(([^)]+)\)', data.decode()):
        resolved = (path.parent / target).resolve()
        assert resolved == checkpoint.resolve() or resolved.is_file(), (str(path), target)
        links.append(dict(document=path.relative_to(root).as_posix(), target=target, resolved_path=str(resolved)))
def once(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
def row(path):
    data = path.read_bytes()
    return dict(path=path.relative_to(root).as_posix(), bytes=len(data), sha256=sha(data))
enc = lambda value: (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')
for name, data in inputs.items():
    assert (base / name).read_bytes() == data
    once(copies / 'resume-2026-10-01-30h-001' / name, data)
for path, data in old.items():
    once(before / path.relative_to(root), data)
once(checkpoint, body.encode())
for path, data in {primary[0]: header + old[primary[0]], primary[1]: handoff, primary[2]: start}.items():
    assert path.read_bytes() == old[path]
    path.write_bytes(data)
for path, data in [(primary[3], entry), (primary[4], resource)]:
    assert path.read_bytes() == old[path]
    with path.open('ab') as stream: stream.write(data)
baseline = []
for path, data in old.items():
    proof = 'exact_before_copy'
    if path.name == 'AGENTS.md':
        assert path.read_bytes().endswith(data); proof = 'exact_retained_suffix'
    if path.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert path.read_bytes().startswith(data); proof = 'exact_retained_prefix'
    baseline.append(dict(primary=path.relative_to(root).as_posix(), before=row(before / path.relative_to(root)), proof=proof))
once(base / 'DOCS_REFRESH_BASELINE_027.json', enc(dict(schema_version=1, created_utc=stamp, files=baseline)))
pairs = [dict(original=row(base / name), copy=row(copies / 'resume-2026-10-01-30h-001' / name)) for name in inputs]
once(base / 'DOCS_REFRESH_INPUTS_027.json', enc(dict(schema_version=1, created_utc=stamp, inputs=pairs)))
declared = [*primary, checkpoint, base / 'DOCS_REFRESH_BASELINE_027.json', base / 'DOCS_REFRESH_INPUTS_027.json',
            *[before / path.relative_to(root) for path in primary],
            *[copies / 'resume-2026-10-01-30h-001' / name for name in inputs]]
facts = dict(Doc26_refusal_and_error_history_preserved=True, old51_top_nested12_new38_precision_correct=True,
             actual_reader_cap_and_old_core_incompatibility_preserved=True, harness_design_still_unapproved=True,
             actual_fresh_phases_and_tests_unrun=True, original_context_runtime_age90_and450plus60_budgets=True,
             no_replay_retimestamp_or_guard_cap_change=True, canonical_Pro3_holds=True)
audit = dict(schema_version=1, checkpoint=27, created_utc=stamp,
             status='AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW', files=[row(path) for path in declared],
             actual_input_count=len(pairs), maintained_links=links, facts=facts)
once(base / 'DOCS_REFRESH_AUDIT_027.json', enc(audit))
print(json.dumps(dict(checkpoint_sha256=sha(checkpoint.read_bytes()), audit_sha256=sha(enc(audit)),
                      declared_files=len(declared), input_pairs=len(pairs), links=len(links))))
