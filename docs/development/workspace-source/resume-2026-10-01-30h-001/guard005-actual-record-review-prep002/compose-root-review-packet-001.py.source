 d=datetime.datetime.strptime(v[:19],'%Y-%m-%dT%H:%M:%S').replace(tzinfo=datetime.timezone.utc)-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
 return (d.days*86400+d.seconds)*10000000+int(v[20:20+n])*(10 if n==6 else 1)
def now():return ticks(datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),'Py')
