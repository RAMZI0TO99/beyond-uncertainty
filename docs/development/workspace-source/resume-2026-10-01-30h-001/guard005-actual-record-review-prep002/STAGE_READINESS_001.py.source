tree=ast.parse(b);env={}
def val(n):
 if isinstance(n,ast.Constant):return n.value
 if isinstance(n,ast.Name):return env[n.id]
 if isinstance(n,(ast.Tuple,ast.List)):return tuple(val(x)for x in n.elts)if isinstance(n,ast.Tuple)else[val(x)for x in n.elts]
 if isinstance(n,ast.Dict):return {val(k):val(v)for k,v in zip(n.keys,n.values)}
 if isinstance(n,ast.BinOp)and isinstance(n.op,ast.Div):return val(n.left)/val(n.right)
 if isinstance(n,ast.Call)and isinstance(n.func,ast.Name)and n.func.id=='Path'and len(n.args)==1 and not n.keywords:return Path(val(n.args[0]))
 raise ValueError('not static data')
for n in tree.body:
 if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
  try:env[n.targets[0].id]=val(n.value)
  except(KeyError,ValueError):pass
selected={}
