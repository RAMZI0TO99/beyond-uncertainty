P=Path(r'D:\Aenv\pro2');R=P/'resume-2026-10-01-30h-001'
def raw9(x):return [x.st_dev,x.st_ino,x.st_size,x.st_mtime_ns,x.st_ctime_ns,x.st_mode,x.st_nlink,getattr(x,'st_file_attributes',None),getattr(x,'st_birthtime_ns',None)]
def pairs_unique(rows):
 value={}
 for k,v in rows:
  if k in value:raise ValueError('duplicate '+k)
  value[k]=v
 return value
def decode(data):
 value=json.loads(data,object_pairs_hook=pairs_unique,parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))
 def check(x):
  if isinstance(x,float)and not math.isfinite(x):raise ValueError('nonfinite')
  if isinstance(x,dict):
   for v in x.values():check(v)
  elif isinstance(x,list):
   for v in x:check(v)
 check(value);return value
def digest(x):return hashlib.sha256(json.dumps(x,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')).hexdigest()
def read(p,cap=8388608):
 p=Path(p);assert p.is_absolute()
 before=[]
 for parent in reversed(p.parents):
  s=parent.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not getattr(s,'st_file_attributes',0)&0x400
  before.append((str(parent),s.st_dev,s.st_ino))
 a=p.lstat();ar=raw9(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not getattr(a,'st_file_attributes',0)&0x400
 assert type(a.st_size)is int and 0<=a.st_size<=cap
 fd=os.open(p,os.O_RDONLY|getattr(os,'O_BINARY',0));parts=[];total=0
 try:
  h=os.fstat(fd);hr=raw9(h);assert stat.S_ISREG(h.st_mode)and h.st_nlink==1 and not getattr(h,'st_file_attributes',0)&0x400
  assert ar[4]==ar[8]and all(ar[i]==hr[i]for i in(0,1,2,3,5,6,7,8))
  while True:
   b=os.read(fd,min(1048576,cap+1-total))
   if not b:break
   total+=len(b);assert total<=cap;parts.append(b)
  assert raw9(os.fstat(fd))==hr
 finally:os.close(fd)
 assert raw9(p.lstat())==ar
 after=[]
 for parent in reversed(p.parents):
  s=parent.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not getattr(s,'st_file_attributes',0)&0x400
  after.append((str(parent),s.st_dev,s.st_ino))
 assert after==before
 data=b''.join(parts);assert len(data)==a.st_size
 return data,{'path':str(p),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'path_raw9':ar,'handle_raw9':hr}

