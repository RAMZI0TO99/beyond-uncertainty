direction=J(choice);assert direction["authorization"]["owner"]=="/root/candidate_review"
baseline=J(read(R/"SOURCE_GUARD_TEST_BINDINGS_004.BASELINE.json"))
bindings=json.loads(json.dumps(baseline));changes={}
for role,row in baseline["consumers"].items():
 p=R/row["path"];x=read(p,row["sha256"],row["size"]);before=read(R/"baseline-pins-only"/row["path"]);assert x==before
 s=x.decode();tree=ast.parse(x)
 direct=[n for n in tree.body if isinstance(n,ast.ImportFrom) and n.module=="types"]
 if direct:
  assert len(direct)==1
  segment=ast.get_source_segment(s,direct[0]);assert "\n" not in segment and "MappingProxyType" not in segment
  oldimport=segment;newimport=segment+", MappingProxyType"
 else:
  anchors=[n for n in tree.body if isinstance(n,ast.Import) and any(a.name=="types" for a in n.names)]
  assert len(anchors)==1
  oldimport=ast.get_source_segment(s,anchors[0]);newimport=oldimport+"\nfrom types import MappingProxyType"
  if "\r\n" in s:newimport=newimport.replace("\n","\r\n")
 assert s.count(oldimport)==1
 s=s.replace(oldimport,newimport,1)
 branch="    if isinstance(value, Mapping):";replacement="    if kind in (dict, MappingProxyType):"
 assert s.count(branch)==1
 s=s.replace(branch,replacement,1)
 changed=s.encode();t=ast.parse(changed)
 back=s.replace(replacement,branch,1).replace(newimport,oldimport,1).encode();assert back==x
 olddefs={n.name:ast.dump(n,include_attributes=False) for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
 newdefs={n.name:ast.dump(n,include_attributes=False) for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
 assert set(olddefs)==set(newdefs)
 changeddefs=[k for k in olddefs if olddefs[k]!=newdefs[k]];assert changeddefs==["_raw_helper_value_identity"]
 og=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=="_raw_helper_value_identity")
 ng=next(n for n in t.body if isinstance(n,ast.FunctionDef) and n.name==og.name)
 oldbranch=next(n for n in ast.walk(og) if isinstance(n,ast.If) and isinstance(n.test,ast.Call) and isinstance(n.test.func,ast.Name) and n.test.func.id=="isinstance" and len(n.test.args)==2 and isinstance(n.test.args[1],ast.Name) and n.test.args[1].id=="Mapping")
 newbranch=next(n for n in ast.walk(ng) if isinstance(n,ast.If) and isinstance(n.test,ast.Compare) and isinstance(n.test.left,ast.Name) and n.test.left.id=="kind" and isinstance(n.test.comparators[0],ast.Tuple) and [z.id for z in n.test.comparators[0].elts if isinstance(z,ast.Name)]==["dict","MappingProxyType"])
 assert ast.dump(ast.Module(body=oldbranch.body,type_ignores=[]),include_attributes=False)==ast.dump(ast.Module(body=newbranch.body,type_ignores=[]),include_attributes=False)
 p.write_bytes(changed);assert read(p)==changed
 final=bindings["consumers"][role];final["sha256"]=hashlib.sha256(changed).hexdigest();final["size"]=len(changed)
 changes[role]={"path":row["path"],"baseline_sha256":row["sha256"],"after_sha256":final["sha256"],"before_import":oldimport,"after_import":newimport,"changed_definition":"_raw_helper_value_identity","exact_mapping_branch":"kind in (dict, MappingProxyType)","recursive_mapping_body_AST_unchanged":True,"all_other_definition_ASTs_unchanged":True,"mapping_change_reversal_equals_pin_only_baseline":True}
bindings["guard_mapping_kind_correction_pending_root"]=False
