source=source.replace('"CodeType": types.CodeType, "RAW_AUTHORITY_HELPER": RAW,','"CodeType": types.CodeType, "MappingProxyType": types.MappingProxyType, "RAW_AUTHORITY_HELPER": RAW,',1)
source=source.replace("healthy actual raw3 cold/reuse control failed before mutation","healthy actual raw4 cold/reuse control failed before mutation",1)
helpers="\ndef schema3_policy_changes(name, value):\n    \"\"\"Finite typed mutants, never an unsupported object() placeholder.\"\"\"\n    if name == \"SUCCESSOR_COMPACT_INTERMEDIATE_FACTS\":\n        changed = dict(value[0]); changed[\"controller_commit\"] = \"f\" * 40\n        return [(\"nested_commit\", (types.MappingProxyType(changed), value[1])),\n                (\"middle_order\", tuple(reversed(value))), (\"missing_middle\", value[:1]),\n                (\"outer_list\", list(value)), (\"nested_dict\", (dict(value[0]), value[1]))]\n    if name == \"_SUCCESSOR_COMPACT_AFTERIMAGES\":\n        changed = dict(value[0][0]); changed[\"size\"] += 1\n        first = (types.MappingProxyType(changed), *value[0][1:])\n        reordered = (value[0][1], value[0][0], *value[0][2:])\n        return [(\"nested_size\", (first, value[1])), (\"row_order\", (reordered, value[1])),\n                (\"missing_row\", (value[0][:-1], value[1])), (\"outer_list\", list(value)),\n                (\"nested_dict\", ((dict(value[0][0]), *value[0][1:]), value[1]))]\n    if name == \"_SUCCESSOR_COMPACT_PROOF_LIMITS\":\n        changed = dict(value[0]); key = \"release_record_base64\"\n        width, size, pin = changed[key]\n        changed[key] = (width, size + 1, pin)\n        missing = dict(value[0]); del missing[\"git_commit_object_base64\"]\n        return [(\"decoded_size\", (types.MappingProxyType(changed), value[1])),\n                (\"missing_proof\", (types.MappingProxyType(missing), value[1])),\n                (\"outer_list\", list(value)), (\"nested_dict\", (dict(value[0]), value[1]))]\n    if name == \"_SUCCESSOR_COMPACT_RELEASE_KEYS\":\n        first = set(value[0]); first.remove(\"ControllerCommit\"); first.add(\"UnreviewedCommit\")\n        return [(\"typed_key_change\", (frozenset(first), value[1])),\n                (\"middle_order\", tuple(reversed(value))), (\"outer_list\", list(value))]\n    if name in (\"_SUCCESSOR_COMPACT_ENTRY_KEYS\", \"_SUCCESSOR_COMPACT_PROOF_KEYS\",\n                \"_SUCCESSOR_ATTESTATION_SCHEMA3_KEYS\"):\n        key = sorted(value)[0]\n        return [(\"missing_key\", frozenset(set(value) - {key})),\n                (\"typed_key_change\", frozenset((set(value) - {key}) | {\"unreviewed_\" + key})),\n                (\"set_type\", set(value))]\n    if name == \"_SUCCESSOR_COMPACT_PROOF_MAX_BYTES\":\n        return [(\"typed_bound\", (value[0] + 1, value[1])),\n                (\"middle_order\", tuple(reversed(value))), (\"outer_list\", list(value))]\n    if name == \"_SUCCESSOR_COMPACT_QA_PATHS\":\n        return [(\"grouped_order\", (value[1], value[0], *value[2:])),\n                (\"missing_path\", value[:-1]), (\"outer_list\", list(value))]\n    if name in (\"_SUCCESSOR_COMPACT_QA_BYTES\", \"_SUCCESSOR_ATTESTATION_MAX_BYTES_SCHEMA3\"):\n        return [(\"typed_bound\", value + 1), (\"bool_type\", True), (\"float_type\", float(value))]\n    raise AssertionError(\"unknown source-derived schema3 policy\")\n\ndef repack_exact_policy(value):\n    \"\"\"Copy genuine immutable containers with identical type and value.\"\"\"\n    if type(value) is types.MappingProxyType:\n        return types.MappingProxyType({key: repack_exact_policy(value[key])\n                                      for key in reversed(tuple(value))})\n    if type(value) is tuple:\n        return tuple(repack_exact_policy(item) for item in value)\n    if type(value) is frozenset:\n        return frozenset(reversed(sorted(value)))\n    return value\n"
methods="\n    def test_all_eleven_schema3_policy_values_refuse_typed_changes_cold_and_reuse(self):\n        for role in (\"controller\", \"worker\", \"entrypoint\", \"fit_child\", \"inspector\"):\n            for reuse in (False, True):\n                with guard_fixture(role) as (_, _, _, _, bindings):\n                    policies = bindings[\"schema3_policy_names\"]\n                self.assertEqual(len(policies), 11)\n                for name in policies:\n                    with guard_fixture(role) as (module, _, _, _, _):\n                        cases = schema3_policy_changes(name, module.__dict__[name])\n                    self.assertTrue(cases)\n                    for damage, replacement in cases:\n                        with self.subTest(role=role, reuse=reuse, name=name, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):\n                            self.assertEqual(namespace[\"_GUARD_HEALTHY_CONTROL_CALLS\"], 2)\n                            if reuse:\n                                self.assertIs(load(), module)\n                            original = module.__dict__[name]\n                            try:\n                                module.__dict__[name] = replacement\n                                with self.assertRaisesRegex(Refused, \"policy differs from pinned source|identity or API changed\"):\n                                    load()\n                            finally:\n                                module.__dict__[name] = original\n                            self.assertIs(load(), module)\n                            self.assertIs(load(), module)\n\n    def test_schema3_genuine_container_copies_and_mapping_order_remain_accepted(self):\n        for role in (\"controller\", \"worker\", \"entrypoint\", \"fit_child\", \"inspector\"):\n            for reuse in (False, True):\n                for name in (\"SUCCESSOR_COMPACT_INTERMEDIATE_FACTS\", \"_SUCCESSOR_COMPACT_AFTERIMAGES\",\n                             \"_SUCCESSOR_COMPACT_PROOF_LIMITS\", \"_SUCCESSOR_COMPACT_RELEASE_KEYS\"):\n                    with self.subTest(role=role, reuse=reuse, name=name), guard_fixture(role) as (module, load, namespace, _, _):\n                        self.assertEqual(namespace[\"_GUARD_HEALTHY_CONTROL_CALLS\"], 2)\n                        if reuse:\n                            self.assertIs(load(), module)\n                        original = module.__dict__[name]\n                        # Genuine dict/proxy values both reach the real fingerprint branch.\n                        row = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS[0]\n                        identity = namespace[\"_raw_helper_value_identity\"]\n                        copied_dict = dict(row)\n                        reversed_dict = dict(reversed(tuple(row.items())))\n                        self.assertEqual(identity(copied_dict), identity(reversed_dict))\n                        self.assertEqual(identity(row), identity(types.MappingProxyType(copied_dict)))\n                        self.assertNotEqual(identity(copied_dict), identity(row))\n                        try:\n                            replacement = repack_exact_policy(original)\n                            self.assertIsNot(replacement, original)\n                            module.__dict__[name] = replacement\n                            self.assertIs(load(), module)\n                            self.assertIs(load(), module)\n                        finally:\n                            module.__dict__[name] = original\n                        self.assertIs(load(), module)\n\n    def test_mapping_proxy_class_name_spoof_refuses_before_user_mapping_methods(self):\n        for role in (\"controller\", \"worker\", \"entrypoint\", \"fit_child\", \"inspector\"):\n            for reuse in (False, True):\n                with self.subTest(role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, Refused, _):\n                    self.assertEqual(namespace[\"_GUARD_HEALTHY_CONTROL_CALLS\"], 2)\n                    if reuse:\n                        self.assertIs(load(), module)\n                    original = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS\n                    row = original[0]\n                    seen = []\n                    class ForeignMapping(Mapping):\n                        def __getitem__(self, key):\n                            seen.append(\"getitem\")\n                            return row[key]\n                        def __iter__(self):\n                            seen.append(\"iter\")\n                            return iter(row)\n                        def __len__(self):\n                            seen.append(\"len\")\n                            return len(row)\n                        def items(self):\n                            seen.append(\"items\")\n                            return row.items()\n                    ForeignMapping.__name__ = \"mappingproxy\"\n                    ForeignMapping.__module__ = type(row).__module__\n                    replacement = ForeignMapping()\n                    self.assertEqual(type(replacement).__name__, type(row).__name__)\n                    self.assertEqual(type(replacement).__module__, type(row).__module__)\n                    self.assertIsNot(type(replacement), types.MappingProxyType)\n                    try:\n                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = (replacement, original[1])\n                        with self.assertRaisesRegex(Refused, \"unsupported policy/default value\"):\n                            load()\n                        self.assertEqual(seen, [], \"foreign mapping method ran before exact-type refusal\")\n                    finally:\n                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = original\n                    self.assertIs(load(), module)\n                    self.assertIs(load(), module)\n\n    def test_tuple_class_name_spoof_refuses_cold_and_reuse(self):\n        for role in (\"controller\", \"worker\", \"entrypoint\", \"fit_child\", \"inspector\"):\n            for reuse in (False, True):\n                with self.subTest(role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, Refused, _):\n                    self.assertEqual(namespace[\"_GUARD_HEALTHY_CONTROL_CALLS\"], 2)\n                    if reuse:\n                        self.assertIs(load(), module)\n                    original = module._SUCCESSOR_COMPACT_QA_PATHS\n                    ForeignTuple = type(\"tuple\", (tuple,), {})\n                    replacement = ForeignTuple(original)\n                    self.assertEqual(type(replacement).__name__, type(original).__name__)\n                    self.assertEqual(tuple(replacement), original)\n                    try:\n                        module._SUCCESSOR_COMPACT_QA_PATHS = replacement\n                        with self.assertRaisesRegex(Refused, \"unsupported policy/default value\"):\n                            load()\n                    finally:\n                        module._SUCCESSOR_COMPACT_QA_PATHS = original\n                    self.assertIs(load(), module)\n                    self.assertIs(load(), module)\n\n    def test_all_four_schema3_helpers_code_globals_defaults_refuse_cold_and_reuse(self):\n        for role in (\"controller\", \"worker\", \"entrypoint\", \"fit_child\", \"inspector\"):\n            for reuse in (False, True):\n                with guard_fixture(role) as (_, _, _, _, bindings):\n                    helpers = bindings[\"schema3_helper_names\"]\n                self.assertEqual(len(helpers), 4)\n                for name in helpers:\n                    for damage in (\"code\", \"defaults\", \"kwdefaults\", \"annotations\", \"replacement\", \"foreign_globals\"):\n                        with self.subTest(role=role, reuse=reuse, name=name, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):\n                            self.assertEqual(namespace[\"_GUARD_HEALTHY_CONTROL_CALLS\"], 2)\n                            if reuse:\n                                self.assertIs(load(), module)\n                            function = module.__dict__[name]\n                            original = (function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__)\n                            try:\n                                if damage == \"code\":\n                                    function.__code__ = (lambda *args, **kwargs: b\"unreviewed\").__code__\n                                elif damage == \"defaults\":\n                                    function.__defaults__ = ({\"reviewed\": (\"changed\", 1)},)\n                                elif damage == \"kwdefaults\":\n                                    function.__kwdefaults__ = {\"reviewed\": {\"changed\": [1]}}\n                                elif damage == \"annotations\":\n                                    function.__annotations__ = {\"reviewed\": \"changed\"}\n                                elif damage == \"replacement\":\n                                    module.__dict__[name] = lambda *args, **kwargs: b\"unreviewed\"\n                                else:\n                                    foreign = types.FunctionType(function.__code__, dict(module.__dict__),\n                                                                 function.__name__, function.__defaults__)\n                                    foreign.__kwdefaults__ = None if function.__kwdefaults__ is None else dict(function.__kwdefaults__)\n                                    foreign.__annotations__ = dict(function.__annotations__)\n                                    module.__dict__[name] = foreign\n                                with self.assertRaisesRegex(Refused, \"API differs from pinned source|identity or API changed\"):\n                                    load()\n                            finally:\n                                module.__dict__[name] = function\n                                function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__ = original\n                            self.assertIs(load(), module)\n                            self.assertIs(load(), module)\n"
