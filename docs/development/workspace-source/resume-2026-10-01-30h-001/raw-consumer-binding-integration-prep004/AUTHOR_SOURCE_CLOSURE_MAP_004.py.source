
import ast,datetime as dt,hashlib,json,math,os,pathlib,stat,re
P=pathlib.Path(r"D:\Aenv\pro2");B=P/"resume-2026-10-01-30h-001";R=B/"raw-component-runtime-prep004"
INPUTS={};BYTES={}
FIXED_EXE_ROLES={str(P/"pro2/.venv/Scripts/python.exe"),str(P/"runtimes/git/mingw64/bin/git.exe"),str(P/"runtimes/week8-python313-frozen-001/python.exe")}
RAW_FIELDS=("st_dev","st_ino","st_mode","st_size","st_mtime_ns","st_ctime_ns","st_nlink","st_file_attributes","st_birthtime_ns")
def raw9(s):return [getattr(s,k) for k in RAW_FIELDS]
def ancestors(p):
    rows=[]
    for d in [*reversed(p.parent.parents),p.parent]:
        s=d.lstat()
        assert stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not s.st_file_attributes&1024,d
        rows.append([str(d),s.st_dev,s.st_ino,s.st_mode,s.st_file_attributes])
    return rows
def read(p,pin=None,size=None,maximum=8388608):
    p=pathlib.Path(p);chain=ancestors(p);pre=p.lstat()
    assert stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and not pre.st_file_attributes&1024,p
    assert type(maximum) is int and 0<maximum<=134217728 and 0<=pre.st_size<=maximum,p
    with p.open("rb") as f:
        first=os.fstat(f.fileno());assert 0<=first.st_size<=maximum
        x=f.read(maximum+1);last=os.fstat(f.fileno())
    post=p.lstat()
    assert len(x)<=maximum and len(x)==pre.st_size and raw9(pre)==raw9(post) and raw9(first)==raw9(last),p
    for key in ("st_dev","st_ino","st_size","st_mtime_ns","st_nlink","st_file_attributes","st_birthtime_ns"):
        assert getattr(pre,key)==getattr(first,key),str(p)+key
    if pre.st_mode!=first.st_mode:
        assert os.name=="nt" and str(p) in FIXED_EXE_ROLES,p
        assert stat.S_IFMT(pre.st_mode)==stat.S_IFMT(first.st_mode) and stat.S_IMODE(pre.st_mode)&~0o111==stat.S_IMODE(first.st_mode)&~0o111,p
        assert stat.S_IMODE(pre.st_mode)&0o111==0o111 and stat.S_IMODE(first.st_mode)&0o111==0,p
    assert ancestors(p)==chain,p
    r={"path":str(p),"sha256":hashlib.sha256(x).hexdigest(),"size":len(x),"path_raw9":raw9(pre),"handle_raw9":raw9(first)}
    if pin is not None:assert r["sha256"]==pin,p
    if size is not None:assert len(x)==size,p
    INPUTS[str(p)]=r;BYTES[str(p)]=x
    return x
def pairs(v):
    d={}
    for k,x in v:
        assert k not in d,"duplicate JSON key"
        d[k]=x
    return d
def finite(token):
    value=float(token);assert math.isfinite(value),"nonfinite JSON number";return value
def J(x):return json.loads(x,object_pairs_hook=pairs,parse_float=finite,parse_constant=lambda x:(_ for _ in ()).throw(ValueError(x)))
def hex64(x):return type(x) is str and re.fullmatch("[0-9a-f]{64}",x) is not None
def bindings_reverse(source,names,expected):
    rows=source.splitlines(keepends=True);t=ast.parse(source.decode("utf-8"));edits=[];found={}
    for n in t.body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in names:
            key=n.targets[0].id;assert key not in found and isinstance(n.value,ast.Constant) and hex64(n.value.value)
            found[key]=n.value.value
            assert expected[key]==n.value.value,key
            start=sum(map(len,rows[:n.value.lineno-1]))+n.value.col_offset
            end=sum(map(len,rows[:n.value.end_lineno-1]))+n.value.end_col_offset
            edits.append((start,end))
    assert set(found)==set(names) and len(edits)==len(names)
    back=source
    for start,end in sorted(edits,reverse=True):back=back[:start]+b"None"+back[end:]
    return back,found,edits

import difflib
R=B/"raw-consumer-binding-integration-prep004";S=R/"before/revision003"
def create(p,x):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open("xb") as f:f.write(x)
 assert read(p)==x
bindings=J(read(R/"SOURCE_GUARD_TEST_BINDINGS_004.json"));old=J(read(S/"SOURCE_GUARD_TEST_BINDINGS_002.json"))
rawmanifest=J(read(R/"inputs/RAW_POLICY_STAGED_MANIFEST_004.json"));rawpeer=J(read(R/"inputs/raw004-peer.json"))
assert rawmanifest["source_sha256"]==rawpeer["source_sha256"]==bindings["raw_sha256"]
assert rawpeer["verdict"]=="PASS_STATIC_SOURCE_AND_TEST_PREPARATION_ONLY"
assert rawpeer["reviewer"]=="/root/candidate_review" and rawpeer["source_author"]=="/root/raw_policy_worker"
patches=[];nondefs=[];projection=[]
for role,row in bindings["consumers"].items():
 before=read(S/row["path"],old["consumers"][role]["sha256"]);after=read(R/row["path"],row["sha256"])
 beforetree=ast.parse(before);aftertree=ast.parse(after)
 patches.extend(difflib.unified_diff(before.decode().splitlines(keepends=True),after.decode().splitlines(keepends=True),fromfile="revision003/"+row["path"],tofile="revision004/"+row["path"]))
 oldcalls=[ast.dump(n,include_attributes=False) for n in ast.walk(beforetree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=="admit_recorded_predecessor"]
 newcalls=[ast.dump(n,include_attributes=False) for n in ast.walk(aftertree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=="admit_recorded_predecessor"]
 assert oldcalls==newcalls
 otherold=[ast.dump(n,include_attributes=False) for n in beforetree.body if not isinstance(n,(ast.FunctionDef,ast.ClassDef,ast.ImportFrom)) and not (isinstance(n,ast.Assign) and isinstance(n.value,ast.Constant) and n.value.value==old["raw_sha256"])]
 othernew=[ast.dump(n,include_attributes=False) for n in aftertree.body if not isinstance(n,(ast.FunctionDef,ast.ClassDef,ast.ImportFrom)) and not (isinstance(n,ast.Assign) and isinstance(n.value,ast.Constant) and n.value.value==bindings["raw_sha256"])]
 assert otherold==othernew
 nondefs.append({"role":role,"all_nontypes_imports_or_unrelated_nondeclarations_AST_exact":True,"admission_call_count":len(newcalls),"all_admission_calls_AST_exact":True})
 keys=[name for name in old["new_policy_names"]]+bindings["schema3_policy_names"]
 assert len(keys)==27 and len(set(keys))==27
 projection.append({"role":role,"path":row["path"],"source_sha256":row["sha256"],"size":row["size"],"captured_policy_names":keys,"schema3_policy_count":11,"schema3_helper_count":4,"selected_guard_and_reader_functions":row["selected_functions"],"raw_source_sha256":bindings["raw_sha256"],"raw_and_outer_only_literal_slots":{"raw":bindings["raw_sha256"],"outer":"505909f8e1d08ade8462535e0edbad19e2b674852815a2ae3ffc7e546dc767cf"},"future_current_release_sha256":None,"future_attestation_sha256":None,"future_operational_binding_review":None})
oldtest=read(S/"test_raw_consumer_guards_003.TEMPLATE.py");newtest=read(R/"test_raw_consumer_guards_004.TEMPLATE.py")
patches.extend(difflib.unified_diff(oldtest.decode().splitlines(keepends=True),newtest.decode().splitlines(keepends=True),fromfile="revision003/test_raw_consumer_guards_003.TEMPLATE.py",tofile="revision004/test_raw_consumer_guards_004.TEMPLATE.py"))
create(R/"SOURCE_AND_TEST_DELTA_004.patch","".join(patches).encode())
