ame and identical path values fails exact kind","expected_error":"unsupported policy/default value"},{"method":"test_all_four_schema3_helpers_code_globals_defaults_refuse_cold_and_reuse","helper_count":4,"damage_variants":["code","typed nested defaults","typed nested kwdefaults","annotations","replacement function","same code with foreign globals"],"role_phase_subtest_contexts":240,"foreign_function_kwdefaults_and_annotations_restored_for_coherent_comparison":True,"expected_error":"API differs from pinned source|identity or API changed"}],"actual_collection_count":None,"actual_subtest_count":None,"actual_passed":None,"actual_healthy_acceptance":None,"test_or_target_import_or_definition_execution":False}
