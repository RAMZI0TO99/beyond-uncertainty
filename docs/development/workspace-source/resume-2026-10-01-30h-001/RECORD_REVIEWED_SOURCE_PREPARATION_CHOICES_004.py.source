"""Record staged-source choices after different design reviews; no live action."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import os

base = Path('D:/Aenv/pro2/resume-2026-10-01-30h-001')
names = [
    'OWNER_WORK_WINDOW_30H_20261001_001.json',
    'FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.json',
    'INDEPENDENT_FINITE_RELEASE_CHAIN_COMPACT_REVIEW_002.json',
    'FINITE_RELEASE_CHAIN_COMPACT_CANONICAL_CORRECTION_001.json',
    'INDEPENDENT_COMPACT_CANONICAL_CORRECTION_REVIEW_001.json',
    'native-stdin-frame-transport-design003/STDIN_FRAME_NATIVE_TRANSPORT_DESIGN_003.json',
    'native-stdin-frame-transport-design003/INDEPENDENT_NATIVE_STDIN_FRAME_DESIGN_REVIEW_003.json',
]
output = base / 'ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_004.json'
notes = base / 'ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_004.md'
assert not output.exists() and not notes.exists()
inputs = {name: (base / name).read_bytes() for name in names}
load = lambda name: json.loads(inputs[name].decode('utf-8'))
assert load(names[2])['verdict'] == 'PASS_SOURCE_ONLY_COMPACT_ATTESTATION_DESIGN_WITH_EXPLICIT_IMPLEMENTATION_CONDITIONS_ENCODING_CLOSURE_REFUSED'
assert load(names[4])['verdict'] == 'PASS_METADATA_AST_CORRECTION_ONLY'
assert load(names[6])['verdict'] == 'PASS_STATIC_DESIGN_ONLY_WITH_EXPLICIT_QUALIFICATIONS'
now = datetime.now(timezone.utc)
assert now < datetime(2026, 10, 2, 22, 36, 15, tzinfo=timezone.utc)
record = dict(
    schema_version=1, record_type='root_reviewed_staged_source_preparation_choices004',
    created_utc=now.isoformat(), author='/root', owner_end_utc='2026-10-02T22:36:15Z',
    inputs=[dict(path=name, bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
            for name, data in inputs.items()],
    authorization='STAGED_SOURCE_AND_TEST_AUTHORING_ONLY_AFTER_DIFFERENT_DESIGN_REVIEWS',
    raw_source_revision004=dict(
        owner='/root/raw_policy_worker', existing_source_and_test_evidence='PRESERVE_EXACT_BEFORE_PAIRS',
        target_folder='successor-candidate-raw-revision004',
        schema3='Exact two compiled historical intermediates EA9->597->3f74->future final; '
                'direct parents, full742 and exact9+9 deltas, finite25 final changes; '
                'release shapes34/36/37/34; compact3-key proofs and grouped263 canonical QA reconstruction.',
        canonical='Existing legacy1/2 admission already requires canonical compact ASCII plus LF; '
                  'extend the same check to3 and preserve all old semantics.',
        caps=dict(global_attestation=395799, schema3_design_max=361287),
        preserve='API12, seven runtime input roles, historical raw4, incident/terminal twins, '
                 'external initial attestation SHA, all old1/2 constants/behavior and cold/reuse guards.',
        tests='Retain prior test4 method/helper ASTs and append meaningful healthy-before/negative/after '
              'schema3 cases; all actual target compilation/import/test execution requires another review.',
        consumer_and_publisher_rebinding_authorized=False,
        live_apply_authorized=False),
    native_closure_source_revision003=dict(
        owner='/root/bootstrap_stage', target_folder='native-schema2-admission-closure-prep003',
        after_other_assigned_metadata_preparation_is_frozen=True,
        implementation='Source-only byte-exact stdin frame for compacted common source and44-field '
                       'bindings; actual OS argv limited and captured before internal argument insertion.',
        no_new_field_or_role=True, no_receipt_or_envelope_change=True,
        limits=dict(sender_encoded_sum=262142, receiver_complete_frame=262144,
                    maximum_representable_canonical_frame=262142,
                    maximum_representable_encoded_sum=262140,
                    binding_component=16384, windows_os_command_utf16=8191),
        cases='Healthy canonical262142 witness; raw262144/262145 test length/framing only. '
              'Canonical Base64, exact twoLF/noCR, bounded262145 read, duplicate/nonfinite JSON, '
              'partial/extra-line/overlength/unknown-key errors, source/code capture and argv distinction.',
        compaction='First compact source with full AST equality before adding reviewed frame logic; '
                   'never execute preview. Derive final source/literal-growth bound from actual edited source.',
        remaining_unknown='All16 actual selected paths/rolecaps, final literal-growth allowance, '
                          'eight actual OS commands and physical capture witnesses remain None/unbindable '
                          'until separately selected and reviewed. Preserve producer Python0/6digits max32 '
                          'versus supportingPS0/7 max33; no universalUTC33.',
        source_target_execution_authorized=False, native_execution_authorized=False),
    source_peer_and_actual_runtime_review_required=True,
    existing_design_review_false_attribution_preserved_and_corrected=True,
    complete_encoding_closure_accepted=False, sole_executor_ack_received=False,
    canonical_apply_fullQA_gate_commit_release_native_authorized=False,
    public_push_fit_epoch_replay_or_guard_reduction_authorized=False,
    frozen_science_and_outcomes_untouched=True,
)
payload = (json.dumps(record, indent=2, sort_keys=True, ensure_ascii=True,
                      allow_nan=False)+'\n').encode('ascii')
body = '''# ROOT reviewed staged source preparation choices004

Only staged source/test authoring is authorized by this record. Different compact
design, canonical-premise correction and native frame design reviews are pinned
in the JSON. No live apply, fullQA, gate, commit, release, binding, target execution,
native ceremony, fit, replay, epoch or public action is authorized.

Raw revision004 implements the exact two-intermediate compact schema3 while
preserving existing legacy1/2 canonical checks, API12, seven input roles, original
immutable records and395799 ingress. Its361287 design cap and reconstructed grouped
QA manifests need source and actual-unit review; no future candidate is accepted.

Native closure003 implements the reviewed byte frame and source compaction only
after the owner's other metadata preparation is frozen. Retain44 fields and all
limits. Healthy canonical max262142 differs from raw262144/262145 probes. Unknown
paths, rolecaps, literal growth, eight OS command lengths and capture witnesses
remain None and operationally unbindable. Later independent source/runtime review
is required. Original frozen bytes, science, caps and one-use guards remain.
'''.encode('utf-8')
for path, data in ((output, payload), (notes, body)):
    with path.open('xb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
for name, data in inputs.items():
    assert (base / name).read_bytes() == data
print(json.dumps(dict(outputs=[dict(path=str(path), bytes=len(data),
                                   sha256=hashlib.sha256(data).hexdigest())
                             for path, data in ((output, payload), (notes, body))])))
