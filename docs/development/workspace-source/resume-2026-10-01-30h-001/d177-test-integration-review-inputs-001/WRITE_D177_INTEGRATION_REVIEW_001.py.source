def sha(data):return hashlib.sha256(data).hexdigest()
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')
def ident(s):
    row=(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,int(getattr(s,'st_file_attributes',0)))
    if os.name=='nt':
        b=getattr(s,'st_birthtime_ns',None);require(type(b) is int and b>0,'birthtime absent');return row+(b,)
    return row
def cross(s,pathname,path):
    row=ident(s)
    if os.name=='nt':
        require(not pathname or s.st_ctime_ns==s.st_birthtime_ns,'creation projection differs')
        row=row[:4]+(s.st_birthtime_ns,)+row[5:8]
        if path==GIT:
            require(s.st_mode&0o111==(0o111 if pathname else 0),'fixed Git mode projection differs')
            row=row[:5]+(row[5]&~0o111,)+row[6:]
    return row
def read(path,expected=None):
    for p in reversed(path.parents):
        s=p.lstat();require(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not int(getattr(s,'st_file_attributes',0))&0x400,'nonplain ancestor')
    a=path.lstat();require(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not stat.S_ISLNK(a.st_mode) and not int(getattr(a,'st_file_attributes',0))&0x400,'nonplain input')
    with path.open('rb',buffering=0) as stream:b=os.fstat(stream.fileno());data=stream.read();c=os.fstat(stream.fileno())
    d=path.lstat();require(ident(a)==ident(d) and ident(b)==ident(c) and cross(a,True,path)==cross(b,False,path) and len(data)==a.st_size,'capture changed')
    if expected is not None:require(sha(data)==expected,'input SHA differs')
    return data,ident(a)
