declared=[*primary,checkpoint,BASE/'DOCS_REFRESH_BASELINE_029.json',BASE/'DOCS_REFRESH_INPUTS_029.json',*[before/p.relative_to(ROOT) for p in primary],*[copies/'resume-2026-10-01-30h-001'/n for n in inputs]]
audit=dict(schema_version=1,checkpoint=29,created_utc=stamp,status='AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW',scope='Expired-window final closeout only',files=[row(p) for p in declared],actual_input_count=len(pairs),maintained_links=links,facts=dict(owner_expired_no_extension=True,unfinished_work_explicit=True,monitor_restored_not_manually_started=True,metadata002_permanently_withdrawn=True,late_sources_frozen_not_approved=True,no_fresh_implementation_or_target_execution=True,holds_and_science_history_preserved=True))
once(BASE/'DOCS_REFRESH_AUDIT_029.json',enc(audit))
print(json.dumps(dict(checkpoint_sha256=sha(checkpoint.read_bytes()),audit_sha256=sha(enc(audit)),declared_files=len(declared),input_pairs=len(pairs),links=len(links))))
