links=[]
for p,data in [(primary[0],header),(primary[1],handoff),(primary[2],start),(checkpoint,body.encode()),(primary[3],entry),(primary[4],resource)]:
    for target in re.findall(r'\]\(([^)]+)\)',data.decode()):
        dest=(p.parent/target).resolve();assert dest==checkpoint.resolve() or dest.is_file(),(p,target)
        links.append(dict(document=p.relative_to(ROOT).as_posix(),target=target,resolved_path=str(dest)))
def once(p,data):
    p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb') as f:f.write(data);f.flush();os.fsync(f.fileno())
def row(p):
    b=p.read_bytes();return dict(path=p.relative_to(ROOT).as_posix(),bytes=len(b),sha256=sha(b))
for n,b in inputs.items():assert (BASE/n).read_bytes()==b;once(copies/'resume-2026-10-01-30h-001'/n,b)
for p,b in old.items():once(before/p.relative_to(ROOT),b)
once(checkpoint,body.encode('utf-8'))
for p,b in [(primary[0],header+old[primary[0]]),(primary[1],handoff),(primary[2],start)]:assert p.read_bytes()==old[p];p.write_bytes(b)
for p,b in [(primary[3],entry),(primary[4],resource)]:
    assert p.read_bytes()==old[p]
    with p.open('ab') as f:f.write(b);f.flush();os.fsync(f.fileno())
baseline=[]
for p,b in old.items():
    proof='exact_before_copy'
    if p.name=='AGENTS.md':assert p.read_bytes().endswith(b);proof='exact_retained_suffix'
    if p.name in ['SESSION.md','RESOURCE_COORDINATION.md']:assert p.read_bytes().startswith(b);proof='exact_retained_prefix'
    baseline.append(dict(primary=p.relative_to(ROOT).as_posix(),before=row(before/p.relative_to(ROOT)),proof=proof))
once(BASE/'DOCS_REFRESH_BASELINE_029.json',enc(dict(schema_version=1,created_utc=stamp,files=baseline)))
pairs=[dict(original=row(BASE/n),copy=row(copies/'resume-2026-10-01-30h-001'/n)) for n in inputs]
