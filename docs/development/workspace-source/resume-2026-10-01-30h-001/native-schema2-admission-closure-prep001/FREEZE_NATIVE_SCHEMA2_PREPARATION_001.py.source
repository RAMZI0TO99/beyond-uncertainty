"""Freeze an author draft using AST/data/filesystem observations only."""
import ast
import base64
import copy
import datetime
import hashlib
import json
import math
import re
import stat
from pathlib import Path

S = Path(__file__).resolve().parent
sha = lambda data: hashlib.sha256(data).hexdigest()
stamp = lambda: datetime.datetime.now(datetime.timezone.utc).isoformat()

def strict_json(data):
    def unique(rows):
        result = {}
        for key, value in rows:
            assert key not in result, key
            result[key] = value
        return result
    def finite_float(value):
        number = float(value)
        assert math.isfinite(number), value
        return number
    return json.loads(data.decode('utf-8', errors='strict'), object_pairs_hook=unique,
                      parse_float=finite_float,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))

def capture(path):
    info = path.lstat()
    assert stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode) and info.st_nlink == 1
    assert not int(getattr(info, 'st_file_attributes', 0)) & 0x400
    data = path.read_bytes()
    after = path.lstat()
    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode',
              'st_nlink', 'st_file_attributes', 'st_birthtime_ns')
    before_row = [getattr(info, key, None) for key in fields]
    assert before_row == [getattr(after, key, None) for key in fields] and len(data) == info.st_size
    return {'path':str(path), 'sha256':sha(data), 'bytes':len(data), 'identity':before_row}, data

def declared(value):
    return value['sha256'] if isinstance(value, dict) else value

paths = {S/'BASELINE_PRESERVATION_001.json', S/'BASELINE_PRESERVATION_SUPPLEMENT_002.json'}
before = strict_json((S/'BASELINE_PRESERVATION_001.json').read_bytes())
supplement = strict_json((S/'BASELINE_PRESERVATION_SUPPLEMENT_002.json').read_bytes())
for row in before['source_snapshot_rows'] + supplement['rows']:
    original = Path(row.get('source',row.get('path')))
    retained = Path(row.get('copy', row.get('retained_path', '')))
    assert retained.is_file(), row
    assert sha(original.read_bytes()) == row['sha256'] and original.read_bytes() == retained.read_bytes(), row
    paths.update((original, retained))
for path in S.rglob('*'):
