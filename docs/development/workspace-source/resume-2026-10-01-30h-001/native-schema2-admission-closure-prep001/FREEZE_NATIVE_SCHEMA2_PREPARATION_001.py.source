assert first == second, 'paired input/source observations changed'

def emit(name, doc):
    path = S/name
    assert not path.exists(), name
    path.write_bytes((json.dumps(doc, sort_keys=True, ensure_ascii=True, allow_nan=False, indent=2)+'\n').encode('utf-8'))
    return {'path':name,'sha256':sha(path.read_bytes()),'bytes':len(path.read_bytes())}

