"""One-use author metadata composition; reads data/AST and writes design records only."""
import ast
import base64
import hashlib
import json
import os
import stat
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).absolute().parent
WORK = ROOT.parent
NATIVE = ROOT / 'before/native002'


def sha(data):
    return hashlib.sha256(data).hexdigest()


def ident(value):
    return [value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns,
            value.st_ctime_ns, value.st_mode, value.st_nlink,
            value.st_file_attributes, value.st_birthtime_ns]


def capture(path):
    before = path.lstat()
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1
    assert not before.st_file_attributes & 0x400 and before.st_size <= 16000000
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        assert opened.st_size == before.st_size
        data = stream.read(before.st_size + 1)
        closed = os.fstat(stream.fileno())
    after = path.lstat()
    assert ident(before) == ident(after) and ident(opened) == ident(closed)
    assert len(data) == before.st_size
    assert ident(before)[:4] + [before.st_birthtime_ns] + ident(before)[5:8] == (
        ident(opened)[:4] + [opened.st_birthtime_ns] + ident(opened)[5:8])
    return {'path': str(path), 'sha256': sha(data), 'bytes': len(data),
            'identity': ident(before)}, data


def write_once(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    row, observed = capture(path)
    assert observed == data
    return row


metadata_observation, metadata_bytes = capture(ROOT / 'SOURCE_AND_CALLER_METADATA_003.json')
assert metadata_observation['sha256'] == '83331ba9e9d3e50e53d4c1217d9e8308353de0dbb9cc38f74bab0dc881a5c64c'
metadata = json.loads(metadata_bytes)
before_observation, before_bytes = capture(ROOT / 'NATIVE002_BEFORE_MANIFEST_003.json')
assert before_observation['sha256'] == '4d4a3667287b3896b5a4b72799728a54205548d041fa691d9e9264ae3107d875'
md_observation, md_bytes = capture(ROOT / 'STDIN_FRAME_NATIVE_TRANSPORT_DESIGN_003.md')
extra_inputs = []
for relative, expected in (
    ('FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.json', '116b2257fb327242877bbec868d632a8207157e3849e912d566a942896b03c9d'),
    ('FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.md', '9150e6dd0e8fa5d4829af00551c305fec516235dffd0a931ed7155d752f361ad'),
    ('publisher-schema2-grammar-revision004/METADATA_GRAMMAR_INTERFACE_004.json', 'f8fda24b4d1d1d8e29de6a91c489f8aa7df0336f35d742c386e1d4830e3b1685'),
):
    original, data = capture(WORK / relative)
    assert original['sha256'] == expected
    copied = write_once(ROOT / 'inputs' / relative, data)
    assert original['identity'][:2] != copied['identity'][:2]
    extra_inputs.append({'original': original, 'copy': copied,
                         'scope': 'Authenticated author design/interface data; no policy/runtime acceptance inferred.'})

tree = ast.parse((NATIVE / 'front/native_successor_front_common_013_001.py.template').read_bytes(), type_comments=True)
assert not any(getattr(node, 'type_comment', None) for node in ast.walk(tree))
null_globals = []
for node in tree.body:
    if isinstance(node, ast.Assign) and isinstance(node.value, ast.Constant) and node.value.value is None:
        null_globals.extend(name.id for name in node.targets if isinstance(name, ast.Name))
test_tree = ast.parse((NATIVE / 'source/test_native_schema2_admission_002.py').read_bytes())
test_asts = {cls.name + '.' + function.name: sha(ast.dump(function, include_attributes=False).encode())
             for cls in test_tree.body if isinstance(cls, ast.ClassDef)
             for function in cls.body if isinstance(function, ast.FunctionDef) and function.name.startswith('test_')}
assert len(test_asts) == 85
preview_size = metadata['formatting_only_preview']['utf8_bytes']
budget_examples = []
for delta in (0, 1024, 2048, 4096):
    source_size = preview_size + delta
    encoded_source = 4 * ((source_size + 2) // 3)
    encoded_binding_maximum = min(16384, 4 * ((262142 - encoded_source) // 4))
    json_maximum = 3 * (encoded_binding_maximum // 4)
    budget_examples.append({'illustrative_new_source_growth_bytes': delta,
                           'source_utf8_bytes': source_size,
                           'source_base64_bytes': encoded_source,
                           'bindings_base64_maximum': encoded_binding_maximum,
                           'bindings_json_maximum': json_maximum,
                           'available_sum_of_16_escaped_path_literal_widths': json_maximum - 5331,
                           'is_final_budget_or_bound_choice': False})

