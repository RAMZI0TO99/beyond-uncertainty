peer_candidates = [base / 'guard005-root-metadata-prep001/INDEPENDENT_ROOT_METADATA_PREPARER_STATIC_REVIEW_001.json',
                   base / 'guard005-root-metadata-prep001/INDEPENDENT_METADATA_STATIC_REVIEW_005.json']
metadata_peer = next((p for p in peer_candidates if p.is_file()), None)
assert metadata_peer is not None, 'Metadata preparer review not yet frozen'
assert metadata_peer.with_suffix('.md').is_file(), 'Paired metadata review not yet frozen'
names += [metadata_peer.relative_to(base).as_posix(), metadata_peer.with_suffix('.md').relative_to(base).as_posix()]
inputs = {'resume-2026-10-01-30h-001/' + n: (base / n).read_bytes() for n in names}
continuation = 'resume-2026-09-28-001/full-gate-009/continuation-001-start.json'
inputs[continuation] = (root / continuation).read_bytes()
digest = lambda b: hashlib.sha256(b).hexdigest()
key = lambda n: 'resume-2026-10-01-30h-001/' + n
short = lambda n: digest(inputs[key(n)])[:8]
load = lambda n: json.loads(inputs[key(n)].decode('utf-8'))
docs_peer = load('INDEPENDENT_DOCS_REFRESH_REVIEW_019.json')
guard_peer = load('consumer-guard-test-runtime005/INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_005.json')
meta_peer_body = json.loads(inputs[metadata_peer.relative_to(root).as_posix()].decode('utf-8'))
assert 'PASS' in docs_peer['verdict']
assert guard_peer['verdict'] == 'PASS_STATIC_PREPARATION_ONLY'
assert 'PASS' in meta_peer_body['verdict'] and 'REFUSED' not in meta_peer_body['verdict']
started = json.loads(inputs[continuation].decode('utf-8'))
stamp = datetime.now(timezone.utc).isoformat(timespec='microseconds')
body = f'''# Major step020 - copied guard launcher reviewed; staged proof and frame authoring authorized

Recorded {stamp}. Owner local/private window ends **2026-10-02T22:36:15Z**.
[Checkpoint019 docs review](INDEPENDENT_DOCS_REFRESH_REVIEW_019.json),
{short('INDEPENDENT_DOCS_REFRESH_REVIEW_019.json')}, passes39 declarations,26 pairs and
26 links with a precise legacy-canonical qualification. All earlier history is retained.

[Canonical-premise correction](INDEPENDENT_COMPACT_CANONICAL_CORRECTION_REVIEW_001.json),
{short('INDEPENDENT_COMPACT_CANONICAL_CORRECTION_REVIEW_001.json')}, passes as metadata/AST
only. Actual raw7fe already checks canonical compact ASCII bytes plus oneLF for
legacy1/2 at line3543. The original compact design's contrary parser-only attribution
is false and preserved with its separate correction. Future3 must extend the existing
check without changing old semantics. The independent361287 size arithmetic remains
separate source-design evidence, not a newly recomputed result or runtime acceptance.

[Native frame design review](native-stdin-frame-transport-design003/INDEPENDENT_NATIVE_STDIN_FRAME_DESIGN_REVIEW_003.json),
{short('native-stdin-frame-transport-design003/INDEPENDENT_NATIVE_STDIN_FRAME_DESIGN_REVIEW_003.json')},
