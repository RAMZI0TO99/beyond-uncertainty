import hashlib
import json
from pathlib import Path

root = Path(r'D:\Aenv\pro2\resume-2026-10-01-30h-001\native-schema2-admission-closure-prep003')
old = root / 'COMPOSE_FRAME_SOURCE_003.py'
data = old.read_bytes()
needle = b'schema = ast.literal_eval(schema_node.value)'
assert data.count(needle) == 1
replacement = b"assert isinstance(schema_node.value, ast.Call) and isinstance(schema_node.value.func, ast.Attribute) and schema_node.value.func.attr == 'loads'\nschema = json.loads(ast.literal_eval(schema_node.value.args[0]))"
new = data.replace(needle, replacement)
with (root / 'COMPOSE_FRAME_SOURCE_004.py').open('xb') as stream:
    stream.write(new)
record = {'schema_version': 1, 'author': '/root/bootstrap_stage', 'record_type': 'author_composition_prewrite_refusal', 'source_path': str(old), 'source_sha256': hashlib.sha256(data).hexdigest(), 'reason': 'BINDING_SCHEMA is source-pinned json.loads(literal), not a directly literal-evaluable dict; the metadata composer failed before any active source changes.', 'active_source_changes_before_failure': 0, 'prepared_definitions_compilation_import_tests_FFI_Git_native_executed': False, 'successor_utility': 'COMPOSE_FRAME_SOURCE_004.py'}
with (root / 'AUTHOR_COMPOSITION_METADATA_REFUSAL_003.json').open('xb') as stream:
    stream.write((json.dumps(record, sort_keys=True, indent=2) + '\n').encode('ascii'))
print(hashlib.sha256(new).hexdigest())
