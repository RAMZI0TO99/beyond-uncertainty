import hashlib
import json
from pathlib import Path

root = Path(r'D:\Aenv\pro2\resume-2026-10-01-30h-001\native-schema2-admission-closure-prep003')
old = root / 'COMPACT_BOOTSTRAP_TOKENS_006.py'
data = old.read_bytes()
needle = b"if observed != [(previous.type, previous.string), (token.type, token.string)]:"
assert data.count(needle) == 1
new = data.replace(needle, b"if (previous.type == tokenize.NUMBER and token.type == tokenize.NAME) or observed != [(previous.type, previous.string), (token.type, token.string)]:")
new = new.replace(b"'bootstrap-layout005'", b"'bootstrap-layout006'").replace(b"'AST_EQUAL_BOOTSTRAP_LAYOUT_CHECKPOINT_006.json'", b"'AST_EQUAL_BOOTSTRAP_LAYOUT_CHECKPOINT_007.json'")
with (root / 'COMPACT_BOOTSTRAP_TOKENS_007.py').open('xb') as stream:
    stream.write(new)
record = {'schema_version': 1, 'author': '/root/bootstrap_stage', 'reason': 'AST-equal first lexical compaction exposed metadata SyntaxWarning for adjacent NUMBER/NAME tokens. The successor preserves a separator for this lexical pair; no target definition or compile/execute occurred.', 'old_utility_sha256': hashlib.sha256(data).hexdigest(), 'old_checkpoint': 'AST_EQUAL_BOOTSTRAP_LAYOUT_CHECKPOINT_006.json', 'status': 'PRESERVED_PRE_FREEZE_METADATA_NOTICE'}
with (root / 'AUTHOR_LEXICAL_SPACING_NOTICE_006.json').open('xb') as stream:
    stream.write((json.dumps(record, sort_keys=True, indent=2) + '\n').encode('ascii'))
