work = Path(r'D:\Aenv\pro2\resume-2026-10-01-30h-001')
root = work / 'native-schema2-admission-closure-prep003'
prior = root / 'before/native002'
mapping = json.loads((root / 'before/design003/SOURCE_AND_CALLER_METADATA_003.json').read_bytes())
preservation = json.loads((root / 'PRESERVATION_AND_COMPACTION_001.json').read_bytes())
common_relative = 'front/native_successor_front_common_013_001.py.template'
test_relative = 'source/test_native_schema2_admission_002.py'


def observe(path):
    start = path.lstat()
    assert stat.S_ISREG(start.st_mode) and start.st_nlink == 1 and not start.st_file_attributes & 0x400, path
    with path.open('rb') as stream:
        opened = os.fstat(stream.fileno())
        data = stream.read()
        final = os.fstat(stream.fileno())
    finish = path.lstat()
    names = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')
    raw = lambda item: [getattr(item, key) for key in names]
    p, f = raw(start), raw(opened)
    assert p == raw(finish) and f == raw(final) and p[:4] + p[5:] == f[:4] + f[5:] and p[4] == p[8], path
    assert len(data) == p[2], path
    return data, dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest(), path_raw9=p, descriptor_raw9=f)


def write_once(path, value):
    data = (json.dumps(value, sort_keys=True, indent=2) + '\n').encode('ascii')
    with path.open('xb') as stream:
        stream.write(data)
    return observe(path)[1]


def parsed(data):
    with warnings.catch_warnings(record=True) as notices:
        warnings.simplefilter('error', SyntaxWarning)
        tree = ast.parse(data)
    assert not notices
    return tree


def dump(tree):
    return ast.dump(tree, include_attributes=False)


def assignments(tree):
    return {node.targets[0].id: node.value for node in tree.body if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)}


def literal(node):
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'loads' and len(node.args) == 1:
        return json.loads(ast.literal_eval(node.args[0]))
    return ast.literal_eval(node)


def methods(tree):
    return {cls.name + '.' + node.name: dump(node) for cls in tree.body if isinstance(cls, ast.ClassDef) for node in cls.body if isinstance(node, ast.FunctionDef) and node.name.startswith('test_')}


external_initial = []
assert preservation['pair_count'] == len(preservation['original_copy_pairs']) == 580
for pair in preservation['original_copy_pairs']:
    values = []
    for role in ('original', 'copy'):
        expected = pair[role]
        actual = observe(Path(expected['path']))[1]
        assert actual == expected
        values.append(actual)
    assert values[0]['sha256'] == values[1]['sha256'] and values[0]['path_raw9'][1] != values[1]['path_raw9'][1]
    external_initial.append(values)

common_bytes, common_identity = observe(root / common_relative)
old_common_bytes = observe(prior / common_relative)[0]
common_tree, old_common_tree = parsed(common_bytes), parsed(old_common_bytes)
current_named = {node.name: node for node in common_tree.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))}
old_named = {node.name: node for node in old_common_tree.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))}
frame_names = {'_native_frame_binding_shape', '_native_frame_decode', '_native_frame_encode', '_native_frame_read'}
assert set(current_named) - set(old_named) == frame_names and set(old_named) - set(current_named) == set()
changed_named = {name for name in old_named if dump(current_named[name]) != dump(old_named[name])}
assert changed_named == {'_native_behavior_manifest'}
reversed_common = ast.Module(body=[old_named[node.name] if isinstance(node, ast.FunctionDef) and node.name == '_native_behavior_manifest' else node for node in common_tree.body if not isinstance(node, ast.FunctionDef) or node.name not in frame_names], type_ignores=[])
assert dump(reversed_common) == dump(old_common_tree)
schema = literal(assignments(common_tree)['BINDING_SCHEMA'])
assert schema == mapping['bindings_schema'] and len(schema) == 44
assert collections.Counter(schema.values()) == collections.Counter(dict(sha256=39, commit=1, count=1, path=2, provenance=1))
frame_schema = literal(next(node.value for node in current_named['_native_frame_binding_shape'].body if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == 'schema' for target in node.targets)))
assert frame_schema == schema
unbound_names = ['NATIVE_REVIEW_MAX_BYTES', 'NATIVE_REVIEW_BOUND_DERIVATION_SHA256', 'NATIVE_BEHAVIOR_CAPS', 'NATIVE_BEHAVIOR_CAP_DERIVATION_SHA256']
for name in unbound_names:
    assert literal(assignments(common_tree)[name]) is None

bootstrap_bytes, bootstrap_identity = observe(root / 'CAPTURED_FRAME_BOOTSTRAP_003.py.txt')
bootstrap = bootstrap_bytes.decode('utf-8')
bootstrap_tree = parsed(bootstrap_bytes)
bootstrap_named = {node.name: node for node in bootstrap_tree.body if isinstance(node, ast.FunctionDef)}
assert set(bootstrap_named) == frame_names - {'_native_frame_encode'}
for name in bootstrap_named:
    assert dump(bootstrap_named[name]) == dump(current_named[name])
q_call = next(index for index, node in enumerate(bootstrap_tree.body) if isinstance(node, ast.Assign) and isinstance(node.value, ast.Call) and isinstance(node.value.func, ast.Name) and node.value.func.id == 'q')
frame_read = next(index for index, node in enumerate(bootstrap_tree.body) if isinstance(node, ast.Assign) and isinstance(node.value, ast.Call) and isinstance(node.value.func, ast.Name) and node.value.func.id == '_native_frame_read')
argv_insert = next(index for index, node in enumerate(bootstrap_tree.body) if isinstance(node, ast.Assign) and isinstance(node.value, ast.List) and any(isinstance(target, ast.Subscript) and isinstance(target.value, ast.Attribute) and target.value.attr == 'argv' for target in node.targets))
execution = next(index for index, node in enumerate(bootstrap_tree.body) if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call) and isinstance(node.value.func, ast.Name) and node.value.func.id == 'exec')
assert q_call < frame_read < argv_insert < execution
assert "q.argtypes=[]" in bootstrap and "q.restype=ctypes.c_wchar_p" in bootstrap
assert "len(w.encode('utf-16-le'))//2<=8191" in bootstrap

sender = (root / 'EXPANDED_FRAME_SENDER_003.ps1.txt').read_text(encoding='utf-8')
ps_metadata = json.loads((root / 'POWERSHELL_PARSE_METADATA_013.json').read_bytes())
assert ps_metadata['all_parsed_without_errors'] is True and ps_metadata['source_count'] == 15
ps_pins = {Path(row['path']).relative_to(root).as_posix(): row for row in ps_metadata['files']}
callers, literal_tables, python_direct_sites, ps_direct_sites = [], [], [], []
assert len(mapping['callers']) == 31
for item in mapping['callers']:
    relative = item['relative_path']
    data, identity = observe(root / relative)
    original = observe(prior / relative)[0]
    changed = data != original
    if item['language'] == 'Python':
        tree = parsed(data)
        if relative != common_relative:
            assert not changed
        if item['literal_44_table']:
            tables = [literal(node) for node in assignments(tree).values() if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == 'loads' and len(node.args) == 1 and isinstance(node.args[0], ast.Constant) and isinstance(node.args[0].value, str) and 'publisher_sha256' in node.args[0].value]
            tables = [table for table in tables if isinstance(table, dict) and set(table) == set(schema)]
            assert len(tables) == 1 and all(value is None for value in tables[0].values())
            literal_tables.append(relative)
        if item['direct_capture_boundary']:
            python_direct_sites.append(relative)
    elif item['language'] == 'PowerShell':
        text = data.decode('utf-8')
        assert ps_pins[relative]['sha256'] == identity['sha256'] and ps_pins[relative]['bytes'] == identity['bytes'] and ps_pins[relative]['error_count'] == 0
        is_bridge = relative in mapping['powershell_direct_capture_sites']
        assert changed == is_bridge
        if is_bridge:
            assert text.count(sender) == 1
            variable = 'frontBootstrap' if '$frontBootstrap =' in text else 'bootstrap'
            match = re.search(r'\$' + variable + r"\s*=\s*'((?:[^']|'')*)'", text)
            assert match and match.group(1).replace("''", "'") == bootstrap
            assert "'--bindings-base64'," not in text and 'frontPayload | &' not in text and '$payload | &' not in text
            assert 'sender encoded sum exceeds262142' in text and 'Frame sender complete byte cap differs' in text
            assert '$input.Write($Frame,$offset,$take); $offset += $take' in text and '$input.Flush()' in text and '$input.Close()' in text
            assert '$code -lt 32 -or $code -ge 127' in text
            assert 'Stdout' not in text or 'ReadAsync' in text
            ps_direct_sites.append(relative)
        if item['literal_44_table']:
            match = re.search(r'\$FrontBindings\s*=\s*\[ordered\]@\{([^}]+)\}', text, re.IGNORECASE)
            assert match
            fields = re.findall(r'^\s*([A-Za-z0-9_]+)\s*=\s*\$null(?:\s*#[^\n]*)?\s*$', match.group(1), re.MULTILINE)
            assert len(fields) == 44 and set(fields) == set(schema)
            literal_tables.append(relative)
    else:
        assert item['language'] == 'CSharp' and not changed
    callers.append(dict(relative_path=relative, language=item['language'], changed=changed, direct_capture_boundary=item['direct_capture_boundary'], nonliteral_dependency=item['nonliteral_dependency'], literal_44_table=item['literal_44_table'], **{key: identity[key] for key in ('bytes', 'sha256')}))
assert len(literal_tables) == 21 and len(python_direct_sites) == 12 and len(ps_direct_sites) == 8
assert sum(item['nonliteral_dependency'] for item in callers) == 9
assert sum(item['changed'] for item in callers) == 9

