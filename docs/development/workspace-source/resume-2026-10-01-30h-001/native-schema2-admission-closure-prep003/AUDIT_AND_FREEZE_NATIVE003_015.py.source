audit = dict(schema_version=1, author='/root/bootstrap_stage', status='SOURCE_PREPARATION_ONLY_UNBOUND_UNRUN_OPERATIONALLY_UNBINDABLE',
             source_caller_count=31, languages=dict(collections.Counter(row['language'] for row in callers)), callers=callers,
