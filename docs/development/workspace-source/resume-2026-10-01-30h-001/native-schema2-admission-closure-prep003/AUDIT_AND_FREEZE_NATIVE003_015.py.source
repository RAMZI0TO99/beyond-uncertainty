    assert all(current[key] == row[key] for key in ('sha256', 'bytes', 'path_raw9', 'descriptor_raw9'))
for pair in preservation['original_copy_pairs']:
    for role in ('original', 'copy'):
        assert observe(Path(pair[role]['path']))[1] == pair[role]
assert observe(root / 'STAGED_MANIFEST_003.json')[1] == manifest_identity
