initial_rows = []
for path in sorted((path for path in root.rglob('*') if path.is_file()), key=lambda path: path.relative_to(root).as_posix()):
    identity = observe(path)[1]
    initial_rows.append(dict(relative_path=path.relative_to(root).as_posix(), **{key: identity[key] for key in ('sha256', 'bytes', 'path_raw9', 'descriptor_raw9')}))
for row in initial_rows:
