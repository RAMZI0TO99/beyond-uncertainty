"""Clarify an overbroad metadata label without amending the frozen choice."""
from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,os
base=Path('D:/Aenv/pro2/resume-2026-10-01-30h-001')
prior=base/'ROOT_BOUNDED_PUBLISHER_NATIVE_SOURCE_CHOICE_008.json'
data=prior.read_bytes();sha=lambda value:hashlib.sha256(value).hexdigest()
assert sha(data)=='016705971c3da31dd9d45dff2edde4499cd6202a793750ab7b33182cdc8d2d34'
output=base/'ROOT_SOURCE_CHOICE008_GUARD_SCOPE_PRECISION_009.json';assert not output.exists()
record=dict(schema_version=1,record_type='root_source_choice008_guard_scope_precision',author='/root',
    created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),prior_sha256=sha(data),
    preserved_prior_field='public_science_epoch_role_API_cap_guard_change_authorized=False',
    qualification='The last combined label was overbroad for guards: it prohibits guard reduction. Explicitly named choice008 typed/identity/bounded-shape/transitive fresh-code guard strengthening and implementation changes ARE authorized as source preparation. API, roles, fields, caps, epoch, science and public scope are unchanged.',
    explicit_named_guard_strengthening_source_only_authorized=True,guard_reduction_authorized=False,
    inherited_Path_nominal_semantics_change_authorized=False,
    target_runtime_or_binding_or_live_action_authorized=False,different_complete_source_review_required=True,
    prior_bytes_amended=False)
payload=(json.dumps(record,indent=2,sort_keys=True)+'\n').encode('ascii')
with output.open('xb') as stream:stream.write(payload);stream.flush();os.fsync(stream.fileno())
assert prior.read_bytes()==data
print(json.dumps(dict(precision_sha256=sha(payload),bytes=len(payload))))
