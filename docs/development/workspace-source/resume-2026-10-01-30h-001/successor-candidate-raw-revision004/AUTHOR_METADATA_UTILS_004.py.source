from pathlib import Path
import ast,base64,hashlib,json,os,stat
from datetime import datetime,timezone
W=Path(r"D:\Aenv\pro2\resume-2026-10-01-30h-001"); N=W/'successor-candidate-raw-revision004'
def raw(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None)]
def cross(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_nlink]
def read(p):
 for q in reversed(p.parents):
  z=q.lstat();assert stat.S_ISDIR(z.st_mode) and not getattr(z,'st_file_attributes',0)&1024
 a=p.lstat();assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not getattr(a,'st_file_attributes',0)&1024 and 0<a.st_size<=8388608
 with p.open('rb') as f:
  b=os.fstat(f.fileno());assert cross(a)==cross(b)
  data=f.read(8388609);c=os.fstat(f.fileno())
 d=p.lstat();assert raw(a)==raw(d) and raw(b)==raw(c) and len(data)==a.st_size
 return data,{'path':str(p),'sha256':hashlib.sha256(data).hexdigest(),'bytes':len(data),'path_raw9':raw(a),'handle_raw9':raw(b)}
def put(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
def out(p,v):put(p,(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode())
def digest(b):return hashlib.sha256(b).hexdigest()
def preserve():
 d=json.loads(read(W/'FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.json')[0]);choice=json.loads(read(W/'ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_004.json')[0])
 selection=['successor-candidate-raw-revision003/scripts/week8_recovery_raw_authority.py','successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.json','successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.md','successor-candidate-raw-revision003/RAW_POLICY_STAGED_MANIFEST_003.json','successor-candidate-raw-revision003/ATTESTATION_SIZE_WITNESS_SCHEMA1_003.json','successor-candidate-raw-revision003/ATTESTATION_SIZE_WITNESS_SCHEMA2_003.json','raw-test-revision004/source/tests/test_week8_recovery_raw_authority.py','raw-test-revision004/source/scripts/week8_relocation_metadata.py','raw-test-revision004/source/src/bu/experiments/week8_relocation_provenance.py','raw-test-revision004/STAGED_MANIFEST_004.json','raw-test-revision004/AUTHOR_TEST_AST_DELTA_004.json','raw-test-revision004/CAUSAL_REGRESSION_MAP_004.json','raw-test-revision004/HANDOFF_004.md','raw-test-revision004/INDEPENDENT_RAW_TEST_REVISION_STATIC_REVIEW_004.json','raw-test-revision004/INDEPENDENT_RAW_TEST_REVISION_STATIC_REVIEW_004.md','raw-component-runtime-prep004/INDEPENDENT_RAW_COMPONENT_RUNTIME_REVIEW_004.json','raw-component-runtime-prep004/INDEPENDENT_RAW_COMPONENT_RUNTIME_REVIEW_004.md','RAW003_RUNTIME_FAILURE_DIAGNOSIS_001.json','RAW003_RUNTIME_FAILURE_DIAGNOSIS_001.md','OWNER_WORK_WINDOW_30H_20261001_001.json','OWNER_WORK_WINDOW_30H_20261001_001_REVIEW.md','FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.json','FINITE_RELEASE_CHAIN_COMPACT_DESIGN_002.md','INDEPENDENT_FINITE_RELEASE_CHAIN_COMPACT_REVIEW_002.json','INDEPENDENT_FINITE_RELEASE_CHAIN_COMPACT_REVIEW_002.md','FINITE_RELEASE_CHAIN_COMPACT_CANONICAL_CORRECTION_001.json','FINITE_RELEASE_CHAIN_COMPACT_CANONICAL_CORRECTION_001.md','INDEPENDENT_COMPACT_CANONICAL_CORRECTION_REVIEW_001.json','INDEPENDENT_COMPACT_CANONICAL_CORRECTION_REVIEW_001.md','ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_004.json','ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_004.md','publisher-schema2-revision003/before/predecessor_rows.bytes','publisher-schema2-revision003/before/predecessor_manifest.bytes','publisher-schema2-revision003/before/middle_release.bytes','publisher-schema2-revision003/before/middle_manifest.bytes','publisher-schema2-revision003/before/middle_commit_object.bytes','ROOT017_RELEASE009_COMMIT_OBJECT_002.bytes','ROOT017_RELEASE009_COMMIT_OBJECT_DETAILS_002.json','ROOT017_RELEASE009_COMMITTED742_MANIFEST_001.json','ROOT017_RELEASE009_COMMITTED_METADATA_OBSERVATION_001.json','../resume-2026-09-28-001/controller-release-009-proposal018.json','../resume-2026-09-28-001/d175-doc-proposal-018/candidate-after.json']
 pins={x['path']:(x['sha256'],x['bytes']) for x in choice['inputs']};pairs=[];initial={};materials={}
 designpins=d['input_observations'][0]
 for rel in selection:
  p=(W/rel).resolve();data,o=read(p)
  if rel in pins:assert (o['sha256'],o['bytes'])==pins[rel]
  if str(p) in designpins:assert o['sha256']==designpins[str(p)]['sha256']
  destination=N/'before'/('external/'+p.relative_to(W.parent).as_posix() if rel.startswith('../') else rel)
  put(destination,data);copy,co=read(destination);assert copy==data
  pairs.append({'source':o,'copy':co});initial[str(p)]=o;materials[rel]=data
 source=materials[selection[0]];test=materials['raw-test-revision004/source/tests/test_week8_recovery_raw_authority.py']
 assert digest(source)=='7fe7dc1989b882f6ef2cb22caaa5975b0b7d5d2907d84ee3c1b858facd57f267'
 assert digest(test)=='367a1d34c6a0d90656fdb296bc864b43452f6e8caac2f63a7fdb2ec7ca31661c'
 for path,data in [('scripts/week8_recovery_raw_authority.py',source),('tests/test_week8_recovery_raw_authority.py',test),('scripts/week8_relocation_metadata.py',materials['raw-test-revision004/source/scripts/week8_relocation_metadata.py']),('src/bu/experiments/week8_relocation_provenance.py',materials['raw-test-revision004/source/src/bu/experiments/week8_relocation_provenance.py'])]:put(N/path,data)
 chain=[d['historical_fact_authority'][k] for k in ('intermediate1','intermediate2')]
 for i,e in enumerate(chain,1):
  for field,name in [('release_record_base64','release'),('git_commit_object_base64','commit')]:put(N/f'facts/intermediate{i}-{name}.bytes',base64.b64decode(e['proof'][field],validate=True))
  out(N/f'facts/intermediate{i}-entry.json',e)
 out(N/'facts/grouped263-paths.json',d['deterministic_qa_reconstruction']['compiled_grouped_path_sequence'])
 source_ast=ast.parse(source);test_ast=ast.parse(test)
 out(N/'BASELINE_AST_BINDINGS_004.json',{'source_functions':{x.name:digest(ast.dump(x,include_attributes=False).encode()) for x in source_ast.body if isinstance(x,(ast.FunctionDef,ast.ClassDef))},'test_functions':{x.name:digest(ast.dump(x,include_attributes=False).encode()) for x in test_ast.body if isinstance(x,ast.FunctionDef)},'test_count':sum(isinstance(x,ast.FunctionDef) and x.name.startswith('test_') for x in test_ast.body),'target_code_executed':False})
 for p,o in initial.items():assert read(Path(p))[1]==o
 out(N/'AUTHOR_PREPARATION_REFUSAL_004_001.json',{'reason':'Initial read-only preparation guessed input_observations entries had path fields; actual entry is a path-keyed mapping. KeyError occurred before newfolder/copy writes; corrected metadata utility authenticated actual schema.','source_or_target_execution':False})
 out(N/'BEFORE_PRESERVATION_004.json',{'created_utc':datetime.now(timezone.utc).isoformat(),'author':'/root/raw_policy_worker','scope':'STAGED_RAW_SOURCE_AND_TEST_AUTHORING_ONLY','pairs':pairs,'source_sha256':digest(source),'test_sha256':digest(test),'all_pair_bytes_and_source_reobservation_exact':True,'target_import_compile_execution':False,'source_peer_pending':True,'runtime_pending':True,'operational_authority':False})
 print(json.dumps({'folder':str(N),'preserved_pairs':len(pairs),'top_level_source_functions':sum(isinstance(x,ast.FunctionDef) for x in source_ast.body),'top_level_test_functions':sum(isinstance(x,ast.FunctionDef) for x in test_ast.body),'test_methods':45,'initial_copies_only':True}))
if __name__=='__main__':preserve()
