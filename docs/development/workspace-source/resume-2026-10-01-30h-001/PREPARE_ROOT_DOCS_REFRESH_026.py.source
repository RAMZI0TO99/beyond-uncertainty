root = Path('D:/Aenv/pro2')
base = root / 'resume-2026-10-01-30h-001'
before = base / 'root-docs-before-major026'
copies = base / 'root-docs-inputs-major026'
checkpoint = base / '30H_RESUME_CHECKPOINT_026.md'
names = [
    '30H_RESUME_CHECKPOINT_025.md', 'DOCS_REFRESH_AUDIT_025.json',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_025.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_025.md',
