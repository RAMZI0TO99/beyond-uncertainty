def require(condition, what):
    if not condition:
        raise RuntimeError(what)


def directory_chain(directory):
    require('..' not in directory.parts, 'parent traversal in evidence path')
    absolute = directory.absolute()
    require(absolute.is_absolute(), 'evidence path is not absolute')
    identities = []
    for ancestor in [*reversed(absolute.parents), absolute]:
        item = ancestor.lstat()
        require(stat.S_ISDIR(item.st_mode) and not stat.S_ISLNK(item.st_mode)
                and not (getattr(item, 'st_file_attributes', 0) & 0x400),
                'non-plain evidence ancestor: ' + str(ancestor))
        identities.append((str(ancestor), item.st_dev, item.st_ino))
    return tuple(identities)


def absent(path):
    directory_chain(path.parent)
    try:
        path.lstat()
    except FileNotFoundError:
        return True
    return False


def plain(path, directory=False):
    directory_chain(path.parent)
    item = path.lstat()
    require(not stat.S_ISLNK(item.st_mode) and not (getattr(item, 'st_file_attributes', 0) & 0x400),
            'linked/reparse evidence: ' + str(path))
    require(stat.S_ISDIR(item.st_mode) if directory else stat.S_ISREG(item.st_mode),
            'non-plain evidence: ' + str(path))
    if not directory:
        require(item.st_nlink == 1, 'aliased evidence: ' + str(path))
    return item


def file_identity(item):
    return (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns, item.st_nlink)


def bytes_of(path):
    ancestors = directory_chain(path.parent)
    before = plain(path)
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        require(file_identity(before) == file_identity(opened), 'evidence replaced before read')
        value = stream.read()
        after_open = os.fstat(stream.fileno())
    after = plain(path)
    require(file_identity(before) == file_identity(after_open) == file_identity(after),
            'evidence changed while read: ' + str(path))
    require(len(value) == before.st_size, 'short evidence read')
    require(directory_chain(path.parent) == ancestors, 'evidence ancestors changed during read')
    return value


def sha(path):
    return hashlib.sha256(bytes_of(path)).hexdigest()


def pairs(rows):
    output = {}
    for name, value in rows:
        require(name not in output, 'duplicate JSON key')
        output[name] = value
    return output


def finite_float(value):
    result = float(value)
    require(math.isfinite(result), 'non-finite JSON number')
    return result


def invalid_constant(value):
    raise RuntimeError('non-finite JSON constant: ' + value)


def read(path):
    return json.loads(bytes_of(path).decode('utf-8-sig'), object_pairs_hook=pairs,
                      parse_float=finite_float, parse_constant=invalid_constant)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
                      allow_nan=False).encode('ascii')


def write_bytes_once(path, payload):
    ancestors = directory_chain(path.parent)
    with path.open('xb') as stream:
        stream.write(payload)
    require(directory_chain(path.parent) == ancestors, 'output ancestors changed during publication')
    require(bytes_of(path) == payload, 'written evidence differs')


def write_once(path, value):
    payload = (json.dumps(value, indent=2, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')
    write_bytes_once(path, payload)


def mkdir_once(path):
    ancestors = directory_chain(path.parent)
    path.mkdir()
    require(directory_chain(path.parent) == ancestors, 'output ancestors changed during directory creation')
    plain(path, directory=True)


def children(path):
    before = plain(path, directory=True)
    with os.scandir(path) as scan:
        names = sorted(item.name for item in scan)
    after = plain(path, directory=True)
    require((before.st_dev, before.st_ino, before.st_mtime_ns) ==
            (after.st_dev, after.st_ino, after.st_mtime_ns), 'directory changed during scan')
    return [path / name for name in names]


def named_children(path, prefix='', suffix=''):
    return {item.name for item in children(path)
            if item.name.startswith(prefix) and item.name.endswith(suffix)}


def aware(value):
    require(type(value) is str, 'timestamp is not text')
    parsed = datetime.fromisoformat(value)
    require(parsed.tzinfo is not None and parsed.utcoffset() == timedelta(0), 'timestamp is not aware UTC')
    return parsed


def runtime():
    require(sys.flags.optimize == 0 and sys.dont_write_bytecode, 'use active checks and -B')
    require(Path(sys.executable).resolve(strict=True) == PYTHON.resolve(strict=True), 'use pinned project Python')
    require(sys.flags.isolated == 1 and sys.flags.ignore_environment == 1
            and sys.flags.no_site == 1 and sys.flags.no_user_site == 1
            and sys.flags.safe_path and sys.flags.utf8_mode == 1,
            'use pinned -I -S -B -X utf8 flags')


def owner_current():
    require(sha(OWNER_RECORD) == OWNER_RECORD_SHA256 and sha(OWNER_REVIEW) == OWNER_REVIEW_SHA256,
            'owner record/review differs')
    owner = read(OWNER_RECORD)
    require(owner['authority'] == 'owner' and owner['decision'] == 'extend_supervised_local_private_work',
            'owner directive differs')
    require(owner['previous_owner_record_sha256'] == HISTORICAL['owner_record_sha256'], 'owner lineage differs')
    require(type(owner['authorized_duration_hours']) is int and owner['authorized_duration_hours'] == 30,
            'owner duration differs')
    require(owner['work_start_utc'] == OWNER_START_TEXT and owner['work_end_utc'] == OWNER_END_TEXT,
            'owner interval differs')
    for name in OWNER_FALSE_FIELDS:
        require(owner[name] is False, 'owner guard changed: ' + name)
    start, end = aware(owner['work_start_utc']), aware(owner['work_end_utc'])
    require(end - start == timedelta(hours=30), 'owner interval is not 30 hours')
    require(start <= datetime.now(timezone.utc) < end, 'outside reviewed owner window')
    require(LAST_PARTITION_START == end - timedelta(hours=1), 'partition reserve differs')
    return end


def key(node):
    parts = node.split('::')
    return ('.'.join([parts[0][:-3].replace('/', '.')] + parts[1:-1]), parts[-1])


def selected(nodes, selectors):
    return [node for node in nodes if any(node == spec or node.startswith(spec + '::')
            or node.startswith(spec + '[') for spec in selectors)]


def candidate():
    rows = []
    def visit(directory, paths):
        for path in children(directory):
            item = path.lstat()
            require(not stat.S_ISLNK(item.st_mode) and not (getattr(item, 'st_file_attributes', 0) & 0x400),
                    'candidate linked/reparse path')
            if stat.S_ISDIR(item.st_mode):
                if path.name != '__pycache__':
                    visit(path, paths)
            else:
                plain(path)
                paths.append(path)
    for folder in ('src', 'tests', 'scripts', 'docs'):
        paths = []
        visit(REPO / folder, paths)
        rows.extend([path.relative_to(REPO).as_posix(), sha(path)] for path in sorted(paths))
    for path in children(REPO):
        if path.name == '.git':
            continue
        item = path.lstat()
        if stat.S_ISREG(item.st_mode):
            rows.append([path.name, sha(path)])
        else:
            plain(path, directory=True)
    return rows


def git_output(cwd, *arguments):
    plain(cwd, directory=True)
    plain(GIT)
    command = [str(GIT), '-c', 'safe.directory=' + REPO.as_posix(),
               '-c', 'safe.directory=' + (PROJECT / 'pro2').as_posix(),
               '-c', 'safe.directory=' + FROZEN.as_posix(), *arguments]
    result = subprocess.run(command, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    require(result.returncode == 0 and result.stderr == b'', 'Git refused or emitted stderr')
    return result.stdout.decode('ascii')


def controller_identity():
    require(git_output(REPO, 'rev-parse', 'HEAD').strip() == CONTROLLER_HEAD, 'controller HEAD differs')
    dirty = git_output(REPO, 'status', '--porcelain', '--untracked-files=no').splitlines()
    require(dirty == EXPECTED_DIRTY, 'controller tracked changes differ')
    for line in git_output(REPO, 'status', '--porcelain', '--untracked-files=normal').splitlines():
        if line in EXPECTED_DIRTY:
            continue
        require(line.startswith('?? ') and line.endswith('/'), 'unexpected controller untracked file')
        name = line[3:-1]
        require('/' not in name and name not in PROTECTED_TOP_DIRS, 'untracked controller protected path')


def frozen_identity():
    require(git_output(FROZEN, 'rev-parse', 'HEAD').strip() == FROZEN_WORKTREE_HEAD, 'frozen HEAD differs')
    require(git_output(FROZEN, 'status', '--porcelain', '--untracked-files=all') == '', 'frozen worktree differs')


def collected(path):
    lines = bytes_of(path).decode('utf-8').splitlines()
    nodes = [line for line in lines if re.match(r'^tests/test_.*::', line)]
    require(len(nodes) == len(set(nodes)) and len({key(node) for node in nodes}) == len(nodes),
            'duplicate collected node or JUnit key')
    return nodes


def accepted_group(group, baseline, name, receipt_root, receipt_required=True):
    folder = QA / name
    plain(folder, directory=True)
    result_path, junit_path = folder / 'result.json', folder / 'junit.xml'
    proof_paths = [result_path, junit_path, folder / 'candidate-before.json', folder / 'candidate-after.json']
    if receipt_required:
        proof_paths.append(receipt_root / (name + '.accepted.json'))
    observations = {path: (file_identity(plain(path)), sha(path)) for path in proof_paths}
    result = read(result_path)
    require(type(result['exit_code']) is int and result['exit_code'] == 0
            and result['source_unchanged'] is True and result['collect_only'] is False,
            'unaccepted result: ' + name)
    require(sha(folder / 'candidate-before.json') == sha(folder / 'candidate-after.json') == baseline,
            'partition candidate changed: ' + name)
    receipt = {'result_sha256': sha(result_path), 'junit_sha256': sha(junit_path)}
    if receipt_required:
        require(read(receipt_root / (name + '.accepted.json')) == receipt, 'accepted receipt differs: ' + name)
    xml = ET.fromstring(bytes_of(junit_path))
    cases = xml.findall('.//testcase')
    mapping = {key(node): node for node in group['Nodes']}
    found = [(case.attrib['classname'], case.attrib['name']) for case in cases]
    require(type(group['ExpectedNodes']) is int and len(mapping) == group['ExpectedNodes']
            and len(found) == len(set(found)) == len(mapping) and set(found) == set(mapping),
            'partition JUnit identity/count differs: ' + name)
    skips, extra = [], 0
    for case in cases:
        require(case.find('failure') is None and case.find('error') is None, 'partition failed: ' + name)
        skipped = case.find('skipped')
        if skipped is not None:
            skips.append({'node': mapping[(case.attrib['classname'], case.attrib['name'])],
                          'reason': skipped.attrib.get('message', '')})
    suites = xml.findall('testsuite')
    require(bool(suites), 'JUnit lacks suites')
    for suite in suites:
        require(int(suite.attrib['failures']) == int(suite.attrib['errors']) == 0, 'suite failed')
        increment = int(suite.attrib['tests']) - len(suite.findall('testcase'))
        require(increment >= 0, 'negative subtest count')
        extra += increment
    if 'ExpectedSkipNodes' in group:
        require(sorted(row['node'] for row in skips) == group['ExpectedSkipNodes'], 'skip identities changed')
        require(extra == group['ExpectedReportedSubtests'], 'reported subtests changed')
    for path, observation in observations.items():
        require((file_identity(plain(path)), sha(path)) == observation, 'partition input changed during proof')
    return xml, skips, extra, result, receipt


def prior_gate_complete():
    require(sha(PRIOR_ROOT / 'plan.json') == HISTORICAL['plan_sha256'], 'historical gate007 plan differs')
    require(sha(PRIOR_ROOT / 'release-verification.json') == PRIOR_RELEASE_VERIFICATION_SHA256,
            'final gate007 report differs')
    require(sha(PRIOR_ROOT / 'release-junit.xml') == PRIOR_COMBINED_JUNIT_SHA256, 'gate007 combined JUnit differs')
    require(sha(PRIOR_DRIVER) == HISTORICAL['driver_helper_sha256'], 'gate007 driver bytes differ')
    require(sha(PRIOR_ROOT / 'driver-start.json') == PRIOR_DRIVER_START_SHA256
            and sha(PRIOR_ROOT / 'driver-finished.json') == PRIOR_DRIVER_FINISH_SHA256, 'gate007 driver receipts differ')
    require(absent(PRIOR_ROOT / 'driver-paused.json') and absent(PRIOR_ROOT / 'driver-failed.json'),
            'gate007 is not a final accepted driver')
    prior, old_plan = read(PRIOR_ROOT / 'release-verification.json'), read(PRIOR_ROOT / 'plan.json')
    require(old_plan['collection'] == HISTORICAL['collection']
            and old_plan['collected_nodes'] == HISTORICAL['collected_nodes'], 'gate007 collection plan differs')
    old_collection = Path(HISTORICAL['collection'])
    require(sha(old_collection / 'result.json') == HISTORICAL['collection_result_sha256'], 'gate007 collection result differs')
    old_collection_result = read(old_collection / 'result.json')
    require(type(old_collection_result['exit_code']) is int and old_collection_result['exit_code'] == 0
            and old_collection_result['source_unchanged'] is True and old_collection_result['collect_only'] is True,
            'gate007 collection was not accepted')
    require(sha(old_collection / 'candidate-before.json') == sha(old_collection / 'candidate-after.json')
            == HISTORICAL['candidate_manifest_sha256'], 'gate007 collection manifest differs')
    require(prior['complete'] is True and prior['failures'] == prior['errors'] == 0, 'gate007 incomplete or failed')
    for field in ('collected_nodes', 'candidate_manifest_sha256', 'plan_sha256', 'collection_result_sha256',
                  'owner_record_sha256', 'controller_head', 'frozen_worktree_head', 'd176_source_sha256',
                  'd176_tests_sha256'):
        require(prior[field] == HISTORICAL[field], 'gate007 historical report mismatch: ' + field)
    require(prior['driver_helper_sha256'] == HISTORICAL['driver_helper_sha256']
            and prior['driver_start_sha256'] == PRIOR_DRIVER_START_SHA256
            and prior['driver_finished_sha256'] == PRIOR_DRIVER_FINISH_SHA256
            and prior['combined_junit_sha256'] == PRIOR_COMBINED_JUNIT_SHA256
            and prior['reconciliation_helper_sha256'] == PRIOR_VERIFIER_HELPER_SHA256,
            'gate007 final receipt/helper linkage differs')
    require(sha(PRIOR_VERIFIER) == PRIOR_VERIFIER_HELPER_SHA256, 'gate007 reviewed bound verifier differs')
    require(prior['distinct_testcase_elements'] == prior['collected_nodes']
            and prior['skipped'] == EXPECTED_SKIPS and prior['additional_reported_subtests'] == EXPECTED_SUBTESTS
            and prior['passed'] == prior['collected_nodes'] - prior['skipped']
            and prior['expected_skip_nodes_match_prior_gate'] is True, 'gate007 reconciliation differs')
    require(EXPECTED_SKIPS == old_plan['prior_expected_skips']
            and EXPECTED_SUBTESTS == old_plan['prior_expected_subtests'], 'gate007 legacy skips/subtests changed')
    groups = old_plan['partitions']
    require(len(groups) == len(prior['partitions']) == 45, 'gate007 partition count differs')
    names = {'g7-' + group['Name'] + '-001' for group in groups}
    require(named_children(PRIOR_ROOT, suffix='.accepted.json') == {name + '.accepted.json' for name in names}
            and named_children(QA, prefix='g7-') == names, 'gate007 accepted coverage names differ')
    profiles, all_skips, all_extra, all_nodes = {}, [], 0, []
    reconstructed_combined = ET.Element('testsuites')
    for group, row in zip(groups, prior['partitions'], strict=True):
        name = 'g7-' + group['Name'] + '-001'
        xml, skips, extra, result, receipt = accepted_group(group, HISTORICAL['candidate_manifest_sha256'],
                                                          name, PRIOR_ROOT)
        require(row['run'] == name and row['collected_nodes'] == group['ExpectedNodes']
                and row['junit_sha256'] == receipt['junit_sha256'], 'gate007 report partition differs')
        profiles[group['Name']] = {'ExpectedSkipNodes': sorted(item['node'] for item in skips),
                                    'ExpectedReportedSubtests': extra}
        all_skips.extend(skips)
        all_extra += extra
        all_nodes.extend(group['Nodes'])
        for suite in xml.findall('testsuite'):
            suite.set('name', name)
            reconstructed_combined.append(suite)
    require(len(all_nodes) == len(set(all_nodes)) == HISTORICAL['collected_nodes'], 'gate007 coverage not exact once')
    require(set(collected(old_collection / 'stdout.txt')) == set(all_nodes), 'gate007 collection Nodes differ')
    require(all_extra == EXPECTED_SUBTESTS and len(all_skips) == EXPECTED_SKIPS
            and sorted(item['node'] for item in all_skips) == sorted(item['node'] for item in prior['skip_details']),
            'gate007 skip/subtest report differs')
    combined = ET.fromstring(bytes_of(PRIOR_ROOT / 'release-junit.xml'))
    require(ET.tostring(combined) == ET.tostring(reconstructed_combined), 'gate007 combined XML differs from accepted groups')
    combined_cases = combined.findall('.//testcase')
    require(len(combined_cases) == len(all_nodes)
            and {(row.attrib['classname'], row.attrib['name']) for row in combined_cases} == {key(node) for node in all_nodes}
            and all(row.find('failure') is None and row.find('error') is None for row in combined_cases),
            'gate007 combined JUnit coverage differs')
    start, finish = read(PRIOR_ROOT / 'driver-start.json'), read(PRIOR_ROOT / 'driver-finished.json')
    for field in ('plan_sha256', 'collection_result_sha256', 'candidate_manifest_sha256', 'owner_record_sha256',
                  'controller_head', 'frozen_worktree_head', 'd176_source_sha256', 'd176_tests_sha256'):
        require(start[field] == HISTORICAL[field], 'gate007 driver start differs: ' + field)
    require(start['driver_sha256'] == HISTORICAL['driver_helper_sha256']
            and start['runner_sha256'] == HISTORICAL['runner_sha256']
            and start['candidate_rows'] == 263 and start['minimum_start_free_bytes'] == 8 * 1024**3
            and start['partition_free_floor_bytes'] == 10 * 1024**3
            and start['last_partition_start_utc'] == HISTORICAL['last_partition_start_utc'], 'gate007 start guards differ')
    require(aware(start['utc']) < aware(HISTORICAL['last_partition_start_utc'])
            and aware(start['utc']) <= aware(finish['utc']) <= aware(HISTORICAL['owner_end_utc']),
            'gate007 historical timing differs')
    require(finish['accepted_attempts'] == 45 and finish['collected_nodes'] == HISTORICAL['collected_nodes']
            and finish['junit_passed'] == prior['passed'] and finish['junit_skipped'] == EXPECTED_SKIPS
            and finish['junit_subtests'] == EXPECTED_SUBTESTS and finish['failures'] == finish['errors'] == 0,
            'gate007 finish differs')
    return prior, old_plan, profiles


def fresh_collection():
    collection = Path(COLLECTION_PATH)
    require(collection.parent == QA and collection.name != Path(HISTORICAL['collection']).name,
            'collection is not a fresh direct QA child')
    plain(collection, directory=True)
    require(sha(collection / 'result.json') == COLLECTION_RESULT_SHA256
            and sha(collection / 'stdout.txt') == COLLECTION_STDOUT_SHA256, 'fresh collection hashes differ')
    result = read(collection / 'result.json')
    require(type(result['exit_code']) is int and result['exit_code'] == 0
            and result['source_unchanged'] is True and result['collect_only'] is True, 'fresh collection refused')
    require(sha(collection / 'candidate-before.json') == sha(collection / 'candidate-after.json') == CANDIDATE_MANIFEST_SHA256,
            'fresh collection candidate changed')
    nodes = collected(collection / 'stdout.txt')
    require(type(COLLECTED_NODES) is int and len(nodes) == COLLECTED_NODES
            and hashlib.sha256(canonical(nodes)).hexdigest() == COLLECTED_NODE_IDS_SHA256,
            'fresh collected nodes differ')
    require(sha(RUNNER) == RUNNER_SHA256 == HISTORICAL['runner_sha256'], 'QA runner changed')
    rows = candidate()
    require(len(rows) == 263 and rows == read(collection / 'candidate-before.json'), 'fresh full263 candidate differs')
    require(type(SOURCE_PINS) is dict and set(SOURCE_PINS) == set(CHANGED_PATHS), 'fresh18 source pin paths differ')
    require(all(re.fullmatch(r'[0-9a-f]{64}', value) for value in SOURCE_PINS.values()), 'bad fresh source SHA')
    require(all(sha(REPO / path) == SOURCE_PINS[path] for path in CHANGED_PATHS), 'fresh source bytes differ')
    old_collection = Path(HISTORICAL['collection'])
    require(sha(old_collection / 'candidate-before.json') == HISTORICAL['candidate_manifest_sha256']
            and sha(old_collection / 'candidate-after.json') == HISTORICAL['candidate_manifest_sha256'],
            'historical263 manifest differs')
    old_rows = read(old_collection / 'candidate-before.json')
    require(len(old_rows) == 263 and [row[0] for row in rows] == [row[0] for row in old_rows], 'candidate pathset/order changed')
    changed = sorted(row[0] for row, old in zip(rows, old_rows, strict=True) if row[1] != old[1])
    require(changed == sorted(CHANGED_PATHS), 'candidate changes outside exact18 paths or missing changed path')
    controller_identity()
    frozen_identity()
    return collection, nodes


def node_delta(nodes, old_plan):
    old_nodes = {node for group in old_plan['partitions'] for node in group['Nodes']}
    added, removed = sorted(set(nodes) - old_nodes), sorted(old_nodes - set(nodes))
    require(type(ADDED_NODES) is list and added == ADDED_NODES and ADDED_NODE_COUNT == len(added)
            and type(ADDED_NODE_COUNT) is int and ADDED_NODE_COUNT > 0, 'added collection delta differs')
    require(removed == REMOVED_NODES == [] and REMOVED_NODE_COUNT == 0 and type(REMOVED_NODE_COUNT) is int,
            'historical nodes removed')
    require(all(node.split('::', 1)[0] in CHANGED_TEST_PATHS for node in added), 'new node outside reviewed test paths')


def expected_plan_fields():
    return {'gate_schema_version': 1, 'gate_name': 'full-gate-008', 'collection': COLLECTION_PATH,
            'collected_nodes': COLLECTED_NODES, 'collection_result_sha256': COLLECTION_RESULT_SHA256,
            'collection_stdout_sha256': COLLECTION_STDOUT_SHA256, 'collected_node_ids_sha256': COLLECTED_NODE_IDS_SHA256,
            'candidate_manifest_sha256': CANDIDATE_MANIFEST_SHA256, 'source_pins': SOURCE_PINS,
            'runner_sha256': RUNNER_SHA256, 'changed_paths': CHANGED_PATHS,
            'added_nodes': ADDED_NODES, 'added_node_count': ADDED_NODE_COUNT,
            'removed_nodes': REMOVED_NODES, 'removed_node_count': REMOVED_NODE_COUNT,
            'prior_release_verification_sha256': PRIOR_RELEASE_VERIFICATION_SHA256,
            'prior_combined_junit_sha256': PRIOR_COMBINED_JUNIT_SHA256,
            'prior_driver_start_sha256': PRIOR_DRIVER_START_SHA256, 'prior_driver_finish_sha256': PRIOR_DRIVER_FINISH_SHA256,
            'prior_verifier_helper_sha256': PRIOR_VERIFIER_HELPER_SHA256,
            'owner_record_sha256': OWNER_RECORD_SHA256, 'owner_review_sha256': OWNER_REVIEW_SHA256,
            'controller_head': CONTROLLER_HEAD, 'frozen_worktree_head': FROZEN_WORKTREE_HEAD,
            'prior_expected_skips': EXPECTED_SKIPS, 'prior_expected_subtests': EXPECTED_SUBTESTS,
            'historical_gate007_plan_sha256': HISTORICAL['plan_sha256']}


def checked_plan():
    require(sha(ROOT / 'plan.json') == PLAN_SHA256, 'fresh gate008 plan differs')
    prior, old_plan, profiles = prior_gate_complete()
    collection, nodes = fresh_collection()
    node_delta(nodes, old_plan)
    plan = read(ROOT / 'plan.json')
    for name, value in expected_plan_fields().items():
        require(plan[name] == value, 'gate008 plan metadata differs: ' + name)
    require(plan['old_routing_template_sha256'] == old_plan['old_routing_template_sha256'], 'routing lineage changed')
    groups = plan['partitions']
    require(len(groups) == 45 and [group['Name'] for group in groups] == [group['Name'] for group in old_plan['partitions']],
            'partition names/order changed')
    scheduled = []
    for group, old in zip(groups, old_plan['partitions'], strict=True):
        require(group['Tests'] == old['Tests'] and group['RepoScratch'] is old['RepoScratch'], 'partition selector/scratch changed')
        require(group['Nodes'] == selected(nodes, group['Tests']) and type(group['ExpectedNodes']) is int
                and group['ExpectedNodes'] == len(group['Nodes']), 'partition fresh nodes/count differ')
        require(group['ExpectedSkipNodes'] == profiles[group['Name']]['ExpectedSkipNodes']
                and group['ExpectedReportedSubtests'] == profiles[group['Name']]['ExpectedReportedSubtests'],
                'partition skip/subtest profile differs')
        scheduled.extend(group['Nodes'])
    require(len(scheduled) == len(set(scheduled)) == len(nodes) and set(scheduled) == set(nodes), 'scheduled coverage not exact once')
    require(groups[0]['Name'] == 'governance' and groups[1]['Name'] == 'b09-heavy'
            and groups[1]['ExpectedNodes'] == 1, 'governance/heavy ordering changed')
    return plan, collection, nodes, groups, prior


def start_fields(driver_sha):
    return {'plan_sha256': PLAN_SHA256, 'collection_result_sha256': COLLECTION_RESULT_SHA256,
            'collection_stdout_sha256': COLLECTION_STDOUT_SHA256, 'collected_node_ids_sha256': COLLECTED_NODE_IDS_SHA256,
            'runner_sha256': RUNNER_SHA256, 'driver_sha256': driver_sha,
            'candidate_manifest_sha256': CANDIDATE_MANIFEST_SHA256, 'candidate_rows': 263,
            'owner_record_sha256': OWNER_RECORD_SHA256, 'owner_review_sha256': OWNER_REVIEW_SHA256,
            'minimum_start_free_bytes': MIN_START_FREE, 'partition_free_floor_bytes': PARTITION_FREE_FLOOR,
            'last_partition_start_utc': LAST_PARTITION_START.isoformat(),
            'prior_release_verification_sha256': PRIOR_RELEASE_VERIFICATION_SHA256, 'prior_accepted_receipt_count': 45,
            'controller_head': CONTROLLER_HEAD, 'frozen_worktree_head': FROZEN_WORKTREE_HEAD,
            'd176_source_sha256': SOURCE_PINS['src/bu/experiments/week8_exp2a_recovery.py'],
            'd176_tests_sha256': SOURCE_PINS['tests/test_week8_exp2a_recovery.py'],
            'source_pins': SOURCE_PINS, 'added_nodes': ADDED_NODES, 'added_node_count': ADDED_NODE_COUNT,
            'removed_nodes': REMOVED_NODES, 'removed_node_count': REMOVED_NODE_COUNT}

runtime()
window_end = owner_current()
require(datetime.now(timezone.utc) < LAST_PARTITION_START, 'outside partition start reserve')
require(shutil.disk_usage(PROJECT).free >= MIN_START_FREE, 'below 10 GiB start floor')
prior, old_plan, profiles = prior_gate_complete()
collection, nodes = fresh_collection()
node_delta(nodes, old_plan)
groups = []
for old in old_plan['partitions']:
    group_nodes = selected(nodes, old['Tests'])
    require(bool(group_nodes), 'empty partition')
    groups.append({'Name': old['Name'], 'Tests': old['Tests'], 'RepoScratch': old['RepoScratch'],
                   'ExpectedNodes': len(group_nodes), 'Nodes': group_nodes, **profiles[old['Name']]})
scheduled = [node for group in groups for node in group['Nodes']]
require(len(groups) == 45 and len(scheduled) == len(set(scheduled)) == len(nodes)
        and set(scheduled) == set(nodes), 'fresh plan coverage is not exact once')
require(groups[0]['Name'] == 'governance' and groups[1]['Name'] == 'b09-heavy'
        and groups[1]['ExpectedNodes'] == 1, 'partition governance/heavy order changed')
plan = {**expected_plan_fields(), 'partitions': groups,
        'old_routing_template_sha256': old_plan['old_routing_template_sha256'],
        'plan_builder_helper_sha256': sha(Path(__file__)),
        'policy': 'Every fresh collected node accepted exactly once; same45 selectors, scratch, skips and subtests; '
                  '10 GiB start/partition floors; original runtime and owner guards; no replay or preaccepted heavy group.'}
require(absent(ROOT), 'gate008 root already exists; preserve the attempt')
require(not named_children(QA, prefix='g8-'), 'gate008 QA attempt already exists')
owner_current()
fresh_collection()
require(datetime.now(timezone.utc) < LAST_PARTITION_START
        and shutil.disk_usage(PROJECT).free >= MIN_START_FREE, 'start guards changed')
mkdir_once(ROOT)
write_once(ROOT / 'plan.json', plan)
require(read(ROOT / 'plan.json') == plan, 'plan publication differs')
print(json.dumps({'plan': str(ROOT / 'plan.json'), 'sha256': sha(ROOT / 'plan.json'),
                  'collected_nodes': len(nodes), 'partitions': 45, 'added_nodes': len(ADDED_NODES)}), flush=True)
