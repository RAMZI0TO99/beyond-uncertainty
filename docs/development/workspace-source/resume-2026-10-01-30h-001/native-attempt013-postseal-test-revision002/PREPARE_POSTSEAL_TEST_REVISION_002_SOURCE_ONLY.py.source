replace("            value=intent();value['utc']=stamp\n            with self.subTest(stamp=stamp):\n                with self.assertRaises(ValueError):self.function('checked_intent')(FakeFront(),F,canonical(value)+b'\\n','seal',H,H,{'receipt':H})\n",
