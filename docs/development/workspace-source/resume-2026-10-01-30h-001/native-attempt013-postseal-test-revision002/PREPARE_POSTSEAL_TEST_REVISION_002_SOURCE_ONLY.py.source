replace("'prelaunch_file_sha256':{'receipt':H},'audit_sha256':H,'utc':","'prelaunch_file_sha256':{'receipt':H},'audit_sha256':hashlib.sha256(AUDIT_BYTES).hexdigest(),'utc':",'derive audit pin from exact mocked bytes')
replace("        return types.FunctionType(old.__code__,self.q,name,old.__defaults__,old.__closure__)\n",
