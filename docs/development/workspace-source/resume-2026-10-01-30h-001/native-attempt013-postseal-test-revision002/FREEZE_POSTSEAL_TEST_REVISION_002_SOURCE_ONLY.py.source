def require(value,message):
    if not value:raise ValueError(message)
def sha(data):return hashlib.sha256(data).hexdigest()
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')+b'\n'
def identity(info):
    values=(info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns,info.st_mode,info.st_nlink,int(getattr(info,'st_file_attributes',0)))
    if os.name=='nt':
        birth=getattr(info,'st_birthtime_ns',None);require(type(birth) is int and birth>0,'Windows birthtime absent');return values+(birth,)
    return values
def cross(info,*,pathname):
    values=identity(info)
    if os.name=='nt':
        require(not pathname or info.st_ctime_ns==info.st_birthtime_ns,'creation projection differs')
        return values[:4]+(info.st_birthtime_ns,)+values[5:8]
    return values
def read(path,expected=None):
    for parent in reversed(path.parents):
        s=parent.lstat();require(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not int(getattr(s,'st_file_attributes',0))&0x400,'nonplain ancestor')
    before=path.lstat();require(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and not stat.S_ISLNK(before.st_mode) and not int(getattr(before,'st_file_attributes',0))&0x400,'nonplain source')
    with path.open('rb',buffering=0) as stream:
        opened=os.fstat(stream.fileno());data=stream.read();closed=os.fstat(stream.fileno())
    after=path.lstat();require(identity(before)==identity(after) and identity(opened)==identity(closed) and cross(before,pathname=True)==cross(opened,pathname=False) and len(data)==before.st_size,'source capture changed')
    if expected is not None:require(sha(data)==expected,'source pin differs: '+str(path))
    return data
def write(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream:stream.write(data)
    require(read(path)==data,'write readback differs')
def absent(path):
    try:path.lstat()
    except FileNotFoundError:return
    raise ValueError('future path already exists: '+str(path))
