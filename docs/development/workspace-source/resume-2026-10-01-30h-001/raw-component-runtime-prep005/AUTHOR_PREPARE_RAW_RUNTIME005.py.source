sha = lambda blob: hashlib.sha256(blob).hexdigest()

def utc():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')

def encoded(value):
    return (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def compact(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns,
            s.st_mode, s.st_nlink, getattr(s, 'st_file_attributes', 0),
            getattr(s, 'st_birthtime_ns', None)]

def cross5(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_nlink]

def directory(path):
    for item in [*reversed(path.absolute().parents), path.absolute()]:
        s = item.lstat()
        assert stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode)
        assert not getattr(s, 'st_file_attributes', 0) & 0x400

def read(path):
    directory(path.parent)
    a = path.lstat()
    assert stat.S_ISREG(a.st_mode) and a.st_nlink == 1
    assert not getattr(a, 'st_file_attributes', 0) & 0x400 and a.st_size <= MAX_FILE
    with path.open('rb') as handle:
        b = os.fstat(handle.fileno())
        assert cross5(a) == cross5(b)
        blob = handle.read(MAX_FILE + 1)
        c = os.fstat(handle.fileno())
    d = path.lstat()
    assert raw9(a) == raw9(d) and raw9(b) == raw9(c)
    assert cross5(d) == cross5(c) and len(blob) == a.st_size
    return blob, {'path': str(path), 'sha256': sha(blob), 'bytes': len(blob),
                  'mode': stat.S_IMODE(a.st_mode), 'path_raw9': raw9(a),
                  'descriptor_raw9': raw9(b)}

def strict(blob):
    def pairs(items):
        answer = {}
        for key, value in items:
            assert key not in answer
            answer[key] = value
        return answer
    def finite(token):
        value = float(token)
        assert math.isfinite(value)
        return value
    return json.loads(blob.decode('utf-8'), object_pairs_hook=pairs, parse_float=finite,
                      parse_constant=lambda token: (_ for _ in ()).throw(ValueError(token)))

def mkdir(path):
    if path.exists():
        directory(path)
    else:
        mkdir(path.parent)
        path.mkdir()
        directory(path)

def write(path, blob):
    mkdir(path.parent)
    assert not path.exists(), str(path)
    with path.open('xb') as handle:
        handle.write(blob)
        handle.flush()
        os.fsync(handle.fileno())
    assert read(path)[0] == blob
    return read(path)[1]

def inventory(root):
    queue = [root]
    directories = []
    rows = []
    total = 0
    while queue:
        parent = queue.pop()
        directory(parent)
        directories.append({'path': str(parent), 'relative_path': parent.relative_to(root).as_posix(),
                            'path_raw9': raw9(parent.lstat()), 'mode': stat.S_IMODE(parent.lstat().st_mode)})
        for child in sorted(parent.iterdir(), key=lambda p: p.name):
            info = child.lstat()
            assert not getattr(info, 'st_file_attributes', 0) & 0x400
            if stat.S_ISDIR(info.st_mode):
                queue.append(child)
            else:
                blob, row = read(child)
                row['relative_path'] = child.relative_to(root).as_posix()
                rows.append(row)
                total += len(blob)
                assert total <= MAX_HISTORY_BYTES
        assert len(rows) <= MAX_HISTORY_FILES and len(directories) <= MAX_HISTORY_DIRECTORIES
    return {'files': sorted(rows, key=lambda r: r['relative_path']),
            'directories': sorted(directories, key=lambda r: r['relative_path']), 'bytes': total}

def changed_function(source, name, replacement):
    text = source.decode('utf-8')
    nodes = [node for node in ast.parse(text).body if isinstance(node, ast.FunctionDef) and node.name == name]
    assert len(nodes) == 1
    node = nodes[0]
    lines = text.splitlines(keepends=True)
    start = sum(len(line) for line in lines[:node.lineno - 1])
    end = sum(len(line) for line in lines[:node.end_lineno])
    return (text[:start] + replacement.rstrip() + '\n' + text[end:]).encode('utf-8')

def assignments(source, values):
    text = source.decode('utf-8')
    lines = text.splitlines(keepends=True)
    edits = []
    for node in ast.parse(text).body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in values:
                start = sum(len(line) for line in lines[:node.value.lineno - 1]) + node.value.col_offset
                end = sum(len(line) for line in lines[:node.value.end_lineno - 1]) + node.value.end_col_offset
                edits.append((start, end, repr(values[name])))
    assert len(edits) == len(values)
    for start, end, replacement in sorted(edits, reverse=True):
        text = text[:start] + replacement + text[end:]
    return text.encode('utf-8')

