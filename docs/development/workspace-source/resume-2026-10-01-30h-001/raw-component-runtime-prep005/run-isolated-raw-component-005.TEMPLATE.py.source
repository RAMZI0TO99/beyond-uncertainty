def independent_reviewer(review, *, harness):
    identifier = review.get("reviewer")
    if type(identifier) is dict:
        identifier = identifier.get("canonical_identity")
    require(type(identifier) is str and identifier in REVIEWER_ALIASES, "unknown reviewer identity")
    canonical = REVIEWER_ALIASES[identifier]
    excluded = {"/root", "/root/raw_policy_worker"}
    if harness:
        excluded.add("/root/raw_policy_worker")
    require(canonical not in excluded, "source/harness author or root cannot supply independent review")
    return canonical

def configuration_guard():
    read(PROJECT / "pro2/.venv/Lib/site-packages/_pytest/config/findpaths.py", PYTEST_CONFIG_SOURCE_SHA256)
    directories = [COPY / "tests", *(COPY / "tests").parents]
    require(len(directories) == 7, "exact configuration ancestors differ")
    paths = [directory / name for directory in directories for name in CONFIG_NAMES]
    require(len(paths) == 56 and all(absent(path) for path in paths), "recognized pytest/config/conftest present")
    return [str(path) for path in paths]

def whole_before_guard(ack):
    path, digest = binding(ack["whole_runtime_before"])
    require(path == PREP / "whole-runtime-before/result.json", "whole before fixed path differs")
    value = parsed(path, digest)
    exact(value, ("schema_version", "phase", "verdict", "started_utc", "finished_utc", "observer_sha256", "static_review_sha256", "owner_sha256", "trees", "observation_files", "before_record_sha256", "runtime_mutation", "target_execution"), "external whole before")
    require(type(value["schema_version"]) is int and value["schema_version"] == 1 and value["phase"] == "before"
            and value["verdict"] == "MATCHES_PINNED_RUNTIME_TWICE" and value["owner_sha256"] == OWNER_SHA256
            and value["static_review_sha256"] == HARNESS_STATIC_REVIEW_SHA256
            and hex64(value["observer_sha256"]) and value["before_record_sha256"] is None
            and value["runtime_mutation"] is False and value["target_execution"] is False,
            "external whole before facts differ")
    require(timestamp(value["started_utc"]) <= timestamp(value["finished_utc"]) <= datetime.now(timezone.utc), "whole before times")
    exact(value["trees"], ("base", "scripts"), "whole trees")
    require(value["trees"] == WHOLE_EXPECTED, "whole runtime identity differs")
    for tree in value["trees"].values():
        exact(tree, ("files", "directories", "bytes", "sha256"), "whole identity row")
        require(all(type(tree[key]) is int for key in ("files", "directories", "bytes"))
                and type(tree["sha256"]) is str, "whole identity scalar types differ")
    require(type(value["observation_files"]) is list and len(value["observation_files"]) == 4, "four whole observations")
    paths = set()
    for row in value["observation_files"]:
        exact(row, ("path", "sha256", "size"), "whole observation binding")
        captured = within_work(row["path"])
        require(captured.parent == PREP / "whole-runtime-before" and captured.name in
                ("base-first.json", "base-second.json", "scripts-first.json", "scripts-second.json")
                and str(captured) not in paths and type(row["size"]) is int and 0 < row["size"] <= 4194304, "whole row path or cap")
        paths.add(str(captured)); read(captured, row["sha256"], row["size"])
    # This authenticates external time-local observations. It is NOT a fresh global-tree reread by this driver.
    return {"path":str(path),"sha256":digest,"finished_utc":value["finished_utc"],"observer_sha256":value["observer_sha256"]}

def opaque_metadata_row(path, expected, maximum):
    exact(expected, ("path", "sha256", "bytes", "path_raw9", "descriptor_raw9"), "opaque metadata row")
    require(expected["path"] == str(path) and type(expected["bytes"]) is int
            and 0 <= expected["bytes"] <= maximum and hex64(expected["sha256"]), "opaque row path/size")
    require(all(type(expected[name]) is list and len(expected[name]) == 9
                and all(type(value) is int for value in expected[name])
                for name in ("path_raw9", "descriptor_raw9")), "opaque raw9 metadata type")
    chain = ancestors(path.parent)
    before = path.lstat()
    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
            and not getattr(before, "st_file_attributes", 0) & 0x400
            and before.st_size <= maximum, "opaque pre-read identity/cap")
    with path.open("rb") as stream:
        first = os.fstat(stream.fileno())
        require(cross(before) == cross(first) and first.st_size <= maximum, "opaque opened identity/cap")
        data = stream.read(maximum + 1)
        last = os.fstat(stream.fileno())
    after = path.lstat()
    require(len(data) == expected["bytes"] == before.st_size and len(data) <= maximum
            and raw(before) == raw(after) and raw(first) == raw(last)
            and cross(before) == cross(first) == cross(last) == cross(after)
            and ancestors(path.parent) == chain and sha(data) == expected["sha256"]
            and list(raw(before)) == expected["path_raw9"]
            and list(raw(first)) == expected["descriptor_raw9"], "opaque byte/metadata drift")
    return {"path": str(path), "sha256": sha(data), "bytes": len(data),
            "path_raw9": list(raw(before)), "descriptor_raw9": list(raw(first))}

def opaque_context_guard(ack):
    profile = parsed(PREP / "OPAQUE_CONTEXT_PROFILE_005.json", CONTEXT_PROFILE_SHA256)
    path, pin = binding(ack["opaque_current_context"])
    value = decode(read(path, pin, profile["context_profile"]["maximum_opaque_context_bytes"]))
    exact(value, ("schema_version", "scope", "captured_utc", "head", "tracked_rows",
                  "git_metadata", "configurations", "runtime_roles_projection_sha256"), "opaque context")
    require(type(value["schema_version"]) is int and value["schema_version"] == 1
            and value["scope"] == profile["scope"]
            and value["runtime_roles_projection_sha256"] == profile["runtime_roles_projection_sha256"], "opaque context role")
    require(0 <= (datetime.now(timezone.utc)-timestamp(value["captured_utc"])).total_seconds() <= 600,
            "fresh opaque context required")
    cfg = profile["context_profile"]
    live = Path(cfg["live_root"])
    require(live == LIVE, "fixed opaque live root")
    require(type(value["head"]) is str and len(value["head"]) == 40
            and all(c in "0123456789abcdef" for c in value["head"]), "opaque HEAD syntax")
    require(type(value["tracked_rows"]) is list and len(value["tracked_rows"]) == cfg["tracked_count"] == 742,
            "opaque tracked row count")
    paths = [row.get("path") for row in value["tracked_rows"] if type(row) is dict]
    require(len(paths) == 742 and all(type(path) is str for path in paths)
            and paths == sorted(paths) and len(set(path.casefold() for path in paths)) == 742
            and sha(encoded(paths)) == cfg["historical_authenticated_pathset_sha256"], "fixed opaque742 path sequence")
    result = {"head": value["head"], "tracked_rows": [], "git_metadata": [], "configurations": []}
    for row in value["tracked_rows"]:
        relative = Path(row["path"])
        require(not relative.is_absolute() and ".." not in relative.parts and relative.as_posix() == row["path"]
                and len(row["path"]) <= 399, "opaque relative path")
        actual = dict(row)
        actual["path"] = str(live / relative)
        observed = opaque_metadata_row(live / relative, actual, cfg["maximum_file_bytes"])
        observed["path"] = row["path"]
        result["tracked_rows"].append(observed)
    git_paths = cfg["head_paths"] + cfg["optional_git_metadata_paths"]
    config_paths = [str(Path(parent) / name) for parent in cfg["configuration_parents"]
                    for name in cfg["configuration_names"]]
    require(len(config_paths) == 55, "exact55 separate context configuration paths")
    for field, allowed in (("git_metadata", git_paths), ("configurations", config_paths)):
        require(type(value[field]) is list and [row.get("path") for row in value[field] if type(row) is dict] == allowed,
                "opaque fixed path coverage")
        for row in value[field]:
            exact(row, ("path", "exists", "identity"), "opaque optional row")
            require(type(row["exists"]) is bool, "opaque existence type")
            item = Path(row["path"])
            if row["exists"]:
                observed = opaque_metadata_row(item, row["identity"], cfg["maximum_git_metadata_bytes"])
                result[field].append({"path": str(item), "exists": True, "identity": observed})
            else:
                require(row["identity"] is None and absent(item), "opaque absence drift")
                require(field != "git_metadata" or row["path"] not in cfg["head_paths"], "required HEAD metadata absent")
                result[field].append({"path": str(item), "exists": False, "identity": None})
    head_path = Path(cfg["head_paths"][-1])
    expected_head = next(row["identity"]["sha256"] for row in value["git_metadata"] if row["path"] == str(head_path))
    require(read(head_path, expected_head, 128).decode("ascii").strip() == value["head"], "opaque actual branch HEAD differs")
    return result

def fresh_guard(ack, expected_live=None):
    now = datetime.now(timezone.utc)
    require(timestamp(ack["created_utc"]) <= now < timestamp(ack["expires_utc"]) <= OWNER_END,
            "acknowledgement or owner expired")
    require(timestamp(ack["expires_utc"]) - timestamp(ack["created_utc"]) <= timedelta(hours=MAX_ACK_HOURS),
            "acknowledgement interval exceeds five hours")
    configuration_paths = configuration_guard()
    whole_before = whole_before_guard(ack)
    inputs = primary_inputs()
    owner = parsed(PREP / "inputs/OWNER_WORK_WINDOW_30H_20261001_001.json", OWNER_SHA256)
    require(timestamp(owner["work_start_utc"]) <= now < timestamp(owner["work_end_utc"]) == OWNER_END,
            "owner interval differs")
    runtime_path, runtime_sha = binding(ack["runtime_snapshot"])
    runtime = parsed(runtime_path, runtime_sha)
    exact(runtime, ("schema_version", "purpose", "captured_utc", "entries", "pytest"), "runtime snapshot")
    require(runtime["schema_version"] == 1 and runtime["purpose"] == "RAW005_ISOLATED_RUNTIME_GUARD_ONLY",
            "runtime snapshot purpose differs")
    require(timestamp(runtime["captured_utc"]) <= now and now - timestamp(runtime["captured_utc"]) < timedelta(hours=MAX_ACK_HOURS),
            "runtime snapshot stale")
    require(type(runtime["entries"]) is list and len(runtime["entries"]) == 4, "four fixed runtime files required")
    actual_runtime = {}
    for row in runtime["entries"]:
        exact(row, ("path", "sha256", "size"), "runtime row")
        require(row["path"] in RUNTIME_FIXED and row["path"] not in actual_runtime
                and row["sha256"] == RUNTIME_FIXED[row["path"]]
                and type(row["size"]) is int and row["size"] > 0, "runtime fixed pin differs")
        value = read(Path(row["path"]), row["sha256"], row["size"])
        actual_runtime[row["path"]] = {"sha256": sha(value), "size": len(value),
                                        "path_identity": list(raw(Path(row["path"]).lstat()))}
    require(set(actual_runtime) == set(RUNTIME_FIXED), "runtime executable closure differs")
    exact(runtime["pytest"], ("path", "sha256", "size", "version"), "pytest binding")
    pytest_row = runtime["pytest"]
    pytest_path = Path(pytest_row["path"])
    require(pytest_path == PROJECT / "pro2/.venv/Lib/site-packages/pytest/__init__.py"
            and pytest_row["version"] == "9.1.1" and hex64(pytest_row["sha256"])
            and type(pytest_row["size"]) is int and pytest_row["size"] > 0, "pytest entry binding differs")
    read(pytest_path, pytest_row["sha256"], pytest_row["size"])
    live = opaque_context_guard(ack)
    if expected_live is not None:
        require(live == expected_live, "current742/HEAD/index/configuration bytes or metadata changed")
    free_disk = ctypes.c_ulonglong()
    require(ctypes.windll.kernel32.GetDiskFreeSpaceExW(str(PROJECT), ctypes.byref(free_disk), None, None), "disk query failed")
    require(free_disk.value >= MIN_DISK_BYTES, "ten GiB start disk floor")
    class Memory(ctypes.Structure):
        _fields_ = [("length", ctypes.c_ulong), ("load", ctypes.c_ulong),
                    ("total_phys", ctypes.c_ulonglong), ("avail_phys", ctypes.c_ulonglong),
                    ("total_page", ctypes.c_ulonglong), ("avail_page", ctypes.c_ulonglong),
                    ("total_virtual", ctypes.c_ulonglong), ("avail_virtual", ctypes.c_ulonglong),
                    ("avail_extended", ctypes.c_ulonglong)]
    memory = Memory(); memory.length = ctypes.sizeof(memory)
    require(ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(memory)), "RAM query failed")
    require(type(ack["min_free_ram_bytes"]) is int and ack["min_free_ram_bytes"] >= 1073741824
            and memory.avail_phys >= ack["min_free_ram_bytes"], "root acknowledged RAM floor")
    return {"configuration56": configuration_paths, "whole_runtime_before": whole_before,
            "primary_inputs": inputs, "live": live, "runtime": actual_runtime,
            "pytest": pytest_row, "free_disk_bytes": free_disk.value, "free_ram_bytes": memory.avail_phys}

def environment(temp):
    value = {key: val for key, val in os.environ.items()
             if not key.upper().startswith(("PYTHON", "GIT_"))}
    value.update({"PYTHONPATH": str(COPY), "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
                  "PYTHONDONTWRITEBYTECODE": "1", "PYTHONNOUSERSITE": "1", "PYTHONSAFEPATH": "1",
                  "TEMP": str(temp), "TMP": str(temp), "TMPDIR": str(temp),
                  "OMP_NUM_THREADS": "1", "OPENBLAS_NUM_THREADS": "1", "MKL_NUM_THREADS": "1",
                  "NUMEXPR_NUM_THREADS": "1"})
    return value

def node_digest(nodeids):
    return sha((json.dumps(nodeids, separators=(",", ":"), ensure_ascii=True, allow_nan=False) + "\n").encode("ascii"))

def evidence_guard(rows, expected=None):
    answer = []
    for path, digest, maximum in rows:
        value = read(path, digest, maximum)
        answer.append({"path": str(path), "sha256": sha(value), "size": len(value),
                       "path_identity": list(raw(path.lstat()))})
    if expected is not None:
        require(answer == expected, "authority evidence bytes or metadata changed")
    return answer

def main():
    require(sys.flags.isolated == sys.flags.no_site == sys.flags.dont_write_bytecode == 1
            and sys.flags.utf8_mode == 1 and Path(sys.executable).resolve(strict=True) == BASE_PYTHON.resolve(strict=True),
            "root driver must use the pinned direct base interpreter and isolated flags")
    require(len(sys.argv) == 4 and all(hex64(x) for x in sys.argv[1:]), "external self/ACK/bound-review SHA arguments required")
    self_sha, ack_sha, bound_review_sha = sys.argv[1:]
    self_path = Path(__file__).absolute()
    require(self_path == PREP / "run-isolated-raw-component-005.BOUND.py", "bound driver path differs")
    source = read(self_path, self_sha)
    static = parsed(PREP / "INDEPENDENT_RAW_HARNESS_STATIC_REVIEW_005.json", HARNESS_STATIC_REVIEW_SHA256)
    require(static["verdict"] == "PASS_STATIC_PREPARATION_ONLY" and static["driver_template_sha256"] == projection_digest(source),
            "independent static template review differs")
    independent_reviewer(static, harness=True)
    bound = parsed(PREP / "INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_005.json", bound_review_sha)
    require(bound["verdict"] == "PASS_BOUND_FOR_ROOT_FIRST_EXECUTION_ONLY"
            and bound["bound_driver_sha256"] == self_sha and bound["static_review_sha256"] == HARNESS_STATIC_REVIEW_SHA256,
            "independent bound review differs")
    independent_reviewer(bound, harness=True)
    launch_path = PREP / "ROOT_LAUNCH_START_005.json"
    launch_bytes = read(launch_path)
    launch = decode(launch_bytes)
    exact(launch, ("schema_version", "started_utc", "bound_driver_sha256", "ack_sha256", "bound_review_sha256"),
          "external root first-launch receipt")
    require(type(launch["schema_version"]) is int and launch["schema_version"] == 1
            and launch["bound_driver_sha256"] == self_sha and launch["ack_sha256"] == ack_sha
            and launch["bound_review_sha256"] == bound_review_sha
            and timestamp(launch["started_utc"]) <= datetime.now(timezone.utc)
            and datetime.now(timezone.utc) - timestamp(launch["started_utc"]) < timedelta(minutes=5),
            "actual root launch receipt differs or is stale")
    raw_peer = parsed(PREP / "inputs/INDEPENDENT_RAW_REVISION004_SOURCE_REVIEW_001.json", RAW_SOURCE_PEER_REVIEW_SHA256)
    independent_reviewer(raw_peer, harness=False)
    require(type(raw_peer["schema_version"]) is int and raw_peer["schema_version"] == 1
            and raw_peer["record_type"] == "independent_raw_revision004_source_test_static_review"
            and raw_peer["reviewer"] == raw_peer["reviewer_agent"] == "/root/candidate_review"
            and raw_peer["source_author"] == "/root/raw_policy_worker"
            and raw_peer["decision"] == raw_peer["verdict"] == "PASS_STATIC_SOURCE_AND_TEST_PREPARATION_ONLY"
            and raw_peer["source_sha256"] == raw_peer["raw_helper_sha256"] == RAW_SOURCE_SHA256
            and raw_peer["test_sha256"] == raw_peer["raw_tests_sha256"] == RAW_TEST_SHA256
            and type(raw_peer["source_bytes"]) is int and raw_peer["source_bytes"] == 210452
            and type(raw_peer["test_bytes"]) is int and raw_peer["test_bytes"] == RAW_TEST_SIZE
            and raw_peer["manifest_sha256"] == RAW_STAGE_MANIFEST_SHA256
            and raw_peer["authorization"]["source_execution_authorized_by_this_review"] is False
            and raw_peer["tests"]["actual_collection"] is None
            and raw_peer["tests"]["actual_runtime_acceptance"] is None,
            "exact Raw004 source-and-test STATIC peer receipt required")
    raw_stage = parsed(PREP / "inputs/RAW_POLICY_STAGED_MANIFEST_004.json", RAW_STAGE_MANIFEST_SHA256)
    require(raw_stage["source_sha256"] == RAW_SOURCE_SHA256 and raw_stage["test_sha256"] == RAW_TEST_SHA256
            and type(raw_stage["api_keyword_count"]) is int and raw_stage["api_keyword_count"] == 12
            and type(raw_stage["global_cap"]) is int and raw_stage["global_cap"] == 395799
            and type(raw_stage["schema3_cap"]) is int and raw_stage["schema3_cap"] == 361287,
            "fixed Raw004 source manifest/API/caps differ")
    ack = parsed(PREP / "ROOT_FIRST_EXECUTION_ACK_RAW005.json", ack_sha)
    exact(ack, ("schema_version", "decision", "created_utc", "expires_utc", "owner_sha256",
                "bound_driver_sha256", "bound_review_sha256", "static_review_sha256", "raw_source_peer_review_sha256", "context_profile_sha256",
                "source_projection_sha256", "raw_source_sha256", "raw_test_sha256", "child_sha256",
                "runtime_snapshot", "opaque_current_context", "whole_runtime_before", "coordination_acknowledgement",
                "min_free_ram_bytes", "maximum_collection_seconds", "maximum_test_seconds", "scope"), "root ACK")
    require(type(ack["schema_version"]) is int and ack["schema_version"] == 1
            and ack["decision"] == "execute_isolated_raw005_collection_then_tests_once"
            and ack["owner_sha256"] == OWNER_SHA256 and ack["bound_driver_sha256"] == self_sha
            and ack["bound_review_sha256"] == bound_review_sha and ack["static_review_sha256"] == HARNESS_STATIC_REVIEW_SHA256
            and ack["raw_source_peer_review_sha256"] == RAW_SOURCE_PEER_REVIEW_SHA256
            and ack["context_profile_sha256"] == CONTEXT_PROFILE_SHA256 and ack["source_projection_sha256"] == SOURCE_PROJECTION_SHA256
            and ack["raw_source_sha256"] == RAW_SOURCE_SHA256 and ack["raw_test_sha256"] == RAW_TEST_SHA256
            and ack["child_sha256"] == static["child_template_sha256"]
            and ack["maximum_collection_seconds"] == MAX_COLLECTION_SECONDS and ack["maximum_test_seconds"] == MAX_TEST_SECONDS
            and ack["scope"] == "ISOLATED_RAW_UNIT_TESTS_ONLY_NO_OPERATIONAL_AUTHORITY", "root ACK facts differ")
    coordination_path, coordination_sha = binding(ack["coordination_acknowledgement"])
    coordination = read(coordination_path, coordination_sha)
    require(bool(coordination), "actual external coordination acknowledgement absent")
    # Root and the independent bound reviewer must assess the immutable acknowledgement text.
    # Merely finding a file or waiting in silence does not supply execution consensus.
    child = read(PREP / "raw-test-child-005.TEMPLATE.py", ack["child_sha256"])
    ast.parse(child)
    authority_rows = [(self_path, self_sha, len(source)),
                      (PREP / "INDEPENDENT_RAW_HARNESS_STATIC_REVIEW_005.json", HARNESS_STATIC_REVIEW_SHA256, MAX_JSON_BYTES),
                      (PREP / "INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_005.json", bound_review_sha, MAX_JSON_BYTES),
                      (PREP / "inputs/INDEPENDENT_RAW_REVISION004_SOURCE_REVIEW_001.json", RAW_SOURCE_PEER_REVIEW_SHA256, MAX_JSON_BYTES),
                      (PREP / "inputs/RAW_POLICY_STAGED_MANIFEST_004.json", RAW_STAGE_MANIFEST_SHA256, MAX_JSON_BYTES),
                      (PREP / "OPAQUE_CONTEXT_PROFILE_005.json", CONTEXT_PROFILE_SHA256, MAX_JSON_BYTES),
                      (PREP / "ROOT_FIRST_EXECUTION_ACK_RAW005.json", ack_sha, MAX_JSON_BYTES),
                      (launch_path, sha(launch_bytes), MAX_JSON_BYTES),
                      (coordination_path, coordination_sha, MAX_JSON_BYTES),
                      (PREP / "raw-test-child-005.TEMPLATE.py", ack["child_sha256"], len(child))]
    authority_baseline = evidence_guard(authority_rows)
    first = fresh_guard(ack)
    require(datetime.now(timezone.utc) - timestamp(first["whole_runtime_before"]["finished_utc"]) < timedelta(minutes=10),
            "whole before observation is not fresh at sole claim")
    require(datetime.now(timezone.utc) + timedelta(seconds=MAX_ROOT_SECONDS + 120)
            < timestamp(ack["expires_utc"]), "insufficient acknowledged wall time reserve")
    require(absent(RUNS), "short scratch already exists")
    for name in ("ROOT_RUN_INTENT_005.json", "started.json", "finished.json", "failed.json"):
        require(absent(PREP / name), "one-use root receipt exists")
    intent = {"schema_version": 1, "created_utc": datetime.now(timezone.utc).isoformat(),
              "self_sha256": self_sha, "root_ack_sha256": ack_sha, "bound_review_sha256": bound_review_sha,
              "source_projection_sha256": SOURCE_PROJECTION_SHA256, "scope": ack["scope"],
              "canonical_qa": False, "native_science_production_authority": False}
    once(PREP / "ROOT_RUN_INTENT_005.json", encoded(intent))
    once(PREP / "started.json", encoded({**intent, "before": first, "authority_evidence": authority_baseline}))
    mkdir(RUNS)
    baseline = first
    try:
        collection_ids = None
        accepted = []
        for phase, timeout in (("collection", MAX_COLLECTION_SECONDS), ("tests", MAX_TEST_SECONDS)):
            evidence_guard(authority_rows, authority_baseline)
            before = fresh_guard(ack, baseline["live"])
            require(before["primary_inputs"] == baseline["primary_inputs"] and before["runtime"] == baseline["runtime"],
                    "source or runtime metadata changed before phase")
            out = PREP / phase
            temp = RUNS / phase
            require(absent(out) and absent(temp), "phase output or scratch exists")
            mkdir(out); mkdir(temp)
            once(out / "pytest-binding.json", encoded(before["pytest"]))
            command = [str(BASE_PYTHON), "-I", "-S", "-B", "-X", "utf8", "-c", child.decode("utf-8"),
                       str(COPY), str(RUNS), phase, str(out)]
            once(out / "intent.json", encoded({"phase": phase, "started_utc": datetime.now(timezone.utc).isoformat(),
                                              "timeout_seconds": timeout, "command": command,
                                              "env_profile": "filtered_python_git_one_thread_plugin_cache_off"}))
            start = time.monotonic()
            stdout, stderr = (out / "stdout.txt").open("xb"), (out / "stderr.txt").open("xb")
            timed_out = False
            try:
                process = subprocess.Popen(command, cwd=COPY, env=environment(temp), stdin=subprocess.DEVNULL,
                                           stdout=stdout, stderr=stderr, shell=False)
                try:
                    rc = process.wait(timeout=timeout)
                except subprocess.TimeoutExpired:
                    timed_out = True
                    process.kill()
                    rc = process.wait(timeout=60)
            finally:
                stdout.close(); stderr.close()
            after = fresh_guard(ack, baseline["live"])
            evidence_guard(authority_rows, authority_baseline)
            unchanged = after["primary_inputs"] == baseline["primary_inputs"] and after["runtime"] == baseline["runtime"]
            result = {"schema_version": 1, "phase": phase, "exit_code": rc, "timed_out": timed_out,
                      "elapsed_seconds": time.monotonic() - start, "finished_utc": datetime.now(timezone.utc).isoformat(),
                      "source_and_runtime_unchanged": unchanged, "live_opaque_guard_unchanged": True,
                      "stdout_sha256": sha(read(out / "stdout.txt")), "stderr_sha256": sha(read(out / "stderr.txt")),
                      "direct_child_reaped": True, "descendant_cleanup_guaranteed": False,
                      "full_runtime_site_closure_verified": False, "os_write_sandbox_enforced": False,
                      "canonical_qa": False, "native_science_production_authority": False}
            once(out / "result.json", encoded(result))
            require(not timed_out and rc == 0 and unchanged, "phase refused/failed/timeout; driver spent")
            observation = parsed(out / "child-observation.json")
            require(observation["pytest_exit_code"] == 0 and observation["no_remaining_bu_modules"], "child import boundary differs")
            nodeids = parsed(out / "collected-nodeids.json")
            require(type(nodeids) is list and nodeids and all(type(x) is str and x.startswith("tests/test_week8_recovery_raw_authority.py::") for x in nodeids)
                    and len(nodeids) == len(set(nodeids)), "fresh collection IDs differ")
            test_ast = ast.parse(read(COPY / "tests/test_week8_recovery_raw_authority.py", RAW_TEST_SHA256, RAW_TEST_SIZE))
            expected_functions = {node.name for node in test_ast.body
                                  if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")}
            require({x.split("::", 1)[1].split("[", 1)[0] for x in nodeids} == expected_functions,
                    "fresh collection does not cover all copied test functions")
            if phase == "collection":
                collection_ids = nodeids
                summary = {"schema_version": 1, "actual_collected_nodes": len(nodeids),
                           "ordered_nodeids_sha256": node_digest(nodeids), "canonical_qa": False}
                once(out / "collection-summary.json", encoded(summary))
            else:
                require(nodeids == collection_ids, "test collection differs from first collection")
                # Full executed call-node coverage is independently recorded by pytest hooks.
                calls = [row["nodeid"] for row in observation["reports"] if row["when"] == "call"]
                skipped_setup = [row["nodeid"] for row in observation["reports"] if row["when"] == "setup" and row["outcome"] == "skipped"]
                require(len(calls + skipped_setup) == len(set(calls + skipped_setup))
                        and set(calls + skipped_setup) == set(collection_ids), "actual report node coverage differs")
                xml = read(out / "junit.xml")
                tree = ET.fromstring(xml)
                cases = tree.findall(".//testcase")
                require(len(cases) == len(collection_ids), "JUnit actual testcase count differs")
                failures = sum(len(case.findall("failure")) for case in cases)
                errors = sum(len(case.findall("error")) for case in cases)
                skipped = sum(bool(case.findall("skipped")) for case in cases)
                require(failures == errors == 0, "JUnit failures or errors")
                expected_names = [x.split("::", 1)[1] for x in collection_ids]
                require(sorted(case.attrib["name"] for case in cases) == sorted(expected_names), "JUnit identities differ")
                for case in cases:
                    if case.find("skipped") is not None:
                        require(case.attrib["name"].split("[", 1)[0] in
                                ("test_tracked_symlink_or_reparse_refuses", "test_plain_tree_refuses_symlink_or_reparse_entries")
                                and ("1314" in ET.tostring(case, encoding="unicode") or "privilege" in ET.tostring(case, encoding="unicode").lower()),
                                "unexpected skipped testcase")
                once(out / "acceptance-summary.json", encoded({"schema_version": 1, "testcases": len(cases),
                     "passed": len(cases) - skipped, "skipped": skipped, "failures": failures, "errors": errors,
                     "junit_sha256": sha(xml), "ordered_nodeids_sha256": node_digest(nodeids), "canonical_qa": False,
                     "operational_admission_or_fullgate_coverage": False}))
            accepted.append({"phase": phase, "result_sha256": sha(read(out / "result.json"))})
        final = fresh_guard(ack, baseline["live"])
        evidence_guard(authority_rows, authority_baseline)
        require(final["primary_inputs"] == baseline["primary_inputs"] and final["runtime"] == baseline["runtime"], "final source or runtime drift")
        once(PREP / "finished.json", encoded({"schema_version": 1, "finished_utc": datetime.now(timezone.utc).isoformat(),
             "accepted_phases": accepted, "actual_collected_nodes": len(collection_ids),
             "ordered_nodeids_sha256": node_digest(collection_ids), "after": final,
             "driver_spent": True, "canonical_qa": False, "native_science_production_authority": False,
             "no_automatic_cleanup": True, "descendant_cleanup_guaranteed": False}))
    except BaseException as error:
        once(PREP / "failed.json", encoded({"schema_version": 1, "finished_utc": datetime.now(timezone.utc).isoformat(),
             "error_type": type(error).__name__, "error": str(error), "driver_spent": True,
             "canonical_qa": False, "native_science_production_authority": False,
             "no_automatic_cleanup": True, "descendant_cleanup_guaranteed": False}))
        raise

if __name__ == "__main__":
    main()
