"""Distinct completion after017 preparation refused before live publication."""
import ast
import datetime
import hashlib
import json
import os
from pathlib import Path
import re

ROOT = Path('D:/Aenv/pro2')
BASE = ROOT / 'resume-2026-10-01-30h-001'
BEFORE = BASE / 'root-docs-before-major017'
INPUTS = BASE / 'root-docs-inputs-major017'
sha = lambda b: hashlib.sha256(b).hexdigest()
enc = lambda v: (json.dumps(v, sort_keys=True, indent=2, ensure_ascii=True,
                            allow_nan=False) + '\n').encode('ascii')

def once(p, b):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())

def row(p):
    b = p.read_bytes()
    return {'path': p.relative_to(ROOT).as_posix(), 'bytes': len(b), 'sha256': sha(b)}

audit_path = BASE / 'DOCS_REFRESH_AUDIT_017.json'
refusal_path = BASE / 'ROOT017_PRE_PUBLICATION_REFUSAL_001.json'
assert not audit_path.exists() and not refusal_path.exists()
prep = BASE / 'PREPARE_ROOT_DOCS_REFRESH_017.py'
prep_bytes = prep.read_bytes()
tree = ast.parse(prep_bytes)
locals_node = next(n.value for n in tree.body if isinstance(n, ast.Assign)
                   and any(isinstance(t, ast.Name) and t.id == 'local_names' for t in n.targets))
names = ['resume-2026-10-01-30h-001/' + n for n in ast.literal_eval(locals_node)] + [
    'resume-2026-09-28-001/controller-release-008-proposal017.json',
    'resume-2026-09-28-001/controller-release-009-proposal018.json',
    'resume-2026-09-28-001/full-gate-008/release-verification.json']
for name in names:
    assert (ROOT / name).read_bytes() == (INPUTS / name).read_bytes()
primary = [ROOT / 'AGENTS.md', ROOT / 'HANDOFF.md', ROOT / 'START_HERE.md',
           ROOT / 'resume-2026-09-28-001/SESSION.md', BASE / 'RESOURCE_COORDINATION.md']
before = {p: p.read_bytes() for p in primary}
for p in primary:
    old = (BEFORE / p.relative_to(ROOT)).read_bytes()
    if p.name == 'SESSION.md':
        assert before[p].startswith(old)
    else:
        assert before[p] == old
checkpoint = BASE / '30H_RESUME_CHECKPOINT_017.md'
body_bytes = checkpoint.read_bytes()
body = body_bytes.decode('utf-8')
stamp = re.search(r'^Recorded (\S+)\. The local/private', body, re.MULTILINE).group(1)
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
refusal = {'schema_version': 1, 'recorded_utc': now,
           'preparation_utility': row(prep), 'spent': True,
           'exception': 'AssertionError: ../resume-2026-09-28-001/controller-release-009-proposal018.json',
           'reason': 'Root HANDOFF inherited checkpoint-relative ../ link; maintained-link validation refused.',
           'stage': 'BEFORE_ANY_PRIMARY_DOCUMENT_PUBLICATION',
           'preserved_partial_outputs': ['root-docs-before-major017', 'root-docs-inputs-major017',
                                         '30H_RESUME_CHECKPOINT_017.md'],
           'live_primary_documents_changed_by_refused_preparation': False,
           'utility_replayed_or_edited_after_refusal': False,
           'distinct_completion_utility': str(Path(__file__).relative_to(ROOT)),
           'new_operational_authority': False}
handoff = body.replace('# Major step017 - new live release observed; staged admission policy needs a fresh chain',
                       '# Current pro2 handoff - major step017')
def root_link(m):
    target = m.group(1)
    return '](' + (target[3:] if target.startswith('../')
                    else 'resume-2026-10-01-30h-001/' + target) + ')'
handoff = re.sub(r'\]\(([^)]+)\)', root_link, handoff)
handoff += '\nDocumentation preparation001 refused on a root-relative handoff link before publication. Its checkpoint/copies and spent utility remain preserved; distinct completion002 validates resolved links before updating the primary documents.\n'
start = '''# Start here

Read [HANDOFF](HANDOFF.md), [checkpoint017](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_017.md) and newest [SESSION](resume-2026-09-28-001/SESSION.md).

Live HEAD3f74/release009 is observed with two further D178 edits. The older finite597-to-final admission policy needs a distinct reviewed chain and fresh current baseline. Gate008's record claims5569 nodes/5550passed/19skips; independent actual XML/results review is pending.

Consumer runtime002 is refused for missing strict PowerShell string checks and a12-vs7 policy-facts mismatch. Preserve it; a distinct003 correction is being authored. All14 guard tests are unrun. Direct raw004169passed/twoexpectedskips is isolated acceptance; all entry namespaces are spent. Native002/grammar004 remain source-only.

ROOT liveapply/fullQA/newgate/commit/native remain held for exclusive executor agreement. Owner ends2026-10-02T22:36:15Z; no fresh lease or durable quiet. Preserve actor changes/history83/84, frozen science, twins/existing epoch, spent attempts and original reserves/pipedGO/noNonInteractive/no-public/no-replay. Keeper consumed; restore monitor at closeout.
'''.encode('utf-8')
header = f'''**MAJOR STEP017 - NEW RELEASE009/HEAD3f74 OBSERVED; FINITE ADMISSION REBASE REQUIRED; GUARD RUNTIME002 REFUSED.**
Recorded {stamp}; published {now}. Owner ends2026-10-02T22:36:15Z. Read [checkpoint017](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_017.md), HANDOFF, START_HERE and newest SESSION.
Read-only context31571943 confirmsHEAD3f74/twoD178source-testM/all742paired. Release00923dbbc02 has37keys/parent597/ninefiles; independentreleaseacceptance absent. Gate0087153record claims5569=5550P19S51subtests0f/e/45partitions, actualevidence auditpending. Older finite raw7fe597-to-final policy is inapplicable to anotherintermediate; actor directory-chainD178 requires distinctreview. PreserveD177seven tests/D178/docs83/84.
Guardruntime002REFUSEDfd2f9130 nine missinglate stringtypes+peer12/profile7 mismatch;112files62pairs preserved/all14UNRUN. Distinct003typed correctionauthoring. Raw004169P2expectedS remains isolated/spent. Native002/grammar004source-only/caps/typedbehavior/argv/pins pending. ROOT016 docs qualifiedPASS/separate timestamp supplement preserved. SoleACK/nativequiet/lease unresolved; ROOTcanonical held/request011 no delivery. Docs preparation001 refused before primarypublication, partialcopies/checkpoint preserved; distinctcompletion002 fixes root-relativelinks. Preserve science/twins/epoch/attempts/reserves/pipedGO/noNonInteractive/no-public/no-replay;monitorrestorecloseout. Priorbytes belowexacthistory.

'''.encode('utf-8')
entry = f'''

## {now} - ROOT MAJOR017: new release requires finite-chain rebase; guard harness refused

See [checkpoint017](../resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_017.md). Freshread-only31571943 HEAD3f74/twoD178M/all742paired; release00923dbbc02/37keys/parent597/ninefiles authenticatedmetadataonly. Gate0087153claims45partitions5569=5550P19S51subtests0f/e; actualXML/results differentauditpending. Oldraw7fe finite597-to-final inapplicable to extra intermediate; actorD178directorychain needs distinctreview. Guardruntime002REFUSEDfd2f9:9missinglate stringtypes+peer12/profile7 mismatch;112files62pairs preserved/14UNRUN/new003authoring. Raw004169P2expectedS isolated/spent; earlier003failurepreserved. Native002/grammar004source-only/caps/typedproof/argv/pins pending. ROOT016docsqualifiedPASS/separate precise driver-versus-launcher timestamp supplement preserved. Request011local/no delivery/no soleACK/quiet/lease/rootliveapply/commit/repair/cleanup/processchange. Docs001refused beforepublication/root-relativehandofflink; partialcheckpoint/copies/utility preserved, distinct002completion. PreserveactorD1777/D178/83/84/science/twins/epoch/attempts/originalguards; monitorrestorecloseout. ROOT017 awaitingdifferentdocsreview.
'''.encode('utf-8')
resource = f'''

### {now} - major017 no new resource lease

Read-onlyHEAD3f74/twoD178edits31571943 is not quiet/lease; no fresh resource measurement claimed. Pro3small/heavy/native durablequiet unresolved. Request011soleSTOP/transfer/local no delivery. Guard14UNRUN/runtime002refused/003authoring; raw004isolatedacceptance spent. Keeperlaunch consumed/lastmonitorDisabled/restorationdue. [Checkpoint017](30H_RESUME_CHECKPOINT_017.md).
'''.encode('utf-8')
maintained = []
for p, b in [(primary[0], header), (primary[1], handoff.encode('utf-8')), (primary[2], start),
             (checkpoint, body_bytes), (primary[3], entry), (primary[4], resource)]:
    for target in re.findall(r'\]\(([^)]+)\)', b.decode('utf-8')):
        resolved = p.parent / target
        assert resolved.is_file(), (p, target)
        maintained.append({'document': p.relative_to(ROOT).as_posix(), 'target': target,
                           'resolved_path': str(resolved.resolve())})
assert prep.read_bytes() == prep_bytes and checkpoint.read_bytes() == body_bytes
once(refusal_path, enc(refusal))
for p in (prep, refusal_path, Path(__file__)):
    name = p.relative_to(ROOT).as_posix()
    once(INPUTS / name, p.read_bytes())
    names.append(name)
session_before = BASE / 'root-docs-before-major017-completion002' / primary[3].relative_to(ROOT)
once(session_before, before[primary[3]])
for p, b in {primary[0]: header + before[primary[0]], primary[1]: handoff.encode('utf-8'), primary[2]: start}.items():
    assert p.read_bytes() == before[p]
    p.write_bytes(b)
for p, b in ((primary[3], entry), (primary[4], resource)):
    assert p.read_bytes() == before[p]
    with p.open('ab') as f:
        f.write(b)
baseline = []
for p, b in before.items():
    preserved = session_before if p.name == 'SESSION.md' else BEFORE / p.relative_to(ROOT)
    proof = 'exact_before_copy'
    if p.name == 'AGENTS.md':
        assert p.read_bytes().endswith(b)
        proof = 'exact_retained_suffix'
    if p.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert p.read_bytes().startswith(b)
        proof = 'exact_retained_prefix'
    baseline.append({'primary': p.relative_to(ROOT).as_posix(), 'before': row(preserved), 'proof': proof})
once(BASE / 'DOCS_REFRESH_BASELINE_017.json', enc({'schema_version': 1, 'created_utc': now, 'files': baseline}))
inputs = [{'original': row(ROOT / n), 'copy': row(INPUTS / n)} for n in names]
once(BASE / 'DOCS_REFRESH_INPUTS_017.json', enc({'schema_version': 1, 'created_utc': now, 'inputs': inputs}))
declared = [*primary, checkpoint, BASE / 'DOCS_REFRESH_BASELINE_017.json', BASE / 'DOCS_REFRESH_INPUTS_017.json',
            *[BEFORE / p.relative_to(ROOT) for p in primary], session_before, *[INPUTS / n for n in names]]
facts = {'owner_end_utc': '2026-10-02T22:36:15Z', 'observed_live_head': '3f74b1d248e003168157e207e28ca775364f1f26',
         'observed_tracked_modifications': 2, 'release009_actual_metadata_key_count': 37,
         'gate008_actual_review': 'PENDING', 'release009_root_independently_accepted': False,
         'raw7fe_fixed597_policy': 'INAPPLICABLE_TO_EXTRA_INTERMEDIATE', 'consumer_runtime002': 'REFUSED_STATIC_PREPARATION',
         'consumer_runtime003': 'AUTHORING_UNBOUND_UNRUN', 'guard_tests_executed': 0,
         'raw004': 'PASS_ISOLATED_RAW_COMPONENT_RUNTIME_ONLY_SPENT',
         'native002_and_grammar004': 'SOURCE_ONLY_AUTHORING', 'sole_executor_ack_received': False,
         'native_quiet_or_resource_lease_agreed': False, 'root_live_mutations_performed': False,
         'documentation_partial_refusal_preserved': True, 'operational_or_science_authority': False}
audit = {'schema_version': 1, 'checkpoint': 17, 'created_utc': now, 'checkpoint_creation_utc': stamp,
         'status': 'AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW', 'files': [row(p) for p in declared],
         'actual_input_count': len(inputs), 'maintained_links': maintained, 'facts': facts}
once(audit_path, enc(audit))
print(json.dumps({'checkpoint_sha256': sha(body_bytes), 'audit_sha256': sha(enc(audit)),
                  'declared_files': len(declared), 'inputs': len(inputs), 'maintained_links': len(maintained)}))
