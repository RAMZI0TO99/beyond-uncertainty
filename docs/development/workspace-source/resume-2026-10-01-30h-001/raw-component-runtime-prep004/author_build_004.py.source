require(len(ack) == 22, "exact ACK22")
ack_file = js("ROOT_FIRST_EXECUTION_ACK_RAW004.TEMPLATE.json", ack)
js("DRIVER_AUTHOR_STAGE_004_002.json", {"schema_version": 1, "status": "SOURCE_TEMPLATES_PREPARED_PENDING_WHOLE_OBSERVER_AND_FINAL_PEER_REVIEW",
   "driver": driver_file, "child": child_file, "PS": ps_file, "ACK": ack_file, "source_projection": projection_file,
   "actual_test_source_size_derived": test_size, "raw_source_peer_sha256": "7c263719ad75c3f48554b6e592d11747ed6ad9e2377723320adf114d71834d5f",
   "raw_test_peer_sha256": peer["sha256"], "primary_count": len(primary), "driver_future_literals": 3,
   "ACK_key_count": len(ack), "target_execution": False, "runtime_execution_authority": False})
for row in copies:
    first, _ = read(Path(row["original"])); second, _ = read(Path(row["copy"]))
    require(first["sha256"] == second["sha256"] == row["sha256"], "final copy drift")
print(json.dumps({"driver": driver_file, "child": child_file, "PS": ps_file, "ACK": ack_file, "source_projection": projection_file, "source_copies": len(copies), "primary": len(primary), "test_size": test_size}))
