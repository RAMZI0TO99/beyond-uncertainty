driver_before, driver_bytes = read(P / "before003/run-isolated-raw-component-003.TEMPLATE.py")
driver = driver_bytes.decode("utf-8")
for old, new in (("raw-component-runtime-prep003", "raw-component-runtime-prep004"), ("raw3-003", "raw4-004"),
                 ("run-isolated-raw-component-003", "run-isolated-raw-component-004"), ("raw-test-child-003", "raw-test-child-004"),
                 ("INDEPENDENT_RAW_HARNESS_STATIC_REVIEW_003", "INDEPENDENT_RAW_HARNESS_STATIC_REVIEW_004"),
                 ("INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_003", "INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_004"),
                 ("ROOT_FIRST_EXECUTION_ACK_RAW003", "ROOT_FIRST_EXECUTION_ACK_RAW004"),
