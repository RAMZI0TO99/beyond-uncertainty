ps = read(P / "before003/ROOT_FIRST_LAUNCH_003.TEMPLATE.ps1")[1].decode("utf-8")
for old, new in (("raw-component-runtime-prep003", "raw-component-runtime-prep004"), ("run-isolated-raw-component-003", "run-isolated-raw-component-004"),
