driver = driver.replace('"runtime_snapshot", "live_guard_snapshot", "coordination_acknowledgement",', '"runtime_snapshot", "live_guard_snapshot", "whole_runtime_before", "coordination_acknowledgement",')
driver = driver.replace('and ack["raw_source_peer_review_sha256"] == RAW_SOURCE_PEER_REVIEW_SHA256', 'and ack["raw_source_peer_review_sha256"] == RAW_SOURCE_PEER_REVIEW_SHA256\n            and ack["raw_test_peer_review_sha256"] == RAW_TEST_PEER_REVIEW_SHA256', 1)
driver = driver.replace('    first = fresh_guard(ack)\n', '    first = fresh_guard(ack)\n    require(datetime.now(timezone.utc) - timestamp(first["whole_runtime_before"]["finished_utc"]) < timedelta(minutes=10),\n            "whole before observation is not fresh at sole claim")\n', 1)
driver = driver.replace('                      (PREP / "ROOT_FIRST_EXECUTION_ACK_RAW004.json", ack_sha, MAX_JSON_BYTES),', '                      (PREP / "inputs/INDEPENDENT_RAW_TEST_REVISION_STATIC_REVIEW_004.json", RAW_TEST_PEER_REVIEW_SHA256, MAX_JSON_BYTES),\n                      (PREP / "ROOT_FIRST_EXECUTION_ACK_RAW004.json", ack_sha, MAX_JSON_BYTES),', 1)
require('411000' not in driver and 'seven_primary_inputs' not in driver and driver.count('= None') == 3, "driver finite source/binding shape")
ast.parse(driver)
driver_file = once("run-isolated-raw-component-004.TEMPLATE.py", driver.encode("utf-8"))
