"""Metadata-only author utility. Target sources are read and parsed, never executed."""
import ast
import hashlib
import json
import os
import stat
from datetime import datetime, timezone
from pathlib import Path

W = Path(r"D:\Aenv\pro2\resume-2026-10-01-30h-001")
P = W / "raw-component-runtime-prep004"
OLD = W / "raw-component-runtime-prep003"
TEST = W / "raw-test-revision004"
FIELDS = ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns", "st_mode", "st_nlink", "st_file_attributes", "st_birthtime_ns")

def require(ok, why):
    if not ok:
        raise RuntimeError(why)

def read(path):
    for ancestor in reversed(path.parents):
        info = ancestor.lstat()
        require(stat.S_ISDIR(info.st_mode) and not info.st_file_attributes & 1024, "unsafe ancestor")
    before = path.lstat()
    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and not before.st_file_attributes & 1024, "unsafe input")
    with path.open("rb") as stream:
        first = os.fstat(stream.fileno())
        value = stream.read()
        last = os.fstat(stream.fileno())
    after = path.lstat()
    raw = lambda info: [getattr(info, field) for field in FIELDS]
    cross = lambda info: tuple(getattr(info, field) for field in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_nlink", "st_file_attributes", "st_birthtime_ns"))
    require(raw(before) == raw(after) and raw(first) == raw(last) and cross(before) == cross(first) == cross(last) == cross(after), "input changed")
    return {"path": str(path), "sha256": hashlib.sha256(value).hexdigest(), "size": len(value), "mode": stat.S_IMODE(before.st_mode), "path_identity": raw(before), "handle_identity": raw(first)}, value

def once(relative, value):
    path = P / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(value)
    observed, actual = read(path)
    require(actual == value, "output readback")
    return observed

def encoded(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=True, indent=2, allow_nan=False) + "\n").encode("ascii")

def js(relative, value):
    return once(relative, encoded(value))

copies = []
def copy(original, relative):
    source, value = read(original)
    copied = once(relative, value)
    require(source["path_identity"][:2] != copied["path_identity"][:2], "copy aliases original")
    row = {"original": str(original), "copy": str(P / relative), "relative_copy": relative,
           "sha256": source["sha256"], "size": source["size"], "mode": source["mode"]}
    copies.append(row)
    return row

