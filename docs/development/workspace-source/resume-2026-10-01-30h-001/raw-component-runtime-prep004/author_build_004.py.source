driver = driver.replace('{"RAW_SOURCE_PEER_REVIEW_SHA256", "HARNESS_STATIC_REVIEW_SHA256"}', '{"RAW_SOURCE_PEER_REVIEW_SHA256", "RAW_TEST_PEER_REVIEW_SHA256", "HARNESS_STATIC_REVIEW_SHA256"}')
driver = driver.replace('len(replacements) == 2, "exact two binding sites required"', 'len(replacements) == 3, "exact three binding sites required"')
