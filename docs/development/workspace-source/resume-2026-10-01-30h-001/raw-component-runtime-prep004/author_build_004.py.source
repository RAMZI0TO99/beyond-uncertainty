                 ("ROOT_LAUNCH_START_003", "ROOT_LAUNCH_START_004"), ("ROOT_LAUNCH_TERMINAL_003", "ROOT_LAUNCH_TERMINAL_004"),
                 ("ROOT_LAUNCH_STDOUT_003", "ROOT_LAUNCH_STDOUT_004"), ("ROOT_LAUNCH_STDERR_003", "ROOT_LAUNCH_STDERR_004"), ("RAW003", "RAW004"), ("Raw003", "Raw004")):
    ps = ps.replace(old, new)
ps = ps.replace("if ($value -cnotmatch '^[0-9a-f]{64}$')", "if ($value -isnot [string] -or $value -cnotmatch '^[0-9a-f]{64}$')")
ps = ps.replace("    if (Test-Path -LiteralPath $path) { throw 'One-use root capture exists' }", "    try { [void](Get-Item -LiteralPath $path -Force -ErrorAction Stop); throw 'One-use root capture exists' }\n    catch [System.Management.Automation.ItemNotFoundException] { } # Only absent paths are accepted; access errors propagate.")
ps_file = once("ROOT_FIRST_LAUNCH_004.TEMPLATE.ps1", ps.encode("utf-8"))
ack = json.loads(read(P / "before003/ROOT_FIRST_EXECUTION_ACK_RAW003.TEMPLATE.json")[1])
ack["decision"] = "execute_isolated_raw004_collection_then_tests_once"
ack["raw_source_peer_review_sha256"] = ack.pop("raw_peer_review_sha256")
