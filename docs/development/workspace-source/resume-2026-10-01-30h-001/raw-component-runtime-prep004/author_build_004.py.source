require(test_manifest["sha256"] == "f08d7f78e591ee568037e4fc62e709533cdb18c8f02a9f9349509c837e3fc475", "test manifest pin")
peer, peer_bytes = read(TEST / "INDEPENDENT_RAW_TEST_REVISION_STATIC_REVIEW_004.json")
