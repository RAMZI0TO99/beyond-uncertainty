driver = driver.replace('SOURCE_PROJECTION_SHA256 = "15ed4f1deb07b3ebef9abd1df5e0f82937f7bc046ad89887ea63252617d2fa72"', "SOURCE_PROJECTION_SHA256 = " + repr(projection_file["sha256"]))
