primary = source_rows + [copy(W / "successor-candidate-raw-revision003/RAW_POLICY_STAGED_MANIFEST_003.json", "inputs/RAW_POLICY_STAGED_MANIFEST_003.json"),
                         copy(TEST / "STAGED_MANIFEST_004.json", "inputs/STAGED_MANIFEST_004.json")]
