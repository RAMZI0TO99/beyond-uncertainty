driver = driver.replace('RAW_TEST_SHA256, 411000', 'RAW_TEST_SHA256, RAW_TEST_SIZE')

helpers = r'''
REVIEWER_ALIASES = {name: canonical for canonical in (
    "/root", "/root/raw_policy_worker", "/root/keepawake_stage", "/root/candidate_review",
    "/root/bootstrap_stage", "/root/window_docs", "/root/gate_evidence")
    for name in (canonical, canonical.rsplit("/", 1)[-1])}
CONFIG_NAMES = ("pytest.toml", ".pytest.toml", "pytest.ini", ".pytest.ini", "pyproject.toml", "tox.ini", "setup.cfg", "conftest.py")
PYTEST_CONFIG_SOURCE_SHA256 = "535d149e6f3962e44260b6645bb354976e19531f5dd248e14ee7d7fff61c8848"
WHOLE_EXPECTED = {
    "base": {"files":5368,"directories":504,"bytes":155022742,"sha256":"0a5aff918e4a46fae2427a593261f8e3640ba439ba4ffebf5081b15eb7df6760"},
    "scripts": {"files":22,"directories":0,"bytes":2145329,"sha256":"baa95b3f7e3e50a9b388fca6c4fd238fb55fc2e62f4cdc07c1b7c57caa9a54ad"},
}

def independent_reviewer(review, *, harness):
    identifier = review.get("reviewer")
    if type(identifier) is dict:
        identifier = identifier.get("canonical_identity")
    require(type(identifier) is str and identifier in REVIEWER_ALIASES, "unknown reviewer identity")
    canonical = REVIEWER_ALIASES[identifier]
    excluded = {"/root", "/root/raw_policy_worker"}
    if harness:
        excluded.add("/root/keepawake_stage")
    require(canonical not in excluded, "source/harness author or root cannot supply independent review")
    return canonical

def configuration_guard():
    read(PROJECT / "pro2/.venv/Lib/site-packages/_pytest/config/findpaths.py", PYTEST_CONFIG_SOURCE_SHA256)
    directories = [COPY / "tests", *(COPY / "tests").parents]
    require(len(directories) == 7, "exact configuration ancestors differ")
    paths = [directory / name for directory in directories for name in CONFIG_NAMES]
    require(len(paths) == 56 and all(absent(path) for path in paths), "recognized pytest/config/conftest present")
    return [str(path) for path in paths]

def whole_before_guard(ack):
    path, digest = binding(ack["whole_runtime_before"])
    require(path == PREP / "whole-runtime-before/result.json", "whole before fixed path differs")
    value = parsed(path, digest)
    exact(value, ("schema_version", "phase", "verdict", "started_utc", "finished_utc", "observer_sha256", "static_review_sha256", "owner_sha256", "trees", "observation_files", "before_record_sha256", "runtime_mutation", "target_execution"), "external whole before")
    require(type(value["schema_version"]) is int and value["schema_version"] == 1 and value["phase"] == "before"
            and value["verdict"] == "MATCHES_PINNED_RUNTIME_TWICE" and value["owner_sha256"] == OWNER_SHA256
            and value["static_review_sha256"] == HARNESS_STATIC_REVIEW_SHA256
            and hex64(value["observer_sha256"]) and value["before_record_sha256"] is None
            and value["runtime_mutation"] is False and value["target_execution"] is False,
            "external whole before facts differ")
    require(timestamp(value["started_utc"]) <= timestamp(value["finished_utc"]) <= datetime.now(timezone.utc), "whole before times")
    exact(value["trees"], ("base", "scripts"), "whole trees")
    require(value["trees"] == WHOLE_EXPECTED, "whole runtime identity differs")
    require(type(value["observation_files"]) is list and len(value["observation_files"]) == 4, "four whole observations")
    paths = set()
    for row in value["observation_files"]:
        exact(row, ("path", "sha256", "size"), "whole observation binding")
        captured = within_work(row["path"])
        require(captured.parent == PREP / "whole-runtime-before" and captured.name in
                ("base-first.json", "base-second.json", "scripts-first.json", "scripts-second.json")
                and str(captured) not in paths and type(row["size"]) is int and 0 < row["size"] <= 4194304, "whole row path or cap")
        paths.add(str(captured)); read(captured, row["sha256"], row["size"])
    # This authenticates external time-local observations. It is NOT a fresh global-tree reread by this driver.
    return {"path":str(path),"sha256":digest,"finished_utc":value["finished_utc"],"observer_sha256":value["observer_sha256"]}

'''
driver = driver.replace("def fresh_guard(ack, expected_live=None):", helpers + "def fresh_guard(ack, expected_live=None):", 1)
driver = driver.replace("    inputs = primary_inputs()\n", "    configuration_paths = configuration_guard()\n    whole_before = whole_before_guard(ack)\n    inputs = primary_inputs()\n", 1)
driver = driver.replace('return {"primary_inputs": inputs, "live": live, "runtime": actual_runtime,', 'return {"configuration56": configuration_paths, "whole_runtime_before": whole_before,\n            "primary_inputs": inputs, "live": live, "runtime": actual_runtime,', 1)
driver = driver.replace('    bound = parsed(PREP / "INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_004.json", bound_review_sha)', '    independent_reviewer(static, harness=True)\n    bound = parsed(PREP / "INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_004.json", bound_review_sha)', 1)
driver = driver.replace('    launch_path = PREP / "ROOT_LAUNCH_START_004.json"', '    independent_reviewer(bound, harness=True)\n    launch_path = PREP / "ROOT_LAUNCH_START_004.json"', 1)
old_peer = '''    require(raw_peer["decision"] == "PASS_STATIC"
            and raw_peer["raw_helper_sha256"] == RAW_SOURCE_SHA256
            and raw_peer["raw_tests_sha256"] == RAW_TEST_SHA256
            and RAW_SOURCE_PEER_REVIEW_SHA256 == "7c263719ad75c3f48554b6e592d11747ed6ad9e2377723320adf114d71834d5f",
            "exact independent raw003 peer receipt required")'''
new_peer = '''    independent_reviewer(raw_peer, harness=False)
    require(raw_peer["decision"] == "PASS_STATIC" and raw_peer["raw_helper_sha256"] == RAW_SOURCE_SHA256
            and raw_peer["raw_tests_sha256"] == "b4bf5499506b6521ce6278254bffb9ba5fbde8f71f3e734edd4e148783dc2a7c"
            and RAW_SOURCE_PEER_REVIEW_SHA256 == "7c263719ad75c3f48554b6e592d11747ed6ad9e2377723320adf114d71834d5f",
            "exact historical raw003 SOURCE peer receipt required")
    test_peer = parsed(PREP / "inputs/INDEPENDENT_RAW_TEST_REVISION_STATIC_REVIEW_004.json", RAW_TEST_PEER_REVIEW_SHA256)
    independent_reviewer(test_peer, harness=False)
    require(test_peer["decision"] == test_peer["verdict"] == "PASS_STATIC_TEST_REVISION_ONLY"
            and test_peer["raw_helper_sha256"] == test_peer["raw_source_sha256"] == RAW_SOURCE_SHA256
            and test_peer["raw_tests_sha256"] == RAW_TEST_SHA256 and type(test_peer["raw_tests_bytes"]) is int
            and test_peer["raw_tests_bytes"] == RAW_TEST_SIZE, "exact new raw004 TEST peer receipt required")'''
require(old_peer in driver, "old peer exact source anchor")
