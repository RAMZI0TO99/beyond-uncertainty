def ordinal(s):
    b=s.encode("utf-16-le","surrogatepass");return tuple(b[i]|b[i+1]<<8 for i in range(0,len(b),2))
def checked_tree(v,expected_root,expected_identity):
    assert set(v)=={"directory_metadata","finished_at_utc","identity","non_ascii_paths","root","root_identity","rows","started_at_utc"}
    assert v["root"]==str(expected_root) and type(v["rows"]) is list and type(v["directory_metadata"]) is dict
    assert set(v["identity"])=={"bytes","directories","files","sha256"} and all(type(v["identity"][x]) is int for x in ("bytes","directories","files")) and hex64(v["identity"]["sha256"])
    paths=[x["path"] for x in v["rows"]];assert len(paths)==len(set(paths))==len({x.lower() for x in paths}) and paths==sorted(paths,key=ordinal)
    lines=[];files=dirs=total=0;file_rows={};directory_rows={}
    for row in v["rows"]:
        p=row["path"];assert type(p) is str and p and not any(x in p for x in ("\t","\n","\r"))
        assert all(x not in ("",".","..") for x in p.split("/")) and not pathlib.PureWindowsPath(p).is_absolute()
        assert type(row["path_identity"]) is list and len(row["path_identity"])==9 and all(type(n) is int for n in row["path_identity"])
        if row["kind"]=="directory":
            assert set(row)=={"kind","path","path_identity"}
            assert stat.S_ISDIR(row["path_identity"][5]) and not row["path_identity"][7]&1024
            directory_rows[str(expected_root/pathlib.PurePosixPath(p))]=row["path_identity"];dirs+=1;lines.append(("D\t"+p+"\n").encode("utf-8"))
        else:
            assert row["kind"]=="file" and set(row)=={"handle_identity","kind","path","path_identity","sha256","size"}
            assert hex64(row["sha256"]) and type(row["size"]) is int and row["size"]>=0
            assert type(row["handle_identity"]) is list and len(row["handle_identity"])==9 and all(type(n) is int for n in row["handle_identity"])
            assert row["path_identity"][2]==row["handle_identity"][2]==row["size"] and row["path_identity"][6]==row["handle_identity"][6]==1
            assert stat.S_ISREG(row["path_identity"][5]) and stat.S_ISREG(row["handle_identity"][5]) and not row["path_identity"][7]&1024 and not row["handle_identity"][7]&1024
            assert all(row["path_identity"][i]==row["handle_identity"][i] for i in (0,1,2,3,6,7,8))
            file_rows[p]=row;files+=1;total+=row["size"];lines.append(("F\t"+p+"\t"+str(row["size"])+"\t"+row["sha256"]+"\n").encode("utf-8"))
    calc={"bytes":total,"directories":dirs,"files":files,"sha256":hashlib.sha256(b"".join(lines)).hexdigest()}
    assert calc==v["identity"]==expected_identity
    assert v["non_ascii_paths"]==[p for p in paths if not p.isascii()]
    assert type(v["root_identity"]) is list and len(v["root_identity"])==9 and all(type(n) is int for n in v["root_identity"]) and stat.S_ISDIR(v["root_identity"][5])
    assert v["directory_metadata"]=={**directory_rows,str(expected_root):v["root_identity"]}
    assert dt.datetime.fromisoformat(v["started_at_utc"])<=dt.datetime.fromisoformat(v["finished_at_utc"])
    return {"identity":calc,"file_rows":file_rows,"directory_rows":v["directory_metadata"],"root_identity":v["root_identity"],"rows":v["rows"]}

