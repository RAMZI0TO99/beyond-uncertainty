canonical=lambda v:json.dumps(v,sort_keys=True,separators=(",",":"),ensure_ascii=True,allow_nan=False).encode("ascii")+b"\n"
report["record_digest"]=hashlib.sha256(canonical(report)).hexdigest()
raw_report=canonical(report);assert len(raw_report)<8388608
for p,data in ((out_md,md),(out_json,raw_report)):
    ancestors(p)
    with p.open("xb") as f:f.write(data);f.flush();os.fsync(f.fileno())
    assert read(p,hashlib.sha256(data).hexdigest(),len(data))==data
# Fourth observation after publication; the frozen report is not rewritten.
for p,row in first.items():
    read(pathlib.Path(p),row["sha256"],row["size"],maximum=max(row["size"],1));assert INPUTS[p]==row,p
print(json.dumps({"verdict":report["verdict"],"json":{"path":str(out_json),"sha256":hashlib.sha256(raw_report).hexdigest(),"size":len(raw_report)},"markdown":{"path":str(out_md),"sha256":hashlib.sha256(md).hexdigest(),"size":len(md)},"input_count":len(first),"observations_before_publication":3,"fourth_postwrite_input_observation_identical":True,"counts":report["counts"]},separators=(",",":")))
