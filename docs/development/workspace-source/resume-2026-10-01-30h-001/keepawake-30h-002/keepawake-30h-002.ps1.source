$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

# Reviewed005 lineage; distinct 30-hour attempt. Never run an unbound template.
$parentSession = 'D:\Aenv\pro2\resume-2026-10-01-30h-001'
$kaSession = Join-Path $parentSession 'keepawake-30h-002'
$ownerPath = Join-Path $parentSession 'OWNER_WORK_WINDOW_30H_20261001_001.json'
$helperPath = Join-Path $kaSession 'keepawake-30h-002.ps1'
$launcherPath = Join-Path $kaSession 'launch-keepawake-30h-002-once.ps1'
$stopperPath = Join-Path $kaSession 'stop-keepawake-30h-002-once.ps1'
$ownerSha = '3ea2fb0aa19fb4526c93fa8429d140b415a0afe118f62fe1691067d7945b2eff' # BIND_OWNER_SHA256_AFTER_INDEPENDENT_REVIEW
$deadlineText = '2026-10-02T22:36:15Z'
$deadline = [datetime]::Parse($deadlineText).ToUniversalTime()
$intentPath = Join-Path $kaSession 'keepawake-30h-002.launch-intent.json'
$startedPath = Join-Path $kaSession 'keepawake-30h-002.started.json'
$activatedPath = Join-Path $kaSession 'keepawake-30h-002.activated.json'
$stoppedPath = Join-Path $kaSession 'keepawake-30h-002.stopped.json'
$stopRequestPath = Join-Path $kaSession 'keepawake-30h-002.stop-request.json'
$stdoutPath = Join-Path $kaSession 'keepawake-30h-002.stdout.txt'
$stderrPath = Join-Path $kaSession 'keepawake-30h-002.stderr.txt'
$psExe = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
$arguments = '-NoProfile -ExecutionPolicy Bypass -File "' + $helperPath + '"'
$expectedCommand = '"' + $psExe + '" ' + $arguments

function Test-KaPresent([string] $LiteralPath) {
    try {
        $null = Get-Item -LiteralPath $LiteralPath -Force -ErrorAction Stop
        return $true
    }
    catch [System.Management.Automation.ItemNotFoundException] {
        if ($_.FullyQualifiedErrorId -cne 'PathNotFound' -and $_.FullyQualifiedErrorId -notlike 'PathNotFound,*') { throw }
        return $false
    }
}

function Assert-KaAbsent([string] $LiteralPath) {
    if (Test-KaPresent $LiteralPath) { throw "Attempt artifact already exists: $LiteralPath" }
}

function Get-KaBytes([string] $LiteralPath) {
    $kaItem = Get-Item -LiteralPath $LiteralPath -Force -ErrorAction Stop
    if ($kaItem -isnot [IO.FileInfo] -or
        ($kaItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
        throw "Expected a regular file: $LiteralPath"
    }
    return ,([IO.File]::ReadAllBytes($LiteralPath))
}

function Get-KaBytesSha([byte[]] $InputBytes) {
    $kaHasher = [Security.Cryptography.SHA256]::Create()
    try { return ([BitConverter]::ToString($kaHasher.ComputeHash($InputBytes))).Replace('-', '').ToLowerInvariant() }
    finally { $kaHasher.Dispose() }
}

function Get-KaFileSha([string] $LiteralPath) {
    return Get-KaBytesSha (Get-KaBytes $LiteralPath)
}

function Read-KaJson([string] $LiteralPath, [string] $ExpectedHash = '') {
    $kaBytes = Get-KaBytes $LiteralPath
    $kaHash = Get-KaBytesSha $kaBytes
    if ($ExpectedHash -ne '' -and $kaHash -cne $ExpectedHash) {
        throw "Exact-byte hash mismatch: $LiteralPath"
    }
    $kaText = [Text.UTF8Encoding]::new($false, $true).GetString($kaBytes)
    return [pscustomobject]@{
        Sha256 = $kaHash
        Value = ($kaText | ConvertFrom-Json -ErrorAction Stop)
    }
}

function Write-KaCreateNewJson([string] $LiteralPath, [object] $JsonValue) {
    $kaBytes = [Text.UTF8Encoding]::new($false).GetBytes(($JsonValue | ConvertTo-Json -Depth 12) + [char]10)
    $kaStream = [IO.File]::Open($LiteralPath, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::Read)
    try { $kaStream.Write($kaBytes, 0, $kaBytes.Length); $kaStream.Flush($true) }
    finally { $kaStream.Dispose() }
}

function Assert-KaOwner {
    if ($null -eq $ownerSha -or $ownerSha -cnotmatch '^[0-9a-f]{64}$') {
        throw 'Owner binding is unset or malformed; template execution is refused'
    }
    $kaOwner = (Read-KaJson $ownerPath $ownerSha).Value
    if ($kaOwner.schema -ne 1 -or $kaOwner.authority -cne 'owner' -or
        $kaOwner.decision -cne 'extend_supervised_local_private_work' -or
        $kaOwner.work_start_utc -cne '2026-10-01T16:36:15Z' -or
        $kaOwner.work_end_utc -cne $deadlineText -or $kaOwner.authorized_duration_hours -ne 30 -or
        $kaOwner.public_actions_authorized -ne $false -or $kaOwner.native_guards_changed -ne $false -or
        $kaOwner.one_use_replay_authorized -ne $false -or $kaOwner.frozen_scientific_changes_authorized -ne $false -or
        $kaOwner.additional_recovery_epochs_authorized -ne $false) {
        throw 'Owner authority, duration, deadline, or scope mismatch'
    }
}

function Get-KaProcess([int] $IdentityPid) {
    $kaProcesses = @(Get-CimInstance -ClassName Win32_Process -Filter ('ProcessId = ' + $IdentityPid) -ErrorAction Stop)
    if ($kaProcesses.Count -ne 1) { throw 'Expected exactly one live helper process' }
    $kaProcess = $kaProcesses[0]
    if ([int]$kaProcess.ProcessId -ne $IdentityPid -or $null -eq $kaProcess.CreationDate -or
        [string]::IsNullOrWhiteSpace($kaProcess.ExecutablePath) -or
        [string]::IsNullOrWhiteSpace($kaProcess.CommandLine) -or
        -not [string]::Equals($kaProcess.ExecutablePath, $psExe, [StringComparison]::OrdinalIgnoreCase) -or
        -not [string]::Equals($kaProcess.CommandLine.TrimEnd(), $expectedCommand, [StringComparison]::OrdinalIgnoreCase)) {
        throw 'Live helper PID, executable, or exact command identity mismatch'
    }
    return $kaProcess
}

function Assert-KaReceiptBinding([object] $Receipt, [string] $BoundHelperSha) {
    if ($Receipt.deadline_utc -cne $deadlineText -or $Receipt.owner_sha256 -cne $ownerSha -or
        $Receipt.helper_sha256 -cne $BoundHelperSha) {
        throw 'Keepawake receipt authority binding mismatch'
    }
}

Assert-KaOwner
if (-not [Environment]::Is64BitProcess) { throw 'Helper requires a 64-bit PowerShell process' }
if (-not [string]::Equals($PSCommandPath, $helperPath, [StringComparison]::OrdinalIgnoreCase)) {
    throw 'Helper must run from the bound helper path'
}
if ([datetime]::UtcNow -ge $deadline) { throw 'Owner window has ended' }
foreach ($kaPath in @($startedPath, $activatedPath, $stoppedPath, $stopRequestPath)) { Assert-KaAbsent $kaPath }
$intentRead = Read-KaJson $intentPath
$intent = $intentRead.Value
$helperSha = Get-KaFileSha $helperPath
Assert-KaReceiptBinding $intent $helperSha
if ($intent.launcher_sha256 -cne (Get-KaFileSha $launcherPath) -or
    $intent.expected_process_executable -cne $psExe -or $intent.expected_process_command -cne $expectedCommand) {
    throw 'Launch intent launcher or process binding mismatch'
}
$process = Get-KaProcess $PID
$createdUtc = $process.CreationDate.ToUniversalTime().ToString('o')
if ([datetime]::Parse($createdUtc).ToUniversalTime() -lt [datetime]::Parse($intent.utc).ToUniversalTime().AddSeconds(-2) -or
    [datetime]::Parse($createdUtc).ToUniversalTime() -gt [datetime]::UtcNow) {
    throw 'Helper process creation time differs from the launch intent'
}

Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class CodexKeepAwake30h001 {
    [DllImport("kernel32.dll", SetLastError=true)]
    public static extern uint SetThreadExecutionState(uint flags);
}
'@
$systemRequiredContinuous = [uint32]2147483649
$continuousOnly = [uint32]2147483648
$stateActive = $false
$startedWritten = $false
$stopReason = 'error'
$clearResult = [uint32]0
$startedSha = $null
$stopRequestSha = $null
try {
    # Recheck exact bindings and live identity immediately before activating this thread.
    Assert-KaOwner
    if ((Get-KaFileSha $helperPath) -cne $helperSha -or
        (Get-KaFileSha $intentPath) -cne $intentRead.Sha256) { throw 'Helper or launch intent changed before activation' }
    $activationProcess = Get-KaProcess $PID
    if ($activationProcess.CreationDate.ToUniversalTime().ToString('o') -cne $createdUtc) {
        throw 'Helper creation identity changed before activation'
    }
    if ([datetime]::UtcNow -ge $deadline) { throw 'Owner window ended before activation' }
    $previous = [CodexKeepAwake30h001]::SetThreadExecutionState($systemRequiredContinuous)
    if ($previous -eq 0) { throw 'SetThreadExecutionState activation failed' }
    $stateActive = $true
    $started = [pscustomobject]@{
        schema = 1
        utc = [datetime]::UtcNow.ToString('o')
        deadline_utc = $deadlineText
        process_id = $PID
        process_created_utc = $createdUtc
        process_executable = $process.ExecutablePath
        process_command = $process.CommandLine.TrimEnd()
        owner_sha256 = $ownerSha
        helper_sha256 = $helperSha
        launch_intent_sha256 = $intentRead.Sha256
        previous_state = $previous
        active_flags = $systemRequiredContinuous
        thread_scope = 'helper_current_thread_only'
    }
    Write-KaCreateNewJson $startedPath $started
    $startedWritten = $true
    $startedSha = Get-KaFileSha $startedPath
    while ($true) {
        $remainingMs = [Math]::Ceiling(($deadline - [datetime]::UtcNow).TotalMilliseconds)
        if ($remainingMs -le 0) { $stopReason = 'deadline'; break }
        if (Test-KaPresent $stopRequestPath) {
            $requestRead = Read-KaJson $stopRequestPath
            $request = $requestRead.Value
            Assert-KaReceiptBinding $request $helperSha
            if ([int]$request.process_id -ne $PID -or $request.process_created_utc -cne $createdUtc -or
                $request.process_executable -cne $process.ExecutablePath -or
                $request.process_command -cne $process.CommandLine.TrimEnd() -or
                $request.launch_intent_sha256 -cne $intentRead.Sha256 -or
                $request.started_receipt_sha256 -cne $startedSha -or
                $request.stopper_sha256 -cne (Get-KaFileSha $stopperPath) -or
                $request.reason -cne 'early_supervised_closeout') {
                throw 'Stop request exact helper identity or receipt binding mismatch'
            }
            if ((Get-KaFileSha $startedPath) -cne $startedSha -or
                (Get-KaFileSha $intentPath) -cne $intentRead.Sha256) { throw 'Start or intent receipt changed' }
            $stopRequestSha = $requestRead.Sha256
            $stopReason = 'owner_stop_request'
            break
        }
        Assert-KaOwner
        if ((Get-KaFileSha $helperPath) -cne $helperSha) { throw 'Helper bytes changed while active' }
        $remainingMs = [Math]::Ceiling(($deadline - [datetime]::UtcNow).TotalMilliseconds)
        if ($remainingMs -le 0) { $stopReason = 'deadline'; break }
        if ([CodexKeepAwake30h001]::SetThreadExecutionState($systemRequiredContinuous) -eq 0) {
            throw 'SetThreadExecutionState refresh failed'
        }
        # A 25-second cap leaves margin below the required 30-second refresh period.
        Start-Sleep -Milliseconds ([int][Math]::Min(25000, $remainingMs))
    }
}
finally {
    if ($stateActive) {
        # This clears only the execution state set by this helper's own thread.
        $clearResult = [CodexKeepAwake30h001]::SetThreadExecutionState($continuousOnly)
        $stopped = [pscustomobject]@{
            schema = 1
            utc = [datetime]::UtcNow.ToString('o')
            deadline_utc = $deadlineText
            process_id = $PID
            process_created_utc = $createdUtc
            process_executable = $process.ExecutablePath
            process_command = $process.CommandLine.TrimEnd()
            owner_sha256 = $ownerSha
            helper_sha256 = $helperSha
            launch_intent_sha256 = $intentRead.Sha256
            started_receipt_written = $startedWritten
            started_receipt_sha256 = $startedSha
            stop_request_sha256 = $stopRequestSha
            reason = $stopReason
            clear_flags = $continuousOnly
            clear_result = $clearResult
            clear_succeeded = ($clearResult -ne 0)
            thread_scope = 'helper_current_thread_only'
        }
        Write-KaCreateNewJson $stoppedPath $stopped
        if ($clearResult -eq 0) { throw 'SetThreadExecutionState clear failed' }
    }
}
