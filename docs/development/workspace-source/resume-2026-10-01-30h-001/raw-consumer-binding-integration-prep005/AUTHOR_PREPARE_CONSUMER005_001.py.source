table["metaclass_models_prepared"]=["M1","M2","M3","M4"]
table["future_complete_source_peer"]=None
deltas=[]
for role,row in table["consumers"].items():
 old=read(S/row["path"],row["sha256"],row["size"]); oldtext=old.decode("utf-8")
 oldtree=ast.parse(oldtext); helpers=[n for n in oldtree.body if isinstance(n,ast.FunctionDef) and n.name=="_raw_helper_value_identity"];assert len(helpers)==1
 helper=helpers[0]; lines=oldtext.splitlines(keepends=True); segment="".join(lines[helper.lineno-1:helper.end_lineno])
 newsegment=segment
 for before,after in replacements:assert newsegment.count(before)==1;(None);newsegment=newsegment.replace(before,after)
 newtext="".join(lines[:helper.lineno-1])+newsegment+"".join(lines[helper.end_lineno:]);new=newtext.encode("utf-8")
 inverse=newtext
 for before,after in reversed(replacements):assert inverse.count(after)==1;inverse=inverse.replace(after,before)
 assert inverse.encode("utf-8")==old
 newtree=ast.parse(newtext)
 assert len(oldtree.body)==len(newtree.body)
 unchanged=0
 for a,b in zip(oldtree.body,newtree.body):
  if isinstance(a,ast.FunctionDef) and a.name=="_raw_helper_value_identity":
   assert ast.dump(a,include_attributes=False)!=ast.dump(b,include_attributes=False)
  else:assert ast.dump(a,include_attributes=False)==ast.dump(b,include_attributes=False);unchanged+=1
 assert new.count(table["raw_sha256"].encode("ascii"))==old.count(table["raw_sha256"].encode("ascii"))
 assert "if isinstance(value, Path):" in newsegment
 publish(R/row["path"],new);row["sha256"]=sha(new);row["size"]=len(new)
 deltas.append({"role":role,"path":row["path"],"before_sha256":sha(old),"after_sha256":sha(new),"before_size":len(old),"after_size":len(new),"sole_changed_definition":"_raw_helper_value_identity","substitution_count":4,"all_other_top_level_AST_nodes_exact":unchanged,"byte_reverse_matches_revision004":True,"path_branch_exact":True})
