choice=J(choice_bytes)
raw=read(R/"inputs/raw004-source.bytes","da64c4ea68e86bbcd28f7fbccd60baa765cc534afa532c14cd7cb39de782b211",210452)
replacements=[
 ("kind in (bool, int, float, str)","kind is bool or kind is int or kind is float or kind is str"),
