"""Inert regression preparation. Execute only in a separately reviewed isolated harness.

Select actual staged guard definitions and real raw004 definition bytes; do not import
full consumers, observe production authority, claim, spawn a fit, or run native code.
These tests prove guarded-loader behavior only, not the full recovery lifecycle.
"""
from __future__ import annotations

import ast
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import stat
import sys
import tempfile
import types
import unittest
from collections.abc import Mapping
from contextlib import contextmanager
from pathlib import Path
from unittest import mock

PREP = Path(__file__).resolve(strict=True).parent
RAW = PREP / "inputs/raw004-source.bytes"
RAW_NAME = "_bu_week8_d161_raw_authority"

def digest(value):
    return hashlib.sha256(value).hexdigest()

def selected(source, names):
    tree = ast.parse(source)
    nodes = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name in names]
    if len(nodes) != len(names):
        raise AssertionError("requested real function definitions are missing")
    return ast.fix_missing_locations(ast.Module(body=[ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0), *nodes], type_ignores=[]))

def module_from_bytes(path, source):
    loader = importlib.machinery.SourceFileLoader(RAW_NAME, str(path))
    specification = importlib.util.spec_from_loader(RAW_NAME, loader)
    module = importlib.util.module_from_spec(specification)
    module.__source_sha256__ = digest(source)
    module.__source_identity__ = {"path": str(path.resolve(strict=True)), "sha256": digest(source), "size": len(source)}
    sys.modules[RAW_NAME] = module
    exec(compile(source, str(path), "exec", dont_inherit=True), module.__dict__)
    return module

@contextmanager
def guard_fixture(role):
    bindings = json.loads((PREP / "SOURCE_GUARD_TEST_BINDINGS_005.json").read_bytes())
    row = bindings["consumers"][role]
    path = PREP / row["path"]
    source = path.read_bytes()
    raw = RAW.read_bytes()
    if digest(source) != row["sha256"] or digest(raw) != bindings["raw_sha256"]:
        raise AssertionError("test preparation source pins differ")
    previous = sys.modules.get(RAW_NAME)
    prior_static = sys.modules.get("_bu_week8_d161_static_raw_authority")
    class Refused(ValueError):
        pass
    namespace = {
        "__name__": "isolated_selected_consumer_guards", "__file__": str(path),
        "ast": ast, "hashlib": hashlib, "importlib": importlib, "os": os, "re": re,
        "stat": stat, "sys": sys, "types": types, "Path": Path, "Mapping": Mapping,
        "Any": object, "FunctionType": types.FunctionType, "ModuleType": types.ModuleType,
        "CodeType": types.CodeType, "MappingProxyType": types.MappingProxyType, "RAW_AUTHORITY_HELPER": RAW,
        "RAW_AUTHORITY_MODULE_NAME": RAW_NAME,
        "EXPECTED_RAW_AUTHORITY_HELPER_SHA256": bindings["raw_sha256"],
        "RAW_AUTHORITY_HELPER_SHA256": bindings["raw_sha256"],
        "_FILE_ATTRIBUTE_REPARSE_POINT": 0x400,
        "_STATIC_RAW_AUTHORITY": None, "_RAW_HELPER_EXECUTABLE_STATE": None,
        "sha256_bytes": digest, "_sha_bytes": digest,
        "_sha_file": lambda path: digest(path.read_bytes()),
        "_is_reparse": lambda info: stat.S_ISLNK(info.st_mode) or bool(getattr(info, "st_file_attributes", 0) & 0x400),
        row["exception"]: Refused,
    }
    exec(compile(selected(source, set(row["selected_functions"])), str(path), "exec", dont_inherit=True), namespace)
    try:
        module = module_from_bytes(RAW, raw)
        if role == "entrypoint":
            load = lambda: namespace["_load_raw_authority"](RAW, bindings["raw_sha256"])[0]
        else:
            load = namespace[row["loader"]]
        # Every negative starts from two accepted uses of the actual pinned raw
        # definitions. A shared clean-module failure must fail this fixture first.
        if load() is not module or load() is not module:
            raise AssertionError("healthy actual raw4 cold/reuse control failed before mutation")
        namespace["_GUARD_HEALTHY_CONTROL_CALLS"] = 2
        # Cold cases must still exercise first acceptance against a fresh pinned
        # reference; resetting only the guard cache preserves the real raw module.
        namespace["_STATIC_RAW_AUTHORITY" if role == "controller"
                  else "_RAW_HELPER_EXECUTABLE_STATE"] = None
        yield module, load, namespace, Refused, bindings
    finally:
        if previous is None:
            sys.modules.pop(RAW_NAME, None)
        else:
            sys.modules[RAW_NAME] = previous
        if prior_static is None:
            sys.modules.pop("_bu_week8_d161_static_raw_authority", None)
        else:
            sys.modules["_bu_week8_d161_static_raw_authority"] = prior_static


def schema3_policy_changes(name, value):
    """Finite typed mutants, never an unsupported object() placeholder."""
    if name == "SUCCESSOR_COMPACT_INTERMEDIATE_FACTS":
        changed = dict(value[0]); changed["controller_commit"] = "f" * 40
        return [("nested_commit", (types.MappingProxyType(changed), value[1])),
                ("middle_order", tuple(reversed(value))), ("missing_middle", value[:1]),
                ("outer_list", list(value)), ("nested_dict", (dict(value[0]), value[1]))]
    if name == "_SUCCESSOR_COMPACT_AFTERIMAGES":
        changed = dict(value[0][0]); changed["size"] += 1
        first = (types.MappingProxyType(changed), *value[0][1:])
        reordered = (value[0][1], value[0][0], *value[0][2:])
        return [("nested_size", (first, value[1])), ("row_order", (reordered, value[1])),
                ("missing_row", (value[0][:-1], value[1])), ("outer_list", list(value)),
                ("nested_dict", ((dict(value[0][0]), *value[0][1:]), value[1]))]
    if name == "_SUCCESSOR_COMPACT_PROOF_LIMITS":
        changed = dict(value[0]); key = "release_record_base64"
        width, size, pin = changed[key]
        changed[key] = (width, size + 1, pin)
        missing = dict(value[0]); del missing["git_commit_object_base64"]
        return [("decoded_size", (types.MappingProxyType(changed), value[1])),
                ("missing_proof", (types.MappingProxyType(missing), value[1])),
                ("outer_list", list(value)), ("nested_dict", (dict(value[0]), value[1]))]
    if name == "_SUCCESSOR_COMPACT_RELEASE_KEYS":
        first = set(value[0]); first.remove("ControllerCommit"); first.add("UnreviewedCommit")
        return [("typed_key_change", (frozenset(first), value[1])),
                ("middle_order", tuple(reversed(value))), ("outer_list", list(value))]
    if name in ("_SUCCESSOR_COMPACT_ENTRY_KEYS", "_SUCCESSOR_COMPACT_PROOF_KEYS",
                "_SUCCESSOR_ATTESTATION_SCHEMA3_KEYS"):
        key = sorted(value)[0]
        return [("missing_key", frozenset(set(value) - {key})),
                ("typed_key_change", frozenset((set(value) - {key}) | {"unreviewed_" + key})),
                ("set_type", set(value))]
    if name == "_SUCCESSOR_COMPACT_PROOF_MAX_BYTES":
        return [("typed_bound", (value[0] + 1, value[1])),
                ("middle_order", tuple(reversed(value))), ("outer_list", list(value))]
    if name == "_SUCCESSOR_COMPACT_QA_PATHS":
        return [("grouped_order", (value[1], value[0], *value[2:])),
                ("missing_path", value[:-1]), ("outer_list", list(value))]
    if name in ("_SUCCESSOR_COMPACT_QA_BYTES", "_SUCCESSOR_ATTESTATION_MAX_BYTES_SCHEMA3"):
        return [("typed_bound", value + 1), ("bool_type", True), ("float_type", float(value))]
    raise AssertionError("unknown source-derived schema3 policy")

def repack_exact_policy(value):
    """Copy genuine immutable containers with identical type and value."""
    if type(value) is types.MappingProxyType:
        return types.MappingProxyType({key: repack_exact_policy(value[key])
                                      for key in reversed(tuple(value))})
    if type(value) is tuple:
        return tuple(repack_exact_policy(item) for item in value)
    if type(value) is frozenset:
        return frozenset(reversed(sorted(value)))
    return value

class RawConsumerGuardRegressions(unittest.TestCase):
    def test_valid_fresh_and_reuse_keep_one_real_raw_module(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            with self.subTest(role=role), guard_fixture(role) as (module, load, _, _, _):
                self.assertIs(load(), module)
                module._OBSERVED_WORKTREES["synthetic-registry-content-control"] = {}
                self.assertIs(load(), module)

    def test_initializer_generator_has_no_global_slot_but_afterimages_remain_guarded(self):
        raw = RAW.read_bytes()
        top_code = compile(raw, str(RAW), "exec", dont_inherit=True, optimize=0)
        generated = [code for code in top_code.co_consts
                     if type(code) is types.CodeType and code.co_name == "<genexpr>"]
        self.assertEqual(len(generated), 1)
        self.assertTrue(generated[0].co_flags & 0x02)
        self.assertTrue(generated[0].co_flags & 0x20)
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with self.subTest(role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, Refused, _):
                    self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                    self.assertNotIn("<genexpr>", module.__dict__)
                    original = module._SUCCESSOR_INTERMEDIATE_AFTERIMAGES
                    self.assertIs(type(original), tuple)
                    self.assertEqual(len(original), 9)
                    self.assertTrue(all(type(row) is types.MappingProxyType for row in original))
                    if reuse:
                        self.assertIs(load(), module)
                    changed = dict(original[0])
                    changed["sha256"] = "f" * 64
                    replacement = (types.MappingProxyType(changed), *original[1:])
                    try:
                        module._SUCCESSOR_INTERMEDIATE_AFTERIMAGES = replacement
                        with self.assertRaisesRegex(Refused, "policy differs from pinned source|identity or API changed"):
                            load()
                    finally:
                        module._SUCCESSOR_INTERMEDIATE_AFTERIMAGES = original
                    self.assertIs(load(), module)
                    self.assertIs(load(), module)

    def test_named_class_namespace_and_property_method_state_refuse_and_restore(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                for damage in ("class_binding", "class_namespace", "property_descriptor", "method_code",
                               "method_defaults", "method_kwdefaults", "method_annotations"):
                    with self.subTest(role=role, reuse=reuse, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):
                        self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                        if reuse:
                            self.assertIs(load(), module)
                        owner = module.SuccessorAdmissionContext
                        descriptor = owner.__dict__["admission_binding"]
                        method = descriptor.fget
                        original = (method.__code__, method.__defaults__, method.__kwdefaults__, method.__annotations__)
                        try:
                            if damage == "class_binding":
                                module.SuccessorAdmissionContext = type("SuccessorAdmissionContext", (), {"__module__": RAW_NAME})
                            elif damage == "class_namespace":
                                owner.unreviewed_policy_slot = True
                            elif damage == "property_descriptor":
                                owner.admission_binding = property(lambda self: {})
                            elif damage == "method_code":
                                method.__code__ = (lambda self: {}).__code__
                            elif damage == "method_defaults":
                                method.__defaults__ = ({"unreviewed": [1]},)
                            elif damage == "method_kwdefaults":
                                method.__kwdefaults__ = {"unreviewed": [1]}
                            else:
                                method.__annotations__ = {"unreviewed": "changed"}
                            with self.assertRaisesRegex(Refused, "class namespace differs|method differs from pinned source|method defaults differ|identity or API changed"):
                                load()
                        finally:
                            module.SuccessorAdmissionContext = owner
                            if damage == "class_namespace":
                                del owner.unreviewed_policy_slot
                            owner.admission_binding = descriptor
                            method.__code__, method.__defaults__, method.__kwdefaults__, method.__annotations__ = original
                        self.assertIs(load(), module)
                        self.assertIs(load(), module)

    def test_all_sixteen_new_policies_refuse_before_first_acceptance_and_reuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with guard_fixture(role) as (_, _, _, _, bindings):
                    policies = bindings["new_policy_names"]
                self.assertEqual(len(policies), 16)
                for name in policies:
                    with self.subTest(role=role, reuse=reuse, name=name), guard_fixture(role) as (module, load, namespace, Refused, _):
                        self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                        if reuse:
                            self.assertIs(load(), module)
                        original = module.__dict__[name]
                        try:
                            module.__dict__[name] = object()
                            with self.assertRaisesRegex(Refused, "unsupported policy/default value"):
                                load()
                        finally:
                            module.__dict__[name] = original
                        self.assertIs(load(), module)
                        self.assertIs(load(), module)

    def test_new_helper_code_defaults_and_kwdefaults_refuse_cold_and_reuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with guard_fixture(role) as (_, _, _, _, bindings):
                    helpers = bindings["new_helper_names"]
                self.assertEqual(len(helpers), 3)
                for name in helpers:
                    for damage in ("code", "defaults", "kwdefaults", "annotations"):
                        with self.subTest(role=role, reuse=reuse, name=name, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):
                            self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                            if reuse:
                                self.assertIs(load(), module)
                            function = module.__dict__[name]
                            original = (function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__)
                            try:
                                if damage == "code":
                                    function.__code__ = (lambda: None).__code__
                                elif damage == "defaults":
                                    function.__defaults__ = ({"unreviewed": [1]},)
                                elif damage == "kwdefaults":
                                    function.__kwdefaults__ = {"unreviewed": {"nested": [1]}}
                                else:
                                    function.__annotations__ = {"unreviewed": "changed"}
                                with self.assertRaisesRegex(Refused, "API differs from pinned source|identity or API changed"):
                                    load()
                            finally:
                                function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__ = original
                            self.assertIs(load(), module)
                            self.assertIs(load(), module)

    def test_base64_and_binascii_import_rebindings_refuse_cold_and_reuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                for name in ("base64", "binascii"):
                    with self.subTest(role=role, reuse=reuse, name=name), guard_fixture(role) as (module, load, namespace, Refused, _):
                        self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                        if reuse:
                            self.assertIs(load(), module)
                        original = module.__dict__[name]
                        try:
                            module.__dict__[name] = types.ModuleType("foreign_binding")
                            with self.assertRaisesRegex(Refused, "imported binding differs|identity or API changed"):
                                load()
                        finally:
                            module.__dict__[name] = original
                        self.assertIs(load(), module)
                        self.assertIs(load(), module)

    def test_guarded_module_function_rebinding_and_foreign_globals_refuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                for damage in ("replacement", "foreign_globals"):
                    with self.subTest(role=role, reuse=reuse, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, bindings):
                        self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                        if reuse:
                            self.assertIs(load(), module)
                        name = bindings["new_helper_names"][0]
                        original = module.__dict__[name]
                        try:
                            if damage == "replacement":
                                module.__dict__[name] = lambda: None
                            else:
                                module.__dict__[name] = types.FunctionType(original.__code__, dict(module.__dict__),
                                                                          original.__name__, original.__defaults__)
                            with self.assertRaisesRegex(Refused, "API differs from pinned source|identity or API changed"):
                                load()
                        finally:
                            module.__dict__[name] = original
                        self.assertIs(load(), module)
                        self.assertIs(load(), module)

    def test_source_byte_change_refuses_on_guarded_reuse(self):
        with tempfile.TemporaryDirectory() as directory:
            altered = Path(directory) / "raw.py"
            raw = RAW.read_bytes()
            altered.write_bytes(raw)
            with guard_fixture("worker") as (module, _, namespace, Refused, bindings):
                namespace["RAW_AUTHORITY_HELPER"] = altered
                module = module_from_bytes(altered, raw)
                self.assertIs(namespace["_load_raw_authority_module"](), module)
                altered.write_bytes(raw + b"\n# changed after verified reuse\n")
                with self.assertRaisesRegex(Refused, "disk SHA256 differs"):
                    namespace["_load_raw_authority_module"]()
                altered.write_bytes(raw)
                self.assertIs(namespace["_load_raw_authority_module"](), module)

    def test_worker_cap_equal_limit_accepts_but_limit_plus_one_refuses_before_open_or_hash(self):
        with guard_fixture("worker") as (_, _, namespace, Refused, _), tempfile.TemporaryDirectory() as directory:
            read = namespace["_read_successor_input"]
            path = Path(directory) / "attestation.json"
            path.write_bytes(b"a" * 17)
            self.assertEqual(read(path, what="synthetic twin", maximum_bytes=17), b"a" * 17)
            path.write_bytes(b"a" * 18)
            with mock.patch.object(Path, "open", side_effect=AssertionError("overflow opened")), mock.patch.dict(namespace, {"_sha_bytes": lambda _: (_ for _ in ()).throw(AssertionError("overflow hashed"))}):
                with self.assertRaises(Refused):
                    read(path, what="synthetic twin", maximum_bytes=17)
            path.write_bytes(b"a" * 17)
            self.assertEqual(read(path, what="synthetic twin", maximum_bytes=17), b"a" * 17)

    def test_worker_bad_bounds_refuse_before_open(self):
        with guard_fixture("worker") as (_, _, namespace, Refused, _), tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "attestation.twin.json"
            path.write_bytes(b"x")
            for bound in (True, False, 0, -1, 1.5, "1"):
                with self.subTest(bound=bound), mock.patch.object(Path, "open", side_effect=AssertionError("invalid bound opened")):
                    with self.assertRaises(Refused):
                        namespace["_read_successor_input"](path, what="synthetic twin", maximum_bytes=bound)
            self.assertEqual(namespace["_read_successor_input"](path, what="restored valid bound", maximum_bytes=1), b"x")

    def test_worker_opened_descriptor_overflow_refuses_before_read_or_hash(self):
        with guard_fixture("worker") as (_, _, namespace, Refused, _), tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "attestation.json"
            path.write_bytes(b"x" * 17)
            stream = path.open("rb")
            class Opened:
                def __enter__(self):
                    return self
                def __exit__(self, *args):
                    stream.close()
                def fileno(self):
                    return stream.fileno()
                def read(self, *_):
                    raise AssertionError("descriptor overflow read")
            with mock.patch.object(Path, "open", return_value=Opened()), mock.patch.object(os, "fstat", return_value=types.SimpleNamespace(st_size=18)), mock.patch.dict(namespace, {"_sha_bytes": lambda _: (_ for _ in ()).throw(AssertionError("descriptor overflow hashed"))}):
                with self.assertRaises(Refused):
                    namespace["_read_successor_input"](path, what="synthetic twin", maximum_bytes=17)
            self.assertEqual(namespace["_read_successor_input"](path, what="restored descriptor control", maximum_bytes=17), b"x" * 17)

    def test_worker_second_bounded_observation_refuses_growth_without_unbounded_hash(self):
        with guard_fixture("worker") as (_, _, namespace, Refused, _), tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "attestation.twin.json"
            path.write_bytes(b"x" * 17)
            original = namespace["_capture_bound_successor_input"]
            calls = []
            def capture(*args, **kwargs):
                calls.append(kwargs["maximum_bytes"])
                if len(calls) == 2:
                    path.write_bytes(b"x" * 18)
                return original(*args, **kwargs)
            with mock.patch.dict(namespace, {"_capture_bound_successor_input": capture,
                                             "_sha_file": lambda _: (_ for _ in ()).throw(AssertionError("unbounded hash used"))}):
                with self.assertRaises(Refused):
                    namespace["_read_successor_input"](path, what="synthetic twin", maximum_bytes=17)
            self.assertEqual(calls, [17, 17])
            path.write_bytes(b"x" * 17)
            self.assertEqual(namespace["_read_successor_input"](path, what="restored second observation", maximum_bytes=17), b"x" * 17)

    def test_controller_and_worker_cap_policy_mutation_refuses_on_same_module_reuse(self):
        for role in ("controller", "worker"):
            for damage in (True, 395800, None):
                with self.subTest(role=role, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):
                    self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                    self.assertIs(load(), module)
                    original = module.SUCCESSOR_ADMISSION_MAX_BYTES
                    try:
                        module.SUCCESSOR_ADMISSION_MAX_BYTES = damage
                        with self.assertRaisesRegex(Refused, "identity or API changed"):
                            load()
                    finally:
                        module.SUCCESSOR_ADMISSION_MAX_BYTES = original
                    self.assertIs(load(), module)
                    self.assertIs(load(), module)

    def test_worker_postproof_transport_reuses_captured_bound_and_refuses_callback_growth(self):
        # Context/gate/records are explicit framing doubles. This exercises the actual
        # worker transport and bounded reader, not real raw admission or native proof.
        for damage in (None, "changed_bound", "bool_bound", "grown_twin"):
            with self.subTest(damage=damage), guard_fixture("worker") as (_, _, namespace, Refused, bindings), tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                evidence = root / "synthetic-evidence"
                records = root / "synthetic-records"
                evidence.mkdir(); records.mkdir()
                for name in ("attestation.json", "attestation.twin.json", "predecessor-release.json", "successor-release.json", "predecessor-candidate-manifest.json", "successor-candidate-manifest.json", "current-native-release-receipt.txt"):
                    (evidence / name).write_bytes(b"x" * 17 if name.startswith("attestation.") else b"synthetic")
                for name in ("incident", "terminal"):
                    (records / name).write_bytes(name.encode("ascii"))
                incident = {"record_digest": "incident-seal", "inventory_digest": "inventory-seal"}
                terminal = {"record_digest": "terminal-seal"}
                incident_sha, terminal_sha = digest(b"incident"), digest(b"terminal")
                pin = "a" * 64
                authority = {"preimport_authority_record": {"native_startup": {"successor_admission_sha256": pin}},
                             "preimport_authority": {"successor_admission_sha256": pin}}
                expected = {"file_sha256": pin}
                invocation = {"authority": authority, "historical_admission": expected,
                              "incident": {"record_digest": incident["record_digest"], "file_sha256": incident_sha, "inventory_digest": incident["inventory_digest"]},
                              "epoch001_terminal": {"record_digest": terminal["record_digest"], "file_sha256": terminal_sha}}
                context = types.SimpleNamespace(admission_binding=expected, historical_incident_sha256=incident_sha,
                    historical_terminal_sha256=terminal_sha, historical_incident=incident,
                    historical_terminal=terminal, operating_authority=authority)
                fake_raw = types.SimpleNamespace(SUCCESSOR_ADMISSION_MAX_BYTES=17, AuthorityRefused=ValueError)
                seen = []
                real_read = namespace["_read_successor_input"]
                def read(path, *, what, maximum_bytes=None):
                    seen.append((path.name, maximum_bytes))
                    return real_read(path, what=what, maximum_bytes=maximum_bytes)
                def admit(**kwargs):
                    self.assertEqual(len(kwargs), 12)
                    self.assertEqual(kwargs["expected_attestation_sha256"], pin)
                    if damage == "changed_bound":
                        fake_raw.SUCCESSOR_ADMISSION_MAX_BYTES = 18
                    elif damage == "bool_bound":
                        fake_raw.SUCCESSOR_ADMISSION_MAX_BYTES = True
                    elif damage == "grown_twin":
                        (evidence / "attestation.twin.json").write_bytes(b"x" * 18)
                    return context
                fake_raw.admit_recorded_predecessor = admit
                namespace.update({"WORKSPACE_ROOT": root, "SUCCESSOR_EVIDENCE_DIRECTORY": evidence.name,
                    "INCIDENT_FILE": "incident", "EPOCH001_TERMINAL_FILE": "terminal",
                    "_validate_authority": lambda value: value, "_binding": lambda value, **_: value,
                    "_load_record": lambda name, **_: (incident, incident_sha) if name == "incident" else (terminal, terminal_sha),
                    "_record_paths": lambda name: (records / name, records / (name + ".twin")),
                    "_same_bytes": lambda *_, what: incident_sha if what == "incident" else terminal_sha,
                    "_canonical": lambda value: json.dumps(value, sort_keys=True),
                    "_load_raw_authority_module": lambda: fake_raw, "_read_successor_input": read})
                source = (PREP / bindings["consumers"]["worker"]["path"]).read_bytes()
                exec(compile(selected(source, {"_validate_historical_admission"}), "selected_worker_transport", "exec", dont_inherit=True), namespace)
                if damage is None:
                    self.assertIs(namespace["_validate_historical_admission"](invocation), context)
                    self.assertEqual([bound for name, bound in seen if name.startswith("attestation.")], [17, 17, 17, 17])
                    self.assertTrue(all(bound is None for name, bound in seen if not name.startswith("attestation.")))
                else:
                    with self.assertRaises(Refused):
                        namespace["_validate_historical_admission"](invocation)
                    if damage in ("changed_bound", "bool_bound"):
                        self.assertEqual(len(seen), 9)  # Two old records plus seven initial inputs; no post-proof reread.
                    fake_raw.SUCCESSOR_ADMISSION_MAX_BYTES = 17
                    (evidence / "attestation.twin.json").write_bytes(b"x" * 17)
                    damage = None
                    restored_seen_start = len(seen)
                    self.assertIs(namespace["_validate_historical_admission"](invocation), context)
                    self.assertEqual([bound for name, bound in seen[restored_seen_start:] if name.startswith("attestation.")], [17, 17, 17, 17])


    def test_all_eleven_schema3_policy_values_refuse_typed_changes_cold_and_reuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with guard_fixture(role) as (_, _, _, _, bindings):
                    policies = bindings["schema3_policy_names"]
                self.assertEqual(len(policies), 11)
                for name in policies:
                    with guard_fixture(role) as (module, _, _, _, _):
                        cases = schema3_policy_changes(name, module.__dict__[name])
                    self.assertTrue(cases)
                    for damage, replacement in cases:
                        with self.subTest(role=role, reuse=reuse, name=name, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):
                            self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                            if reuse:
                                self.assertIs(load(), module)
                            original = module.__dict__[name]
                            try:
                                module.__dict__[name] = replacement
                                with self.assertRaisesRegex(Refused, "policy differs from pinned source|identity or API changed"):
                                    load()
                            finally:
                                module.__dict__[name] = original
                            self.assertIs(load(), module)
                            self.assertIs(load(), module)

    def test_schema3_genuine_container_copies_and_mapping_order_remain_accepted(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                for name in ("SUCCESSOR_COMPACT_INTERMEDIATE_FACTS", "_SUCCESSOR_COMPACT_AFTERIMAGES",
                             "_SUCCESSOR_COMPACT_PROOF_LIMITS", "_SUCCESSOR_COMPACT_RELEASE_KEYS"):
                    with self.subTest(role=role, reuse=reuse, name=name), guard_fixture(role) as (module, load, namespace, _, _):
                        self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                        if reuse:
                            self.assertIs(load(), module)
                        original = module.__dict__[name]
                        # Genuine dict/proxy values both reach the real fingerprint branch.
                        row = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS[0]
                        identity = namespace["_raw_helper_value_identity"]
                        copied_dict = dict(row)
                        reversed_dict = dict(reversed(tuple(row.items())))
                        self.assertEqual(identity(copied_dict), identity(reversed_dict))
                        self.assertEqual(identity(row), identity(types.MappingProxyType(copied_dict)))
                        self.assertNotEqual(identity(copied_dict), identity(row))
                        try:
                            replacement = repack_exact_policy(original)
                            self.assertIsNot(replacement, original)
                            module.__dict__[name] = replacement
                            self.assertIs(load(), module)
                            self.assertIs(load(), module)
                        finally:
                            module.__dict__[name] = original
                        self.assertIs(load(), module)

    def test_mapping_proxy_class_name_spoof_refuses_before_user_mapping_methods(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with self.subTest(role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, Refused, _):
                    self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                    if reuse:
                        self.assertIs(load(), module)
                    original = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS
                    row = original[0]
                    seen = []
                    class ForeignMapping(Mapping):
                        def __getitem__(self, key):
                            seen.append("getitem")
                            return row[key]
                        def __iter__(self):
                            seen.append("iter")
                            return iter(row)
                        def __len__(self):
                            seen.append("len")
                            return len(row)
                        def items(self):
                            seen.append("items")
                            return row.items()
                    ForeignMapping.__name__ = "mappingproxy"
                    ForeignMapping.__module__ = type(row).__module__
                    replacement = ForeignMapping()
                    self.assertEqual(type(replacement).__name__, type(row).__name__)
                    self.assertEqual(type(replacement).__module__, type(row).__module__)
                    self.assertIsNot(type(replacement), types.MappingProxyType)
                    try:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = (replacement, original[1])
                        with self.assertRaisesRegex(Refused, "unsupported policy/default value"):
                            load()
                        self.assertEqual(seen, [], "foreign mapping method ran before exact-type refusal")
                    finally:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = original
                    self.assertIs(load(), module)
                    self.assertIs(load(), module)

