    def test_all_four_schema3_helpers_code_globals_defaults_refuse_cold_and_reuse(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with guard_fixture(role) as (_, _, _, _, bindings):
                    helpers = bindings["schema3_helper_names"]
                self.assertEqual(len(helpers), 4)
                for name in helpers:
                    for damage in ("code", "defaults", "kwdefaults", "annotations", "replacement", "foreign_globals"):
                        with self.subTest(role=role, reuse=reuse, name=name, damage=damage), guard_fixture(role) as (module, load, namespace, Refused, _):
                            self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                            if reuse:
                                self.assertIs(load(), module)
                            function = module.__dict__[name]
                            original = (function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__)
                            try:
                                if damage == "code":
                                    function.__code__ = (lambda *args, **kwargs: b"unreviewed").__code__
                                elif damage == "defaults":
                                    function.__defaults__ = ({"reviewed": ("changed", 1)},)
                                elif damage == "kwdefaults":
                                    function.__kwdefaults__ = {"reviewed": {"changed": [1]}}
                                elif damage == "annotations":
                                    function.__annotations__ = {"reviewed": "changed"}
                                elif damage == "replacement":
                                    module.__dict__[name] = lambda *args, **kwargs: b"unreviewed"
                                else:
                                    foreign = types.FunctionType(function.__code__, dict(module.__dict__),
                                                                 function.__name__, function.__defaults__)
                                    foreign.__kwdefaults__ = None if function.__kwdefaults__ is None else dict(function.__kwdefaults__)
                                    foreign.__annotations__ = dict(function.__annotations__)
                                    module.__dict__[name] = foreign
                                with self.assertRaisesRegex(Refused, "API differs from pinned source|identity or API changed"):
                                    load()
                            finally:
                                module.__dict__[name] = function
                                function.__code__, function.__defaults__, function.__kwdefaults__, function.__annotations__ = original
                            self.assertIs(load(), module)
                            self.assertIs(load(), module)



def metaclass_spoof_row(case, row, frozen_rows, seen):
    """Separate instances and logs distinguish callback setup from guarded use."""
    if case not in ("M1", "M2", "M3", "M4"):
        raise AssertionError("unknown finite metaclass case")
    class SpoofMeta(type(Mapping)):
        __hash__ = type.__hash__
        def __eq__(cls, other):
            seen.append(("type_equality", getattr(other, "__name__", None)))
            if case == "M1":
                return other is dict or other is types.MappingProxyType
            if case in ("M2", "M3"):
                return other is int
            return other is tuple
    class ForeignMapping(Mapping, metaclass=SpoofMeta):
        def __getitem__(self, key):
            seen.append(("getitem", key))
            return row[key]
        def __iter__(self):
            seen.append(("iter", None))
            return iter(row)
        def __len__(self):
            seen.append(("len", None))
            return len(row)
        def items(self):
            seen.append(("items", None))
            return row.items()
        def __eq__(self, other):
            seen.append(("value_equality", type(other).__name__))
            if case == "M3":
                return type(other) is tuple and other == frozen_rows
            return Mapping.__eq__(self, other)
    ForeignMapping.__name__ = type(row).__name__
    ForeignMapping.__module__ = type(row).__module__
    return ForeignMapping()


class RawConsumerMetaclassIdentityRegressions(unittest.TestCase):
    def assert_metaclass_case_refused(self, case):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with self.subTest(case=case, role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, Refused, _):
                    self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                    if reuse:
                        self.assertIs(load(), module)
                    original = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS
                    row = original[0]
                    identity = namespace["_raw_helper_value_identity"]
                    frozen_rows = identity(row)[1]
                    self.assertEqual(identity(row), identity(types.MappingProxyType(dict(row))))
                    # Prove the same finite equality mechanism with a SEPARATE
                    # object/log. It never enters the raw module or guard cache.
                    probe_seen = []
                    probe = metaclass_spoof_row(case, row, frozen_rows, probe_seen)
                    self.assertEqual(probe_seen, [], "fixture construction invoked a user callback")
                    target = dict if case == "M1" else tuple if case == "M4" else int
                    self.assertTrue(type(probe) == target)
                    self.assertEqual(probe_seen, [("type_equality", target.__name__)])
                    if case == "M3":
                        # This is the exact genuine normalized mapping-row value
                        # to which the old primitive branch's foreign value could
                        # compare equal. No raw/guard callback is substituted.
                        self.assertTrue(probe == frozen_rows)
                        self.assertEqual(probe_seen[-1], ("value_equality", "tuple"))
                    seen = []
                    replacement = metaclass_spoof_row(case, row, frozen_rows, seen)
                    self.assertEqual(seen, [], "mutation fixture setup invoked a user callback")
                    self.assertEqual(type(replacement).__name__, type(row).__name__)
                    self.assertEqual(type(replacement).__module__, type(row).__module__)
                    self.assertIsNot(type(replacement), types.MappingProxyType)
                    try:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = (replacement, original[1])
                        with self.assertRaisesRegex(Refused, "unsupported policy/default value"):
                            load()
                        self.assertEqual(seen, [], "foreign type/value/mapping callback preceded identity refusal")
                    finally:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = original
                    self.assertIs(load(), module)
                    self.assertIs(load(), module)

    def test_m1_mapping_selective_metaclass_refuses_cold_and_reuse_without_callbacks(self):
        self.assert_metaclass_case_refused("M1")

    def test_m2_primitive_selective_metaclass_refuses_cold_and_reuse_without_callbacks(self):
        self.assert_metaclass_case_refused("M2")

    def test_m3_primitive_and_value_equality_metaclass_refuses_cold_and_reuse_without_callbacks(self):
        self.assert_metaclass_case_refused("M3")

    def test_m4_sequence_selective_metaclass_refuses_cold_and_reuse_without_callbacks(self):
        self.assert_metaclass_case_refused("M4")

    def test_genuine_builtin_fingerprints_keep_types_order_and_cold_reuse_acceptance(self):
        for role in ("controller", "worker", "entrypoint", "fit_child", "inspector"):
            for reuse in (False, True):
                with self.subTest(role=role, reuse=reuse), guard_fixture(role) as (module, load, namespace, _, _):
                    self.assertEqual(namespace["_GUARD_HEALTHY_CONTROL_CALLS"], 2)
                    if reuse:
                        self.assertIs(load(), module)
                    identity = namespace["_raw_helper_value_identity"]
                    genuine = (None, False, 7, 1.25, "reviewed", b"reviewed",
                               {"b": 2, "a": 1}, types.MappingProxyType({"b": 2, "a": 1}),
                               (2, 1), [2, 1], {2, 1}, frozenset((2, 1)))
                    for value in genuine:
                        fingerprint = identity(value)
                        self.assertIs(type(fingerprint), tuple)
                        expected_kind = "NoneType" if value is None else type(value).__name__
                        self.assertEqual(fingerprint[0], expected_kind)
                    self.assertEqual(identity({"b": 2, "a": 1}), identity({"a": 1, "b": 2}))
                    self.assertEqual(identity(types.MappingProxyType({"b": 2, "a": 1})),
                                     identity(types.MappingProxyType({"a": 1, "b": 2})))
                    self.assertNotEqual(identity({"a": 1}), identity(types.MappingProxyType({"a": 1})))
                    self.assertNotEqual(identity((2, 1)), identity((1, 2)))
                    self.assertNotEqual(identity((2, 1)), identity([2, 1]))
                    self.assertEqual(identity({2, 1}), identity({1, 2}))
                    self.assertEqual(identity(frozenset((2, 1))), identity(frozenset((1, 2))))
                    self.assertNotEqual(identity({1, 2}), identity(frozenset((1, 2))))
                    original = module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS
                    try:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = repack_exact_policy(original)
                        self.assertIs(load(), module)
                        self.assertIs(load(), module)
                    finally:
                        module.SUCCESSOR_COMPACT_INTERMEDIATE_FACTS = original
                    self.assertIs(load(), module)
                    self.assertIs(load(), module)

