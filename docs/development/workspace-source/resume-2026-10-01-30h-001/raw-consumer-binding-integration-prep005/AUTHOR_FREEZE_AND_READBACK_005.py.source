def sha(x):return hashlib.sha256(x).hexdigest()
def create(name,v):
 path=R/name
 x=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+"\n").encode("ascii")
 with path.open("xb")as f:f.write(x)
 assert read(path,sha(x),len(x))==x
 return sha(x),len(x)
