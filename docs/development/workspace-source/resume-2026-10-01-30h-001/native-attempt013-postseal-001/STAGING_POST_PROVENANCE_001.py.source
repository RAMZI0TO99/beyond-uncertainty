"""Create-once static provenance supplement; no helper/import/native execution."""
import hashlib,json,os,stat
from datetime import datetime,timezone
from pathlib import Path
ROOT=Path(__file__).parent
SESSION=ROOT.parent
FRONT=SESSION/'native-attempt013-front-001'
sources=[FRONT/'INDEPENDENT_NATIVE_FRONT_STATIC_REVIEW_001.json',
         FRONT/'INDEPENDENT_NATIVE_FRONT_STATIC_REVIEW_001.md',
         SESSION/'WIN_STAT_EXE_AND_VERIFIER_TOPOLOGY_WITNESS_001.json']
rows=[]
for source in sources:
    first=source.lstat();data=source.read_bytes();last=source.lstat()
    identify=lambda s:(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,int(getattr(s,'st_file_attributes',0)))
    assert stat.S_ISREG(first.st_mode) and first.st_nlink==1 and not getattr(first,'st_file_attributes',0)&0x400
    assert identify(first)==identify(last) and len(data)==first.st_size
    destination=ROOT/'before'/('front-refusal-'+source.name)
    with destination.open('xb') as file:file.write(data)
    assert destination.read_bytes()==data
    rows.append({'source_path':str(source),'retained_path':str(destination.relative_to(ROOT)).replace('\\','/'),
                 'sha256':hashlib.sha256(data).hexdigest(),'size':len(data),'source_identity':list(identify(last))})
document={'schema_version':1,'record_type':'postseal_front001_refusal_lineage_reference',
          'created_at_utc':datetime.now(timezone.utc).isoformat(),'files':rows,
          'front001_defects':['NF001_windows_executable_path_descriptor_mode_projection','NF002_owned_venv_parent_self_only_quiet_refusal'],
          'front001_imported_or_executed':False,'front001_modified':False,'production_or_historical_evidence_modified':False,
          'future_final_front_sha256':None,'future_current_release':'release-009-proposal018',
          'attempt013_collision_independent_review_required':True}
with (ROOT/'FRONT001_REFUSAL_REFERENCE_001.json').open('xb') as file:
    file.write((json.dumps(document,sort_keys=True,separators=(',',':'),ensure_ascii=True)+'\n').encode('ascii'))
print('Frozen front001 refusal and witness retained exactly; no current readiness/authority implied.')
