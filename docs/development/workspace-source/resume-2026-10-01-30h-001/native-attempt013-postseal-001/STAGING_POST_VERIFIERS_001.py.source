"""Stdlib staging-only generator; no generated helper or project import."""
import ast,json
from pathlib import Path

ROOT=Path(__file__).parent
BEFORE=ROOT/'before'
F=json.loads((BEFORE/'front-native_successor_front_common_013_001.py.template').read_text(encoding='utf-8').split('BINDING_SCHEMA = json.loads(')[1].split('\n',1)[0][:-1]) if False else json.loads((ROOT.parent/'native-attempt013-front-001'/'FRONT_BINDINGS_UNBOUND_001.json').read_bytes())
assert len(F)==40 and all(value is None for value in F.values())
HEADER='''
from __future__ import annotations
import argparse,base64,hashlib,importlib.machinery,importlib.util,json,os,re,shutil,stat,sys,types
from datetime import datetime,timedelta,timezone
from pathlib import Path
PROJECT=Path('D:/Aenv/pro2')
SESSION=PROJECT/'resume-2026-10-01-30h-001/native-attempt013-postseal-001'
FRONT_SESSION=PROJECT/'resume-2026-10-01-30h-001/native-attempt013-front-001'
ATTEMPT=PROJECT/'.tmp/week8-d168-release-attempt-013'
FRONT_HELPER_SHA256=None
POST_COMMON_SHA256=None
FRONT_BINDINGS=json.loads(FRONT_BINDINGS_LITERAL)
PRIOR_VERDICT_SHA256=None
PHASE_EVIDENCE_SHA256=None
PRE_RECOVER_EVIDENCE_SHA256=None
STDOUT_SHA256=None
STDOUT_BYTES=None
STDERR_SHA256=None
AUDIT_SHA256=None
INTENT_SHA256=None

def load_context():
    parser=argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--expected-script-sha256',required=True)
    args=parser.parse_args()
    if not (sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode):
        raise ValueError('downstream requires pinned Python -I -S -B')
    if not re.fullmatch(r'[0-9a-f]{64}',args.expected_script_sha256 or ''):
        raise ValueError('downstream expected self SHA malformed')
    if hashlib.sha256(Path(__file__).read_bytes()).hexdigest()!=args.expected_script_sha256:
        raise ValueError('reviewed downstream verifier source differs')
    if not (type(POST_COMMON_SHA256) is str and re.fullmatch(r'[0-9a-f]{64}',POST_COMMON_SHA256)
            and type(FRONT_HELPER_SHA256) is str and re.fullmatch(r'[0-9a-f]{64}',FRONT_HELPER_SHA256)):
        raise ValueError('final postseal/front source pins unbound')
    path=SESSION/'native_successor_postseal_common_013_001.py'
    for component in reversed((path,*path.parents)):
        info=component.lstat()
        if (stat.S_ISLNK(info.st_mode) or int(getattr(info,'st_file_attributes',0))&0x400
            or (component==path and (not stat.S_ISREG(info.st_mode) or info.st_nlink!=1))
            or (component!=path and not stat.S_ISDIR(info.st_mode))):
            raise ValueError('downstream helper topology differs')
    source=path.read_bytes()
    if hashlib.sha256(source).hexdigest()!=POST_COMMON_SHA256:
        raise ValueError('captured downstream helper hash differs')
    name='_attempt013_verified_postseal_policy'
    if name in sys.modules:raise ValueError('downstream helper namespace occupied')
    loader=importlib.machinery.SourceFileLoader(name,str(path))
    spec=importlib.util.spec_from_loader(name,loader)
    if spec is None:raise ValueError('downstream helper specification absent')
    Q=importlib.util.module_from_spec(spec);sys.modules[name]=Q
    exec(compile(source,str(path),'exec',dont_inherit=True),Q.__dict__)
    C=Q.load_front(FRONT_HELPER_SHA256)
    C.read(path,POST_COMMON_SHA256);C.read(Path(__file__).absolute(),args.expected_script_sha256)
    C.checked_bindings(FRONT_BINDINGS,receipt_only=False)
    return Q,C,FRONT_BINDINGS
'''
HEADER=HEADER.replace('FRONT_BINDINGS_LITERAL',repr(json.dumps(F,sort_keys=True,separators=(',',':'))))

def write(name,text):
    ast.parse(text)
    with (ROOT/name).open('xb') as file:file.write(text.encode('utf-8'))

def nodes(source,names):
    tree=ast.parse(source)
    return '\n\n'.join(ast.get_source_segment(source,n) for n in tree.body
                       if isinstance(n,ast.FunctionDef) and n.name in names)

def statements(source,function='main'):
    tree=ast.parse(source)
    node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name==function)
    return node,source.splitlines(keepends=True)

def slice_statements(source,start,end):
    assert source.count(start)==1 and source.count(end)==1
    return source[source.index(start):source.index(end)]

# Preserve the complete original pre-seal mechanical body after admission;
# release/readiness/owner admission is now supplied by the reviewed common.
src=(BEFORE/'verify-recovery-evidence-before-seal-011-window-oct02-001.py.template').read_text(encoding='utf-8')
body=slice_statements(src,'    witness: dict[str, str] = {}','    require_preseal_reserve()\n    digest =')
body=body.replace('== CONTROLLER_COMMIT\n              and terminal["incident"]',"== C.PROGRAMMATIC_FACTS['predecessor']['controller_commit']\n              and terminal[\"incident\"]")
body=body.replace('"pro2_native_phase_evidence_v1"','"pro2_native_phase_evidence_v2"')
body=body.replace('    require_preseal_reserve()\n','    C.owner({},45)\n')
pre='''
def main():
    global E
    Q,C,F=load_context()
    C.boundary(F,reserve=45)
    E,invocation,context=Q.operating(C,F)
    C.absent(Q.phase_path('pre_seal'))
    prior=Q.checked_record(C,F,C.verdict_path('recover'),PRIOR_VERDICT_SHA256)
    pre=C.validate_pre_recover_verdict(PRE_RECOVER_EVIDENCE_SHA256,F,reobserve=False)
    E.require(prior['phase_evidence_sha256']==PRE_RECOVER_EVIDENCE_SHA256,'recover/pre-recover chain differs')
    raw,attempt_hashes,native_witness=Q.observed_files(C,Q.file_names(C,'recover'))
    response=Q.checked_response(C,'recover',STDOUT_SHA256,STDOUT_BYTES)
    E.require(prior['result']==response and attempt_hashes==prior['attempt_file_sha256'],
              'recover verified binary/native inventory differs')
    CONTROLLER_COMMIT=F['controller_commit'];RECEIPT_SHA256=F['receipt_sha256']
    OWNER_RECORD_SHA256=C.PROGRAMMATIC_FACTS['owner_sha256']
    RECOVER_VERDICT_SHA256=PRIOR_VERDICT_SHA256
'''+body+'''
    def late():
        C.repeat(native_witness)
        E.require(E.file_identity_witness(witness)==file_identity
                  and E.phase_directory_witness('pre_seal',witness)==directory_map
                  and E.runtime_temp_identity()==runtime_identity,'pre-seal witness changed at publication')
        for value in absent_paths:E.absent(Path(value))
        E.old_processes_dead_twice();Q.operating(C,F)
    digest=Q.publish(C,F,Q.phase_path('pre_seal'),verdict,reserve=45,final_check=late)
    print('recovery_evidence_before_seal_sha256='+digest)

if __name__=='__main__':main()
'''
write('verify-recovery-evidence-before-seal-013-window30h-001.py.template',HEADER+pre)

# Preserve independent reconstruction of completion and launch exactly, with
# the operating current commit supplied explicitly rather than incident commit.
src=(BEFORE/'verify-sealed-recovery-evidence-011-window-oct02-001.py.template').read_text(encoding='utf-8')
function=nodes(src,{'completion_and_launch'})
body=slice_statements(src,'    witness: dict[str, str] = {}','    E.require(datetime.now(timezone.utc)\n              < datetime(2026, 10, 2, 8, 0, tzinfo=timezone.utc)\n              and shutil.disk_usage(E.PROJECT).free >= 8 * 1024**3,\n              "owner work window or 8 GiB D: floor expired")\n    verdict =')
verdict=slice_statements(src,'    verdict = {','    E.require(datetime.now(timezone.utc)\n              < datetime(2026, 10, 2, 8, 0, tzinfo=timezone.utc)\n              and shutil.disk_usage(E.PROJECT).free >= 8 * 1024**3,\n              "owner work window or 8 GiB D: floor expired before verdict")')
verdict=verdict.replace('"pro2_native_phase_evidence_v1"','"pro2_native_phase_evidence_v2"')
post='''
def main():
    global E,CONTROLLER_COMMIT
    Q,C,F=load_context();C.boundary(F)
    E,invocation,context=Q.operating(C,F)
    CONTROLLER_COMMIT=F['controller_commit'];RECEIPT_SHA256=F['receipt_sha256']
    OWNER_RECORD_SHA256=C.PROGRAMMATIC_FACTS['owner_sha256']
    SEAL_VERDICT_SHA256=PRIOR_VERDICT_SHA256;PRE_SEAL_EVIDENCE_SHA256=PHASE_EVIDENCE_SHA256
    C.absent(Q.phase_path('post_seal'))
    prior=Q.checked_record(C,F,Q.verdict_path(C,'seal'),PRIOR_VERDICT_SHA256)
    pre=Q.validate_phase(C,F,'pre_seal',PHASE_EVIDENCE_SHA256,reobserve=False)
    E.require(prior['phase_evidence_sha256']==PHASE_EVIDENCE_SHA256,'seal/pre-seal chain differs')
    raw,attempt_hashes,native_witness=Q.observed_files(C,Q.file_names(C,'seal'))
    response=Q.checked_response(C,'seal',STDOUT_SHA256,STDOUT_BYTES)
    E.require(prior['result']==response and attempt_hashes==prior['attempt_file_sha256'],
              'seal verified binary/native inventory differs')
'''+body+verdict+'''
    verdict.update(witness_file_identity=E.file_identity_witness(witness),
        witness_absent_paths=E.absent_witness([root/'records'/'bootstrap-postmortem-completion.json'
                                             for root in (E.RECOVERY,E.RECOVERY_COPY)]),
        witness_historical_absent_paths=E.historical_absence_witness(),
        witness_directory_entries={},witness_directory_identity={})
    identities=verdict['witness_file_identity']
    def late():
        C.repeat(native_witness)
        E.require(E.file_identity_witness(witness)==identities,'sealed mechanical evidence changed before publication')
        completion_and_launch(incident,incident_sha,material,bootstrap,witness,response)
        E.old_processes_dead_twice();Q.operating(C,F)
    digest=Q.publish(C,F,Q.phase_path('post_seal'),verdict,final_check=late)
    print('sealed_recovery_independent_evidence_sha256='+digest)

if __name__=='__main__':main()
'''
write('verify-sealed-recovery-evidence-013-window30h-001.py.template',HEADER+function+'\n'+post)

# Retain every original downstream outcome-blind evidence function and core
# business section, replacing only current admission/transport/publication.
for phase in ('monitor','finalize','report','figures'):
    name='verify-native-'+phase+'-011-window-oct02-'+('terminal-success-' if phase=='monitor' else 'success-')+'001.py.template'
    src=(BEFORE/name).read_text(encoding='utf-8')
    tree=ast.parse(src)
    globals_text='\n'.join(ast.get_source_segment(src,node) for node in tree.body if isinstance(node,ast.Assign)
                          and not any(isinstance(t,ast.Name) and t.id in {'COMMIT','COMMON','COMMON_SHA','SESSION','OUTPUT','ATTEMPT','PROJECT','OWNER_SHA','RELEASE_RECORD_SHA','RELEASE_SHA','RECEIPT_SHA','LAUNCHER_SHA','STDOUT_SHA','STDOUT_BYTES','READY_AUDIT_SHA','SEAL_SHA','MONITOR_SHA','FINALIZE_SHA','REPORT_VERDICT_SHA','POSTSEAL_SHA'} for t in node.targets)
                          and not (isinstance(node.value,ast.Constant) and isinstance(node.value.value,str) and node.value.value.startswith('FINAL_')))
    functions='\n\n'.join(ast.get_source_segment(src,node) for node in tree.body if isinstance(node,ast.FunctionDef)
                          and node.name not in {'main','checked_oct02_authority','plain_self','plain_ancestors'})
    business=slice_statements(src,'    prior_names = (','    payload = (json.dumps(verdict' if phase!='finalize' else '    output = (json.dumps(verdict')
    if phase in ('monitor','finalize'):
        left='    old_raw = common.plain_file(SESSION / "OWNER_POST_STATUS009_WINDOW2200_RESTART_002.json")'
        right='    now = datetime.now(timezone.utc)'
        assert business.count(left)==1 and business.count(right)==1
        business=business[:business.index(left)]+business[business.index(right):]
    else:
        business=business.replace('    deadline = checked_oct02_authority(common)','    C.boundary(F)\n    deadline=datetime.fromisoformat(C.PROGRAMMATIC_FACTS[\'owner\'][\'work_end_utc\'])')
    business=business.replace('    deadline = datetime(2026, 10, 2, 8, 0, tzinfo=timezone.utc)',"    deadline=datetime.fromisoformat(C.PROGRAMMATIC_FACTS['owner']['work_end_utc'])")
    business=business.replace('    if raw["'+phase+'-exitcode.txt"] != b"0\\n" or raw["'+phase+'-stderr.txt"]:',
                              '    if raw["'+phase+'-exitcode.txt"] != b"0\\n" or raw["'+phase+'-stderr.txt"] != raw["status-stderr.txt"]:')
    if phase=='figures':
        business=business.replace('    if raw["figures-exitcode.txt"] != b"0\\n" or raw["figures-stderr.txt"]:',
                                  '    if raw["figures-exitcode.txt"] != b"0\\n" or raw["figures-stderr.txt"] != raw["status-stderr.txt"]:')
    business=business.replace('    raw = {name: common.plain_file(ATTEMPT / name) for name in all_names}',
                              '    raw,hashes,native_witness=Q.observed_files(C,all_names)')
    business=business.replace('    raw = {name: common.plain_file(ATTEMPT / name) for name in names}',
                              '    raw,hashes,native_witness=Q.observed_files(C,names)')
    business=business.replace('"pro2_native_phase_evidence_v1"','"pro2_native_phase_evidence_v2"')
    for old_phase in ('seal','monitor','finalize','report','figures'):
        business=business.replace('pro2_native_'+old_phase+'_mechanical_verification_v1','pro2_native_'+old_phase+'_mechanical_verification_v2')
    business=business.replace('pro2_native_monitor_terminal_verification_v1','pro2_native_monitor_terminal_verification_v2')
    for text in (business,functions):assert 'import numpy' not in text and 'import bu' not in text
    business=business.replace('-011-','-013-').replace('-011.json','-013.json')
    setup='''
def main():
    global COMMIT,RECEIPT_SHA,LAUNCHER_SHA,OWNER_SHA,STDOUT_SHA,STDOUT_BYTES,READY_AUDIT_SHA
    global SEAL_SHA,MONITOR_SHA,FINALIZE_SHA,REPORT_VERDICT_SHA,POSTSEAL_SHA
    Q,C,F=load_context();C.boundary(F)
    E,invocation,context=Q.operating(C,F)
    common=Q.legacy_view(C,F)
    COMMIT=F['controller_commit'];RECEIPT_SHA=F['receipt_sha256'];LAUNCHER_SHA=F['launcher_sha256']
    OWNER_SHA=C.PROGRAMMATIC_FACTS['owner_sha256']
    STDOUT_SHA=STDOUT_SHA256;STDOUT_BYTES=str(globals()['STDOUT_BYTES']);READY_AUDIT_SHA=AUDIT_SHA256
    SEAL_SHA=MONITOR_SHA=FINALIZE_SHA=REPORT_VERDICT_SHA=PRIOR_VERDICT_SHA256;POSTSEAL_SHA=PHASE_EVIDENCE_SHA256
    C.require(type(globals()['STDOUT_SHA256']) is str and C.HEX64.fullmatch(STDOUT_SHA256) is not None
              and STDOUT_BYTES.isdecimal() and 5<=int(STDOUT_BYTES)<=8192,'first stdout pin/byte limit unbound')
    C.require(type(STDERR_SHA256) is str and C.HEX64.fullmatch(STDERR_SHA256) is not None,'first stderr pin unbound')
    OUTPUT=Q.verdict_path(C,'PHASE_LITERAL');C.absent(OUTPUT)
    prior_phase={'monitor':'seal','finalize':'monitor','report':'finalize','figures':'report'}['PHASE_LITERAL']
    Q.checked_record(C,F,Q.verdict_path(C,prior_phase),PRIOR_VERDICT_SHA256)
    Q.validate_phase(C,F,'post_seal',PHASE_EVIDENCE_SHA256)
'''.replace('PHASE_LITERAL',phase)
    # Capture mechanical reads/identity across retained functions, including
    # immutable post-seal control proof and output receipts/PNG bytes.
    setup+='''    evidence_witness={}
    def captured_read(path):
        return C.read(path,witness=evidence_witness,maximum=C.readiness_byte_limit() if path.name in ('status-stdout.txt','adjudicate-stdout.txt') else 1048576)
    common.plain_file=captured_read
'''
    tail='''
    C.require(C.sha(raw['PHASE_LITERAL-stderr.txt'])==STDERR_SHA256,'first stderr capture changed')
    C.checked_audit(raw['stage0-PHASE_LITERAL-audit.txt'],F,'PHASE_LITERAL')
    Q.checked_intent(C,F,raw['PHASE_LITERAL-launch-intent.json'],'PHASE_LITERAL',
        PRIOR_VERDICT_SHA256,PHASE_EVIDENCE_SHA256,{name:hashes[name] for name in prior_names})
    def late():
        C.repeat(native_witness);C.repeat(evidence_witness)
        Q.validate_phase(C,F,'post_seal',PHASE_EVIDENCE_SHA256)
        E.old_processes_dead_twice();Q.operating(C,F)
    digest=Q.publish(C,F,OUTPUT,verdict,final_check=late)
    print('native_PHASE_LITERAL_verification_sha256='+digest)

if __name__=='__main__':main()
'''.replace('PHASE_LITERAL',phase)
    write('verify-native-'+phase+'-013-window30h-'+('terminal-success-' if phase=='monitor' else 'success-')+'001.py.template',
          HEADER+'\n'+globals_text+'\n'+functions+'\n'+setup+business+tail)

print('Six downstream phase/business verifiers staged by pure source assembly; none imported/run.')
