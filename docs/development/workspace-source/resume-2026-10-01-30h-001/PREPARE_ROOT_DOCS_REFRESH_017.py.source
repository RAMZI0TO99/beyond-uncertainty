         'actual_input_count': len(inputs), 'maintained_links': maintained, 'facts': facts}
once(BASE / 'DOCS_REFRESH_AUDIT_017.json', encode(audit))
print(json.dumps({'checkpoint_sha256': sha(checkpoint.read_bytes()), 'audit_sha256': sha(encode(audit)),
                  'declared_files': len(declared), 'inputs': len(inputs), 'maintained_links': len(maintained)}))
