         'observed_tracked_modifications': 2, 'opaque742_paired': True,
         'release009_actual_metadata_key_count': 37, 'release009_root_independently_accepted': False,
         'gate008_record_claims': {'nodes': 5569, 'passed': 5550, 'skipped': 19, 'subtests': 51, 'failures': 0, 'errors': 0},
