"""Distinct one-use ROOT017 documentation refresh; no project definitions execute."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import re

ROOT = Path('D:/Aenv/pro2')
BASE = ROOT / 'resume-2026-10-01-30h-001'
BEFORE = BASE / 'root-docs-before-major017'
INPUTS = BASE / 'root-docs-inputs-major017'
sha = lambda b: hashlib.sha256(b).hexdigest()
encode = lambda x: (json.dumps(x, indent=2, sort_keys=True, ensure_ascii=True,
                               allow_nan=False) + '\n').encode('ascii')

def once(p, b):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())

def row(p):
    b = p.read_bytes()
    return {'path': p.relative_to(ROOT).as_posix(), 'bytes': len(b), 'sha256': sha(b)}

local_names = [
    '30H_RESUME_CHECKPOINT_016.md', 'DOCS_REFRESH_AUDIT_016.json',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_016.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_016.md',
    'ROOT016_TIMESTAMP_ATTRIBUTION_CORRECTION_001.json',
    'ROOT016_TIMESTAMP_ATTRIBUTION_CORRECTION_001.md',
    'ROOT017_READ_ONLY_CONTEXT_OBSERVATION_001.json', 'ROOT017_OPAQUE_CURRENT742_GUARD_001.json',
    'COORDINATION_RAW004_GUARD003_HOLD_010.md', 'COORDINATION_NEW_RELEASE009_D178_HOLD_011.md',
    'consumer-guard-test-runtime002/GUARD_RUNTIME_PREPARATION_MANIFEST_002.json',
    'consumer-guard-test-runtime002/INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_002.json',
    'consumer-guard-test-runtime002/INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_002.md',
    'raw-consumer-binding-integration-prep003/INDEPENDENT_RAW_CONSUMER_GUARD_STATIC_REVIEW_003.json',
