resource = f'''

### {stamp} - major017 new actor release, no new lease

Fresh read-only HEAD3f74/twoD178edits/context{short('ROOT017_READ_ONLY_CONTEXT_OBSERVATION_001.json')} is not quiet or a lease. No fresh resource measurement is claimed. Pro3small/heavy holds and native durablequiet stay unresolved. Request011 seeks sole-executorSTOP/transfer without delivery claim. Copied guard14 remainunrun/runtime002refused/new003authoring; raw004isolated acceptance spent. Keeper launch consumed, lastmonitorDisabled/restorationcloseoutdue. [Checkpoint017](30H_RESUME_CHECKPOINT_017.md).
'''.encode('utf-8')
maintained = []
for p, b in [(primary[0], header), (primary[1], handoff.encode('utf-8')), (primary[2], start),
             (checkpoint, body.encode('utf-8')), (primary[3], entry), (primary[4], resource)]:
    for target in re.findall(r'\]\(([^)]+)\)', b.decode('utf-8')):
        resolved = p.parent / target
        assert resolved.is_file(), target
        maintained.append({'document': p.relative_to(ROOT).as_posix(), 'target': target,
                           'resolved_path': str(resolved.resolve())})
for p, b in {primary[0]: header + before[primary[0]], primary[1]: handoff.encode('utf-8'), primary[2]: start}.items():
    assert p.read_bytes() == before[p]
    p.write_bytes(b)
for p, b in ((primary[3], entry), (primary[4], resource)):
    assert p.read_bytes() == before[p]
    with p.open('ab') as f:
        f.write(b)
baseline = []
for p, b in before.items():
    proof = 'exact_before_copy'
    if p.name == 'AGENTS.md':
        assert p.read_bytes().endswith(b)
        proof = 'exact_retained_suffix'
    if p.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert p.read_bytes().startswith(b)
        proof = 'exact_retained_prefix'
    baseline.append({'primary': p.relative_to(ROOT).as_posix(),
                     'before': row(BEFORE / p.relative_to(ROOT)), 'proof': proof})
once(BASE / 'DOCS_REFRESH_BASELINE_017.json', encode({'schema_version': 1, 'created_utc': stamp, 'files': baseline}))
