    'native-schema2-contract-design002/ROOT_NATIVE_SCHEMA2_DESIGN_DECISION_002.json',
    'native-schema2-contract-design002/INDEPENDENT_NATIVE_SCHEMA2_CONTRACT_DESIGN_REVIEW_002.json',
    'OWNER_WORK_WINDOW_30H_20261001_001.json', 'OWNER_WORK_WINDOW_30H_20261001_001_REVIEW.md',
]
names = ['resume-2026-10-01-30h-001/' + n for n in local_names] + [
    'resume-2026-09-28-001/controller-release-008-proposal017.json',
    'resume-2026-09-28-001/controller-release-009-proposal018.json',
    'resume-2026-09-28-001/full-gate-008/release-verification.json',
