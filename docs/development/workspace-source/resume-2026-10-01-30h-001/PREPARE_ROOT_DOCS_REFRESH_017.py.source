data = {n: (ROOT / n).read_bytes() for n in names}
key = lambda n: 'resume-2026-10-01-30h-001/' + n
obj = lambda n: json.loads(data[key(n)])
short = lambda n: sha(data[key(n)])[:8]
context = obj('ROOT017_READ_ONLY_CONTEXT_OBSERVATION_001.json')
assert context['head'] == '3f74b1d248e003168157e207e28ca775364f1f26'
assert context['tracked_files'] == 742 and context['all742_paired_bytes_metadata_matched'] is True
assert context['porcelain_untracked_normal'] == [
    ' M src/bu/experiments/week8_exp2a_recovery.py', ' M tests/test_week8_exp2a_recovery.py']
refusal = obj('consumer-guard-test-runtime002/INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_002.json')
assert refusal['verdict'] == 'REFUSED_STATIC_PREPARATION'
assert refusal['reviewer'] == '/root/candidate_review'
assert refusal['tests_executed'] is False and refusal['target_definitions_executed'] is False
raw = obj('raw-component-runtime-prep004/INDEPENDENT_RAW_COMPONENT_RUNTIME_REVIEW_004.json')
assert raw['verdict'] == 'PASS_ISOLATED_RAW_COMPONENT_RUNTIME_ONLY'
finished = obj('raw-component-runtime-prep004/finished.json')
terminal = obj('raw-component-runtime-prep004/ROOT_LAUNCH_TERMINAL_004.json')
assert terminal['exit_code'] == 0 and terminal['timed_out'] is False and terminal['failure'] is None
release_path = 'resume-2026-09-28-001/controller-release-009-proposal018.json'
release = json.loads(data[release_path])
assert len(release) == 37 and release['ControllerCommit'] == context['head']
assert release['ParentCommit'] == '597eb048a1bc441030bfcd88b70fdf9c56f882d0'
gate_path = 'resume-2026-09-28-001/full-gate-008/release-verification.json'
gate = json.loads(data[gate_path])
assert (gate['collected_nodes'], gate['passed'], gate['skipped'],
        gate['additional_reported_subtests'], gate['failures'], gate['errors']) == (5569, 5550, 19, 51, 0, 0)
assert len(gate['partitions']) == 45
