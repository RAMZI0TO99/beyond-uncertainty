resource = f'''

### {stamp} - major018 no new lease or quiet agreement

Gate008D177 dataacceptance is not a resourcelease/quiet/sole-executor transfer. Actor009start05:31receipt metadataonly; Root didnotlaunch/stop/repair/cleanup. Guard14/grammar24/native85planned remainunrun. Pro3small/heavy/nativequiet holds unchanged; no new RAMmeasurement claimed. Keeperconsumed/lastmonitorDisabled/restorecloseout. [Checkpoint018](30H_RESUME_CHECKPOINT_018.md).
'''.encode('utf-8')
maintained = []
for p, b in [(primary[0], header), (primary[1], handoff.encode()), (primary[2], start),
             (CHECKPOINT, body.encode()), (primary[3], entry), (primary[4], resource)]:
    for target in re.findall(r'\]\(([^)]+)\)', b.decode('utf-8')):
        resolved = (p.parent / target).resolve()
        assert resolved == CHECKPOINT.resolve() or resolved.is_file(), (p, target)
        maintained.append({'document': p.relative_to(ROOT).as_posix(), 'target': target, 'resolved_path': str(resolved)})
for n, b in data.items():
    assert (ROOT / n).read_bytes() == b
    once(INPUTS / n, b)
for p, b in before.items():
    once(BEFORE / p.relative_to(ROOT), b)
once(CHECKPOINT, body.encode('utf-8'))
for p, b in {primary[0]: header + before[primary[0]], primary[1]: handoff.encode(), primary[2]: start}.items():
    assert p.read_bytes() == before[p]
    p.write_bytes(b)
for p, b in ((primary[3], entry), (primary[4], resource)):
    assert p.read_bytes() == before[p]
    with p.open('ab') as f:
        f.write(b)
baseline = []
for p, b in before.items():
    proof = 'exact_before_copy'
    if p.name == 'AGENTS.md':
        assert p.read_bytes().endswith(b)
        proof = 'exact_retained_suffix'
    if p.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert p.read_bytes().startswith(b)
        proof = 'exact_retained_prefix'
    baseline.append({'primary': p.relative_to(ROOT).as_posix(), 'before': row(BEFORE / p.relative_to(ROOT)), 'proof': proof})
once(BASE / 'DOCS_REFRESH_BASELINE_018.json', enc({'schema_version': 1, 'created_utc': stamp, 'files': baseline}))
inputs = [{'original': row(ROOT / n), 'copy': row(INPUTS / n)} for n in names]
