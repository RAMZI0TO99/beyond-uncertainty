declared = [*primary, CHECKPOINT, BASE / 'DOCS_REFRESH_BASELINE_018.json', BASE / 'DOCS_REFRESH_INPUTS_018.json',
            *[BEFORE / p.relative_to(ROOT) for p in primary], *[INPUTS / n for n in names]]
facts = {'owner_end_utc': '2026-10-02T22:36:15Z', 'root017_docs': docs_peer['verdict'],
         'gate008': gate_peer['verdict'], 'gate008_nodes': 5569, 'gate008_passed': 5550, 'gate008_skipped': 19,
         'gate008_counter_surplus_without_individual_ids': 51, 'current_d178_or_release009_or_native_accepted': False,
         'finite001_encoding': 'REFUSED_LOWER_BOUND444068_EXCEEDS395799', 'compact002_design': 'AUTHORING_SOURCE_ONLY',
         'guard003': 'REFUSED_STATIC_PREPARATION', 'guard004': guard004, 'guard_tests_executed': 0,
         'grammar004': 'REFUSED_STATIC_TEST_PREPARATION', 'grammar005': 'AUTHORING_TEST_ONLY_UNRUN',
