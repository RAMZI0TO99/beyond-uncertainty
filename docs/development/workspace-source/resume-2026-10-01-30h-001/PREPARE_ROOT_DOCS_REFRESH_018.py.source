    guard004 = p['verdict']
    guard004_clause = f'[Different004 review]({optional[0]}),{short(optional[0])}, is frozen with verdict {guard004}. Preserve it; no binding or execution is approved.'
body = f'''# Major step018 - gate008 data accepted; proof and transport redesign remain held

