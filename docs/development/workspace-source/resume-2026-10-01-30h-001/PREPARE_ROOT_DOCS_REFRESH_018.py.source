guard004 = 'FROZEN_PREPARATION_DIFFERENT_REVIEW_UNDERWAY_KNOWN_STALE_RECORD_TEMPLATE_PINS'
guard004_clause = 'Its different review is underway and reports stale runtime003 pins in active004 record templates. No corrected binding or execution is approved.'
if optional[0] in local:
