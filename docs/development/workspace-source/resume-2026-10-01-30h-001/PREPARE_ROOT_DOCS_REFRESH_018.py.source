"""One-use documentation refresh018; validates links before publishing."""
import datetime
import hashlib
import json
import os
from pathlib import Path
import re

ROOT = Path('D:/Aenv/pro2')
BASE = ROOT / 'resume-2026-10-01-30h-001'
BEFORE = BASE / 'root-docs-before-major018'
INPUTS = BASE / 'root-docs-inputs-major018'
CHECKPOINT = BASE / '30H_RESUME_CHECKPOINT_018.md'
sha = lambda b: hashlib.sha256(b).hexdigest()
enc = lambda v: (json.dumps(v, indent=2, sort_keys=True, ensure_ascii=True,
                            allow_nan=False) + '\n').encode('ascii')

def once(p, b):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())

def row(p):
    b = p.read_bytes()
    return {'path': p.relative_to(ROOT).as_posix(), 'bytes': len(b), 'sha256': sha(b)}

assert not BEFORE.exists() and not INPUTS.exists() and not CHECKPOINT.exists()
local = [
    '30H_RESUME_CHECKPOINT_017.md', 'DOCS_REFRESH_AUDIT_017.json',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_017.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_017.md',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_017_002.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_017_002.md',
