local += [n for n in optional if (BASE / n).is_file()]
names = ['resume-2026-10-01-30h-001/' + n for n in local] + [
    'resume-2026-09-28-001/full-gate-009/driver-start.json',
    'resume-2026-09-28-001/full-gate-009/plan.json',
    'resume-2026-09-28-001/full-gate-009/g9-governance-001.accepted.json',
]
data = {n: (ROOT / n).read_bytes() for n in names}
key = lambda n: 'resume-2026-10-01-30h-001/' + n
obj = lambda n: json.loads(data[key(n)])
short = lambda n: sha(data[key(n)])[:8]
docs_peer = obj('INDEPENDENT_DOCS_REFRESH_REVIEW_017_002.json')
assert docs_peer['verdict'] == 'PASS_FROZEN_DOCUMENTATION_ONLY_WITH_IMMUTABLE_REVIEWER_CORRECTION'
gate_peer = obj('INDEPENDENT_ACTUAL_GATE008_CONTINUATION_REVIEW_001.json')
assert gate_peer['verdict'] == 'PASS_RECONSTRUCTED_ACTUAL_GATE008_CONTINUATION_DATA_D177_ONLY'
