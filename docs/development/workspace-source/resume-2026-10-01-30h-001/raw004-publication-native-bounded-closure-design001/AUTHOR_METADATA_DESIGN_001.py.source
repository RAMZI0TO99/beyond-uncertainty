def digest(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value):
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("ascii")


def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns,
            s.st_mode, s.st_nlink, getattr(s, "st_file_attributes", None),
            getattr(s, "st_birthtime_ns", None)]


def read_finite(path):
    first = path.lstat()
    if not stat.S_ISREG(first.st_mode) or first.st_size > MAX_INPUT or first.st_nlink != 1:
        raise ValueError("not a capped, single-link regular finite input: " + str(path))
    if getattr(first, "st_file_attributes", 0) & 0x400:
        raise ValueError("reparse input: " + str(path))
    with path.open("rb") as stream:
        fd_before = os.fstat(stream.fileno())
        data = stream.read(MAX_INPUT + 1)
        fd_after = os.fstat(stream.fileno())
    after = path.lstat()
    if len(data) != first.st_size or len(data) > MAX_INPUT:
        raise ValueError("capped input changed or exceeded bound")
    if raw9(first) != raw9(after) or raw9(fd_before) != raw9(fd_after):
        raise ValueError("same-API finite input identity changed")
    # Windows path and descriptor ctime semantics can differ; do not equate them.
    for field in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_mode", "st_nlink"):
        if getattr(first, field) != getattr(fd_before, field):
            raise ValueError("shared path/descriptor identity differs: " + field)
    return data, {"path_lstat_before_raw9": raw9(first), "path_lstat_after_raw9": raw9(after),
                  "descriptor_before_raw9": raw9(fd_before), "descriptor_after_raw9": raw9(fd_after),
                  "same_api_repeat_exact": True, "cross_api_ctime_equated": False}


def new_bytes(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    if path.read_bytes() != data:
        raise ValueError("new artifact readback differs")


def new_json(name, value):
    data = json.dumps(value, ensure_ascii=True, sort_keys=True, indent=2).encode("ascii") + b"\n"
    new_bytes(OUT / name, data)


def assignments(tree):
    result = {}
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name):
                    if target.id in result:
                        raise ValueError("duplicate direct source assignment " + target.id)
                    result[target.id] = node
    return result


def typed_literal(node):
    """Recognize this finite source AST grammar into own JSON data, no eval/calls."""
    if isinstance(node, ast.Constant):
        if type(node.value) is str:
            if not node.value.isascii():
                raise ValueError("non-ASCII policy string")
            return ["str", node.value]
        if type(node.value) is int:
            return ["int", node.value]
        raise ValueError("unsupported scalar AST")
    if isinstance(node, ast.Tuple):
        return ["tuple", [typed_literal(x) for x in node.elts]]
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and not node.keywords and len(node.args) == 1:
        if node.func.id == "MappingProxyType" and isinstance(node.args[0], ast.Dict):
            literal = node.args[0]
            pairs = []
            for key, value in zip(literal.keys, literal.values):
                if not isinstance(key, ast.Constant) or type(key.value) is not str or not key.value.isascii():
                    raise ValueError("mapping keys must be exact literal ASCII strings")
                pairs.append([key.value, typed_literal(value)])
            if len({key for key, _ in pairs}) != len(pairs):
                raise ValueError("duplicate AST mapping key")
            return ["mappingproxy", sorted(pairs)]
        if node.func.id == "frozenset" and isinstance(node.args[0], ast.Tuple):
            values = []
            for value in node.args[0].elts:
                if not isinstance(value, ast.Constant) or type(value.value) is not str or not value.value.isascii():
                    raise ValueError("frozenset requires exact literal ASCII strings")
                values.append(value.value)
            if len(set(values)) != len(values):
                raise ValueError("duplicate AST frozenset member")
            return ["frozenset", sorted(values)]
    raise ValueError("unreviewed literal form " + ast.dump(node, include_attributes=False)[:100])


def plain(typed):
    tag, value = typed
    if tag in {"str", "int", "frozenset"}:
        return value
    if tag == "tuple":
        return [plain(child) for child in value]
    if tag == "mappingproxy":
        return {key: plain(child) for key, child in value}
    raise ValueError("unknown own typed data")


def shape(typed, path, measures, depth=1):
    tag, value = typed
    measures["typed_node_count"] += 1
    measures["tag_counts"][tag] += 1
    measures["maximum_depth"] = max(measures["maximum_depth"], depth)
    if tag == "str":
        escaped = len(json.dumps(value, ensure_ascii=True, separators=(",", ":")).encode("ascii"))
        measures["maximum_string_ascii_bytes"] = max(measures["maximum_string_ascii_bytes"], len(value))
        measures["maximum_json_quoted_string_bytes"] = max(measures["maximum_json_quoted_string_bytes"], escaped)
        return {"nominal_type": "str", "ascii_bytes": len(value), "quoted_json_bytes": escaped}
    if tag == "int":
        return {"nominal_type": "int_not_bool", "decimal_bytes": len(str(value)), "sign": "nonnegative" if value >= 0 else "negative"}
    if tag == "tuple":
        measures["maximum_collection_count"] = max(measures["maximum_collection_count"], len(value))
        return {"nominal_type": "tuple", "exact_count": len(value),
                "items": [shape(child, path + "/" + str(i), measures, depth + 1) for i, child in enumerate(value)]}
    if tag == "mappingproxy":
        measures["maximum_collection_count"] = max(measures["maximum_collection_count"], len(value))
        for key, _ in value:
            measures["mapping_key_count"] += 1
            measures["maximum_string_ascii_bytes"] = max(measures["maximum_string_ascii_bytes"], len(key))
        return {"nominal_type": "exact_types.MappingProxyType", "exact_count": len(value),
                "keys_in_canonical_order": [key for key, _ in value],
                "values": {key: shape(child, path + "/" + key, measures, depth + 1) for key, child in value}}
    if tag == "frozenset":
        measures["maximum_collection_count"] = max(measures["maximum_collection_count"], len(value))
        for text in value:
            measures["frozenset_member_count"] += 1
            measures["maximum_string_ascii_bytes"] = max(measures["maximum_string_ascii_bytes"], len(text))
        return {"nominal_type": "frozenset_of_exact_str", "exact_count": len(value),
                "member_ascii_byte_lengths_in_canonical_order": [len(text) for text in value]}
    raise ValueError("unknown shape tag")


def function_refs(tree, names):
    return {node.name: {"line": node.lineno, "end_line": node.end_lineno}
            for node in tree.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.name in names}


def direct_upper_names(tree):
    values = set()
    for node in tree.body:
        if isinstance(node, (ast.Assign, ast.AnnAssign)):
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            for target in targets:
                if isinstance(target, ast.Name) and (target.id.isupper() or target.id == "__all__"):
                    values.add(target.id)
        elif isinstance(node, (ast.Import, ast.ImportFrom)):
            for alias in node.names:
                name = alias.asname or (alias.name.split(".")[0] if isinstance(node, ast.Import) else alias.name)
                if name.isupper() or name == "__all__":
                    values.add(name)
    return sorted(values)


def create_design():
    choice_bytes, _ = read_finite(BASE / "ROOT_REVIEWED_SOURCE_PREPARATION_CHOICES_005.json")
    if len(choice_bytes) != 5830 or digest(choice_bytes) != CHOICE_SHA:
        raise ValueError("Root source choice005 bytes differ")
    choice = json.loads(choice_bytes)
    if choice["publication_native_schema3_design"]["implementation_authorized"] is not False:
        raise ValueError("unexpected source authority")
    for row in choice["inputs"]:
        EXPECTED[row["path"]] = (row["bytes"], row["sha256"])
    raw_manifest_data, _ = read_finite(BASE / "successor-candidate-raw-revision004/RAW_POLICY_STAGED_MANIFEST_004.json")
    raw_manifest = json.loads(raw_manifest_data)
    def collect_raw_manifest_pins(value):
        if isinstance(value, dict):
            rel = value.get("relative_path")
            if type(rel) is str and type(value.get("bytes")) is int and type(value.get("sha256")) is str:
                full_rel = "successor-candidate-raw-revision004/" + rel
                if full_rel in INPUTS:
                    EXPECTED[full_rel] = (value["bytes"], value["sha256"])
            for child in value.values():
                collect_raw_manifest_pins(child)
        elif isinstance(value, list):
            for child in value:
                collect_raw_manifest_pins(child)
    collect_raw_manifest_pins(raw_manifest)
    selected = {}
    pairs = []
    for rel in INPUTS:
        data, observation = read_finite(BASE / rel)
        if rel in EXPECTED and (len(data), digest(data)) != EXPECTED[rel]:
            raise ValueError("selected expected finite source pin differs: " + rel)
        copy = OUT / "before" / rel
        new_bytes(copy, data)
        copy_data, copy_observation = read_finite(copy)
        if copy_data != data:
            raise ValueError("finite before pair bytes differ")
        selected[rel] = data
        pairs.append({"original": str(BASE / rel), "copy": str(copy), "relative_input": rel,
                      "bytes": len(data), "sha256": digest(data), "byte_pair_exact": True,
                      "original_observation": observation, "copy_observation": copy_observation})
    trees = {rel: ast.parse(selected[rel].decode("utf-8"), filename=str(BASE / rel))
             for rel in (RAW_REL, COMMON_REL, PUB_REL, VER_REL)}
    raw_tree, common_tree = trees[RAW_REL], trees[COMMON_REL]
    raw_assign = assignments(raw_tree)
    common_assign = assignments(common_tree)
    def literal_json_call(node):
        if not (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
                and isinstance(node.func.value, ast.Name) and node.func.value.id == "json"
                and node.func.attr == "loads" and len(node.args) == 1
                and isinstance(node.args[0], ast.Constant) and type(node.args[0].value) is str):
            raise ValueError("expected explicit json.loads literal AST")
        return json.loads(node.args[0].value)
    native_bindings = literal_json_call(common_assign["BINDING_SCHEMA"].value)
    native_middle = literal_json_call(common_assign["NATIVE_MIDDLE_INPUTS"].value)
    pub_assign = assignments(trees[PUB_REL])
    pub_middle = literal_json_call(pub_assign["MIDDLE_INPUTS"].value)
    if len(native_bindings) != 44 or native_middle != pub_middle or set(native_middle) != {"middle_release", "middle_manifest", "middle_commit_object"}:
        raise ValueError("current binding/middle scalar source roles differ")
    facts = [[name, typed_literal(raw_assign[name].value)] for name in sorted(POLICIES)]
    raw_sha = digest(selected[RAW_REL])
    commitment = ["week8_raw004_compact_policy_v1", raw_sha, facts]
    commitment_bytes = json.dumps(commitment, ensure_ascii=True, separators=(",", ":")).encode("ascii")
    if len(commitment_bytes) != 21724 or digest(commitment_bytes) != "b292d3ff9487fd44cdf0647d982f6ae544d1bbcc9c4f5775820ddd39fd6c95f9":
        raise ValueError("prior advisory typed commitment derivation differs")
    new_bytes(OUT / "AST_TYPED_POLICY_COMMITMENT_001.json", commitment_bytes)
    plain_facts = {name: plain(value) for name, value in facts}
    measures = {"typed_node_count": 0, "tag_counts": collections.Counter(), "maximum_depth": 0,
                "maximum_collection_count": 0, "maximum_string_ascii_bytes": 0,
                "maximum_json_quoted_string_bytes": 0, "mapping_key_count": 0,
                "frozenset_member_count": 0}
    shapes = {name: shape(value, name, measures) for name, value in facts}
    measures["tag_counts"] = dict(measures["tag_counts"])
    new_json("AST_TYPED_POLICY_SHAPE_001.json", {
        "scope": "OWN_AST_DATA_BOUND_DERIVATION_NOT_A_RUNTIME_WHITELIST_OR_APPROVED_CAP",
        "raw_source_sha256": raw_sha, "facts": shapes, "derived_measurements": measures,
        "shape_interpretation": "Exact recursive collection counts/keys/nominal types; leaf lengths are source-derived required upper bounds. The independently reviewed digest fixes all scalar values. Every mapping key and frozenset member must be exact ASCII str. A runtime walker must validate shape before copying/hashing and derive a serialized-size budget including keys/members/tags/punctuation; these measured data are not by themselves a compiled implementation budget.",
    })
    native_json_node = common_assign["NATIVE_SCHEMA2_POLICY"].value
    if not (isinstance(native_json_node, ast.Call) and isinstance(native_json_node.func, ast.Attribute)
            and isinstance(native_json_node.func.value, ast.Name) and native_json_node.func.value.id == "json"
            and native_json_node.func.attr == "loads" and len(native_json_node.args) == 1
            and isinstance(native_json_node.args[0], ast.Constant) and type(native_json_node.args[0].value) is str):
        raise ValueError("unexpected Native policy AST literal source")
    native_policy = json.loads(native_json_node.args[0].value)
    first_limits = dict(native_policy["_SUCCESSOR_INTERMEDIATE_PROOF_LIMITS"])
    del first_limits["candidate_manifest_base64"]
    dedup = {
        "first_summary_equals_existing_native_fact": plain_facts["SUCCESSOR_COMPACT_INTERMEDIATE_FACTS"][0] == native_policy["SUCCESSOR_INTERMEDIATE_FACTS"],
        "first_afterimages_equal_existing_native_afterimages": plain_facts["_SUCCESSOR_COMPACT_AFTERIMAGES"][0] == native_policy["_SUCCESSOR_INTERMEDIATE_AFTERIMAGES"],
        "first_compact_limits_equal_old_limits_without_QA_base64": plain_facts["_SUCCESSOR_COMPACT_PROOF_LIMITS"][0] == first_limits,
        "first_release_keyset_equals_existing_native_keyset": plain_facts["_SUCCESSOR_COMPACT_RELEASE_KEYS"][0] == sorted(native_policy["_SUCCESSOR_INTERMEDIATE_RELEASE_KEYS"]),
        "second_release_added_keys": sorted(set(plain_facts["_SUCCESSOR_COMPACT_RELEASE_KEYS"][1]) - set(native_policy["_SUCCESSOR_INTERMEDIATE_RELEASE_KEYS"])),
        "second_release_removed_keys": sorted(set(native_policy["_SUCCESSOR_INTERMEDIATE_RELEASE_KEYS"]) - set(plain_facts["_SUCCESSOR_COMPACT_RELEASE_KEYS"][1])),
        "second_summary_normalized_json_bytes": len(canonical(plain_facts["SUCCESSOR_COMPACT_INTERMEDIATE_FACTS"][1])),
        "second_afterimages_normalized_json_bytes": len(canonical(plain_facts["_SUCCESSOR_COMPACT_AFTERIMAGES"][1])),
        "QA_paths_normalized_json_bytes": len(canonical(plain_facts["_SUCCESSOR_COMPACT_QA_PATHS"])),
        "QA_paths_count": len(plain_facts["_SUCCESSOR_COMPACT_QA_PATHS"]),
    }
    if not all(dedup[key] for key in list(dedup)[:4]):
        raise ValueError("dedup equality proof differs")
    naive = len(canonical(plain_facts))
    current_bytes = len(selected[COMMON_REL])
    b64_current = 4 * ((current_bytes + 2) // 3)
    frame_current = b64_current + 16384 + 2
    canonical_max = 262142
    raw_max = ((canonical_max - 16384 - 2) // 4) * 3
    naive_total = current_bytes + naive
    native_naive_frame = 4 * ((naive_total + 2) // 3) + 16384 + 2
    derive = {
        "record_type": "own_finite_source_ast_literal_and_transport_derivation001",
        "status": "SOURCE_AST_DATA_ONLY_ADVISORY_DIGEST_NOT_RUNTIME_APPROVED",
        "raw_source": {"path": str(BASE / RAW_REL), "bytes": len(selected[RAW_REL]), "sha256": raw_sha},
        "native_common": {"path": str(BASE / COMMON_REL), "bytes": current_bytes, "sha256": digest(selected[COMMON_REL])},
        "existing_native_policy_literal_field_count": len(native_policy),
        "new_raw_policy_field_count": len(POLICIES), "future_policy_facts_count": len(native_policy) + len(POLICIES),
        "source_policy_assignments": {name: {"line": raw_assign[name].lineno, "end_line": raw_assign[name].end_lineno,
                                                 "normalized_json_bytes": len(canonical(plain_facts[name]))} for name in POLICIES},
        "source_helper_definitions": function_refs(raw_tree, HELPERS),
        "raw_top_function_count": sum(isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) for node in raw_tree.body),
        "raw_top_class_count": sum(isinstance(node, ast.ClassDef) for node in raw_tree.body),
        "raw_explicit_class_method_count": sum(isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)) for node in raw_tree.body if isinstance(node, ast.ClassDef) for child in node.body),
        "raw_non_definition_initializer_genexpr_count": sum(isinstance(child, ast.GeneratorExp) for node in raw_tree.body if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) for child in ast.walk(node)),
        "source_direct_uppercase_or___all___names": direct_upper_names(raw_tree),
        "source_direct_uppercase_name_scope": "Direct module assignments/imports only; future executable reference must prove equality with actual reference namespace rather than assuming this static extraction covers conditional/dynamic globals.",
        "normalized_11_fact_json_bytes": naive, "typed_commitment_bytes": len(commitment_bytes),
