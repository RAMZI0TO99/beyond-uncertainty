"""One-use root metadata binding only; never executes any target definition."""
import ast
import hashlib
import json
import os
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path('D:/Aenv/pro2')
PREP = ROOT / 'resume-2026-10-01-30h-001/raw-component-runtime-prep003'

def read(path):
    return path.read_bytes()

def digest(value):
    return hashlib.sha256(value).hexdigest()

def parsed(path):
    return json.loads(read(path))

def once(path, value):
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii') if not isinstance(value, bytes) else value
    with path.open('xb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    return digest(data)

selection = parsed(PREP / 'BOUND_PREPARATION_003_ROOT_001.json')
bound_path = PREP / 'run-isolated-raw-component-003.BOUND.py'
review_path = PREP / 'INDEPENDENT_RAW_HARNESS_BOUND_REVIEW_003.json'
static_path = PREP / 'INDEPENDENT_RAW_HARNESS_STATIC_REVIEW_003.json'
review_bytes = read(review_path)
review = json.loads(review_bytes)
assert review['verdict'] == 'PASS_BOUND_FOR_ROOT_FIRST_EXECUTION_ONLY'
assert digest(read(bound_path)) == selection['bound_driver_sha256'] == review['bound_driver_sha256']
assert digest(read(static_path)) == selection['static_review_sha256'] == review['static_review_sha256']
assert len(review_bytes) < 2097152
resource_path = PREP / 'ROOT_RAW003_PRE_BIND_RESOURCE_001.json'
resource = parsed(resource_path)
now = datetime.now(timezone.utc)
assert (now - datetime.fromisoformat(resource['captured_utc'])).total_seconds() < 600
assert type(resource['free_ram_bytes']) is int and resource['free_ram_bytes'] >= 1073741824
assert type(resource['d_free_bytes']) is int and resource['d_free_bytes'] >= 10737418240
expiry = datetime(2026, 10, 2, 3, 45, tzinfo=timezone.utc)
assert (expiry - now).total_seconds() > 6000

# No pytest configuration/conftest may be inherited from the copied source's ancestors.
config_names = ('pytest.ini', '.pytest.ini', 'pyproject.toml', 'tox.ini', 'setup.cfg', 'conftest.py')
copy = PREP / 'source'
ancestors = [copy / 'tests', copy, *copy.parents]
config_observations = []
for parent in ancestors:
    for name in config_names:
        path = parent / name
        assert not path.exists(), str(path)
        config_observations.append({'path': str(path), 'exists': False})
cleared_prefixes = ('PYTEST', 'PYTHON', 'GIT_', 'COVERAGE')
ambient_names = sorted(k for k in os.environ if k.upper().startswith(cleared_prefixes))
environment_profile = {
    'schema_version': 1,
    'captured_utc': now.isoformat(),
    'source': str(copy),
    'ancestor_configuration_observations': config_observations,
    'ambient_matching_names_only': ambient_names,
    'root_launch_temporarily_removes_prefixes': list(cleared_prefixes),
    'root_launch_restores_ambient_process_environment_in_finally': True,
    'driver_child_explicit_pytest_autoload_off_one_thread_profile': True,
    'full_site_runtime_closure_or_import_trace_proven': False,
}

ack = parsed(PREP / 'ROOT_FIRST_EXECUTION_ACK_RAW003.TEMPLATE.json')
assert len(ack) == 20
ack.update({
    'created_utc': now.isoformat(),
    'expires_utc': expiry.isoformat(),
    'bound_driver_sha256': selection['bound_driver_sha256'],
    'bound_review_sha256': digest(review_bytes),
    'static_review_sha256': selection['static_review_sha256'],
    'raw_peer_review_sha256': selection['raw_peer_review_sha256'],
    'child_sha256': selection['child_sha256'],
    'min_free_ram_bytes': 1073741824,
})
for key in ('runtime_snapshot', 'live_guard_snapshot', 'coordination_acknowledgement'):
    selected = selection['selected_for_bound_preparation_only'][key]
    actual_path = Path(selected['path'])
    assert digest(read(actual_path)) == selected['sha256']
    ack[key] = {'path': str(actual_path), 'sha256': selected['sha256']}
    if key != 'coordination_acknowledgement':
        captured = datetime.fromisoformat(parsed(actual_path)['captured_utc'])
        assert 0 <= (now - captured).total_seconds() < 18000
        assert (expiry - captured).total_seconds() < 18000
    else:
        assert read(actual_path) == read(Path(selected['actual_original_path']))
assert all(v is not None for v in ack.values())
future = ['ROOT_FIRST_EXECUTION_ACK_RAW003.json', 'ROOT_FIRST_LAUNCH_003.BOUND.ps1',
          'ROOT_LAUNCH_START_003.json', 'ROOT_LAUNCH_TERMINAL_003.json',
          'ROOT_LAUNCH_STDOUT_003.txt', 'ROOT_LAUNCH_STDERR_003.txt',
          'ROOT_RUN_INTENT_003.json', 'started.json', 'finished.json', 'failed.json']
for name in future:
    assert not (PREP / name).exists(), name
assert not (ROOT / '.tmp/raw3-003').exists()

profile_sha = once(PREP / 'ROOT_RAW003_ENVIRONMENT_PROFILE_001.json', environment_profile)
ack_sha = once(PREP / 'ROOT_FIRST_EXECUTION_ACK_RAW003.json', ack)
launcher_path = PREP / 'ROOT_FIRST_LAUNCH_003.TEMPLATE.ps1'
original = read(launcher_path)
bound = original
bindings = {'BoundDriverSha256': selection['bound_driver_sha256'],
            'RootAckSha256': ack_sha, 'BoundReviewSha256': digest(review_bytes)}
for key, value in bindings.items():
    old = ('$' + key + ' = $null').encode('ascii')
    new = ('$' + key + " = '" + value + "'").encode('ascii')
    assert bound.count(old) == 1
    bound = bound.replace(old, new, 1)
reverse = bound
for key, value in bindings.items():
    reverse = reverse.replace(('$' + key + " = '" + value + "'").encode('ascii'),
                              ('$' + key + ' = $null').encode('ascii'), 1)
assert reverse == original
launcher_sha = once(PREP / 'ROOT_FIRST_LAUNCH_003.BOUND.ps1', bound)
receipt = {'schema_version': 1, 'created_utc': now.isoformat(), 'author': '/root',
           'status': 'BOUND_ACK_LAUNCHER_PREPARATION_ONLY_PENDING_DIFFERENT_LATE_REVIEW',
           'ack_sha256': ack_sha, 'bound_launcher_sha256': launcher_sha,
           'template_launcher_sha256': digest(original),
           'bound_driver_sha256': selection['bound_driver_sha256'],
           'bound_review_sha256': digest(review_bytes),
           'resource_observation_sha256': digest(read(resource_path)),
           'environment_profile_sha256': profile_sha,
           'exact_three_literal_reverse': reverse == original,
           'driver_launcher_tests_executed': False,
           'canonical_qa_native_release_authority': False}
receipt_sha = once(PREP / 'ROOT_ACK_LAUNCH_BINDING_003_001.json', receipt)
print(json.dumps({'ack_sha256': ack_sha, 'launcher_sha256': launcher_sha,
                  'binding_receipt_sha256': receipt_sha, 'environment_profile_sha256': profile_sha}))
