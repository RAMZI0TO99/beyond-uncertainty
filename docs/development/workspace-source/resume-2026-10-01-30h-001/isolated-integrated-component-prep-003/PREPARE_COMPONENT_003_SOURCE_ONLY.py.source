def require(v,m):
    if not v:raise ValueError(m)
def sha(v):return hashlib.sha256(v).hexdigest()
def canonical(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def rawidentity(s):return(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None))
def cross(s):return(s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_nlink)
def ancestors(p):
    rows=[]
    for q in [*reversed(p.absolute().parents),p.absolute()]:
        s=q.lstat();require(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not(getattr(s,'st_file_attributes',0)&0x400),'linked ancestor '+str(q));rows.append((str(q),s.st_dev,s.st_ino))
    return rows
def read(p,pin=None):
    c=ancestors(p.parent);before=p.lstat();require(stat.S_ISREG(before.st_mode) and not stat.S_ISLNK(before.st_mode) and before.st_nlink==1 and not(getattr(before,'st_file_attributes',0)&0x400),'nonplain '+str(p))
    with p.open('rb') as f:opened=os.fstat(f.fileno());v=f.read();closed=os.fstat(f.fileno())
    after=p.lstat();require(rawidentity(before)==rawidentity(after) and rawidentity(opened)==rawidentity(closed) and cross(before)==cross(opened)==cross(closed)==cross(after) and len(v)==before.st_size and ancestors(p.parent)==c,'read drift '+str(p))
    require(pin is None or sha(v)==pin,'pin drift '+str(p));CAPTURED.append((p,sha(v),len(v),rawidentity(before)));return v,before
def get(p,pin=None):return json.loads(read(p,pin)[0])
def absent(p):
    ancestors(p.parent)
    try:p.lstat()
    except FileNotFoundError:return str(p)
    raise ValueError('exists '+str(p))
def create(p,v):
    absent(p)
    with p.open('xb') as f:f.write(v)
    require(read(p)[0]==v,'copy/publication drift')
