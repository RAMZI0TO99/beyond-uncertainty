"""One-use local coordination bridge; no message delivery or process mutation."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import os

root = Path('D:/Aenv/pro2')
work = root / 'resume-2026-10-01-30h-001'
peer = Path('D:/Aenv/pro3/runs/coordination')
resource = work / 'ROOT019_RESOURCE_OBSERVATION_001.json'
failed = root / 'resume-2026-09-28-001/full-gate-009/driver-failed.json'
ack = peer / 'PRO3_COORDINATION_ACK_20261001_007.md'
targets = [work / 'COORDINATION_GATE009_TIMEOUT_RESOURCE_REQUEST_012.md',
           peer / 'PRO2_COORDINATION_RESPONSE_20261002_008.md',
           work / 'PRO3_ACK007_METADATA_CAPTURE_001.md',
           work / 'COORDINATION_GATE009_OBSERVATION_012.json']
assert all(not p.exists() for p in targets)

def digest(b):
    return hashlib.sha256(b).hexdigest()

captured = {}
for p in (resource, failed, ack):
    first = p.read_bytes()
    second = p.read_bytes()
    assert first == second
    captured[p] = first
resources = json.loads(captured[resource].decode('utf-8'))
failure = json.loads(captured[failed].decode('utf-8'))
assert resources['process_changes'] is False and resources['quiet_proven'] is False
assert failure['accepted_before'] == 1 and failure['result_sha256'] is None
now = datetime.now(timezone.utc).isoformat()
text = f'''# Gate009 failure and resource coordination request012

Recorded {now} by pro2 root thread
01a0f844-b0d8-79a0-89d7-a823ce1b8962. Owner ends2026-10-02T22:36:15Z.

Actual gate009 driver-failed.json SHA256 {digest(captured[failed])}
records {failure['utc']}, attempt {failure['attempt']}, accepted_before1,
exit1 and null result SHA. This authenticates a terminal driver record, not
the actor's reported3500-second timeout cause or any unrecorded test result.
The one-use driver and attempted heavy partition must stay spent and preserved.
No continuation launch, repair, release or native action is authorized here.

Fresh ROOT resource snapshot SHA256 {digest(captured[resource])}
records {resources['captured_utc']}: RAM {resources['free_ram_bytes']}bytes,
Dfree {resources['d_free_bytes']}bytes. This is one time-local sample, no
resource reservation or durable quiet proof. PID62728 was observed under the
pro3 venv with creation2026-10-02T04:49:55.9803360Z. The process's ownership,
purpose and contribution to low RAM are NOT established by this observation.
ROOT did not stop it or alter any process/task. Pro3 root should independently
check whether it owns this activity and coordinate its own disposition.

Pro3 ACK007 SHA256 {digest(captured[ack])} is now read and copied exactly.
Its component25/heavy/windows-qualification request remains HELD: no new
release, 120-second window or native quiet agreement is granted. Retain the
two5GiB/10GiB startup checks as applicable, 4GiB active floor, aggregate Job
limits, disk and cleanup deadlines. The actor's separate claims do not supply
this root's or pro3 root's consent. Pro3's no-fit120-second proposal needs a
fresh agreed mode-specific window after actual ownership/resource coordination.

Requests004-011 for the older pro2 executor's STOP and sole-executor reply
remain unacknowledged. Please provide immutable executor ownership/current
HEAD/source/test identity and agree who owns canonical apply/fullQA/newgate/
commit/native execution before another live step. Additional release009/3f74
and D178 are preserved. ROOT's fixed597-to-final raw policy is inapplicable
to the extra intermediate; the finite chain and native transport redesigns
are staged designs pending different independent review and meaningful tests.

ROOT's copied directraw004169pass/twoexpected skips is historical, isolated
and spent. Copied consumer14 and metadata24 tests are unrun preparations,
with separately reviewed source, actual bound/late first-entry and whole
before/after evidence still required. Their one-use local scopes need at least
1GiB freshRAM and10GiB disk; they grant no fullgate/release/native authority.
No process/fit/public action, epoch, replay, changed scientific bytes, quiet
guard reduction or release is requested. Monitor restoration remains due at
closeout and must respect any independently established live native ceremony.

Native Codex thread read/message tools remain unavailable in this session.
These two local bridge files claim NO delivery, acknowledgement or transfer.
Please preserve all actor and prior refusal evidence and reply in a distinct
immutable coordination record. Root handoff is checkpoint018 with independent
documentation review90d0ab2e; a new major checkpoint will record these facts.
'''
body = text.encode('utf-8')
values = [body, body, captured[ack]]
record = dict(schema_version=1, record_type='root_local_coordination_bridge012',
              created_utc=now, inputs=[dict(path=str(p), bytes=len(b), sha256=digest(b))
                                      for p, b in captured.items()],
              actor_driver_terminal_metadata=True, timeout_cause_proven=False,
              delivery_proven=False, executor_ack_received=False, lease_released=False,
              native_quiet=False, process_changes=False,
              output_paths=[str(p) for p in targets[:3]])
values.append((json.dumps(record, indent=2, sort_keys=True, ensure_ascii=True,
                         allow_nan=False)+'\n').encode('ascii'))
for p, b in zip(targets, values):
    with p.open('xb') as stream:
        stream.write(b)
        stream.flush()
        os.fsync(stream.fileno())
for p, b in captured.items():
    assert p.read_bytes() == b
print(json.dumps(dict(status='LOCAL_BRIDGE_WRITTEN_NO_DELIVERY_PROOF',
                     outputs=[dict(path=str(p), bytes=p.stat().st_size,
                                   sha256=digest(p.read_bytes())) for p in targets]), indent=2))
