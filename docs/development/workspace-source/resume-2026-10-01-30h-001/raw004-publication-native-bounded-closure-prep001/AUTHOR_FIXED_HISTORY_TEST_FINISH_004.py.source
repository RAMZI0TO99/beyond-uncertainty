"""Own AST/data source composition; no target namespace is executed."""
import ast
from pathlib import Path
stage=Path(__file__).absolute().parent
test=stage/'source/test_native_schema3_admission_001.py'
before=test.read_bytes()
with(stage/'BEFORE_FIXED_HISTORY_TEST_FINISH_004.bytes').open('xb')as f:f.write(before)
source=before.decode('utf8');tree=ast.parse(source)
assert isinstance(tree.body[-1],ast.ClassDef)and tree.body[-1].name=='BoundedRaw004CausalCases'
family=next(n for n in tree.body if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id=='NATIVE_CRITICAL_FAMILY_CASES')
groups=ast.literal_eval(family.value)
groups['B15']=['BoundedRaw004CausalCases.test_b15_fixed_history_acquisition_caps_precede_IO']
lines=source.splitlines(keepends=True)
lines[family.lineno-1:family.end_lineno]=['NATIVE_CRITICAL_FAMILY_CASES = '+repr(groups)+'\n']
source=''.join(lines)
builder=ast.parse((stage/'AUTHOR_FIXED_HISTORY_CAP_PATCH_003.py').read_bytes())
method=ast.literal_eval(next(n.value for n in builder.body if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id=='method'))
source+='\n'+method+'\n'
tree=ast.parse(source)
assert tree.body[-1].body[-1].name=='test_b15_fixed_history_acquisition_caps_precede_IO'
test.write_text(source,encoding='utf8',newline='\n')
print({'common_bytes':len((stage/'front/native_successor_front_common_013_001.py.template').read_bytes()),'planned_native_methods':sum(isinstance(m,ast.FunctionDef)and m.name.startswith('test_')for n in tree.body if isinstance(n,ast.ClassDef)for m in n.body),'target_code_executed':False})
