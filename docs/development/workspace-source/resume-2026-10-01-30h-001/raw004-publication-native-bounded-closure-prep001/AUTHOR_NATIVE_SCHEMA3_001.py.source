def _native_compact_qa(rows,policy,pin):
 table={row['path']:row for row in rows}
 paths=policy['_SUCCESSOR_COMPACT_QA_PATHS']
 require(type(paths)is list and len(paths)==263 and len(set(paths))==263 and all(type(path)is str and path.isascii()and path in table for path in paths),'schema3 grouped263 path domain')
