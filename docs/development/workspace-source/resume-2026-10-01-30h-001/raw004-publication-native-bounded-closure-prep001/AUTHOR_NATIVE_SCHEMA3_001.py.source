 return data
def _native_middle_role_hash(role,values):
 require(type(role)is str and role in NATIVE_MIDDLE_INPUTS and type(values)is list and len(values)==2,'compiled two-middle role hash domain')
 descriptors=[]
 for value,fact in zip(values,NATIVE_MIDDLE_INPUTS[role],strict=True):
  require(type(value)is bytes and len(value)==fact['size']and sha(value)==fact['sha256'],'two-middle independently acquired bytes differ')
  descriptors.append(('git_commit'if fact['path']is None else'file',fact['commit']if fact['path']is None else fact['path'],fact['size'],fact['sha256']))
 return sha(canonical(['week8_schema3_fixed_middle_role_v1',role,descriptors]))
'''
