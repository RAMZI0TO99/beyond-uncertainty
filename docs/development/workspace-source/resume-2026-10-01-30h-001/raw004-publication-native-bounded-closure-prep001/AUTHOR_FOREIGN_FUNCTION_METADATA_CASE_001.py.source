"""Own test/source AST composition; target code is never executed."""
import ast,json
from pathlib import Path
stage=Path(__file__).absolute().parent
common=stage/'front/native_successor_front_common_013_001.py.template'
test=stage/'source/test_native_schema3_admission_001.py'
for path in(common,test):
 with(stage/('BEFORE_FOREIGN_FUNCTION_METADATA_'+path.name+'.bytes')).open('xb')as f:f.write(path.read_bytes())
source=common.read_text(encoding='utf8')
assert source.count("{'B%02d'%i for i in range(1,17)}")==1
source=source.replace("{'B%02d'%i for i in range(1,17)}","{'B%02d'%i for i in range(1,18)}")
ast.parse(source);common.write_text(source,encoding='utf8',newline='\n')
source=test.read_text(encoding='utf8');tree=ast.parse(source)
nodes={n.targets[0].id:n for n in tree.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
case='BoundedRaw004CausalCases.test_b17_foreign_function_metadata_refuses_before_equality_callbacks'
groups=ast.literal_eval(nodes['NATIVE_CRITICAL_FAMILY_CASES'].value);groups['B17']=[case]
events=ast.literal_eval(nodes['NATIVE_SUBTEST_POLICY'].value)
for i in range(16):events[f'{case}#{i+1:04d}']={'case_id':case,'expected_refusal':True,'observed_boundary':'ForeignFunctionMetadataBeforeEquality','control_case_id':'BoundedRaw004CausalCases.test_b01_all31_exact_typed_commitment_cold_and_reuse'}
lines=source.splitlines(keepends=True)
for name,value in sorted((('NATIVE_CRITICAL_FAMILY_CASES',groups),('NATIVE_SUBTEST_POLICY',events)),key=lambda row:nodes[row[0]].lineno,reverse=True):
 node=nodes[name];lines[node.lineno-1:node.end_lineno]=[name+' = '+repr(value)+'\n']
source=''.join(lines)+'''
    def test_b17_foreign_function_metadata_refuses_before_equality_callbacks(self):
        calls=[]
        class Foreign:
            def __eq__(self,other):calls.append('eq');return True
            def __str__(self):calls.append('str');raise AssertionError('foreign string conversion')
        class Text(str):
            def __eq__(self,other):calls.append('text-eq');return True
        with bounded_raw004_fixture()as(n,module):
            targets=(module.admit_recorded_predecessor,module.SuccessorAdmissionContext.__init__)
            for timing in('cold','reuse'):
                for target in targets:
                    for field in('__name__','__qualname__','__module__','__doc__'):
                        with self.subTest(timing=timing,target=target.__qualname__,field=field):
                            self.assertEqual(n['_native_attestation_limit']()[1],395799)
                            if timing=='cold':n['_RAW_HELPER_EXECUTABLE_STATE']=None
                            original=getattr(target,field)
                            value=Text('FOREIGN')if field in('__name__','__qualname__')else Foreign()
                            setattr(target,field,value)
                            try:
                                with self.assertRaisesRegex(ValueError,'function metadata text type'):
                                    n['_native_attestation_limit']()
                                self.assertEqual(calls,[])
                            finally:setattr(target,field,original)
                            self.assertEqual(n['_native_attestation_limit']()[1],395799)
'''
ast.parse(source);test.write_text(source,encoding='utf8',newline='\n')
with(stage/'FOREIGN_FUNCTION_METADATA_CASE_001.json').open('x',encoding='utf8')as f:
 json.dump({'schema_version':1,'scope':'planned causal checks only; no tests executed','case':case,'planned_subtests':16,'declared_subtest_policy_total':len(events),'before_equality_exact_text_guard':True,'actual_case_results':None},f,indent=2);f.write('\n')
print({'common_bytes':len(common.read_bytes()),'declared_subtests':len(events),'target_code_executed':False})
