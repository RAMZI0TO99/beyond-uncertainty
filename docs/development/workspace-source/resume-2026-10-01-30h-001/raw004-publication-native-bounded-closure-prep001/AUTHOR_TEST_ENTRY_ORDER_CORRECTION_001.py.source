"""Move the test main guard after added classes; no test execution."""
import ast
from pathlib import Path
stage=Path(__file__).absolute().parent
path=stage/'source/test_schema3_metadata_grammar_001.py'
data=path.read_bytes()
with(stage/'METADATA_TEST_BEFORE_ENTRY_ORDER_CORRECTION_001.bytes').open('xb')as f:f.write(data)
text=data.decode();tree=ast.parse(text)
entry=next(n for n in tree.body if isinstance(n,ast.If)and isinstance(n.test,ast.Compare)and isinstance(n.test.left,ast.Name)and n.test.left.id=='__name__')
lines=text.splitlines(keepends=True);body=''.join(lines[entry.lineno-1:entry.end_lineno]);del lines[entry.lineno-1:entry.end_lineno]
text=''.join(lines).rstrip()+'\n\n'+body
ast.parse(text);path.write_text(text,encoding='utf-8',newline='\n')
