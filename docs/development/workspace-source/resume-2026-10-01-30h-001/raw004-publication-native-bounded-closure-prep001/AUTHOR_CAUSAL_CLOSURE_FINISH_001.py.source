        def process(*args,**kwargs):
            calls.append((args,kwargs))
            return types.SimpleNamespace(returncode=0,stdin=None,stdout=io.BytesIO(b'x'),stderr=io.BytesIO(b''),poll=lambda:0,wait=lambda **kw:0)
        n['subprocess']=types.SimpleNamespace(Popen=process)
        self.assertEqual(n['_bounded_git_run']([],cwd=None,env={},maximum=1),b'x')
        before=len(calls)''')
