text=fragment.read_text()
text=text.replace('import contextlib\n','import contextlib,io\n')
text=text.replace("        final=document['successor_files'];saved=copy.deepcopy(final);final[:]=copy.deepcopy(table)\n",'')
text=text.replace("        finally:table[:]=original;final[:]=saved","        finally:table[:]=original")
