source=metadata.read_text()+'''

class Schema3BoundedPreparation(unittest.TestCase):
    def test_two_ordered_middle_actual742_and_grouped263_controls(self):
        for name in TEMPLATES:
            n=selected_namespace(name)
            previous=None
            for index in (0,1):
                p,old,middle,proof,paths,_=historical_fixture(n,index)
                if previous is not None:self.assertEqual(old,previous)
                entry={'identities':p['SUCCESSOR_COMPACT_INTERMEDIATE_FACTS'][index],'proof':proof}
                call=lambda e:n['schema3_middle'](e,old,middle,policy=p,expected_paths=paths,index=index)
                self.assertEqual(call(entry),middle)
                self.assertEqual(len(n['schema3_compact_qa'](middle,p,entry['identities']['candidate_manifest_sha256'])),31347)
                for mutate in (lambda e:e.update(extra=True),lambda e:e['identities'].update(tracked_file_count=True),lambda e:e['proof']['changed_files'][0].update(size=True)):
                    changed=copy.deepcopy(entry);mutate(changed)
                    with self.assertRaises(n['Refused']):call(changed)
                    self.assertEqual(call(entry),middle)
                previous=middle

    def test_all31_current_raw004_and_source_initializers_are_data_only(self):
        raw=(STAGE/'before/raw004-source.bytes').read_bytes()
        tree=ast.parse(raw)
        self.assertEqual(sum(isinstance(n,ast.FunctionDef) for n in tree.body),85)
        self.assertEqual(sum(isinstance(n,ast.ClassDef) for n in tree.body),7)
        for name in TEMPLATES:
            n=selected_namespace(name)
            self.assertEqual(len(n['schema2_literal_policy'](raw)),31)
            altered=raw+b'\\nSUCCESSOR_COMPACT_INTERMEDIATE_FACTS = ()\\n'
            with self.assertRaises(n['Refused']):n['schema2_literal_policy'](altered)
            self.assertEqual(n['schema2_literal_policy'](raw),n['COMPILED_POLICY'])

    def test_metadata_two_middle_nominals_order_and_pair_input_hashes(self):
        for name in TEMPLATES:
            n=grammar_namespace(name);context,documents=grammar_fixture(n)
            for kind in ('successor_publication_complete','successor_verification_pass'):
                good=documents[kind]
                self.assertEqual(len(good['intermediate']),2)
                self.assertEqual(len(good['middle_full742_identity']),2)
                n['sealed_receipt_bytes'](good)
                for mutate in (lambda v:v['intermediate'].reverse(),lambda v:v['middle_full742_identity'].pop(),lambda v:v['middle_full742_identity'][1].update(tracked_file_count=True)):
                    changed=copy.deepcopy(good);mutate(changed)
                    with self.assertRaises(n['Refused']):n['sealed_receipt_bytes'](changed)
                    n['sealed_receipt_bytes'](good)

    def test_middle_pair_caps_are_587_6030_and_62694_without_role_growth(self):
        for name in TEMPLATES:
            n=grammar_namespace(name);context,documents=grammar_fixture(n)
            self.assertEqual(len(context['paths']),17);self.assertEqual(len(context['input_caps']),35)
            for role,expected in [('middle_commit_object',587),('middle_release',6030),('middle_manifest',62694)]:
                self.assertEqual(context['input_caps'][role],expected)
                original=n['INPUT_ROLE_MAX_BYTES'][role]
                n['INPUT_ROLE_MAX_BYTES'][role]+=1
                try:
                    with self.assertRaises(n['Refused']):n['metadata_context']()
                finally:n['INPUT_ROLE_MAX_BYTES'][role]=original
                self.assertEqual(n['metadata_context'](),context)

    def test_zero_full742_rows_are_valid_and_bool_zero_is_refused(self):
        for name in TEMPLATES:
            n=selected_namespace(name);p,rows,*_=historical_fixture(n)
            zero=copy.deepcopy(rows);zero[0].update(size=0,sha256=n['sha'](b''),git_blob=hashlib.sha1(b'blob 0\\0').hexdigest())
            self.assertEqual(n['schema2_file_rows'](zero,policy=p,what='zero742'),zero)
            for size in(True,False,-1):
                changed=copy.deepcopy(zero);changed[0]['size']=size
                with self.assertRaises(n['Refused']):n['schema2_file_rows'](changed,policy=p,what='bad742')
                self.assertEqual(n['schema2_file_rows'](zero,policy=p,what='restored742'),zero)
'''
ast.parse(source);metadata.write_text(source,encoding='utf-8',newline='\n')
