with(stage/'NATIVE_TEST_BEFORE_CAUSAL_APPEND_001.bytes').open('xb')as f:f.write(test.read_bytes())
source=test.read_text()+text
tree=ast.parse(source)
family=next(n for n in tree.body if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id=='NATIVE_CRITICAL_FAMILY_CASES')
values=ast.literal_eval(family.value)
values.update({f'B{i:02}':['BoundedRaw004CausalCases.'+method.name] for i,method in enumerate(next(n for n in tree.body if isinstance(n,ast.ClassDef)and n.name=='BoundedRaw004CausalCases').body,1) if isinstance(method,ast.FunctionDef)})
lines=source.splitlines(keepends=True);lines[family.lineno-1:family.end_lineno]=['NATIVE_CRITICAL_FAMILY_CASES = '+repr(values)+'\n'];source=''.join(lines)
ast.parse(source);test.write_text(source,encoding='utf-8',newline='\n')
common=stage/'front/native_successor_front_common_013_001.py.template'
