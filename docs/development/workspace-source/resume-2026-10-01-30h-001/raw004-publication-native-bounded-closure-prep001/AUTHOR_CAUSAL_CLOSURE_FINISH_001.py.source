source=common.read_text()
source=source.replace('type(descriptor)in(staticmethod,classmethod)','(type(descriptor)is staticmethod or type(descriptor)is classmethod)')
source=source.replace("({'M%02d'%i for i in range(1,33)}|{'F%02d'%i for i in range(1,27)})", "({'M%02d'%i for i in range(1,33)}|{'F%02d'%i for i in range(1,27)}|{'B%02d'%i for i in range(1,15)})")
source=source.replace(" doc=parse(inputs['attestation.json'])", " require(len(inputs['attestation.json'])<=policy['_SUCCESSOR_ATTESTATION_MAX_BYTES_SCHEMA3'],'schema3 private preparse attestation ceiling')\n doc=parse(inputs['attestation.json'])")
