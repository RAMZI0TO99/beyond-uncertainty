"""Nonexecuting text/AST patch; no Git or target definition calls."""
import ast,json
from pathlib import Path
stage=Path(__file__).absolute().parent
helper='''
def _bounded_git_run(command,*,cwd,env,maximum,data=None):
 """Finite capture, retained direct child only; no descendant/OS deadline claim."""
 require(type(maximum)is int and 0<maximum<=9223372036854775807,'unbound finite Git acquisition ceiling')
 require(data is None or(type(data)is bytes and len(data)<=30422),'Git input finite742 request budget')
 process=subprocess.Popen(command,stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,cwd=cwd,env=env,shell=False)
 captured=[bytearray(),bytearray()]
 errors=[]
 stop=threading.Event()
 def pump(stream,index):
  try:
   while not stop.is_set():
    chunk=stream.read(min(65536,maximum-len(captured[index])+1))
    if not chunk:
     return
    if type(chunk)is not bytes or len(chunk)>maximum-len(captured[index]):
     raise ValueError('Git capture exceeds reviewed finite ceiling')
    captured[index].extend(chunk)
  except BaseException as exc:
   errors.append(exc);stop.set()
 def feed():
  try:
   process.stdin.write(data);process.stdin.close()
  except BaseException as exc:
   errors.append(exc);stop.set()
 threads=[threading.Thread(target=pump,args=(process.stdout,0),daemon=True),threading.Thread(target=pump,args=(process.stderr,1),daemon=True)]
 if data is not None:
  threads.append(threading.Thread(target=feed,daemon=True))
 deadline=time.monotonic()+30
 try:
  for thread in threads:
   thread.start()
  while process.poll()is None and not stop.is_set()and time.monotonic()<deadline:
   stop.wait(min(.05,max(0,deadline-time.monotonic())))
  require(process.poll()is not None and not stop.is_set(),'Git finite capture failed or timed out')
  for thread in threads:
   thread.join(max(0,deadline-time.monotonic()))
  require(not any(thread.is_alive()for thread in threads)and not errors,'Git capture drain unconfirmed')
  require(process.returncode==0 and not captured[1],'Git read refused')
  return bytes(captured[0])
 finally:
  stop.set()
  if process.poll()is None:
   process.kill()
  process.wait(timeout=1)
  for thread in threads:
   thread.join(.1)
  # Blocking provider calls and foreign descendants are outside this guard.
  if not any(thread.is_alive()for thread in threads):
   process.stdout.close();process.stderr.close()
   if process.stdin is not None and not process.stdin.closed:
    process.stdin.close()
'''
for relative in ('front/native_successor_front_common_013_001.py.template','publication/publish-successor-admission-schema3-001.py.template','publication/verify-successor-admission-schema3-001.py.template'):
 path=stage/relative;before=path.read_bytes()
 with (stage/('BEFORE_BOUNDED_GIT_'+path.name+'.bytes')).open('xb') as f:f.write(before)
 text=before.decode()
 tree=ast.parse(text)
 target=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='git')
 lines=text.splitlines(keepends=True)
 function=''.join(lines[target.lineno-1:target.end_lineno])
 if relative.startswith('front/'):
  old=" result=subprocess.run([str(GIT),'-c','safe.directory='+root.as_posix(),'-C',str(root),*arguments],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=False,env=environment)"
  # Preserve the authenticated command/environment; replace the capture only.
  run=next(n for n in ast.walk(target)if isinstance(n,ast.Assign)and isinstance(n.value,ast.Call)and isinstance(n.value.func,ast.Attribute)and n.value.func.attr=='run')
  run_text=ast.get_source_segment(text,run)
  command=ast.unparse(run.value.args[0])
  env=ast.unparse(next(k.value for k in run.value.keywords if k.arg=='env'))
  start=run.lineno-target.lineno
  fl=function.splitlines(keepends=True)
  end=next(i for i,line in enumerate(fl)if line.strip()=='return result.stdout')
  fl[start:end+1]=[" return _bounded_git_run("+command+",cwd=root,env="+env+",maximum=GIT_ACQUISITION_MAX_BYTES)\n"]
  function=''.join(fl)
 else:
  start=function.index('    result = subprocess.run(')
  function=function[:start]+'''    return _bounded_git_run(command,cwd=executable.parent,env=environment,maximum=GIT_ACQUISITION_MAX_BYTES,data=data)
'''
 lines[target.lineno-1:target.end_lineno]=[function]
 text=''.join(lines)
 # Standalone source constants are bound only by a separate reviewed derivation.
 position=text.index('\ndef git(')
 text=text[:position]+'\nimport threading,time\nGIT_ACQUISITION_MAX_BYTES=None\n'+helper+text[position:]
 ast.parse(text)
 path.write_text(text,encoding='utf-8',newline='\n')
