import ast,hashlib,json
from pathlib import Path
stage=Path(__file__).absolute().parent
preserved=json.loads((stage/'PRESERVATION_BEFORE_IMPLEMENTATION_002.json').read_bytes())
policy=json.loads((stage/'ALL31_NORMALIZED_POLICY_001.json').read_bytes())
pairs=preserved['pairs']
def sha(data):return hashlib.sha256(data).hexdigest()
def capture(expected):
    row=next(row for row in pairs if row['sha256']==expected)
    data=(stage/row['copy_relative']).read_bytes()
    assert sha(data)==expected and len(data)==row['bytes']
    return data
def named(relative,source):
    path=stage/relative;path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream:stream.write(source)
    return sha(source)
fixtures={
 'raw004-source.bytes':capture('da64c4ea68e86bbcd28f7fbccd60baa765cc534afa532c14cd7cb39de782b211'),
 'raw004-policy-normalized.bytes':(stage/'ALL31_NORMALIZED_POLICY_001.json').read_bytes(),
