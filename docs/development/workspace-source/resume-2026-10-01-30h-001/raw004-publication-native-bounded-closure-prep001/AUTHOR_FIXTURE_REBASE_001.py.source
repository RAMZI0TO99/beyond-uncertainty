for role in descriptors:fixtures[role+'.bytes']=fixtures['middle1_'+role+'.bytes']
fixture_pins={name:named('source/before/'+name,data) for name,data in fixtures.items()}
for row in pairs:
    if row['original_relative'].startswith('publisher-schema2-grammar-revision004/before/'):
        filename=Path(row['original_relative']).name
        destination=stage/'publication/before'/filename
        if not destination.exists():named(str(destination.relative_to(stage)),capture(row['sha256']))
for role,pair in descriptors.items():
    for row in pair:named('publication/before/'+row['retained_name'],capture(row['sha256']))
named('publication/before/raw004-source.bytes',fixtures['raw004-source.bytes'])

def change_definition(text,name,replacement):
    tree=ast.parse(text)
    found=[n for n in ast.walk(tree)if isinstance(n,(ast.FunctionDef,ast.ClassDef))and n.name==name]
    assert len(found)==1,name
    n=found[0];lines=text.splitlines(keepends=True)
    indent=' '*n.col_offset
    replacement='\n'.join(indent+line if line else '' for line in replacement.strip('\n').splitlines())+'\n'
    lines[n.lineno-1:n.end_lineno]=[replacement]
    return ''.join(lines)

