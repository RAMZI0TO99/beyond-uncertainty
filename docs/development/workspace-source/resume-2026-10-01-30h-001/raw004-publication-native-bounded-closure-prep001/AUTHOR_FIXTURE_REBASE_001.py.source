text=change_definition(text,'test_middle_exact_proof_keysets_afterimages_and_encoded_sizes_refuse','''def test_middle_exact_proof_keysets_afterimages_and_encoded_sizes_refuse(self):
    for name,ns in self.each_namespace():
        for index in (0,1):
            policy,old,middle,proof,paths,_=historical_fixture(ns,index)
            entry={'identities':policy['SUCCESSOR_COMPACT_INTERMEDIATE_FACTS'][index],'proof':proof}
            call=lambda value,p=policy:ns['schema3_middle'](value,old,middle,policy=p,expected_paths=paths,index=index)
            with self.subTest(template=name,index=index):
                self.assertEqual(call(entry),middle)
                mutations=[]
                altered=copy.deepcopy(entry);altered['proof']['changed_files'][0]['size']+=1;mutations.append(altered)
                altered=copy.deepcopy(entry);altered['proof']['extra']=True;mutations.append(altered)
                altered=copy.deepcopy(entry);del altered['proof']['changed_files'];mutations.append(altered)
                for altered in mutations:
                    with self.assertRaises(ns['Refused']):call(altered)
                    self.assertEqual(call(entry),middle)
                cap=policy['_SUCCESSOR_COMPACT_PROOF_MAX_BYTES'][index]
                self.assertEqual(len(ns['canonical'](proof)),cap)
                widened=copy.deepcopy(entry);widened['proof']['release_record_base64']+='='
                self.assertEqual(len(ns['canonical'](widened['proof'])),cap+1)
                never=lambda *a,**k:(_ for _ in ()).throw(AssertionError('cap must precede decoder'))
                with patch.dict(ns,base64=SimpleNamespace(b64decode=never,b64encode=base64.b64encode)):
                    with self.assertRaisesRegex(ns['Refused'],'^intermediate proof cap exceeded$'):call(widened)
                wider=copy.deepcopy(policy);wider['_SUCCESSOR_COMPACT_PROOF_MAX_BYTES'][index]+=1
                calls=[]
                bad=widened['proof']['release_record_base64'].encode('ascii')
                def decoder(token,*a,**k):
                    self.assertNotEqual(token,bad,'width gate precedes this decoder')
                    calls.append(token);return base64.b64decode(token,*a,**k)
                self.assertEqual(call(entry,wider),middle)
                with patch.dict(ns,base64=SimpleNamespace(b64decode=decoder,b64encode=base64.b64encode)):
                    with self.assertRaisesRegex(ns['Refused'],'^middle base64 type/encoded length differs$'):call(widened,wider)
                self.assertEqual(calls,[proof['git_commit_object_base64'].encode('ascii')])
                self.assertEqual(call(entry),middle)''')
text=change_definition(text,'test_schema2_external_sha_seal_schema_and_preparse_cap','''def test_schema2_external_sha_seal_schema_and_preparse_cap(self):
    for name,ns in self.each_namespace():
        policy,old,middle1,proof1,_,_=historical_fixture(ns,0)
        _,_,middle2,proof2,_,_=historical_fixture(ns,1)
        chain=[{'identities':policy['SUCCESSOR_COMPACT_INTERMEDIATE_FACTS'][i],'proof':proof} for i,proof in enumerate((proof1,proof2))]
        body={'successor_admission_schema_version':3,'record_type':'week8_d176_successor_admission','decision_id':'D-161','recovery_id':'week8-exp2a-d161-2026-09-02-attempt-001','predecessor':policy['SUCCESSOR_PREDECESSOR_FACTS'],'successor':{},'predecessor_files':old,'successor_files':middle2,'changed_paths':[],'intermediate_chain':chain,'successor_parent_changed_paths':[],**ns['FLAGS']}
        def seal(value):
            value=copy.deepcopy(value);value['record_digest']=ns['sha'](ns['canonical'](value))
            return ns['canonical'](value)+b'\\n'
        data=seal(body);accept=lambda value:ns['schema2_sealed_attestation'](value,expected_sha256=ns['sha'](value),policy=policy)
        with self.subTest(template=name):
            self.assertEqual(accept(data)['intermediate_chain'],chain)
            with self.assertRaisesRegex(ns['Refused'],'external byte pin'):ns['schema2_sealed_attestation'](data,expected_sha256='0'*64,policy=policy)
            with patch.dict(ns,strict_json=lambda value:(_ for _ in ()).throw(AssertionError('preparse gate'))):
                oversized=b'x'*(policy['_SUCCESSOR_ATTESTATION_MAX_BYTES_SCHEMA3']+1)
                with self.assertRaisesRegex(ns['Refused'],'capture'):ns['schema2_sealed_attestation'](oversized,expected_sha256='0'*64,policy=policy)
            for mutate in (lambda value:value.update(successor_admission_schema_version=True),lambda value:value['intermediate_chain'].reverse(),lambda value:value['intermediate_chain'].pop()):
                changed=copy.deepcopy(body);mutate(changed)
                with self.assertRaises(ns['Refused']):accept(seal(changed))
                self.assertEqual(accept(data)['intermediate_chain'],chain)''')
