text=text.replace("doc['middle_full742_identity'] = {key: ns['COMPILED_POLICY']['SUCCESSOR_INTERMEDIATE_FACTS'][key]\n                for key in ('controller_inventory_digest', 'tracked_tree_digest', 'tracked_file_count')}","doc['middle_full742_identity'] = [{key: row[key] for key in ('controller_inventory_digest','tracked_tree_digest','tracked_file_count')} for row in ns['COMPILED_POLICY']['SUCCESSOR_COMPACT_INTERMEDIATE_FACTS']]")
