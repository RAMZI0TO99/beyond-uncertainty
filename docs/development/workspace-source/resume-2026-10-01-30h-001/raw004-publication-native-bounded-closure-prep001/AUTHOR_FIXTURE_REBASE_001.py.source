    namespace['schema2_middle']=first_middle
    return namespace


def historical_fixture''')
text=change_definition(text,'historical_fixture','''def historical_fixture(ns,index=0):
    policy=copy.deepcopy(ns['COMPILED_POLICY'])
    old_rows=json.loads((STAGE/'before/predecessor_rows.bytes').read_bytes())
    old_qa_bytes=(STAGE/'before/predecessor_manifest.bytes').read_bytes()
    if index==1:
        table={row['path']:copy.deepcopy(row) for row in old_rows}
        for row in policy['_SUCCESSOR_COMPACT_AFTERIMAGES'][0]:table[row['path']]=copy.deepcopy(row)
        old_rows=[table[path] for path in sorted(table)]
    table={row['path']:copy.deepcopy(row) for row in old_rows}
    for row in policy['_SUCCESSOR_COMPACT_AFTERIMAGES'][index]:table[row['path']]=copy.deepcopy(row)
    middle=[table[path] for path in sorted(table)]
    proof={'changed_files':copy.deepcopy(policy['_SUCCESSOR_COMPACT_AFTERIMAGES'][index]),
           'release_record_base64':base64.b64encode((STAGE/f'before/middle{index+1}_middle_release.bytes').read_bytes()).decode('ascii'),
           'git_commit_object_base64':base64.b64encode((STAGE/f'before/middle{index+1}_middle_commit_object.bytes').read_bytes()).decode('ascii')}
    return policy,old_rows,middle,proof,list(policy['_SUCCESSOR_COMPACT_QA_PATHS']),old_qa_bytes''')
