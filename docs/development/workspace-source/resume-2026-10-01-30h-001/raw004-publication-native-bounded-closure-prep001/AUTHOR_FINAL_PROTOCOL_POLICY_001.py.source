"""Own source/policy metadata only; never calls staged targets/tests."""
import ast,collections,copy,json
from pathlib import Path
stage=Path(__file__).absolute().parent
common=stage/'front/native_successor_front_common_013_001.py.template'
with(stage/'COMMON_BEFORE_FINAL_PROTOCOL_POLICY_001.bytes').open('xb')as f:f.write(common.read_bytes())
text=common.read_text()
needle=" if frozenset(key for key in module.__dict__ if key.isupper()or key==\"__all__\")!=upper_names or identity!=admitted_identity"
assert text.count(needle)==1
text=text.replace(needle," if type(module.__name__)is not str or module.__name__!=name or module.__package__!=specification.parent or frozenset(key for key in module.__dict__ if key.isupper()or key==\"__all__\")!=upper_names or identity!=admitted_identity")
ast.parse(text);common.write_text(text,encoding='utf-8',newline='\n')
test=stage/'source/test_native_schema3_admission_001.py'
with(stage/'NATIVE_TEST_BEFORE_FINAL_PROTOCOL_POLICY_001.bytes').open('xb')as f:f.write(test.read_bytes())
text=test.read_text();tree=ast.parse(text)
node=next(n for n in tree.body if isinstance(n,ast.Assign)and isinstance(n.targets[0],ast.Name)and n.targets[0].id=='NATIVE_SUBTEST_POLICY')
old=ast.literal_eval(node.value);groups=collections.OrderedDict()
for key,row in old.items():groups.setdefault(row['case_id'],[]).append((key,row))
changed={'NativeSchema2Preparation.test_middle_base64_and_reconstruction_negative':2,'NativeSchema2Preparation.test_cold_and_reused_real_raw_guard_policy_code_defaults_aliases':76}
new={}
for case,entries in groups.items():
    for i in range(changed.get(case,len(entries))):
        key=f'{case}#{i+1:04d}';new[key]=copy.deepcopy(entries[min(i,len(entries)-1)][1])
case='BoundedRaw004CausalCases.test_b02_each31_replacement_isolated_with_restored_controls'
for i in range(62):new[f'{case}#{i+1:04d}']={'case_id':case,'expected_refusal':True,'observed_boundary':'Raw004PolicyOriginsColdReuse','control_case_id':'BoundedRaw004CausalCases.test_b01_all31_exact_typed_commitment_cold_and_reuse'}
lines=text.splitlines(keepends=True);lines[node.lineno-1:node.end_lineno]=['NATIVE_SUBTEST_POLICY = '+repr(new)+'\n'];text=''.join(lines)
ast.parse(text);test.write_text(text,encoding='utf-8',newline='\n')
with(stage/'PLANNED_SUBTEST_POLICY_REVISION_001.json').open('x',encoding='utf-8')as f:
    json.dump({'schema_version':1,'scope':'explicit static loop cardinality policy; no test events observed','old_declared_subtests':len(old),'new_declared_subtests':len(new),'changed_old_case_cardinality':changed,'added_case_cardinality':{case:62},'actual_subtest_count':None,'actual_case_results':None},f,indent=2);f.write('\n')
