"""Freeze own staged metadata/hand-off; no target namespace or process execution."""
import ast,collections,difflib,hashlib,json,os,stat
from datetime import datetime,timezone
from pathlib import Path
stage=Path(__file__).absolute().parent
work=stage.parent
def digest(data):return hashlib.sha256(data).hexdigest()
def win(path):
 path=str(path)
 return Path(path if path.startswith('\\\\?\\')else'\\\\?\\'+path)
def observe(path,expected=None):
 path=win(path);start=path.lstat()
 assert stat.S_ISREG(start.st_mode)and start.st_nlink==1 and not start.st_file_attributes&1024,path
 names=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
 raw=lambda item:[getattr(item,key)for key in names]
 p=raw(start)
 with path.open('rb')as f:
  opened=os.fstat(f.fileno());fraw=raw(opened)
  assert p[:4]+p[5:]==fraw[:4]+fraw[5:]and p[4]==p[8],path
  data=f.read(p[2]+1)
  assert raw(os.fstat(f.fileno()))==fraw,path
 assert raw(path.lstat())==p and len(data)==p[2],path
 record={'bytes':len(data),'sha256':digest(data),'path_raw9':p,'descriptor_raw9':fraw}
 if expected is not None:assert record==expected,path
 return data,record
def once(relative,value):
 path=stage/relative
 if type(value)is bytes:data=value
 elif type(value)is str:data=value.encode('utf8')
 else:data=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode('ascii')
 with path.open('xb')as f:f.write(data)
 return observe(path)[1]
preservation=json.loads(observe(stage/'PRESERVATION_BEFORE_IMPLEMENTATION_002.json')[0])
assert preservation['pair_count']==len(preservation['pairs'])==912
def pairs_pass():
 rows=[]
 for pair in preservation['pairs']:
  original=observe(pair['original'],pair['original_observation'])[1]
  copy=observe(stage/pair['copy_relative'],pair['copy_observation'])[1]
  assert original['sha256']==copy['sha256']==pair['sha256']and original['bytes']==pair['bytes']and original['path_raw9'][1]!=copy['path_raw9'][1]
  rows.append({'original_relative':pair['original_relative'],'sha256':pair['sha256'],'bytes':pair['bytes']})
 return digest((json.dumps(rows,sort_keys=True,separators=(',',':'))+'\n').encode('ascii'))
first_pair=pairs_pass()
audit=json.loads(observe(stage/'SOURCE_SHAPE_BUDGET_TEST_AUDIT_005.json')[0])
caller=json.loads(observe(stage/'CALLER_BOOTSTRAP_SHARED_SOURCE_AUDIT_003.json')[0])
caps=json.loads(observe(stage/'FINITE_ACQUISITION_DERIVATION_CONTRACT_003.json')[0])
assert len(audit['source_files'])==35 and caller['caller_count']==31
def assign(tree):return{n.targets[0].id:n.value for n in tree.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
def defs(tree):return{n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def dump(node):return ast.dump(node,include_attributes=False)
def data_ast(node,values):
 if isinstance(node,ast.Name):return values[node.id]
 if isinstance(node,ast.Call)and isinstance(node.func,ast.Name)and node.func.id=='frozenset':return frozenset(data_ast(node.args[0],values))
 if isinstance(node,ast.BinOp)and isinstance(node.op,ast.BitOr):return data_ast(node.left,values)|data_ast(node.right,values)
 return ast.literal_eval(node)
sources=[];tests=[]
(stage/'diffs').mkdir()
for index,row in enumerate(audit['source_files']):
 path=stage/row['path'];data,identity=observe(path)
 assert row['sha256']==identity['sha256']and row['bytes']==identity['bytes'],row['path']
 before_map=next(r for r in preservation['active_source_map']if r['active']==row['path'])
 old=next(r for r in preservation['pairs']if r['original_relative']==before_map['before'])
 olddata=observe(stage/old['copy_relative'],old['copy_observation'])[0]
 detail={'path':row['path'],'bytes':len(data),'sha256':identity['sha256'],'before_sha256':old['sha256'],'unchanged':data==olddata}
 if row['path'].endswith('.py.template')or path.suffix=='.py':
  tree=ast.parse(data);oldtree=ast.parse(olddata);newdefs,olddefs=defs(tree),defs(oldtree)
  assert set(olddefs)<=set(newdefs),row['path']
  detail.update(old_source_names_retained=True,added_source_names=sorted(set(newdefs)-set(olddefs)),changed_source_names=sorted(name for name in olddefs if dump(olddefs[name])!=dump(newdefs[name])))
  if row['path'].startswith('source/'):
   methods={c.name+'.'+m.name:m for c in tree.body if isinstance(c,ast.ClassDef)for m in c.body if isinstance(m,ast.FunctionDef)and m.name.startswith('test_')}
   assert len(methods)==row['method_count']
   policies=assign(tree)
   case={'path':row['path'],'bytes':len(data),'sha256':identity['sha256'],'named_methods':len(methods),'old_named_methods':row['old_method_count'],'old_method_names_retained':True,'old_method_ASTs_unchanged':row['old_method_ASTs_unchanged'],'changed_old_method_names':row['changed_old_method_names'],'added_method_names':row['added_method_names'],'method_AST_sha256':{name:digest(dump(node).encode())for name,node in sorted(methods.items())},'actual_case_results':None,'actual_subtest_count':None}
   if 'NATIVE_SUBTEST_POLICY'in policies:
    events=ast.literal_eval(policies['NATIVE_SUBTEST_POLICY']);families=ast.literal_eval(policies['NATIVE_CRITICAL_FAMILY_CASES'])
    assert len(events)==421 and len(families)==75
    for key,value in events.items():assert value['case_id']in methods and value['control_case_id']in methods,key
    for family,ids in families.items():assert ids and all(name in methods for name in ids),family
    case.update(declared_subtest_policy_count=len(events),critical_family_count=len(families),family_coverage=families,declared_subtest_counts=dict(collections.Counter(row['case_id']for row in events.values())))
   tests.append(case)
 if data!=olddata:
  diff=''.join(difflib.unified_diff(olddata.decode('utf8').splitlines(keepends=True),data.decode('utf8').splitlines(keepends=True),fromfile=before_map['before'],tofile=row['path']))
  detail['diff_path']=f'diffs/{index:02}.diff';once(detail['diff_path'],diff)
 sources.append(detail)
publisher=stage/'publication/publish-successor-admission-schema3-001.py.template'
tree=ast.parse(observe(publisher)[0]);assignments=assign(tree);keysets={}
for name in('METADATA_BASE_KEYS','METADATA_COMPLETION_KEYS','METADATA_FAILURE_KEYS'):
 keysets[name]=data_ast(assignments[name],keysets)
variants={ast.literal_eval(key):data_ast(value,keysets)for key,value in zip(assignments['METADATA_VARIANT_KEYS'].keys,assignments['METADATA_VARIANT_KEYS'].values)}
variants={kind:sorted(keysets['METADATA_BASE_KEYS']|extra|{'record_digest'})for kind,extra in variants.items()}
expected={'successor_publication_intent':18,'successor_publication_started':17,'successor_publication_complete':30,'successor_publication_failed':21,'successor_verification_intent':19,'successor_verification_started':17,'successor_verification_pass':33,'successor_verification_failed':21}
assert {kind:len(keys)for kind,keys in variants.items()}==expected
