assert type(plan['collected_nodes']) is int and plan['collected_nodes'] == 5575
nodes = []
offset = 0
partitions = []
for index, group in enumerate(groups):
    assert type(group['Name']) is str and re.fullmatch(r'[a-z0-9-]+', group['Name'])
    assert type(group['ExpectedNodes']) is int and group['ExpectedNodes'] == len(group['Nodes'])
    assert group['ExpectedNodes'] > 0 and all(type(n) is str for n in group['Nodes'])
    original_attempt = 'g9-' + group['Name'] + '-001'
    active_attempt = 'g9-' + group['Name'] + ('-002' if index == 1 else '-001')
    receipt_path = GATE / (active_attempt + '.accepted.json')
    receipt_present = not absent(receipt_path)
    if receipt_present:
        assert receipt_path == GATE / 'g9-governance-001.accepted.json'
    partitions.append({'index_zero_based': index, 'name': group['Name'],
                       'node_offset_start_inclusive': offset,
                       'node_offset_end_exclusive': offset + group['ExpectedNodes'],
                       'expected_nodes': group['ExpectedNodes'],
                       'nodes_sha256_compact_ascii_lf': sha((json.dumps(group['Nodes'],
                            ensure_ascii=True, separators=(',', ':')) + '\n').encode('ascii')),
                       'original_attempt': original_attempt, 'continuation001_attempt': active_attempt,
                       'accepted_receipt_path': str(receipt_path),
                       'accepted_receipt_present': receipt_present})
    offset += group['ExpectedNodes']
    nodes += group['Nodes']
assert offset == len(nodes) == len(set(nodes)) == 5575
