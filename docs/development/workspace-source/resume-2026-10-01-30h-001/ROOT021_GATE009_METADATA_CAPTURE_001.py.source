"""Author-owned stdlib metadata capture. Never import or execute project definitions."""
import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import re
import stat
import subprocess
import xml.etree.ElementTree as ET

PROJECT = Path('D:/Aenv/pro2')
WORK = PROJECT / 'resume-2026-10-01-30h-001'
SESSION_ROOT = PROJECT / 'resume-2026-09-28-001'
GATE = SESSION_ROOT / 'full-gate-009'
QA = PROJECT / 'resume-2026-09-05/qa-relocation'
LIVE = PROJECT / 'week8-recovery-controller-worktree'
GIT = PROJECT / 'runtimes/git/mingw64/bin/git.exe'
GIT_SHA = 'c115a66a1bede6694b513af420cc90f8775be03666a54d1ecb82d6196b929fe9'
OWNER_SHA = '3ea2fb0aa19fb4526c93fa8429d140b415a0afe118f62fe1691067d7945b2eff'
OUT = WORK / 'ROOT021_GATE009_METADATA_OBSERVATION_001.json'
MD = WORK / 'ROOT021_GATE009_METADATA_OBSERVATION_001.md'
COPIES = WORK / 'ROOT021_GATE009_METADATA_INPUTS_001'
MAX_BYTES = 8 * 1024 * 1024

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')

def sha(blob):
    return hashlib.sha256(blob).hexdigest()

def enc(value):
    return (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns,
            s.st_mode, s.st_nlink, getattr(s, 'st_file_attributes', 0),
            getattr(s, 'st_birthtime_ns', None)]

def cross5(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_nlink]

def directory(path):
    for parent in reversed((path, *path.parents)):
        s = parent.lstat()
        assert stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode), str(parent)
        assert not getattr(s, 'st_file_attributes', 0) & 0x400, str(parent)

def read(path):
    directory(path.parent)
    p0 = path.lstat()
    assert stat.S_ISREG(p0.st_mode) and p0.st_nlink == 1, str(path)
    assert not getattr(p0, 'st_file_attributes', 0) & 0x400, str(path)
    assert 0 <= p0.st_size <= MAX_BYTES, str(path)
    with path.open('rb') as handle:
        f0 = os.fstat(handle.fileno())
        assert stat.S_ISREG(f0.st_mode) and f0.st_nlink == 1
        assert cross5(p0) == cross5(f0), str(path)
        blob = handle.read(MAX_BYTES + 1)
        f1 = os.fstat(handle.fileno())
    p1 = path.lstat()
    assert raw9(p0) == raw9(p1) and raw9(f0) == raw9(f1), str(path)
    assert cross5(p1) == cross5(f1) and len(blob) == p0.st_size, str(path)
    return blob, {'path': str(path), 'sha256': sha(blob), 'bytes': len(blob),
                  'path_raw9': raw9(p0), 'descriptor_raw9': raw9(f0)}

def strict(blob):
    def pairs(items):
        value = {}
        for key, item in items:
            assert key not in value, 'duplicate JSON key'
            value[key] = item
        return value
    def finite(token):
        value = float(token)
        assert math.isfinite(value), 'nonfinite JSON number'
        return value
    def invalid(token):
        raise ValueError('nonfinite JSON constant: ' + token)
    return json.loads(blob.decode('utf-8'), object_pairs_hook=pairs,
                      parse_float=finite, parse_constant=invalid)

def write(path, blob):
    directory(path.parent)
    assert not path.exists(), str(path)
    with path.open('xb') as handle:
        handle.write(blob)
        handle.flush()
        os.fsync(handle.fileno())
    observed, row = read(path)
    assert observed == blob
    return row

def gate_names():
    directory(GATE)
    return sorted(item.name for item in GATE.iterdir())

def absent(path):
    directory(path.parent)
    try:
        path.lstat()
    except FileNotFoundError:
        return True
    return False

started = now()
directory(WORK)
assert not OUT.exists() and not MD.exists() and not COPIES.exists()
gate_initial_names = gate_names()
git_bytes, git_row = read(GIT)
assert sha(git_bytes) == GIT_SHA
env = {k: v for k, v in os.environ.items()
       if not k.upper().startswith(('GIT_', 'PYTHON'))}
env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_SYSTEM=os.devnull,
           GIT_CONFIG_NOSYSTEM='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C')
controls = ['--no-pager', '--no-optional-locks', '-c', 'core.fsmonitor=false',
            '-c', 'core.untrackedCache=false', '-c', 'core.hooksPath=NUL',
            '-c', 'core.quotepath=false', '-c', 'safe.directory=' + LIVE.as_posix(),
            '-C', str(LIVE)]
git_observations = []

def git(*args):
    before, row0 = read(GIT)
    assert sha(before) == GIT_SHA
    completed = subprocess.run([str(GIT), *controls, *args], env=env,
                               stdin=subprocess.DEVNULL, capture_output=True,
                               timeout=30, check=True)
    assert not completed.stderr
    after, row1 = read(GIT)
    assert before == after and row0 == row1
    git_observations.append({'args': list(args), 'stdout_sha256': sha(completed.stdout),
                             'stdout_bytes': len(completed.stdout),
                             'exit_code': completed.returncode, 'stderr_bytes': 0})
    return completed.stdout

