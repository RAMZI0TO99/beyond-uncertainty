param([Parameter(Mandatory=$true)][string]$ExpectedSelfSha256,[Parameter(Mandatory=$true)][string]$ExpectedAuthorizationSha256)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$Prep = 'D:\Aenv\pro2\resume-2026-10-01-30h-001\consumer-guard-test-runtime005'
$Work = 'D:\Aenv\pro2\resume-2026-10-01-30h-001'
$Python = 'D:\Aenv\pro2\runtimes\week8-python313-frozen-001\python.exe'
$Script = Join-Path $Prep 'observe-whole-runtime-005.BOUND.py'
$Profile = Join-Path $Prep 'GUARD_RUNTIME_PROFILE_005.json'
$Review = Join-Path $Prep 'INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_005.json'
$Owner = Join-Path $Work 'OWNER_WORK_WINDOW_30H_20261001_001.json'
$Auth = Join-Path $Prep 'ROOT_WHOLE_BEFORE_AUTHORIZATION_005.json'
$Start = Join-Path $Prep 'ROOT_WHOLE_BEFORE_PARENT_START_005.json'
$Terminal = Join-Path $Prep 'ROOT_WHOLE_BEFORE_PARENT_TERMINAL_005.json'
$Stdout = Join-Path $Prep 'ROOT_WHOLE_BEFORE_PARENT_STDOUT_005.txt'
$Stderr = Join-Path $Prep 'ROOT_WHOLE_BEFORE_PARENT_STDERR_005.txt'
$ObserverSha = '1bdaa7667fbb4b56d2b46b506e8ea6ed50b7c83c33cfe2c405cdd7b944405831'
$ProfileSha = '6063125d058ed6ae901b5aca7017785434ba702baad35c97405c6b6286abb5eb'
$ReviewSha = 'aa73d51d0e0e5ce604dc851d3cefef42dd5f901bd4fc759b581d29a64b9aac6a'
$OwnerSha = '3ea2fb0aa19fb4526c93fa8429d140b415a0afe118f62fe1691067d7945b2eff'
$Scope = 'COPIED_CONSUMER_GUARD_UNIT005_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'

function Pin([string]$Path,[string]$Expected,[long]$Cap) {
    if ($Expected -cnotmatch '^[0-9a-f]{64}$' -or $Cap -le 0) { throw 'Invalid exact pin/cap' }
    $item = Get-Item -LiteralPath $Path -Force
    if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -or $item.Length -gt $Cap) { throw 'Nonplain or oversized input' }
    $stream = [IO.File]::Open($Path,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
    try {
        if ($stream.Length -ne $item.Length -or $stream.Length -gt $Cap) { throw 'Opened input size differs before allocation' }
        $memory = [IO.MemoryStream]::new()
        try {
            $buffer = [byte[]]::new(4096)
            do {
                $count = $stream.Read($buffer,0,$buffer.Length)
                if ($memory.Length + $count -gt $Cap) { throw 'Opened input cap exceeded' }
                $memory.Write($buffer,0,$count)
            } while ($count -gt 0)
            $bytes = $memory.ToArray()
        } finally { $memory.Dispose() }
    } finally { $stream.Dispose() }
    $hasher = [Security.Cryptography.SHA256]::Create()
    try { $hash = [BitConverter]::ToString($hasher.ComputeHash($bytes)).Replace('-','').ToLowerInvariant() } finally { $hasher.Dispose() }
    $last = Get-Item -LiteralPath $Path -Force
    if ($last.PSIsContainer -or ($last.Attributes -band [IO.FileAttributes]::ReparsePoint) -or
        $hash -cne $Expected -or $bytes.Length -ne $item.Length -or $item.Length -ne $last.Length -or
        $item.LastWriteTimeUtc.Ticks -ne $last.LastWriteTimeUtc.Ticks -or
        $item.CreationTimeUtc.Ticks -ne $last.CreationTimeUtc.Ticks -or $item.Attributes -ne $last.Attributes) { throw 'Input pin or FileInfo metadata drift' }
    # FileInfo does not establish nlink/inode/descriptor identity or an atomic retained execution lock.
    return ,$bytes
}

function Write-Once([string]$Path,$Record) {
    $bytes = [Text.UTF8Encoding]::new($false,$true).GetBytes(($Record | ConvertTo-Json -Compress -Depth 8) + "`n")
    if ($bytes.Length -gt 65536) { throw 'Parent receipt cap' }
    $stream = [IO.File]::Open($Path,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
    try { $stream.Write($bytes,0,$bytes.Length); $stream.Flush($true) } finally { $stream.Dispose() }
}

function Authorization-Stamp($Value) {
    if ($Value -isnot [string] -or $Value -cnotmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{7}\+00:00\z') { throw 'Authorization requires genuine canonical ROOT PowerShell UTC33' }
    $stamp = [DateTimeOffset]::ParseExact($Value,'o',[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None)
    if ($stamp.Offset -ne [TimeSpan]::Zero -or $stamp.ToString('o',[Globalization.CultureInfo]::InvariantCulture) -cne $Value) { throw 'Authorization UTC roundtrip differs' }
    return $stamp
}

function Before-Authorization($Record) {
    $keys = @('schema_version','record_type','author','scope','phase','created_utc','expires_utc','observer_sha256','profile_sha256','static_review_sha256','owner_sha256','runtime_snapshot','context_selection','before_record_sha256','unit_receipt')
    $names = @($Record.PSObject.Properties.Name)
    if ($Record -isnot [pscustomobject] -or $names.Count -ne 15 -or @($names | Where-Object { $keys -cnotcontains $_ }).Count -ne 0) { throw 'Whole-before authorization exact15 keys differ' }
    foreach ($name in @('record_type','author','scope','phase','observer_sha256','profile_sha256','static_review_sha256','owner_sha256')) {
        if ($Record.$name -isnot [string]) { throw 'Authorization nominal string differs' }
    }
    if (($Record.schema_version -isnot [int] -and $Record.schema_version -isnot [long]) -or $Record.schema_version -ne 1 -or
        $Record.record_type -cne 'consumer_guard_unit005_metadata_observation_authorization' -or
        $Record.author -cne '/root' -or $Record.scope -cne $Scope -or $Record.phase -cne 'before' -or
        $Record.observer_sha256 -cne $ObserverSha -or $Record.profile_sha256 -cne $ProfileSha -or
        $Record.static_review_sha256 -cne $ReviewSha -or $Record.owner_sha256 -cne $OwnerSha -or
        $null -ne $Record.before_record_sha256 -or $null -ne $Record.unit_receipt) { throw 'Whole-before authorization role/pins differ' }
    foreach ($name in @('runtime_snapshot','context_selection')) {
        $pointer = $Record.$name
        if ($pointer -isnot [pscustomobject] -or @($pointer.PSObject.Properties.Name).Count -ne 2 -or
            @($pointer.PSObject.Properties.Name | Where-Object { @('path','sha256') -cnotcontains $_ }).Count -ne 0 -or
            $pointer.path -isnot [string] -or $pointer.path.Length -eq 0 -or $pointer.path.Length -gt 32767 -or
            $pointer.sha256 -isnot [string] -or $pointer.sha256 -cnotmatch '^[0-9a-f]{64}$') { throw 'Whole-before pointer nominal shape differs' }
    }
    $created = Authorization-Stamp $Record.created_utc
    $expires = Authorization-Stamp $Record.expires_utc
    $now = [DateTimeOffset]::UtcNow
    $ownerEnd = [DateTimeOffset]::Parse('2026-10-02T22:36:15Z',[Globalization.CultureInfo]::InvariantCulture)
    $age = ($now-$created).TotalSeconds
    if ($age -lt 0 -or $age -gt 600 -or ($expires-$created).TotalSeconds -le 0 -or
        ($expires-$created).TotalSeconds -gt 1800 -or $expires -gt $ownerEnd -or
        ($expires-$now).TotalSeconds -lt 315 -or ($ownerEnd-$now).TotalSeconds -lt 350) { throw 'Fresh authorization,315-second expiry and350-second owner reserves required' }
    return $now
}

if ([IO.Path]::GetFullPath($PSCommandPath) -cne (Join-Path $Prep 'SUPERVISE_ROOT_WHOLE_BEFORE_005.ps1')) { throw 'Fixed whole-before supervisor path required' }
[void](Pin $PSCommandPath $ExpectedSelfSha256 65536)
[void](Pin $Python '5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed' 105816)
[void](Pin $Script $ObserverSha 26697)
[void](Pin $Profile $ProfileSha 65536)
[void](Pin $Review $ReviewSha 65536)
[void](Pin $Owner $OwnerSha 65536)
$authBytes = Pin $Auth $ExpectedAuthorizationSha256 65536
foreach ($path in @($Start,$Terminal,$Stdout,$Stderr,(Join-Path $Prep 'whole-runtime-before'),(Join-Path $Prep 'whole-runtime-after'),(Join-Path $Prep 'ROOT_WHOLE_AFTER_AUTHORIZATION_005.json'))) {
    try { [void](Get-Item -LiteralPath $path -Force -ErrorAction Stop); throw 'One-use whole-before namespace exists' }
    catch [System.Management.Automation.ItemNotFoundException] { }
}
$authRecord = [Text.UTF8Encoding]::new($false,$true).GetString($authBytes) | ConvertFrom-Json
$now = Before-Authorization $authRecord
$info = [Diagnostics.ProcessStartInfo]::new()
$info.FileName = $Python
$info.Arguments = '-I -S -B -X utf8 "' + $Script + '" --expected-self-sha256 ' + $ObserverSha + ' --expected-profile-sha256 ' + $ProfileSha + ' --authorization-path "' + $Auth + '" --authorization-sha256 ' + $ExpectedAuthorizationSha256 + ' --static-review-path "' + $Review + '"'
$info.WorkingDirectory = $Prep
$info.UseShellExecute = $false
$info.CreateNoWindow = $true
$info.RedirectStandardInput = $true
$info.RedirectStandardOutput = $true
$info.RedirectStandardError = $true
foreach ($name in @($info.EnvironmentVariables.Keys)) { if ($name -match '^(PYTHON|GIT_)') { $info.EnvironmentVariables.Remove($name) } }
$info.EnvironmentVariables['PYTHONDONTWRITEBYTECODE']='1'
foreach ($name in @('OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS')) { $info.EnvironmentVariables[$name]='1' }
$process = [Diagnostics.Process]::new()
$process.StartInfo = $info
$outFile = $null; $errFile = $null; $watch = [Diagnostics.Stopwatch]::new()
$started = $false; $reaped = $false; $drained = $false; $overflow = $false; $timedOut = $false; $failure = $null; $code = $null; $outBytes = 0; $errBytes = 0
Write-Once $Start ([ordered]@{schema_version=1;created_utc=$now.ToString('o');phase='before';authorization_sha256=$ExpectedAuthorizationSha256;supervisor_sha256=$ExpectedSelfSha256;observer_sha256=$ObserverSha;profile_sha256=$ProfileSha;static_review_sha256=$ReviewSha;metadata_only=$true;consumed=$true;expected_inventory_trees=2;expected_runtime_file_guards=4})
try {
    $outFile = [IO.File]::Open($Stdout,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
    $errFile = [IO.File]::Open($Stderr,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::Read)
    # Recheck actual UTC reserves after receipt/capture creation, immediately before entry.
    [void](Before-Authorization $authRecord)
    $watch.Start()
    if (-not $process.Start()) { throw 'Whole-before direct child failed to start' }
    $started = $true
    $process.StandardInput.BaseStream.Close()
    $outBuffer = [byte[]]::new(4096); $errBuffer = [byte[]]::new(4096)
    $outTask = $process.StandardOutput.BaseStream.ReadAsync($outBuffer,0,4096)
    $errTask = $process.StandardError.BaseStream.ReadAsync($errBuffer,0,4096)
    $outDone = $false; $errDone = $false
    while (-not ($reaped -and $outDone -and $errDone)) {
        foreach ($channel in @('out','err')) {
            $task = if ($channel -ceq 'out') { $outTask } else { $errTask }
            $done = if ($channel -ceq 'out') { $outDone } else { $errDone }
            if (-not $done -and $task.IsCompleted) {
                $count = $task.GetAwaiter().GetResult()
                if ($count -eq 0) { if ($channel -ceq 'out') { $outDone=$true } else { $errDone=$true } }
                else {
                    $used = if ($channel -ceq 'out') { $outBytes } else { $errBytes }
                    $keep = [Math]::Min($count,65536-$used)
                    if ($channel -ceq 'out') { $outFile.Write($outBuffer,0,$keep); $outBytes += $keep; $outTask=$process.StandardOutput.BaseStream.ReadAsync($outBuffer,0,4096) }
                    else { $errFile.Write($errBuffer,0,$keep); $errBytes += $keep; $errTask=$process.StandardError.BaseStream.ReadAsync($errBuffer,0,4096) }
                    if ($keep -lt $count) { $overflow=$true }
                }
            }
        }
        if (($overflow -or $watch.Elapsed.TotalSeconds -ge 300) -and -not $process.HasExited) { $timedOut=($watch.Elapsed.TotalSeconds -ge 300); $process.Kill() }
        if ($process.HasExited) { $reaped=$process.WaitForExit(0); if ($reaped) { $code=$process.ExitCode } }
        if ($watch.Elapsed.TotalSeconds -ge 315) { throw 'Whole-before cooperative capture/reap budget exhausted' }
        Start-Sleep -Milliseconds 20
    }
    $drained=$true
} catch { $failure=$_.Exception.Message }
finally {
    if ($started -and -not $reaped) {
        try { if (-not $process.HasExited) { $process.Kill() }; $reaped=$process.WaitForExit(1000); if ($reaped) { $code=$process.ExitCode } }
        catch { $failure=([string]$failure)+'; direct child cleanup unproved' }
    }
    if ($null -ne $outFile) { $outFile.Dispose() }
    if ($null -ne $errFile) { $errFile.Dispose() }
    $process.Dispose()
    # Exit0 alone does not reconcile observer metadata. Neither tree observation nor descendant death is inferred.
    Write-Once $Terminal ([ordered]@{schema_version=1;finished_utc=[DateTimeOffset]::UtcNow.ToString('o');phase='before';exit_code=$code;timed_out=$timedOut;capture_overflow=$overflow;capture_drain_complete=$drained;direct_child_reaped=$reaped;failure=$failure;stdout_bytes=$outBytes;stderr_bytes=$errBytes;authorization_sha256=$ExpectedAuthorizationSha256;supervisor_sha256=$ExpectedSelfSha256;observer_sha256=$ObserverSha;profile_sha256=$ProfileSha;static_review_sha256=$ReviewSha;metadata_only=$true;spent=$true;expected_inventory_trees=2;expected_runtime_file_guards=4;whole_inventory_trees_observed=$null;runtime_file_guards_observed=$null;observer_result_reconciled=$false;whole_site_loaded_closure_guaranteed=$false;target_tests_executed=$false;operational_authority_granted=$false;native_authority_granted=$false;descendant_cleanup_guaranteed=$false;OS_Job_hard_memory_bound=$false;unconditional_physical_IO_deadline_guaranteed=$false})
}
if ($timedOut -or $overflow -or $failure -or -not $drained -or -not $reaped -or $code -ne 0) { throw 'Whole-before first entry refused; preserve every output; never replay' }
