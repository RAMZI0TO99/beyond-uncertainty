"""Preserve a pre-publication docs utility refusal and create a distinct successor."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib,json,os
base=Path('D:/Aenv/pro2/resume-2026-10-01-30h-001')
old=base/'PREPARE_ROOT_DOCS_REFRESH_024.py'
new=base/'PREPARE_ROOT_DOCS_REFRESH_024_CONTINUATION_002.py'
record_path=base/'ROOT_DOCS24_PREPUBLICATION_REFUSAL_001.json'
for p in (new,record_path,base/'root-docs-before-major024',base/'root-docs-inputs-major024',
          base/'30H_RESUME_CHECKPOINT_024.md',base/'DOCS_REFRESH_AUDIT_024.json'):
    assert not p.exists(),str(p)
source=old.read_bytes()
needle=b"== 'PASS_FROZEN_CREATION_SCOPE'"
assert source.count(needle)==1
corrected=source.replace(needle,b"== 'PASS_DOCUMENTATION_FROZEN_CREATION_SCOPE_ONLY'")
assert corrected.count(b"    'OWNER_WORK_WINDOW_30H_20261001_001.json',")==1
corrected=corrected.replace(b"    'OWNER_WORK_WINDOW_30H_20261001_001.json',",
    b"    'OWNER_WORK_WINDOW_30H_20261001_001.json', 'ROOT_DOCS24_PREPUBLICATION_REFUSAL_001.json',")
needle2=b"Earlier source/refusal/actor histories and primary before bytes remain."
# Insert separate refusal provenance without changing frozen001.
anchor=b"observed. All earlier source/refusal/actor histories and primary before bytes remain."
assert corrected.count(anchor)==1
corrected=corrected.replace(anchor,anchor+b"\nRoot docs publisher001 refused before any writes because its expected peer verdict\nspelling was wrong; refusal record is preserved and this distinct002 corrects that\nmetadata expectation. No primary document or target runtime was changed by001.")
sha=lambda data:hashlib.sha256(data).hexdigest()
record=dict(schema_version=1,created_utc=datetime.now(timezone.utc).isoformat(),
    record_type='root_docs24_prepublication_source_literal_refusal',author='/root',
    tool_chunk='45c4bb',exit_code=1,refusal='AssertionError at line39: wrong expected documentation peer verdict literal',
    prior_utility_sha256=sha(source),prior_utility_preserved=True,prior_utility_spent=True,
    actual_peer_verdict='PASS_DOCUMENTATION_FROZEN_CREATION_SCOPE_ONLY',
    primary_mutations_performed=False,new_checkpoint_or_baselines_created=False,
    continuation_path=str(new),continuation_sha256=sha(corrected),
    operational_helper_or_target_execution=False)
for path,data in [(record_path,(json.dumps(record,indent=2,sort_keys=True)+'\n').encode('ascii')),(new,corrected)]:
    with path.open('xb') as stream:stream.write(data);stream.flush();os.fsync(stream.fileno())
print(json.dumps(dict(record_sha256=sha(record_path.read_bytes()),successor_sha256=sha(corrected))))
