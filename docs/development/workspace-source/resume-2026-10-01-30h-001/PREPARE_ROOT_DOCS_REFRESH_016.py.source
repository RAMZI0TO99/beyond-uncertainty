    proof = 'exact_before_copy'
    if path.name == 'AGENTS.md':
        assert path.read_bytes().endswith(value)
        proof = 'exact_retained_suffix'
    if path.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert path.read_bytes().startswith(value)
        proof = 'exact_retained_prefix'
    baseline.append({'primary': path.relative_to(ROOT).as_posix(),
                     'before': row(BEFORE / path.relative_to(ROOT)), 'proof': proof})
once(BASE / 'DOCS_REFRESH_BASELINE_016.json', encode({'schema_version': 1, 'created_utc': stamp, 'files': baseline}))
inputs = [{'original': row(BASE / name), 'copy': row(INPUTS / name)} for name in names]
once(BASE / 'DOCS_REFRESH_INPUTS_016.json', encode({'schema_version': 1, 'created_utc': stamp, 'inputs': inputs}))
declared = [*primary, checkpoint, BASE / 'DOCS_REFRESH_BASELINE_016.json', BASE / 'DOCS_REFRESH_INPUTS_016.json',
            *[BEFORE / path.relative_to(ROOT) for path in primary], *[INPUTS / name for name in names]]
facts = {'owner_end_utc': '2026-10-02T22:36:15Z', 'raw004_verdict': runtime_peer['verdict'],
         'raw004_actual_nodes': 171, 'raw004_passed': 169, 'raw004_expected_skips': 2,
         'raw004_failures': 0, 'raw004_errors': 0, 'raw004_spent': True,
         'whole_runtime_after_verdict': after_tree['verdict'], 'consumer002': guard_status,
         'consumer003': 'PASS_STATIC_SOURCE_AND_TESTS_ONLY_14_UNRUN',
         'consumer_guard_runtime001': 'PERMANENTLY_HELD_UNBOUND_UNRUN',
         'consumer_guard_runtime002': 'AUTHORING_UNBOUND_UNRUN',
         'assembly003': 'INAPPLICABLE_FOR_EXECUTION', 'native001': 'REFUSED_STATIC',
         'native_design002': design_status, 'root_native_binding_design_choice': 'UNIFORM44',
         'outer003': 'STATIC_PREPARATION_ONLY_UNBOUND_UNRUN', 'root_live_executor_ack_received': False,
         'native_whole_window_quiet_agreed': False, 'live_head_observed': context['head'],
         'monitor_observed_disabled': True, 'cleanup_or_live_source_apply_performed': False,
         'operational_fit_science_or_publication_authority': False}
audit = {'schema_version': 1, 'checkpoint': 16, 'created_utc': stamp,
         'status': 'AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW', 'files': [row(path) for path in declared],
         'actual_input_count': len(inputs), 'maintained_links': links, 'facts': facts}
once(BASE / 'DOCS_REFRESH_AUDIT_016.json', encode(audit))
print(json.dumps({'checkpoint_sha256': sha(checkpoint.read_bytes()), 'audit_sha256': sha(encode(audit)),
                  'declared_files': len(declared), 'inputs': len(inputs), 'maintained_links': len(links)}))
