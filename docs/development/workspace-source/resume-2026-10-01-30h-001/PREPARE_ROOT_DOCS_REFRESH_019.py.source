failed = json.loads(data['resume-2026-09-28-001/full-gate-009/driver-failed.json'].decode('utf-8'))
assert failed['accepted_before'] == 1 and failed['result_sha256'] is None
assert 'PASS' in docs['verdict'] and grammar['verdict'] == 'STATIC_TEST_PREPARATION_ONLY'
assert compact.get('approved_for_execution', False) is False
native_review = load(native_optional[0]) if all(optional_present) else None
stamp = datetime.now(timezone.utc).isoformat()
native_status = native_review['verdict'] if native_review else 'DIFFERENT_DESIGN_REVIEW_PENDING'
