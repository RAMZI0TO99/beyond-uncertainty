"""Create-once major019 docs; preserve history and validate every new link first."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import os
import re

ROOT = Path('D:/Aenv/pro2')
BASE = ROOT / 'resume-2026-10-01-30h-001'
BEFORE = BASE / 'root-docs-before-major019'
INPUTS = BASE / 'root-docs-inputs-major019'
CHECKPOINT = BASE / '30H_RESUME_CHECKPOINT_019.md'
assert not BEFORE.exists() and not INPUTS.exists() and not CHECKPOINT.exists()

def sha(b):
    return hashlib.sha256(b).hexdigest()

def encoded(v):
    return (json.dumps(v, indent=2, sort_keys=True, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def once(p, b):
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open('xb') as stream:
        stream.write(b)
        stream.flush()
        os.fsync(stream.fileno())

def row(p):
    b = p.read_bytes()
    return dict(path=p.relative_to(ROOT).as_posix(), bytes=len(b), sha256=sha(b))

local = [
    '30H_RESUME_CHECKPOINT_018.md', 'DOCS_REFRESH_AUDIT_018.json',
    'INDEPENDENT_DOCS_REFRESH_REVIEW_018.json', 'INDEPENDENT_DOCS_REFRESH_REVIEW_018.md',
    'INDEPENDENT_ACTUAL_GATE008_CONTINUATION_REVIEW_001.json',
    'consumer-guard-test-runtime004/GUARD_RUNTIME_PREPARATION_MANIFEST_004.json',
