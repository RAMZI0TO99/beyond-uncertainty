optional_present = [(BASE / n).is_file() for n in native_optional]
assert optional_present[0] == optional_present[1], 'Native review must be a frozen pair'
if all(optional_present):
    local += native_optional
names = ['resume-2026-10-01-30h-001/' + n for n in local] + [
    'resume-2026-09-28-001/full-gate-009/driver-start.json',
    'resume-2026-09-28-001/full-gate-009/driver-failed.json',
]
data = {n: (ROOT / n).read_bytes() for n in names}
key = lambda n: 'resume-2026-10-01-30h-001/' + n
short = lambda n: sha(data[key(n)])[:8]
load = lambda n: json.loads(data[key(n)].decode('utf-8'))
docs = load('INDEPENDENT_DOCS_REFRESH_REVIEW_018.json')
grammar = load('publisher-schema2-grammar-test-revision005/INDEPENDENT_METADATA_GRAMMAR_TEST_REVIEW_005.json')
compact = load('INDEPENDENT_FINITE_RELEASE_CHAIN_COMPACT_REVIEW_002.json')
