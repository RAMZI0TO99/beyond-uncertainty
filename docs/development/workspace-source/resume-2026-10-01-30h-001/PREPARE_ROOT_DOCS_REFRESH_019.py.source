maintained = []
for p, b in [(primary[0], header), (primary[1], handoff), (primary[2], start),
             (CHECKPOINT, body.encode()), (primary[3], entry), (primary[4], resource_entry)]:
    for target in re.findall(r'\]\(([^)]+)\)', b.decode('utf-8')):
        resolved = (p.parent / target).resolve()
        assert resolved == CHECKPOINT.resolve() or resolved.is_file(), (p, target)
        maintained.append(dict(document=p.relative_to(ROOT).as_posix(), target=target,
                               resolved_path=str(resolved)))
for n, b in data.items():
    assert (ROOT / n).read_bytes() == b
    once(INPUTS / n, b)
for p, b in before.items():
    once(BEFORE / p.relative_to(ROOT), b)
once(CHECKPOINT, body.encode())
for p, b in {primary[0]: header + before[primary[0]], primary[1]: handoff,
             primary[2]: start}.items():
    assert p.read_bytes() == before[p]
    p.write_bytes(b)
for p, b in [(primary[3], entry), (primary[4], resource_entry)]:
    assert p.read_bytes() == before[p]
    with p.open('ab') as stream:
        stream.write(b)
baseline = []
for p, b in before.items():
    proof = 'exact_before_copy'
    if p.name == 'AGENTS.md':
        assert p.read_bytes().endswith(b)
        proof = 'exact_retained_suffix'
    if p.name in ('SESSION.md', 'RESOURCE_COORDINATION.md'):
        assert p.read_bytes().startswith(b)
        proof = 'exact_retained_prefix'
    baseline.append(dict(primary=p.relative_to(ROOT).as_posix(),
                         before=row(BEFORE / p.relative_to(ROOT)), proof=proof))
once(BASE / 'DOCS_REFRESH_BASELINE_019.json', encoded(dict(schema_version=1, created_utc=stamp, files=baseline)))
input_rows = [dict(original=row(ROOT / n), copy=row(INPUTS / n)) for n in names]
once(BASE / 'DOCS_REFRESH_INPUTS_019.json', encoded(dict(schema_version=1, created_utc=stamp, inputs=input_rows)))
declared = [*primary, CHECKPOINT, BASE / 'DOCS_REFRESH_BASELINE_019.json',
            BASE / 'DOCS_REFRESH_INPUTS_019.json', *[BEFORE / p.relative_to(ROOT) for p in primary],
            *[INPUTS / n for n in names]]
