"""One-use Root source preparation choice; no selected target is executed."""
from pathlib import Path
from datetime import datetime,timezone
import ast,hashlib,json,os
base=Path('D:/Aenv/pro2/resume-2026-10-01-30h-001')
folder=base/'raw-consumer-binding-integration-prep004'
peer=base/'consumer004-metaclass-equality-static-audit001/INDEPENDENT_CONSUMER004_METACLASS_REFUSAL_001.json'
manifest=folder/'STAGED_MANIFEST_004.json'
outputs=[base/'ROOT_CONSUMER_TYPE_IDENTITY_CORRECTION_007.json',base/'ROOT_CONSUMER_TYPE_IDENTITY_CORRECTION_007.md']
for path in outputs:assert not path.exists(),str(path)
sha=lambda data:hashlib.sha256(data).hexdigest()
peer_bytes=peer.read_bytes();manifest_bytes=manifest.read_bytes()
assert sha(peer_bytes)=='1f6d079a73d603d342a73a90b374850ff35d786adb1fdf3075da4e359aeefbb1'
assert sha(manifest_bytes)=='8a5b03ba0efd04a35d5a61f54233d4d05b663f5821baeb50b827698e27822ccb'
report=json.loads(peer_bytes)
assert report['verdict']=='REFUSED_SCOPED_NOMINAL_MAPPING_CLOSURE_SOURCE_ONLY'
bindings=json.loads((folder/'SOURCE_GUARD_TEST_BINDINGS_004.json').read_bytes())
rows=[]
for role,selection in bindings['consumers'].items():
    path=folder/selection['path'];data=path.read_bytes()
    assert sha(data)==selection['sha256'] and len(data)==selection['size']
    tree=ast.parse(data)
    fn=next(node for node in tree.body if isinstance(node,ast.FunctionDef) and node.name=='_raw_helper_value_identity')
    comparisons=[node for node in ast.walk(fn) if isinstance(node,ast.Compare)
        and isinstance(node.left,ast.Name) and node.left.id=='kind' and any(isinstance(op,ast.In) for op in node.ops)]
    assert len(comparisons)==4
    branches=[ast.get_source_segment(data.decode(),node) for node in comparisons]
    assert set(branches)=={'kind in (bool, int, float, str)','kind in (dict, MappingProxyType)',
        'kind in (tuple, list, set, frozenset)','kind in (set, frozenset)'}
    rows.append(dict(role=role,path=str(path),sha256=sha(data),bytes=len(data),four_membership_comparisons=branches))
assert len(rows)==5
stamp=datetime.now(timezone.utc).isoformat(timespec='microseconds')
assert datetime.now(timezone.utc)<datetime(2026,10,2,22,36,15,tzinfo=timezone.utc)
record=dict(schema_version=1,record_type='root_consumer_type_identity_source_correction_choice',
    author='/root',created_utc=stamp,owner_end_utc='2026-10-02T22:36:15Z',
    prior_choice006_preserved=True,prior_Consumer004_frozen_unapproved=True,
    independent_scoped_refusal=dict(path=str(peer),sha256=sha(peer_bytes),whole811_approval=False),
    prior_manifest=dict(path=str(manifest),sha256=sha(manifest_bytes)),root_AST_corroboration=rows,
    assigned_author='/root/candidate_review',destination='raw-consumer-binding-integration-prep005',
    authorized_source_changes={
        'kind in (bool, int, float, str)':'kind is bool or kind is int or kind is float or kind is str',
        'kind in (dict, MappingProxyType)':'kind is dict or kind is MappingProxyType',
        'kind in (tuple, list, set, frozenset)':'kind is tuple or kind is list or kind is set or kind is frozenset',
        'kind in (set, frozenset)':'kind is set or kind is frozenset'},
    source_constraints='Only these four identity predicates in each of the five selected value-identity helpers. Preserve recursive rows, ordering, refusal, genuine values, trusted imports, Raw004 pins, all other source functions/ASTs and API/default/code/global/import/registry guards.',
    required_tests=['Preserve all19 prior method ASTs where feasible and all old14 exactly.',
        'Each of five roles cold and reuse has genuine healthy before and restored controls.',
        'M1 selective mapping type equality; M2 primitive type equality retag; M3 simultaneous primitive type and instance fingerprint equality; M4 later sequence type equality.',
        'Assert no foreign metaclass equality, value equality, items or iteration callback occurs with corrected predicates; each negative is causally reached rather than failing stale pins/fixture setup.',
        'Genuine builtin, dict/proxy, tuple/list/set/frozenset recursive fingerprints and ordering remain healthy.'],
    preservation='Preserve all actual004 files before copying plus new scoped refusal/manifest selected pairs. Never rewrite prior choices, sources, manifests, author qualifiers, peer refusals or tests.',
    untouched_Path_semantics='Existing isinstance(value,Path) behavior is unchanged; nominal rejection for foreign Path-like objects/subclasses is not established by this narrow correction. Do not claim unconditional identity closure for all supported values.',
    inert_compile_metadata='Choice005 only: authenticated Raw004 plus six selected AST projections compiled to inert CodeTypes without exec/eval/FunctionType/target definitions/imports/calls/tests/Git/FFI/native.',
    different_complete_source_and_causal_test_review_required=True,
    operational_binding_or_runtime_or_live_apply_authorized=False,
    API_role_field_cap_epoch_science_or_public_change_authorized=False)
note=f'''# Root exact type predicate correction007

Recorded {stamp}; owner ends2026-10-02T22:36:15Z.
Different scoped source audit1f6d079a and Root's five-source AST corroboration show
that Mapping-only identity cannot reject the earlier primitive equality route.
A simultaneous foreign instance equality callback can satisfy the resulting
fingerprint comparison; later sequence membership can invoke foreign iteration.
These are unexecuted static causal models, not actual exploits or test results.

Candidate may author distinct Consumer005 replacing all FOUR kind-membership
predicates with explicit is disjunctions, preserving recursive behavior and every
other guard. Retain all actual004 history and19 prior method ASTs where feasible;
add causal cold/reuse/healthy/restored M1-M4 controls for five roles and callback
sentinels. Root006's literal spelling was followed but was itself insufficient.
The unchanged Path isinstance semantics remain outside nominal closure claims.

Different COMPLETE source/test peer precedes any new harness or actual binding.
Only previously scoped inert CodeType metadata compilation is permitted; no target
definitions/imports/calls/tests/Git/FFI/native/live/public action is authorized.
No policy/API/role/field/cap/epoch/science change or old helper replay follows.
'''.encode()
for path,data in [(outputs[0],(json.dumps(record,indent=2,sort_keys=True,allow_nan=False)+'\n').encode('ascii')),(outputs[1],note)]:
    with path.open('xb') as stream:stream.write(data);stream.flush();os.fsync(stream.fileno())
assert peer.read_bytes()==peer_bytes and manifest.read_bytes()==manifest_bytes
print(json.dumps(dict(choice_sha256=sha(outputs[0].read_bytes()),bytes=outputs[0].stat().st_size,
                     five_AST_sources_checked=True,target_execution=False)))
