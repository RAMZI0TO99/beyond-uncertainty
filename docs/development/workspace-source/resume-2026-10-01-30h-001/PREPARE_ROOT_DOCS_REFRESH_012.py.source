"""Root-only documentation refresh012. Distinct outputs, exact history, run once."""
from pathlib import Path
import datetime
import hashlib
import json
import re

ROOT = Path(r"D:\Aenv\pro2")
BASE = ROOT / "resume-2026-10-01-30h-001"
BEFORE = BASE / "root-docs-before-major012"
INPUTS = BASE / "root-docs-inputs-major012"
sha = lambda data: hashlib.sha256(data).hexdigest()
encode = lambda value: (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True, allow_nan=False)+"\n").encode("ascii")

def once(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(data)

def row(path):
    data = path.read_bytes()
    return {"path":str(path.relative_to(ROOT)).replace("\\", "/"),"bytes":len(data),"sha256":sha(data)}

names = [
    "30H_RESUME_CHECKPOINT_011.md", "DOCS_REFRESH_AUDIT_011.json",
    "INDEPENDENT_DOCS_REFRESH_REVIEW_011.json", "INDEPENDENT_DOCS_REFRESH_REVIEW_011.md",
    "successor-candidate-raw-revision003/RAW_POLICY_STAGED_MANIFEST_003.json",
    "successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.json",
    "successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.md",
    "raw-component-runtime-prep003/RAW_COMPONENT_PREPARATION_MANIFEST_003.json",
