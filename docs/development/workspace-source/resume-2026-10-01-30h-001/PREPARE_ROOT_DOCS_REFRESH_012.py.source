    "isolated-guard-test-supervisor001/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_001.json",
    "isolated-guard-test-supervisor001/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_001.md",
    "code-apply-018-prep-revision002/INDEPENDENT_APPLY018_PREPARATION_REVIEW_002.json",
    "code-apply-018-prep-revision002/INDEPENDENT_APPLY018_PREPARATION_REVIEW_002.md",
    "LIVE_D177_ROOT012_OBSERVATION_001.json", "ROOT012_HOST_OBSERVATION_001.json",
    "RAW003_CURRENT_LIVE_GUARD_ROOT012_001.json", "RAW003_RUNTIME_GUARD_ROOT012_001.json",
    "ROOT012_OBSERVATION_001_REFUSAL.json", "CAPTURE_ROOT012_READONLY_OBSERVATIONS_001.py",
    "CAPTURE_ROOT012_READONLY_OBSERVATIONS_002.py",
    "COORDINATION_WORKFLOW_HOLD_AND_ISOLATED_RAW_008.md",
    "COORDINATION_CODE_CORRECTION_BEFORE_GATE_007.md", "D177_TEST_INTEGRATION_REVIEW_001.md",
    "OWNER_WORK_WINDOW_30H_20261001_001.json", "OWNER_WORK_WINDOW_30H_20261001_001_REVIEW.md",
]
assert not BEFORE.exists() and not INPUTS.exists() and not (BASE / "DOCS_REFRESH_AUDIT_012.json").exists()
input_bytes = {name:(BASE/name).read_bytes() for name in names}
raw_review = json.loads(input_bytes["successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.json"])
assert raw_review["decision"] == "PASS_STATIC"
live = json.loads(input_bytes["LIVE_D177_ROOT012_OBSERVATION_001.json"])
host = json.loads(input_bytes["ROOT012_HOST_OBSERVATION_001.json"])
accepted = sum(r["name"].endswith(".accepted.json") for r in live["actor_gate008_top_level_file_observations"])
assert accepted == 29
assert [r["name"] for r in live["actor_gate008_top_level_file_observations"] if not r["name"].endswith(".accepted.json")] == ["driver-start.json", "plan.json"]
assert host["free_ram_bytes"] < 1073741824
short = lambda name: sha(input_bytes[name])[:8]
stamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
body = f"""# Major step012 - raw policy reviewed; new frozen preparation; execution holds retained

Recorded {stamp}. Reviewed local/private owner ends **2026-10-02T22:36:15Z**. [Root011 independent documentation PASS](INDEPENDENT_DOCS_REFRESH_REVIEW_011.json),{short('INDEPENDENT_DOCS_REFRESH_REVIEW_011.json')}, preserves its exact history. Prior checkpoint creation fields remain historical.

**Raw003 has independent STATIC source PASS, not runtime acceptance.** [Review](successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.json),{short('successor-candidate-raw-revision003/INDEPENDENT_RAW_POLICY_STATIC_REVIEW_003.json')}, checks19 frozen author inputs,67 caller snapshots,49 digest sites and full-width bounds. Exact schema1 remains separate from schema2 through the unique typed597 intermediate; all742 rows, authenticated grouped263 QA order and both finite25 deltas remain required. API12/seven input files and all34 prior test function ASTs are retained;11 functions added. N18/N19 malformed afterimage cases can refuse first on sorting and do not independently prove the compiled-nine predicate. Six physical/transitive negative IDs and five peer obligations, including actual final one-parent Git proof, locked-module fresh/reuse mutations, caller capture bounds and coherent outside-QA integration, remain deferred. No raw003 collection or test count is accepted.

**New isolated raw runtime preparation is frozen and UNRUN.** [Manifest](raw-component-runtime-prep003/RAW_COMPONENT_PREPARATION_MANIFEST_003.json),{short('raw-component-runtime-prep003/RAW_COMPONENT_PREPARATION_MANIFEST_003.json')}, pins37 files: exact raw003/test/two support copies, actual spent raw002 evidence and new Python driver/child/PowerShell launcher. [Contract](raw-component-runtime-prep003/BINDING_AND_EXECUTION_CONTRACT_003.md) requires a different static reviewer, distinct two-literal bound driver, external self SHA, fresh opaque current-live742/runtime snapshots, actual isolated coordination reply, root ACK and actual bound/late ACK-launch review before first entry. Counts derive from that first collection. Direct frozen base Python avoids the venv redirector; explicit pytest site path/one thread/autoload-cache-site-off,600s collection/3500s tests/4320s root limits remain. It does not prove full site closure, an OS write sandbox, hard log limits or descendant cleanup. Every actual invocation is one-use including pre-driver refusal. Driver/child/test definitions were not imported or run. The author cannot independently review this preparation.

**Schema2 publisher/verifier003 is frozen, awaiting independent source/test review.** [Manifest](publisher-schema2-revision003/STAGED_MANIFEST_003.json),{short('publisher-schema2-revision003/STAGED_MANIFEST_003.json')}, lists71 files excluding itself; [handoff](publisher-schema2-revision003/HANDOFF_003.md) records publisher b4c51fa5/verifier87cc98af and12 proposed pure methods, all UNRUN. Both producers are intended to independently acquire full old/middle/final742 Git rows/blobs twice, verify typed exact middle/final one-parent lineage, preserve historical grouped263 sequence and exact36 intermediate/34 final release roles, enforce both25 actual deltas and395799 attestation initial/reread/emission bounds. Four current paths, future release/manifest/raw-review/receipt facts, external metadata proof's own derived cap and verifier publisher pin remain unbound. Prior85 runtime/evidence is preserved and spent; it does not cover these new templates. No publication, postcommit or native acceptance.

**Three preparatory refusals are preserved, unrun.** [Front37 harness001 review](native-attempt013-front-test-runtime001/INDEPENDENT_FRONT_GUARD_TEST_RUNTIME_STATIC_REVIEW_001.json),{short('native-attempt013-front-test-runtime001/INDEPENDENT_FRONT_GUARD_TEST_RUNTIME_STATIC_REVIEW_001.json')}, proves the intended37-method lifecycle requires7 common-source reads while the driver caps/requires3. Its reviewer text also accepts unknown/empty/source-author aliases. Distinct002 is being prepared with exact ordered7-read trace and finite canonical/short identities, retaining37 names and all original bytes. [Postseal18 supervisor001 review](isolated-guard-test-supervisor001/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_001.json),{short('isolated-guard-test-supervisor001/INDEPENDENT_SUPERVISOR_STATIC_REVIEW_001.json')}, finds repeated Stop-Owned can renew5s twice (10s cumulative) and nominal authorization text lacks string types before PowerShell coercing comparison. Externally trusted JSON hashes are not claimed bypassed. Its source remains preserved; a distinct correction plus independently reviewed complete60s outer envelope is required. [Apply018prep002 review](code-apply-018-prep-revision002/INDEPENDENT_APPLY018_PREPARATION_REVIEW_002.json),{short('code-apply-018-prep-revision002/INDEPENDENT_APPLY018_PREPARATION_REVIEW_002.json')}, refuses source-author/root short-canonical alias exclusions. Its26 future literals and current baseline/payload/ACK are unselected; no apply approval or execution. New versions must preserve old refusals, not edit or replay them. Existing controller12/worker94/front37-guard/postseal18-fixture STATIC reviews still cover only their frozen preparation, with no new runtime acceptance.

**Fresh root observations retain the actor's live work.** [Paired742 read](LIVE_D177_ROOT012_OBSERVATION_001.json),{short('LIVE_D177_ROOT012_OBSERVATION_001.json')}, captured {live['captured_utc']}: HEAD597eb048, D177 source/test a5ca433f/07f075f4 unchanged, two tracked modifications/two DLP logs/ignored figure-mpl cache. All742 byte/mode/metadata rows were observed twice; tracked set and HEAD rechecked. The [opaque live guard](RAW003_CURRENT_LIVE_GUARD_ROOT012_001.json) and [runtime guard](RAW003_RUNTIME_GUARD_ROOT012_001.json) are potential isolated inputs only, not operational authority or actual execution bindings. Gate008 directory has29 acceptance metadata files plus plan/start, no listed terminal; actual result/XML acceptance remains unaudited. The [host observation](ROOT012_HOST_OBSERVATION_001.json) at {host['captured_utc']} sees the original driver pair57980/54680 and also shell/observer pattern matches; this is not a whole-host quiet proof. Root did not launch, stop or replay that gate. The first read-only snapshot utility refused before publishing any outputs on Git's actual Windows ownership check; [refusal](ROOT012_OBSERVATION_001_REFUSAL.json) and source001 are preserved. Distinct002 succeeded with only the exact repo safe-directory argument, optional locks off, filtered Git configuration and no global Git change.

**Resource and live execution holds remain explicit.** Latest root free RAM {host['free_ram_bytes']} bytes (~0.86GiB) fails the isolated raw1GiB start floor and Pro3 floors. D: free {host['disk_free_bytes']} bytes is a snapshot. Pro3 small/heavy remains HELD; held ACK006 may support only separately authorized isolated tests, never the older live executor's acknowledgement, canonical QA or durable native quiet. [Coordination008](COORDINATION_WORKFLOW_HOLD_AND_ISOLATED_RAW_008.md) is a request, not ACK. No live apply/fullQA/new canonical gate/commit/native action is authorized by staged work or gate metadata. New five-consumer raw003 binding/capture/module-guard integration is underway outside live; all seven D177 test intents/docs83/84 must survive the complete proposal. Complete source/caller/test/pin correction precedes fresh exact-source QA. No old18 overlay, generic ancestry shortcut or future release selfhash.

Attempt012 spent invocation, incident/terminal twins, existing epoch and frozen science remain exact: E2A150 local/149synced/111untouched/299events, Gate1FAIL/H2H3untested. Keeper52988 launcher consumed; last body/power evidence is historical, monitor restoration remains due at closeout. Original disk/reserves/quiet/pipedGO/noNonInteractive guards and no replay/public/push/outcome consultation/extra epoch stay. Next: independent preparations and cycle-free actual bindings -> meaningful distinct isolated runtime and full consumer/native closure -> reviewed source proposal and sole-executor ACK -> fresh focused/collection/distinct exact-source fullgate -> preserved83/84 doc rebase/governance/final263/local release -> independent postcommit admission -> fresh native only under all original guards. This root012 refresh awaits a different independent documentation review; creation metadata is immutable history.
"""
primary = [ROOT/"AGENTS.md", ROOT/"HANDOFF.md", ROOT/"START_HERE.md",
           ROOT/"resume-2026-09-28-001/SESSION.md", BASE/"RESOURCE_COORDINATION.md"]
before = {p:p.read_bytes() for p in primary}
for name, data in input_bytes.items():
    assert (BASE/name).read_bytes() == data
    once(INPUTS/name, data)
for p, data in before.items():
    once(BEFORE/p.relative_to(ROOT), data)
checkpoint = BASE/"30H_RESUME_CHECKPOINT_012.md"
once(checkpoint, body.encode("utf-8"))
header = ("**MAJOR STEP012 - RAW003 INDEPENDENT STATIC PASS; RUNTIME/PUBLISHER PREPARATIONS FROZEN; THREE PREPARATORY REFUSALS; LIVE ACK HOLD.**\n"
          f"Recorded {stamp}. Owner local/private ends2026-10-02T22:36:15Z. Read [checkpoint012](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_012.md), HANDOFF, START_HERE and newest SESSION.\n"
          "Raw003 source7fe7dc19/testb4bf5499 independently STATIC PASS7c263719, no runtime/count acceptance. Raw isolated37-file prep frozen/pending peer; publisher/verifier schema2 package71files/12puretests frozen/pending peer. Front37 harness001 REFUSED7reads-vs3/author aliases; postseal supervisor001 REFUSED5s wait renewed and untyped text; apply018prep002 REFUSED author/root aliases. Originals preserved UNRUN; distinct corrections required. Prior raw002/publisher003/component003 consumed evidence unchanged. Root011 docs independent PASS192698b7.\n"
          "Root00:22 paired742 confirms HEAD597/D177 a5ca433f/07f075f4 and ignored cache; actor gate00829 metadata acceptances/no listed terminal, actual final acceptance not audited. Root did not launch/stop it. RAM00:19 922185728B fails isolate1GiB and Pro3 floors. Sole-executor ACK pending; root live apply/fullQA/newgate/commit/native HELD. Opaque742/runtime snapshots grant no operational authority. Pro3 HELD/quiet unagreed. Preserve seven D177 intents/docs83/84; integrate complete source/caller/tests/pins before fresh gate.\n"
          "Attempt012/twins/existing epoch/science/original reserves/pipedGO/noNonInteractive/no replay/public/outcomes stay. Keeper consumed, monitor restoration due. Earlier bytes below remain exact history.\n\n").encode("utf-8")
handoff = body.replace("# Major step012 - raw policy reviewed; new frozen preparation; execution holds retained", "# Current pro2 handoff - major step012")
handoff = re.sub(r"\]\(([^)]+)\)", lambda m:"]("+m.group(1)+")" if m.group(1).startswith(("http", "D:", "../")) else "](resume-2026-10-01-30h-001/"+m.group(1)+")", handoff)
start = ("# Start here\n\nRead [HANDOFF](HANDOFF.md), [checkpoint012](resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_012.md), [coordination008](resume-2026-10-01-30h-001/COORDINATION_WORKFLOW_HOLD_AND_ISOLATED_RAW_008.md) and newest [SESSION](resume-2026-09-28-001/SESSION.md).\n\n"
         "Raw003 independently STATIC accepted; raw runtime/publisher-schema2 preparations frozen, tests UNRUN. Front37 harness001, postseal supervisor001 and apply018prep002 are independently REFUSED_STATIC, originals preserved; distinct corrections/reviews/bindings needed. Root011 docs reviewed PASS. New consumer capture/module/pin integration remains staged only.\n\n"
         "Preserve HEAD597/D177 seven test intents/docs83/84 and running actor008. Root00:22 sees29 acceptance metadata files/no listed terminal, not actual gate acceptance. Sole-executor ACK pending: live apply/fullQA/newgate/commit/native HELD. Complete corrected source/caller/test/pin review precedes fresh exact-source gate. RAM00:19 ~0.86GiB fails isolated1GiB start; Pro3 small/heavy HELD/native quiet unagreed.\n\n"
         "Owner local/private ends2026-10-02T22:36:15Z. Preserve spent attempts/twins/existing epoch/frozen science/original guards/pipedGO/noNonInteractive/no-public/no-replay/no-outcomes. Keeper consumed; restore monitor at closeout.\n").encode("utf-8")
replacements = {primary[0]:header+before[primary[0]], primary[1]:handoff.encode("utf-8"),primary[2]:start}
for p, data in replacements.items():
    assert p.read_bytes() == before[p]
    p.write_bytes(data)
entry = (f"\n\n## {stamp} - ROOT MAJOR012: reviewed raw policy and frozen preparations\n\n"
         "See [checkpoint012](../resume-2026-10-01-30h-001/30H_RESUME_CHECKPOINT_012.md). Raw003 STATIC PASS7c263719; raw runtime37files and publisher71files/12puretests frozen pending peer, UNRUN. Front37 harness001 REFUSED7-vs3/aliases, postseal supervisor001 REFUSED wait renewal/untyped text, apply018prep002 REFUSED attribution aliases; originals preserved. Root011 docs PASS192698b7. Root00:22 paired742/liveD177 unchanged, actor00829 acceptance metadata/no listed terminal, actual acceptance unaudited. Root did not launch/stop/replay. RAM00:19 922185728B below isolated1GiB/Pro3 floors. Opaque live/runtime observations and Pro3 held ACK grant no canonical/live/native authority; sole-executor ACK pending. Complete consumer/test/pin closure and D1777/83/84 preservation ahead. Science/twins/epoch/original guards unchanged; monitor restoration due. Root012 docs await independent review.\n").encode("utf-8")
resource_entry = (f"\n\n### {stamp} - major012 resource and isolated scope\n\n"
                  "[Root host snapshot](ROOT012_HOST_OBSERVATION_001.json) at00:19 gives RAM922185728B (~0.86GiB), D302877265920B. RAM fails proposed isolated raw1GiB and Pro35/10GiB floors. Driver57980/54680 observed; matching shell/observer rows do not prove quiet. Actor00829 acceptance metadata at00:22, no listed terminal/final reconciliation. No new lease/sole-executor ACK/native quiet or test launch. Raw source STATIC PASS/new harness/publisher frozen; front/postseal/apply helper refusals preserved. Keeper consumed, monitor restoration due. [Coordination008](COORDINATION_WORKFLOW_HOLD_AND_ISOLATED_RAW_008.md) is only a request; actual Pro3 held ACK supports separate isolated coordination only. See [checkpoint012](30H_RESUME_CHECKPOINT_012.md).\n").encode("utf-8")
for p, add in ((primary[3],entry),(primary[4],resource_entry)):
    assert p.read_bytes().startswith(before[p])
    with p.open("ab") as stream:stream.write(add)
baseline = []
for p, data in before.items():
    proof = "exact_before_copy"
    if p.name == "AGENTS.md":assert p.read_bytes().endswith(data);proof="exact_retained_suffix"
    if p.name in ("SESSION.md","RESOURCE_COORDINATION.md"):assert p.read_bytes().startswith(data);proof="exact_retained_prefix"
    baseline.append({"primary":str(p.relative_to(ROOT)).replace("\\", "/"),"before":row(BEFORE/p.relative_to(ROOT)),"proof":proof})
once(BASE/"DOCS_REFRESH_BASELINE_012.json", encode({"schema_version":1,"created_utc":stamp,"files":baseline}))
inputs = [{"original":row(BASE/name),"copy":row(INPUTS/name)} for name in names]
once(BASE/"DOCS_REFRESH_INPUTS_012.json", encode({"schema_version":1,"created_utc":stamp,"inputs":inputs}))
declared = [*primary,checkpoint,BASE/"DOCS_REFRESH_BASELINE_012.json",BASE/"DOCS_REFRESH_INPUTS_012.json",
            *[BEFORE/p.relative_to(ROOT) for p in primary],*[INPUTS/name for name in names]]
links = []
for p, text in ((primary[0],header.decode()),(primary[1],handoff),(primary[2],start.decode()),
                (checkpoint,body),(primary[3],entry.decode()),(primary[4],resource_entry.decode())):
    for target in re.findall(r"\]\(([^)]+)\)",text):
        if target.startswith(("http:","https:")):continue
        path = Path(target) if re.match(r"^[A-Za-z]:",target) else p.parent/target
        assert path.exists(), target
        links.append({"document":str(p.relative_to(ROOT)).replace("\\", "/"),"target":target,"resolved_path":str(path.resolve())})
audit = {"schema_version":1,"checkpoint":12,"created_utc":stamp,"status":"AWAITING_INDEPENDENT_DOCUMENTATION_REVIEW",
         "files":[row(p) for p in declared],"actual_input_count":len(inputs),"maintained_links":links,
         "facts":{"owner_end_utc":"2026-10-02T22:36:15Z","root011_independent_docs_review":"PASS",
                  "raw003_source_review":"PASS_STATIC","raw003_runtime_acceptance":False,
                  "new_runtime_and_publisher_preparation":"FROZEN_UNRUN_PEER_PENDING",
                  "front37_harness001":"REFUSED_STATIC","postseal_supervisor001":"REFUSED_STATIC",
                  "apply018prep002":"REFUSED_STATIC","actor008_acceptance_metadata":accepted,
                  "actor008_final_acceptance_audited":False,"raw_isolated_ram_floor_passed":False,
                  "root_live_executor_ack_received":False,"native_whole_window_quiet_agreed":False,
                  "pro3_small_and_heavy":"HELD","source_and_operational_evidence_edited":False}}
once(BASE/"DOCS_REFRESH_AUDIT_012.json", encode(audit))
print(json.dumps({"checkpoint_sha256":sha(checkpoint.read_bytes()),"audit_sha256":sha(encode(audit)),
                  "declared_files":len(declared),"inputs":len(inputs),"maintained_links":len(links)}))
