        bytes=len(source_bytes),sha256=sha(source_bytes),before004_sha256=sha(before_bytes),
        growth_bytes=len(source_bytes)-len(before_bytes), loader=binding['consumers'][role]['loader'],
        exception=binding['consumers'][role]['exception'],
        selected_functions=binding['consumers'][role]['selected_functions'],
        helper_line=helper.lineno, Path_isinstance_line=path_branch.lineno,
        four_predicate_reversal_exact_bytes=True, all_other_source_AST_exact=True,
        nominal_kind_is_comparisons=nominal_is, remaining_kind_in_comparisons=kind_in,
        direct_trusted_MappingProxyType_imports=import_count,
        helper_AST_sha256=sha(ast.dump(helper,include_attributes=False).encode('utf-8'))))

