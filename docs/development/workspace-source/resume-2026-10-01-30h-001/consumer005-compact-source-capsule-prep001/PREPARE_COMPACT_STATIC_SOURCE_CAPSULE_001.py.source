    exact_top_level_keys=sorted(capsule),top_level_key_count=len(capsule),
    top_level_nominal_types={key:type(value).__name__ for key,value in capsule.items()},
    exact_nominal_core=typed_shape(nominal_core),closed_entire_fixed_capsule_shape=typed_shape(capsule),
    parser_requirements='Fresh bytes externallySHA-pinned;<=131072 before/descriptor/read checks; exact ASCII JSON+LF with duplicate/nonfinite rejection; exact builtin identities (int excludes bool); exact closed nested shapes and pinned literal data; genuinePy6 creation. This is a data contract only, not approved reader source.',
