for role in ['controller','entrypoint','fit_child','inspector','worker']:
    source_bytes = data['consumer_'+role]
    before_bytes = data['before004_'+role]
    reversed_bytes = source_bytes
    for new,old in substitutions:
        assert reversed_bytes.count(new.encode()) == 1
        reversed_bytes = reversed_bytes.replace(new.encode(),old.encode())
    assert reversed_bytes == before_bytes
    current_tree = ast.parse(source_bytes)
    prior_tree = ast.parse(before_bytes)
    helper = next(node for node in current_tree.body if isinstance(node,ast.FunctionDef) and node.name == '_raw_helper_value_identity')
    prior_other = [ast.dump(node,include_attributes=False) for node in prior_tree.body
                   if not (isinstance(node,ast.FunctionDef) and node.name == helper.name)]
    current_other = [ast.dump(node,include_attributes=False) for node in current_tree.body
                     if not (isinstance(node,ast.FunctionDef) and node.name == helper.name)]
    assert current_other == prior_other
    proof = next(row for row in peer['source_proofs'] if row['role'] == role)
    assert proof['sha256'] == sha(source_bytes) and proof['before_sha256'] == sha(before_bytes)
    assert binding['consumers'][role]['sha256'] == sha(source_bytes)
    import_count = sum(isinstance(node,ast.ImportFrom) and node.module == 'types'
                       and any(alias.name == 'MappingProxyType' and alias.asname is None for alias in node.names)
                       for node in current_tree.body)
    assert import_count == 1
    path_branch = next(node for node in ast.walk(helper) if isinstance(node,ast.If)
                      and isinstance(node.test,ast.Call) and ast.unparse(node.test) == 'isinstance(value, Path)')
    nominal_is = sum(isinstance(node,ast.Compare) and isinstance(node.left,ast.Name)
                     and node.left.id == 'kind' and any(isinstance(op,ast.Is) for op in node.ops)
                     for node in ast.walk(helper))
    kind_in = sum(isinstance(node,ast.Compare) and isinstance(node.left,ast.Name)
                  and node.left.id == 'kind' and any(isinstance(op,ast.In) for op in node.ops)
                  for node in ast.walk(helper))
    assert nominal_is == 14 and kind_in == 0
