substitutions = [
 ('if value is None or kind is bool or kind is int or kind is float or kind is str:', 'if value is None or kind in (bool, int, float, str):'),
 ('if kind is dict or kind is MappingProxyType:', 'if kind in (dict, MappingProxyType):'),
