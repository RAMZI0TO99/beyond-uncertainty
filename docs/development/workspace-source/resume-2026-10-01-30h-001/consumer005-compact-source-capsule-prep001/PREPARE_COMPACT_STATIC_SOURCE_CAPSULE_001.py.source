# Closed data contract: exact built-in identity, not class-name/equality membership.
# This validates own publication data, not a future target reader implementation.
def typed_shape(value):
    kind = type(value)
    if kind is dict:
        assert all(type(key) is str for key in value)
        return dict(kind='exact_builtin_dict',closed_keys=sorted(value),
                    fields={key:typed_shape(item) for key,item in value.items()})
    if kind is list:
        return dict(kind='exact_builtin_list',length=len(value),items=[typed_shape(item) for item in value])
    if kind is bool:
        return dict(kind='exact_builtin_bool',value=value)
    if kind is int:
        return dict(kind='exact_builtin_int_not_bool',value=value)
    if kind is str:
        return dict(kind='exact_builtin_str',value=value,maximum_UTF8_bytes=len(value.encode('utf-8')))
    if value is None:
        return dict(kind='None',value=None)
    raise AssertionError('unsupported own data type')

def type_validate(value, node):
    kind = node['kind']
    if kind == 'exact_builtin_dict':
        assert type(value) is dict and sorted(value) == node['closed_keys']
        for key in node['closed_keys']:
            type_validate(value[key],node['fields'][key])
    elif kind == 'exact_builtin_list':
        assert type(value) is list and len(value) == node['length']
        for item,shape in zip(value,node['items']):
            type_validate(item,shape)
    elif kind == 'exact_builtin_bool':
        assert type(value) is bool and value is node['value']
    elif kind == 'exact_builtin_int_not_bool':
        assert type(value) is int and value == node['value']
    elif kind == 'exact_builtin_str':
        assert type(value) is str and value == node['value']
    else:
        assert kind == 'None' and value is None

