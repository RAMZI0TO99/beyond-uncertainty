     stream.write('\\n')\n    if invalid:raise RuntimeError('remaining bu module origin outside isolated copy')\nsys.exit(rc)\n"
CHILD_SHA256 = 'b459a9649887f2c0278188817e4e8ed663dcdda5c7acb112c468eb5afe09354a'

def require(value,what):
    if not value:raise RuntimeError(what)

def ancestors(directory):
    rows=[]
    for path in [*reversed(directory.absolute().parents),directory.absolute()]:
        info=path.lstat()
        require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode)
            and not(getattr(info,'st_file_attributes',0)&0x400),'linked/reparse ancestor')
        rows.append((str(path),info.st_dev,info.st_ino))
    return tuple(rows)

def absent(path):
    ancestors(path.parent)
    try:path.lstat()
    except FileNotFoundError:return True
    return False

def raw_identity(info):
    return(info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns,
        info.st_mode,info.st_nlink,getattr(info,'st_file_attributes',0),getattr(info,'st_birthtime_ns',None))

def cross_identity(info):
    # Established cross-API identity: no Windows ctime/mode ABI assumptions.
    return(info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_nlink)

def read(path,expected=None):
    chain=ancestors(path.parent);before=path.lstat()
    require(stat.S_ISREG(before.st_mode) and not stat.S_ISLNK(before.st_mode)
        and before.st_nlink==1 and not(getattr(before,'st_file_attributes',0)&0x400),'not one-link plain file')
    with path.open('rb') as stream:
        first=os.fstat(stream.fileno());value=stream.read();last=os.fstat(stream.fileno())
    after=path.lstat()
    require(cross_identity(before)==cross_identity(first)==cross_identity(last)==cross_identity(after)
        and raw_identity(before)==raw_identity(after) and raw_identity(first)==raw_identity(last)
        and len(value)==before.st_size and ancestors(path.parent)==chain,'file changed during read')
    if expected is not None:require(hashlib.sha256(value).hexdigest()==expected,'file byte pin differs')
    return value

def no_duplicates(rows):
    result={}
    for key,value in rows:
        require(key not in result,'duplicate JSON key');result[key]=value
    return result

def finite_float(token):
    value=float(token);require(math.isfinite(value),'nonfinite JSON float');return value

def parsed(path,expected=None):
    return json.loads(read(path,expected).decode('utf-8'),object_pairs_hook=no_duplicates,
        parse_float=finite_float,parse_constant=lambda token:(_ for _ in()).throw(ValueError('nonfinite JSON')))

def encoded(value):
    return(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')

def write(path,value):
    require(absent(path),'create-once output exists');chain=ancestors(path.parent)
    with path.open('xb') as stream:stream.write(value);stream.flush();os.fsync(stream.fileno())
    require(read(path)==value and ancestors(path.parent)==chain,'output publication differs')

def mkdir(path):
    require(absent(path),'create-once directory exists');chain=ancestors(path.parent)
    path.mkdir();require(ancestors(path.parent)==chain,'directory parent changed');ancestors(path)

def reviewed_template_digest():
    source=read(Path(__file__)).decode('utf-8')
    module=ast.parse(source)
    substitutions=[]
    lines=source.splitlines(keepends=True)
    for name,expected in [('HARNESS_REVIEW_SHA256',HARNESS_REVIEW_SHA256),
            ('ROOT_EXECUTION_ACK_SHA256',ROOT_EXECUTION_ACK_SHA256)]:
        matches=[node for node in module.body if isinstance(node,ast.Assign)
            and len(node.targets)==1 and isinstance(node.targets[0],ast.Name)
            and node.targets[0].id==name]
        require(len(matches)==1 and isinstance(matches[0].value,ast.Constant)
            and matches[0].value.value==expected,'binding literal differs')
        node=matches[0].value
        require(type(expected) is str and len(expected)==64
            and all(c in '0123456789abcdef' for c in expected),'binding hash shape differs')
        start=sum(len(line) for line in lines[:node.lineno-1])+node.col_offset
        end=sum(len(line) for line in lines[:node.end_lineno-1])+node.end_col_offset
        substitutions.append((start,end))
    for start,end in sorted(substitutions,reverse=True):source=source[:start]+'None'+source[end:]
    return hashlib.sha256(source.encode('utf-8')).hexdigest()

def guards():
    now=datetime.now(timezone.utc)
    require(sys.flags.isolated==1 and sys.flags.no_site==1 and sys.flags.safe_path==1
        and sys.flags.dont_write_bytecode==1 and sys.flags.utf8_mode==1,'runner flags differ')
    read(PYTHON,PYTHON_SHA256);read(GIT,GIT_SHA256);read(PYVENV,PYVENV_SHA256);read(BASE_PYTHON,BASE_PYTHON_SHA256)
    require(Path(sys.executable).resolve(strict=True)==PYTHON.resolve(strict=True),'interpreter path differs')
    require(OWNER_START<=now and now+timedelta(seconds=MAX_SECONDS)<OWNER_END,'owner interval/reserve differs')
    parsed(WORK/'OWNER_WORK_WINDOW_30H_20261001_001.json',OWNER_SHA256)
    read(WORK/'OWNER_WORK_WINDOW_30H_20261001_001_REVIEW.md',OWNER_REVIEW_SHA256)
    import shutil
    require(shutil.disk_usage(PROJECT).free>=MIN_FREE_BYTES,'10 GiB start floor')
    review=parsed(PREP/'INDEPENDENT_ISOLATED_COMPONENT_PREP_REVIEW_001.json',HARNESS_REVIEW_SHA256)
    require(review.get('verdict')=='PASS_STATIC' and review.get('runner_template_sha256')==reviewed_template_digest(),'harness review/template did not pass')
    ack=parsed(WORK/'ROOT_EXECUTION_ACK_ISOLATED_COMPONENTS_001.json',ROOT_EXECUTION_ACK_SHA256)
    require(set(ack)=={'schema_version','decision','executor','owner_sha256','copy_preparation_sha256',
        'harness_review_sha256','runner_template_sha256','canonical_qa','science_native_production_authorized',
        'created_utc','expires_utc'} and ack['schema_version']==1 and ack['executor']=='/root'
        and ack['decision']=='execute_four_isolated_components_once' and ack['owner_sha256']==OWNER_SHA256
        and ack['copy_preparation_sha256']==COPY_PREPARATION_SHA256
        and ack['harness_review_sha256']==HARNESS_REVIEW_SHA256
        and ack['runner_template_sha256']==review['runner_template_sha256']
        and ack['canonical_qa'] is False and ack['science_native_production_authorized'] is False,'root ACK differs')
    created=datetime.fromisoformat(ack['created_utc']);expiry=datetime.fromisoformat(ack['expires_utc'])
    require(created.utcoffset()==timedelta(0) and expiry.utcoffset()==timedelta(0)
        and OWNER_START<=created<=now<expiry<=OWNER_END,'root ACK interval differs')

def tree(root,rows,shape):
    result=[]
    for row in rows:
        path=root/row['path'];value=read(path,row['sha256'])
        require(len(value)==row['bytes'],'inventory byte count differs')
        info=path.lstat()
        if root==COPY:require(info.st_mode==dict(shape['filesystem_modes'])[row['path']],'copy filesystem mode differs')
        result.append({'path':row['path'],'sha256':row['sha256'],'bytes':len(value),
            'filesystem_mode':info.st_mode,'mtime_ns':info.st_mtime_ns})
    if root==COPY:
        files=[];directories=[]
        def scan(folder):
            ancestors(folder)
            with os.scandir(folder) as entries:
                for entry in entries:
                    path=Path(entry.path);info=path.lstat()
                    require(not stat.S_ISLNK(info.st_mode) and not(getattr(info,'st_file_attributes',0)&0x400),'copy link/reparse')
                    if stat.S_ISDIR(info.st_mode):directories.append(path.relative_to(root).as_posix());scan(path)
                    elif stat.S_ISREG(info.st_mode):require(info.st_nlink==1,'copy hardlink');files.append(path.relative_to(root).as_posix())
                    else:raise RuntimeError('copy nonregular entry')
        scan(root)
        require(sorted(files)==sorted(shape['tracked_paths']) and sorted(directories)==shape['directories'],'copy pathshape differs')
    return result

def environment(scratch):
    values={k:v for k,v in os.environ.items() if k.upper() in {'SYSTEMROOT','WINDIR','COMSPEC','SYSTEMDRIVE','PROCESSOR_ARCHITECTURE','NUMBER_OF_PROCESSORS','COMPUTERNAME','PATHEXT'}}
    values.update({'PATH':str(GIT.parent),'PYTHONPATH':str(COPY/'src'),'PYTHONDONTWRITEBYTECODE':'1',
        'PYTHONNOUSERSITE':'1','PYTHONHASHSEED':'0','PYTEST_DISABLE_PLUGIN_AUTOLOAD':'1',
        'TEMP':str(scratch/'temp'),'TMP':str(scratch/'temp'),'USERPROFILE':str(scratch/'profile'),
        'LOCALAPPDATA':str(scratch/'profile/Local'),'APPDATA':str(scratch/'profile/Roaming'),
        'MPLCONFIGDIR':str(scratch/'mpl'),'MPLBACKEND':'Agg','TORCH_HOME':str(scratch/'torch'),
        'XDG_CACHE_HOME':str(scratch/'cache'),'JOBLIB_TEMP_FOLDER':str(scratch/'joblib'),
        'OMP_NUM_THREADS':'1','OPENBLAS_NUM_THREADS':'1','MKL_NUM_THREADS':'1','NUMEXPR_NUM_THREADS':'1',
        'BLIS_NUM_THREADS':'1','VECLIB_MAXIMUM_THREADS':'1','GIT_CONFIG_NOSYSTEM':'1',
        'GIT_CONFIG_SYSTEM':os.devnull,'GIT_CONFIG_GLOBAL':os.devnull,'GIT_OPTIONAL_LOCKS':'0'})
    return values

def cases(junit):
    root=ET.fromstring(read(junit));require(root.tag=='testsuites','JUnit root differs')
    nodes=list(root.iter('testcase'));keys=[(node.get('classname'),node.get('name')) for node in nodes]
    require(len(keys)==len(set(keys)),'JUnit duplicate testcase')
    skipped=sum(len(node.findall('skipped')) for node in nodes)
    failed=sum(len(node.findall('failure')) for node in nodes);errors=sum(len(node.findall('error')) for node in nodes)
    suites=list(root.findall('testsuite'))
    require(len(nodes)==sum(int(s.get('tests')) for s in suites)
        and skipped==sum(int(s.get('skipped')) for s in suites)
        and failed==sum(int(s.get('failures')) for s in suites)
        and errors==sum(int(s.get('errors')) for s in suites),'JUnit suite/case counts differ')
    return {'testcases':len(nodes),'passed':len(nodes)-skipped-failed-errors,'skipped':skipped,
        'failures':failed,'errors':errors,'node_ids':keys}

def main():
    guards();require(hashlib.sha256(CHILD.encode('utf-8')).hexdigest()==CHILD_SHA256,'child source differs')
    prep=parsed(PREP/'COPY_PREPARATION_001.json',COPY_PREPARATION_SHA256)
    copyrows=parsed(PREP/'COPIED_TRACKED_742_AFTER_OVERLAY.json',COPIED_INVENTORY_SHA256)
    liverows=parsed(PREP/'CURRENT_LIVE_TRACKED_742_BEFORE.json',LIVE_INVENTORY_SHA256)
    shape=parsed(PREP/'COPY_PATH_SHAPE_002.json',PATH_SHAPE_SHA256)
    require(len(copyrows)==len(liverows)==742 and prep['tracked_count']==742 and prep['overlay_count']==18,'inventory counts differ')
    tree(COPY,copyrows,shape);tree(LIVE,liverows,shape);mkdir(RUNS)
    write(RUNS/'started.json',encoded({'utc':datetime.now(timezone.utc).isoformat(),'canonical_qa':False,
        'copy_preparation_sha256':COPY_PREPARATION_SHA256,'runner_sha256':hashlib.sha256(read(Path(__file__))).hexdigest(),
        'root_ack_sha256':ROOT_EXECUTION_ACK_SHA256,'review_sha256':HARNESS_REVIEW_SHA256,'suites':SUITES}))
    accepted=[]
    try:
        for name,suite in SUITES:
            guards();before_copy=tree(COPY,copyrows,shape);before_live=tree(LIVE,liverows,shape)
            run=RUNS/name;mkdir(run)
            for relative in ['scratch','scratch/temp','scratch/profile','scratch/profile/Local','scratch/profile/Roaming',
                    'scratch/mpl','scratch/torch','scratch/cache','scratch/joblib']:
                mkdir(run/relative)
            env=environment(run/'scratch');junit=run/'junit.xml';origin=run/'loaded-bu-origins.json'
            command=[str(PYTHON),'-s','-P','-B','-X','utf8','-c',CHILD,str(COPY/'src'),suite,
                str(run/'scratch/temp'),str(junit),str(origin)]
            write(run/'started.json',encoded({'utc':datetime.now(timezone.utc).isoformat(),'command':command,
                'environment':env,'cwd':str(COPY),'max_seconds':MAX_SECONDS,'canonical_qa':False}))
            read(PYTHON,PYTHON_SHA256);read(GIT,GIT_SHA256);start=time.monotonic()
            timed_out=False
            try:
                outcome=subprocess.run(command,cwd=COPY,env=env,stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=MAX_SECONDS,check=False)
                code=outcome.returncode;stdout=outcome.stdout;stderr=outcome.stderr
            except subprocess.TimeoutExpired as error:
                timed_out=True;code=None;stdout=error.stdout or b'';stderr=error.stderr or b''
            elapsed=time.monotonic()-start
            write(run/'stdout.txt',stdout);write(run/'stderr.txt',stderr)
            after_copy=tree(COPY,copyrows,shape);after_live=tree(LIVE,liverows,shape)
            require(after_copy==before_copy and after_live==before_live,'source identity changed during component')
            write(run/'copy-before.json',encoded(before_copy));write(run/'copy-after.json',encoded(after_copy))
            write(run/'live-before.json',encoded(before_live));write(run/'live-after.json',encoded(after_live))
            detail=None;origin_record=None
            if not timed_out:
                detail=cases(junit);origin_record=parsed(origin)
            result={'schema_version':1,'finished_utc':datetime.now(timezone.utc).isoformat(),'suite':suite,
                'exit_code':code,'timed_out':timed_out,'elapsed_seconds':elapsed,'source_and_copy_unchanged':True,
                'stdout_sha256':hashlib.sha256(stdout).hexdigest(),'stderr_sha256':hashlib.sha256(stderr).hexdigest(),
                'junit_sha256':None if detail is None else hashlib.sha256(read(junit)).hexdigest(),
                'origins_sha256':None if origin_record is None else hashlib.sha256(read(origin)).hexdigest(),
                'junit':detail,'canonical_qa':False,'scientific_fits_run':False,'native_or_production_invoked':False,
                'live_source_modified':False}
            write(run/'result.json',encoded(result))
            require(not timed_out and code==0 and detail['failures']==detail['errors']==0
                and detail['testcases']>0 and origin_record['all_remaining_bu_origins_confined'] is True,'component refused/failure/timeout')
            guards();accepted.append({'suite':suite,'run':name,'result_sha256':hashlib.sha256(read(run/'result.json')).hexdigest()})
        write(RUNS/'finished.json',encoded({'utc':datetime.now(timezone.utc).isoformat(),'accepted':accepted,
            'canonical_qa':False,'scientific_native_production_authority':False}))
    except BaseException as error:
        write(RUNS/'failed.json',encoded({'utc':datetime.now(timezone.utc).isoformat(),'accepted':accepted,
            'exception_type':type(error).__name__,'never_replay':True,'canonical_qa':False}))
        raise

if __name__=='__main__':main()
