def require(value, what):
    if not value:
        raise RuntimeError(what)


def ancestors(directory):
    require('..' not in directory.parts, 'parent traversal')
    target = directory.absolute()
    rows = []
    for path in [*reversed(target.parents), target]:
        value = path.lstat()
        require(stat.S_ISDIR(value.st_mode) and not stat.S_ISLNK(value.st_mode)
                and not (getattr(value, 'st_file_attributes', 0) & 0x400), 'linked/reparse ancestor')
        rows.append((str(path), value.st_dev, value.st_ino))
    return tuple(rows)


def absent(path):
    ancestors(path.parent)
    try:
        path.lstat()
    except FileNotFoundError:
        return True
    return False


def raw_metadata(value):
    return (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns,
            value.st_mode, value.st_nlink, getattr(value, 'st_file_attributes', 0),
            getattr(value, 'st_birthtime_ns', None))


def cross_metadata(value):
    rows = raw_metadata(value)[:8]
    if os.name == 'nt':
        birth = getattr(value, 'st_birthtime_ns', None)
        require(type(birth) is int and birth > 0, 'Windows birthtime metadata is required')
        rows = (*rows[:4], birth, *rows[5:])
    return rows


def plain_file(path):
    ancestors(path.parent)
    value = path.lstat()
    require(stat.S_ISREG(value.st_mode) and not stat.S_ISLNK(value.st_mode)
            and not (getattr(value, 'st_file_attributes', 0) & 0x400)
            and value.st_nlink == 1, 'not a one-link plain file: ' + str(path))
    return value


def data(path):
    chain = ancestors(path.parent)
    before = plain_file(path)
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        require(cross_metadata(before) == cross_metadata(opened), 'file replaced before read')
        value = stream.read()
        after_open = os.fstat(stream.fileno())
    after_path = plain_file(path)
    require(raw_metadata(before) == raw_metadata(after_path)
            and raw_metadata(opened) == raw_metadata(after_open)
            and cross_metadata(before) == cross_metadata(after_open)
            and len(value) == before.st_size and ancestors(path.parent) == chain, 'file changed during read')
    return value


def sha(path):
    return hashlib.sha256(data(path)).hexdigest()


def pairs(items):
    output = {}
    for name, value in items:
        require(name not in output, 'duplicate JSON key')
        output[name] = value
    return output


def finite(value):
    number = float(value)
    require(math.isfinite(number), 'non-finite JSON number')
    return number


def invalid(value):
    raise RuntimeError('non-finite JSON constant: ' + value)


def read(path):
    return json.loads(data(path).decode('utf-8-sig'), object_pairs_hook=pairs,
                      parse_float=finite, parse_constant=invalid)


def write_bytes(path, value):
    chain = ancestors(path.parent)
    with path.open('xb') as stream:
        stream.write(value)
        stream.flush()
        os.fsync(stream.fileno())
    require(ancestors(path.parent) == chain and data(path) == value, 'publication differs')


def write_json(path, value):
    write_bytes(path, (json.dumps(value, indent=2, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii'))


def mkdir(path):
    chain = ancestors(path.parent)
    path.mkdir()
    require(ancestors(path.parent) == chain, 'directory ancestors changed')
    ancestors(path)


def aware(value):
    require(type(value) is str, 'timestamp is not text')
    stamp = datetime.fromisoformat(value)
    require(stamp.tzinfo is not None and stamp.utcoffset() == timedelta(0), 'timestamp is not aware UTC')
    return stamp


def owner_and_ack():
    require(sha(OWNER) == OWNER_SHA256 and sha(OWNER_REVIEW) == OWNER_REVIEW_SHA256, 'owner record/review differs')
    owner = read(OWNER)
    require(owner['authority'] == 'owner' and owner['authorized_duration_hours'] == 30
            and owner['work_start_utc'] == OWNER_START and owner['work_end_utc'] == OWNER_END, 'owner interval differs')
    for name in OWNER_FALSE_FIELDS:
        require(owner[name] is False, 'owner guard changed')
    now, end = datetime.now(timezone.utc), aware(OWNER_END)
    require(aware(OWNER_START) <= now < end and end - aware(OWNER_START) == timedelta(hours=30), 'outside owner window')
    peer, review = Path(OTHER_SESSION_ACKNOWLEDGEMENT_PATH), Path(OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_PATH)
    require(peer != review and peer.is_absolute() and review.is_absolute()
            and peer.is_relative_to(WORK) and review.is_relative_to(WORK), 'coordination evidence outside30h folder')
    require(sha(peer) == OTHER_SESSION_ACKNOWLEDGEMENT_SHA256
            and sha(review) == OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_SHA256, 'coordination evidence/review differs')
    review_record = read(review)
    require(review_record['verdict'] == 'PASS'
            and review_record['acknowledgement_sha256'] == OTHER_SESSION_ACKNOWLEDGEMENT_SHA256
            and review_record['single_executor'] == '/root'
            and review_record['hold_scope'] == 'apply018_and_focused_qa'
            and type(review_record['reviewer']) is str and review_record['reviewer'] not in ('', '/root'),
            'coordination review does not prove sole executor/hold')
    require(sha(ACK) == SINGLE_EXECUTOR_ACK_SHA256, 'single executor ACK differs')
    ack = read(ACK)
    expected = {'schema_version': 1, 'decision': 'single_executor_apply018_and_focused_qa', 'executor': '/root',
        'owner_record_sha256': OWNER_SHA256, 'integrated_manifest_sha256': INTEGRATED_MANIFEST_SHA256,
        'binding_review_sha256': BINDING_REVIEW_SHA256, 'gate007_actual_audit_sha256': GATE007_AUDIT_SHA256,
        'other_session_acknowledgement': {'path': str(peer), 'sha256': OTHER_SESSION_ACKNOWLEDGEMENT_SHA256},
        'other_session_acknowledgement_review': {'path': str(review), 'sha256': OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_SHA256},
        'public_actions_authorized': False, 'one_use_replay_authorized': False,
        'frozen_scientific_changes_authorized': False, 'additional_recovery_epochs_authorized': False}
    require(set(ack) == set(expected) | {'created_utc', 'expires_utc'}
            and all(type(ack[name]) is type(value) and ack[name] == value for name, value in expected.items()),
            'single executor ACK fields differ')
    require(aware(OWNER_START) <= aware(ack['created_utc']) <= now < aware(ack['expires_utc']) <= end,
            'single executor ACK expired/outside owner window')
    require(shutil.disk_usage(PROJECT).free >= 10 * 1024**3, 'below10GiB apply/QA floor')


def git(cwd, *arguments):
    ancestors(cwd)
    plain_file(GIT)
    result = subprocess.run([str(GIT), '-c', 'safe.directory=' + REPO.as_posix(),
        '-c', 'safe.directory=' + BASE.as_posix(), '-c', 'safe.directory=' + FROZEN.as_posix(),
        '-C', str(cwd), *arguments], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    require(result.returncode == 0 and result.stderr == b'', 'Git refused or emitted stderr')
    return result.stdout.decode('ascii')


def git_guards(applied=False):
    require(git(REPO, 'rev-parse', 'HEAD').strip() == CONTROLLER_HEAD, 'controller HEAD changed')
    expected = sorted(' M ' + row['path'] for row in SOURCE_ROWS) if applied else ORIGINAL_DIRTY
    require(git(REPO, 'status', '--porcelain', '--untracked-files=no').splitlines() == expected, 'tracked dirty set differs')
    for directory in (BASE, FROZEN):
        require(git(directory, 'rev-parse', 'HEAD').strip() == FROZEN_HEAD
                and git(directory, 'status', '--porcelain', '--untracked-files=all') == '', 'base/frozen worktree changed')
    require(git(FROZEN, 'rev-parse', '--abbrev-ref', 'HEAD').strip() == 'HEAD', 'frozen HEAD is not detached')


def candidate():
    rows = []
    def scan(directory, output):
        ancestors(directory)
        with os.scandir(directory) as entries:
            paths = sorted(Path(entry.path) for entry in entries)
        for path in paths:
            value = path.lstat()
            require(not stat.S_ISLNK(value.st_mode) and not (getattr(value, 'st_file_attributes', 0) & 0x400),
                    'candidate linked/reparse path')
            if stat.S_ISDIR(value.st_mode):
                if path.name != '__pycache__':
                    scan(path, output)
            else:
                plain_file(path)
                output.append(path)
    for folder in ('src', 'tests', 'scripts', 'docs'):
        paths = []
        scan(REPO / folder, paths)
        rows.extend([path.relative_to(REPO).as_posix(), sha(path)] for path in sorted(paths))
    ancestors(REPO)
    with os.scandir(REPO) as entries:
        root_paths = sorted(Path(entry.path) for entry in entries)
    for path in root_paths:
        if path.name == '.git':
            continue
        value = path.lstat()
        if stat.S_ISREG(value.st_mode):
            rows.append([path.name, sha(path)])
        else:
            ancestors(path)
    require(len(rows) == 263 and len({row[0] for row in rows}) == 263, 'candidate is not263 unique ordered rows')
    return rows


require(sys.flags.optimize == 0 and sys.dont_write_bytecode and sys.flags.isolated == 1
        and sys.flags.no_site == 1 and sys.flags.no_user_site == 1 and sys.flags.ignore_environment == 1
        and sys.flags.safe_path and sys.flags.utf8_mode == 1, 'use-I-S-B-Xutf8 active checks')
require(Path(sys.executable).resolve(strict=True) == PYTHON.resolve(strict=True), 'use pinned project Python')
owner_and_ack()
require(sha(STAGE / 'INTEGRATED_CODE_MANIFEST_001.json') == INTEGRATED_MANIFEST_SHA256
        and sha(STAGE / 'INDEPENDENT_DEPENDENCY_BINDING_REVIEW_001.json') == BINDING_REVIEW_SHA256
        and sha(WORK / 'INDEPENDENT_GATE007_ACTUAL_RECONCILIATION_001.json') == GATE007_AUDIT_SHA256, 'reviewed evidence differs')
require(read(STAGE / 'INDEPENDENT_DEPENDENCY_BINDING_REVIEW_001.json')['verdict'] == 'PASS_STATIC', 'binding review notPASS')
require(read(WORK / 'INDEPENDENT_GATE007_ACTUAL_RECONCILIATION_001.json')['verdict'] == 'PASS_ACTUAL_DATA_RECONCILIATION',
        'actual gate007 data review notPASS')
for name, expected_sha in GATE007_PINS.items():
    require(sha(GATE007 / name) == expected_sha, 'actual gate007 evidence differs')
require(absent(ROOT), 'apply018 attempt already exists; preserve/never replay')
require(ROOT.drive == REPO.drive == 'D:', 'atomic source staging must remain onD')
require(len(SOURCE_ROWS) == len({row['path'] for row in SOURCE_ROWS}) == 18, 'source scope is not exact18')
git_guards()
before = candidate()
require(sha(BASELINE) == BASELINE_SHA256 and before == read(BASELINE), 'current candidate differs from gate007263')
untracked_before = git(REPO, 'status', '--porcelain', '--untracked-files=normal')
payloads, before_bytes = {}, {}
for row in SOURCE_ROWS:
    relative = row['path']
    source, target = STAGE / relative, REPO / relative
    require(target.is_relative_to(REPO) and source.is_relative_to(STAGE) and '..' not in Path(relative).parts,
            'source/target escapes reviewed root')
    payloads[relative], before_bytes[relative] = data(source), data(target)
    require(hashlib.sha256(payloads[relative]).hexdigest() == row['sha256']
            and len(payloads[relative]) == row['bytes']
            and hashlib.sha256(before_bytes[relative]).hexdigest() == row['live_before_sha256'], 'source/before bytes differ')
owner_and_ack()
require(candidate() == before and git(REPO, 'status', '--porcelain', '--untracked-files=normal') == untracked_before,
        'candidate/untracked noise changed before publication')
mkdir(ROOT)
mkdir(ROOT / 'before')
mkdir(ROOT / 'temporary')
write_json(ROOT / 'started.json', {'utc': datetime.now(timezone.utc).isoformat(), 'helper_sha256': sha(Path(__file__)),
    'owner_record_sha256': OWNER_SHA256, 'single_executor_ack_sha256': SINGLE_EXECUTOR_ACK_SHA256,
    'integrated_manifest_sha256': INTEGRATED_MANIFEST_SHA256, 'binding_review_sha256': BINDING_REVIEW_SHA256,
    'gate007_actual_audit_sha256': GATE007_AUDIT_SHA256, 'candidate_before_sha256': BASELINE_SHA256,
    'source_rows': SOURCE_ROWS, 'untracked_status_before': untracked_before})
applied = []
try:
    for index, row in enumerate(SOURCE_ROWS):
        write_bytes(ROOT / 'before' / ('%02d.bin' % index), before_bytes[row['path']])
    write_json(ROOT / 'candidate-before.json', before)
    for index, row in enumerate(SOURCE_ROWS):
        owner_and_ack()
        relative = row['path']
        require(data(REPO / relative) == before_bytes[relative], 'target changed before replacement')
        temporary = ROOT / 'temporary' / ('%02d.bin' % index)
        write_bytes(temporary, payloads[relative])
        os.chmod(temporary, plain_file(REPO / relative).st_mode & 0o777)
        require(data(temporary) == payloads[relative], 'atomic staging bytes changed')
        ancestors((REPO / relative).parent)
        ancestors(temporary.parent)
        os.replace(temporary, REPO / relative)
        require(data(REPO / relative) == payloads[relative], 'applied bytes differ')
        applied.append(relative)
    after = candidate()
    require([row[0] for row in after] == [row[0] for row in before], 'candidate path order changed')
    require(sorted(row[0] for row, old in zip(after, before, strict=True) if row[1] != old[1])
            == sorted(row['path'] for row in SOURCE_ROWS), 'actual changed subset differs from18')
    git_guards(applied=True)
    require(git(REPO, 'status', '--porcelain', '--untracked-files=normal')
            == '\n'.join(sorted([' M ' + row['path'] for row in SOURCE_ROWS]
                                + [line for line in untracked_before.splitlines() if line.startswith('?? ')])) + '\n',
            'untracked files changed')
    owner_and_ack()
    write_json(ROOT / 'candidate-after.json', after)
    write_json(ROOT / 'finished.json', {'utc': datetime.now(timezone.utc).isoformat(), 'applied': applied,
        'source_pins': {row['path']: row['sha256'] for row in SOURCE_ROWS},
        'candidate_before_sha256': sha(ROOT / 'candidate-before.json'),
        'candidate_after_sha256': sha(ROOT / 'candidate-after.json'), 'candidate_rows': 263,
        'public_action': False, 'scientific_outcomes_consulted': False, 'fit_executed': False})
except BaseException as exc:
    write_json(ROOT / 'failed.json', {'utc': datetime.now(timezone.utc).isoformat(), 'applied': applied,
        'error_type': type(exc).__name__, 'error': str(exc), 'replay_authorized': False})
    raise
print(json.dumps({'applied18': True, 'finished_sha256': sha(ROOT / 'finished.json'),
                  'candidate_after_sha256': sha(ROOT / 'candidate-after.json')}), flush=True)
