ROOT6_SHA = "fdae5a1eec6672ad1dc478da46446c0678ed1aa59276e1b893232e334bf72415"


def sha(data):
    return hashlib.sha256(data).hexdigest()


def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns,
            s.st_mode, s.st_nlink, getattr(s, "st_file_attributes", None),
            getattr(s, "st_birthtime_ns", None)]


def finite(path):
    first = path.lstat()
    if not stat.S_ISREG(first.st_mode) or first.st_nlink != 1 or first.st_size > MAX_BYTES:
        raise ValueError("finite selected input shape/cap differs: " + str(path))
    if getattr(first, "st_file_attributes", 0) & 0x400:
        raise ValueError("reparse selected input")
    with path.open("rb") as stream:
        fd_first = os.fstat(stream.fileno())
        data = stream.read(MAX_BYTES + 1)
        fd_last = os.fstat(stream.fileno())
    last = path.lstat()
    if len(data) != first.st_size or len(data) > MAX_BYTES or raw9(first) != raw9(last) or raw9(fd_first) != raw9(fd_last):
        raise ValueError("selected input changed during capped read")
    for field in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_mode", "st_nlink"):
        if getattr(first, field) != getattr(fd_first, field):
            raise ValueError("selected input path/descriptor shared identity differs")
    return data, {"path_before_raw9": raw9(first), "path_after_raw9": raw9(last),
                  "descriptor_before_raw9": raw9(fd_first), "descriptor_after_raw9": raw9(fd_last),
                  "same_API_repeat_exact": True, "cross_API_ctime_equated": False}


def new(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    if path.read_bytes() != data:
        raise ValueError("own artifact readback differs")


def new_json(name, value):
    new(OUT / name, json.dumps(value, ensure_ascii=True, sort_keys=True, indent=2).encode("ascii") + b"\n")


def ast_dump(node):
    return ast.dump(node, include_attributes=False)


def helper(tree):
    values = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == "_raw_helper_value_identity"]
    if len(values) != 1:
        raise ValueError("selected helper not unique")
    return values[0]


