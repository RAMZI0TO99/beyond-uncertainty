DOCUMENT_PATHS = ['CLAUDE.md', 'DECISIONS.md', 'DELTA_TO_SOL.md', 'PROJECT_STATE.md', 'PROJECT_STATE_ARCHIVE.md', 'docs/week8_production_runbook.md', 'docs/week8_release_verification.md']

METADATA_FIELDS = ('dev', 'ino', 'size', 'mtime_ns', 'ctime_ns', 'mode', 'nlink', 'file_attributes', 'birthtime_ns')
FALSE_FIELDS = ('public_action_performed', 'production_invoked', 'scientific_outcomes_consulted', 'scientific_values_emitted', 'one_use_replay_authorized', 'frozen_scientific_changes_authorized', 'additional_recovery_epochs_authorized')
OUTPUT_CHAIN = ()

def require(value, message):
    if not value:
        raise RuntimeError(message)

def digest(value):
    return hashlib.sha256(value).hexdigest()

def canonical(value):
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('ascii')

def exact_keys(value, keys, message):
    require(type(value) is dict and set(value) == set(keys), message)

def hex_text(value, length=64):
    require(type(value) is str and len(value) == length and all(c in '0123456789abcdef' for c in value), 'invalid lowercase hex pin')
    return value

def relative(value):
    require(type(value) is str and value != '' and '\\' not in value and ':' not in value and not value.startswith('/') and all(part not in ('', '.', '..') for part in value.split('/')), 'invalid relative path')
    return value

def confined(value):
    require(type(value) is str, 'bound path is not text')
    path = Path(value)
    require(path.is_absolute() and '..' not in path.parts and path.is_relative_to(WORK) and path != WORK and not path.is_relative_to(ROOT), 'bound input outside reviewed workspace')
    return path

def ancestors(directory):
    require(directory.is_absolute() and '..' not in directory.parts, 'relative/traversing directory')
    rows = []
    for path in [*reversed(directory.parents), directory]:
        value = path.lstat()
        require(stat.S_ISDIR(value.st_mode) and not stat.S_ISLNK(value.st_mode) and not (getattr(value, 'st_file_attributes', 0) & 0x400), 'nonplain ancestor: ' + str(path))
        rows.append((str(path), value.st_dev, value.st_ino))
    return tuple(rows)

def validate_metadata(row):
    exact_keys(row, METADATA_FIELDS, 'raw-nine metadata shape differs')
    require(all(type(row[name]) is int and row[name] >= 0 for name in METADATA_FIELDS[:-1]), 'metadata field not nonnegative exact int')
    require((os.name == 'nt' and type(row['birthtime_ns']) is int and row['birthtime_ns'] >= 0) or (os.name != 'nt' and (row['birthtime_ns'] is None or type(row['birthtime_ns']) is int)), 'required birthtime differs')
    require(stat.S_ISREG(row['mode']) and row['nlink'] == 1 and not (row['file_attributes'] & 0x400), 'metadata not regular/one-link/nonreparse')

def raw_metadata(value):
    row = dict(zip(METADATA_FIELDS, (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns, value.st_mode, value.st_nlink, getattr(value, 'st_file_attributes', None if os.name == 'nt' else 0), getattr(value, 'st_birthtime_ns', None))))
    validate_metadata(row)
    return row

def cross_metadata(value):
    # Cross-API identity uses only the established five fields. All nine raw
    # fields remain exact before/after within each API, including mode/ctime.
    return (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_nlink)

def regular(value, path):
    require(stat.S_ISREG(value.st_mode) and not stat.S_ISLNK(value.st_mode) and not (getattr(value, 'st_file_attributes', 0) & 0x400) and value.st_nlink == 1, 'not one-link regular nonreparse file: ' + str(path))
    raw_metadata(value)

def capture(path):
    chain = ancestors(path.parent)
    before = path.lstat()
    regular(before, path)
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        regular(opened, path)
        require(cross_metadata(before) == cross_metadata(opened), 'path/handle identity differs before read')
        value = stream.read()
        handle_after = os.fstat(stream.fileno())
        regular(handle_after, path)
    after = path.lstat()
    regular(after, path)
    require(raw_metadata(before) == raw_metadata(after) and raw_metadata(opened) == raw_metadata(handle_after) and cross_metadata(after) == cross_metadata(handle_after) and len(value) == before.st_size and ancestors(path.parent) == chain, 'file/ancestor drift during read')
    return value, raw_metadata(after)

def data(path):
    return capture(path)[0]

def sha(path):
    return digest(data(path))

def output_guard(path):
    require(path.is_relative_to(ROOT), 'output outside sole owned attempt')
    if OUTPUT_CHAIN:
        require(ancestors(ROOT) == OUTPUT_CHAIN, 'owned output directory identity drift')

def absent(path):
    chain = ancestors(path.parent)
    try:
        path.lstat()
    except FileNotFoundError:
        require(ancestors(path.parent) == chain, 'absence parent drift')
        return True
    return False

def mkdir_once(path):
    output_guard(path)
    chain = ancestors(path.parent)
    require(absent(path), 'consumed output directory: ' + str(path))
    path.mkdir()
    require(ancestors(path.parent) == chain, 'mkdir ancestor drift')
    ancestors(path)

def write_bytes_once(path, value):
    output_guard(path)
    chain = ancestors(path.parent)
    require(absent(path), 'consumed output file: ' + str(path))
    with path.open('xb') as stream:
        require(stream.write(value) == len(value), 'short output write')
        stream.flush(); os.fsync(stream.fileno())
    require(ancestors(path.parent) == chain and data(path) == value, 'output byte/ancestor drift')
    output_guard(path)

def write_json_once(path, value):
    write_bytes_once(path, (json.dumps(value, ensure_ascii=True, indent=2, allow_nan=False) + '\n').encode('ascii'))

def pairs(items):
    result = {}
    for name, value in items:
        require(name not in result, 'duplicate JSON key')
        result[name] = value
    return result

def finite(text):
    value = float(text)
    require(math.isfinite(value), 'JSON numeric overflow')
    return value

def invalid(text):
    raise RuntimeError('nonfinite JSON constant: ' + text)

def decode_json(value):
    return json.loads(value.decode('utf-8'), object_pairs_hook=pairs, parse_float=finite, parse_constant=invalid)

def pinned(value, expected_sha):
    path = confined(value)
    value = data(path)
    require(digest(value) == hex_text(expected_sha), 'bound evidence byte pin differs: ' + str(path))
    return decode_json(value)

def aware(value):
    require(type(value) is str, 'timestamp not text')
    stamp = datetime.fromisoformat(value)
    require(stamp.tzinfo is not None and stamp.utcoffset() == timedelta(0), 'timestamp not aware UTC')
    return stamp

def interval(record):
    now = datetime.now(timezone.utc)
    require(aware(OWNER_START) <= aware(record['created_utc']) <= now < aware(record['expires_utc']) <= aware(OWNER_END), 'evidence expired/outside owner window')

def false_fields(record):
    require(all(record[name] is False for name in FALSE_FIELDS), 'authority/science/public flag differs')

def runtime_guard():
    require(sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.no_user_site == 1 and sys.flags.dont_write_bytecode == 1 and sys.flags.utf8_mode == 1, 'runtime flags differ')
    require(Path(sys.executable) == PYTHON and Path(sys._base_executable) == BASE_PYTHON and sys.version_info[:3] == (3, 13, 5), 'runtime executable/version differs')
    require(sys.argv == [str(BOUND_SCRIPT)], 'unexpected helper argv')
    for path, expected in ((PYTHON, PYTHON_SHA256), (BASE_PYTHON, BASE_PYTHON_SHA256), (PYVENV, PYVENV_SHA256), (GIT, GIT_SHA256)):
        require(sha(path) == expected, 'runtime byte pin differs: ' + str(path))

def git(cwd, *arguments):
    runtime_guard()
    chain = ancestors(cwd)
    executable_before = capture(GIT)
    require(digest(executable_before[0]) == GIT_SHA256, 'Git byte pin differs')
    environment = {name: value for name, value in os.environ.items() if not name.upper().startswith('GIT_')}
    environment.update({'GIT_CONFIG_GLOBAL': os.devnull, 'GIT_CONFIG_SYSTEM': os.devnull, 'GIT_CONFIG_NOSYSTEM': '1', 'GIT_TERMINAL_PROMPT': '0', 'LC_ALL': 'C'})
    result = subprocess.run([str(GIT), '--no-pager', '--no-optional-locks', '-c', 'core.fsmonitor=false', '-c', 'core.untrackedCache=false', '-c', 'core.quotepath=false', '-c', 'safe.directory=' + REPO.as_posix(), '-c', 'safe.directory=' + BASE.as_posix(), '-c', 'safe.directory=' + FROZEN.as_posix(), '-C', str(cwd), *arguments], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=120, env=environment)
    require(result.returncode == 0 and result.stderr == b'', 'Git failed/emitted stderr')
    require(capture(GIT) == executable_before and ancestors(cwd) == chain, 'Git executable/directory drift')
    runtime_guard()
    return result.stdout.decode('ascii')

def index_rows():
    output = git(REPO, 'ls-files', '--stage', '-z')
    rows = []
    for item in output.rstrip('\0').split('\0'):
        prefix, path = item.split('\t')
        mode, blob, stage = prefix.split(' ')
        require(mode in ('100644', '100755') and stage == '0', 'nonregular/unmerged tracked index')
        rows.append({'path': relative(path), 'mode': mode, 'index_blob': hex_text(blob, 40)})
    require(len(rows) == 742 and len({row['path'] for row in rows}) == 742 and [row['path'] for row in rows] == sorted(row['path'] for row in rows), 'full742 index membership/order differs')
    return output, rows

def status_rows(text):
    rows = {}
    require(text == '' or text.endswith('\0'), 'status not NUL terminated')
    for item in text.rstrip('\0').split('\0') if text else ():
        require(len(item) >= 4 and item[2] == ' ', 'malformed Git status')
        code, path = item[:2], relative(item[3:])
        require(code in (' M', '??', '!!') and path not in rows, 'staged/renamed/duplicate/unexpected Git change')
        rows[path] = code
    return rows

def git_guards(expected_status):
    require(git(REPO, 'rev-parse', 'HEAD').strip() == hex_text(ACTUAL_HEAD, 40), 'HEAD changed')
    require(Path(git(REPO, 'rev-parse', '--show-toplevel').strip()) == REPO, 'controller root differs')
    require(status_rows(git(REPO, 'status', '--porcelain=v1', '--ignored', '--untracked-files=all', '-z')) == expected_status, 'tracked/untracked/ignored status differs')
    for directory in (BASE, FROZEN):
        require(git(directory, 'rev-parse', 'HEAD').strip() == FROZEN_HEAD, 'base/frozen HEAD changed')
        require(git(directory, 'status', '--porcelain=v1', '--ignored', '--untracked-files=all', '-z') == '', 'base/frozen dirty/untracked/ignored residue')
    require(git(FROZEN, 'rev-parse', '--abbrev-ref', 'HEAD').strip() == 'HEAD', 'frozen tree not detached')

def qa_rows():
    rows = []
    def scan(directory):
        chain = ancestors(directory)
        with os.scandir(directory) as entries:
            paths = sorted(Path(entry.path) for entry in entries)
        files = []
        for path in paths:
            value = path.lstat()
            require(not stat.S_ISLNK(value.st_mode) and not (getattr(value, 'st_file_attributes', 0) & 0x400), 'QA linked/reparse member')
            if stat.S_ISDIR(value.st_mode):
                ancestors(path)
                if path.name != '__pycache__':
                    files.extend(scan(path))
            else:
                regular(value, path); files.append(path)
        require(ancestors(directory) == chain, 'QA directory drift')
        return files
    for folder in ('src', 'tests', 'scripts', 'docs'):
        rows.extend([path.relative_to(REPO).as_posix(), sha(path)] for path in sorted(scan(REPO / folder)))
    chain = ancestors(REPO)
    with os.scandir(REPO) as entries:
        paths = sorted(Path(entry.path) for entry in entries)
    for path in paths:
        if path.name == '.git':
            continue
        value = path.lstat()
        if stat.S_ISREG(value.st_mode):
            rows.append([path.name, sha(path)])
        else:
            ancestors(path)
    require(ancestors(REPO) == chain and len(rows) == 263 and len({row[0] for row in rows}) == 263, 'QA not263 unique grouped rows')
    return rows

def file_row(path, mode=None):
    value, metadata = capture(REPO / relative(path))
    row = {'path': path, 'sha256': digest(value), 'bytes': len(value), 'metadata': metadata}
    if mode is not None:
        row['mode'] = mode
    return row

def whole_tracked():
    output, rows = index_rows()
    return digest(output.encode('ascii')), [file_row(row['path'], row['mode']) for row in rows]

def residue_rows(tracked):
    paths = []
    for arguments in (('ls-files', '--others', '--exclude-standard', '-z'), ('ls-files', '--others', '--ignored', '--exclude-standard', '-z')):
        output = git(REPO, *arguments)
        require(output == '' or output.endswith('\0'), 'residue output malformed')
        paths.extend(relative(path) for path in output.rstrip('\0').split('\0') if path)
    require(len(paths) == len(set(paths)) and not set(paths) & set(tracked), 'residue duplicate/overlap')
    return [file_row(path) for path in sorted(paths)]

def normalized_source(source):
    tree = ast.parse(source.decode('utf-8'))
    starts = [0]
    for line in source.decode('utf-8').splitlines(keepends=True):
        starts.append(starts[-1] + len(line.encode('utf-8')))
    replacements, names = [], []
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            name = node.targets[0].id
            if name in FUTURE_BINDING_NAMES:
                require(name not in names, 'duplicate future binding')
                ast.literal_eval(node.value)
                names.append(name)
                replacements.append((starts[node.value.lineno - 1] + node.value.col_offset, starts[node.value.end_lineno - 1] + node.value.end_col_offset))
    require(tuple(names) == FUTURE_BINDING_NAMES, 'future binding set/order differs')
    for start, end in reversed(replacements):
        source = source[:start] + b'None' + source[end:]
    return source

def binding_digest():
    # These two receipt hashes are excluded to prevent recursive SHA cycles.
    # Root must obtain an additional external audit of the complete bound file.
    values = {name: globals()[name] for name in FUTURE_BINDING_NAMES}
    values['BOUND_SOURCE_REVIEW_SHA256'] = None
    values['ROOT_EXECUTION_ACK_SHA256'] = None
    return digest(canonical(values))

def material_refs():
    return {'baseline_sha256': ACTUAL_BASELINE_SHA256, 'desired_payload_sha256': DESIRED_PAYLOAD_SHA256, 'policy_review_sha256': POLICY_REVIEW_SHA256}

def evidence_refs():
    return {**material_refs(), 'integration_review_sha256': INTEGRATION_REVIEW_SHA256}

def checked_review(path, pin, verdict, additions):
    record = pinned(path, pin)
    expected = {'schema_version': 1, 'verdict': verdict, **additions, **{name: False for name in FALSE_FIELDS}}
    exact_keys(record, (*expected, 'reviewer'), 'review shape differs')
    require(all(type(record[name]) is type(value) and record[name] == value for name, value in expected.items()), 'review attribution differs')
    require(type(record['reviewer']) is str and record['reviewer'] not in ('', '/root', 'bootstrap_stage'), 'review not independent')
    return record

def fresh_authorization():
    runtime_guard()
    if OUTPUT_CHAIN:
        output_guard(ROOT)
    owner_bytes = data(OWNER)
    require(digest(owner_bytes) == OWNER_SHA256 and sha(OWNER_REVIEW) == OWNER_REVIEW_SHA256, 'owner bytes/review differ')
    owner = decode_json(owner_bytes)
    require(owner['authority'] == 'owner' and type(owner['authorized_duration_hours']) is int and owner['authorized_duration_hours'] == 30 and owner['work_start_utc'] == OWNER_START and owner['work_end_utc'] == OWNER_END and all(owner[name] is False for name in OWNER_FALSE_FIELDS), 'owner scope/window differs')
    now = datetime.now(timezone.utc)
    require(aware(OWNER_START) <= now < aware(OWNER_END) and aware(OWNER_END) - aware(OWNER_START) == timedelta(hours=30), 'owner expired')
    require(shutil.disk_usage(PROJECT).free >= 10 * 1024**3, 'below10GiB apply floor')
    source, template_bytes = data(BOUND_SCRIPT), data(TEMPLATE)
    require(Path(__file__) == BOUND_SCRIPT and normalized_source(source) == template_bytes, 'bound code differs beyond reviewed literals')
    template_sha = digest(template_bytes)
    checked_review(PREPARATION_REVIEW_PATH, PREPARATION_REVIEW_SHA256, 'PASS_STATIC', {'template_sha256': template_sha, 'source_scope_count': 18, 'unchanged_document_count': 7})
    checked_review(POLICY_REVIEW_PATH, POLICY_REVIEW_SHA256, 'PASS_STATIC', {'desired_payload_sha256': DESIRED_PAYLOAD_SHA256, 'historical_records_rewritten': False, 'exact_one_intermediate_proved': True, 'historical_grouped_qa_order_retained': True})
    # No review embeds its own file SHA. Integration binds earlier material only.
    checked_review(INTEGRATION_REVIEW_PATH, INTEGRATION_REVIEW_SHA256, 'PASS_STATIC', {**material_refs(), 'actor_d177_changes_reconciled_and_preserved': True, 'documents_83_84_retained': True})
    checked_review(BOUND_SOURCE_REVIEW_PATH, BOUND_SOURCE_REVIEW_SHA256, 'PASS_BOUND_STATIC', {'template_sha256': template_sha, 'binding_digest': binding_digest(), **evidence_refs(), 'unrun': True})
    peer = pinned(OTHER_SESSION_ACKNOWLEDGEMENT_PATH, OTHER_SESSION_ACKNOWLEDGEMENT_SHA256)
    expected_peer = {'schema_version': 1, 'record_type': 'peer_apply018_revision002_hold_ack', 'executor': '/root', 'owner_record_sha256': OWNER_SHA256, **evidence_refs(), 'hold_scope': 'live_source_apply018_and_focused_qa', 'acknowledged': True, 'live_execution_paused': True, **{name: False for name in FALSE_FIELDS}}
    exact_keys(peer, (*expected_peer, 'author', 'created_utc', 'expires_utc'), 'peer ACK shape differs')
    require(all(type(peer[name]) is type(value) and peer[name] == value for name, value in expected_peer.items()) and type(peer['author']) is str and peer['author'] not in ('', '/root'), 'explicit peer hold/executor ACK absent')
    interval(peer)
    checked_review(OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_PATH, OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_SHA256, 'PASS', {'acknowledgement_sha256': OTHER_SESSION_ACKNOWLEDGEMENT_SHA256, 'single_executor': '/root', 'hold_scope': 'live_source_apply018_and_focused_qa', **evidence_refs()})
    expected_ack = {'schema_version': 1, 'decision': 'single_executor_apply018_revision002_and_focused_qa', 'executor': '/root', 'owner_record_sha256': OWNER_SHA256, **evidence_refs(), 'other_session_acknowledgement_sha256': OTHER_SESSION_ACKNOWLEDGEMENT_SHA256, 'other_session_acknowledgement_review_sha256': OTHER_SESSION_ACKNOWLEDGEMENT_REVIEW_SHA256, **{name: False for name in FALSE_FIELDS}}
    ack = pinned(SINGLE_EXECUTOR_ACK_PATH, SINGLE_EXECUTOR_ACK_SHA256)
    exact_keys(ack, (*expected_ack, 'created_utc', 'expires_utc'), 'sole-executor ACK shape differs')
    require(all(type(ack[name]) is type(value) and ack[name] == value for name, value in expected_ack.items()), 'sole-executor ACK differs')
    interval(ack)
    execution = pinned(ROOT_EXECUTION_ACK_PATH, ROOT_EXECUTION_ACK_SHA256)
    expected_execution = {'schema_version': 1, 'decision': 'execute_apply018_revision002_once', 'executor': '/root', 'owner_record_sha256': OWNER_SHA256, 'template_sha256': template_sha, 'binding_digest': binding_digest(), 'single_executor_ack_sha256': SINGLE_EXECUTOR_ACK_SHA256, 'bound_source_review_sha256': BOUND_SOURCE_REVIEW_SHA256, **evidence_refs(), **{name: False for name in FALSE_FIELDS}}
    exact_keys(execution, (*expected_execution, 'created_utc', 'expires_utc'), 'root execution ACK shape differs')
    require(all(type(execution[name]) is type(value) and execution[name] == value for name, value in expected_execution.items()), 'root execution ACK differs')
    interval(execution)
    paths = [confined(globals()[name]) for name in FUTURE_BINDING_NAMES if name.endswith('_PATH')]
    metadata = [capture(path)[1] for path in paths]
    require(len(set(paths)) == len(paths) and len({(row['dev'], row['ino']) for row in metadata}) == len(metadata), 'aliased bound evidence inputs')
    for name in FUTURE_BINDING_NAMES:
        if name.endswith('_PATH'):
            require(sha(confined(globals()[name])) == globals()[name[:-5] + '_SHA256'], 'late authorization evidence drift')
    # Repeat time after slow reads; the unbound helper never reaches this code.
    interval(peer); interval(ack); interval(execution)
    require(datetime.now(timezone.utc) < aware(OWNER_END), 'owner expired during proof')
    runtime_guard()

def load_material():
    baseline = pinned(ACTUAL_BASELINE_PATH, ACTUAL_BASELINE_SHA256)
    desired = pinned(DESIRED_PAYLOAD_PATH, DESIRED_PAYLOAD_SHA256)
    exact_keys(baseline, ('schema_version', 'record_type', 'created_utc', 'expires_utc', 'owner_record_sha256', 'head', 'tracked_index_sha256', 'tracked_files', 'qa_rows', 'status_with_ignored', 'residue_files', 'source_scope', 'unchanged_documents', *FALSE_FIELDS), 'fresh baseline shape differs')
    require(type(baseline['schema_version']) is int and baseline['schema_version'] == 1 and baseline['record_type'] == 'fresh_apply018_revision002_baseline' and baseline['owner_record_sha256'] == OWNER_SHA256 and baseline['head'] == ACTUAL_HEAD and baseline['source_scope'] == SOURCE_PATHS and baseline['unchanged_documents'] == DOCUMENT_PATHS, 'baseline scope/identity differs')
    interval(baseline); false_fields(baseline); hex_text(baseline['tracked_index_sha256'])
    require(digest(canonical(baseline['qa_rows'])) == hex_text(ACTUAL_QA_SHA256) and digest(canonical(baseline['tracked_files'])) == hex_text(ACTUAL_TRACKED_SHA256) and type(baseline['status_with_ignored']) is str and digest(baseline['status_with_ignored'].encode('ascii')) == hex_text(ACTUAL_STATUS_SHA256), 'baseline digest bindings differ')
    exact_keys(desired, ('schema_version', 'record_type', 'owner_record_sha256', 'baseline_sha256', 'source_root', 'source_rows', 'actor_d177_changes_reconciled_and_preserved', 'documents_83_84_retained', *FALSE_FIELDS), 'desired payload shape differs')
    require(type(desired['schema_version']) is int and desired['schema_version'] == 1 and desired['record_type'] == 'reviewed_apply018_revision002_payload' and desired['owner_record_sha256'] == OWNER_SHA256 and desired['baseline_sha256'] == ACTUAL_BASELINE_SHA256 and desired['source_root'] == DESIRED_SOURCE_ROOT and desired['source_rows'] == DESIRED_SOURCE_ROWS and desired['actor_d177_changes_reconciled_and_preserved'] is True and desired['documents_83_84_retained'] is True, 'desired payload lacks exact current reconciliation')
    false_fields(desired)
    source_root = confined(DESIRED_SOURCE_ROOT)
    ancestors(source_root)
    require(not source_root.is_relative_to(PREP) and source_root != WORK, 'desired root not independent staged payload')
    require(type(DESIRED_SOURCE_ROWS) is list and len(DESIRED_SOURCE_ROWS) == 18 and all(type(row) is dict for row in DESIRED_SOURCE_ROWS) and [row['path'] for row in DESIRED_SOURCE_ROWS] == SOURCE_PATHS, 'desired rows not exactly18 finite paths')
    require(type(baseline['tracked_files']) is list and len(baseline['tracked_files']) == 742 and all(type(row) is dict for row in baseline['tracked_files']) and len({row['path'] for row in baseline['tracked_files']}) == 742 and [row['path'] for row in baseline['tracked_files']] == sorted(row['path'] for row in baseline['tracked_files']), 'baseline not742 unique tracked paths')
    tracked = {}
    for row in baseline['tracked_files']:
        exact_keys(row, ('path', 'sha256', 'bytes', 'mode', 'metadata'), 'tracked row shape differs')
        relative(row['path']); hex_text(row['sha256']); validate_metadata(row['metadata'])
        require(type(row['bytes']) is int and row['bytes'] >= 0 and row['bytes'] == row['metadata']['size'] and row['mode'] in ('100644', '100755'), 'tracked bytes/mode differ')
        tracked[row['path']] = row
    require(set(SOURCE_PATHS) <= set(tracked) and set(DOCUMENT_PATHS) <= set(tracked) and not set(SOURCE_PATHS) & set(DOCUMENT_PATHS), 'finite source/document scope differs')
    status = status_rows(baseline['status_with_ignored'])
    require(all(code != ' M' or path in SOURCE_PATHS for path, code in status.items()), 'tracked changes outside18')
    require(type(baseline['qa_rows']) is list and len(baseline['qa_rows']) == 263 and all(type(row) is list and len(row) == 2 and row[0] in tracked and row[1] == tracked[row[0]]['sha256'] for row in baseline['qa_rows']) and len({row[0] for row in baseline['qa_rows']}) == 263, 'baseline QA membership/hashes differ')
    require((set(SOURCE_PATHS) | set(DOCUMENT_PATHS)) <= {row[0] for row in baseline['qa_rows']}, 'QA misses code/doc scope')
    require(type(baseline['residue_files']) is list, 'residue not finite reviewed list')
    for row in baseline['residue_files']:
        exact_keys(row, ('path', 'sha256', 'bytes', 'metadata'), 'residue row shape differs')
        relative(row['path']); hex_text(row['sha256']); validate_metadata(row['metadata'])
        require(type(row['bytes']) is int and row['bytes'] >= 0 and row['bytes'] == row['metadata']['size'] and row['path'] not in tracked, 'residue overlaps tracked/invalid')
    require([row['path'] for row in baseline['residue_files']] == sorted({row['path'] for row in baseline['residue_files']}) and {row['path'] for row in baseline['residue_files']} == {path for path, code in status.items() if code in ('??', '!!')}, 'residue/status membership differs')
    payload = {}
    for row in DESIRED_SOURCE_ROWS:
        exact_keys(row, ('path', 'before_sha256', 'sha256', 'bytes', 'mode'), 'desired row shape differs')
        old = tracked[row['path']]
        require(row['before_sha256'] == old['sha256'] and row['mode'] == old['mode'] and hex_text(row['sha256']) != old['sha256'] and type(row['bytes']) is int and row['bytes'] > 0, 'desired source lacks exact current before-image/change')
        value = data(source_root / row['path'])
        require(digest(value) == row['sha256'] and len(value) == row['bytes'], 'staged payload byte drift')
        payload[row['path']] = value
    return baseline, desired, payload

def fresh_state(baseline, expected_files, expected_status, payload):
    fresh_authorization()
    require(sha(confined(ACTUAL_BASELINE_PATH)) == ACTUAL_BASELINE_SHA256 and sha(confined(DESIRED_PAYLOAD_PATH)) == DESIRED_PAYLOAD_SHA256, 'baseline/payload evidence changed')
    interval(baseline)
    git_guards(expected_status)
    index_sha, rows = whole_tracked()
    require(index_sha == baseline['tracked_index_sha256'] and rows == expected_files, 'full742 source/mode/raw-metadata drift')
    hashes = {row['path']: row['sha256'] for row in expected_files}
    expected_qa = [[path, hashes[path]] for path, _ in baseline['qa_rows']]
    require(qa_rows() == expected_qa, 'whole263 grouped QA path/hash drift')
    require(residue_rows(hashes) == baseline['residue_files'], 'finite ignored/untracked residue drift')
    old_docs = {row['path']: row for row in baseline['tracked_files'] if row['path'] in DOCUMENT_PATHS}
    require(all(row == old_docs[row['path']] for row in rows if row['path'] in DOCUMENT_PATHS), 'seven docs changed; never restore/remove83/84')
    for path, value in payload.items():
        require(data(confined(DESIRED_SOURCE_ROOT) / path) == value, 'staged payload drift at boundary')
    git_guards(expected_status)
    fresh_authorization()
    interval(baseline)

def main():
    global OUTPUT_CHAIN
    require(Path(__file__) == BOUND_SCRIPT and absent(ROOT), 'wrong/consumed bound apply script')
    fresh_authorization()
    baseline, desired, payload = load_material()
    expected_files = json.loads(json.dumps(baseline['tracked_files']))
    expected_status = status_rows(baseline['status_with_ignored'])
    fresh_state(baseline, expected_files, expected_status, payload)
    mkdir_once(ROOT)
    OUTPUT_CHAIN = ancestors(ROOT)
    applied = []
    try:
        mkdir_once(ROOT / 'before')
        mkdir_once(ROOT / 'temporary')
        write_json_once(ROOT / 'started.json', {'schema_version': 1, 'record_type': 'apply018_revision002_started', 'created_utc': datetime.now(timezone.utc).isoformat(), 'helper_sha256': sha(BOUND_SCRIPT), 'owner_record_sha256': OWNER_SHA256, 'root_execution_ack_sha256': ROOT_EXECUTION_ACK_SHA256, 'single_executor_ack_sha256': SINGLE_EXECUTOR_ACK_SHA256, 'binding_digest': binding_digest(), 'baseline_sha256': ACTUAL_BASELINE_SHA256, 'desired_payload_sha256': DESIRED_PAYLOAD_SHA256, 'head': ACTUAL_HEAD, 'source_rows': DESIRED_SOURCE_ROWS, **{name: False for name in FALSE_FIELDS}})
        write_json_once(ROOT / 'baseline.json', baseline)
        # All18 before-images are byte-verified before the first target mutation.
        for number, row in enumerate(DESIRED_SOURCE_ROWS):
            value, metadata = capture(REPO / row['path'])
            old = next(item for item in expected_files if item['path'] == row['path'])
            require(digest(value) == row['before_sha256'] and metadata == old['metadata'], 'backup source differs')
            write_bytes_once(ROOT / 'before' / (str(number).zfill(2) + '.bin'), value)
        fresh_state(baseline, expected_files, expected_status, payload)
        for number, row in enumerate(DESIRED_SOURCE_ROWS):
            target = REPO / row['path']
            temporary = ROOT / 'temporary' / (str(number).zfill(2) + '.bin')
            write_bytes_once(temporary, payload[row['path']])
            old = next(item for item in expected_files if item['path'] == row['path'])
            os.chmod(temporary, stat.S_IMODE(old['metadata']['mode']))
            require(data(temporary) == payload[row['path']], 'temporary chmod/read drift')
            chain = ancestors(target.parent)
            require(temporary.lstat().st_dev == target.lstat().st_dev, 'replacement not same volume')
            fresh_state(baseline, expected_files, expected_status, payload)
            # Late target, backup, temporary and directory observations precede
            # the sole mutation. A new actor change refuses; never auto-repin.
            require(capture(target) == (data(ROOT / 'before' / (str(number).zfill(2) + '.bin')), old['metadata']) and data(temporary) == payload[row['path']] and ancestors(target.parent) == chain, 'pre-replace source/temporary/ancestor drift')
            output_guard(temporary)
            require(datetime.now(timezone.utc) < aware(OWNER_END), 'owner expired before replacement')
            interval(baseline)
            os.replace(temporary, target)
            applied.append(row['path'])
            require(ancestors(target.parent) == chain, 'post-replace target ancestor drift')
            current = file_row(row['path'], row['mode'])
            require(current['sha256'] == row['sha256'] and current['bytes'] == row['bytes'] and stat.S_IMODE(current['metadata']['mode']) == stat.S_IMODE(old['metadata']['mode']), 'published source/mode differs')
            expected_files[expected_files.index(old)] = current
            expected_status[row['path']] = ' M'
            fresh_state(baseline, expected_files, expected_status, payload)
        require(len(applied) == 18 and set(applied) == set(SOURCE_PATHS), 'not exactly18 applied paths')
        changed = [row['path'] for row, old in zip(expected_files, baseline['tracked_files']) if row['sha256'] != old['sha256']]
        require(set(changed) == set(SOURCE_PATHS), 'source delta differs from18')
        fresh_state(baseline, expected_files, expected_status, payload)
        write_json_once(ROOT / 'candidate-after.json', qa_rows())
        write_json_once(ROOT / 'tracked-after.json', expected_files)
        fresh_state(baseline, expected_files, expected_status, payload)
        write_json_once(ROOT / 'finished.json', {'schema_version': 1, 'record_type': 'apply018_revision002_finished', 'finished_utc': datetime.now(timezone.utc).isoformat(), 'started_sha256': sha(ROOT / 'started.json'), 'helper_sha256': sha(BOUND_SCRIPT), 'owner_record_sha256': OWNER_SHA256, 'head': ACTUAL_HEAD, 'baseline_sha256': ACTUAL_BASELINE_SHA256, 'desired_payload_sha256': DESIRED_PAYLOAD_SHA256, 'applied_paths': applied, 'seven_documents_unchanged': True, 'git_index_unchanged': True, 'qa_after_sha256': sha(ROOT / 'candidate-after.json'), 'tracked_after_sha256': sha(ROOT / 'tracked-after.json'), 'tests_run': False, **{name: False for name in FALSE_FIELDS}})
    except BaseException as error:
        output_guard(ROOT)
        if absent(ROOT / 'failed.json'):
            write_json_once(ROOT / 'failed.json', {'schema_version': 1, 'record_type': 'apply018_revision002_failed', 'failed_utc': datetime.now(timezone.utc).isoformat(), 'applied_paths': applied, 'error_type': type(error).__name__, 'error': str(error), 'rollback_performed': False, 'replay_authorized': False, **{name: False for name in FALSE_FIELDS}})
        raise
    print(json.dumps({'applied': len(applied), 'finished_sha256': sha(ROOT / 'finished.json'), 'public_action': False}))

if __name__ == '__main__':
    main()
