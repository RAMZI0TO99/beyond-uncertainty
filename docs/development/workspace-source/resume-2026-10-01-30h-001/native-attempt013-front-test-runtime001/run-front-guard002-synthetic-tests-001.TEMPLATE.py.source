ests.test_final_pid_parent_flags_and_base_substitution_refuse', 'OwnedVerifierPairTests.test_final_reobservation_prevents_same_bytes_replacement_hiding_in_new_witness', 'OwnedVerifierPairTests.test_foreign_second_snapshot_and_query_failure_refuse', 'OwnedVerifierPairTests.test_independent_image_pin_failure_precedes_first_host_query', 'OwnedVerifierPairTests.test_owned_cim_name_path_command_parent_and_creation_substitution_refuse', 'OwnedVerifierPairTests.test_pair_direct_parent_cycle_order_and_future_creation_refuse', 'OwnedVerifierPairTests.test_pair_pid_parent_and_creation_types_values_refuse', 'OwnedVerifierPairTests.test_pair_unknown_missing_extra_and_reordered_fields_or_rows_refuse', 'OwnedVerifierPairTests.test_pair_wrong_roles_image_hashes_and_paths_refuse', 'OwnedVerifierPairTests.test_pid_reuse_and_relationship_changes_between_snapshots_refuse', 'OwnedVerifierPairTests.test_stored_quiet_snapshot_false_counts_indices_verifier_and_shape_refuse', 'OwnedVerifierPairTests.test_valid_pair_and_two_fresh_snapshots_keep_pid_zero_inventory')
