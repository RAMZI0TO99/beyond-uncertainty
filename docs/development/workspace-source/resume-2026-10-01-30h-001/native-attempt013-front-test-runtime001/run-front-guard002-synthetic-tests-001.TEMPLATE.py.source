def require(value,message):
    if not value:raise ValueError(message)


def sha(data):return hashlib.sha256(data).hexdigest()


def pin(value):
    require(type(value) is str and re.fullmatch(r'[0-9a-f]{64}',value) is not None,'exact SHA256 binding required')
    return value


def canonical(value):
    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')


def parse(data):
    def unique(rows):
        document={}
        for key,value in rows:
            require(key not in document,'duplicate JSON field')
            document[key]=value
        return document
    def finite(token):
        value=float(token);require(math.isfinite(value),'nonfinite JSON number');return value
    return json.loads(data.decode('utf-8'),object_pairs_hook=unique,parse_float=finite,
        parse_constant=lambda token:(_ for _ in ()).throw(ValueError('nonfinite JSON token')))


def raw_identity(info):
    values=(info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns,
            info.st_mode,info.st_nlink,getattr(info,'st_file_attributes',None),
            getattr(info,'st_birthtime_ns',None))
    require(all(type(value) is int for value in values),'required Windows stat integer absent')
    require(values[7]>=0 and values[8]>=0,'negative Windows attributes or creation time')
    return values


def directory_chain(path):
    require(type(path) is type(ROOT) and path.is_absolute(),'fixed absolute Path required')
    rows=[]
    for parent in reversed(path.parents):
        info=parent.lstat()
        attrs=getattr(info,'st_file_attributes',None)
        require(type(attrs) is int and attrs>=0 and stat.S_ISDIR(info.st_mode)
                and not stat.S_ISLNK(info.st_mode) and not attrs&0x400,'ancestor is not a plain directory')
        rows.append((str(parent),info.st_dev,info.st_ino,info.st_mode,attrs))
    return tuple(rows)


def cross_identity(info,path,*,pathname):
    row=raw_identity(info)
    require(not pathname or info.st_ctime_ns==info.st_birthtime_ns,'pathname creation-time projection differs')
    mode=info.st_mode
    if path in (BASE,VENV):
        require(stat.S_ISREG(mode) and (mode&0o111)==(0o111 if pathname else 0),
                'fixed interpreter execute-bit role differs')
        mode&=~0o111
    return row[:4]+(row[8],mode,row[6],row[7])


def plain_file(info):
    row=raw_identity(info)
    require(stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode)
            and info.st_nlink==1 and not row[7]&0x400,'plain one-link regular file required')


def read(path,expected,*,maximum):
    pin(expected);require(type(maximum) is int and 0<maximum<=4194304,'finite input cap differs')
    chain=directory_chain(path);before=path.lstat();plain_file(before)
    require(0<before.st_size<=maximum,'input size outside cap')
    with path.open('rb',buffering=0) as stream:
        opened=os.fstat(stream.fileno());plain_file(opened)
        data=stream.read(maximum+1);closed=os.fstat(stream.fileno());plain_file(closed)
    after=path.lstat();plain_file(after)
    require(raw_identity(before)==raw_identity(after) and raw_identity(opened)==raw_identity(closed)
            and cross_identity(before,path,pathname=True)==cross_identity(opened,path,pathname=False)
            and cross_identity(after,path,pathname=True)==cross_identity(closed,path,pathname=False)
            and directory_chain(path)==chain and len(data)==before.st_size
            and len(data)<=maximum and sha(data)==expected,'input identity/content changed')
    witness=(data,raw_identity(before),raw_identity(opened),chain)
    if path in WITNESSES:require(WITNESSES[path]==witness,'input changed after first observation')
    else:WITNESSES[path]=witness
    return data


def absent(path):
    directory_chain(path)
    try:path.lstat()
    except FileNotFoundError:return
    raise ValueError('create-once path already exists: '+str(path))


def active_owner():
    now=datetime.now(timezone.utc)
    require(OWNER_START<=now<OWNER_END,'reviewed owner window inactive')
    owner=parse(read(OWNER,OWNER_SHA256,maximum=65536))
    require(owner['work_start_utc']=='2026-10-01T16:36:15Z'
            and owner['work_end_utc']=='2026-10-02T22:36:15Z'
            and owner['public_actions_authorized'] is False and owner['one_use_replay_authorized'] is False,
            'owner interval/scope differs')
    read(OWNER_REVIEW,OWNER_REVIEW_SHA256,maximum=65536)
    return now


def reobserve():
    for path,(data,identity,handle_identity,chain) in tuple(WITNESSES.items()):
        require(read(path,sha(data),maximum=len(data))==data,'observed input changed at boundary')
    active_owner()


def write_bytes_once(path,payload,*,maximum):
    require(path.parent==RUNS and path in (STARTED,RESULT,JUNIT,FINISHED,FAILED),'output path outside finite run set')
    require(type(payload) is bytes and 0<len(payload)<=maximum,'output exceeds finite cap')
    absent(path);chain=directory_chain(path)
    descriptor=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|getattr(os,'O_BINARY',0),0o400)
    with os.fdopen(descriptor,'wb') as stream:stream.write(payload);stream.flush();os.fsync(stream.fileno())
    require(directory_chain(path)==chain and read(path,sha(payload),maximum=maximum)==payload,'exclusive output readback differs')
    return sha(payload)


def write_json_once(path,document,*,maximum=MAX_RESULT):
    return write_bytes_once(path,canonical(document)+b'\n',maximum=maximum)


def template_projection(source):
    tree=ast.parse(source)
    nodes=[node for node in tree.body if isinstance(node,ast.Assign) and len(node.targets)==1
           and isinstance(node.targets[0],ast.Name) and node.targets[0].id=='INDEPENDENT_STATIC_REVIEW_SHA256']
    require(len(nodes)==1 and nodes[0].lineno==nodes[0].end_lineno,'exact single review binding absent')
    require(isinstance(nodes[0].value,ast.Constant) and type(nodes[0].value.value) is str
            and nodes[0].value.value==INDEPENDENT_STATIC_REVIEW_SHA256,'review literal not exact bound string')
    lines=source.decode('ascii').splitlines(keepends=True)
    require(lines[nodes[0].lineno-1]=='INDEPENDENT_STATIC_REVIEW_SHA256='+repr(INDEPENDENT_STATIC_REVIEW_SHA256)+'\n',
            'binding line must be the exact lone literal assignment')
    lines[nodes[0].lineno-1]='INDEPENDENT_STATIC_REVIEW_SHA256=None\n'
    return ''.join(lines).encode('ascii')


def prepare_test_namespace(common_source,test_source):
    common_tree=ast.parse(common_source)
    for wanted in SELECTED_COMMON_SETS:
        found=[node.name for node in common_tree.body if isinstance(node,ast.FunctionDef) and node.name in wanted]
        require(len(found)==len(wanted) and set(found)==wanted,'selected common definitions differ')
    tree=ast.parse(test_source)
    wanted_classes=set(HELPER_CLASSES+CASE_CLASSES)
    chosen=[node for node in tree.body if (isinstance(node,ast.ClassDef) and node.name in wanted_classes)
            or (isinstance(node,ast.FunctionDef) and node.name=='observation')]
    require({node.name for node in chosen}==wanted_classes|{'observation'}
            and len(chosen)==len(wanted_classes)+1,'exact selected test definitions differ')
    names=tuple(sorted(node.name+'.'+method.name for node in chosen if isinstance(node,ast.ClassDef)
                and node.name in CASE_CLASSES for method in node.body
                if isinstance(method,ast.FunctionDef) and method.name.startswith('test_')))
    require(names==CASE_NAMES and len(names)==len(set(names))==37,'exact ordered37 methods differ')
    captured_wanted=[frozenset(ast.literal_eval(node.value)) for node in ast.walk(tree)
                     if isinstance(node,ast.Assign) and any(isinstance(target,ast.Name)
                        and target.id=='wanted' for target in node.targets)]
    require(tuple(captured_wanted)==SELECTED_COMMON_SETS,'captured definition selections differ')
    future=ast.ImportFrom(module='__future__',names=[ast.alias(name='annotations')],level=0)
    module=ast.fix_missing_locations(ast.Module(body=[future,*chosen],type_ignores=[]))
    namespace={'__name__':'_front_guard002_synthetic_cases_001','__file__':str(TEST),'ast':ast,
        'base64':base64,'copy':copy,'datetime':datetime,'timezone':timezone,'hashlib':hashlib,
        'json':json,'re':re,'stat':stat,'time':time,'types':types,'unittest':unittest,'patch':patch,'Path':Path}
    # No full test module imports/top-level main or full front namespace is executed.
    # The reviewed tests compile only selected common functions with OS/CIM doubles.
    compiled=compile(module,str(TEST),'exec',dont_inherit=True)
    return namespace,compiled,common_source.decode('utf-8')


class CappedText(io.StringIO):
    def __init__(self):super().__init__();self.byte_count=0
    def write(self,value):
        require(type(value) is str,'test transcript must remain text')
        self.byte_count+=len(value.encode('utf-8'))
        require(self.byte_count<=MAX_TRANSCRIPT,'test transcript cap exceeded')
        return super().write(value)


class RecordingResult(unittest.TextTestResult):
    def __init__(self,*args,**kwargs):
        super().__init__(*args,**kwargs)
        self.named_cases=[];self.subtest_events=[];self.fixture_events=[];self._active={}

    @staticmethod
    def case_name(test):
        return test.__class__.__name__+'.'+test._testMethodName

    def event(self,test,kind,detail):
        text=str(detail)[:8192]
        if hasattr(test,'_testMethodName') and test.__class__.__name__ in CASE_CLASSES:
            name=self.case_name(test)
            require(name in self._active,'test outcome without active named method')
            row=self._active[name];row['events'].append({'kind':kind,'detail':text})
            if kind in ('error','failure','unexpected_success'):
                if row['outcome']!='error' or kind=='error':row['outcome']=kind
            elif row['outcome']=='running':row['outcome']=kind
        else:
            require(len(self.fixture_events)<128,'fixture-event cap exceeded')
            self.fixture_events.append({'label':str(test)[:1024],'kind':kind,'detail':text})

    def startTest(self,test):
        name=self.case_name(test)
        require(name in CASE_NAMES and name not in self._active,'named-test identity differs')
        previous_index=-1 if not self.named_cases else CASE_NAMES.index(self.named_cases[-1]['name'])
        require(CASE_NAMES.index(name)>previous_index,'named-test order differs')
        row={'name':name,'outcome':'running','events':[],'subtest_indices':[],'elapsed_ns':None}
        self.named_cases.append(row);self._active[name]=row;row['_started_ns']=time.monotonic_ns()
        super().startTest(test)

    def addSuccess(self,test):
        super().addSuccess(test);self.event(test,'passed','')

    def addFailure(self,test,error):
        self.event(test,'failure',self._exc_info_to_string(error,test));super().addFailure(test,error)

    def addError(self,test,error):
        self.event(test,'error',self._exc_info_to_string(error,test));super().addError(test,error)

    def addSkip(self,test,reason):
        if hasattr(test,'test_case') and test.test_case.__class__.__name__ in CASE_CLASSES:
            parent=test.test_case;name=self.case_name(parent);row=self._active[name]
            require(len(self.subtest_events)<MAX_SUBTESTS,'subtest-event cap exceeded')
            index=len(self.subtest_events)
            self.subtest_events.append({'index':index,'parent':name,'parameters':str(test.params)[:2048],
                                        'outcome':'skipped','detail':str(reason)[:8192]})
            row['subtest_indices'].append(index);self.event(parent,'skipped',reason)
        else:self.event(test,'skipped',reason)
        super().addSkip(test,reason)

    def addExpectedFailure(self,test,error):
        self.event(test,'expected_failure',self._exc_info_to_string(error,test));super().addExpectedFailure(test,error)

    def addUnexpectedSuccess(self,test):
        self.event(test,'unexpected_success','unexpected success');super().addUnexpectedSuccess(test)

    def addSubTest(self,test,subtest,error):
        require(len(self.subtest_events)<MAX_SUBTESTS,'subtest-event cap exceeded')
        name=self.case_name(test);row=self._active[name]
        outcome='passed' if error is None else ('failure' if issubclass(error[0],test.failureException) else 'error')
        detail='' if error is None else self._exc_info_to_string(error,test)[:8192]
        index=len(self.subtest_events)
        self.subtest_events.append({'index':index,'parent':name,'parameters':str(subtest.params)[:2048],
                                    'outcome':outcome,'detail':detail})
        row['subtest_indices'].append(index)
        if error is not None:self.event(test,outcome,detail)
        super().addSubTest(test,subtest,error)

    def stopTest(self,test):
        row=self._active[self.case_name(test)]
        row['elapsed_ns']=time.monotonic_ns()-row.pop('_started_ns')
        if row['outcome']=='running':row['outcome']='error';row['events'].append({'kind':'error','detail':'no terminal named-test outcome'})
        super().stopTest(test)


def junit_bytes(result):
    cases=result.named_cases;fixtures=result.fixture_events
    failures=sum(row['outcome'] in ('failure','unexpected_success') for row in cases)+sum(row['kind'] in ('failure','unexpected_success') for row in fixtures)
    errors=sum(row['outcome']=='error' for row in cases)+sum(row['kind']=='error' for row in fixtures)
    skipped=sum(row['outcome'] in ('skipped','expected_failure') for row in cases)+sum(row['kind'] in ('skipped','expected_failure') for row in fixtures)
    suite=ET.Element('testsuite',name='front_guard002_synthetic37',tests=str(len(cases)+len(fixtures)),
                     failures=str(failures),errors=str(errors),skipped=str(skipped))
    properties=ET.SubElement(suite,'properties')
    for key,value in (('planned_named_cases',37),('actual_named_cases',len(cases)),
                     ('subtest_events',len(result.subtest_events)),('subtest_failures',sum(r['outcome']=='failure' for r in result.subtest_events)),
                     ('subtest_errors',sum(r['outcome']=='error' for r in result.subtest_events)),
                     ('unittest_failure_events',len(result.failures)),('unittest_error_events',len(result.errors)),
                     ('scope','selected AST definitions; OS/CIM/image/query mocks; no real native/quiet proof')):
        ET.SubElement(properties,'property',name=key,value=str(value))
    for row in cases:
        classname,name=row['name'].split('.',1)
        case=ET.SubElement(suite,'testcase',classname=classname,name=name,
                           time=format(row['elapsed_ns']/1000000000,'.9f'))
        if row['outcome'] in ('failure','unexpected_success','error'):
            tag='error' if row['outcome']=='error' else 'failure'
            failure=ET.SubElement(case,tag,type=row['outcome'],message='named test or subtest did not pass')
            failure.text='\n'.join(event['detail'] for event in row['events'] if event['kind']!='passed')
        elif row['outcome'] in ('skipped','expected_failure'):
            ET.SubElement(case,'skipped',message=row['outcome'])
        subtests=[result.subtest_events[index] for index in row['subtest_indices']]
        ET.SubElement(case,'system-out').text=canonical({'subtests':subtests}).decode('ascii')
    for row in fixtures:
        case=ET.SubElement(suite,'testcase',classname='unittest_fixture',name=row['label'])
        if row['kind'] in ('skipped','expected_failure'):
            ET.SubElement(case,'skipped',message=row['kind']).text=row['detail']
        else:
            tag='error' if row['kind']=='error' else 'failure'
            ET.SubElement(case,tag,type=row['kind'],message='fixture outcome').text=row['detail']
    ET.indent(suite,space='  ')
    payload=ET.tostring(suite,encoding='utf-8',xml_declaration=True)+b'\n'
    require(len(payload)<=MAX_JUNIT,'JUnit byte cap exceeded')
    return payload


def assert_no_project_imports():
    require(not any(name=='bu' or name.startswith('bu.') or name.startswith('native_successor_')
                    or name.startswith('native_phase_evidence_') or name.startswith('native_poststatus_')
                    for name in sys.modules),'project/full front module was imported')


def runtime_guard():
    require(os.name=='nt' and Path(sys.executable)==BASE and Path(sys._base_executable)==BASE,
            'fixed direct frozen base interpreter required')
    require(sys.version_info[:3]==(3,13,5) and sys.maxsize==2**63-1,'reviewed Python version/architecture differs')
    require(all(getattr(sys.flags,name)==1 for name in ('isolated','no_site','no_user_site',
                'dont_write_bytecode','utf8_mode','safe_path')) and sys.flags.optimize==0
            and sys.dont_write_bytecode is True,'isolated -I -S -B -X utf8 flags required')
    require(Path.cwd()==ROOT,'fixed harness working directory required')
    require(not any(key.upper().startswith('PYTHON') for key in os.environ),'Python startup environment must be cleared')
    thread_keys=('OMP_NUM_THREADS','MKL_NUM_THREADS','OPENBLAS_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS')
    require(all(os.environ.get(key)=='1' for key in thread_keys),'stable one-thread environment required')
    read(BASE,BASE_SHA256,maximum=2097152)
    read(VENV,VENV_SHA256,maximum=2097152)
    read(CFG,CFG_SHA256,maximum=32768)
    assert_no_project_imports()


def validate_authorizations(source,script_sha256,bound_review_sha256,root_ack_sha256):
    template_sha256=sha(template_projection(source))
    review=parse(read(STATIC_REVIEW,INDEPENDENT_STATIC_REVIEW_SHA256,maximum=524288))
    require(type(review) is dict and review.get('verdict')=='PASS_STATIC'
            and review.get('runner_template_sha256')==template_sha256
            and review.get('test_source_sha256')==TEST_SHA256 and review.get('common_source_sha256')==COMMON_SHA256
            and review.get('guard_review_sha256')==GUARD_REVIEW_SHA256
            and review.get('private_source_copies_verified') is True and review.get('tests_executed') is False
            and review.get('external_supervision_required') is True and review.get('operational_authority_granted') is False
            and type(review.get('reviewer')) is str and review['reviewer'] not in ('bootstrap_stage','/root/bootstrap_stage'),
            'independent unbound static review contract differs')
    ack=parse(read(ACK,root_ack_sha256,maximum=65536))
    fields={'schema_version','record_type','decision','runner_template_sha256','bound_runner_sha256',
        'independent_static_review_sha256','guard_review_sha256','test_source_sha256','common_source_sha256',
        'owner_record_sha256','owner_work_start_utc','owner_work_end_utc','run_root',
        'maximum_supervised_seconds','external_owned_process_supervision_required','run_authorized',
        'project_execution_authorized','native_execution_authorized','public_action_authorized',
        'scientific_outcomes_authorized'}
    require(type(ack) is dict and set(ack)==fields and type(ack['schema_version']) is int and ack['schema_version']==1
            and ack['record_type']=='front_guard002_synthetic37_root_ack'
            and ack['decision']=='execute_front_guard002_37_synthetic_tests_once'
            and ack['runner_template_sha256']==template_sha256 and ack['bound_runner_sha256']==script_sha256
            and ack['independent_static_review_sha256']==INDEPENDENT_STATIC_REVIEW_SHA256
            and ack['guard_review_sha256']==GUARD_REVIEW_SHA256
            and ack['test_source_sha256']==TEST_SHA256 and ack['common_source_sha256']==COMMON_SHA256
            and ack['owner_record_sha256']==OWNER_SHA256 and ack['owner_work_start_utc']=='2026-10-01T16:36:15Z'
            and ack['owner_work_end_utc']=='2026-10-02T22:36:15Z' and ack['run_root']==str(RUNS)
            and type(ack['maximum_supervised_seconds']) is int and ack['maximum_supervised_seconds']==60
            and ack['external_owned_process_supervision_required'] is True and ack['run_authorized'] is True
            and all(ack[name] is False for name in ('project_execution_authorized','native_execution_authorized',
                'public_action_authorized','scientific_outcomes_authorized')),'fresh exact synthetic-only ROOT ACK differs')
    bound=parse(read(BOUND_REVIEW,bound_review_sha256,maximum=524288))
    require(type(bound) is dict and bound.get('verdict')=='PASS_BOUND_STATIC'
            and bound.get('bound_runner_sha256')==script_sha256 and bound.get('runner_template_sha256')==template_sha256
            and bound.get('root_ack_sha256')==root_ack_sha256
            and bound.get('independent_static_review_sha256')==INDEPENDENT_STATIC_REVIEW_SHA256
            and bound.get('test_source_sha256')==TEST_SHA256 and bound.get('common_source_sha256')==COMMON_SHA256
            and bound.get('only_review_literal_changed') is True and bound.get('tests_executed') is False
            and bound.get('external_supervision_required') is True and bound.get('operational_authority_granted') is False
            and type(bound.get('reviewer')) is str and bound['reviewer'] not in ('bootstrap_stage','/root/bootstrap_stage'),
            'independent exact bound-source/ACK review differs')
    return template_sha256


def main():
    parser=argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--expected-script-sha256',required=True)
    parser.add_argument('--bound-review-sha256',required=True)
    parser.add_argument('--root-ack-sha256',required=True)
    args=parser.parse_args()
    script_sha256=pin(args.expected_script_sha256);bound_review_sha256=pin(args.bound_review_sha256)
    root_ack_sha256=pin(args.root_ack_sha256);pin(INDEPENDENT_STATIC_REVIEW_SHA256)
    require(Path(__file__)==SELF,'fixed reviewed bound driver path required')
    require(sys.orig_argv==[str(BASE),'-I','-S','-B','-X','utf8',str(SELF),
            '--expected-script-sha256',script_sha256,'--bound-review-sha256',bound_review_sha256,
            '--root-ack-sha256',root_ack_sha256],'exact supervised invocation differs')
    source=read(SELF,script_sha256,maximum=262144)
    runtime_guard();active_owner()
    template_sha256=validate_authorizations(source,script_sha256,bound_review_sha256,root_ack_sha256)
    guard=parse(read(GUARD_REVIEW,GUARD_REVIEW_SHA256,maximum=524288))
    require(type(guard) is dict and guard.get('verdict')=='PASS_STATIC_GUARD_ONLY'
            and guard.get('test_method_count')==37 and tuple(guard.get('ordered_test_names',()))==CASE_NAMES
            and guard.get('operational_authority_granted') is False,'original guard-only review differs')
    provenance=parse(read(PROVENANCE,PROVENANCE_SHA256,maximum=65536))
    require(type(provenance) is dict and provenance['private_source_copy_count']==2
            and provenance['planned_case_count']==37 and tuple(provenance['case_names'])==CASE_NAMES,
            'private copy provenance differs')
    require(sorted(path.name for path in INPUTS.iterdir())==sorted((COMMON.name,TEST.name)),
            'private input folder exact two-source scope differs')
    common_source=read(COMMON,COMMON_SHA256,maximum=262144)
    test_source=read(TEST,TEST_SHA256,maximum=65536)
    front=ROOT.parent/'native-attempt013-front-revision002'
    original_common=front/COMMON.name;original_test=front/TEST.name
    require(read(original_common,COMMON_SHA256,maximum=262144)==common_source
            and read(original_test,TEST_SHA256,maximum=65536)==test_source,'frozen originals/copies differ')
    identities=[(path.lstat().st_dev,path.lstat().st_ino) for path in (COMMON,TEST,original_common,original_test)]
    require(len(set(identities))==4,'private copies must have distinct independent inodes')
    copy_rows={row['path']:row for row in provenance['copies']}
    for path in (COMMON,TEST):
        row=copy_rows[str(path.relative_to(ROOT)).replace('\\','/')]
        require(row['independent_inode'] is True and row['copy_identity']==list((path.lstat().st_dev,path.lstat().st_ino)),
                'frozen private copy identity changed')
    namespace,compiled,common_text=prepare_test_namespace(common_source,test_source)
    # Compiling the chosen AST does not execute definitions. All compilation and
    # review/runtime/owner/copy proofs precede the exclusive run-directory claim.
    absent(RUNS);reobserve();runtime_guard()
    chain=directory_chain(RUNS);RUNS.mkdir()
    require(directory_chain(RUNS)==chain,'run-directory ancestor identity changed')
    require(stat.S_ISDIR(RUNS.lstat().st_mode) and not int(RUNS.lstat().st_file_attributes)&0x400,
            'claimed run directory is not plain')
    for path in (STARTED,RESULT,JUNIT,FINISHED,FAILED):absent(path)
    started_at=active_owner().isoformat()
    common={'schema_version':1,'runner_sha256':script_sha256,'runner_template_sha256':template_sha256,
        'test_source_sha256':TEST_SHA256,'common_source_sha256':COMMON_SHA256,'guard_review_sha256':GUARD_REVIEW_SHA256,
        'copy_provenance_sha256':PROVENANCE_SHA256,'independent_static_review_sha256':INDEPENDENT_STATIC_REVIEW_SHA256,
        'bound_review_sha256':bound_review_sha256,'root_ack_sha256':root_ack_sha256,
        'owner_record_sha256':OWNER_SHA256,'owner_work_end_utc':'2026-10-02T22:36:15Z','started_at_utc':started_at,
        'planned_named_cases':37,'scope':'synthetic selected guard/test AST definitions with OS/CIM/image/query mocks',
        'base_python_sha256':BASE_SHA256,'venv_python_sha256':VENV_SHA256,'venv_cfg_sha256':CFG_SHA256,
        'driver_subprocess_launches':0,'external_supervision_required':True,'maximum_supervised_seconds':60,
        'driver_builtin_process_timeout':False,'driver_descendant_cleanup_claim':False,
        'full_front_module_imported':False,'front_operational_main_executed':False,'project_code_imported':False,
        'real_owned_pair_proven':False,'real_quiet_host_proven':False,'native_invoked':False,'production_invoked':False,
        'public_action_performed':False,'scientific_outcomes_consulted':False,'scientific_values_emitted':False,
        'release009_or_schema2_or_grouped_qa_readiness_proven':False}
    write_json_once(STARTED,dict(common,record_type='front_guard002_synthetic37_started',
                               captured_guard_definitions_executed=False))
    result=None
    try:
        original_read_text=Path.read_text;original_sleep=time.sleep;source_read_count=0
        def captured_read_text(path,*positional,**keywords):
            nonlocal source_read_count
            require(type(path) is type(ROOT) and path==COMMON and not positional
                    and keywords=={'encoding':'utf-8'},'test source read escaped exact captured common')
            source_read_count+=1
            require(source_read_count<=3,'unexpected additional common source read')
            return common_text
        reobserve();runtime_guard()
        exec(compiled,namespace)
        suite=unittest.TestSuite(namespace[class_name](method_name)
            for class_name,method_name in (name.split('.',1) for name in CASE_NAMES))
        stream=CappedText();runner=unittest.TextTestRunner(stream=stream,verbosity=2,failfast=False,resultclass=RecordingResult)
        # Only three source reads are permitted, and each receives captured pinned
        # text. Every actual host/image/query/native API in selected guards is mocked.
        with patch.object(Path,'read_text',captured_read_text):result=runner.run(suite)
        require(Path.read_text is original_read_text and time.sleep is original_sleep,'stdlib test patches escaped their scope')
        transcript=stream.getvalue()
        actual_names=tuple(row['name'] for row in result.named_cases)
        require(actual_names==tuple(name for name in CASE_NAMES if name in actual_names)
                and result.testsRun==len(result.named_cases),'actual named-case order/count differs')
        reobserve();runtime_guard();assert_no_project_imports()
        successful=(result.wasSuccessful() and len(result.named_cases)==37 and source_read_count==3 and not result.fixture_events
            and not result.skipped and not result.expectedFailures and not result.unexpectedSuccesses
            and all(row['outcome']=='passed' for row in result.named_cases)
            and all(row['outcome']=='passed' for row in result.subtest_events))
        completed=dict(common,record_type='front_guard002_synthetic37_result',finished_at_utc=active_owner().isoformat(),
            captured_guard_definitions_executed=True,tests_run=result.testsRun,
            named_cases_passed=sum(row['outcome']=='passed' for row in result.named_cases),
            named_case_records=result.named_cases,fixture_events=result.fixture_events,
            subtest_count=len(result.subtest_events),subtest_events=result.subtest_events,
            subtest_failures=sum(row['outcome']=='failure' for row in result.subtest_events),
            subtest_errors=sum(row['outcome']=='error' for row in result.subtest_events),
            unittest_failure_events=len(result.failures),unittest_error_events=len(result.errors),
            unittest_skips=len(result.skipped),expected_failures=len(result.expectedFailures),
            unexpected_successes=len(result.unexpectedSuccesses),captured_source_read_count=source_read_count,
            successful=successful,transcript=transcript,exit_code=0 if successful else 1)
        result_sha256=write_json_once(RESULT,completed)
        junit_sha256=write_bytes_once(JUNIT,junit_bytes(result),maximum=MAX_JUNIT)
        reobserve();runtime_guard()
        write_json_once(FINISHED,dict(common,record_type='front_guard002_synthetic37_finished',
            finished_at_utc=active_owner().isoformat(),captured_guard_definitions_executed=True,
            tests_run=result.testsRun,named_cases_passed=completed['named_cases_passed'],subtest_count=len(result.subtest_events),
            successful=successful,exit_code=completed['exit_code'],result_sha256=result_sha256,junit_sha256=junit_sha256))
        print(json.dumps({'state':'finished','successful':successful,'tests_run':result.testsRun,
                          'result_sha256':result_sha256,'junit_sha256':junit_sha256},sort_keys=True))
        return completed['exit_code']
    except BaseException as error:
        # ROOT's external process attempt is consumed even if this best-effort
        # terminal receipt cannot be written. Never infer permission to replay.
        try:
            absent(FINISHED);absent(FAILED)
            write_json_once(FAILED,dict(common,record_type='front_guard002_synthetic37_failed',
                finished_at_utc=datetime.now(timezone.utc).isoformat(),error_type=type(error).__name__,
                error=str(error)[:4096],exit_code=1,partial_result_available=result is not None,
                partial_tests_run=None if result is None else result.testsRun,
                partial_named_cases=[] if result is None else result.named_cases,
                partial_subtest_events=[] if result is None else result.subtest_events,
                successful=False))
        except BaseException:
            pass
        raise


if __name__=='__main__':raise SystemExit(main())
