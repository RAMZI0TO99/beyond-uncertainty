"""Root-owned once-only source binder entry; no metadata phase/target entry."""
from pathlib import Path
from datetime import datetime,timezone
import hashlib,json,os,subprocess
base=Path('D:/Aenv/pro2/resume-2026-10-01-30h-001');p=base/'guard005-root-metadata-prep002'
sha=lambda d:hashlib.sha256(d).hexdigest()
audit=json.loads((base/'DOCS_REFRESH_AUDIT_023.json').read_bytes())
mr=next(r for r in audit['files'] if r['path'].endswith('/STAGED_MANIFEST_002.json'))
mb=(p/'STAGED_MANIFEST_002.json').read_bytes();assert sha(mb)==mr['sha256']
m=json.loads(mb)
brow=next(r for r in m['files'] if r['relative_path']=='BIND_SOURCE_AND_PHASES_002.TEMPLATE.py')
binder=p/brow['relative_path'];bd=binder.read_bytes();assert sha(bd)==brow['sha256'] and len(bd)==brow['bytes']
peer_path=p/'INDEPENDENT_METADATA_STATIC_REVIEW_005.json';peer_bytes=peer_path.read_bytes();peer=json.loads(peer_bytes)
assert sha(peer_bytes)=='af6580f58fbab70548355973d72ce2281a17384d2af2719bb5665ff77b88e06d'
assert peer['verdict']=='PASS_STATIC_METADATA_PREPARATION_ONLY' and peer['reviewer']=='/root/window_docs' and peer['manifest_sha256']==sha(mb)
for name in ('capture-guard005-root-metadata.BOUND.py','ACTUAL_SOURCE_BINDING_002.json','ROOT_METADATA_AUTHORIZATION_BEFORE_005.json','ROOT_METADATA_AUTHORIZATION_AFTER_005.json','phase-before-005','phase-after-005'):
 assert not (p/name).exists(),name
python=Path('D:/Aenv/pro2/pro2/.venv/Scripts/python.exe')
assert sha(python.read_bytes())=='935016795f3e6908e75acbc2040a01e2e4cdb494a57c42f63a0d6eedb2372256'
record=dict(schema_version=1,record_type='root_metadata_prep002_source_binding_authorization',author='/root',created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),stage='python_source_copy_only',manifest_sha256=sha(mb),binder_sha256=sha(bd),preparer_peer_sha256=sha(peer_bytes),decision='CREATE_REVIEWED_NINE_SHA_THREE_PATH_SOURCE_SUBSTITUTIONS_ONCE',phase_authorization_or_capture_or_unit_entry_authorized=False,source_compilation_import_target_definition_execution_authorized=False,powershell_phase_binding_requires_separate_actual_bound9_review=True)
with (p/'ROOT_SOURCE_BINDING_AUTHORIZATION_PYTHON_002_001.json').open('xb') as stream:stream.write((json.dumps(record,indent=2,sort_keys=True)+'\n').encode());stream.flush();os.fsync(stream.fileno())
env=os.environ.copy()
for key in list(env):
 if key.startswith('PYTHON') or key.startswith('GIT_'):del env[key]
env['PYTHONDONTWRITEBYTECODE']='1'
result=subprocess.run([str(python),'-I','-S','-B','-X','utf8',str(binder),'--expected-self-sha256',sha(bd),'--stage','python','--expected-preparer-peer-sha256',sha(peer_bytes)],cwd=base,env=env,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30,check=False)
assert len(result.stdout)<=65536 and len(result.stderr)<=65536
terminal=dict(schema_version=1,author='/root',finished_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),stage='python_source_copy_only',exit_code=result.returncode,stdout_sha256=sha(result.stdout),stderr_sha256=sha(result.stderr),stdout_bytes=len(result.stdout),stderr_bytes=len(result.stderr),metadata_phase_or_unit_entered=False)
with (p/'ROOT_SOURCE_BINDING_TERMINAL_PYTHON_002_001.json').open('xb') as stream:stream.write((json.dumps(terminal,indent=2,sort_keys=True)+'\n').encode());stream.flush();os.fsync(stream.fileno())
print(json.dumps(terminal))
if result.returncode:print(result.stderr.decode('utf-8',errors='replace'))
assert result.returncode==0
print(json.dumps(dict(bound_source_sha256=sha((p/'capture-guard005-root-metadata.BOUND.py').read_bytes()),binding_record_sha256=sha((p/'ACTUAL_SOURCE_BINDING_002.json').read_bytes()),metadata_phase_entered=False)))
