import ast,datetime,hashlib,json
from pathlib import Path
ROOT=Path('D:/Aenv/pro2'); OUT=ROOT/'resume-2026-10-03-continuation001/capsule-design-independent-review001'; OLD=ROOT/'resume-2026-10-01-30h-001'
CAP=OLD/'consumer005-compact-source-capsule-prep001'; DES=OLD/'guard005-fresh-metadata-pipeline-design001'
def get(p): return json.loads(p.read_bytes())
def dump(v): return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode('ascii')
def sha(b): return hashlib.sha256(b).hexdigest()
def once(name,b):
    with (OUT/name).open('xb') as f:f.write(b)
def main():
    context=get(DES/'inputs/22-actual_context.json'); d=get(DES/'FRESH_METADATA_PIPELINE_SOURCE_DESIGN_002.json'); d1=get(DES/'FRESH_METADATA_PIPELINE_SOURCE_DESIGN_001.json')
    assert d['source_derived_Gitmetadata7']['role_keys']==context['git_metadata']
    # Only targeted sequence steps changed; all other retained steps remain exact.
    changes=[i for i,(a,b) in enumerate(zip(d1['sequence'],d['sequence'])) if a!=b]
    assert len(d1['sequence'])==len(d['sequence'])==8 and changes==[3,5]
    hp1=dict(d1['historical_pipeline']); hp2=dict(d['historical_pipeline'])
    # Revision002 qualifies misleading literal absence names; timestamps/history otherwise stay exact.
    changed_historical=[k for k in hp1 if hp1[k]!=hp2[k]]
    assert changed_historical==['selected_absences']
    inp=CAP/'inputs'; current=ast.parse((inp/'test.bytes').read_bytes()); prior=ast.parse((inp/'before004_test.bytes').read_bytes())
    cls=[n for n in current.body if isinstance(n,ast.ClassDef)]; names={n.name for n in cls}
    for n in current.body:
        ts=n.targets if isinstance(n,ast.Assign) else [n.target] if isinstance(n,ast.AnnAssign) else []
        assert not any(isinstance(t,ast.Name) and t.id in names for t in ts)
    old_other=[ast.dump(n,include_attributes=False) for n in prior.body if not(isinstance(n,ast.FunctionDef) and n.name=='guard_fixture')]
    new_other=[ast.dump(n,include_attributes=False) for n in current.body if not(isinstance(n,ast.FunctionDef) and n.name in ('guard_fixture','metaclass_spoof_row')) and not(isinstance(n,ast.ClassDef) and n.name==cls[1].name)]
    assert old_other==new_other
    failure=get(CAP/'PREPARATION_WRITER_FAILURE_001.json'); assert failure['initial_observation_timestamps_or_metadata_receipt_available'] is False
    result=dict(schema_version=1,record_type='independent_capsule_design_additional_precision_checks',reviewer='/root/capsule_design_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),all_seven_Git_rows_byte_value_equivalent_to_pinned_context=True,only_sequence_steps_changed=changes,only_historical_field_changed=changed_historical,prior_nonfixture_top_level_test_AST_exact=True,test_classes_not_rebound=True,initial001_observation_time_not_retroactively_claimed=True,target_execution=False,authority=False)
    once('SUPPLEMENTARY_PRECISION_CHECKS_002.json',dump(result))
    md='''# Independent capsule and Design002 static review

Two separate source-only acceptances are recorded in this directory. No reviewed code was compiled, imported, defined or called, and no target tests, helper, Git, FFI or PowerShell action ran.

Capsule review: PASS_STATIC_COMPACT_CAPSULE_DERIVATION_WITH_IMPLEMENTATION_CONDITIONS. The 24627-byte capsule has 18 closed top-level fields and exact nested nominal shapes. All five Consumer005 predicate reversals recover Consumer004 bytes exactly; Raw4 AST/API/caps and the two direct sibling test classes (19+5 methods) were independently reconstructed. The full Source005 peer remains externally pinned and does not become the old Source003 record. Old 51 top-level keys / nested12 and new38 / 456833-byte old-cap excess are corroborated. Attributed inert CodeType metadata and unchanged Path isinstance semantics are qualified. Initial writer001 ASCII refusal is preserved; its missing initial timing receipt is not invented.

Design002 review: PASS_STATIC_DESIGN002_NARROW_CORRECTIONS_WITH_IMPLEMENTATION_CONDITIONS. The order is genuine Root ACK22, different BOUND22, Root three-literal launcher binding, different LATE14, then separate fresh Root GO. Source-defined ACK/start names are corrected; historical absence is not future first-use proof. All seven Git metadata rows match the pinned context exactly and four runtime files remain separate. Only sequence steps 3/5 and the selected historical absence field changed; retained checker/ownership/limits/invariants and original001 files stay exact. This narrow peer relies on the previous different full001 design review, rather than claiming a new full pipeline proof.

The first compositor observed and copied 131 finite inputs three times plus post. Scope is finite selected evidence, not unknown-file absence, current execution ownership, quiet host or runtime readiness.

Separate implementation choices and source audits are required for the capsule reader, event grammar and harness, and for the fresh pipeline before/after producers and independent actual-decision checkers. Original 90/600/resource60/450+after60 budgets stay unchanged. Metadata002 is withdrawn and cannot be replayed or retimestamped. Historical expired owner records cannot authorize renewed execution.
'''
    once('INDEPENDENT_REVIEW_001.md',md.encode('ascii'))
    payload=[OUT/'AUDIT_CAPSULE_AND_DESIGN_001.py',OUT/'COMPLETE_REVIEW_SUPPLEMENT_002.py',OUT/'INDEPENDENT_COMPACT_CAPSULE_REVIEW_001.json',OUT/'INDEPENDENT_DESIGN002_NARROW_REVIEW_001.json',OUT/'INPUT_POST_STABILITY_001.json',OUT/'SUPPLEMENTARY_PRECISION_CHECKS_002.json',OUT/'INDEPENDENT_REVIEW_001.md']+[OUT/'inputs'/f'{i:03d}.bytes' for i in range(131)]
    rows=[dict(path=str(p.relative_to(OUT)),bytes=len(p.read_bytes()),sha256=sha(p.read_bytes())) for p in payload]
    once('AUDIT_MANIFEST_001.json',dump(dict(schema_version=1,reviewer='/root/capsule_design_review',finite_payload_files=len(rows),files=rows,unknown_file_absence_claimed=False,target_execution=False)))
    print(json.dumps(dict(supplement_sha256=sha(dump(result)),manifest_sha256=sha((OUT/'AUDIT_MANIFEST_001.json').read_bytes()),payload_files=len(rows))))
if __name__=='__main__':main()
