now=datetime.now(timezone.utc).isoformat(timespec='microseconds')
report=dict(schema_version=1,record_type='independent_checker25_complete_source_details',created_utc=now,reviewer='/root/binder_correction_audit',source_author='/root/bootstrap_stage',scope=scope,verdict='PASS_STATIC_SYNTHETIC_CHECKER25_RUNNER_ONLY',runner_source_sha256=sha(runner),parent_source_sha256=sha(parent),source_manifest_sha256=sha(mb),finite_inputs=records,input_count=len(records),copied_input_count=len(records),observations_per_input=3,original_copy_pairs=pairs,original_copy_pair_count=68,checks=[dict(id=k,finding=v)for k,v in checks],source_issues=[],planned_methods=25,old19_test_ASTs_exact=True,new_causal_methods=6,target_execution=False,tests_executed=False,actual_runtime=None,operational_authority=False,prepeer_output_absences=[str(p)for p in absence])
p=O/'INDEPENDENT_CHECKER25_RUNNER_SOURCE_DETAILS_001.json';p.write_text(json.dumps(report,indent=2,sort_keys=True)+'\n',encoding='utf8');rb,rr=observe(p)
peer=dict(schema_version=1,record_type='independent_checker25_runner_source_review',created_utc=now,reviewer='/root/binder_correction_audit',source_author='/root/bootstrap_stage',scope=scope,verdict='PASS_STATIC_SYNTHETIC_CHECKER25_RUNNER_ONLY',runner_source_sha256=sha(runner),parent_source_sha256=sha(parent),source_manifest_sha256=sha(mb),target_execution=False,actual_runtime=None)
