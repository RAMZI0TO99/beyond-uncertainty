    lease=decode(add(BASE/'EXECUTION_LEASE_GG6_M3_001.json','43cb0552e3117842868eb78ff4e6b52913a16e78f3c26b8caa754cfb6b29fc48'))
    need(len(master)==27 and master['work_end_utc'] is None and master['fixed_deadline_invented'] is False and len(owner_peer)==19 and owner_peer['reviewer']=='owner_docs_review','ongoing master and exact historical peer')
    need(len(lease)==12 and lease['lease_is_owner_deadline'] is False and type(lease['maximum_lease_seconds']) is int and lease['maximum_lease_seconds']==43200 and lease['owner_master_sha256']==owner_peer['source_owner_sha256'],'distinct finite lease')
    for key in ('created_utc','lease_end_utc'): need(re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{7}\+00:00',lease[key]),'native PS7 literal stamp')
    b7=DATA[str(U/'review_guard006_actual_records_001-corrected007.TEMPLATE.py')]
    b8=DATA[str(U/'review_guard006_actual_records_001-corrected008.TEMPLATE.py')]
    b10=DATA[str(U/'review_guard006_actual_records_001-corrected010.TEMPLATE.py')]
    proposal=DATA[str(U/'review_guard006_actual_records_001-corrected009.TEMPLATE.py')]
    need(proposal==b10 and c10['genuine_author_Source_tool']=='d1f6c8' and c10['adopted_Root_proposal']['Root_authorship_preserved'] is True,'PUB successor byte adoption; Root proposal history remains Root')
    t7=ast.parse(b7.decode('utf-8')); t8=ast.parse(b8.decode('utf-8')); t10=ast.parse(b10.decode('utf-8'))
    defs=lambda tree:{n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
    f7=defs(t7); f8=defs(t8); f10=defs(t10)
    need(set(f7)==set(f8)==set(f10) and len(f10)==41,'all41 definitions')
    changed=[n for n in f10 if dump(f8[n])!=dump(f10[n])]; need(changed==['physical_provenance'],'one changed full function')
    p=f8['physical_provenance']; edits=[]; text8=b8.decode('utf-8'); lines=text8.splitlines(keepends=True)
    for n in ast.walk(p):
        if isinstance(n,ast.Constant) and n.value==old_pattern:
            start=sum(map(len,lines[:n.lineno-1]))+n.col_offset; end=sum(map(len,lines[:n.end_lineno-1]))+n.end_col_offset
            token=text8[start:end]; need(old_pattern in token,'raw literal span'); edits.append((start,end,token.replace(old_pattern,new_pattern)))
    need(len(edits)==1,'single additional regex literal span')
    replacement=text8
    for start,end,token in sorted(edits,reverse=True): replacement=replacement[:start]+token+replacement[end:]
    need(replacement.encode('utf-8')==b10 and len(b10)-len(b8)==8,'complete008 to010 bytes only regex')
    restore8=copy.deepcopy(t10); reverse_count=0
    for n in ast.walk(defs(restore8)['physical_provenance']):
        if isinstance(n,ast.Constant) and n.value==new_pattern: n.value=old_pattern; reverse_count+=1
    need(reverse_count==1 and dump(restore8)==dump(t8),'full008 Module AST reversal')
    restore7=copy.deepcopy(restore8); inverse={v:k for k,v in c8['literal_changes'].items()}; reverse_count=0
    for n in ast.walk(defs(restore7)['physical_provenance']):
        if isinstance(n,ast.Constant) and type(n.value) is str and n.value in inverse: n.value=inverse[n.value]; reverse_count+=1
    need(reverse_count==3 and dump(restore7)==dump(t7),'complete007 Module AST reversed4 constants')
    # Independently reproduce the lawful protected indentation, not just AST comparison.
    literal=b7.decode('utf-8'); lines=literal.splitlines(keepends=True); spans=[]
    for n in ast.walk(f7['physical_provenance']):
        if isinstance(n,ast.Constant) and type(n.value) is str and n.value in c8['literal_changes']:
            start=sum(map(len,lines[:n.lineno-1]))+n.col_offset; end=sum(map(len,lines[:n.end_lineno-1]))+n.end_col_offset
            token=literal[start:end]; spans.append((start,end,token.replace(n.value,c8['literal_changes'][n.value])))
    need(len(spans)==3,'three lawful initial path literal changes')
    for start,end,token in sorted(spans,reverse=True): literal=literal[:start]+token+literal[end:]
    protected=set()
    for token in tokenize.generate_tokens(io.StringIO(literal).readline):
        if token.type==tokenize.STRING and token.start[0]<token.end[0]: protected.update(range(token.start[0]+1,token.end[0]+1))
    need(sorted(protected)==[2,3,4,5,6],'exact five protected lines')
    compact=[]
    for index,line in enumerate(literal.splitlines(keepends=True),1):
        width=len(line)-len(line.lstrip(' ')); compact.append((' '*(width//4)+line[width:]) if index not in protected and width>0 and width%4==0 else line)
    need(''.join(compact).encode('utf-8')==b8 and len(literal.encode('utf-8'))-len(b8)==3747,'independent entire protected indentation reconstruction')
    composer=DATA[str(U/'compose-root-review-packet-006.TEMPLATE.py')]
    need(sha(composer)=='1b909f93c795c1d162b025ccf4917513ee20eb2edfd5d1db80ff78afebd1d911' and len(composer)==14753,'composer exact')
    ast.parse(composer.decode('utf-8'))
    # These are own metadata predicate classifications, NOT full helper tests.
    tickets=next(n for n in t10.body if isinstance(n,ast.Assign) and isinstance(n.targets[0],ast.Name) and n.targets[0].id=='TICKET22')
    allowed=set(ast.literal_eval(tickets.value))|{'metadata_script_sha256','metadata_bound_review_sha256','observer_sha256','profile_sha256','harness_static_review_sha256','owner_lease_sha256'}
    argv_rows=[]; witnesses=[]
    need(len(p16['phase_argv_templates'])==8,'all eight P16 domains')
    for role,tokens in p16['phase_argv_templates'].items():
        need(type(tokens) is list and 1<=len(tokens)<=64 and all(type(x) is str and len(x)<=4096 for x in tokens),'finite typed argv')
        count=0
        for index,token in enumerate(tokens):
            if '{' in token or '}' in token:
                need(re.fullmatch(new_pattern,token) is not None and token[1:-1] in allowed,'all genuine flat names admitted by source shape and closed key set')
                count+=1; witnesses.append(dict(role=role,token_index=index,token=token,old_shape_match=re.fullmatch(old_pattern,token) is not None,new_shape_match=True,closed_key_name=True))
        argv_rows.append(dict(role=role,token_count=len(tokens),flat_placeholder_count=count,all_literals_unchanged=True))
    need(len(witnesses)==11 and len({w['token'] for w in witnesses})==6 and all(not w['old_shape_match'] for w in witnesses),'zero old/eleven new/six names')
    controls=[]
    for token in ('{authorization_sha256}','{{authorization_sha256}}','{ticket.authorization_sha256}','{unknown_sha256}','{9authorization_sha256}','prefix{authorization_sha256}','{authorization_sha256}suffix','{_authorization_sha256}'):
        match=re.fullmatch(new_pattern,token) is not None; member=match and token[1:-1] in allowed
        predicted='substitution_then_final_argv_comparison_required' if member else 'closed source substitution' if match else 'no arbitrary argv interpolation'
        controls.append(dict(token=token,shape_match=match,closed_key_member=member,static_predicted_guard=predicted,full_function_executed=False))
    plan=decode(DATA[str(U/'UTILITY010_CAUSAL_SOURCE_CONTROL_PLAN_001.json')]); inherited=decode(DATA[str(U/'UTILITY008_CAUSAL_SOURCE_CONTROL_PLAN_001.json')]); new_plan=decode(DATA[str(U/'UTILITY010_NEW_CAUSAL_PLAN_001.json')])
    need(plan['inherited_controls']==inherited['controls'] and len(plan['inherited_controls'])==6 and plan['new_full_function_plan']==new_plan and plan['total_plan_count']==7,'six exact inherited/one full causal plan')
    need(plan['results'] is None and new_plan['results'] is None and new_plan['planned_status']=='UNRUN_NO_EXECUTABLE_TEST_OR_RESULT','all causal plans unrun')
    need([r['id'] for r in new_plan['steps']]==['U10ARG-H1','U10ARG-NESTED','U10ARG-RESTORE1','U10ARG-UNKNOWN','U10ARG-RESTORE2'],'full healthy-negative-restored branch sequence planned')
    syntax=[]
    for p,data in DATA.items():
        if p.endswith('.py'):
            tree=ast.parse(data.decode('utf-8')); syntax.append(dict(path=p,sha256=sha(data),ast_only=True,top_level_definition_count=len(defs(tree))))
    observations={p:[] for p in PINS}; copies=[]; (OWN/'inputs').mkdir()
    for index,(p,pin) in enumerate(PINS.items()):
        for unused in range(3):
            data,row=observe(Path(p),pin['sha256'],pin['bytes']); need(row==INITIAL[p],'own triple raw9/hash drift'); observations[p].append(row)
        target=OWN/'inputs'/(str(index).zfill(3)+'-'+Path(p).name)
        with target.open('xb') as stream: stream.write(DATA[p]); stream.flush(); os.fsync(stream.fileno())
        data,row=observe(target,pin['sha256'],pin['bytes']); need(data==DATA[p] and row['path_raw9'][:2]!=INITIAL[p]['path_raw9'][:2],'exact own binary copy/different identity')
        copies.append(dict(original_path=p,copy_observation=row,exact_binary_copy=True))
    pre=[]
    for p,pin in PINS.items():
        unused,row=observe(Path(p),pin['sha256'],pin['bytes']); need(row==INITIAL[p],'prepublication drift'); pre.append(row)
    checks=[
      'Complete Source010 and composer semantic audit covers all41 utility definitions/full nonfunction module, not only delta acceptance. One blocking inherited008 regex is corrected; no remaining concrete Source issue found.',
      'All24 new/all17 preserved008/all41 predecessor007 payloads and sixteen selected author original-copy pairs authenticated. Own three observations, API8 identity subset excluding cross-API ctime, complete same-path/same-handle raw9, independent API bytes, exact copies and post-read are required.',
      'PUB-authored010 adoption from byte-exact Root proposal009 is source-attributed to author d1f6c8/observer3a0e00/freezer84bbb4, not invented tool/OS attestation. Proposal009 remains Root-authored; Root remains different future actual pool20 reviewer.',
      'Choice004 selects canonical regex and RootT009 gate010 to never-created BOUND007; config002 must retain ef3 bytes, INIT/trust/peer002 remain Source-future. Four stage sources still select config001; no false config002 stage claim.',
      'Complete byte proof reconstructs008 from007 three lawful filename spans + protected indentation4-to1 saving3747, then single raw regex token adds8 bytes to010. Entire Module reverses four constants to007 and one constant to008; other40 definitions/nonfunction ASTs/composer exact.',
      'Canonical flat grammar exactly matches checker010. All8 historical genuine P16 argv domains include11 flat hash placeholders/six known names; old0/new11 classification is owned Source metadata only. Complete actual helper function remains UNRUN.',
