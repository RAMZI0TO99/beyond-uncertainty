"""Owned stdlib metadata audit. Reviewed text is parsed as AST only, never executed."""
import ast
import copy
import datetime as dt
import hashlib
import io
import json
from decimal import Decimal
import os
from pathlib import Path
import re
import stat
import tokenize

ROOT = Path('D:/Aenv/pro2')
BASE = ROOT / 'resume-2026-10-03-continuation001'
U = BASE / 'guard006-bound-late-checker-prep001'
OWN = BASE / 'guard010-utility-source-independent-review001'
PINS = {}
DATA = {}
INITIAL = {}

def need(value, reason):
    if not value:
        raise ValueError(reason)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def raw(s):
    result = [getattr(s, key, None) for key in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]
    need(all(type(v) is int for v in result), 'genuine Windows raw9')
    return result

def parents(p):
    result = []
    for q in reversed(p.parents):
        s = q.lstat()
        need(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode) and not s.st_file_attributes & 0x400, 'plain parent')
        result.append([str(q), s.st_dev, s.st_ino])
    return result

def observe(p, expected=None, size=None):
    p = p.absolute()
    need(p.is_relative_to(ROOT), 'workspace input')
    chain = parents(p)
    a = p.lstat(); ar = raw(a)
    need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and not a.st_file_attributes & 0x400 and a.st_size <= 8388608, 'plain finite source')
    fd = os.open(p, os.O_RDONLY | os.O_BINARY)
    parts = []; count = 0
    try:
        b = os.fstat(fd); br = raw(b)
        need(all(ar[i] == br[i] for i in (0,1,2,3,5,6,7,8)), 'lawful plain source cross-API identity; retain independent ctime facts')
        while True:
            block = os.read(fd, min(1048576, a.st_size + 1 - count))
            if not block:
                break
            count += len(block); need(count <= a.st_size, 'source growth')
            parts.append(block)
        need(raw(os.fstat(fd)) == br, 'descriptor post drift')
    finally:
        os.close(fd)
    data = b''.join(parts)
    need(raw(p.lstat()) == ar and parents(p) == chain, 'path/parent post drift')
    need(len(data) == a.st_size and (size is None or len(data) == size) and (expected is None or sha(data) == expected), 'expected bytes/hash')
    # Different API byte read is still owned metadata, never a reviewed module import.
    need(p.read_bytes() == data and raw(p.lstat()) == ar, 'paired API byte read')
    return data, dict(path=str(p), bytes=len(data), sha256=sha(data), path_raw9=ar, descriptor_raw9=br, parent_identities=chain)

def pairs(rows):
    result = {}
    for key, value in rows:
        need(key not in result, 'duplicate JSON key')
        result[key] = value
    return result

def reject(value):
    raise ValueError('nonfinite JSON constant')

def decode(data):
    value = json.loads(data.decode('utf-8', 'strict'), object_pairs_hook=pairs, parse_float=Decimal, parse_constant=reject)
    allowed_duration = type(value) is dict and value.get('record_type') == 'root_source_diagnostic_physical_tool_correlation' and value.get('author') == '/root' and value.get('owning_tool_chunk') == '93f931'
    def finite(v, keys=()):
        if type(v) is Decimal:
            need(allowed_duration and keys == ('wall_time_seconds',) and v.is_finite() and Decimal(0) <= v <= Decimal(60), 'Source JSON floats forbidden except pinned physical Root diagnostic duration')
        elif type(v) is dict:
            for key, item in v.items(): finite(item, keys + (key,))
        elif type(v) is list:
            for index, item in enumerate(v): finite(item, keys + (index,))
    finite(value)
    return value

def add(p, pin=None, size=None):
    p = p.absolute(); key = str(p)
    if key in PINS:
        need(pin is None or PINS[key]['sha256'] == pin, 'consistent pool pin')
        need(size is None or PINS[key]['bytes'] == size, 'consistent pool size')
        return DATA[key]
    data, row = observe(p, pin, size)
    PINS[key] = dict(path=key, sha256=row['sha256'], bytes=row['bytes'])
    INITIAL[key] = row; DATA[key] = data
    if p.suffix == '.json': decode(data)
    elif p.suffix in ('.py', '.md', '.ps1'): data.decode('utf-8', 'strict')
    return data

def dump(node):
    return ast.dump(node, include_attributes=False)

def output(name, value):
    p = OWN / name
    data = (json.dumps(value, sort_keys=True, ensure_ascii=True, allow_nan=False, separators=(',', ':')) + '\n').encode('ascii')
    with p.open('xb') as stream:
        stream.write(data); stream.flush(); os.fsync(stream.fileno())
    need(p.read_bytes() == data, 'own output readback')
    return dict(path=str(p), sha256=sha(data), bytes=len(data))

def run():
    need(os.name == 'nt' and os.sys.flags.isolated and os.sys.flags.no_site and os.sys.flags.dont_write_bytecode and os.sys.flags.utf8_mode, 'isolated frozen stdlib metadata')
    need(Path(os.sys.executable).absolute() == ROOT / 'runtimes/week8-python313-frozen-001/python.exe', 'direct frozen interpreter')
    manifest = decode(add(U/'AUTHOR_FROZEN_SOURCE_MANIFEST_010.json','289726ace3beb286d8b37642afd527df952f9535186be0ad320a2ae7937277b5',4934))
    m8 = decode(add(U/'AUTHOR_FROZEN_SOURCE_MANIFEST_008.json','4b7cbd49afcb3153a73835119ef1634c71f62b246eb4ad958bb69c4ffb855da1',3752))
    m7 = decode(add(U/'AUTHOR_FROZEN_SOURCE_MANIFEST_007.json','4d95dc21c9606090a6ddab6344dc63bf062e62e3ead27846f08165ceebadb73e',8517))
    need([len(m['payloads']) for m in (manifest,m8,m7)] == [24,17,41], 'exact24/17/41 cohorts')
    need(manifest['author'] == manifest['source_author'] == '/root/pubnative_review', 'genuine PUB successor author')
    for key in ('Root_GO','actual_READY','actual_binding','actual_models','actual_source_fit','actual_source_pool','different_full_Source_acceptance'):
        need(manifest[key] is None, 'frozen Source actual field None: '+key)
    for key in ('helper_or_target_execution','operational_authority','runtime_acceptance'):
        need(manifest[key] is False, 'unrun Source flag: '+key)
    for m in (manifest,m8,m7):
        for row in m['payloads']: add(U/row['path'],row['sha256'],row['bytes'])
    for row in manifest['active_source_rows']: add(U/row['path'],row['sha256'],row['bytes'])
    author = decode(DATA[str(U/'UTILITY010_FINITE_SOURCE_OBSERVATIONS_001.json')])
    selected = author['inputs']; need(len(selected)==16, 'sixteen selected author pairs')
    pair_rows = []
    for row in selected:
        original=Path(row['original_path']); copied=Path(row['copy_path']); claimed=row['observations'][0]
        need(len(row['observations'])==3 and all(x==claimed for x in row['observations']) and row['post_observation']==claimed,'author triples/post exact')
        a=add(original,claimed['sha256'],claimed['bytes']); b=add(copied,claimed['sha256'],claimed['bytes'])
        need(a==b and original!=copied,'author binary copy exact')
        for p,c in ((original,claimed),(copied,row['copy_observation'])):
            for key in ('bytes','sha256','path_raw9','descriptor_raw9'): need(INITIAL[str(p)][key]==c[key],'author stable same-API metadata '+key)
        need(INITIAL[str(original)]['path_raw9'][:2]!=INITIAL[str(copied)]['path_raw9'][:2],'different author copy identity')
        pair_rows.append(dict(original_path=str(original),copy_path=str(copied),sha256=sha(a),bytes=len(a),three_observations_and_post_confirmed=True))
    for row in author['preserved_predecessor_payloads_before_post']:
        data=add(Path(row['path']),row['sha256'],row['bytes'])
        for key in ('bytes','sha256','path_raw9','descriptor_raw9'): need(INITIAL[row['path']][key]==row[key],'all predecessor author identity facts preserved')
    c10=decode(DATA[str(U/'UTILITY010_SOURCE_CONTRACT_001.json')]); c8=decode(DATA[str(U/'UTILITY008_SOURCE_CONTRACT_001.json')])
    choice=decode(add(Path(c10['Root_choice004']['path']),c10['Root_choice004']['sha256']))
    need(c10['Root_choice004']['sha256']=='81051a31a93a93e5539454ea11e732152f3a1d4796b730d2eeb8a987aba65589','selected choice004')
    old_pattern=r'\{[a-z_]+\}'; new_pattern=r'\{[a-z][a-z0-9_]*\}'
    need(choice['additional_inherited_reader_correction']['new_regex']==new_pattern and c10['only_additional_AST_literal_change']==dict(old=old_pattern,new=new_pattern),'canonical explicit Root regex selection')
    need(choice['source_authorship_boundary']['final_utility_Source_author']=='/root/pubnative_review' and choice['source_authorship_boundary']['actual_bound_pool_different_reviewer']=='/root','authorship/actual review separation')
    need(choice['pipeline_successor']['template']=='RUN_ROOT_METADATA_PIPELINE_009.TEMPLATE.ps1' and choice['pipeline_successor']['bound']=='RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1','truthful T009 to fresh BOUND007 selection')
    need(choice['pipeline_successor']['utility_gate']=='review_guard006_actual_records_001-corrected010.TEMPLATE.py','Root gate selects genuine PUB010')
    root9=add(BASE/'root-guard006-pipeline-prep001/RUN_ROOT_METADATA_PIPELINE_009.TEMPLATE.ps1','84ddc157d2c2b9eba3998afc8ca57e09110cd34e24e403422e574a97b20165d3',45560).decode('utf-8')
    need('review_guard006_actual_records_001-corrected010.TEMPLATE.py' in root9 and 'RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1' in root9,'selected Source gate/path literals')
    need('function Source-Argv' in root9 and '$Selections.authorization_sha256' in root9,'actual phase Source-Argv hash fields')
