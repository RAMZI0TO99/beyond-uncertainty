    for name,pin,size in [('INDEPENDENT_UTILITY008_SOURCE_REVIEW_001.json','4d810a2a95013ad1a304996dd3ca334bf5444e07fdbebea07a6957c17aa1f89e',2191),('INDEPENDENT_UTILITY008_SOURCE_DETAILS_001.json','57a12135274fe71c41f61e12f9db03689de8853d525817140029f0b531103f59',416717),('INDEPENDENT_UTILITY008_SOURCE_POST_READBACK_001.json','c8d1039bb0404aae716a8b5b204efabcc6ff4155495560fa12a6e44fdbb9ee13',145136)]:
