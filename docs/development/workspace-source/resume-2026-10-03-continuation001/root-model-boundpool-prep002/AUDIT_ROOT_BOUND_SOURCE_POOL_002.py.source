def need(value, message):
    if not value:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def pin(value):
    need(type(value) is str and re.fullmatch('[0-9a-f]{64}', value) is not None, 'exact external SHA')
    return value

def exact(value, keys, label):
    need(type(value) is dict and set(value) == set(keys), label + ' closed keyset')

def same(value, expected, label):
    need(type(value) is type(expected), label + ' exact builtin type')
    if type(expected) is dict:
        exact(value, expected, label)
        for key in expected:
            same(value[key], expected[key], label + '.' + key)
    elif type(expected) is list:
        need(len(value) == len(expected), label + ' list length')
        for item, wanted in zip(value, expected):
            same(item, wanted, label)
    else:
        need(value == expected, label + ' literal')

def plain(value):
    if type(value) is dict:
        need(all(type(key) is str for key in value), 'builtin string dictionary keys')
        return {key: plain(item) for key,item in value.items()}
    if type(value) is list:
        return [plain(item) for item in value]
    need(type(value) in (str, int, bool, type(None)), 'ordinary finite JSON builtin domain')
    return value

def decode(data):
    def pairs(rows):
        result = {}
        for key,value in rows:
            need(key not in result, 'duplicate ordinary Source JSON key')
            result[key] = value
        return result
    def bad(value):
        raise ValueError('float/nonfinite ordinary Source JSON forbidden')
    need(type(data) is bytes and not data.startswith(b'\xef\xbb\xbf'), 'strict JSON bytes/no BOM')
    return plain(json.loads(data.decode('utf8','strict'), object_pairs_hook=pairs,
                            parse_float=bad, parse_constant=bad))

def wire(value):
    return (json.dumps(plain(value),sort_keys=True,separators=(',',':'),
                       ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')

def details_wire(value):
    return (json.dumps(plain(value),sort_keys=True,indent=2,
                       ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')

def now():
    return datetime.now(timezone.utc).isoformat(timespec='microseconds')

def ticks(value, width=None):
    need(type(value) is str and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,7}\+00:00',value), 'canonical Py6/PS7 UTC')
    fraction=value[20:-6]
    need(width is None or len(fraction)==width, 'producer precision unchanged')
    base=datetime.strptime(value[:19],'%Y-%m-%dT%H:%M:%S').replace(tzinfo=timezone.utc)
    delta=base-datetime(1970,1,1,tzinfo=timezone.utc)
    return (delta.days*86400+delta.seconds)*10000000+int(fraction.ljust(7,'0'))

def path_of(value):
    need(type(value) is str and 0<len(value)<=4096, 'finite explicit absolute path')
    path=Path(value)
    need(path.is_absolute() and path.is_relative_to(ROOT) and '..' not in path.parts
         and all(':' not in part for part in path.parts[1:]), 'confined Source path')
    return path

def raw(info):
    result=[getattr(info,key,None) for key in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
    need(all(type(value) is int for value in result), 'exact Windows raw9')
    return result

def ancestors(path):
    result=[]
    for parent in reversed(path.parents):
        info=parent.lstat()
        need(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode)
             and not info.st_file_attributes & 1024, 'plain stable Source ancestor')
        result.append([str(parent),info.st_dev,info.st_ino])
    return result

def read(path, expected=None, size=None, maximum=MAX_FILE):
    path=path_of(str(path))
    need(type(maximum) is int and 0<maximum<=MAX_FILE, 'finite existing read cap')
    ancestry=ancestors(path)
    info=path.lstat()
    a=raw(info)
    need(stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode)
         and info.st_nlink==1 and not info.st_file_attributes&1024
         and 0<=info.st_size<=maximum and a[4]==a[8], 'plain one-link Source before bounded read')
    with path.open('rb',buffering=0) as handle:
        opened=os.fstat(handle.fileno())
        b=raw(opened)
        need(stat.S_ISREG(opened.st_mode) and opened.st_nlink==1
             and not opened.st_file_attributes&1024
             and all(a[index]==b[index] for index in API8), 'cross-API8 identity; ctime excluded')
        data=handle.read(info.st_size+1)
        need(raw(os.fstat(handle.fileno()))==b, 'same-handle raw9 stable')
    need(raw(path.lstat())==a and ancestors(path)==ancestry and len(data)==info.st_size, 'same-path raw9/full bounded bytes')
    need(expected is None or sha(data)==pin(expected), 'externally pinned SHA differs')
    need(size is None or (type(size) is int and len(data)==size), 'externally pinned byte size differs')
    return data,dict(path=str(path),sha256=sha(data),bytes=len(data),maximum=maximum,
                     path_raw9=a,descriptor_raw9=b,ancestors=ancestry)

def remember(path, expected=None, size=None, maximum=MAX_FILE, constructor_input=False):
    data,meta=read(path,expected,size,maximum)
    key=str(path_of(str(path)))
    entry=(sha(data),len(data),maximum)
    if key in REGISTRY:
        old=REGISTRY[key]
        need(old[:2]==entry[:2], 'conflicting finite original pin')
        entry=(entry[0],entry[1],min(old[2],maximum))
    REGISTRY[key]=entry
    need(len(REGISTRY)<=MAX_INPUTS, 'inherited finite metadata input limit')
    if constructor_input:
        if key in CTOR_INPUTS:
            old=CTOR_INPUTS[key]
            need(old[:2]==entry[:2], 'conflicting constructor Source pin')
            entry=(entry[0],entry[1],min(old[2],maximum))
        CTOR_INPUTS[key]=entry
    return data

def record(path, expected=None, size=None, maximum=65536, constructor_input=False):
    return decode(remember(path,expected,size,maximum,constructor_input))

def pointer(value):
    exact(value,('path','sha256'),'pointer2')
    return dict(path=str(path_of(value['path'])),sha256=pin(value['sha256']))

def row3(path,data):
    return dict(path=str(path),sha256=sha(data),bytes=len(data))

def source_row(path, expected, maximum):
    remember(path,expected,maximum=maximum,constructor_input=True)
    return dict(path=str(path),sha256=pin(expected),maximum=maximum)

def absence(path):
    ancestry=ancestors(path)
    try:
        path.lstat()
    except FileNotFoundError:
        need(ancestors(path)==ancestry,'named absence ancestor drift')
        return dict(path=str(path),ancestors=ancestry,observed_absent=True)
    raise ValueError('one-use future/capture role already exists: '+str(path))

def exclusive(path,data,maximum=MAX_FILE):
    need(type(data) is bytes and len(data)<=maximum, 'bounded owned metadata output')
    need(path.is_relative_to(OUT) or path==POOL,'only owned audit metadata or fixed genuine future Root peer')
    path.parent.mkdir(parents=True,exist_ok=True)
    absence(path)
    with path.open('xb') as handle:
        need(handle.write(data)==len(data),'complete exclusive metadata write')
        handle.flush()
        os.fsync(handle.fileno())
    need(read(path,sha(data),len(data),maximum)[0]==data,'exclusive metadata full readback')

def slots(data,names):
    text=data.decode('utf8','strict')
    lines=text.splitlines(keepends=True)
    tree=ast.parse(text)
    found={}
    for node in tree.body:
        if type(node) is ast.Assign and len(node.targets)==1 and type(node.targets[0]) is ast.Name and node.targets[0].id in names:
            name=node.targets[0].id
            need(name not in found,'unique selected top-level literal assignment')
            # Selected helpers use ASCII in the assignment prefixes/values.
            start=sum(len(line.encode('utf8')) for line in lines[:node.value.lineno-1])+node.value.col_offset
            end=sum(len(line.encode('utf8')) for line in lines[:node.value.end_lineno-1])+node.value.end_col_offset
            found[name]=(start,end,node.value)
    need(set(found)==set(names),'exact selected literal assignment set')
    return tree,found

def python_literal(value):
    value=plain(value)
    if type(value) is dict:
        return '{'+','.join(ascii(key)+':'+python_literal(value[key]) for key in sorted(value))+'}'
    if type(value) is list:
        return '['+','.join(python_literal(item) for item in value)+']'
    return ascii(value)

def audit_assignment_bytes(actual,template,values,originals,canonical=False,label='selected Source'):
    oldtree,old=slots(template,values)
    tree,new=slots(actual,values)
    edits=[]
    expected_edits=[]
    for name in values:
        os_,oe,node=old[name]
        ns,ne,boundnode=new[name]
        same(plain(ast.literal_eval(node)),originals[name],label+' original literal')
        same(plain(ast.literal_eval(boundnode)),values[name],label+' exact bound builtin literal')
        edits.append((ns,ne,template[os_:oe]))
        expected_edits.append((os_,oe,python_literal(values[name]).encode('ascii')))
    reversed_bytes=actual
    for start,end,replacement in sorted(edits,reverse=True):
        reversed_bytes=reversed_bytes[:start]+replacement+reversed_bytes[end:]
    need(reversed_bytes==template,label+' complete literal byte reversal')
    if canonical:
        complete=template
        for start,end,replacement in sorted(expected_edits,reverse=True):
            complete=complete[:start]+replacement+complete[end:]
        need(complete==actual,label+' canonical complete actual byte assembly')
    kinds=(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)
    before=[ast.dump(node,include_attributes=False) for node in oldtree.body if type(node) in kinds]
    after=[ast.dump(node,include_attributes=False) for node in tree.body if type(node) in kinds]
    same(after,before,label+' all exact function/class ASTs')
    AST_PROOFS.append(dict(label=label,assignment_names=list(values),
        template_sha256=sha(template),actual_sha256=sha(actual),
        exact_complete_source_byte_reversal=True,canonical_actual_byte_assembly=canonical,
        function_class_count=len(before),all_function_class_ASTs_exact=True))

def model(source,keys,core):
    exact(source,keys,'selected Source model input')
    return dict(keys=list(keys),values={key:plain(source[key]) for key in core})

def capture_paths():
    result=[M/'ROOT_METADATA_AUTHORIZATION_BEFORE_003.json',M/'phase-before-003',M/'phase-after-003',
        G/'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json',G/'whole-runtime-before',G/'whole-runtime-after',
        G/'ROOT_EXECUTION_ACK_GUARD_UNIT006.json',G/'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json',
        G/'INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_006.json',G/'ROOT_LAUNCH_TERMINAL_006.json']
    result += [K/('ACTUAL_TICKET_'+phase.upper()+'_006.json') for phase in PHASE8]
    result += [M/name for name in ('INDEPENDENT_ACTUAL_ROOT_AUTH_BEFORE_REVIEW_006.json',
        'INDEPENDENT_ACTUAL_ROOT_METADATA_BEFORE_CAPTURE_REVIEW_006.json','INDEPENDENT_ACTUAL_ROOT_WHOLE_BEFORE_REVIEW_006.json')]
    return result

def check_lease(value,minimum=510):
    exact(value,LEASE12,'authentic finite lease12')
    need(list(value)==list(LEASE12),'original ordered PowerShell lease12')
    for key,wanted in dict(schema_version=1,record_type='root_local_private_execution_lease',
        author='/root',scope=SCOPE,owner_master_sha256=MASTER_SHA,owner_review_sha256=MASTER_PEER_SHA,
        decision='authorize_bounded_selected_unit_metadata_and_copied_tests_once',
        maximum_lease_seconds=43200,lease_is_owner_deadline=False,operational_authority=False).items():
        same(value[key],wanted,'lease nominal')
    created,end=ticks(value['created_utc'],7),ticks(value['lease_end_utc'],7)
    need(0<end-created<=432000000000 and created<=ticks(now(),6)
         and ticks(now(),6)+minimum*10000000<end,'finite lease with unchanged reserve')

def verify_existing_composition(table,selection,raw_sources,lease,config,rootpeer,
                                plan,binding,boundpeer,phasebinding,phasepeer,checker):
    exact(plan,('schema_version','source_author','scope','bindings','role_selections','lease_selection','actual_binding'),'M3 plan7')
    for key,wanted in dict(schema_version=1,source_author='/root/renewal_runtime_inventory',
                          scope=SCOPE,actual_binding=None).items():
        same(plan[key],wanted,'M3 plan nominal')
    exact(binding,('schema_version','binder','template_sha256','actual_script_sha256','bindings','role_selections','exact_six_assignment_reversal','exact_function_ASTs','actual_before_authorization','actual_after_authorization','target_capture_executed'),'M3 binding11')
    for key,wanted in dict(schema_version=1,binder='/root',
        template_sha256=sha(raw_sources['metadata_capture_template']),exact_six_assignment_reversal=True,
        exact_function_ASTs=True,actual_before_authorization=None,actual_after_authorization=None,target_capture_executed=False).items():
        same(binding[key],wanted,'M3 binding nominal')
    nine={name:table['immutable'][role]['sha256'] for name,role in (
        ('guard_profile_sha256','profile'),('source_projection_sha256','projection'),
        ('raw_source_sha256','raw_source'),('source_manifest_sha256','source_manifest'),
        ('source_peer_sha256','capsule'),('guard_harness_static_review_sha256','static_review'),
        ('preparer_static_review_sha256','metadata_peer'))}
    nine.update(coordination_peer_reply_sha256=config['coordination_peer_reply']['sha256'],
                coordination_root_response_sha256=config['coordination_root_response']['sha256'])
    exact(nine,table['metadata9_keys'],'complete metadata9')
    selected_nine=plain(plan['bindings'])
    exact(selected_nine,table['metadata9_keys'],'plan metadata9')
    selected_nine['preparer_static_review_sha256']=table['immutable']['metadata_peer']['sha256']
    same(selected_nine,nine,'selected preparer peer correction')
    same(binding['bindings'],nine,'M3 bound nine pins')
    same(plan['lease_selection'],dict(path=str(WORK/'EXECUTION_LEASE_GG6_M3_001.json'),
        sha256=LEASE_SHA,lease_end_utc=lease['lease_end_utc']),'M3 finite lease3')
    roles=plan['role_selections']
    exact(roles,('UNIT_TERMINAL_RELATIVE','COORDINATION_PEER_REPLY_RELATIVE','COORDINATION_ROOT_RESPONSE_RELATIVE'),'M3 three role names')
    destinations={'UNIT_TERMINAL_RELATIVE':G/'ROOT_LAUNCH_TERMINAL_006.json',
                  'COORDINATION_PEER_REPLY_RELATIVE':path_of(config['coordination_peer_reply']['path']),
                  'COORDINATION_ROOT_RESPONSE_RELATIVE':path_of(config['coordination_root_response']['path'])}
    for name,relative in roles.items():
        need(type(relative) is str and 0<len(relative)<=399 and '\\' not in relative
             and all(part not in ('','.','..') and ':' not in part for part in relative.split('/')),'canonical M3 relative role')
        base=G if name=='UNIT_TERMINAL_RELATIVE' else WORK
        same(str(base/Path(relative)),str(destinations[name]),'M3 exact role destination')
    same(binding['role_selections'],roles,'bound M3 role names')
    actual=remember(M/'capture-root-metadata003.BOUND.py',binding['actual_script_sha256'],
                    maximum=65536,constructor_input=True)
    replacements=dict(roles,BINDINGS=nine,OWNER_SHA=LEASE_SHA,OWNER_END=lease['lease_end_utc'])
    originals=dict({name:None for name in roles},BINDINGS={name:None for name in nine},OWNER_SHA=None,OWNER_END=None)
    audit_assignment_bytes(actual,raw_sources['metadata_capture_template'],replacements,originals,label='M3 six assignments')
    same(boundpeer,dict(actual_script_sha256=binding['actual_script_sha256'],metadata_only=True,
        phase_set=['before','after'],record_type='guard006_root_metadata_bound_source_review',
        reviewer='/root/owner_docs_review',schema_version=1,source_author='/root/renewal_runtime_inventory',
        source_bindings=nine,verdict='PASS_STATIC_BOUND_METADATA_ONLY'),'complete different M3 bound peer9')
    exact(boundpeer,table['bound9_keys'],'M3 peer9')
    exact(phasebinding,('schema_version','binder','sources','actual_script_sha256','bound_review_sha256','actual_authorization','prepared_source_actions_executed'),'phase binding7')
    for key,wanted in dict(schema_version=1,binder='/root',actual_script_sha256=binding['actual_script_sha256'],
        bound_review_sha256=selection['metadata_bound_review_sha256'],actual_authorization=None,
        prepared_source_actions_executed=False).items():
        same(phasebinding[key],wanted,'phase binding nominal')
    exact(phasepeer,table['phase20_keys'],'complete phase peer20')
    for key,wanted in dict(schema_version=1,record_type='guard006_root_metadata_phase_ps_source_binding_review',
        reviewer='/root/owner_docs_review',source_author='/root/renewal_runtime_inventory',metadata_only=True,
        actual_authorization_or_entry_approved=False,exact_two_literal_reversal_all_four=True,
