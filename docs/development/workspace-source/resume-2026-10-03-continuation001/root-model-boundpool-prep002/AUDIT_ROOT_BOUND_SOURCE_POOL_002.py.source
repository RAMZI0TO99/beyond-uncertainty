def verify_projection(projection,projection_data,selection_sha,selection,output_rows):
    keys=('schema_version','record_type','author','scope','created_utc','owner_master_sha256',
          'execution_lease_sha256','root_trust_selection_sha256','source_selection_sha256',
          'constructor_source_sha256','constructor_source_peer_sha256','selected_inputs',
          'published_source_models','finite_before_capture_absences','actual_context','actual_results',
          'independent_bound_model_peer','Root_GO','helper_mains_executed','target_execution','operational_authority_granted')
    exact(projection,keys,'complete actual Source projection21')
    for key,wanted in dict(schema_version=1,record_type='root_guard006_selected_source_pool_projection',
        author='/root',scope=SCOPE,owner_master_sha256=MASTER_SHA,execution_lease_sha256=LEASE_SHA,
        root_trust_selection_sha256=selection['root_trust_selection_sha256'],
        source_selection_sha256=selection_sha,constructor_source_sha256=CTOR_SHA,
        constructor_source_peer_sha256=CTOR_PEER_SHA,actual_context=None,actual_results=None,
        independent_bound_model_peer=None,Root_GO=None,helper_mains_executed=False,target_execution=False,
        operational_authority_granted=False).items():
        same(projection[key],wanted,'Source projection nominal')
    ticks(projection['created_utc'],6)
    same(projection['published_source_models'],output_rows,'all five complete predicted model byte rows')
    same(projection['finite_before_capture_absences'],[str(path) for path in capture_paths()],'exact original finite pre-capture absence paths')
    need(wire(projection)==projection_data,'canonical compact entire projection bytes')
    observed={}
    need(type(projection['selected_inputs']) is list and len(projection['selected_inputs'])<=4096,'unchanged bounded projection observations')
    for row in projection['selected_inputs']:
        exact(row,('path','sha256','bytes','maximum','path_raw9','descriptor_raw9'),'projection raw9 Source row7')
        path=path_of(row['path'])
        need(str(path) not in observed,'unique complete projection input path')
        data,meta=read(path,row['sha256'],row['bytes'],row['maximum'])
        same(row['path_raw9'],meta['path_raw9'],'actual constructor Source path raw9')
        same(row['descriptor_raw9'],meta['descriptor_raw9'],'actual constructor Source descriptor raw9')
        observed[str(path)]=(row['sha256'],row['bytes'],row['maximum'])
        remember(path,row['sha256'],row['bytes'],row['maximum'])
    need(observed==CTOR_INPUTS,'exact complete constructor Source input set/pins/strictest caps; no invented rows')

def main():
    need(os.name=='nt' and sys.version_info[:3]==(3,13,5) and sys.flags.isolated==1
         and sys.flags.no_site==1 and sys.flags.dont_write_bytecode==1
         and sys.flags.utf8_mode==1 and sys.flags.optimize==0,'genuine isolated fixed metadata interpreter')
