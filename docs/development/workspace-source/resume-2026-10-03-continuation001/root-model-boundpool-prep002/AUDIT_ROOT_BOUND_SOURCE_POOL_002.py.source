        audit_assignment_bytes(body,raw_sources[role+'_template'],guard_values[role],
            {name:None for name in guard_values[role]},True,'driver3' if role=='driver' else 'observer1')
    for role in ('whole_before_parent','whole_after_writer','whole_after_parent'):
        body=remember(path_of(config['sources'][role]['path']),config['sources'][role]['sha256'],maximum=65536,constructor_input=True)
