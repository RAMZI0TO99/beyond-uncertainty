        same(phasepeer[key],wanted,'phase peer nominal')
    need(type(phasebinding['sources']) is list and len(phasebinding['sources'])==4
         and type(phasepeer['phase_sources']) is list and len(phasepeer['phase_sources'])==4,'all four phase copies')
    for index,role in enumerate(PHASE4):
        row=phasebinding['sources'][index]
        exact(row,('path','sha256','template_sha256','exact_two_literal_reversal'),'phase source row4')
        chosen=table['phase_templates'][role]
        same(row['template_sha256'],chosen['sha256'],'phase selected template')
        same(row['exact_two_literal_reversal'],True,'phase reversal truth')
        body=remember(path_of(row['path']),row['sha256'],maximum=65536,constructor_input=True)
        template=remember(path_of(chosen['path']),chosen['sha256'],chosen['bytes'],65536,True)
        text=body.decode('utf8','strict')
        for name,wanted in (('BoundScriptSha256',binding['actual_script_sha256']),
                            ('BoundReviewSha256',selection['metadata_bound_review_sha256'])):
            pattern=r"(?m)^\$"+name+r" = '[0-9a-f]{64}'(\r?)$"
            matches=list(re.finditer(pattern,text))
            need(len(matches)==1 and matches[0].group().rstrip('\r')=='$'+name+" = '"+wanted+"'",'exact phase two hash assignments')
            text=re.sub(pattern,lambda match,n=name:'$'+n+' = $null'+match.group(1),text)
        need(text.encode('utf8')==template,'all four phase PS complete two-literal byte reversal')
        same(phasepeer['phase_sources'][index],dict(path=row['path'],sha256=row['sha256'],
             template_sha256=row['template_sha256'],bytes=len(body),exact_two_literal_reversal=True,
             PowerShell_parser_errors=0),'phase peer row6')
        field={'before_writer':'writer_sha256','before_parent':'supervisor_sha256',
               'after_writer':'after_writer_sha256','after_parent':'after_supervisor_sha256'}[role]
