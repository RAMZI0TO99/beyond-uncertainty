    closure={name:dict(path=str(path),sha256=selected) for name,path,selected in (
        ('metadata_script',M/'capture-root-metadata003.BOUND.py',binding['actual_script_sha256']),
        ('metadata_source_binding',M/'ACTUAL_SOURCE_BINDING_003.json',selection['metadata_source_binding_sha256']),
        ('metadata_bound_review',M/'INDEPENDENT_BOUND_METADATA_REVIEW_003.json',selection['metadata_bound_review_sha256']),
        ('phase_source_binding',M/'PHASE_PS_SOURCE_BINDING_003.json',selection['phase_source_binding_sha256']),
        ('phase_source_review',M/'INDEPENDENT_ROOT_METADATA_PHASE_PS_BINDING_REVIEW_003.json',selection['phase_source_review_sha256']))}
    same(checker['metadata_sources'],closure,'checker same exact five M3 closure roles')
    exact(checker['phase_sources'],PHASE4,'checker phase4')
    for row,role in zip(phasebinding['sources'],PHASE4):
        same(checker['phase_sources'][role],dict(path=row['path'],sha256=row['sha256']),'checker phase row agrees')
    same(checker['root_pipeline_source'],dict(path=str(P/'RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1'),
        sha256=PIPELINE_SHA,source_peer_path=str(WORK/'root-pipeline-independent-review001/SOURCE_REVIEW_ROOT_PIPELINE_002.json'),
        source_peer_sha256=P16_SHA),'checker root pipeline4')
    same(checker['execution_launch_witness'],dict(reviewer='/root/actual_record_checker',
        nonce='d7b24061509e48d0b9ea526c3b5c0708',
        tool_trace_kind='EXTERNALLY_CORROBORATED_REVIEWER_TOOL_CELL_NOT_OS_ATTESTATION'),'planned witness3 exactly')
    # This Source witness has no PID/tool identity and must not be asserted active.
    guard_values={'driver':dict(SOURCE_CAPSULE_PEER_SHA256=table['immutable']['capsule_peer']['sha256'],
        HARNESS_STATIC_PEER_SHA256=table['immutable']['static_review']['sha256'],OWNER_SHA256=LEASE_SHA),
        'observer':dict(HARNESS_STATIC_PEER_SHA256=table['immutable']['static_review']['sha256'])}
    for role in ('driver','observer'):
