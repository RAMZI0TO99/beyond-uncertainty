    options=argparse.ArgumentParser(allow_abbrev=False)
    for name in ('expected-self-sha256','expected-selection-sha256','constructor-outcome-path',
                 'expected-constructor-outcome-sha256','root-init-correlation-path',
                 'expected-root-init-correlation-sha256'):
