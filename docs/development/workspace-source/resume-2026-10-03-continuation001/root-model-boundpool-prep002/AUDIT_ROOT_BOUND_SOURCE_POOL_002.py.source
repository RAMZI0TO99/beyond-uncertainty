    writer=remember(path_of(config['sources']['root_records']['path']),config['sources']['root_records']['sha256'],maximum=65536,constructor_input=True)
    need(writer==raw_sources['root_records_template'],'Root writer exact original zero-slot copy')
    need(b'ROOT_PIPELINE_BINDING_001.json' in writer and b'ROOT_PIPELINE_BINDING_002.json' not in writer,'Root writer still reads canonical001')
    return nine

