    regression_source=dict(path=str(test),sha256=test_row['sha256'],bytes=test_row['bytes']),
    future_loader='Authenticates exactly81410 Source bytes, SHA, regular/singlelink/plain ancestors, raw9/API8 and size before compile/exec; executes same verified bytes with non-main module name ONLY after independent Source review and runtime GO.',
    author_operations='Own AST/JSON/hash/raw9/copy metadata only; no target definitions/import/compile/main or tests run.',
    fixtures='Private TemporaryDirectory only; complete physical_provenance code plus actual reader/open spies. All logical Root records/PID17/nonces/trace flags are synthetic inert fixtures, never Root producer, OS or tool attestations.',
    fixture_scope_limits='Detail15 and Trace13 closed shape; this control invokes physical_provenance directly. Source-closure/check fields unused by that function are synthetic and are not machine_core acceptance. No full Core/metadata capture/lease test is inferred.',
    controls=dict(P1='Full function healthy, source006-only negative before any open, healthy restore for bothroles.',
