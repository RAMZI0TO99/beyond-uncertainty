    counts=dict(source_plans=7,implemented_runnable_methods=6,deferred_methods=1,parent_ids=7,subtests=10,hypothetical_events=24),
    output_and_cleanup='TemporaryDirectory removes only owned synthetic tree on every outcome. Stdout bounded4096 bytes per synthetic JSONL event; stderr unittest diagnostics. Future physical child supervision/runtime resource/deadline guard not supplied by this Source preparation.',
