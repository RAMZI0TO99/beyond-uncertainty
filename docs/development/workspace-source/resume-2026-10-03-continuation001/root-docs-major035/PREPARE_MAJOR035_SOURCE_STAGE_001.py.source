def need(v,m):
    if not v:raise ValueError(m)
def sha(b):return hashlib.sha256(b).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(s):
    r=[getattr(s,k,None)for k in KEYS];need(all(type(v)is int for v in r),'typed raw9')
    return r
def observe(p):
    a=p.lstat();ar=raw(a);need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=MAXIMUM,'plain bounded input')
    chain=[]
    for q in p.parents:
        s=q.lstat();need(stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024,'plain ancestor')
        chain.append([str(q),s.st_dev,s.st_ino])
    with p.open('rb')as h:
        s=os.fstat(h.fileno());hr=raw(s);need(ar[:4]+ar[5:]==hr[:4]+hr[5:]and ar[4]==ar[8],'cross API8 excludes ctime/path birth')
        data=h.read(MAXIMUM+1);need(raw(os.fstat(h.fileno()))==hr,'same descriptor raw9')
    need(raw(p.lstat())==ar and len(data)==ar[2]and len(data)<=MAXIMUM,'same path raw9/bytes')
    need(chain==[[str(q),q.lstat().st_dev,q.lstat().st_ino]for q in p.parents],'ancestor identities')
    return data,dict(path=str(p),bytes=len(data),sha256=sha(data),path_raw9=ar,descriptor_raw9=hr)
def decode(b,physical=False):
    def pairs(rows):
        d={}
        for k,v in rows:need(k not in d,'duplicate JSON key');d[k]=v
        return d
    def bad(v):raise ValueError('ordinary float/nonfinite Source JSON')
    return json.loads(b,object_pairs_hook=pairs,parse_float=Decimal if physical else bad,parse_constant=bad)
def once(p,b):
    need(p.is_relative_to(OWN)and type(b)is bytes and len(b)<=MAXIMUM and not p.exists(),'own createonce Source')
    p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb')as h:need(h.write(b)==len(b),'complete own write');h.flush();os.fsync(h.fileno())
    need(observe(p)[0]==b,'own readback')
def pointer(p,b):return dict(path=p.relative_to(ROOT).as_posix(),bytes=len(b),sha256=sha(b))
def AST(n):return ast.dump(n,include_attributes=False)

