         and u8['findings'][0]['no_reviewed_execution_or_runtime_failure_observed'] is True,
         'U008 inherited Source-only refusal')
    u10 = selected('guard010-utility-source-independent-review001/INDEPENDENT_UTILITY010_SOURCE_REVIEW_001.json')
    need(u10['source_author'] == '/root/pubnative_review'
         and u10['verdict'] == 'PASS_STATIC_GENERIC_PUB_PREPARATION_ONLY_ACTUAL_BOUND_POOL_UNREADY'
         and u10['finite_input_count'] == 99 and u10['new_payload_count'] == 24
         and u10['preserved007_payload_count'] == 41 and u10['preserved008_payload_count'] == 17
         and u10['selected_author_pair_count'] == 16 and u10['tests_executed'] is False
