         and event['overlap_with_TYPE_launch_proven'] is None
         and event['complete_metadata_hold_throughout_window_proven'] is False
         and event['reported_by'] == '/root/architecture'
         and event['exact_tool_chunk_or_pid_or_timestamp'] == 'Not retained by reporter; do not invent',
         'disclosed unapproved hold event/unknown cause/overlap/no quiet')
    checkpoint_text = texts[-1]['text']
    need('now completed and selected' in checkpoint_text
         and 'Overlap and causal effect are unknown' in checkpoint_text
         and 'earlier pending fields' in checkpoint_text
         and 'before leaf handshake or mypy API' in checkpoint_text,
         'checkpoint correctly distinguishes completed review from immutable old snapshots')
    owner = selected('OWNER_CONTINUATION_20261003_001.json')
    lease = selected('EXECUTION_LEASE_GG6_M3_001.json')
    need(owner['work_end_utc'] is None and owner['fixed_deadline_invented'] is False
         and lease['lease_end_utc'] == '2026-10-03T20:39:32.1487556+00:00'
         and lease['lease_is_owner_deadline'] is False
         and lease['maximum_lease_seconds'] == 43200, 'ongoing owner distinct finite lease')
    need(context['TYPE_cause_and_overlap_unknown'] is True
         and context['pro3_cleanup_attributed_only'] is True
         and context['no_actual_production_fit_or_models_inferred'] is True
         and context['selected_pro3_TYPE_FAILED_actual_audit_sha256']
         == 'b514dc3a2ca2f2a1ac521372a072369ce2c31a8e1a1fbbb0f4d4440a38b2c153'
         and context['selected_pro3_Root_source_read_sha256']
         == '3d4ed3f69c4c9174bf959d6b6ca6b9e0bfe5d6e65f97d095f20758b1a4457902',
         'selected context uses truthful current failed-evidence scope')

    previous = add(WORK / 'root-docs-major033/PUBLISH_MAJOR033_DOCS_001.py',
                   '57b0a0d48ec026542559db950654ee85204af6b9d45f511c50bb7469955b5936', 9971)
    substitutions = [
        dict(original='033', selected='034', occurrences=13),
        dict(original='CONTINUATION_CHECKPOINT_004.md', selected='CONTINUATION_CHECKPOINT_005.md', occurrences=1),
        dict(original='/root/root_pipeline_binder', selected='/root/actual_record_checker', occurrences=2),
        dict(original="review['reviewer']=='/root/capsule_design_review'",
             selected="review['reviewer']=='/root'", occurrences=1)]
    need(contract['declared_literal_substitutions'] == substitutions
         and contract['genuine_future_review_keys'] == list(REVIEW_KEYS)
         and contract['fixed_review_path'] == (OUT / 'INDEPENDENT_MAJOR034_PREPUBLICATION_SOURCE_REVIEW_001.json').relative_to(ROOT).as_posix()
         and contract['actual_review'] is None and contract['actual_Root_publication'] is None
         and contract['different_creation_review'] is None, 'exact Source/publication contract')
    transformed = previous
    for row in substitutions:
        before, after = row['original'].encode('ascii'), row['selected'].encode('ascii')
        need(transformed.count(before) == row['occurrences'], 'exact declared literal occurrence count')
        transformed = transformed.replace(before, after)
    need(transformed == publisher, 'complete publisher four-substitution byte reconstruction')
    oldtree, tree = ast.parse(previous), ast.parse(publisher)
    oldfunctions = {n.name: n for n in oldtree.body if type(n) is ast.FunctionDef}
    functions = {n.name: n for n in tree.body if type(n) is ast.FunctionDef}
    need(len(functions) == len(oldfunctions) == 13 and set(functions) == set(oldfunctions),
         'all13 publisher function coverage')
    ast_rows = []
    changed = []
    for name, node in functions.items():
        current = ast.dump(node, include_attributes=False)
        old = ast.dump(oldfunctions[name], include_attributes=False)
        if current != old:
            changed.append(name)
        ast_rows.append(dict(name=name, lineno=node.lineno, AST_sha256=sha(current.encode('utf8')),
                             identical_to033=current == old))
    need(changed == ['main'], 'only publisher main identity AST changes; other12 exact')
    imports = [a.name for n in tree.body if type(n) is ast.Import for a in n.names]
    imports += [n.module for n in tree.body if type(n) is ast.ImportFrom]
    need(set(imports) == {'argparse', 'hashlib', 'json', 'os', 're', 'stat', 'datetime', 'pathlib'}
         and b'automatic_rollback=False' in publisher
         and b'batch_atomicity_guaranteed=False' in publisher
         and b'os.replace(temp,destination)' in publisher,
         'complete publisher has bounded source reads and qualified per-file publication')
    add(WORK / 'root-docs-independent-major033/REVIEW_MAJOR033_SOURCE_002.py',
        '644399aee91f320baea7fb4964dfac55dda30b26320e80eb1faef93e3d8e23d5')
    # Preserve the stale author draft as history, but never use it as candidate wording.
    stale_draft = add(STAGE / 'DRAFT_PRIMARY_SECTIONS_034.json',
                      '0017ca23f7f3fc18f85cc35811c31401c222eb3230f659f689ffe0c83d5a4be7', 7650)
    need(b'PENDING/unselected' in stale_draft, 'explicit stale draft identity')
    named = [Path(row['path']) for row in author['named_role_absences']]
    need(len(named) == 12 and all(row['observed_absent'] is True for row in author['named_role_absences']),
         'fixed twelve fresh named-role absence declarations')
    absent_paths = [CHECKPOINT, Path(str(CHECKPOINT) + '.staging'),
                    STAGE / 'ROOT_PUBLISH_RECEIPT_034.json',
                    STAGE / 'ROOT_RESTORE_RECEIPT_034.json',
                    STAGE / 'PARTIAL_PUBLISH_034.json', STAGE / 'PARTIAL_RESTORE_034.json', *named]
    def absent(path):
        ancestry = ancestors(path)
        try:
            path.lstat()
        except FileNotFoundError:
            need(ancestors(path) == ancestry, 'absence ancestor drift')
            return str(path)
        raise ValueError('named Source prepublication role exists: ' + str(path))
    absences = [absent(path) for path in absent_paths]
    output_names = ['INDEPENDENT_MAJOR034_SOURCE_DETAILS_001.json',
                    'POST_MAJOR034_SOURCE_REVIEW_001.json',
                    'INDEPENDENT_MAJOR034_PREPUBLICATION_SOURCE_REVIEW_001.json',
                    'HANDOFF_MAJOR034_SOURCE_REVIEW_001.md',
                    'OWN_MAJOR034_SOURCE_AUDITOR_REFUSAL_001.json']
    for name in output_names:
        absent(OUT / name)
    for obj in (creation, u8, u10, checker_peer, root_checker, attribution):
        need(ticks(obj['created_utc']) < prepared, 'selected record predates frozen stage')

    observations = []
    for index, (path, (pin, size)) in enumerate(sorted(registry.items(), key=lambda x: str(x[0]))):
        passes = [read(path, pin, size) for _ in range(3)]
        need(passes[0] == passes[1] == passes[2], 'three identical finite Source observations')
        copy_path = 'source001-inputs/' + str(index).zfill(3) + '.bytes'
        once(copy_path, passes[0][0])
        copy_bytes, copy_meta = read(OUT / copy_path, pin, size)
        need(copy_bytes == passes[0][0]
             and copy_meta['path_raw9'][:2] != passes[0][1]['path_raw9'][:2],
             'independent exact copy identity')
        observations.append(dict(path=str(path), sha256=pin, bytes=size,
                                 passes=[item[1] for item in passes], copy_path=copy_path,
                                 copy_observation=copy_meta))
    checks = [
      'All60 selected034 original-copy pairs and complete78-pair033 stage are authenticated and retained. Exactly five old live032 primary input roles were legitimately superseded by Root033 publication: their authentic preserved033 before/copy bytes are checked, while current033 live bytes independently match033 candidates/current034 before. No obsolete live pin is replayed. Earlier finite history is byte-pinned without recursively recopying prior auditor forests; complete suffix3/prefix2 history remains exact.',
      'All five complete final candidate additions and checkpoint0059969 were read and matched selected sections/checkpoint draft. All32 links resolve from final document locations. Stale DRAFT_PRIMARY_SECTIONS is retained history and is not final wording.',
      'Publisher0349951 reconstructs0339971 by exactly four declared identity substitutions. All13 function ASTs inspected; only main identity AST changes, all other12 exact. No selected imports/definitions/compilers/mains invoked.',
      'Genuine prior033 Root publication/receipt and different creation selection are selected, not recreated. U008 inherited digit-placeholder refusal remains Source-only history. Genuine Pub U010 and different full reviewer accept preparation with actual poolUNREADY; seven causal plans UNRUN.',
      'Checker010141/72/69/66 and full different150-input/28-body Source review plus genuine Root compact003 are selected as Source only. No010/test004 actual result or current24/model/capture authority follows.',
      'Pro3 b514 completed FAILED evidence audit and Root3d4 attribution are current, while older cleanup/event pending fields retain original history. Actual31.959359799999998seconds exit1 preceded mypy/handshake; TYPE/runtime acceptance false, cause unknown, native whole-cleanup false, leaf membership unproven.',
      'Architecture unapproved0.4s hold check, unknown exact chunk/PID/time/overlap/cause, withdrawn Root ordering phrase, and genuine post-release proof remain disclosed. Scoped Pro3 reports and native parser observation do not prove quiet.',
      'Ongoing owner/endNone remains distinct finite lease20:39:32.1487556UTC. Twelve named fresh roles absent only at this finite read. No bound model/fit/pool20/READY/GO/Auth/capture/current24 result inferred; original caps600/both90/resource60/510/450+after60 and history/science/twins/epoch retained.']
    conditions = [
      'Root alone must select and invoke the authenticated publisher once with this genuine closed12 Source receipt. It must reobserve exact current baselines and one-use roles before publication; concurrent change refuses.',
      'Publisher is atomic per file only; no batch atomicity, OS compare-and-swap or automatic rollback is asserted. Preserve partial change records and all frozen stages.',
      'Separate different creation audit must match five physical primaries/checkpoint/receipt/history after actual publication. Source PASS is not publication or creation.',
      'No Source/synthetic/component result supplies future actual fit/model/pool20/metadata/current24/native/science/whole-host/Job authority. Later facts need a distinct snapshot.']
    details = dict(schema_version=1, record_type='independent_major034_full_documentation_source_details',
        created_utc=now(), reviewer='/root', source_author='/root/actual_record_checker',
        scope=SCOPE, verdict='PASS_MAJOR034_DOCUMENTATION_SOURCE_ONLY',
        manifest_sha256=MANIFEST_SHA, publisher_sha256=PUBLISHER_SHA,
        finite_input_count=len(observations), finite_inputs=observations,
        staged_packet_pair_counts=pair_counts, current_original_copy_pairs=60,
        superseded_prior_primary_input_roles=superseded_prior_primary_inputs,
        selected_links=extracted, full_final_new_text_read=texts, history=history,
        publisher_AST_rows=ast_rows, publisher_declared_substitutions=substitutions,
        selected_context=context, exact_contract=contract, prepublication_named_absences=absences,
        source_checks=checks, findings=[],
        superseded_observer_error=dict(observer='/root/architecture',
          mistaken_source='DRAFT_PRIMARY_SECTIONS_034.json',
          apparent_pending_wording_blocker_withdrawn=True,
          genuine_Root_candidate_read_correction_tool='3bfb65',
          actual_manifest_candidate_additions_independently_read_after_correction=True,
          project_Source_refusal_created=False),
        implementation_conditions=conditions, publication_performed=False,
        publisher_import_definitions_compile_main_executed=False,
        target_execution=False, operational_authority=False, actual_creation=None)
    # Decimal measurements are checked in memory only; outputs contain authenticated
    # Source tuples/text and integer raw9, not reencoded native measurement objects.
    once('INDEPENDENT_MAJOR034_SOURCE_DETAILS_001.json', enc(details))
    post = []
    for row in observations:
        data, meta = read(Path(row['path']), row['sha256'], row['bytes'])
        copy, copy_meta = read(OUT / row['copy_path'], row['sha256'], row['bytes'])
        need(data == copy and meta == row['passes'][0]
             and copy_meta == row['copy_observation'], 'exact original/copy post-read raw9')
        post.append(dict(path=row['path'], observation=meta, copy_observation=copy_meta))
    need([absent(path) for path in absent_paths] == absences, 'post-read absence drift')
    once('POST_MAJOR034_SOURCE_REVIEW_001.json', enc(dict(schema_version=1,
         created_utc=now(), reviewer='/root', observations=post,
         all_original_and_copy_bytes_and_raw9_exact=True,
         prepublication_absences=absences, publication_performed=False,
         target_execution=False, operational_authority=False)))
    peer = dict(schema_version=1,
         record_type='independent_major034_documentation_prepublication_source_review',
         created_utc=now(), reviewer='/root', source_author='/root/actual_record_checker',
         scope=SCOPE, verdict='PASS_MAJOR034_DOCUMENTATION_SOURCE_ONLY',
         publisher_sha256=PUBLISHER_SHA, manifest_sha256=MANIFEST_SHA,
         publication_performed=False, target_execution=False, operational_authority=False)
    exact(peer, REVIEW_KEYS)
    once('INDEPENDENT_MAJOR034_PREPUBLICATION_SOURCE_REVIEW_001.json', enc(peer))
    once('HANDOFF_MAJOR034_SOURCE_REVIEW_001.md',
         ('\n\n'.join(['Genuine Root full Major034 documentation Source review only; publication and different creation audit remain separate.', *checks, *conditions]) + '\n').encode('utf8'))
    print(json.dumps(dict(peer_sha256=sha(enc(peer)), peer_bytes=len(enc(peer)),
        details_sha256=sha(enc(details)), finite_inputs=len(observations),
        selected_links=len(extracted), verdict=peer['verdict'],
        publication_performed=False, target_execution=False)))

if __name__ == '__main__':
    try:
        main()
    except BaseException as error:
        once('OWN_MAJOR034_SOURCE_AUDITOR_REFUSAL_001.json', enc(dict(
            schema_version=1, record_type='owned_major034_source_auditor_refusal',
            created_utc=now(), reviewer='/root', failure_type=type(error).__name__,
            failure=str(error), source_acceptance=None, publication_performed=False,
            target_execution=False, operational_authority=False)))
        raise
