}

def need(v, message):
    if not v:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def enc(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def now():
    return datetime.now(timezone.utc).isoformat(timespec='microseconds')

def exact(value, keys):
    need(type(value) is dict and set(value) == set(keys), 'closed keyset differs')

def decode(data, physical_name=None):
    def pairs(rows):
        result = {}
        for key, value in rows:
            need(key not in result, 'duplicate JSON key')
            result[key] = value
        return result
    def bad(value):
        raise ValueError('Source float/nonfinite JSON refused')
    need(not data.startswith(b'\xef\xbb\xbf'), 'JSON BOM refused')
    need(physical_name is None or physical_name in PHYSICAL_DECIMALS,
         'only an externally pinned native physical record admits Decimal')
    value = json.loads(data.decode('utf8', 'strict'), object_pairs_hook=pairs,
                       parse_float=Decimal if physical_name else bad,
                       parse_constant=bad)
    if physical_name:
        actual = {}
        def walk(item, path):
            if type(item) is Decimal:
                need(item.is_finite(), 'nonfinite physical measurement')
                actual[path] = str(item)
            elif type(item) is dict:
                for key, child in item.items():
                    walk(child, path + '/' + key)
            elif type(item) is list:
                for index, child in enumerate(item):
                    walk(child, path + '/' + str(index))
        walk(value, '')
        need(actual == PHYSICAL_DECIMALS[physical_name],
             'native record Decimal field/value domain differs')
    return value

def raw(s):
    return [getattr(s, key) for key in (
        'st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns',
        'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def ancestors(p):
    result = []
    for q in reversed(p.parents):
        s = q.lstat()
        need(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode)
             and not s.st_file_attributes & 1024, 'plain ancestor required')
        result.append([str(q), s.st_dev, s.st_ino])
    return result

def read(p, pin=None, size=None):
    need(p.is_absolute(), 'absolute pinned path required')
    ancestry = ancestors(p)
    a = p.lstat()
    need(stat.S_ISREG(a.st_mode) and not stat.S_ISLNK(a.st_mode)
         and a.st_nlink == 1 and not a.st_file_attributes & 1024
         and 0 <= a.st_size <= MAX_FILE, 'plain one-link bounded file')
    with p.open('rb', buffering=0) as handle:
        b = os.fstat(handle.fileno())
        x, y = raw(a), raw(b)
        need(x[:4] + x[5:] == y[:4] + y[5:] and x[4] == x[8],
             'cross-API8 identity excluding ctime; path ctime/birth')
        data = handle.read(a.st_size + 1)
        need(raw(b) == raw(os.fstat(handle.fileno())), 'same-handle raw9 drift')
    need(raw(a) == raw(p.lstat()) and ancestors(p) == ancestry,
         'same-path raw9/ancestor drift')
    need(len(data) == a.st_size, 'bounded exact read')
    need(pin is None or (type(pin) is str and
         re.fullmatch('[0-9a-f]{64}', pin) and sha(data) == pin),
         'external SHA differs')
    need(size is None or (type(size) is int and size == len(data)),
         'external byte count differs')
    return data, dict(path=str(p), sha256=sha(data), bytes=len(data),
                     path_raw9=x, descriptor_raw9=y, ancestors=ancestry)

def local(relative):
    need(type(relative) is str and 0 < len(relative) <= 399
         and '\\' not in relative and not relative.startswith('/')
         and all(part not in ('', '.', '..') and ':' not in part
                 for part in relative.split('/')), 'canonical local path')
    return ROOT.joinpath(*relative.split('/'))

def once(relative, data):
    need(type(data) is bytes and len(data) <= MAX_FILE, 'owned output cap')
    path = OUT.joinpath(*relative.split('/'))
    path.parent.mkdir(parents=True, exist_ok=True)
    ancestry = ancestors(path)
    need(not path.exists() and not path.is_symlink(), 'owned role already exists')
    with path.open('xb') as handle:
        need(handle.write(data) == len(data), 'complete exclusive owned write')
        handle.flush()
        os.fsync(handle.fileno())
    need(ancestors(path) == ancestry and read(path, sha(data), len(data))[0] == data,
         'owned write/readback drift')

def ticks(text):
    need(type(text) is str and re.fullmatch(
        r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,7}\+00:00', text),
         'canonical Py6/PS7 UTC tick string')
    base, fraction = text[:-6].split('.')
    dt = datetime.fromisoformat(base + '+00:00')
    need(dt.strftime('%Y-%m-%dT%H:%M:%S') == base, 'canonical UTC date')
    epoch = datetime(1970, 1, 1, tzinfo=timezone.utc)
    delta = dt - epoch
    return (delta.days * 86400 + delta.seconds) * 10000000 + int(fraction.ljust(7, '0'))

def main():
    need(Path(__file__).absolute() == OUT / 'ROOT_REVIEW_MAJOR034_SOURCE_001.py',
         'fixed genuine Root auditor path')
    options = argparse.ArgumentParser()
    options.add_argument('--expected-self-sha256', required=True)
    args = options.parse_args()
    registry = {}
    def add(path, pin=None, size=None):
        data, _ = read(path, pin, size)
        row = (sha(data), len(data))
        need(path not in registry or registry[path] == row, 'conflicting finite pin')
        registry[path] = row
        need(len(registry) <= MAX_INPUTS, 'finite Source registry cap')
        return data
    def addrow(row):
        exact(row, ('path', 'sha256', 'bytes'))
        need(type(row['bytes']) is int and 0 <= row['bytes'] <= MAX_FILE, 'typed size')
        return add(local(row['path']), row['sha256'], row['bytes'])

    add(Path(__file__), args.expected_self_sha256)
    manifest = decode(add(STAGE / 'STAGED_DOCUMENTATION_MANIFEST_034_001.json',
                          MANIFEST_SHA, 48370))
    exact(manifest, ('schema_version', 'record_type', 'author', 'prepared_utc',
                    'checkpoint', 'primaries', 'inputs', 'links', 'source_only',
                    'publication_performed', 'target_execution', 'operational_authority'))
    need(type(manifest['schema_version']) is int and manifest['schema_version'] == 1
         and manifest['record_type'] == 'major034_documentation_stage'
         and manifest['author'] == '/root/actual_record_checker'
         and manifest['source_only'] is True, 'Major034 stage nominals')
    need(all(manifest[k] is False for k in (
         'publication_performed', 'target_execution', 'operational_authority')),
         'documentation Source-only stage')
    need(type(manifest['inputs']) is list and len(manifest['inputs']) == 60
         and type(manifest['links']) is list and len(manifest['links']) == 32,
         'fixed60 pairs/32 links')
    prepared = ticks(manifest['prepared_utc'])
    publisher = add(STAGE / 'PUBLISH_MAJOR034_DOCS_001.py', PUBLISHER_SHA, 9951)
    context = decode(add(STAGE / 'SELECTED_SOURCE_CONTEXT_034_001.json', CONTEXT_SHA, 14715))
    contract = decode(add(STAGE / 'DOCUMENTATION_SOURCE_CONTRACT_034_001.json', CONTRACT_SHA, 2542))
    author = decode(add(STAGE / 'AUTHOR_MAJOR034_STAGE_AUDIT_001.json', AUTHOR_SHA, 323930))
    need(context['source_author'] == contract['source_author'] == author['source_author']
         == '/root/actual_record_checker' and context['scope'] == contract['scope']
         == author['scope'] == SCOPE, 'author/scope consistency')
    need(context['prepared_utc'] == contract['prepared_utc'] == author['prepared_utc']
         == manifest['prepared_utc'], 'frozen preparation timestamp')
    for obj in (context, contract, author):
        need(all(obj[k] is False for k in (
             'publication_performed', 'target_execution', 'operational_authority'))
             if 'publication_performed' in obj else
             obj['target_execution'] is False and obj['operational_authority'] is False,
             'selected author record has no operational authority')
    need(author['finite_input_count'] == 60 and author['selected_link_count'] == 32
         and author['whole_five_primary033_bytes_preserved'] is True
         and author['selected_checker28_tests_executed'] is False
         and author['pro3_TYPE_pass'] is False
         and author['future_publisher_main_or_import_or_compile_or_definitions_executed'] is False,
         'author preparation limits')

    prior = decode(add(WORK / 'root-docs-major033/STAGED_DOCUMENTATION_MANIFEST_033_001.json',
                       '384946e3efe58c11b922899b3b6a320806f1a3127e662fe596524e8d28f316a8', 76127))
    pair_counts = []
    superseded_prior_primary_inputs = []
    prior_primary_rows = {row['destination']: row for row in prior['primaries']}
    for packet in (manifest, prior):
        addrow(packet['checkpoint'])
        for row in packet['primaries']:
            exact(row, ('destination', 'before', 'candidate', 'preservation'))
            addrow(row['before'])
            addrow(row['candidate'])
        for row in packet['inputs']:
            exact(row, ('original', 'copy'))
            if packet is prior and row['original']['path'] in PRIMARY:
                # Root published033. Its five old live032 input roles now legitimately
                # contain033; preserve the old bytes through authentic before/copy roles.
                oldrow = prior_primary_rows[row['original']['path']]
                need(row['original']['sha256'] == oldrow['before']['sha256']
                     and row['original']['bytes'] == oldrow['before']['bytes']
                     and addrow(oldrow['before']) == addrow(row['copy']),
                     'superseded033 primary input differs from preserved before/copy')
                superseded_prior_primary_inputs.append(dict(
                    original=row['original'], preserved_before=oldrow['before'],
                    copy=row['copy'], selected_current033=oldrow['candidate'],
                    obsolete032_live_pin_replayed=False))
            else:
                need(addrow(row['original']) == addrow(row['copy']), 'complete packet copy differs')
        pair_counts.append(len(packet['inputs']))
    need(pair_counts[:2] == [60, 78], 'selected034/prior033 pair counts')
    need(len(superseded_prior_primary_inputs) == 5,
         'exact five legitimately superseded prior live-primary roles')
    final = {r['original']['path']: (r['original']['sha256'], r['original']['bytes'])
             for r in manifest['inputs']}
    need(len(final) == 60, 'duplicate current original')
    declared = {r['path']: (r['sha256'], r['bytes']) for r in context['selected_inputs']}
    need(len(declared) == len(context['selected_inputs']) == 58
         and all(final.get(key) == value for key, value in declared.items()),
         'all selected context inputs are authenticated current pairs')

    selected_section_pins = [
     ('7d1a73c502e84e2c50b0e3f51dec7ce65c0a112eff1b85db2eda8381ae17c210', 1741),
     ('f014d3590fadbcd8b0965614da141999dacff38f3e6355231155d5ac1d32afb7', 2483),
     ('0243d2aff0bcccb7cdc4462fefd0f866cd44d4004502ac51203d27a0c5d543cf', 1299),
     ('519d081c2bec44a3a71622694a5d74dc66389b4a304f270b3faa68d727637beb', 1968),
     ('79605b58e6d07ccc3854fb9afdb7696b099c763f048131f60ab45b9863b69a16', 1586)]
    boundary = b'\n\n---\n\nEarlier primary bytes below remain exact history; their pending statements describe the earlier selected snapshot.\n\n'
    texts, history = [], []
    need(tuple(row['destination'] for row in manifest['primaries']) == PRIMARY
         and tuple(row['destination'] for row in prior['primaries']) == PRIMARY,
         'exact five primary order')
    for index, (row, oldrow) in enumerate(zip(manifest['primaries'], prior['primaries'])):
        before, candidate = addrow(row['before']), addrow(row['candidate'])
        need(add(local(row['destination']), sha(before), len(before)) == before
             == addrow(oldrow['candidate']), 'current five033 baselines/candidates exact')
        section = add(STAGE / ('selected-sections/section-' + str(index) + '.md'),
                      *selected_section_pins[index])
        if index < 3:
            need(row['preservation'] == 'suffix' and candidate == section + boundary + before,
                 'complete033 suffix and selected new prefix differ')
            addition = candidate[:-len(before)]
        else:
            need(row['preservation'] == 'prefix' and candidate == before + b'\n\n' + section,
                 'complete033 prefix and selected new suffix differ')
            addition = candidate[len(before):]
        need(b'_PREPARED_UTC_' not in addition and b'_WORK_' not in addition
             and manifest['prepared_utc'].encode('ascii') in addition,
             'final selected addition, not stale draft')
        text = addition.decode('utf8', 'strict')
        need('PENDING/unselected' not in text and 'differentactualauditPENDING' not in text
             and 'b514' in text and '3d4e' in text, 'current TYPE failed-audit selection wording')
        texts.append(dict(document=row['destination'], bytes=len(addition),
                          sha256=sha(addition), text=text))
        history.append(dict(destination=row['destination'], preservation=row['preservation'],
                            before=row['before'], candidate=row['candidate'],
                            complete_prior033_bytes_exact=True, current_primary_equals_before=True))
    checkpoint = addrow(manifest['checkpoint'])
    need(sha(checkpoint) == CHECKPOINT_SHA and len(checkpoint) == 9969, 'fixed checkpoint005')
    draft_checkpoint = add(STAGE / 'DRAFT_CHECKPOINT_005_SOURCE.md',
                           '318d1c7be02227966bb7e6baf527a53ee98ea3ca492f7ff09739a56a1462d386', 9756)
    checker_status = b'[Genuine Root compact003](metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_003.json) is separately externally selected at SHA6d981aa8, Source-only; no actual test or phase authority follows.'
    need(draft_checkpoint.replace(b'_PREPARED_UTC_', manifest['prepared_utc'].encode('ascii'))
         .replace(b'_CHECKER_SOURCE_REVIEW_STATUS_', checker_status)
         == checkpoint, 'checkpoint exact two declared Source-status substitutions')
    texts.append(dict(document=CHECKPOINT.relative_to(ROOT).as_posix(), bytes=len(checkpoint),
                      sha256=sha(checkpoint), text=checkpoint.decode('utf8', 'strict')))
    extracted = []
    for item in texts:
        for target in re.findall(r'\]\(([^)]+)\)', item['text']):
            need(not target.startswith(('https:', 'http:', 'file:')), 'local documentation links only')
            resolved = (local(item['document']).parent / target).resolve()
            relative = resolved.relative_to(ROOT).as_posix()
            extracted.append(dict(origin=item['document'], target=target, resolved_path=relative))
            if resolved != CHECKPOINT:
                add(resolved)
    def linkkey(row):
        exact(row, ('origin', 'target', 'resolved_path'))
        return row['origin'], row['target'], row['resolved_path']
    need(sorted(map(linkkey, extracted)) == sorted(map(linkkey, manifest['links']))
         and len(extracted) == 32, 'all32 final-location links exact')

    def selected(name):
        key = WORK.relative_to(ROOT).as_posix() + '/' + name
        need(key in final, 'selected fact absent from final finite Source inputs')
        pin, size = final[key]
        return decode(add(local(key), pin, size),
                      name if name in PHYSICAL_DECIMALS else None)
    creation = selected('root-docs-major033/ROOT_CREATION_SELECTION_033_001.json')
    need(creation['author'] == '/root'
         and creation['verdict'] == 'SELECTED_GENUINE_DIFFERENT_CREATION_ACCEPTANCE'
         and creation['Root_owning_publication_tool_chunk'] == 'ca2cda'
         and creation['Root_owning_exit_code'] == 0
         and creation['publication_receipt']['sha256']
         == '095e918ef79804ea344a42577e339ff083e7ff6f83ad2bd36fca9cff8c37fb61'
         and creation['creation_review']['sha256']
         == '43682521a2a61c42e412221ab5e72b8026832d857e3660a45970708a6857b754',
         'genuine prior033 Root creation selection')
    old_creation = selected('root-docs-independent-major033/INDEPENDENT_MAJOR033_CREATION_REVIEW_001.json')
    need(old_creation['verdict'] == 'PASS_ACTUAL_MAJOR033_DOCUMENTATION_CREATION_ONLY',
         'prior different creation scope')
    selected('root-docs-independent-major033/POST_MAJOR033_CREATION_REVIEW_001.json')
    u8 = selected('guard008-utility-source-independent-review001/INDEPENDENT_UTILITY008_SOURCE_REVIEW_001.json')
    need(u8['verdict'] == 'REFUSED_SOURCE_PREPARATION_REQUIRED_FLAT_HASH_ARGV_UNREADABLE'
         and u8['finite_input_count'] == 72 and u8['new_payload_count'] == 17
         and u8['preserved_payload_count'] == 41 and u8['selected_author_pair_count'] == 9
