        for side in ('original', 'copy'):
            exact(pair[side], ('path', 'sha256', 'bytes'))
        original = Path(pair['original']['path'])
        copy = Path(pair['copy']['path'])
        need(original.is_relative_to(Path('D:/Aenv/pro3/runs/coordination/next_step_20261003_types'))
             and copy.is_relative_to(WORK / 'root-pro3-type-closeout001'),
             'finite producer/copy TYPE namespace')
        need(add(original, pair['original']['sha256'], pair['original']['bytes'])
             == add(copy, pair['copy']['sha256'], pair['copy']['bytes']),
             'selected Pro3 producer/local copy differ')
    need(cleanup['actual_exit_code'] == 1 and cleanup['actual_mypy_api_run'] is False
         and cleanup['type_result_accepted'] is False
