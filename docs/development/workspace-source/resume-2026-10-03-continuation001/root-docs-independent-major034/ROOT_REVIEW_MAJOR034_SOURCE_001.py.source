    u10details = selected('guard010-utility-source-independent-review001/INDEPENDENT_UTILITY010_SOURCE_DETAILS_001.json')
    need(u10details['causal_control_plans'] == 7
         and u10details['full_function_causal_tests_executed'] is False,
         'seven U010 plans remain UNRUN')
    choice = selected('root-pipeline-source-successor-design001/ROOT_SUCCESSOR_SOURCE_CHOICE_004.json')
    need(choice['pipeline_successor']['template'] == 'RUN_ROOT_METADATA_PIPELINE_009.TEMPLATE.ps1'
         and choice['pipeline_successor']['bound'] == 'RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1'
         and choice['pipeline_successor']['utility_gate'] == 'review_guard006_actual_records_001-corrected010.TEMPLATE.py'
         and choice['pipeline_successor']['config_sha256_must_equal_preserved_config001']
         == 'ef3a6f208158ca2809aecf6d92b62b63777d4b795574c8cdccec1f882c669488'
         and choice['actual_models_or_pool20'] is None
         and choice['actual_metadata_or_current24'] is None,
         'actual-independent choice004 future identity boundaries')
    need(choice['unchanged_limits'] == dict(Root_unit_seconds=450, after_seconds=60,
         both_context_runtime_age_at_unit_GO_seconds=90, original_context_seconds=600,
         resource_age_seconds_through_spawn=60, unit_plus_after_reserve_seconds=510,
         utility_composer_bound_source_bytes_each=131072), 'unchanged guards')
    parser = selected('root-guard006-pipeline-prep001/ROOT_PIPELINE009_NATIVE_SOURCE_PARSE_001.json')
    need(parser['owning_parser_tool_chunk'] == 'ee4705' and parser['owning_parser_exit_code'] == 0
         and parser['native_parser_errors'] == 0 and parser['function_count'] == 26
         and parser['unchanged_function_count'] == 25
         and parser['changed_functions'] == ['Source-Pool']
         and parser['parser_only_no_source_execution'] is True
         and parser['actual_binding'] is False, 'native parser observation only')

    checker_peer = selected('metadata3-checker-source-independent010/INDEPENDENT_METADATA3_CHECKER010_SOURCE_REVIEW_001.json')
    root_checker = selected('metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_003.json')
    checker_details = selected('metadata3-checker-source-independent010/INDEPENDENT_METADATA3_CHECKER010_SOURCE_DETAILS_001.json')
    need(checker_peer['reviewer'] == '/root/capsule_design_review'
         and checker_peer['source_author'] == root_checker['source_author'] == '/root/actual_record_checker'
         and root_checker['reviewer'] == '/root' and checker_peer['tests_executed'] is False
         and root_checker['tests_executed'] is False
         and checker_peer['actual_binding'] is None and root_checker['actual_binding'] is None
         and checker_peer['full_source_details_sha256'] == root_checker['full_source_details_sha256']
         == 'a0c7285f1e3a8851cc156a0e435f4e60f283b47de1d551201ce1478bb93e1c99',
         'different Source review and genuine Root compact003')
    need(checker_details['manifest_payload_count'] == 141
         and checker_details['predecessor_payload_count'] == 55
         and checker_details['author_input_pair_count'] == 72
         and checker_details['finite_input_count'] == 150
         and checker_details['checker_function_count'] == 69
         and checker_details['unchanged_function_count'] == 66
         and checker_details['changed_function_names'] == ['configure', 'root_trust_preflight', 'decision']
         and checker_details['literal_reversal_count'] == 10
         and len(checker_details['direct_test_methods']) == 28
         and checker_details['prior25_ASTs_exact'] is True
         and checker_details['tests_executed'] is False, 'checker010 current Source counts/limits')

