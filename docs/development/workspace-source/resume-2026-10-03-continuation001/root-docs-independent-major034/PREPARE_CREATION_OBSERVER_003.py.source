"""Own metadata title-case diagnostic correction, preserving observer002."""
import hashlib
import json
from pathlib import Path
OUT=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001\root-docs-independent-major034')
old=(OUT/'REVIEW_MAJOR034_CREATION_002.py').read_bytes()
sha=lambda value:hashlib.sha256(value).hexdigest()
def once(name,value):
    with (OUT/name).open('xb') as stream:
        if stream.write(value)!=len(value):raise ValueError('complete metadata write')
    if (OUT/name).read_bytes()!=value:raise ValueError('metadata readback')
once('before-creation-observer002.bytes',old)
rows=[]
for path in sorted((OUT/'creation002-inputs').glob('*.bytes')):
    data=path.read_bytes();rows.append(dict(path=path.relative_to(OUT).as_posix(),sha256=sha(data),bytes=len(data)))
once('OWN_MAJOR034_CREATION_OBSERVER_REFUSAL_002.json',(json.dumps(dict(schema_version=1,reviewer='/root/bootstrap_stage',source_sha256=sha(old),tool_chunk='5728a9',exit=1,reason='Own title-case check omitted the actual lowercase major034 header in HANDOFF/START_HERE',documentation_defect_proven=False,creation_review_published=False,target_execution=False,partial_copy_count=len(rows),partial_copies=rows),sort_keys=True,indent=2)+'\n').encode('ascii'))
text=old.decode('utf8')
changes=[("OUT / 'REVIEW_MAJOR034_CREATION_002.py'","OUT / 'REVIEW_MAJOR034_CREATION_003.py'"),("'creation002-inputs/%03d.bytes'","'creation003-inputs/%03d.bytes'"),("need(addition and b'Major034' in addition or addition and b'MAJOR STEP034' in addition, 'new034 text')","need(addition and re.search(rb'(?:Major034|major034|MAJOR STEP034)', addition), 'actual selected034 title spelling')")]
for before,after in changes:
    if text.count(before)!=1:raise ValueError('exact metadata anchor')
    text=text.replace(before,after)
once('REVIEW_MAJOR034_CREATION_003.py',text.encode('utf8'))
print(json.dumps(dict(observer003_sha256=sha(text.encode('utf8')),preserved_partial_copies=len(rows),selected_target_execution=False)))
