    b=content[str(p)];copy=OWN/'stage-evidence'/p.relative_to(ROOT);once(copy,b);copied,cr=observe(copy);need(copied==b,'Source copy exact');row['owned_copy_path']=str(copy);row['owned_copy_observation']=cr;inputs.append(dict(original=pointer(p,b),copy=pointer(copy,b)))
need(len(inputs)<=100,'finite Source pairs cap')
named=['root-guard006-pipeline-prep001/ROOT_PIPELINE_INIT_TRACE_002.json','root-guard006-pipeline-prep001/ROOT_PIPELINE_TRUST_SELECTION_002.json','root-guard006-pipeline-prep001/ROOT_METADATA_PIPELINE_GO_002.json','metadata3-actual-checker-prep001/CHECKER_READY_BEFORE_006.json','metadata3-actual-checker-prep001/CHECKER_READY_AFTER_006.json','guard006-bound-late-checker-prep001/BOUND_LATE_CHECKER_READY_006.json','root-guard006-model-prep001/ACTUAL_SOURCE_POOL_PROJECTION_002.json','root-guard006-model-prep001/UTILITY_SOURCE_BINDINGS_002.json','root-guard006-model-prep001/UTILITY_SOURCE_PROTOCOL_002.json','root-guard006-model-prep001/COMPOSER_FRESH_SOURCE_MODEL_002.json','guard006-bound-late-checker-prep001/review_guard006_actual_records_001.BOUND.py','guard006-bound-late-checker-prep001/compose-root-review-packet-006.BOUND.py']
absences=[]
for r in named:need(not(WORK/r).exists(),'named downstream role already present '+r);absences.append(dict(path=str(WORK/r),observed_absent=True,scope='named filesystem role only, no process/quiet claim'))
for row in observations:
    p=Path(row['original_path']);b,post=observe(p);copied,cpost=observe(Path(row['owned_copy_path']));need(b==content[str(p)]and post==row['observations'][0]and copied==b and cpost==row['owned_copy_observation'],'full Source post stability');row['post_read']=post;row['owned_copy_post_read']=cpost
for r in PRIMARY:need(observe(ROOT/r)[0]==baseline[r],'current035 primary bytes unchanged')
audit=dict(schema_version=1,record_type='major036_author_Source_stage_audit',source_author=AUTHOR,prepared_utc=STAMP,scope=contract['scope'],finite_input_count=len(inputs),selected_link_count=len(links),observations=observations,named_role_absences=absences,whole_five_primary035_bytes_preserved=True,publisher_function_count=len(f0),changed_function_ASTs=changed,exact_publisher_byte_reversal=True,publisher_definitions_import_main_executed=False,helper_test_target_execution=False,publication_performed=False,operational_authority=False,current_synthetic28_actual_acceptance_only=True,currentConsumer24_UNRUN=True,utility6_plus_F1_deferred_UNRUN=True,actual_models_or_fit_or_capture=None,selected_pro3_evidence_attributed_only=True,selected_pro3_full_component_PASS=False,old_pending_snapshot_bytes_preserved=True)
audit_path=OWN/'AUTHOR_MAJOR036_STAGE_AUDIT_001.json';once(audit_path,wire(audit))
manifest=dict(schema_version=1,record_type='major036_documentation_stage',author=AUTHOR,prepared_utc=STAMP,checkpoint=pointer(checkpoint_candidate,checkpoint_body),primaries=candidate_rows,inputs=inputs,links=links,source_only=True,publication_performed=False,target_execution=False,operational_authority=False)
manifest_body=wire(manifest);need(len(manifest_body)<=2097152,'unchanged manifest cap')
for row in observations:need(observe(Path(row['original_path']))[1]==row['observations'][0],'final originals stable')
for r in PRIMARY:need(observe(ROOT/r)[0]==baseline[r],'final035 primaries unchanged')
manifest_path=OWN/'STAGED_DOCUMENTATION_MANIFEST_036_001.json';once(manifest_path,manifest_body)
print(json.dumps(dict(manifest_sha256=sha(manifest_body),manifest_bytes=len(manifest_body),publisher_sha256=sha(publisher),publisher_bytes=len(publisher),audit_sha256=sha(wire(audit)),audit_bytes=len(wire(audit)),finite_pairs=len(inputs),links=len(links),checkpoint_bytes=len(checkpoint_body),publisher_functions=len(f0),changed_functions=changed,publication_performed=False,target_execution=False),sort_keys=True))
