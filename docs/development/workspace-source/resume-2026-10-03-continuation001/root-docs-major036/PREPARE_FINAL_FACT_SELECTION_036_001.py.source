"""Own data selection for completed genuine records; no Root masquerade."""
from pathlib import Path
import hashlib,json,os
WORK=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001')
OWN=WORK/'root-docs-major036'
MAXIMUM=8388608
def digest(b):return hashlib.sha256(b).hexdigest()
def read(p):
    assert p.is_relative_to(WORK)and p.is_file()and p.stat().st_size<=MAXIMUM
    b=p.read_bytes();assert len(b)<=MAXIMUM
    return b
records=[]
def selected(relative,pin,role):
    b=read(WORK/relative);assert digest(b)==pin
    row=dict(path=relative,sha256=pin,bytes=len(b),role=role);records.append(row)
    return b
acceptance=selected('root-checker28-actual-independent002/INDEPENDENT_ACTUAL_CHECKER28_REVIEW_002.json','0ab74ef0c01f50b9b4ee2629cda76c609d94b35ed16cfcbf167a5a59c5c637ad','checker_acceptance')
selected('root-checker28-runtime-prep002/ROOT_ACTUAL_CHECKER28_ACCEPTANCE_SELECTION_002.json','2e1b4b51d384374d7a7eb41c88585e49f435b15f802922d2b62758ccae296c49','Root_checker_selection')
selected('root-checker28-actual-independent002/INDEPENDENT_ACTUAL_CHECKER28_DETAILS_002.json','198c2180ccae6dcc32d41ff0dafb589fff52272588cbf598630a829cb39e6d72','checker_details')
selected('root-checker28-actual-independent002/POST_ACTUAL_CHECKER28_REVIEW_002.json','3197dfee7f980a703df0ced0b63453bbdd35dbc929910b8a9187969de1dabce5','checker_post')
selected('root-checker28-actual-independent002/HANDOFF.md','21bbda83ece872ba3af7cbf1102808c3f92cf5e45294ce9f9e4239f2be9e1590','checker_handoff')
type_body=selected('root-pro3-type004-observation001/ROOT_EXTERNAL_TYPE004_FAILURE_SOURCE_SELECTION_001.json','50db55938242cec370c326a0917e75272e7e2bead6fc90a7b7f7c5395720c8d6','TYPE004_root_selection')
type_record=json.loads(type_body)
assert len(type_record['external_source_observations'])==11
for i,outer in enumerate(type_record['external_source_observations']):
    r=outer['before_copy'];p=Path(r['path']);assert p.is_relative_to(WORK)
    b=selected(p.relative_to(WORK).as_posix(),r['sha256'],f'TYPE004_fixed_{i:02d}');assert len(b)==r['bytes']
selected('root-checker28-runtime-prep002/ROOT_ACTUAL_CHECKER28_PHYSICAL_WITNESS_002.json','35571fbe0d9d1931b813c40cab7cfef2a37063100ffdf118515c0883fa40c82d','checker_physical')
selected('metadata3-actual-checker-prep001/ACTUAL_CHECKER_BINDING_002.json','c731bbe787ff03812aaf5757fe9edf4f5169daf889dcfa4bb57ca53ff595b3e4','Root_config18')
peer_path='root-guard006-model-prep001/INDEPENDENT_MODEL_CONSTRUCTOR_SOURCE_REVIEW_004.json'
peer=read(WORK/peer_path);assert digest(peer).startswith('43bc4b334')
selected(peer_path,digest(peer),'Root_ctor_compact')
predicates=dict(checker_acceptance=dict(schema_version=1,record_type='independent_actual_synthetic_checker28_review',reviewer='/root/owner_docs_review',producer='/root',scope='SYNTHETIC_METADATA3_CHECKER28_STDLIB_REGRESSIONS_ONLY',verdict='PASS_ACTUAL_SYNTHETIC_CHECKER28_ONLY',methods=28,subtests=24,events=80,failures=0,errors=0,skips=0,diagnostic_bytes=0,conservative_physical_upper_seconds=38,consumed_no_replay=True,actual_project_metadata_or_current24=False,models_or_bound_pool=False,operational_authority=False,hard_OS_Job_or_descendant_or_global_quiet=False),TYPE004_root_selection=dict(schema_version=1,record_type='root_external_type004_failure_source_selection',author='/root',decision='SELECT_DIFFERENT_FAILED_TYPE004_REVIEW_AND_SUCCESSOR_ONLY_MANUAL_REPAIR_AUTHORITY_NO_COMPONENT_PASS',all11_fixed_inputs_triple_read_copy_post_exact=True,actual_mypy_zero_exit_205_files_observed=True,full_guarded_component_accepted=False,native_deadline_difference_nanoseconds=800,native_final_postdeadline_checks_unreached=True,Root_pro2_independent_process_scan_or_Job_or_global_quiet_claim=False,actual_runtime_validation_scientific_or_operational_authority_granted=False,attempt_and_grant004_consumed_no_replay=True,actual_TYPE005_patch_preparation_or_execution_attested_by_this_observer=False))
for role,body in (('checker_acceptance',acceptance),('TYPE004_root_selection',type_body)):
    v=json.loads(body)
    for k,x in predicates[role].items():assert v.get(k)==x and type(v.get(k))is type(x)
out=dict(schema_version=1,record_type='major036_author_completed_factual_Source_selection',source_author='/root/actual_record_checker',checker_acceptance_complete=True,TYPE004_external_observation_complete=True,selected_records=records,record_predicates=predicates,publication_performed=False,target_execution=False,operational_authority=False,root_compact_or_Root_execution_selection_created_by_author=False)
b=(json.dumps(out,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii');p=OWN/'FINAL_FACT_SELECTION_036_001.json'
with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b
print(json.dumps(dict(path=str(p),bytes=len(b),sha256=digest(b),selected_record_count=len(records))))
