    for k,e in dict(record_type='root_synthetic_checker19_parent_terminal',started_utc=started['started_utc'],exit_code=0,timed_out=False,capture_overflow=False,capture_drain_complete=True,direct_child_reaped=True,source_runtime_preserved=True,failure=None,physical_parent_within60_seconds=True,hard_OS_Job_or_descendant_cleanup_proof=False,operational_authority=False).items():nominal(terminal[k],e)
