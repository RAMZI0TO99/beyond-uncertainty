    exact(started,('schema_version','record_type','author','scope','started_utc','parent_pid','parent_source_sha256','runner_source_sha256','root_GO_sha256','resource_observed_utc','free_physical_memory_bytes','disk_free_bytes','resource_lease_or_native_quiet'))
