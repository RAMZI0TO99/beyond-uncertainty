def sha(v):return hashlib.sha256(v).hexdigest()
def enc(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def once(name,v):
    p=OUT/name;p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb')as f:f.write(v)
def raw(s):return [getattr(s,k)for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def ancestry(p):
    result=[]
    for q in reversed(p.parents):
        s=q.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024
        result.append([str(q),s.st_dev,s.st_ino])
    return result
def read(p,pin,cap):
    assert type(cap)is int and 0<=cap<=8388608
    chain=ancestry(p);a=p.lstat();ar=raw(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and a.st_size<=cap
    with p.open('rb')as f:
        b=os.fstat(f.fileno());br=raw(b);assert all(ar[i]==br[i]for i in (0,1,2,3,6,7,8))
        body=f.read(cap+1);assert raw(os.fstat(f.fileno()))==br
    assert len(body)==a.st_size<=cap and sha(body)==pin and raw(p.lstat())==ar and ancestry(p)==chain
    return body,dict(path=str(p),bytes=len(body),sha256=pin,path_raw9=ar,descriptor_raw9=br,ancestors=chain)
def decode(v,wall=False):
    def pairs(rows):
        result={}
        for k,x in rows:assert k not in result;result[k]=x
        return result
    def bad(x):raise ValueError('nonfinite or unselected float')
    return json.loads(v.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=Decimal if wall else bad,parse_constant=bad)
def exact(v,keys):assert type(v)is dict and set(v)==set(keys)
def nominal(v,e):assert type(v)is type(e)and v==e
def absent(p):
    # A missing directory can have missing descendants. Authenticate the existing prefix.
    q=p.parent
    while not q.exists():q=q.parent
    chain=ancestry(q/'probe-absence')
    try:p.lstat()
    except FileNotFoundError:assert ancestry(q/'probe-absence')==chain;return dict(path=str(p),absent=True,observed_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),existing_ancestor_chain=chain)
    raise ValueError('refusal nonentry role exists '+str(p))
