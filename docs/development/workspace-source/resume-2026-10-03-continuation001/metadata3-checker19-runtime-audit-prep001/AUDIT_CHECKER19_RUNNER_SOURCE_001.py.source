    methods.sort(key=lambda r:r['id']);assert len(methods)==19 and methods==projection['methods']and [r['id']for r in methods]==projection['ordered_ids']
    assert len(contract['source_peer_keys'])==12 and contract['source_peer_nominals']['reviewer']=='/root/capsule_design_review'and contract['source_peer_nominals']['source_author']=='/root/root_pipeline_binder'
    assert contract['source_peer_path']=='metadata3-checker19-runtime-audit-prep001/INDEPENDENT_CHECKER19_RUNNER_SOURCE_REVIEW_001.json'
    for k in ('actual_GO','actual_discovery','actual_independent_acceptance','actual_parent','actual_result','actual_subtest_count','actual_tests'):assert contract[k]is None
    assert contract['physical_parent_budget']==dict(child_timeout_seconds_from_parent_entry=52,failure_drain_reap_stop_seconds_from_parent_entry=57,seconds=60,stderr_cap_bytes=65536,stdout_cap_bytes=65536)
    ast_rows=[dict(name=n.name,kind=type(n).__name__,lineno=n.lineno,AST_sha256=sha(ast.dump(n,include_attributes=False).encode('utf8')))for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))]
    assert len([r for r in ast_rows if r['kind']=='FunctionDef'])==13 and len([r for r in ast_rows if r['kind']=='ClassDef'])==1
    checks=[
