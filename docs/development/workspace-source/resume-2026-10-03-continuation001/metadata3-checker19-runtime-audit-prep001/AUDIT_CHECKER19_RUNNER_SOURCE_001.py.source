      (MPEER/'INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_002.json','d4faaf6ae5143c3d9e3c3fa74489b150ccf862b5eaccec414b78bc8a4b144837',2097152),
      (OUT/'CHECKER19_DISCOVERY_PROJECTION_002.json',PROJECTION,10398),
