    inputs=[];bodies={}
    for i,(p,pin,maximum)in enumerate(selected):
        passes=[read(p,pin,maximum)for _ in range(3)];assert passes[0]==passes[1]==passes[2]
        data=passes[0][0];copy='runner-source-inputs001/'+str(i).zfill(2)+'.bytes';once(copy,data);cb,cm=read(OUT/copy,pin,len(data));assert cb==data and cm['path_raw9'][:2]!=passes[0][1]['path_raw9'][:2]
        inputs.append(dict(path=str(p),bytes=len(data),sha256=pin,passes=[r[1]for r in passes],copy_path=copy,copy_observation=cm));bodies[p.name]=data
    manifest=json.loads(bodies['SOURCE_MANIFEST_001.json']);contract=json.loads(bodies['SOURCE_CONTRACT_001.json']);projection=json.loads(bodies['CHECKER19_DISCOVERY_PROJECTION_002.json']);helper_peer=json.loads(bodies['INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json'])
