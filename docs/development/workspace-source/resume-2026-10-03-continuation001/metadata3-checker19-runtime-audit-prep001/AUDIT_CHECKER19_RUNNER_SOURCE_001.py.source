def sha(v):return hashlib.sha256(v).hexdigest()
def enc(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def once(name,v):
    p=OUT/name;p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb')as f:f.write(v)
def raw(s):return [getattr(s,k)for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def ancestors(p):
    rows=[]
    for q in reversed(p.parents):
        s=q.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024
        rows.append([str(q),s.st_dev,s.st_ino])
    return rows
def read(p,pin,maximum):
    assert type(maximum)is int and 0<=maximum<=8388608
    ancestry=ancestors(p);a=p.lstat();ar=raw(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and a.st_size<=maximum
    with p.open('rb')as f:
        b=os.fstat(f.fileno());br=raw(b);assert all(ar[i]==br[i]for i in (0,1,2,3,6,7,8))
        data=f.read(maximum+1);assert raw(os.fstat(f.fileno()))==br
    assert raw(p.lstat())==ar and ancestors(p)==ancestry and len(data)==a.st_size<=maximum and sha(data)==pin
    return data,dict(path=str(p),sha256=pin,bytes=len(data),path_raw9=ar,descriptor_raw9=br,ancestors=ancestry)
def exact(v,keys):assert type(v)is dict and set(v)==set(keys)
def literals(t):
    values={}
    for n in t.body:
        if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            try:values[n.targets[0].id]=ast.literal_eval(n.value)
            except(ValueError,TypeError):pass
    return values
