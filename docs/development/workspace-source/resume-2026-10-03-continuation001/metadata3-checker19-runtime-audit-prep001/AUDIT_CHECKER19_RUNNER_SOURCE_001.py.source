    assert helper_peer['reviewer']=='/root/owner_docs_review'and helper_peer['source_author']=='/root/actual_record_checker'and helper_peer['verdict']=='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY'
    assert all(helper_peer[k]is False for k in ('target_execution','tests_executed','runtime_acceptance','operational_authority'))and helper_peer['actual_binding']is None
