    assert vals['GO_KEYS']==tuple(contract['Root_GO_keys'])and vals['SCOPE']==SCOPE and vals['MODULE']==projection['module_name']
    assert vals['TEST_SHA']==projection['test']['sha256']and vals['HELPER_SHA']==HELPER and vals['PEER_SHA']==HELPER_PEER and vals['PROJECTION_SHA']==PROJECTION
    methods=[]
