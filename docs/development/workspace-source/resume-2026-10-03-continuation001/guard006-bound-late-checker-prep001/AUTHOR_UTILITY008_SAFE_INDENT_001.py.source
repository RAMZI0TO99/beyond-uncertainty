"""Owned Source metadata compositor only; no utility/composer definition is run.

Requires Root's explicit fixed trace and pipeline source filename choice before
authoring008. Performs only literal-span edits and protected indentation edits.
"""
import ast
import hashlib
import io
import json
import os
import stat
import tokenize
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/guard006-bound-late-checker-prep001')
WORK=OWN.parent
old=OWN/'review_guard006_actual_records_001-corrected007.TEMPLATE.py'
source=old.read_bytes()
assert hashlib.sha256(source).hexdigest()=='8f620adad426d38315392b94e5a9e46a66f1a1eb63613aa5fb79a9715abbc8fd'

# Standalone metadata analysis; emission is gated until Root selects the needed
# third hard-nominal filename correction. No value is inferred from a draft.
authorization=WORK/'root-pipeline-source-successor-design001/ROOT_SUCCESSOR_SOURCE_CHOICE_002.json'
choice_bytes=authorization.read_bytes()
assert hashlib.sha256(choice_bytes).hexdigest()=='1edf53523771c936c961a3617115a1d5d56af2f3c5bb04380059e4164cb741dc'
choice=json.loads(choice_bytes)
assert type(choice)is dict
assert choice['schema_version']==1 and type(choice['schema_version'])is int
assert choice['record_type']=='root_source_successor_implementation_choice' and choice['author']=='/root'
assert choice['additional_path_finding']['actual_utility_function']=='physical_provenance'
assert choice['additional_path_finding']['target_or_utility_execution']is False
assert choice['operational_authority']is False
expected={
    'ROOT_PIPELINE_TRUST_SELECTION_001.json':'ROOT_PIPELINE_TRUST_SELECTION_002.json',
    'ROOT_PIPELINE_INIT_TRACE_001.json':'ROOT_PIPELINE_INIT_TRACE_002.json',
    'RUN_ROOT_METADATA_PIPELINE_006.BOUND.ps1':'RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1',
}
assert choice['pipeline_successor']['bound']==expected['RUN_ROOT_METADATA_PIPELINE_006.BOUND.ps1']
assert choice['pipeline_successor']['INIT']==expected['ROOT_PIPELINE_INIT_TRACE_001.json']
assert choice['pipeline_successor']['trust']==expected['ROOT_PIPELINE_TRUST_SELECTION_001.json']
assert 'three necessary identity literals are explicitly authorized' in choice['utility_successor']

text=source.decode('utf8')
tree=ast.parse(text)
function=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='physical_provenance')
lines=text.splitlines(keepends=True)
edits=[];found={}
for node in ast.walk(function):
    if isinstance(node,ast.Constant)and type(node.value)is str and node.value in expected:
        assert node.value not in found
        start=sum(map(len,lines[:node.lineno-1]))+node.col_offset
        end=sum(map(len,lines[:node.end_lineno-1]))+node.end_col_offset
        token=text[start:end]
        assert ast.literal_eval(token)==node.value
        replacement=token.replace(node.value,expected[node.value])
        assert ast.literal_eval(replacement)==expected[node.value]
        edits.append((start,end,replacement));found[node.value]=dict(lineno=node.lineno,old=token,new=replacement)
assert set(found)==set(expected)
for start,end,replacement in sorted(edits,reverse=True):text=text[:start]+replacement+text[end:]
semantic=text.encode('utf8')
semantic_tree=ast.parse(text)
for node in ast.walk(semantic_tree):
    if isinstance(node,ast.Constant)and type(node.value)is str and node.value in expected.values():
        pass
# Full old Module comparison after reverting only the three authorized constants.
normalized=ast.parse(text)
f=next(n for n in normalized.body if isinstance(n,ast.FunctionDef)and n.name=='physical_provenance')
reverse={v:k for k,v in expected.items()}
reverted=[]
for node in ast.walk(f):
    if isinstance(node,ast.Constant)and type(node.value)is str and node.value in reverse:
        reverted.append(node.value);node.value=reverse[node.value]
assert set(reverted)==set(reverse)and len(reverted)==3
assert ast.dump(normalized,include_attributes=False)==ast.dump(tree,include_attributes=False)

protected=set()
for token in tokenize.generate_tokens(io.StringIO(text).readline):
    if token.type==tokenize.STRING and token.end[0]>token.start[0]:
        protected.update(range(token.start[0]+1,token.end[0]+1))
compacted=[];changed=[]
for index,line in enumerate(text.splitlines(keepends=True),1):
    prefix=len(line)-len(line.lstrip(' '))
    if index not in protected and prefix and prefix%4==0:
        updated=' '*(prefix//4)+line[prefix:]
        if updated!=line:changed.append(dict(lineno=index,old_prefix_spaces=prefix,new_prefix_spaces=prefix//4))
        compacted.append(updated)
    else:compacted.append(line)
bound=''.join(compacted).encode('utf8')
assert ast.dump(ast.parse(bound),include_attributes=False)==ast.dump(semantic_tree,include_attributes=False)
assert len(source)-len(bound)==3747 and len(bound)==81402
for index in protected:assert compacted[index-1]==text.splitlines(keepends=True)[index-1]
target=OWN/'review_guard006_actual_records_001-corrected008.TEMPLATE.py'
with target.open('xb')as stream:stream.write(bound);stream.flush();os.fsync(stream.fileno())
analysis=dict(schema_version=1,record_type='utility008_protected_indentation_and_literal_source_facts',author='/root/pubnative_review',
    old_source_sha256=hashlib.sha256(source).hexdigest(),new_source_sha256=hashlib.sha256(bound).hexdigest(),
    old_bytes=len(source),new_bytes=len(bound),indentation_bytes_saved=3747,
    changed_function='physical_provenance',literal_changes=found,protected_multiline_string_lines=sorted(protected),indentation_changes=changed,
    compacted_Module_AST_equals_literal_only_Module_AST=True,all_other_Module_AST_exact=True,
    all_other_function_class_ASTs_exact=True,composer_unchanged=True,
    historical_original_bound_arithmetic=dict(bytes=134174-3747,headroom=131072-(134174-3747),actual_successor_fit=False),
    actual_source_model_fit=None,actual_models=None,actual_pool_peer=None,target_execution=False,operational_authority=False)
metadata=OWN/'UTILITY008_COMPACTION_SOURCE_FACTS_001.json'
with metadata.open('xb')as stream:stream.write((json.dumps(analysis,sort_keys=True,separators=(',',':'))+'\n').encode('ascii'))
print(json.dumps(dict(path=str(target),sha256=analysis['new_source_sha256'],bytes=len(bound),target_execution=False),sort_keys=True))
