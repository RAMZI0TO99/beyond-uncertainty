"""Owned Source metadata only; never imports or executes reviewed definitions."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/guard006-bound-late-checker-prep001')
a=(OWN/'review_guard006_actual_records_001-corrected008.TEMPLATE.py').read_bytes()
b=(OWN/'review_guard006_actual_records_001-corrected010.TEMPLATE.py').read_bytes()
c=(OWN/'review_guard006_actual_records_001-corrected009.TEMPLATE.py').read_bytes()
assert hashlib.sha256(a).hexdigest()=='98167867d0feedd106054a884222d16f9fb77dcf40df6c9f42bda9a14939f0e1'
assert b==c
old=b'\\{[a-z_]+\\}'
new=b'\\{[a-z][a-z0-9_]*\\}'
assert a.count(old)==1 and b==a.replace(old,new)
assert len(b)==81410
tree=ast.parse(b)
function=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='physical_provenance')
found=[n for n in ast.walk(function)if isinstance(n,ast.Constant)and n.value==new.decode()]
assert len(found)==1
found[0].value=old.decode()
assert ast.dump(tree,include_attributes=False)==ast.dump(ast.parse(a),include_attributes=False)
assert sum(isinstance(n,ast.FunctionDef)for n in tree.body)==41
print(json.dumps(dict(path=str(OWN/'review_guard006_actual_records_001-corrected010.TEMPLATE.py'),sha256=hashlib.sha256(b).hexdigest(),bytes=len(b),function_count=41,exact_proposal_bytes=True,all_other_Module_AST_exact=True,target_execution=False),sort_keys=True))
