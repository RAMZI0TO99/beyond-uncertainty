"""UNRUN Root-owned packet producer; it never emits an independent approval."""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path

PROJECT=Path('D:/Aenv/pro2')
WORK=PROJECT/'resume-2026-10-03-continuation001'
OWN=WORK/'guard006-bound-late-checker-prep001'
G=WORK/'consumer005-guard006-runtime-prep001'
M=WORK/'metadata3-producer-core-prep001'
SELF=OWN/'compose-root-review-packet-006.BOUND.py'
BASE=PROJECT/'runtimes/week8-python313-frozen-001/python.exe'
BASE_PIN='5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed'
SCOPE='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
# This exact model is selected/reviewed before the actual capture timer. It is
# not supplied by approval bodies or a mutable packet. None refuses entry.
FRESH_SOURCE_MODEL=None
MODEL_KEYS=('fixed19','source_roles','source_approval_models','core_roles','whole_auth_path','ack_keys','ack_nominals','whole_acceptance_keys','whole_nominals','core12','core_nominals','root_template','driver_sha256','bound_keys','root_trust_selection')
PACKET_KEYS=('schema_version','record_type','phase','roles','producer_roles','approval_cores')
ROLES=('ack','whole_acceptance','whole_auth','metadata_source_review','metadata_source_binding','metadata_bound_source','metadata_bound_review','metadata_before_review','whole_phase_review','root_writer','root_writer_review','bound_review','root_launcher')
PRODUCERS=('whole_acceptance','metadata_source_review','whole_phase_review','metadata_before_review','root_writer_review')
CORES=('metadata_source_review','metadata_before_review','whole_phase_review','root_writer_review')
FIXED19=('profile','driver','driver_template','observer','observer_template','static','source_peer','source_manifest','owner','root_template','bound_template','late_template','root_writer_before','root_writer','metadata_template','metadata_manifest','metadata_binding_plan','pro3_coord','root_coord')
CORE12=('schema_version','record_type','reviewer','created_utc','verdict','input_sha256','context_sha256','runtime_snapshot_sha256','parent_terminal_sha256','metadata_only','operational_authority_granted','evidence_sha256')
SEEN={}

def require(value,reason):
    if not value:raise ValueError(reason)
def sha(data):return hashlib.sha256(data).hexdigest()
def wire(value):return(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def exact(value,keys,reason):require(type(value)is dict and set(value)==set(keys),reason)
def nominal(value,expected,reason):
    require(type(value)is type(expected),reason+' nominal type')
    if type(expected)is dict:
        exact(value,expected,reason)
        for key in expected:nominal(value[key],expected[key],reason+'.'+key)
    elif type(expected)in(list,tuple):
        require(len(value)==len(expected),reason+' fixed length')
        for item,wanted in zip(value,expected):nominal(item,wanted,reason)
    else:require(value==expected,reason+' literal')
def pin(value):require(type(value)is str and re.fullmatch('[0-9a-f]{64}',value),'external SHA256');return value
def confined(value):
    require(type(value)is str,'nominal source path');p=Path(value)
    require(p.is_absolute()and p.is_relative_to(PROJECT)and '..'not in p.parts and all(':'not in x for x in p.parts[1:]),'confined project path')
    return p
def raw(info):
    value=[getattr(info,key,None)for key in('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
    require(all(type(x)is int for x in value),'exact Windows raw9');return value
def parents(p):
    rows=[]
    for parent in reversed(p.parents):
        s=parent.lstat();require(stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&0x400,'plain ancestors');rows.append((str(parent),s.st_dev,s.st_ino))
    return rows
def read(p,expected=None,maximum=65536):
    p=confined(str(p));require(type(maximum)is int and 0<maximum<=8388608,'bounded metadata reader')
    ancestors=parents(p);a=p.lstat();ar=raw(a)
    require(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&0x400 and 0<=a.st_size<=maximum,'bounded single-link metadata file')
    require(a.st_ctime_ns==a.st_birthtime_ns,'Windows path creation')
    fd=os.open(p,os.O_RDONLY|os.O_BINARY);parts=[];count=0
    try:
        b=os.fstat(fd);br=raw(b)
        require(stat.S_ISREG(b.st_mode)and b.st_nlink==1 and not b.st_file_attributes&0x400,'owned read handle')
        require(all(ar[i]==br[i]for i in(0,1,2,3,6,7,8)),'cross API identity')
        if ar[5]!=br[5]:require(p==BASE and expected==BASE_PIN and a.st_size==105816 and ar[5]&0o111==0o111 and br[5]&0o111==0 and ar[5]&~0o111==br[5],'exact BASE executable mode projection')
        while True:
            part=os.read(fd,min(1048576,maximum+1-count))
            if not part:break
            count+=len(part);require(count<=maximum,'read cap');parts.append(part)
        require(raw(os.fstat(fd))==br,'descriptor raw9 stable')
    finally:os.close(fd)
    require(raw(p.lstat())==ar and parents(p)==ancestors,'path/raw9/ancestor stable')
    data=b''.join(parts);require(len(data)==a.st_size and(expected is None or sha(data)==pin(expected)),'size/SHA pin')
    observation={'sha256':sha(data),'bytes':len(data),'path_raw9':ar,'descriptor_raw9':br}
    require(str(p)not in SEEN or SEEN[str(p)]==observation,'input reobserved unchanged');SEEN[str(p)]=observation
    return data
def unique(rows):
    out={}
    for key,value in rows:require(key not in out,'duplicate JSON key');out[key]=value
    return out
def reject_number(unused):raise ValueError('float/nonfinite metadata forbidden')
def decode(data):return json.loads(data.decode('utf-8','strict'),object_pairs_hook=unique,parse_float=reject_number,parse_constant=reject_number)
def record(p,expected,maximum=65536):return decode(read(p,expected,maximum))
def pointer(row):exact(row,('path','sha256'),'closed pointer2');return confined(row['path']),pin(row['sha256'])
def absent(p):
    parents(p)
    try:p.lstat()
    except FileNotFoundError:return
    raise ValueError('create-once metadata path already exists')
def publish_once(p,value):
    data=wire(value);require(len(data)<=65536,'finite packet output');absent(p)
    fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_BINARY,0o600)
    with os.fdopen(fd,'wb')as f:f.write(data);f.flush();os.fsync(f.fileno())
    nominal(read(p,sha(data)),data,'full packet readback')
    return {'path':str(p),'sha256':sha(data)}
def atomic_ready(p,value):
    # Windows rename refuses an existing destination. The owned temporary is
    # preserved on refusal; no replacement, removal, replay or cleanup occurs.
    require(os.name=='nt','Windows create-once rename semantics')
    absent(p);temporary=p.with_name(p.name+'.publishing');row=publish_once(temporary,value)
    absent(p);os.rename(temporary,p);read(p,row['sha256'])
    return {'path':str(p),'sha256':row['sha256']}
def genuine_ticks(value,width):
    require(type(value)is str and re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{'+str(width)+r'}\+00:00',value),'genuine producer timestamp')
    base=dt.datetime.strptime(value[:19],'%Y-%m-%dT%H:%M:%S').replace(tzinfo=dt.timezone.utc);d=base-dt.datetime(1970,1,1,tzinfo=dt.timezone.utc)
    return(d.days*86400+d.seconds)*10000000+int(value[20:20+width])*(10 if width==6 else 1)
def fresh(value,width,seconds):
    now=genuine_ticks(dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),6);age=now-genuine_ticks(value,width)
    require(0<=age<=seconds*10000000,'original freshness');return now

def main():
    parser=argparse.ArgumentParser()
    for name in('expected-self-sha256','phase','ack-sha256','whole-acceptance-sha256','whole-auth-sha256','metadata-core-sha256','whole-core-sha256'):
        parser.add_argument('--'+name,required=True)
    parser.add_argument('--bound-review-sha256');parser.add_argument('--root-launcher-sha256')
    args=parser.parse_args()
    require(os.name=='nt'and sys.version_info[:3]==(3,13,5)and sys.flags.isolated==1 and sys.flags.no_site==1 and sys.flags.dont_write_bytecode==1 and sys.flags.utf8_mode==1 and sys.flags.optimize==0,'Root direct isolated own metadata process')
    nominal(Path(sys.executable).absolute(),BASE,'direct BASE');read(BASE,BASE_PIN,105816)
    nominal(Path(__file__).absolute(),SELF,'bound Root own producer');read(SELF,pin(args.expected_self_sha256),131072)
    exact(FRESH_SOURCE_MODEL,MODEL_KEYS,'unbound fresh source model')
    require(args.phase in('bound','late'),'closed phase')
    exact(FRESH_SOURCE_MODEL['fixed19'],FIXED19,'fresh nineteen Source roles')
    nominal(FRESH_SOURCE_MODEL['core12'],list(CORE12),'unaltered Core12 protocol')
    for row in FRESH_SOURCE_MODEL['fixed19'].values():
        exact(row,('path','sha256','maximum'),'fixed Source row3')
        read(confined(row['path']),pin(row['sha256']),row['maximum'])
    trust=FRESH_SOURCE_MODEL['root_trust_selection'];record(*pointer(trust))
    roles=dict(FRESH_SOURCE_MODEL['source_roles'])
    roles.update(ack={'path':str(G/'ROOT_EXECUTION_ACK_GUARD_UNIT006.json'),'sha256':pin(args.ack_sha256)},whole_acceptance={'path':str(G/'INDEPENDENT_WHOLE_BEFORE_ACCEPTANCE_006.json'),'sha256':pin(args.whole_acceptance_sha256)},whole_auth={'path':FRESH_SOURCE_MODEL['whole_auth_path'],'sha256':pin(args.whole_auth_sha256)},metadata_before_review={'path':FRESH_SOURCE_MODEL['core_roles']['metadata_before_review'],'sha256':pin(args.metadata_core_sha256)},whole_phase_review={'path':FRESH_SOURCE_MODEL['core_roles']['whole_phase_review'],'sha256':pin(args.whole_core_sha256)},bound_review=None,root_launcher=None)
    exact(roles,ROLES,'fresh fixed roles13')
    ack=record(*pointer(roles['ack']));exact(ack,FRESH_SOURCE_MODEL['ack_keys'],'ACK22');require(len(ack)==22,'ACK22 count')
    for key,value in FRESH_SOURCE_MODEL['ack_nominals'].items():nominal(ack[key],value,'actual ACK nominal')
    context,runtime=pointer(ack['runtime_snapshot']);rt=record(context,runtime)
    fresh(rt['captured_utc'],6,90);cp,cs=pointer(rt['context_selection']);ctx=record(cp,cs,1048576);now=fresh(ctx['captured_utc'],6,90)
    require(now+5100000000<=genuine_ticks(ack['expires_utc'],7),'ACK510 reserve')
    rp,rs=pointer(ack['resource_snapshot']);res=record(rp,rs);fresh(res['captured_utc'],7,60)
    require(type(res['free_ram_bytes'])is int and res['free_ram_bytes']>=1073741824 and type(res['disk_free_bytes'])is int and res['disk_free_bytes']>=10737418240,'resource floor snapshot')
    whole=record(*pointer(roles['whole_acceptance']));exact(whole,FRESH_SOURCE_MODEL['whole_acceptance_keys'],'whole acceptance7')
    for key,value in FRESH_SOURCE_MODEL['whole_nominals'].items():nominal(whole[key],value,'different whole acceptance')
    nominal(whole['runtime_snapshot_sha256'],runtime,'whole original runtime')
    approvals={}
    for role in CORES:
        approval=record(*pointer(roles[role]),maximum=2097152)
        if role in('metadata_source_review','root_writer_review'):
            model=FRESH_SOURCE_MODEL['source_approval_models'][role]
            exact(approval,model['keys'],'source approval closed schema')
            for key,value in model['values'].items():nominal(approval[key],value,'source-bound approval field')
            approvals[role]=model
        else:
            exact(approval,CORE12,'actual Core12')
            for key,value in FRESH_SOURCE_MODEL['core_nominals'][role].items():nominal(approval[key],value,'actual independent metadata decision')
            nominal(approval['runtime_snapshot_sha256'],runtime,'core actual runtime');nominal(approval['context_sha256'],cs,'core actual original context')
            require(approval['reviewer']=='/root/actual_record_checker'and approval['metadata_only']is True and approval['operational_authority_granted']is False,'different genuine metadata scope')
            # The independent retained BOUND/LATE checker will fully reobserve
            # Core/detail/input/parent/Source closure. Root merely creates this
            # closed packet; it does not approve metadata or waive those checks.
            approvals[role]={'keys':list(FRESH_SOURCE_MODEL['core12']),'values':approval}
    packet={'schema_version':1,'record_type':'root_selected_gg6_actual_record_review_001','phase':args.phase,'roles':roles,'producer_roles':{role:'python6'for role in PRODUCERS},'approval_cores':approvals}
    if args.phase=='late':
        roles['bound_review']={'path':str(G/'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json'),'sha256':pin(args.bound_review_sha256)}
        template_path,template_pin=pointer(FRESH_SOURCE_MODEL['root_template'])
        require(template_path.parent==G and template_path.name.startswith('ROOT_FIRST_LAUNCH_006-rev')and template_path.name.endswith('.TEMPLATE.ps1'),'selected fresh Root launcher template')
        roles['root_launcher']={'path':str(template_path.with_name(template_path.name.replace('.TEMPLATE.ps1','.BOUND.ps1'))),'sha256':pin(args.root_launcher_sha256)}
        bound=record(*pointer(roles['bound_review']));exact(bound,FRESH_SOURCE_MODEL['bound_keys'],'BOUND22')
        nominal(bound['root_ack_sha256'],args.ack_sha256,'bound ACK');nominal(bound['reviewer'],'/root/pubnative_review','different bound reviewer')
        launch=read(*pointer(roles['root_launcher'])).decode('utf-8','strict')
        for name,value in(('BoundDriverSha256',FRESH_SOURCE_MODEL['driver_sha256']),('RootAckSha256',args.ack_sha256),('BoundReviewSha256',args.bound_review_sha256)):
            pattern=r"(?m)^\$"+name+r" = '[0-9a-f]{64}'\r?$";rows=re.findall(pattern,launch)
            require(len(rows)==1 and rows[0].rstrip('\r')=="$"+name+" = '"+value+"'",'Root three-literal exact binding')
            launch=re.sub(pattern,lambda match,n=name:'$'+n+' = $null'+('\r'if match.group().endswith('\r')else''),launch)
        nominal(launch.encode(),read(template_path,template_pin),'Root three-literal reversal')
    for p,observed in list(SEEN.items()):read(Path(p),observed['sha256'],max(1,observed['bytes']))
    fresh(rt['captured_utc'],6,90);fresh(ctx['captured_utc'],6,90);fresh(res['captured_utc'],7,60)
    phase=args.phase.upper();output=OWN/('ROOT_SELECTED_'+phase+'_PACKET_006.json');row=publish_once(output,packet)
    marker=atomic_ready(OWN/('ROOT_SELECTED_'+phase+'_PACKET_READY_006.json'),{'schema_version':1,'record_type':'root_guard006_packet_ready','author':'/root','phase':args.phase,'packet':row,'target_execution':False})
    print(json.dumps({'packet':row,'ready':marker,'target_execution':False,'operational_authority':False},sort_keys=True))

if __name__=='__main__':main()
