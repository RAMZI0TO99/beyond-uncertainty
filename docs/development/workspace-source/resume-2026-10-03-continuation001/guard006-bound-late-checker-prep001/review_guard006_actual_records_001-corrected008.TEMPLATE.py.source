  require(type(row["bytes"]) is int and 0 < row["bytes"] <= profile["whole_before_evidence_max_bytes"], "whole finite row cap")
  read(expected_path, row["sha256"], profile["whole_before_evidence_max_bytes"])
 auth = record(*roles["whole_auth"])
 exact(auth, ("schema_version", "record_type", "author", "scope", "phase", "created_utc", "expires_utc", "observer_sha256", "profile_sha256", "static_review_sha256", "owner_sha256", "runtime_snapshot", "context_selection", "before_record_sha256", "unit_receipt"), "whole auth15")
 for key, expected in (("schema_version", 1), ("record_type", "consumer_guard_unit006_metadata_observation_authorization"), ("author", "/root"), ("scope", SCOPE), ("phase", "before"), ("observer_sha256", OBSERVER_PIN), ("profile_sha256", PROFILE_PIN), ("static_review_sha256", STATIC_PIN), ("owner_sha256", OWNER_PIN), ("before_record_sha256", None), ("unit_receipt", None)):
  nominal(auth[key], expected, "before auth field")
 nominal(pointer(auth["runtime_snapshot"]), (runtime_path, runtime_pin), "auth/runtime")
 nominal(auth["context_selection"], runtime["context_selection"], "auth/context")
 auth_start, auth_end = ticks(auth["created_utc"], "powershell7"), ticks(auth["expires_utc"], "powershell7")
 result_time = ticks(whole_result["captured_utc"], "python6")
 require(auth_start <= result_time <= auth_end <= LEASE_END_TICKS, "actual metadata completion within authorized producer clock interval")
 record_data = decode(fixed["bound_template"])
 record_data.update(common)
 record_data["driver_template_sha256"]=TEMPLATE_PIN
 for key,value in {"schema_version":1,"record_type":"consumer_guard_unit006_bound_review","scope":SCOPE,"author":AUTHOR,"max_collection_seconds":60,"max_test_seconds":300}.items():nominal(record_data[key],value,"BOUND unchanged nominal grammar")
 record_data.update({"verdict": "PASS_BOUND_STATIC", "reviewer": REVIEWER, "root_ack_sha256": ack_pin, "runtime_snapshot_sha256": runtime_pin, "whole_runtime_before_sha256": whole_pin, "resource_snapshot_sha256": resource_pin, "coordination_ack_sha256": coord_pin})
 output = PREP / "INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json"
 if phase == "late":
  bound_path, bound_pin = roles["bound_review"]
  nominal(bound_path, output, "actual bound22 path")
  nominal(record(bound_path, bound_pin), record_data, "actual bound22 from same inputs")
  launch_path, launch_pin = roles["root_launcher"]
  root_template_path=FIXED["root_template"][0]
  require(root_template_path.parent==PREP and root_template_path.name.startswith("ROOT_FIRST_LAUNCH_006-rev")and root_template_path.name.endswith(".TEMPLATE.ps1"),"selected fresh Root PS template")
  nominal(launch_path,root_template_path.with_name(root_template_path.name.replace(".TEMPLATE.ps1",".BOUND.ps1")),"actual Root PS path from selected source pool")
  launch = read(launch_path, launch_pin, 65536)[0].decode("utf8")
  for name, expected in (("BoundDriverSha256", DRIVER_PIN), ("RootAckSha256", ack_pin), ("BoundReviewSha256", bound_pin)):
   pattern = "(?m)^\\$" + name + " = '[0-9a-f]{64}'\\r?$"
   matches = re.findall(pattern, launch)
   require(len(matches) == 1 and matches[0].rstrip("\r") == "$" + name + " = '" + expected + "'", "RootPS exact3 binding")
   launch = re.sub(pattern, lambda match, n=name: "$" + n + " = $null"+("\r"if match.group().endswith("\r")else""), launch)
  nominal(launch.encode("utf8"), fixed["root_template"], "RootPS three-literal byte reversal")
  record_data = decode(fixed["late_template"])
  nominal(record_data["profile_sha256"],None,"late template has no actual source pin")
  record_data["profile_sha256"]=PROFILE_PIN
  for key,value in {"schema_version":1,"record_type":"consumer_guard_unit006_root_launch_late_review","scope":SCOPE,"author":AUTHOR,"profile_sha256":PROFILE_PIN,"target_execution":False}.items():nominal(record_data[key],value,"LATE unchanged nominal grammar")
  # This new reviewer deadline cannot extend or rewrite the existing ACK.
  # Use integer arithmetic, preserving the distinct genuine producer roles.
  review_now = dt.datetime.now(dt.timezone.utc)
  ack_floor = dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc) + dt.timedelta(microseconds=expires // 10)
  review_expiry = min(review_now + dt.timedelta(minutes=15), ack_floor)
  require(review_expiry - review_now >= dt.timedelta(seconds=510), "late review450s reserve")
  record_data.update({"verdict": "PASS_LATE_BOUND_ONLY", "reviewer": REVIEWER, "root_ack_sha256": ack_pin, "driver_sha256": DRIVER_PIN, "bound_review_sha256": bound_pin, "launch_sha256": launch_pin, "created_utc": review_now.isoformat(timespec="microseconds"), "expires_utc": review_expiry.isoformat(timespec="microseconds")})
  output = PREP / "INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_006.json"
 require(len(record_data) == (22 if phase == "bound" else 14), "closed output key count")
 absent(output)
 proof_path = OWN / ("ACTUAL_" + phase.upper() + "_REVIEW_OBSERVATION_001.json")
 absent(proof_path)
 for p, observed in list(observations.items()):
  read(path(p), observed["sha256"], observed["bytes"])
 final_whole_reobserve()
 check_runtime(runtime, profile)
 fresh(resource["captured_utc"], "powershell7", 60)
 require(now_ticks() + 5100000000 <= expires, "final owner/ACK reserve")
 for name in ("ROOT_LAUNCH_START_006.json", "ROOT_LAUNCH_TERMINAL_006.json", "ROOT_LAUNCH_STDOUT_006.txt", "ROOT_LAUNCH_STDERR_006.txt"):
  absent(PREP / name)
 absent(PROJECT / ".tmp/cg24-006")
 proof = {"schema_version": 1, "record_type": "gg6_actual_" + phase + "_review_observation", "reviewer": REVIEWER, "captured_utc": dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"), "selection_sha256": args.selection_sha256, "utility_sha256": args.expected_self_sha256, "unique_input_count": len(observations), "input_byte_raw9_digest": sha(canonical(observations)), "current_tracked_rows": 742, "configuration_rows": 55, "runtime_files": 4, "whole_tree_inventory_performed_by_this_utility": False, "two_tree_before_proof_accepted_by_different_reviewer": True, "target_execution": False, "input_resource_age_seconds_limit": 60, "context_age_seconds_limit": 90, "future_root_fresh_prelaunch_checks_required": True, "canonical_native_fullQA_lease_quiet_or_science_authority": False, "no_deadline_refresh_or_clock_reissue": True, "pro3_request_HELD_no_delivery_ACK_or_native_lease": True}
 proof_row = publish_once(proof_path, proof, 65536)
 output_row = publish_once(output, record_data, 65536)
 print(json.dumps({"review": output_row, "observation": proof_row, "scope": SCOPE, "target_execution": False}, sort_keys=True))



def retained_waiter():
 import time
 parser=argparse.ArgumentParser()
 parser.add_argument("--expected-self-sha256",required=True)
 parser.add_argument("--retained-deadline-utc",required=True)
 args=parser.parse_args()
 require(os.name=="nt"and sys.version_info[:3]==(3,13,5)and sys.flags.isolated==1 and sys.flags.no_site==1 and sys.flags.dont_write_bytecode==1 and sys.flags.utf8_mode==1 and sys.flags.optimize==0,"retained own direct isolated reviewer")
 nominal(Path(sys.executable).absolute(),BASE_PYTHON,"retained direct base interpreter")
 read(BASE_PYTHON,"5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed",105816)
 nominal(Path(__file__).absolute(),SELF,"retained bound own source")
 read(SELF,hexpin(args.expected_self_sha256),131072);bind_source_pool()
 fixed={role:read(p,pin,maximum)[0]for role,(p,pin,maximum)in FIXED.items()}
 profile=decode(fixed["profile"]);nominal(profile["scope"],SCOPE,"pre-timer profile scope")
 source_inputs(profile,fixed)
 source_roles=SOURCE_PROTOCOL["packet_source_roles"]
 exact(source_roles,("metadata_source_review","metadata_source_binding","metadata_bound_source","metadata_bound_review","root_writer","root_writer_review"),"pre-timer six immutable source roles")
 metadata_source_closure(None,{role:pointer(row)for role,row in source_roles.items()},fixed)
 root_writer_source(fixed)
 # Source readiness checks do not read or fabricate any future metadata
 # capture/Core/ACK/BOUND/LATE or target result. The closed Source pool and
 # source peers must exist before the original capture timer can start.
 end=ticks(args.retained_deadline_utc,"powershell7")
 require(now_ticks()<end<=LEASE_END_TICKS and end-now_ticks()<=3600*10000000,"retained own bounded poll deadline")
 publish_once(OWN/"BOUND_LATE_CHECKER_READY_006.json",{"schema_version":1,"record_type":"guard006_bound_late_checker_ready","reviewer":REVIEWER,"pid":os.getpid(),"created_utc":dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"),"utility_sha256":args.expected_self_sha256,"lease_sha256":OWNER_PIN,"root_trust_selection_sha256":hexpin(SOURCE_BINDINGS["root_trust_selection_sha256"]),"target_execution":False},65536)
 for phase in ("bound","late"):
  trigger=OWN/("ROOT_SELECTED_"+phase.upper()+"_PACKET_READY_006.json")
  while True:
   require(now_ticks()<end,"retained checker poll expired")
   try:
    trigger.lstat();break
   except FileNotFoundError:time.sleep(.05)
  marker=record(trigger,None,65536)
  exact(marker,("schema_version","record_type","author","phase","packet","target_execution"),"Root packet-ready6")
  for key,value in {"schema_version":1,"record_type":"root_guard006_packet_ready","author":"/root","phase":phase,"target_execution":False}.items():nominal(marker[key],value,"genuine Root packet handoff")
  packet,pin=pointer(marker["packet"])
  nominal(packet,OWN/("ROOT_SELECTED_"+phase.upper()+"_PACKET_006.json"),"fixed retained packet path")
  global observations
  observations={}
  WHOLE_FILE_ROWS.clear();WHOLE_DIRECTORY_ROWS.clear()
  oldargs=sys.argv
  try:
   sys.argv=[str(SELF),"--expected-self-sha256",args.expected_self_sha256,"--selection",str(packet),"--selection-sha256",pin]
   main()
  finally:sys.argv=oldargs
  publish_once(OWN/(phase.upper()+"_DECISION_READY_006.json"),{"schema_version":1,"record_type":"guard006_actual_decision_ready","reviewer":REVIEWER,"phase":phase,"created_utc":dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"),"target_execution":False},65536)

if __name__=="__main__":
 retained_waiter()
