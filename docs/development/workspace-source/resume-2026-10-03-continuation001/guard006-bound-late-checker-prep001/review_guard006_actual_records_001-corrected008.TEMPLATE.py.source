def physical_provenance(detail,approval,evidence,actual):
 trace=detail["execution_owner_trace"];root=WORK/"root-guard006-pipeline-prep001"
 source=SOURCE_PROTOCOL["root_pipeline_source"];exact(source,("path","sha256","maximum"),"pipeline source row3")
 nominal(path(source["path"]),root/"RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1","fixed Root pipeline")
 nominal(trace["pipeline_source_sha256"],hexpin(source["sha256"]),"physical pipeline selected source")
 read(path(source["path"]),source["sha256"],source["maximum"])
 peer_row=SOURCE_PROTOCOL["root_pipeline_peer"]
 exact(peer_row,("path","sha256","maximum","keys","values"),"pipeline peer closed source model")
 peer=record(path(peer_row["path"]),hexpin(peer_row["sha256"]),peer_row["maximum"])
 exact(peer,peer_row["keys"],"pipeline full Source peer")
 for key,value in peer_row["values"].items():nominal(peer[key],value,"pipeline different source review")
 for key,value in {"reviewer":"/root/owner_docs_review","source_author":"/root","pipeline_source_sha256":source["sha256"],"verdict":"PASS_STATIC_ROOT_PIPELINE_SOURCE_ONLY"}.items():nominal(peer[key],value,"pipeline source nominal")
 trust=record(root/"ROOT_PIPELINE_TRUST_SELECTION_002.json",SOURCE_BINDINGS["root_trust_selection_sha256"])
 exact(trust,("schema_version","record_type","author","scope","pipeline_source_sha256","pipeline_source_peer_sha256","init_trace","physical_root_tool_chunk"),"external Root trust8")
 for key,value in {"schema_version":1,"record_type":"root_pipeline_trust_selection","author":"/root","scope":SCOPE,"pipeline_source_sha256":source["sha256"],"pipeline_source_peer_sha256":peer_row["sha256"],"physical_root_tool_chunk":trace["root_reported_tool_chunk"]}.items():nominal(trust[key],value,"Root trust selected nominal")
 ip,ih=pointer(trust["init_trace"]);nominal(ip,root/"ROOT_PIPELINE_INIT_TRACE_002.json","Root fixed init path")
 nominal(ih,trace["init_trace_sha256"],"Root trace binds init")
 init=record(ip,ih);exact(init,("schema_version","record_type","author","scope","created_utc","pid","nonce","pipeline_source_sha256"),"Root init8")
 for key,value in {"schema_version":1,"record_type":"root_pipeline_init_trace","author":"/root","scope":SCOPE,"pid":trace["root_launch_pid"],"nonce":trace["root_launch_nonce"],"pipeline_source_sha256":source["sha256"]}.items():nominal(init[key],value,"physical Root identity linked")
 role=detail["role"]
 phase=record(root/("ROOT_PIPELINE_PHASE_TRACE_"+role.upper()+"_006.json"),trace["phase_trace_sha256"])
 exact(phase,("schema_version","record_type","author","scope","phase","created_utc","pipeline_source_sha256","init_trace_sha256","argv","outputs"),"Root phase10")
 for key,value in {"schema_version":1,"record_type":"root_pipeline_phase_trace","author":"/root","scope":SCOPE,"phase":role,"pipeline_source_sha256":source["sha256"],"init_trace_sha256":ih}.items():nominal(phase[key],value,"Root phase provenance")
 require(ticks(init["created_utc"],"powershell7")<=ticks(phase["created_utc"],"powershell7")<=now_ticks(),"Root init/phase chronology")
 require(type(detail["observations"])is list and 1<=len(detail["observations"])<=4096,"finite genuine detail observations")
 observed=[row for row in detail["observations"] if type(row)is dict and row.get("path")==evidence["ticket_path"]]
 require(len(observed)==1,"single cryptobound checker ticket observation")
 ticket=record(path(evidence["ticket_path"]),hexpin(observed[0]["sha256"]));exact(ticket,TICKET22,"Root checker ticket22")
 for key,value in {"schema_version":1,"record_type":"root_metadata_checker_input_ticket","author":"/root","scope":SCOPE,"role":role,"path":evidence["input_path"],"sha256":approval["input_sha256"],"runtime_sha256":approval["runtime_snapshot_sha256"],"context_sha256":approval["context_sha256"],"terminal_path":evidence["parent_path"],"terminal_sha256":approval["parent_terminal_sha256"],"phase_trace_sha256":trace["phase_trace_sha256"],"root_trust_sha256":SOURCE_BINDINGS["root_trust_selection_sha256"]}.items():nominal(ticket[key],value,"ticket actual selected input")
 templates=peer["phase_argv_templates"];exact(templates,PHASE8,"eight closed source-reviewed phase argv templates")
 tokens=templates[role];require(type(tokens)is list and 1<=len(tokens)<=64,"finite reviewed argv")
 bindings=evidence["argv_bindings"]
 exact(bindings,("metadata_script_sha256","metadata_bound_review_sha256","observer_sha256","profile_sha256","harness_static_review_sha256","owner_lease_sha256"),"six immutable argv source pins")
 for value in bindings.values():hexpin(value)
 nominal(bindings["owner_lease_sha256"],OWNER_PIN,"argv finite lease")
 nominal(bindings["observer_sha256"],OBSERVER_PIN,"argv observer")
 nominal(bindings["profile_sha256"],PROFILE_PIN,"argv profile")
 nominal(bindings["harness_static_review_sha256"],STATIC_PIN,"argv static peer")
 substitutions={key:value for key,value in ticket.items() if type(value)is str};substitutions.update(bindings);expected=[]
 for token in tokens:
  require(type(token)is str and len(token)<=4096,"argv token bound")
  if re.fullmatch(r"\{[a-z_]+\}",token):
   name=token[1:-1];require(name in substitutions,"closed source substitution");token=substitutions[name]
  require("{"not in token and "}"not in token,"no arbitrary argv interpolation");expected.append(token)
 nominal(phase["argv"],expected,"actual Root argv matches reviewed source")
 outputs={evidence["input_path"]:approval["input_sha256"],evidence["parent_path"]:approval["parent_terminal_sha256"]}
 if role=="capture_before":
  for key in ("context","runtime_selection"):
   p,h=pointer(actual[key]);outputs[str(p)]=h
 require(type(phase["outputs"])is list and len(phase["outputs"])==len(outputs)<=12,"exact finite phase outputs")
 seen=set()
 for row in phase["outputs"]:
  p,h=pointer(row);name=str(p);require(name in outputs and name not in seen,"compiled actual output path")
  nominal(h,outputs[name],"compiled actual output pin");seen.add(name)
 return ticket

def bind_source_pool():
 global FIXED,OWNER_END,OWNER_PIN,PROFILE_PIN,DRIVER_PIN,OBSERVER_PIN,STATIC_PIN,SOURCE_PIN,TEMPLATE_PIN,SOURCE_MANIFEST_PIN
 exact(SOURCE_BINDINGS,SOURCE_BINDING_KEYS,"unbound fresh source pool")
 exact(SOURCE_PROTOCOL,SOURCE_PROTOCOL_KEYS,"unbound fresh strict Source protocol")
 nominal(SOURCE_PROTOCOL["core12"],list(CORE12),"unaltered Core12 protocol")
 exact(SOURCE_BINDINGS["fixed19"],FIXED_ROLES,"fresh fixed nineteen roles")
 FIXED={}
 for role,row in SOURCE_BINDINGS["fixed19"].items():
  exact(row,("path","sha256","maximum"),"fixed source row3")
  require(type(row["maximum"])is int and 0<row["maximum"]<=8388608,"fixed source cap")
  FIXED[role]=(path(row["path"]),hexpin(row["sha256"]),row["maximum"])
 exact(SOURCE_BINDINGS["source_pin_values"],("profile","driver","observer","static","source_peer","driver_template","source_manifest"),"seven source constants")
 for role,pin in SOURCE_BINDINGS["source_pin_values"].items():
  nominal(pin,FIXED[role][1],"source pool constant agrees")
 PROFILE_PIN=FIXED["profile"][1];DRIVER_PIN=FIXED["driver"][1];OBSERVER_PIN=FIXED["observer"][1]
 STATIC_PIN=FIXED["static"][1];SOURCE_PIN=FIXED["source_peer"][1];TEMPLATE_PIN=FIXED["driver_template"][1];SOURCE_MANIFEST_PIN=FIXED["source_manifest"][1]
 OWNER_PIN=hexpin(SOURCE_BINDINGS["lease_sha256"])
 nominal(FIXED["owner"][:2],(LEASE_PATH,OWNER_PIN),"fixed lease role")
 end=ticks(SOURCE_BINDINGS["lease_end_utc"],"powershell7")
 OWNER_END=dt.datetime(1970,1,1,tzinfo=dt.timezone.utc)+dt.timedelta(microseconds=end//10)
 # Preserve PS7 tick precision separately. The floor above is not authority.
 global LEASE_END_TICKS
 LEASE_END_TICKS=end
 require(type(SOURCE_BINDINGS["extra_inputs"])is dict,"explicit extra source roles")
 for row in SOURCE_BINDINGS["extra_inputs"].values():
  exact(row,("path","sha256","maximum"),"explicit extra source row3")
  read(path(row["path"]),hexpin(row["sha256"]),row["maximum"])
 lease_guard()

def lease_guard():
 master=record(MASTER_PATH,MASTER_PIN,65536)
 exact(master,MASTER_KEYS,"pinned ongoing master27")
 for key,value in {"schema_version":1,"record_type":"owner_ongoing_local_private_continuation","authority":"owner","owner_directive":"ok then keep working on the project and do not stop unless if there is something that stops you.","decision":"resume_project_work_beyond_prior_deadline","fixed_deadline_invented":False,"successor_bindings_at_creation":None,"historical_records_preserved":True}.items():nominal(master[key],value,"ongoing owner nominal")
 for key in ("original_guards_changed","public_actions_authorized","one_use_replay_authorized","frozen_scientific_changes_authorized","additional_recovery_epochs_authorized","unrelated_process_stops_authorized","sole_executor_transfer_asserted","resource_lease_asserted","native_quiet_asserted"):nominal(master[key],False,"retained owner guard")
 nominal(master["authorization_mode"],"ongoing_until_completion_owner_stop_or_actual_blocker","ongoing owner")
 nominal(master["work_end_utc"],None,"no fabricated owner end")
 peer=record(MASTER_PEER_PATH,MASTER_PEER_PIN,1048576)
 exact(peer,MASTER_PEER_KEYS,"pinned owner peer19")
 # This immutable historical owner peer uses its recorded bare name. New
 # GG6 actors use canonical /root/... names; do not rewrite ancestor bytes.
 for key,value in {"schema_version":1,"record_type":"independent_owner_continuation_directive_and_lineage_review","reviewer":"owner_docs_review","verdict":"PASS_OWNER_DIRECTIVE_AND_LINEAGE_SOURCE_ONLY","source_owner_sha256":MASTER_PIN,"owner_end_utc":None,"directive_matches_user_verbatim":True,"old_artifacts_renewed":False,"ongoing_authority_supersedes_old_deadline":True,"operational_authorization_or_execution_acceptance":False,"source_choice_implementation_or_runtime_acceptance":False}.items():nominal(peer[key],value,"pinned owner source acceptance")
 lease=record(LEASE_PATH,OWNER_PIN,65536);exact(lease,LEASE_KEYS,"closed lease12")
 for key,value in {"schema_version":1,"record_type":"root_local_private_execution_lease","author":"/root","scope":SCOPE,"owner_master_sha256":MASTER_PIN,"owner_review_sha256":MASTER_PEER_PIN,"decision":"authorize_bounded_selected_unit_metadata_and_copied_tests_once","maximum_lease_seconds":43200,"lease_is_owner_deadline":False,"operational_authority":False}.items():
  nominal(lease[key],value,"finite lease nominal")
 start=ticks(lease["created_utc"],"powershell7");end=ticks(lease["lease_end_utc"],"powershell7")
 nominal(end,LEASE_END_TICKS,"exact bound lease end")
 require(ticks(master["record_created_utc"],"powershell7")<=start<=now_ticks() and 0<end-start<=43200*10000000 and now_ticks()+5100000000<=end,"bounded lease510 reserve")
 return end

def capsule_shape(value,spec):
 require(type(spec)is dict and type(spec.get("kind"))is str,"closed capsule node")
 kind=spec["kind"]
 if kind=="exact_builtin_dict":
  exact(value,spec["closed_keys"],"capsule nested closed keys")
  for key in spec["closed_keys"]:capsule_shape(value[key],spec["fields"][key])
 elif kind=="exact_builtin_list":
  require(type(value)is list and len(value)==spec["length"] and len(spec["items"])==len(value),"capsule list domain")
  for item,shape in zip(value,spec["items"]):capsule_shape(item,shape)
 elif kind in ("exact_builtin_str","exact_builtin_int_not_bool","exact_builtin_bool","None"):
  nominal(value,spec["value"],"capsule pinned scalar")
 else:raise ValueError("capsule unknown nominal shape")

def machine_core(approval,role):
 exact(approval,CORE12,"machine closed Core12")
 for key,value in {"schema_version":1,"reviewer":"/root/actual_record_checker","metadata_only":True,"operational_authority_granted":False}.items():nominal(approval[key],value,"different actual metadata reviewer")
 nominal(approval["record_type"],SOURCE_PROTOCOL["detail15"][role]["core_type"],"actual core type")
 nominal(approval["verdict"],SOURCE_PROTOCOL["detail15"][role]["core_verdict"],"actual core verdict")
 evidence=SOURCE_PROTOCOL["detail15"][role]
 detail=record(path(evidence["path"]),hexpin(approval["evidence_sha256"]),2097152)
 exact(detail,DETAIL15,"cryptobound detail15")
 nominal(detail["schema_version"],1,"detail schema")
 nominal(detail["record_type"],"guard006_actual_metadata_checker_detail","detail role")
 nominal(detail["reviewer"],"/root/actual_record_checker","different detail reviewer")
 nominal(detail["role"],{"metadata_before_review":"capture_before","whole_phase_review":"whole_before_result"}[role],"exact before detail phase")
 for key,value in evidence["nominals"].items():nominal(detail[key],value,"bound evidence nominal")
 nominal(detail["checker_source_sha256"],SOURCE_PROTOCOL["checker_source"]["sha256"],"genuine checker source")
 nominal(detail["checker_source_peer_sha256"],SOURCE_PROTOCOL["checker_peer"]["sha256"],"different checker source review")
 nominal(detail["checker_binding_sha256"],SOURCE_PROTOCOL["checker_binding"]["sha256"],"checker exact binding")
 nominal(detail["target_execution"],False,"metadata does not execute unit")
 nominal(detail["action_authorization"],False,"metadata does not authorize action")
 for key in ("source_closure","phase_sources"):
  nominal(detail[key],evidence[key],"actual evidence exact source closure")
 trace=detail["execution_owner_trace"]
 exact(trace,TRACE13,"closed actual physical producer trace")
 nominal(trace["root_trust_selection_sha256"],hexpin(SOURCE_BINDINGS["root_trust_selection_sha256"]),"externally authenticated Root trust selection")
 for key,value in evidence["trace_nominals"].items():nominal(trace[key],value,"pinned producer source trace")
 # Dynamic physical tool/process identities are typed, not guessed or treated
 # as a caller PASS. Genuine owning-tool evidence remains independently
 # reconciled by Root before its final separate test GO.
 for key in ("root_launch_pid","checker_pid"):
  require(type(trace[key])is int and trace[key]>0,"actual producer process identity")
 for key in ("root_reported_tool_chunk","root_launch_nonce","checker_launch_nonce"):
  require(type(trace[key])is str and 0<len(trace[key])<=1024,"actual producer tool trace text")
 require(re.fullmatch(r"[0-9A-Za-z_-]{1,128}",trace["root_reported_tool_chunk"])is not None,"Root tool chunk domain")
 for key in ("root_launch_nonce","checker_launch_nonce"):
  require(type(trace[key])is str and re.fullmatch('[0-9a-f]{32}',trace[key]),"actual launch nonce")
 for key in ("root_trust_selection_sha256","init_trace_sha256","phase_trace_sha256","pipeline_source_sha256"):
  hexpin(trace[key])
 nominal(trace["reviewer"],"/root/actual_record_checker","trace distinct metadata reviewer")
 nominal(trace["physical_tool_identity_externally_correlated_by_Root"],True,"selected external Root correlation")
 nominal(trace["independent_OS_or_tool_attestation"],False,"no invented OS/tool attestation")
 nominal(trace["hard_Job_or_descendant_or_provider_deadline_proved"],False,"no invented Job/descendant/provider proof")
 input_path=path(evidence["input_path"])
 actual=record(input_path,hexpin(approval["input_sha256"]),evidence["input_maximum"])
 exact(actual,evidence["input_keys"],"closed actual reviewed input")
 for key,value in evidence["input_nominals"].items():nominal(actual[key],value,"actual input scope")
 terminal=record(path(evidence["parent_path"]),hexpin(approval["parent_terminal_sha256"]),65536)
 parent_keys=METADATA_PARENT20 if role=="metadata_before_review" else WHOLE_PARENT30
 exact(terminal,parent_keys,"actual retained parent terminal")
 nominal(list(terminal),list(parent_keys),"PS source parent property order")
 for key,value in {"schema_version":1,"phase":"before","exit_code":0,"timed_out":False,"capture_overflow":False,"capture_drain_complete":True,"direct_child_reaped":True,"failure":None,"stdout_bytes":0,"stderr_bytes":0,"metadata_only":True,"spent":True,"target_tests_executed":False,"operational_authority_granted":False,"descendant_cleanup_guaranteed":False,"OS_Job_hard_memory_bound":False}.items():nominal(terminal[key],value,"actual retained parent status")
 nominal(terminal["supervisor_sha256"],evidence["parent_source_sha256"],"pinned actual parent source")
 if role=="metadata_before_review":
  nominal(terminal["whole_inventory_trees_observed"],0,"metadata parent observes zero trees")
 else:
  for key,value in {"observer_sha256":OBSERVER_PIN,"profile_sha256":PROFILE_PIN,"static_review_sha256":STATIC_PIN,"expected_inventory_trees":2,"expected_runtime_file_guards":4,"whole_inventory_trees_observed":None,"runtime_file_guards_observed":None,"observer_result_reconciled":False,"whole_site_loaded_closure_guaranteed":False,"native_authority_granted":False,"unconditional_physical_IO_deadline_guaranteed":False}.items():nominal(terminal[key],value,"whole parent scope distinction")
 require(ticks(terminal["finished_utc"],"powershell7")>=ticks(actual["captured_utc"],"python6"),"parent finishes after helper publication")
 for key in ("stdout_bytes","stderr_bytes"):
  read(path(evidence[key+"_path"]),sha(b""),65536)
 for key in ("input_sha256","context_sha256","runtime_snapshot_sha256","parent_terminal_sha256","evidence_sha256"):
  hexpin(approval[key])
 ticks(approval["created_utc"],"python6")
 validate_whole_projection(detail,approval,actual)
 ticket=physical_provenance(detail,approval,evidence,actual)
 nominal(terminal["authorization_sha256"],hexpin(ticket["authorization_sha256"]),"parent binds actual source authorization")
 auth=record(path(evidence["authorization_path"]),ticket["authorization_sha256"])
 require(ticks(auth["created_utc"],"powershell7")<=ticks(actual["captured_utc"],"python6"),"authorized helper publication order")
 return detail

WHOLE_ROOTS = {'base': PROJECT / 'runtimes/week8-python313-frozen-001', 'scripts': PROJECT / 'pro2/.venv/Scripts'}
WHOLE_EXPECTED = {'base': {'files': 5368, 'directories': 504, 'bytes': 155022742, 'sha256': '0a5aff918e4a46fae2427a593261f8e3640ba439ba4ffebf5081b15eb7df6760'}, 'scripts': {'files': 22, 'directories': 0, 'bytes': 2145329, 'sha256': 'baa95b3f7e3e50a9b388fca6c4fd238fb55fc2e62f4cdc07c1b7c57caa9a54ad'}}
WHOLE_FILE_ROWS = {}
WHOLE_DIRECTORY_ROWS = {}
PROJECTION13 = ('schema_version', 'record_type', 'scope', 'phase', 'whole_result', 'table_sources', 'roots', 'path_rule', 'row_rule', 'counts', 'ordered_projected_observations_sha256', 'maximum_detail_bytes', 'maximum_retained_observations')
PROJECTION_ROLES = ('base_first', 'base_second', 'scripts_first', 'scripts_second')


def whole_raw9(value):
 require(type(value) is list and len(value) == 9 and all(type(item) is int for item in value), 'whole raw9 exact integer fields')


def whole_observation_row(value):
 exact(value, ('path', 'bytes', 'sha256', 'path_raw9', 'descriptor_raw9'), 'whole reconstructed row5')
 path(value['path']);hexpin(value['sha256'])
 require(type(value['bytes']) is int and 0 <= value['bytes'] <= 67108864, 'whole row bounded exact size')
 whole_raw9(value['path_raw9']);whole_raw9(value['descriptor_raw9'])


def current_whole_directory(p, expected):
 whole_raw9(expected)
 parents(p)
 info = p.lstat()
 require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode) and not info.st_file_attributes & 0x400, 'whole plain current directory')
 nominal(raw(info), expected, 'whole directory same-API current raw9')


def current_whole_file(p, expected):
 # Only a file authenticated by the complete compiled-root table proof may
 # use this reader. It does not relax the ordinary executable/birth policy.
 whole_observation_row(expected)
 nominal(expected['path'], str(p), 'whole exact current file path')
 require(str(p) in WHOLE_FILE_ROWS, 'whole reader authenticated membership')
 nominal(WHOLE_FILE_ROWS[str(p)], expected, 'whole reader exact authenticated facts')
 chain = parents(p)
 before = p.lstat(); a = raw(before)
 require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and not before.st_file_attributes & 0x400
   and before.st_size == expected['bytes'], 'whole bounded plain file before open')
 nominal(a, expected['path_raw9'], 'whole path same-API raw9 before open')
 hexpin(expected['sha256'])
 total = 0; hasher = hashlib.sha256()
 with p.open('rb') as stream:
  info = os.fstat(stream.fileno()); b = raw(info)
  require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and not info.st_file_attributes & 0x400, 'whole plain owned handle')
  nominal(b, expected['descriptor_raw9'], 'whole descriptor same-API raw9 before read')
  nominal(a[:4] + [a[6]], b[:4] + [b[6]], 'whole restricted cross-API identity')
  while True:
   block = stream.read(min(1048576, expected['bytes'] - total + 1))
   if not block:
    break
   total += len(block)
   require(total <= expected['bytes'], 'whole stream growth bound')
   hasher.update(block)
  nominal(raw(os.fstat(stream.fileno())), b, 'whole same-handle final raw9')
 nominal(raw(p.lstat()), a, 'whole same-path final raw9')
 nominal(parents(p), chain, 'whole ancestor identity stable')
 nominal(total, expected['bytes'], 'whole exact streamed size')
 nominal(hasher.hexdigest(), expected['sha256'], 'whole full current byte hash')


def reconstruct_whole_tables(tables):
 exact(tables, PROJECTION_ROLES, 'whole four reconstructed tables')
 projected = []; directories = {}; all_paths = []
 for role, root in WHOLE_ROOTS.items():
  first = tables[role + '_first']; second = tables[role + '_second']
  nominal(first, second, 'whole both tables exact typed equal')
  exact(first, ('root', 'identity', 'rows', 'root_raw9', 'directory_metadata'), 'whole closed table5')
  nominal(first['root'], str(root), 'whole compiled canonical root')
  nominal(first['identity'], WHOLE_EXPECTED[role], 'whole complete pinned identity')
  whole_raw9(first['root_raw9'])
  require(type(first['rows']) is list and len(first['rows']) <= 6000, 'whole finite rows')
  require(type(first['directory_metadata']) is dict, 'whole directory map nominal type')
  tree_directories = {str(root): first['root_raw9']}; relative_paths = []; lines = []
  files = dirs = total = 0
  for row in first['rows']:
   require(type(row) is dict and type(row.get('path')) is str and 0 < len(row['path']) <= 399
     and not any(char in row['path'] for char in ('\t', '\r', '\n', '\x00')), 'whole finite relative path')
   relative = Path(row['path'])
   components = row['path'].split('/')
   require(not relative.is_absolute() and relative.as_posix() == row['path']
     and all(component not in ('', '.', '..') and ':' not in component for component in components), 'whole canonical path confinement')
   absolute = root / relative
   require(absolute.is_relative_to(root), 'whole compiled root join')
   relative_paths.append(row['path'])
   if row.get('kind') == 'directory':
    exact(row, ('kind', 'path', 'path_raw9'), 'whole directory row3')
    whole_raw9(row['path_raw9'])
    tree_directories[str(absolute)] = row['path_raw9']; dirs += 1
    lines.append('D\t' + row['path'] + '\n')
   else:
    exact(row, ('kind', 'path', 'bytes', 'sha256', 'path_raw9', 'descriptor_raw9'), 'whole file row6')
    nominal(row['kind'], 'file', 'whole exact file kind')
    observation = dict(path=str(absolute), bytes=row['bytes'], sha256=row['sha256'], path_raw9=row['path_raw9'], descriptor_raw9=row['descriptor_raw9'])
    whole_observation_row(observation)
    projected.append(observation); all_paths.append(str(absolute)); files += 1; total += row['bytes']
    lines.append('F\t' + row['path'] + '\t' + str(row['bytes']) + '\t' + row['sha256'] + '\n')
  ordinal = lambda value: tuple(int.from_bytes(value.encode('utf-16-le', 'surrogatepass')[i:i + 2], 'little') for i in range(0, len(value.encode('utf-16-le', 'surrogatepass')), 2))
  nominal(relative_paths, sorted(relative_paths, key=ordinal), 'whole full UTF16 ordinal order')
  require(len(relative_paths) == len({value.casefold() for value in relative_paths}), 'whole no repeated or casefold aliases')
  for key, value in first['directory_metadata'].items():
   require(type(key) is str, 'whole directory map string keys'); whole_raw9(value)
  nominal(first['directory_metadata'], tree_directories, 'whole exact directory coverage')
  nominal(dict(files=files, directories=dirs, bytes=total, sha256=sha(''.join(lines).encode('utf8'))), first['identity'], 'whole reconstructed full tree identity')
  directories.update(tree_directories)
 require(len(projected) == 5390 and len(all_paths) == len({value.casefold() for value in all_paths}), 'whole exact complete5390 unique coverage')
 return projected, directories


def validate_whole_projection(detail, approval, actual):
 require(type(detail['checks']) is dict and 'whole_observation_projection' in detail['checks'], 'checker009 lossless projection required')
 projection = detail['checks']['whole_observation_projection']
 exact(projection, PROJECTION13, 'whole closed projection13')
 phase = 'before' if detail['role'] == 'whole_before_result' else 'none'
 for key, value in dict(schema_version=1, record_type='guard006_lossless_whole_observation_projection', scope=SCOPE, phase=phase,
  roots={role:str(root) for role,root in WHOLE_ROOTS.items()}, path_rule='COMPILED_ROOT_JOIN_CANONICAL_RELATIVE_FILE_ROW',
  row_rule='FILE_ONLY_PATH_BYTES_SHA256_PATH_RAW9_DESCRIPTOR_RAW9', maximum_detail_bytes=2097152, maximum_retained_observations=4096).items():
  nominal(projection[key], value, 'whole projection exact nominal')
 retained = detail['observations']
 require(type(retained) is list and 1 <= len(retained) <= 4096, 'whole retained observation cap')
 for row in retained:
  whole_observation_row(row)
 count = 5390 if phase == 'before' else 0
 nominal(projection['counts'], dict(unique_file_count=count, omitted_observation_count=count, retained_observation_count=len(retained),
  total_observation_count=count + len(retained), per_tree=dict(base=5368 if count else 0, scripts=22 if count else 0)), 'whole exact typed projection counts')
 if phase == 'none':
  nominal(projection['whole_result'], None, 'nonwhole no omitted result')
  nominal(projection['table_sources'], [], 'nonwhole no table pointers')
  nominal(projection['ordered_projected_observations_sha256'], sha(canonical([])), 'nonwhole empty projected digest')
  return
 nominal(projection['whole_result'], dict(path=str(PREP/'whole-runtime-before/result.json'), sha256=approval['input_sha256']), 'whole projection exact current core input')
 nominal(actual['phase'], 'before', 'whole result projection phase')
 nominal(actual['trees'], WHOLE_EXPECTED, 'whole result complete pinned trees')
 rows = projection['table_sources']
 require(type(rows) is list and len(rows) == 4 and type(actual['observation_files']) is list and len(actual['observation_files']) == 4, 'whole four exact table pointers')
 tables = {}; table_bytes = {}
 for role, row, result_row in zip(PROJECTION_ROLES, rows, actual['observation_files']):
  exact(row, ('role', 'path', 'sha256', 'bytes'), 'whole table pointer4')
  tree, suffix = role.split('_'); p = PREP/'whole-runtime-before'/(tree+'-'+suffix+'.json')
  nominal(row['role'], role, 'whole ordered table role')
  nominal(row['path'], str(p), 'whole fixed table path')
  require(type(row['bytes']) is int and 0 < row['bytes'] <= 4194304, 'whole table pre-read4MiB cap')
  nominal(result_row, {key:row[key] for key in ('path','sha256','bytes')}, 'whole result projection table equality')
  data, observed = read(p, hexpin(row['sha256']), 4194304)
  nominal(len(data), row['bytes'], 'whole table exact byte count')
  tables[role] = decode(data, True); table_bytes[role] = data
 for role in WHOLE_ROOTS:
  nominal(table_bytes[role+'_first'], table_bytes[role+'_second'], 'whole both full canonical byte streams equal')
 projected, directories = reconstruct_whole_tables(tables)
 nominal(sha(canonical(projected)), hexpin(projection['ordered_projected_observations_sha256']), 'whole complete projected row5 digest')
 for row in projected:
  key = row['path']
  if key in WHOLE_FILE_ROWS:
   nominal(WHOLE_FILE_ROWS[key], row, 'whole same authenticated file across decisions')
  WHOLE_FILE_ROWS[key] = row
 for key, value in directories.items():
  if key in WHOLE_DIRECTORY_ROWS:
   nominal(WHOLE_DIRECTORY_ROWS[key], value, 'whole same authenticated directory across decisions')
  WHOLE_DIRECTORY_ROWS[key] = value
  current_whole_directory(Path(key), value)
 for row in projected:
  current_whole_file(Path(row['path']), row)


def final_whole_reobserve():
 require(len(WHOLE_FILE_ROWS) == 5390 and len(WHOLE_DIRECTORY_ROWS) == 506, 'whole final complete file and directory coverage')
 for key, value in WHOLE_DIRECTORY_ROWS.items():
  current_whole_directory(Path(key), value)
 for key, value in WHOLE_FILE_ROWS.items():
  current_whole_file(Path(key), value)


def require(value, reason):
 if not value:
  raise ValueError(reason)


def sha(data):
 return hashlib.sha256(data).hexdigest()


def canonical(value):
 return (json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False) + "\n").encode("ascii")


def exact(value, keys, reason):
 require(type(value) is dict and set(value) == set(keys), reason)


def nominal(value, expected, reason):
 require(type(value) is type(expected) and value == expected, reason)
 if type(expected) is dict:
  require(set(value) == set(expected), reason)
  for key in expected:
   nominal(value[key], expected[key], reason + ":" + key)
 elif type(expected) in (list, tuple):
  require(len(value) == len(expected), reason)
  for index, item in enumerate(expected):
   nominal(value[index], item, reason + ":" + str(index))


def hexpin(value, length=64):
 require(type(value) is str and re.fullmatch("[0-9a-f]{" + str(length) + "}", value), "exact SHA domain")
 return value


def unique(rows):
 out = {}
 for key, value in rows:
  require(key not in out, "duplicate JSON key")
  out[key] = value
 return out


def reject_number(unused):
 raise ValueError("floating/nonfinite JSON numbers prohibited")


def decode(data, canonical_bytes=False):
 require(type(data) is bytes, "JSON bytes")
 value = json.loads(data.decode("utf8", errors="strict"), object_pairs_hook=unique, parse_float=reject_number, parse_constant=reject_number)
 if canonical_bytes:
  require(data == canonical(value), "canonical compact ASCII plus LF required")
 return value


def path(value):
 require(type(value) is str and len(value) <= 1024, "nominal pathname")
 p = Path(value)
 require(p.is_absolute() and ".." not in p.parts and all(":" not in component for component in p.parts[1:]) and (p.is_relative_to(PROJECT) or str(p) in EXTERNAL_CONFIGS), "project-confined plain path or exact external configuration role")
 return p


def raw(info):
 values = [getattr(info, key, None) for key in ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns", "st_mode", "st_nlink", "st_file_attributes", "st_birthtime_ns")]
 require(all(type(item) is int for item in values), "Windows raw9 exact integers")
 return values


def parents(p):
 out = []
 for parent in reversed(p.parents):
  info = parent.lstat()
  require(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode) and not info.st_file_attributes & 0x400, "plain ancestor")
  out.append((str(parent), info.st_dev, info.st_ino))
 return out


def read(p, pin=None, maximum=2097152):
 p = path(str(p))
 require(type(maximum) is int and 0 <= maximum <= 8388608, "finite pre-read cap")
 if pin is not None:
  hexpin(pin)
 ancestors = parents(p)
 a = p.lstat(); ar = raw(a)
 require(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and not a.st_file_attributes & 0x400 and 0 <= a.st_size <= maximum, "plain bounded single-link file")
 require(a.st_ctime_ns == a.st_birthtime_ns, "path creation field")
 fd = os.open(p, os.O_RDONLY | os.O_BINARY)
 chunks = []; total = 0
 try:
  h = os.fstat(fd); hr = raw(h)
  require(stat.S_ISREG(h.st_mode) and h.st_nlink == 1 and not h.st_file_attributes & 0x400, "plain owned read handle")
  require(all(ar[i] == hr[i] for i in (0, 1, 2, 3, 6, 7, 8)), "canonical cross creation/identity")
  if a.st_mode != h.st_mode:
   role = EXECUTABLES.get(str(p).casefold())
   require(role is not None and pin == role[0] and a.st_size == role[1] and a.st_mode & 0o111 == 0o111 and h.st_mode & 0o111 == 0 and a.st_mode & ~0o111 == h.st_mode & ~0o111, "only fixed byte-pinned executable projection")
  while True:
   block = os.read(fd, min(1048576, maximum + 1 - total))
   if not block:
    break
   total += len(block); require(total <= maximum, "read cap")
   chunks.append(block)
  require(raw(os.fstat(fd)) == hr, "same-handle raw9 drift")
 finally:
  os.close(fd)
 require(raw(p.lstat()) == ar and parents(p) == ancestors, "same-path raw9/ancestor drift")
 data = b"".join(chunks)
 require(len(data) == a.st_size and (pin is None or sha(data) == pin), "byte pin/size")
 observation = {"bytes": len(data), "sha256": sha(data), "path_raw9": ar, "descriptor_raw9": hr}
 previous = observations.get(str(p))
 require(previous is None or previous == observation, "input changed between review observations")
 observations[str(p)] = observation
 return data, observation


def record(p, pin, maximum=65536):
 return decode(read(p, pin, maximum)[0])


def pointer(value):
 exact(value, ("path", "sha256"), "pointer2")
 return path(value["path"]), hexpin(value["sha256"])


def absent(p):
 parents(p)
 try:
  p.lstat()
 except FileNotFoundError:
  return
 raise ValueError("create-once role already exists: " + str(p))


def ticks(value, role):
 digits = 6 if role == "python6" else 7 if role == "powershell7" else None
 require(digits is not None and type(value) is str and re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{" + str(digits) + r"}\+00:00", value), "genuine producer UTC role")
 base = dt.datetime.strptime(value[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc)
 delta = base - dt.datetime(1970, 1, 1, tzinfo=dt.timezone.utc)
 return (delta.days * 86400 + delta.seconds) * 10000000 + int(value[20:20 + digits]) * (10 if digits == 6 else 1)


def now_ticks():
 return ticks(dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"), "python6")


def fresh(value, role, seconds):
 age = now_ticks() - ticks(value, role)
 require(0 <= age <= seconds * 10000000, "freshness budget exhausted")
 return age / 10000000


def metadata_row(p, value, maximum):
 exact(value, ("path", "sha256", "bytes", "path_raw9", "descriptor_raw9"), "closed metadata row5")
 nominal(value["path"], str(p), "fixed metadata path")
 require(type(value["bytes"]) is int and 0 <= value["bytes"] <= maximum, "nominal file size")
 for key in ("path_raw9", "descriptor_raw9"):
  require(type(value[key]) is list and len(value[key]) == 9 and all(type(x) is int for x in value[key]), "nominal raw9")
 _, observed = read(p, value["sha256"], maximum)
 nominal(observed, {key: value[key] for key in observed}, "actual byte/raw9 row")


def check_context(value, profile):
 exact(value, ("schema_version", "scope", "captured_utc", "head", "tracked_rows", "git_metadata", "configurations", "runtime_roles_projection_sha256"), "closed opaque8")
 nominal(value["schema_version"], 1, "context schema"); nominal(value["scope"], SCOPE, "context scope")
 nominal(value["runtime_roles_projection_sha256"], profile["runtime_roles_projection_sha256"], "roles projection")
 fresh(value["captured_utc"], "python6", 90); hexpin(value["head"], 40)
 cfg = profile["context_profile"]
 require(type(value["tracked_rows"]) is list and len(value["tracked_rows"]) == 742, "tracked742")
 names = [row["path"] for row in value["tracked_rows"]]
 require(all(type(x) is str for x in names) and names == sorted(names) and len({x.casefold() for x in names}) == 742 and sha(canonical(names)) == cfg["historical_authenticated_pathset_sha256"], "exact known742 pathset")
 for row in value["tracked_rows"]:
  rel = PurePosixPath(row["path"])
  require(not rel.is_absolute() and ".." not in rel.parts and rel.as_posix() == row["path"] and len(row["path"]) <= 399 and ":" not in row["path"] and "\\" not in row["path"], "safe relative current row")
  actual = dict(row); actual["path"] = str(Path(cfg["live_root"]) / row["path"])
  metadata_row(path(actual["path"]), actual, cfg["maximum_file_bytes"])
 expected_git = cfg["head_paths"] + cfg["optional_git_metadata_paths"]
 expected_config = [str(Path(parent) / name) for parent in cfg["configuration_parents"] for name in cfg["configuration_names"]]
 require(len(expected_config) == 55, "config55")
 for field, coverage in (("git_metadata", expected_git), ("configurations", expected_config)):
  require(type(value[field]) is list and [row["path"] for row in value[field]] == coverage, "finite optional coverage")
  for row in value[field]:
   exact(row, ("path", "exists", "identity"), "optional row3")
   require(type(row["exists"]) is bool, "nominal existence")
   if row["exists"]:
    metadata_row(path(row["path"]), row["identity"], cfg["maximum_git_metadata_bytes"])
   else:
    nominal(row["identity"], None, "absent identity"); absent(path(row["path"]))
    require(field != "git_metadata" or row["path"] not in cfg["head_paths"], "required HEAD role exists")
 branch = path(cfg["head_paths"][-1])
 pin = next(row["identity"]["sha256"] for row in value["git_metadata"] if row["path"] == str(branch))
 nominal(read(branch, pin, 128)[0].decode("ascii").strip(), value["head"], "observed HEAD bytes")


def reverse_literals(data, bindings):
 text = data.decode("utf8", errors="strict"); lines = text.splitlines(keepends=True)
 offsets = []; found = set()
 for node in ast.parse(text).body:
  if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name) and node.targets[0].id in bindings:
   name = node.targets[0].id
   require(name not in found and isinstance(node.value, ast.Constant), "single literal binding")
   nominal(node.value.value, bindings[name], "exact source binding value")
   found.add(name)
   start = sum(map(len, lines[:node.value.lineno - 1])) + node.value.col_offset
   end = sum(map(len, lines[:node.value.end_lineno - 1])) + node.value.end_col_offset
   offsets.append((start, end))
 require(found == set(bindings), "complete exact source bindings")
 for start, end in sorted(offsets, reverse=True):
  text = text[:start] + "None" + text[end:]
 return text.encode("utf8")


def source_inputs(profile,fixed):
 nominal(reverse_literals(fixed["driver"],{"SOURCE_CAPSULE_PEER_SHA256":SOURCE_PIN,"HARNESS_STATIC_PEER_SHA256":STATIC_PIN,"OWNER_SHA256":OWNER_PIN}),fixed["driver_template"],"fresh three-literal driver reversal")
 observer_bindings=SOURCE_PROTOCOL["static_model"]["observer_bindings"]
 nominal(reverse_literals(fixed["observer"],observer_bindings),fixed["observer_template"],"fresh exact observer reversal")
 nominal(sha(fixed["source_manifest"]),profile["source_manifest_sha256"],"current Consumer005 manifest")
 source=decode(fixed["source_peer"]);exact(source,SOURCE_PROTOCOL["source_peer_keys"],"closed distinct capsule source peer")
 for key,value in SOURCE_PROTOCOL["source_peer_core"].items():nominal(source[key],value,"pinned Consumer005 peer core")
 # The Source005 capsule is never interpreted as old51/nested12 Source003.
 roles=SOURCE_PROTOCOL["capsule_roles"];exact(roles,("capsule","schema","derivation"),"three closed capsule roles")
 captures={key:record(path(row["path"]),hexpin(row["sha256"]),row["maximum"])for key,row in roles.items()}
 capsule_shape(captures["capsule"],captures["schema"]["closed_entire_fixed_capsule_shape"])
 nominal(captures["capsule"]["operational_authority_granted"],False,"capsule source only")
 nominal(captures["capsule"]["future_authority"]["results"],None,"capsule no runtime results")
 static=decode(fixed["static"]);model=SOURCE_PROTOCOL["static_model"]["core"]
 exact(static,set(model)|{"limitation"},"closed immutable static20")
 require(len(static)==20,"static exact20")
 for key,value in model.items():nominal(static[key],value,"fresh harness source fact")
 nominal(static["owner_master_sha256"],MASTER_PIN,"static master versus actual lease")
 require(type(static["limitation"])is str and 0<len(static["limitation"])<=4096,"static qualification")
 projection=profile["source_projection"];q=record(PREP/projection["path"],projection["sha256"],2097152);result=[]
 for row in q["entries"]:
  if not row["runtime_source_reobserve_required"]:continue
  left=path(row["original_path"]);rel=PurePosixPath(row["copy_path"])
  require(not rel.is_absolute()and ".."not in rel.parts,"confined current source copy")
  right=PREP/str(rel);lb,lm=read(left,row["sha256"],row["bytes"]);rb,rm=read(right,row["sha256"],row["bytes"])
  nominal(lb,rb,"current source/copy bytes");nominal(lm,row["original_metadata"],"source raw9");nominal(rm,row["copy_metadata"],"copy raw9")
  require(lm["path_raw9"][:2]!=rm["path_raw9"][:2],"independent source/copy inode")
  result.append({"path":row["copy_path"],"original":lm,"copy":rm})
 return result



def check_runtime(value, profile):
 exact(value, ("schema_version", "scope", "captured_utc", "entries", "context_selection"), "closed runtime5")
 nominal(value["schema_version"], 1, "runtime schema"); nominal(value["scope"], SCOPE, "runtime scope")
 fresh(value["captured_utc"], "python6", 90)
 require(type(value["entries"]) is list and len(value["entries"]) == 4, "four files")
 for actual, fixed in zip(value["entries"], profile["runtime4_roles"]):
  nominal(actual["path"], fixed["path"], "fixed runtime path"); nominal(actual["sha256"], fixed["sha256"], "fixed runtime SHA")
  nominal(actual["bytes"], fixed["size"], "runtime size")
  metadata_row(path(actual["path"]), actual, fixed["size"])
 cp, cs = pointer(value["context_selection"])
 check_context(record(cp, cs, profile["context_profile"]["maximum_opaque_context_bytes"]), profile)


def metadata_source_closure(selection, roles, fixed):
 root = WORK / "metadata3-producer-core-prep001"
 nominal(roles["metadata_source_review"][0], WORK / "m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json", "fixed new preparer peer")
 preparer = record(*roles["metadata_source_review"], maximum=2097152)
 nominal(preparer["verdict"], "PASS_STATIC_METADATA_PREPARATION_ONLY", "new metadata source scope")
 nominal(preparer["reviewer"], "/root/owner_docs_review", "different metadata source reviewer")
 nominal(roles["metadata_source_binding"][0], root / "ACTUAL_SOURCE_BINDING_003.json", "actual binder provenance path")
 binding = record(*roles["metadata_source_binding"])
 exact(binding, ("schema_version", "binder", "template_sha256", "actual_script_sha256", "bindings", "role_selections", "exact_six_assignment_reversal", "exact_function_ASTs", "actual_before_authorization", "actual_after_authorization", "target_capture_executed"), "actual metadata source binding11")
 for key, expected in (("schema_version", 1), ("binder", "/root"), ("template_sha256", sha(fixed["metadata_template"])), ("exact_six_assignment_reversal", True), ("exact_function_ASTs", True), ("actual_before_authorization", None), ("actual_after_authorization", None), ("target_capture_executed", False)):
  nominal(binding[key], expected, "source binder field: " + key)
 plan = decode(fixed["metadata_binding_plan"])
 expected_bindings = dict(plan["bindings"])
 expected_bindings["preparer_static_review_sha256"] = roles["metadata_source_review"][1]
 require(len(expected_bindings) == 9, "finite metadata nine pins")
 for value in expected_bindings.values():
  hexpin(value)
 nominal(binding["bindings"], expected_bindings, "metadata nine actual source pins")
 nominal(binding["role_selections"], plan["role_selections"], "metadata exact three source roles")
 nominal(roles["metadata_bound_source"], (root / "capture-root-metadata003.BOUND.py", binding["actual_script_sha256"]), "metadata actual source role")
 bound = read(*roles["metadata_bound_source"], maximum=65536)[0]
 old_text, new_text = fixed["metadata_template"].decode("utf8"), bound.decode("utf8")
 old_tree, new_tree = ast.parse(old_text), ast.parse(new_text)
 old_functions = [ast.dump(n, include_attributes=False) for n in old_tree.body if isinstance(n, ast.FunctionDef)]
 new_functions = [ast.dump(n, include_attributes=False) for n in new_tree.body if isinstance(n, ast.FunctionDef)]
 require(len(old_functions) == 20 and old_functions == new_functions, "metadata exact twenty function ASTs")
 names = dict(plan["role_selections"], BINDINGS=expected_bindings, OWNER_SHA=OWNER_PIN, OWNER_END=SOURCE_BINDINGS["lease_end_utc"])
 old_assignments = {n.targets[0].id: n.value for n in old_tree.body if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names}
 edits = []; found = set(); lines = new_text.splitlines(keepends=True)
 for n in new_tree.body:
  if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in names:
   name = n.targets[0].id
   require(name not in found, "unique metadata assignment")
   nominal(ast.literal_eval(n.value), names[name], "exact metadata nine-plus-three binding")
   found.add(name)
   start = sum(map(len, lines[:n.value.lineno - 1])) + n.value.col_offset
   end = sum(map(len, lines[:n.value.end_lineno - 1])) + n.value.end_col_offset
   edits.append((start, end, ast.get_source_segment(old_text, old_assignments[name])))
 require(found == set(names) and len(edits) == 6, "six selected top-level assignments")
 for start, end, original in sorted(edits, reverse=True):
  new_text = new_text[:start] + original + new_text[end:]
 nominal(new_text.encode("utf8"), fixed["metadata_template"], "metadata exact nine-plus-three source byte reversal")
 nominal(roles["metadata_bound_review"][0], root / "INDEPENDENT_BOUND_METADATA_REVIEW_003.json", "actual metadata bound peer path")
 peer = record(*roles["metadata_bound_review"])
 exact(peer, ("actual_script_sha256", "metadata_only", "phase_set", "record_type", "reviewer", "schema_version", "source_author", "source_bindings", "verdict"), "metadata bound peer9")
 for key, expected in (("actual_script_sha256", binding["actual_script_sha256"]), ("metadata_only", True), ("phase_set", ["before", "after"]), ("record_type", "guard006_root_metadata_bound_source_review"), ("reviewer", "/root/owner_docs_review"), ("schema_version", 1), ("source_author", "/root/renewal_runtime_inventory"), ("source_bindings", expected_bindings), ("verdict", "PASS_STATIC_BOUND_METADATA_ONLY")):
  nominal(peer[key], expected, "actual different metadata bound peer: " + key)
 model=SOURCE_PROTOCOL["phase_core"]
 exact(model,("binding","review"),"phase closure model2")
 row=model["binding"];exact(row,("path","sha256","maximum"),"phase binding source row3")
 nominal(path(row["path"]),root/"PHASE_PS_SOURCE_BINDING_003.json","fixed phase binding")
 phase_binding=record(path(row["path"]),hexpin(row["sha256"]),row["maximum"])
 exact(phase_binding,("schema_version","binder","sources","actual_script_sha256","bound_review_sha256","actual_authorization","prepared_source_actions_executed"),"phase binding7")
 for key,value in {"schema_version":1,"binder":"/root","actual_script_sha256":binding["actual_script_sha256"],"bound_review_sha256":roles["metadata_bound_review"][1],"actual_authorization":None,"prepared_source_actions_executed":False}.items():nominal(phase_binding[key],value,"phase source binding nominal")
 planned=SOURCE_PROTOCOL["phase_rows"]
 require(type(planned)is list and len(planned)==4,"four explicitly selected PS source pairs")
 require(type(phase_binding["sources"])is list and len(phase_binding["sources"])==4,"all four PS phase rows")
 stems=("WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_003","SUPERVISE_ROOT_METADATA_BEFORE_003","WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_003","SUPERVISE_ROOT_METADATA_AFTER_003")
 for actual,selected,stem in zip(phase_binding["sources"],planned,stems):
  exact(actual,("path","sha256","template_sha256","exact_two_literal_reversal"),"phase row4")
  exact(selected,("path","sha256","template_path","template_sha256"),"reviewed finite PS pair")
  nominal(actual,{"path":selected["path"],"sha256":selected["sha256"],"template_sha256":selected["template_sha256"],"exact_two_literal_reversal":True},"phase row reviewed source")
  nominal(path(actual["path"]),root/(stem+".BOUND.ps1"),"fixed actual PS phase")
  template_path=path(selected["template_path"])
  require(template_path.parent==root and template_path.name.startswith(stem)and template_path.name.endswith(".TEMPLATE.ps1"),"selected corrected PS template leaf")
  original=read(template_path,hexpin(selected["template_sha256"]),65536)[0]
  text=read(path(actual["path"]),hexpin(actual["sha256"]),65536)[0].decode("utf8")
  for name,pin in {"BoundScriptSha256":binding["actual_script_sha256"],"BoundReviewSha256":roles["metadata_bound_review"][1]}.items():
   pattern="(?m)^\\$"+name+r" = '[0-9a-f]{64}'\r?$"
   matches=re.findall(pattern,text)
   require(len(matches)==1 and matches[0].rstrip("\r")=="$"+name+" = '"+pin+"'","phase exact two pin assignment")
   text=re.sub(pattern,lambda match,n=name:"$"+n+" = $null"+("\r"if match.group().endswith("\r")else""),text)
  nominal(text.encode("utf8"),original,"all four PS exact two-literal byte reversals")
 review_row=model["review"]
 exact(review_row,("path","sha256","maximum","keys","values"),"different phase Source peer model")
 phase_peer=record(path(review_row["path"]),hexpin(review_row["sha256"]),review_row["maximum"])
 exact(phase_peer,review_row["keys"],"complete different phase source peer")
 for key,value in review_row["values"].items():nominal(phase_peer[key],value,"phase source peer pinned fact")
 nominal(phase_peer["reviewer"],"/root/owner_docs_review","different phase source reviewer")
 require(type(phase_peer["verdict"])is str and phase_peer["verdict"].startswith("PASS"),"pinned phase source acceptance")


def root_writer_source(fixed):
 writer=fixed["root_writer"];reversal=SOURCE_PROTOCOL["root_writer_reversal"]
 exact(reversal,("actual_sha256","template_sha256","literal_slots"),"Root-reviewed writer reversal model3")
 nominal(sha(writer),hexpin(reversal["actual_sha256"]),"fresh Root writer pinned source")
 nominal(sha(fixed["root_writer_before"]),hexpin(reversal["template_sha256"]),"fresh Root writer template")
 slots=reversal["literal_slots"];require(type(slots)is dict and len(slots)<=16,"finite Root-authored writer slots")
 text=writer.decode("utf8")
 for name,pin in slots.items():
  require(type(name)is str and re.fullmatch("[A-Za-z][A-Za-z0-9_]{0,63}",name),"Root slot identifier")
  hexpin(pin);pattern="(?m)^\\$"+name+r" = '[0-9a-f]{64}'\r?$";matches=re.findall(pattern,text)
  require(len(matches)==1 and matches[0].rstrip("\r")=="$"+name+" = '"+pin+"'","Root source-defined writer binding")
  text=re.sub(pattern,lambda match,n=name:"$"+n+" = $null"+("\r"if match.group().endswith("\r")else""),text)
 nominal(text.encode("utf8"),fixed["root_writer_before"],"Root actual reviewed byte reversal without invented namespace substitutions")
 for role,key in (("metadata_source_review","metadata_source_core"),("root_writer_review","root_writer_core")):
  p,h=pointer(SOURCE_PROTOCOL["packet_source_roles"][role]);approval=record(p,h,2097152);model=SOURCE_PROTOCOL[key]
  exact(model,("keys","values"),"complete frozen Source approval model2")
  exact(approval,model["keys"],"all frozen Source approval keys")
  for name,value in model["values"].items():nominal(approval[name],value,"pinned Source approval fact")
  nominal(approval["reviewer"],"/root/owner_docs_review","different Source approver")
  require(type(approval["verdict"])is str and approval["verdict"].startswith("PASS"),"pinned Source acceptance")


def publish_once(p, value, maximum):
 data = canonical(value); require(len(data) <= maximum, "finite output")
 absent(p)
 fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_BINARY, 0o600)
 with os.fdopen(fd, "wb") as stream:
  stream.write(data); stream.flush(); os.fsync(stream.fileno())
 nominal(read(p, sha(data), maximum)[0], data, "review readback")
 return {"path": str(p), "sha256": sha(data), "bytes": len(data)}


def main():
 parser = argparse.ArgumentParser()
 for name in ("expected-self-sha256", "selection", "selection-sha256"):
  parser.add_argument("--" + name, required=True)
 args = parser.parse_args()
 require(os.name == "nt" and sys.version_info[:3] == (3, 13, 5) and sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1 and sys.flags.utf8_mode == 1 and sys.flags.optimize == 0, "isolated pinned metadata utility flags/version")
 nominal(Path(sys.executable).absolute(), BASE_PYTHON, "direct pinned metadata interpreter")
 read(BASE_PYTHON, "5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed", 105816)
 nominal(Path(__file__).absolute(), SELF, "fixed utility source")
 read(SELF, hexpin(args.expected_self_sha256), 131072)
 selection = record(path(args.selection), hexpin(args.selection_sha256))
 exact(selection, SELECTION_KEYS, "external selection6")
 nominal(selection["schema_version"], 1, "selection schema")
 nominal(selection["record_type"], "root_selected_gg6_actual_record_review_001", "selection role")
 require(selection["phase"] in ("bound", "late"), "known phase")
 phase = selection["phase"]
