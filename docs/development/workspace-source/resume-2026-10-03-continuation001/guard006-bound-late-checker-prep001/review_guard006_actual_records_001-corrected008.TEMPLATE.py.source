   nominal(value, None, "no future source binding cycle")
  else:
   roles[role] = pointer(value)
 bind_source_pool()
 static_roles=SOURCE_PROTOCOL["packet_source_roles"]
 exact(static_roles,("metadata_source_review","metadata_source_binding","metadata_bound_source","metadata_bound_review","root_writer","root_writer_review"),"six immutable packet Source roles")
 for role,row in static_roles.items():nominal(roles[role],pointer(row),"packet role agrees with selected Source pool")
 fixed = {role: read(p, pin, maximum)[0] for role, (p, pin, maximum) in FIXED.items()}
 profile = decode(fixed["profile"])
 nominal(profile["scope"], SCOPE, "profile scope")
 require(now_ticks() < LEASE_END_TICKS, "owner deadline")
 source_snapshot = source_inputs(profile, fixed)
 nominal(roles["root_writer"], FIXED["root_writer"][:2], "externally pinned distinct Root writer2")
 root_writer_source(fixed)
 for role in APPROVAL_ROLES:
  approval = record(*roles[role], maximum=2097152)
  if role in ("metadata_before_review","whole_phase_review"):
   machine_core(approval,role)
  specification = selection["approval_cores"][role]
  exact(specification, ("keys", "values"), "selected exact review shape and core")
  require(type(specification["keys"]) is list and all(type(x) is str for x in specification["keys"]) and len(set(specification["keys"])) == len(specification["keys"]), "finite selected closed approval keys")
  exact(approval, specification["keys"], "actual closed stage review")
  core = specification["values"]
  if role in ("metadata_source_review","root_writer_review"):
   model=SOURCE_PROTOCOL["metadata_source_core" if role=="metadata_source_review" else "root_writer_core"]
   nominal(specification,{"keys":model["keys"],"values":model["values"]},"source-bound complete approval model")
  require(type(core) is dict and len(core) >= 3 and type(core.get("verdict")) is str and core["verdict"].startswith("PASS") and core.get("reviewer") in ELIGIBLE and core["reviewer"] != REVIEWER, "externally selected different independent actual-stage approval")
  for key, expected in core.items():
   nominal(approval[key], expected, "prior-stage authentic actual review core: " + key)
  for key in ("created_utc", "captured_utc"):
   if key in approval:
    ticks(approval[key], selection["producer_roles"][role])
 metadata_source_closure(selection, roles, fixed)
 ack_path, ack_pin = roles["ack"]
 nominal(ack_path, PREP / "ROOT_EXECUTION_ACK_GUARD_UNIT006.json", "fixed actual ACK")
 ack = record(ack_path, ack_pin)
 template_row = SOURCE_PROTOCOL["ack_template"]
 exact(template_row,("path","sha256","maximum"),"fresh ACK template row3")
 nominal(path(template_row["path"]),PREP / "ROOT_EXECUTION_ACK_GUARD_UNIT006.TEMPLATE.json","fixed fresh ACK template")
 template = record(path(template_row["path"]),hexpin(template_row["sha256"]),template_row["maximum"])
 require(len(template)==22,"fresh ACK template22")
 exact(ack, template, "closed ACK22")
 for key,value in {"schema_version":1,"record_type":"consumer_guard_unit006_first_run_ack","scope":SCOPE,"author":"/root","executor":"/root","max_collection_seconds":60,"max_test_seconds":300}.items():nominal(ack[key],value,"ACK unchanged nominal grammar")
 for key, expected in template.items():
  if expected is not None:
   nominal(ack[key], expected, "ACK fixed nominal: " + key)
 common = {"driver_sha256": DRIVER_PIN, "harness_static_review_sha256": STATIC_PIN, "owner_sha256": OWNER_PIN, "child_sha256": profile["child"]["sha256"], "profile_sha256": PROFILE_PIN, "source_peer_sha256": SOURCE_PIN, "source_manifest_sha256": SOURCE_MANIFEST_PIN, "source_projection_sha256": profile["source_projection_sha256"]}
 for key, expected in common.items():
  nominal(ack[key], expected, "ACK current source field: " + key)
 nominal(ack["decision"], "execute_copied_consumer_guard_unit006_once", "ACK scope decision")
 created, expires = ticks(ack["created_utc"], "powershell7"), ticks(ack["expires_utc"], "powershell7")
 require(created <= now_ticks() and now_ticks() + 5100000000 <= expires <= LEASE_END_TICKS and 0 < expires - created <= 5 * 3600 * 10000000, "actual ACK owner/450s reserve")
 runtime_path, runtime_pin = pointer(ack["runtime_snapshot"])
 runtime = record(runtime_path, runtime_pin)
 check_runtime(runtime, profile)
 for role in ("metadata_before_review","whole_phase_review"):
  core=record(*roles[role]);nominal(core["context_sha256"],runtime["context_selection"]["sha256"],"machine core original context")
  nominal(core["runtime_snapshot_sha256"],runtime_pin,"machine core original runtime")
 metadata_core=record(*roles["metadata_before_review"])
 capture=record(path(SOURCE_PROTOCOL["detail15"]["metadata_before_review"]["input_path"]),metadata_core["input_sha256"],SOURCE_PROTOCOL["detail15"]["metadata_before_review"]["input_maximum"])
 nominal(capture["context"],runtime["context_selection"],"actual captured context pointer")
 nominal(pointer(capture["runtime_selection"]),(runtime_path,runtime_pin),"actual captured runtime pointer")
 resource_path, resource_pin = pointer(ack["resource_snapshot"])
 resource = record(resource_path, resource_pin)
 exact(resource, ("schema_version", "scope", "captured_utc", "free_ram_bytes", "disk_free_bytes", "single_thread", "author"), "resource7")
 for key, expected in (("schema_version", 1), ("scope", SCOPE), ("single_thread", True), ("author", "/root")):
  nominal(resource[key], expected, "resource nominal")
 require(type(resource["free_ram_bytes"]) is int and resource["free_ram_bytes"] >= 1073741824 and type(resource["disk_free_bytes"]) is int and resource["disk_free_bytes"] >= 10737418240, "resource snapshot floors")
 fresh(resource["captured_utc"], "powershell7", 60)
 coord_path, coord_pin = pointer(ack["coordination_acknowledgement"])
 coord = record(coord_path, coord_pin)
 exact(coord, ("schema_version", "scope", "created_utc", "other_session_acknowledgement", "root_response", "live_execution_authorized"), "coordination6")
 nominal(coord["schema_version"], 1, "coord schema"); nominal(coord["scope"], SCOPE, "coord scope")
 nominal(coord["live_execution_authorized"], False, "no live execution/lease/quiet")
 ticks(coord["created_utc"], "powershell7")
 nominal(pointer(coord["other_session_acknowledgement"]), FIXED["pro3_coord"][:2], "held Pro3 bytes")
 nominal(pointer(coord["root_response"]), FIXED["root_coord"][:2], "isolated/no-delivery Root response")
 whole_path, whole_pin = pointer(ack["whole_runtime_before"])
 nominal((whole_path, whole_pin), roles["whole_acceptance"], "actual whole acceptance pointer")
 whole = record(whole_path, whole_pin)
 exact(whole, ("schema_version", "scope", "captured_utc", "verifier", "whole_before_evidence", "unchanged_against_reviewed_runtime", "runtime_snapshot_sha256"), "whole acceptance7")
 nominal(whole["schema_version"], 1, "whole schema"); nominal(whole["scope"], SCOPE, "whole scope")
 nominal(whole["verifier"], "/root/actual_record_checker", "different actual before reviewer")
 nominal(whole["unchanged_against_reviewed_runtime"], True, "actual whole acceptance")
 nominal(whole["runtime_snapshot_sha256"], runtime_pin, "whole runtime reference")
 fresh(whole["captured_utc"], selection["producer_roles"]["whole_acceptance"], 90)
 whole_result_path, whole_result_pin = pointer(whole["whole_before_evidence"])
 nominal(whole_result_path, PREP / "whole-runtime-before/result.json", "actual before result path")
 whole_result = record(whole_result_path, whole_result_pin, 262144)
 whole_core=record(*roles["whole_phase_review"])
 nominal(whole_core["input_sha256"],whole_result_pin,"actual whole decision input")
 exact(whole_result, ("schema_version", "record_type", "scope", "phase", "verdict", "captured_utc", "observer_sha256", "static_review_sha256", "profile_sha256", "owner_sha256", "runtime_snapshot_sha256", "context_selection_sha256", "source_snapshot_sha256", "trees", "observation_files", "before_record_sha256", "unit_receipt", "target_execution", "whole_site_loaded_closure_retained_lock_OS_Job_guaranteed"), "whole result19")
 nominal(whole_result["schema_version"], 1, "whole result schema")
 nominal(whole_result["before_record_sha256"], None, "before no future record")
 nominal(whole_result["unit_receipt"], None, "before no future unit result")
 nominal(whole_result["whole_site_loaded_closure_retained_lock_OS_Job_guaranteed"], False, "no loaded/Job closure")
 nominal(whole_result["record_type"], "consumer_guard_unit006_whole_metadata_result", "whole result role")
 nominal(whole_result["phase"], "before", "before phase"); nominal(whole_result["scope"], SCOPE, "whole result scope")
 nominal(whole_result["verdict"], "MATCHES_PINNED_BYTES_METADATA_TWICE", "whole data verdict")
 for key, expected in (("runtime_snapshot_sha256", runtime_pin), ("profile_sha256", PROFILE_PIN), ("static_review_sha256", STATIC_PIN), ("owner_sha256", OWNER_PIN), ("observer_sha256", OBSERVER_PIN), ("target_execution", False)):
  nominal(whole_result[key], expected, "whole result binding: " + key)
 ticks(whole_result["captured_utc"], "python6")
 nominal(whole_result["source_snapshot_sha256"], sha(canonical(source_snapshot)), "whole source raw9 digest")
 nominal(whole_result["context_selection_sha256"], runtime["context_selection"]["sha256"], "whole context")
 nominal(whole_result["trees"], {"base": {"files": 5368, "directories": 504, "bytes": 155022742, "sha256": "0a5aff918e4a46fae2427a593261f8e3640ba439ba4ffebf5081b15eb7df6760"}, "scripts": {"files": 22, "directories": 0, "bytes": 2145329, "sha256": "baa95b3f7e3e50a9b388fca6c4fd238fb55fc2e62f4cdc07c1b7c57caa9a54ad"}}, "different-reviewer accepted two-tree canonical identities")
 files = whole_result["observation_files"]
 require(type(files) is list and len(files) == 4, "two trees/four evidence files")
 for row, expected_path in zip(files, (PREP / "whole-runtime-before" / (role + "-" + suffix + ".json") for role in ("base", "scripts") for suffix in ("first", "second"))):
  exact(row, ("path", "sha256", "bytes"), "whole observation row3")
