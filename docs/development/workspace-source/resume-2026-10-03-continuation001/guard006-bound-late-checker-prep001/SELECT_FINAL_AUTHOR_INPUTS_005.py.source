old=(P/'AUDIT_AND_FREEZE_OWN_SOURCE_003.py').read_text()
new=old.replace("'selected-source-003'","'selected-source-005'").replace('OWN_AST_INERT_AND_FINITE_INPUT_FACTS_003.json','OWN_AST_INERT_AND_FINITE_INPUT_FACTS_005.json').replace('CHECKER_SOURCE_FROM_PRESERVED_GG5_003.patch','CHECKER_SOURCE_FROM_PRESERVED_GG5_005.patch').replace('COMPOSER_SOURCE_FROM_PRESERVED_GG5_003.patch','COMPOSER_SOURCE_FROM_PRESERVED_GG5_005.patch').replace('metadata3-producer-core-prep001/STAGED_MANIFEST_004.json','metadata3-producer-core-prep001/STAGED_MANIFEST_005.json').replace('metadata3-producer-core-prep001/SOURCE_SCHEMA_AND_REVIEW_CONTRACT_004.json','metadata3-producer-core-prep001/SOURCE_SCHEMA_AND_REVIEW_CONTRACT_005.json')
