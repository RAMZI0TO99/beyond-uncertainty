old_manifest7=OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_007.json';old_manifest8=OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_008.json'
preserved=[]
for mp,pincount,expected in [(old_manifest7,41,'4d95dc21c9606090a6ddab6344dc63bf062e62e3ead27846f08165ceebadb73e'),
