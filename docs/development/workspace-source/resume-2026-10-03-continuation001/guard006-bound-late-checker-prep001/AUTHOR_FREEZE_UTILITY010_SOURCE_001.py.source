assert sha(oldbytes)=='98167867d0feedd106054a884222d16f9fb77dcf40df6c9f42bda9a14939f0e1'
assert sha(newbytes)=='2811fe89f1c8580563c436b2f11c45db35ad1ee8c02ba312a00db399e5924de8'and len(newbytes)==81410 and newbytes==proposalbytes
oldregex=b'\\{[a-z_]+\\}';newregex=b'\\{[a-z][a-z0-9_]*\\}'
assert oldbytes.count(oldregex)==1 and newbytes==oldbytes.replace(oldregex,newregex)
tree=ast.parse(newbytes);function=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='physical_provenance')
selected=[n for n in ast.walk(function)if isinstance(n,ast.Constant)and n.value==newregex.decode()]
assert len(selected)==1;selected[0].value=oldregex.decode()
assert ast.dump(tree,include_attributes=False)==dump(oldbytes)
assert sum(isinstance(n,ast.FunctionDef)for n in tree.body)==41
assert sha(read(composer)[0])=='1b909f93c795c1d162b025ccf4917513ee20eb2edfd5d1db80ff78afebd1d911'

