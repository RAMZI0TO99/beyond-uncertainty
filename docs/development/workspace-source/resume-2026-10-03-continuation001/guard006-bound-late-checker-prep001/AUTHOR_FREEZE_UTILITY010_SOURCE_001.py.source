"""Own Source AST/metadata freeze only, after genuine Rootchoice004 exists.
No reviewed definition/import/compiler/main/test/binding is executed.
"""
import ast
import datetime as dt
import hashlib
import json
import os
import re
import stat
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/guard006-bound-late-checker-prep001')
WORK=OWN.parent
def sha(data):return hashlib.sha256(data).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,ensure_ascii=True,separators=(',',':'))+'\n').encode('ascii')
def raw(i):return [getattr(i,k)for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def read(p):
    a=p.lstat();assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&0x400 and 0<=a.st_size<=2097152
    with p.open('rb')as s:
        b=raw(os.fstat(s.fileno()));data=s.read(2097153);assert raw(os.fstat(s.fileno()))==b
    assert len(data)==a.st_size and len(data)<=2097152 and raw(p.lstat())==raw(a)
    return data,dict(path=str(p),bytes=len(data),sha256=sha(data),path_raw9=raw(a),descriptor_raw9=b)
def once(p,data):
    with p.open('xb')as s:s.write(data);s.flush();os.fsync(s.fileno())
    assert read(p)[0]==data
def dump(data):return ast.dump(ast.parse(data),include_attributes=False)

old=OWN/'review_guard006_actual_records_001-corrected008.TEMPLATE.py'
proposal=OWN/'review_guard006_actual_records_001-corrected009.TEMPLATE.py'
new=OWN/'review_guard006_actual_records_001-corrected010.TEMPLATE.py'
composer=OWN/'compose-root-review-packet-006.TEMPLATE.py'
