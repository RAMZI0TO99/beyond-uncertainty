assert all(not re.fullmatch(oldregex.decode(),token)for token in tokens)
names=sorted(set(token[1:-1]for token in tokens));assert names==['authorization_sha256','before_authorization_sha256','before_capture_sha256','before_result_sha256','driver_finished_sha256','unit_terminal_sha256']
