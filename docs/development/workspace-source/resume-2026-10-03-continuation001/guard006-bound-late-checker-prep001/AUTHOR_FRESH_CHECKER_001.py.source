    nominal(end,LEASE_END_TICKS,"exact bound lease end")
    require(start<=now_ticks() and 0<end-start<=43200*10000000 and now_ticks()+5100000000<=end,"bounded lease510 reserve")
    return end

def capsule_shape(value,spec):
    require(type(spec)is dict and type(spec.get("kind"))is str,"closed capsule node")
    kind=spec["kind"]
    if kind=="exact_builtin_dict":
        exact(value,spec["closed_keys"],"capsule nested closed keys")
        for key in spec["closed_keys"]:capsule_shape(value[key],spec["fields"][key])
    elif kind=="exact_builtin_list":
        require(type(value)is list and len(value)==spec["length"] and len(spec["items"])==len(value),"capsule list domain")
        for item,shape in zip(value,spec["items"]):capsule_shape(item,shape)
    elif kind in ("exact_builtin_str","exact_builtin_int","exact_builtin_bool","exact_builtin_NoneType"):
        nominal(value,spec["value"],"capsule pinned scalar")
    else:raise ValueError("capsule unknown nominal shape")

def machine_core(approval,role):
    exact(approval,SOURCE_PROTOCOL["core12"],"machine closed Core12")
