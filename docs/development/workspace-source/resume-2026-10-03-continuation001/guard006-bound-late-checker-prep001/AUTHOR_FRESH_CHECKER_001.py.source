    nominal(approval["verdict"],SOURCE_PROTOCOL["detail15"][role]["core_verdict"],"actual core verdict")
    evidence=SOURCE_PROTOCOL["detail15"][role]
    detail=record(path(evidence["path"]),hexpin(approval["evidence_sha256"]),2097152)
    exact(detail,evidence["keys"],"cryptobound detail15")
    for key,value in evidence["nominals"].items():nominal(detail[key],value,"bound evidence nominal")
    nominal(detail["checker_source_sha256"],SOURCE_PROTOCOL["checker_source"]["sha256"],"genuine checker source")
    nominal(detail["checker_source_peer_sha256"],SOURCE_PROTOCOL["checker_peer"]["sha256"],"different checker source review")
    nominal(detail["checker_binding_sha256"],SOURCE_PROTOCOL["checker_binding"]["sha256"],"checker exact binding")
    nominal(detail["target_execution"],False,"metadata does not execute unit")
    nominal(detail["action_authorization"],False,"metadata does not authorize action")
    # Full trace/closure models are externally source-bound, never packet claims.
    for key in ("source_closure","phase_sources","execution_owner_trace"):
        nominal(detail[key],evidence[key],"actual evidence exact source/provenance binding")
    return detail
