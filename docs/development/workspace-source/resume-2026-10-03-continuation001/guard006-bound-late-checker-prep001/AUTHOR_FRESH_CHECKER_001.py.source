            try:
                trigger.lstat();break
            except FileNotFoundError:time.sleep(.05)
        marker=record(trigger,None,65536)
        exact(marker,("schema_version","record_type","author","phase","packet","target_execution"),"Root packet-ready6")
        for key,value in {"schema_version":1,"record_type":"root_guard006_packet_ready","author":"/root","phase":phase,"target_execution":False}.items():nominal(marker[key],value,"genuine Root packet handoff")
        packet,pin=pointer(marker["packet"])
        nominal(packet,OWN/("ROOT_SELECTED_"+phase.upper()+"_PACKET_006.json"),"fixed retained packet path")
        global observations
        observations={}
        oldargs=sys.argv
        try:
            sys.argv=[str(SELF),"--expected-self-sha256",args.expected_self_sha256,"--selection",str(packet),"--selection-sha256",pin]
            main()
        finally:sys.argv=oldargs
        publish_once(OWN/(phase.upper()+"_DECISION_READY_006.json"),{"schema_version":1,"record_type":"guard006_actual_decision_ready","reviewer":REVIEWER,"phase":phase,"created_utc":dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"),"target_execution":False},65536)

if __name__=="__main__":
    retained_waiter()
