    end=ticks(args.retained_deadline_utc,"python6")
    require(now_ticks()<end<=LEASE_END_TICKS and end-now_ticks()<=3600*10000000,"retained own bounded poll deadline")
    publish_once(OWN/"BOUND_LATE_CHECKER_READY_006.json",{"schema_version":1,"record_type":"guard006_bound_late_checker_ready","reviewer":REVIEWER,"pid":os.getpid(),"created_utc":dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds"),"utility_sha256":args.expected_self_sha256,"lease_sha256":OWNER_PIN,"target_execution":False},65536)
    for phase in ("bound","late"):
        trigger=OWN/("ROOT_SELECTED_"+phase.upper()+"_PACKET_READY_006.json")
        while True:
