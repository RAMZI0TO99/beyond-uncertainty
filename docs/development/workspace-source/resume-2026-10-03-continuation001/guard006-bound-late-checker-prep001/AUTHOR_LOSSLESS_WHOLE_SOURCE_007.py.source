"""Own metadata authoring only; never imports, defines or calls target helpers."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).parent
OLD = HERE / 'review_guard006_actual_records_001-corrected006.TEMPLATE.py'
NEW = HERE / 'review_guard006_actual_records_001-corrected007.TEMPLATE.py'
FRAGMENT = HERE / 'LOSSLESS_WHOLE_READER_007.py.source'


def digest(data):
    return hashlib.sha256(data).hexdigest()


def once(path, data):
    with path.open('xb') as stream:
        stream.write(data)


old = OLD.read_bytes()
assert digest(old) == '1ab45b85e38447c40a99abdc5849eed5547700fbc9f84aefc842055b7a5b0ea1'
fragment = FRAGMENT.read_bytes()
source = old.decode('utf8')
newline = '\r\n' if '\r\n' in source else '\n'
fragment_text = fragment.decode('utf8').replace('\r\n', '\n').replace('\n', newline)
assert source.count('def require(value, reason):') == 1
source = source.replace('def require(value, reason):', fragment_text + newline + 'def require(value, reason):', 1)
old_call = '    ticket=physical_provenance(detail,approval,evidence,actual)'
assert source.count(old_call) == 1
source = source.replace(old_call, '    validate_whole_projection(detail,approval,actual)' + newline + old_call, 1)
old_final = '    check_runtime(runtime, profile)' + newline + '    fresh(resource["captured_utc"], "powershell7", 60)'
assert source.count(old_final) == 1
source = source.replace(old_final, '    final_whole_reobserve()' + newline + old_final, 1)
old_reset = '        observations={}'
assert source.count(old_reset) == 1
source = source.replace(old_reset, old_reset + newline + '        WHOLE_FILE_ROWS.clear();WHOLE_DIRECTORY_ROWS.clear()', 1)
data = source.encode('utf8')
tree_old = ast.parse(old)
tree_new = ast.parse(data)
old_functions = {node.name:ast.dump(node, include_attributes=False) for node in tree_old.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))}
new_functions = {node.name:ast.dump(node, include_attributes=False) for node in tree_new.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))}
changed = [name for name in old_functions if old_functions[name] != new_functions[name]]
assert sorted(changed) == ['machine_core', 'main', 'retained_waiter']
once(NEW, data)
once(HERE/'LOSSLESS_WHOLE_SOURCE_DIFF_007.patch', ('Source006 preserved; Source007 inserts independent reader functions and exactly three integration sites.\n').encode('ascii'))
facts = dict(schema_version=1,record_type='guard006_lossless_whole_source_author_inert_facts',source_author='/root/pubnative_review',
    predecessor=dict(path=str(OLD),sha256=digest(old),bytes=len(old)),successor=dict(path=str(NEW),sha256=digest(data),bytes=len(data)),
    fragment=dict(path=str(FRAGMENT),sha256=digest(fragment),bytes=len(fragment)),
    preserved_function_ASTs=[name for name in old_functions if name not in changed],changed_function_ASTs=changed,
    new_function_names=[name for name in new_functions if name not in old_functions],
    target_source_imported=False,target_definitions_executed=False,target_functions_called=False,tests_executed=False,
    actual_source_bindings=None,actual_source_pool=None,actual_detail_fit=None,actual_self_fit=None,SourceActualInputs=None)
assert OLD.read_bytes() == old and FRAGMENT.read_bytes() == fragment
once(HERE/'LOSSLESS_WHOLE_SOURCE_INERT_FACTS_007.json', (json.dumps(facts,sort_keys=True,indent=2)+'\n').encode('ascii'))
print(json.dumps(dict(source=facts['successor'],changed=changed,new_functions=len(facts['new_function_names']),actuals=None),sort_keys=True))
