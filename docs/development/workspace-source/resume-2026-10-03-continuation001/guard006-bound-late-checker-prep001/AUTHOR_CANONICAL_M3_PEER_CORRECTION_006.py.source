"""Own source/metadata correction only; generated definitions stay unexecuted."""
import ast
import datetime
import difflib
import hashlib
import json
import types
from pathlib import Path
P=Path(__file__).parent
WORK=P.parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def once(path,data):
    with path.open('xb')as f:f.write(data)
    assert path.read_bytes()==data
def emit(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii')
    once(P/name,data)
    return dict(path=name,sha256=sha(data),bytes=len(data))
def raw(path):
    st=path.lstat()
    return [getattr(st,k,None)for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
original=P/'review_guard006_actual_records_001.TEMPLATE.py'
composer=P/'compose-root-review-packet-006.TEMPLATE.py'
manifest=P/'AUTHOR_FROZEN_SOURCE_MANIFEST_005.json'
addendum=P/'AUTHOR_SOURCE_ADDENDUM_006.json'
inputs=[original,composer,manifest,addendum,P/'ACYCLIC_BOUND_MODEL_PEER_PROTOCOL_006.json',
 WORK/'metadata3-producer-core-prep001/capture-root-metadata003-corrected005.TEMPLATE.py',
 WORK/'metadata3-producer-core-prep001/BIND_SOURCE_AND_PHASES_003-corrected005.TEMPLATE.py',
 WORK/'metadata3-producer-core-prep001/SOURCE_SCHEMA_AND_REVIEW_CONTRACT_005.json',
 WORK/'metadata3-producer-core-prep001/STAGED_MANIFEST_005.json',
 WORK/'metadata3-actual-checker-prep001/review-metadata3-actual006.TEMPLATE.py',
 WORK/'metadata3-actual-checker-prep001/SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_001.json']
selected=P/'selected-canonical-peer-006';selected.mkdir(exist_ok=False)
rows=[];captured={}
for i,path in enumerate(inputs):
    passes=[]
    for unused in range(3):
        r=raw(path);b=path.read_bytes();assert r==raw(path)
        passes.append(dict(sha256=sha(b),bytes=len(b),raw9=r))
    assert all(value==passes[0]for value in passes)
    copy=selected/(str(i).zfill(2)+'.bytes');once(copy,b)
    assert raw(copy)[:2]!=r[:2]
    rows.append(dict(path=str(path),copy_path=str(copy),sha256=sha(b),bytes=len(b),passes=passes))
    captured[path]=b
assert sha(captured[manifest])=='8bf74ab72b00707291a1d2c51f91d7eaa713480e44fef338fdca38f5bcb5e6a1'
assert sha(captured[addendum])=='ffad921b0f3d4301133d6b935d9e395e5a26471cab3db89c5bb3d5f98114a399'
assert sha(captured[original])=='6ca3946b864525a89af9b1f42708d56a8cf74d0e2a5dbfcaedbee4eb7e8a5e2f'
assert sha(captured[composer])=='1b909f93c795c1d162b025ccf4917513ee20eb2edfd5d1db80ff78afebd1d911'
old=captured[original].decode()
old_literal='root / "INDEPENDENT_METADATA_STATIC_REVIEW_003.json"'
new_literal='WORK / "m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json"'
assert old.count(old_literal)==1
new=old.replace(old_literal,new_literal)
candidate=P/'review_guard006_actual_records_001-corrected006.TEMPLATE.py'
once(candidate,new.encode())
left,right=ast.parse(old),ast.parse(new)
lf={n.name:ast.dump(n,include_attributes=False)for n in left.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
rf={n.name:ast.dump(n,include_attributes=False)for n in right.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
assert set(lf)==set(rf)and len(lf)==34
assert [name for name in lf if lf[name]!=rf[name]]==['metadata_source_closure']
assert new.replace(new_literal,old_literal)==old
literal_values={n.targets[0].id:ast.literal_eval(n.value)for n in right.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id in ('SOURCE_BINDINGS','SOURCE_PROTOCOL')}
assert literal_values==dict(SOURCE_BINDINGS=None,SOURCE_PROTOCOL=None)
code=compile(right,str(candidate),'exec',dont_inherit=True,optimize=0)
codes=[]
def walk(c):
    codes.append(dict(name=c.co_name,qualname=c.co_qualname,flags=c.co_flags,argcount=c.co_argcount,byte_count=len(c.co_code)))
    for value in c.co_consts:
        if type(value)is types.CodeType:walk(value)
walk(code)
patch=''.join(difflib.unified_diff(old.splitlines(True),new.splitlines(True),fromfile=original.name,tofile=candidate.name))
once(P/'CANONICAL_M3_SOURCE_PEER_PATH_006.patch',patch.encode())
for row in rows:
    p=Path(row['path']);b=p.read_bytes()
    assert sha(b)==row['sha256']and raw(p)==row['passes'][0]['raw9']and Path(row['copy_path']).read_bytes()==b
    row['post_readback']=dict(sha256=sha(b),bytes=len(b),raw9=raw(p))
emit('CANONICAL_M3_PATH_AND_INERT_FACTS_006.json',dict(schema_version=1,record_type='guard006_canonical_M3_peer_path_source_correction',source_author='/root/pubnative_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),status='AUTHOR_FACTS_DIFFERENT_SOURCE_REVIEW_PENDING',finite_inputs=rows,preserved_source_manifest_sha256=sha(captured[manifest]),preserved_addendum_sha256=sha(captured[addendum]),changed_function_AST='metadata_source_closure',unchanged_other_function_AST_count=33,composer_byte_identical=True,exact_one_literal_byte_reversal=True,old_path='metadata3-producer-core-prep001/INDEPENDENT_METADATA_STATIC_REVIEW_003.json',selected_canonical_path='m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json',copy_analysis='Byte equality alone would preserve SHA, but does not satisfy contradictory old utility path and selected canonical packet-role equality. Using a copied utility role would require a distinct two-identity selection while producer/checker still read canonical input. Correction chooses the shared canonical path; no copy/alias/peer rewrite.',code_type_metadata=codes,inert_compilation_only=True,generated_definitions_or_mains_executed=False,helper_binding_or_tests_executed=False,SourceActualInputs=None,actual_results=None))
emit('SOURCE_BINDING_ALIGNMENT_006.json',dict(schema_version=1,record_type='guard006_corrected_source_binding_alignment',author='/root/pubnative_review',selected_utility_template=dict(path=candidate.name,sha256=sha(new.encode()),bytes=len(new.encode())),selected_composer_template=dict(path=composer.name,sha256=sha(captured[composer]),bytes=len(captured[composer])),utility_bound_path='review_guard006_actual_records_001.BOUND.py',composer_bound_path='compose-root-review-packet-006.BOUND.py',canonical_M3_peer_path=str(WORK/'m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json'),bound_model_peer20_path=str(WORK/'guard006-utility-source-independent-review001/INDEPENDENT_GUARD006_BOUND_SOURCE_POOL_REVIEW_001.json'),Root_GO13_added_keys=['composer_sha256','composer_source_binding_peer_sha256'],peer20_binding_data_keys=['utility_source_bindings','utility_source_protocol','composer_fresh_source_model'],schema_protocol_006_preserved_sha256=sha(captured[inputs[4]]),source_models=None,actual_binding=None,actual_peer20=None,actual_GO13=None,actual_results=None,operational_authority=False))
text='''Corrected006 selects the exact canonical M3 Source peer path used by the frozen corrected005 producer, binder and actual metadata checker. Only one path expression changes in metadata_source_closure; all33 other utility function ASTs and composer bytes remain exact. Original generic manifest005 and acyclic addendum006 remain exact history, including the different generic architecture acceptance of005.

A byte-identical peer copy would retain its SHA but would not satisfy both the old utility path assertion and the selected canonical packet-role assertion. Admitting a separate copied utility role would require explicit dual-identity selection and preservation while M3 producer/checker still read the canonical input. Corrected006 uses the single canonical review path and does not copy, alias or rewrite any peer.

Root GO13 uses exactly composer_sha256 and composer_source_binding_peer_sha256. Independent bound-model peer20 uses utility_source_bindings, utility_source_protocol and composer_fresh_source_model, and its fixed actual path is recorded in SOURCE_BINDING_ALIGNMENT_006.json. Pre-INIT configC selects only composer TEMPLATE T; finitelease precedes C, then P/INIT/trustR, actual B/U literal binding and different peer20 before capture. The independent generic architecture receipt19 remains ineligible as peer20/readiness.

Own checks were AST plus inert CodeType metadata only, with11 finite inputs three reads/copies/postread. All source models and actual bindings/peers/GO/results remain None. No helper main, target import/definition, binding or test ran. Original600 lifetime, both90 atGO, resource60 through spawn and Root450+after60/510 reserve remain unchanged. A different corrected generic source review and separate literal-pool review remain required before any retained actual entry.
'''
once(P/'HANDOFF_CORRECTED_006.md',text.encode())
payload_names=['AUTHOR_CANONICAL_M3_PEER_CORRECTION_006.py',candidate.name,'CANONICAL_M3_SOURCE_PEER_PATH_006.patch','CANONICAL_M3_PATH_AND_INERT_FACTS_006.json','SOURCE_BINDING_ALIGNMENT_006.json','HANDOFF_CORRECTED_006.md']+[str(p.relative_to(P)).replace('\\','/')for p in sorted(selected.iterdir())]
payloads=[]
for name in payload_names:
    b=(P/name).read_bytes();payloads.append(dict(path=name,sha256=sha(b),bytes=len(b)))
result=emit('AUTHOR_FROZEN_SOURCE_MANIFEST_006.json',dict(schema_version=1,record_type='guard006_corrected_generic_source_manifest',author='/root/pubnative_review',status='FROZEN_CORRECTED_SOURCE_ONLY_DIFFERENT_REVIEW_PENDING',payloads=payloads,preserved_manifest005_sha256=sha(captured[manifest]),preserved_addendum006_sha256=sha(captured[addendum]),active_source_rows=[dict(path=candidate.name,sha256=sha(new.encode()),bytes=len(new.encode())),dict(path=composer.name,sha256=sha(captured[composer]),bytes=len(captured[composer]))],SourceActualInputs=None,actual_binding=None,actual_peer20=None,actual_results=None,operational_authority=False))
print(json.dumps(dict(manifest=result,source_sha256=sha(new.encode()),source_bytes=len(new.encode()),payloads=len(payloads),generated_mains_executed=False)))
