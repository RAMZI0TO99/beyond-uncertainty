"""Own finite DATA/AST review. Never loads, compiles, or calls selected Sources."""
import ast
import hashlib
import json
import os
import stat
import sys
from datetime import datetime, timezone
from pathlib import Path

PROJECT=Path('D:/Aenv/pro2')
WORK=PROJECT/'resume-2026-10-03-continuation001'
SOURCE=WORK/'metadata3-actual-checker-prep001'
OWN=WORK/'metadata3-checker-source-independent010'
CAP=8388608
SCOPE='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
REVIEWER='/root/capsule_design_review'
AUTHOR='/root/actual_record_checker'

def need(value,message):
    if not value:raise ValueError(message)

def utc():return datetime.now(timezone.utc).isoformat(timespec='microseconds')
def sha(data):return hashlib.sha256(data).hexdigest()
def raw(value):
    return [value.st_dev,value.st_ino,value.st_size,value.st_mtime_ns,value.st_ctime_ns,value.st_mode,value.st_nlink,value.st_file_attributes,value.st_birthtime_ns]

def ancestors(path):
    values=[]
    for item in [*reversed(path.parents)]:
        row=item.lstat()
        need(stat.S_ISDIR(row.st_mode) and not row.st_file_attributes&1024,'plain ancestor '+str(item))
        values.append([str(item),row.st_dev,row.st_ino,row.st_mode,row.st_file_attributes])
    return values

def observe(path):
    path=Path(path)
    need(path.is_absolute() and path.is_relative_to(PROJECT),'finite project source '+str(path))
    chain=ancestors(path);before=path.lstat();a=raw(before)
    need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and not before.st_file_attributes&1024 and 0<=before.st_size<=CAP,'finite plain regular source '+str(path))
    with path.open('rb',buffering=0) as stream:
        opened=os.fstat(stream.fileno());b=raw(opened)
        need(stat.S_ISREG(opened.st_mode) and opened.st_nlink==1 and not opened.st_file_attributes&1024,'opened plain source')
        need(a[:4]+a[5:]==b[:4]+b[5:],'ordinary cross-API raw9 excluding only ctime '+str(path))
        data=stream.read(before.st_size+1)
        need(raw(os.fstat(stream.fileno()))==b,'same descriptor raw9 stable '+str(path))
    need(raw(path.lstat())==a and ancestors(path)==chain and len(data)==before.st_size,'same path raw9 and ancestor identity stable '+str(path))
    return data,dict(path=str(path),bytes=len(data),sha256=sha(data),path_raw9=a,descriptor_raw9=b)

def pairs(items):
    result={}
    for key,value in items:
        need(key not in result,'duplicate JSON key')
        result[key]=value
    return result

def decode(data):
    need(not data.startswith(b'\xef\xbb\xbf'),'no BOM')
    return json.loads(data.decode('utf8','strict'),object_pairs_hook=pairs,parse_constant=lambda value:(_ for _ in ()).throw(ValueError('nonfinite JSON')))

def typed(a,b):
    if type(a) is not type(b):return False
    if type(a) is dict:return set(a)==set(b) and all(typed(a[k],b[k]) for k in a)
    if type(a) in (list,tuple):return len(a)==len(b) and all(typed(x,y) for x,y in zip(a,b))
    return a==b

def encode(value):return (json.dumps(value,ensure_ascii=True,allow_nan=False,separators=(',',':'))+'\n').encode('ascii')

def write(path,data):
    need(path.is_relative_to(OWN) and len(data)<=CAP,'own finite write')
    with path.open('xb',buffering=0) as stream:need(stream.write(data)==len(data),'complete own write');os.fsync(stream.fileno())
    body,row=observe(path);need(body==data,'own exact readback')
    return row

REG={};DATA={}
def select(path,pin=None,size=None):
    path=Path(path);data,row=observe(path)
    need(pin is None or row['sha256']==pin,'selected SHA '+str(path))
    need(size is None or row['bytes']==size,'selected size '+str(path))
    if str(path) in REG:need(typed(REG[str(path)],row),'duplicate source stable')
    else:REG[str(path)]=row;DATA[str(path)]=data
    return data

def literal_values(tree):
    values={}
    for node in tree.body:
        if isinstance(node,ast.Assign):
            try:value=ast.literal_eval(node.value)
            except (ValueError,TypeError,SyntaxError):continue
            for target in node.targets:
                if isinstance(target,ast.Name):values[target.id]=value
    return values

def funcs(tree):return {node.name:ast.dump(node,include_attributes=False) for node in tree.body if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
def nonfunc(tree):return [ast.dump(node,include_attributes=False) for node in tree.body if not isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))]
def methods(tree):
    result={}
    for cls in [n for n in tree.body if isinstance(n,ast.ClassDef)]:
        for fn in cls.body:
            if isinstance(fn,ast.FunctionDef) and fn.name.startswith('test_'):
                need(fn.name not in result,'unique direct test method')
                result[fn.name]=(cls.name,fn)
    return result

def nodefacts(data,tree):
    rows=[]
    for node in ast.walk(tree):
        if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):
            rows.append(dict(name=node.name,kind=type(node).__name__,line=node.lineno,end_line=node.end_lineno,
                body_ast_sha256=sha(ast.dump(node,include_attributes=False).encode('utf8'))))
    return rows

def main():
    need(Path(os.path.realpath(sys.executable))==PROJECT/'runtimes/week8-python313-frozen-001/python.exe','pinned BASE313 observer')
    select(OWN/'AUDIT_CHECKER010_SOURCE_001.py')
