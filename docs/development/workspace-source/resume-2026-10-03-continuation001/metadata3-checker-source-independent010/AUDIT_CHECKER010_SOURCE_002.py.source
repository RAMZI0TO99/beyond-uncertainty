    manifest=decode(select(SOURCE/'AUTHOR_FROZEN_SOURCE_MANIFEST_010.json','624914bedda69ba654cf8ff273774bfb6054f936d61dec936c332b2e46dd0949',28249))
    author=decode(select(SOURCE/'AUTHOR_FRESH_SOURCE_METADATA_010.json','b82ec49ff6146e33dbad045892a77c66dae6e682cf1b8653e3a6264b5769b31f',378573))
    need(manifest['payload_count']==141 and len(manifest['payloads'])==141 and manifest['source_author']==AUTHOR and manifest['scope']==SCOPE,'manifest finite scope')
    payloads={}
    for row in manifest['payloads']:
        name=row['path'];path=SOURCE/name
        need(type(name) is str and not Path(name).is_absolute() and '..' not in Path(name).parts and name not in payloads,'confined unique manifest role')
        payloads[name]=row;select(path,row['sha256'],row['bytes'])
    oldmanifest=decode(select(SOURCE/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json','8b296a86c7912141f3e2b880927e515408b7d73994edde6b2bfd7f1676fa0e31',10908))
    need(len(oldmanifest['payloads'])==oldmanifest['payload_count']==55,'old55 manifest')
