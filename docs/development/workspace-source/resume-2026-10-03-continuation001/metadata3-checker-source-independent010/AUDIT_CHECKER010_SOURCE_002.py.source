        need(row['path'] in payloads and payloads[row['path']]['sha256']==row['sha256'] and payloads[row['path']]['bytes']==row['bytes'],'predecessor55 immutable manifest pins')
        select(SOURCE/row['path'],row['sha256'],row['bytes'])
    need(author['finite_input_count']==len(author['inputs'])==72,'finite72 author input pairs')
    for row in author['inputs']:
        path=Path(row['input_path']);body=select(path)
        now=REG[str(path)];need(len(row['observations'])==3 and all(typed(now,old) for old in row['observations']) and typed(now,row['post_read']),'full author original raw9 triple/post reproduction')
        copy=Path(row['owned_copy_path']);copybody=select(copy)
        need(copybody==body and typed(REG[str(copy)],row['owned_copy']) and typed(REG[str(copy)],row['owned_copy_post_read']),'author copied bytes/raw9/post reproduction')
    closeout=select(SOURCE/'HANDOFF_SOURCE010_AUTHOR_FREEZE_CLOSEOUT_001.md')
    priorfull=decode(select(WORK/'metadata3-checker009-independent-review001/INDEPENDENT_METADATA3_CHECKER009_SOURCE_DETAILS_001.json','556bd1a518caf9e284c00adab7fcd937ea71e31ab770bfb4257137e6b6cf0ebe',192565))
    helper=select(SOURCE/'review-metadata3-actual006-corrected010.TEMPLATE.py','9efa6deb54721a531159545ffa5e4e9bd90606f3dc12d7b0ab6cf5f4af51ee16',146200)
    old=select(SOURCE/'review-metadata3-actual006-corrected009.TEMPLATE.py','3c02e9898ed5fde8cf74f91ff780093ed66ca2a8807a1be2dfe1c9e8976d14e6',146200)
    delta=decode(DATA[str(SOURCE/'CHECKER010_LITERAL_DELTA_AND_FRESH_ROLES_001.json')])
    reversed_bytes=helper;count=0
    for row in delta['replacements']:
        a=row['original'].encode('ascii');b=row['selected'].encode('ascii');n=row['occurrences']
        need(old.count(a)==helper.count(b)==n and a not in helper,'exact unique identity replacement')
        reversed_bytes=reversed_bytes.replace(b,a);count+=n
    need(count==10 and reversed_bytes==old,'complete ten literal byte reversal to009')
    oldtree=ast.parse(old);tree=ast.parse(helper);oldfn=funcs(oldtree);newfn=funcs(tree)
    changed=[name for name in oldfn if oldfn[name]!=newfn[name]]
    need(len(oldfn)==len(newfn)==69 and list(oldfn)==list(newfn) and changed==['configure','root_trust_preflight','decision'],'69 functions exact3 changed')
    need(nonfunc(oldtree)==nonfunc(tree) and oldfn['main']==newfn['main'],'nonfunction/main exact')
    test=select(SOURCE/'test_metadata3_actual_checker_preparation_004.py','daf2d526c1d751e6b10b78d8b421bdd2329b652e3a8cba23a761fcde35931fd9',52200)
    oldtest=select(SOURCE/'test_metadata3_actual_checker_preparation_003.py','11babbb00b240059ce441b37e2b4bcbcd3167ff44f674dc3229578a63dd865db',34563)
    testtree=ast.parse(test);oldtests=methods(ast.parse(oldtest));tests=methods(testtree)
    need(len(oldtests)==25 and len(tests)==28 and all(ast.dump(tests[name][1],include_attributes=False)==ast.dump(pair[1],include_attributes=False) for name,pair in oldtests.items()),'25 old direct test ASTs exact of28')
    added=sorted(set(tests)-set(oldtests))
    need(added==['test_fresh_configure_fixed_self_peer003_and_config002_refuse_old_aliases','test_fresh_decision_reopens_current_peer003_config002_before_provenance_or_output','test_fresh_root_trust002_pipeline007_peer002_init002_and_transitive_guards'],'three exact new controls')
    protocol=decode(DATA[str(SOURCE/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_010.json')]);values=literal_values(tree)
    for key,value in protocol['closed_source_literal_schemas'].items():need(list(values[key])==value,'exact Source literal protocol '+key)
    need(values['PHASES']=={key:tuple(row) for key,row in protocol['core_phase_types_verdicts_leaves'].items()},'eight exact core phase types/verdict/leaves')
