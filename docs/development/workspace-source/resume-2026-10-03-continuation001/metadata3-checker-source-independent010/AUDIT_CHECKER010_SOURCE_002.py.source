    ]
    full=dict(schema_version=1,record_type='independent_metadata3_checker010_full_source_review',created_utc=utc(),reviewer=REVIEWER,source_author=AUTHOR,scope=SCOPE,verdict='PASS_STATIC_METADATA3_CHECKER010_SOURCE_ONLY',
      source_manifest_sha256='624914bedda69ba654cf8ff273774bfb6054f936d61dec936c332b2e46dd0949',manifest_payload_count=141,predecessor_payload_count=55,author_input_pair_count=72,
      finite_input_count=len(entries),observations_preserved=entries,post=postrow,checker_function_count=69,changed_function_names=changed,unchanged_function_count=66,main_AST_exact=True,nonfunction_AST_exact=True,literal_reversal_count=count,
      selected_checker=dict(path=str(SOURCE/'review-metadata3-actual006-corrected010.TEMPLATE.py'),bytes=len(helper),sha256=sha(helper)),selected_test=dict(path=str(SOURCE/'test_metadata3_actual_checker_preparation_004.py'),bytes=len(test),sha256=sha(test)),
      direct_test_methods=[dict(class_name=pair[0],method=name,line=pair[1].lineno,end_line=pair[1].end_lineno,body_AST_sha256=sha(ast.dump(pair[1],include_attributes=False).encode('utf8'))) for name,pair in sorted(tests.items())],
      new_test_names=added,prior25_ASTs_exact=True,complete_selected_python_AST_metadata=astfacts,source_checks=checks,findings=[],advisories=['Inherited scope_limitations sentence says planned nine tests; explicit selected_planned_tests correctly names all28. Historical synthetic counts are not current results.'],implementation_conditions=conditions,
      actual_source_peer003=None,actual_binding=None,actual_nonce=None,actual_model_pool=None,actual_ready=None,actual_test_results=None,tests_executed=False,target_execution=False,selected_source_definitions_imports_compilers_mains_executed=False,runtime_acceptance=False,operational_authority=False)
    detailrow=write(OWN/'INDEPENDENT_METADATA3_CHECKER010_SOURCE_DETAILS_001.json',encode(full))
    summary=dict(schema_version=1,record_type='independent_metadata3_checker010_source_review',created_utc=utc(),reviewer=REVIEWER,source_author=AUTHOR,scope=SCOPE,verdict=full['verdict'],checker_template_sha256=sha(helper),test_source_sha256=sha(test),source_manifest_sha256=full['source_manifest_sha256'],full_source_details_sha256=detailrow['sha256'],target_execution=False,actual_binding=None,tests_executed=False,runtime_acceptance=False,operational_authority=False)
    summaryrow=write(OWN/'INDEPENDENT_METADATA3_CHECKER010_SOURCE_REVIEW_001.json',encode(summary))
