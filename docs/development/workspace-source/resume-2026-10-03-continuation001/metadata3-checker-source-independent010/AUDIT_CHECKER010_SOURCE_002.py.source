    need(len(values['CORE_KEYS'])==12 and len(values['PROJECTION_KEYS'])==13 and len(values['PHASE_PEER_KEYS'])==20,'Core12/projection13/phase20')
    need(protocol['selected_planned_tests']['planned_count']==28 and protocol['selected_planned_tests']['methods']==sorted(tests) and protocol['selected_planned_tests']['actual_results'] is None and protocol['selected_planned_tests']['executed'] is False,'truthful selected28 Source plan')
    config=decode(DATA[str(SOURCE/'ACTUAL_CHECKER_BINDING_010.TEMPLATE.json')])
    need(len(config)==18 and list(config)==protocol['config18_keys'] and config['checker_template_sha256']==sha(helper),'unbound compiled config18')
    need(config['checker_source_peer_sha256'] is None and config['execution_launch_witness']['nonce'] is None and config['owner_lease_sha256'] is None and config['owner_lease_end_utc'] is None and config['maximum_wait_seconds'] is None and config['actual_actions_executed'] is False,'actual authority slots None')
    need(all(value is None for value in config['metadata_bindings'].values()) and all(row['sha256'] is None for key in ('metadata_sources','phase_sources','whole_sources','guard_sources') for row in config[key].values()),'actual source pins None')
    need(config['root_pipeline_source']['sha256'] is None and config['root_pipeline_source']['source_peer_sha256'] is None,'Root actual source pins None')
    need(protocol['limits']==dict(original_context_seconds=600,both_original_context_and_runtime_at_unit_GO_seconds=90,GO_reserve_seconds=510,unit_seconds=450,after_reserve_seconds=60,resource_seconds_through_spawn=60,maximum_wait_seconds=3600,chunks_combined=32,each_chunk_bytes=131072,stream_combined_bytes=4194304,rows_combined=4096,canonical_row_bytes_including_LF=1024,transcript_bytes=262144,unit_receipt_bytes=262144,physical_stdout_or_stderr_bytes=131072),'unchanged exact limits')
    # Parse all selected Python source copies as inert AST data, never CodeType.
    astfacts=[]
    for path,data in DATA.items():
        if Path(path).suffix=='.py':
            parsed=ast.parse(data)
            astfacts.append(dict(path=path,bytes=len(data),sha256=sha(data),whole_AST_sha256=sha(ast.dump(parsed,include_attributes=False).encode('utf8')),definitions=nodefacts(data,parsed)))
    rootchoices=protocol['fresh_source_successor']
    need(all(rootchoices[key] is None for key in ('actual_source_peer','actual_binding','actual_execution_nonce','actual_tests'))
         and rootchoices['parent_reported_reader_successor_planning']['actual_source_choice004'] is None
         and rootchoices['parent_reported_reader_successor_planning']['actual_bound_pool'] is None,'planning only')
    # Three distinct complete observations, independent selected byte copies, post.
    entries=[];copydir=OWN/'finite-source-copies001';copydir.mkdir(exist_ok=False)
    for index,(path,baseline) in enumerate(REG.items()):
        observations=[]
        for phase in range(3):
            data,row=observe(Path(path));need(data==DATA[path] and typed(row,baseline),'independent triple unchanged');observations.append(row)
        copy=copydir/(str(index).zfill(3)+'-'+Path(path).name);copyrow=write(copy,DATA[path])
        entries.append(dict(path=path,observations=observations,owned_copy=copyrow))
    post=[]
    for row in entries:
        data,current=observe(Path(row['path']));copybody,copycurrent=observe(Path(row['owned_copy']['path']))
        need(data==DATA[row['path']]==copybody and typed(current,REG[row['path']]) and typed(copycurrent,row['owned_copy']),'post full raw9 original/copy unchanged')
        post.append(dict(original=current,owned_copy=copycurrent))
    postrow=write(OWN/'POST_METADATA3_CHECKER010_SOURCE_REVIEW_001.json',encode(dict(schema_version=1,record_type='independent_checker010_source_post',reviewer=REVIEWER,created_utc=utc(),finite_input_count=len(entries),rows=post,target_execution=False)))
    checks=[
      'Read complete current69-function checker and28-method test source, both handoffs, freezer, authoring scripts and protocol; pin all141 frozen payloads, all55 predecessor payloads and72 original/copy pairs.',
