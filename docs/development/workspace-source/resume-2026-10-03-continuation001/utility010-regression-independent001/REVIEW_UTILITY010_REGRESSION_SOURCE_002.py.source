copies=OWN/'inputs002';copies.mkdir(exist_ok=False)
collection=[];contents={};inventory=[]
for index,(name,(length,pin))in enumerate(sorted(expected.items())):
    p=Path(name);assert p.is_relative_to(WORK)
    readings=[]
    for _ in range(3):body,row=read(p);readings.append(row)
    assert readings[0]==readings[1]==readings[2] and (len(body),sha(body))==(length,pin)
    target=copies/(f'{index:03d}_'+p.name);once(target,body)
    collection.append(dict(original_path=str(p),copy_path=str(target),triple_original=readings,copy=read(target)[1]))
    contents[str(p)]=body
    kind='other';detail={}
    if p.suffix.lower()=='.json':
        value=decode_inventory(body);kind='JSON';detail=dict(top_level_keys=sorted(value)if type(value)is dict else None,record_type=value.get('record_type')if type(value)is dict else None)
    elif p.suffix.lower()=='.py':
        tree=ast.parse(body,filename=str(p));kind='Python_AST_only'
        detail=dict(module_ast_sha256=sha(dump(tree).encode()),top_level_functions=[dict(name=n.name,line=n.lineno,end_line=n.end_lineno,ast_sha256=sha(dump(n).encode()))for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))],classes=[dict(name=n.name,line=n.lineno,end_line=n.end_lineno,methods=[dict(name=m.name,line=m.lineno,end_line=m.end_lineno,ast_sha256=sha(dump(m).encode()))for m in n.body if isinstance(m,(ast.FunctionDef,ast.AsyncFunctionDef))])for n in tree.body if isinstance(n,ast.ClassDef)])
    inventory.append(dict(path=str(p),bytes=len(body),sha256=pin,kind=kind,review=detail))

