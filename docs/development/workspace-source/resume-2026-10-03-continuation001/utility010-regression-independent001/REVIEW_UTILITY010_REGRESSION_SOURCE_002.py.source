    expected[str(p)]=(row['bytes'],row['sha256'])
obs=decode(read(AUTHOR/'FINITE_SOURCE_OBSERVATIONS_001.json')[0])
assert obs['selected_pair_count']==15 and len(obs['selected_pairs'])==15
assert obs['preserved_manifest_payload_counts']==[41,17,24]and len(obs['preserved_before_and_post'])==82
assert obs['tests_executed']is False and obs['target_execution']is False and obs['actual_actions']is None
author_pair_proofs=[]
for row in obs['selected_pairs']:
    triple=row['triple_original'];assert len(triple)==3 and triple[0]==triple[1]==triple[2]==row['post_original']
    assert row['copy']==row['post_copy']
