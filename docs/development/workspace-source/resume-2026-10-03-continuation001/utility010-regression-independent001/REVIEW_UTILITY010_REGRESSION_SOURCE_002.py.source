    assert (original['bytes'],original['sha256'])==(copy['bytes'],copy['sha256'])
    expected[row['original_path']]=(original['bytes'],original['sha256'])
    expected[row['copy_path']]=(copy['bytes'],copy['sha256'])
    author_pair_proofs.append(dict(original=row['original_path'],copy=row['copy_path'],bytes=original['bytes'],sha256=original['sha256'],three_and_post_exact=True))
for row in obs['preserved_before_and_post']:
