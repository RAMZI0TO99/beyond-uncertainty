MANIFEST_PIN='8e42b4fe12f2326b3840ea10eda06bac7c42dfa8a74c06eaedb787e0e559cd0a'
KEYS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
API8=(0,1,2,3,5,6,7,8)
MAXIMUM=8388608
def sha(b):return hashlib.sha256(b).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
    result={}
    for k,v in rows:
        assert k not in result,('duplicate JSON key',k)
        result[k]=v
    return result
def bad(v):raise ValueError('nonfinite/float Source JSON '+v)
def decode(b):return json.loads(b,object_pairs_hook=pairs,parse_constant=bad,parse_float=bad)
def decode_inventory(body):
    if sha(body)=='345d2bb4674da2e985be8f9356641d7f39377bd6d54cacdfcb99fa6718dc22e0':
        value=json.loads(body,object_pairs_hook=pairs,parse_constant=bad,parse_float=Decimal)
        assert value['record_type']=='root_source_diagnostic_physical_tool_correlation' and value['author']=='/root'
        assert value['owning_tool_chunk']=='93f931' and value['wall_time_seconds']==Decimal('0.8142997')
        assert type(value['wall_time_seconds'])is Decimal and all(type(v)is not Decimal for k,v in value.items()if k!='wall_time_seconds')
        return value
    return decode(body)
def raw(s):
    r=[getattr(s,k,None)for k in KEYS];assert all(type(v)is int for v in r)
    return r
def read(p):
    assert p.is_absolute() and '..' not in p.parts
    a=p.lstat();ar=raw(a)
    assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not a.st_file_attributes&0x400 and 0<a.st_size<=MAXIMUM
    ancestors=[]
    for q in p.parents:
        s=q.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&0x400
        ancestors.append([str(q),s.st_dev,s.st_ino])
    with p.open('rb')as h:
        s=os.fstat(h.fileno());hr=raw(s)
        assert stat.S_ISREG(s.st_mode)and s.st_nlink==1 and not s.st_file_attributes&0x400
        assert all(ar[i]==hr[i]for i in API8)and ar[4]==ar[8]
        body=h.read(MAXIMUM+1);assert raw(os.fstat(h.fileno()))==hr
    assert len(body)==ar[2]and len(body)<=MAXIMUM and raw(p.lstat())==ar
    assert ancestors==[[str(q),q.lstat().st_dev,q.lstat().st_ino]for q in p.parents]
    return body,dict(path=str(p),bytes=len(body),sha256=sha(body),path_raw9=ar,descriptor_raw9=hr,paired_API8=[ar[i]for i in API8],cross_API_ctime_equality_asserted=False)
def once(p,b):
    with p.open('xb')as f:f.write(b);f.flush();os.fsync(f.fileno())
    assert read(p)[0]==b
def dump(n):return ast.dump(n,include_attributes=False)
def funcs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
def protected(b):
    r=set()
    for t in tokenize.tokenize(io.BytesIO(b).readline):
        if t.type==tokenize.STRING and t.end[0]>t.start[0]:r.update(range(t.start[0]+1,t.end[0]+1))
    return r
def compact(b):
    hold=protected(b);lines=b.splitlines(keepends=True)
    for i,line in enumerate(lines,1):
        count=len(line)-len(line.lstrip(b' '))
        if i not in hold and count>0 and count%4==0:lines[i-1]=b' '*(count//4)+line[count:]
    return b''.join(lines)

