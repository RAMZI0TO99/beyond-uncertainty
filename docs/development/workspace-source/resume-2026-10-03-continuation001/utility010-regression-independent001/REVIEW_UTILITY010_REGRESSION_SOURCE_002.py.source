manifest=decode(manifest_bytes);assert manifest['payload_count']==21 and len(manifest['payloads'])==21
assert manifest['tests_executed']is False and manifest['results']is None and manifest['actual_actions']is None and manifest['operational_authority']is False
expected={str(AUTHOR/'AUTHOR_FROZEN_SOURCE_MANIFEST_001.json'):(len(manifest_bytes),MANIFEST_PIN)}
