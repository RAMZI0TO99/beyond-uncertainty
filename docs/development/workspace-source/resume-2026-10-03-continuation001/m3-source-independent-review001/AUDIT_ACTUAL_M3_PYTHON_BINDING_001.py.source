 'raw_source_sha256':('consumer005-guard006-runtime-prep001/inputs/raw004-source.bytes','da64c4ea68e86bbcd28f7fbccd60baa765cc534afa532c14cd7cb39de782b211'),
 'source_manifest_sha256':('consumer005-guard006-runtime-prep001/inputs/SOURCE_STAGED_MANIFEST_005.json','169d559bdb54c32dce439bd815dd1e28e895b65826db3e7d4310315b8a5edabc'),
 'source_peer_sha256':('consumer005-guard006-runtime-prep001/inputs/ACTUAL_SOURCE_CAPSULE_005.json','4c81e41d926eea61805eac23b5c616931fa3c86b4db1e794f8f28a2f04c26fa8'),
 'guard_harness_static_review_sha256':('consumer005-guard006-runtime-prep001/INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_006.json','787a60b216f1ac00e7e78f1f0c20d232e0656793cc8c4c02fb646c1aa7d21292'),
 'preparer_static_review_sha256':('m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json','78bc1b1a7a3e06e6752283e632651faac1b07f8f307f1612ceac4b1bd015bf30')}
exact(plan['bindings'],set(known)|{'coordination_peer_reply_sha256','coordination_root_response_sha256'})
for k,(p,h) in known.items():assert plan['bindings'][k]==h;pins[BASE/p]=h
