assert coord['state']=='conditional_ack_pending_concrete_interval_and_root_go' and coord['window_start_utc'] is None and coord['window_end_utc'] is None and coord['whole_host_quiet_or_exclusive_lease_attested'] is False and coord['no_pro3_compute_grant_inferred'] is True
assert response['concrete_execution_interval'] is None and response['Root_GO'] is None and response['capture_timer_started'] is False and response['current_tests_started'] is False and response['sole_executor_resource_lease_or_host_quiet'] is False
nominal(response['peer_source'],dict(copied_path=str(BASE/roles['COORDINATION_PEER_REPLY_RELATIVE']),sha256=plan['bindings']['coordination_peer_reply_sha256'],bytes=len(data[BASE/roles['COORDINATION_PEER_REPLY_RELATIVE']])))
now=datetime.datetime.now(datetime.timezone.utc);delta=now-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc);assert start<=(delta.days*86400+delta.seconds)*10000000+delta.microseconds*10<end
template=data[META/'capture-root-metadata003-corrected005.TEMPLATE.py'];bound=data[boundp]
values=dict(BINDINGS=plan['bindings'],OWNER_SHA=args.lease,OWNER_END=lease['lease_end_utc'],**roles)
original=literal_nodes(template,values);actual=literal_nodes(bound,values);edits=[];lines=bound.splitlines(keepends=True);oldlines=template.splitlines(keepends=True)
for name,value in values.items():
 assert type(ast.literal_eval(actual[name])) is type(value) and ast.literal_eval(actual[name])==value
 expected={k:None for k in plan['bindings']} if name=='BINDINGS' else None;assert ast.literal_eval(original[name])==expected
 n=actual[name];o=original[name];s=sum(map(len,lines[:n.lineno-1]))+n.col_offset;e=sum(map(len,lines[:n.end_lineno-1]))+n.end_col_offset
 os_=sum(map(len,oldlines[:o.lineno-1]))+o.col_offset;oe=sum(map(len,oldlines[:o.end_lineno-1]))+o.end_col_offset;edits.append((s,e,template[os_:oe]))
reverse=bound
for s,e,v in sorted(edits,reverse=True):reverse=reverse[:s]+v+reverse[e:]
assert reverse==template and funcs(bound)==funcs(template) and len(bound)<=65536
