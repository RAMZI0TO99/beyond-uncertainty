for role,key in (('COORDINATION_PEER_REPLY_RELATIVE','coordination_peer_reply_sha256'),('COORDINATION_ROOT_RESPONSE_RELATIVE','coordination_root_response_sha256')):
 value=roles[role];assert type(value) is str and 0<len(value)<=399 and '\\' not in value and not value.startswith('/') and all(v not in ('','.','..') and ':' not in v for v in value.split('/'))
 assert re.fullmatch('[0-9a-f]{64}',plan['bindings'][key]);pins[BASE.joinpath(*value.split('/'))]=plan['bindings'][key]
observations=[];data=None
for phase in range(3):
 current={};rows=[]
 for p in sorted(pins,key=str):
  b,r=read(p);assert sha(b)==pins[p],str(p);current[p]=b;rows.append(r)
 if data is None:data=current
 else:assert current==data
 observations.append(dict(phase=phase+1,rows=rows))
binding=parse(data[bindingp]);exact(binding,('schema_version','binder','template_sha256','actual_script_sha256','bindings','role_selections','exact_six_assignment_reversal','exact_function_ASTs','actual_before_authorization','actual_after_authorization','target_capture_executed'))
producer=parse(data[producerp]);nominal(producer,dict(schema_version=1,record_type='root_m3_python_source_binding_producer_observation',author='/root',scope=SCOPE,source_author='/root/renewal_runtime_inventory',source_binder_sha256='3b565b5e7a13b5b8c03754ae347d9d9ae626d44b3878022de8729259da54db56',source_peer_sha256=pins[sourcepeer],stage='python_source_only',capture_timer_started=False,authorization_created=False,current_tests_run=False,independent_acceptance=False,operational_authority=False))
nominal(producer['root_tool'],dict(chunk_id='7952f8',exit_code=0,complete_tool_return=True,session_id=None));assert producer['root_plan_creation_tool']=='7bbc31';ticks(producer['created_utc'])
for p,h in ((planp,args.plan),(bindingp,args.binding),(boundp,args.bound)):
 row=producer['selected_sources'][p.name];exact(row,('path','sha256','bytes'));nominal(row,dict(path=str(p),sha256=h,bytes=len(data[p])))
nominal(binding,dict(schema_version=1,binder='/root',template_sha256='c874f620f7f342e3b04ce7bf6c88969d51ed73d9f5801a45b851563eb8eebdc6',actual_script_sha256=args.bound,bindings=plan['bindings'],role_selections=roles,exact_six_assignment_reversal=True,exact_function_ASTs=True,actual_before_authorization=None,actual_after_authorization=None,target_capture_executed=False))
