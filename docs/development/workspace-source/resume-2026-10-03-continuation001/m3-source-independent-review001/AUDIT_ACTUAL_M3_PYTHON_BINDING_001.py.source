sourcepeer=OUT/'INDEPENDENT_M3_SOURCE_REVIEW_002.json';peer=parse(sourcepeer.read_bytes());assert sha(sourcepeer.read_bytes())=='78bc1b1a7a3e06e6752283e632651faac1b07f8f307f1612ceac4b1bd015bf30'
planp=META/'SOURCE_BINDING_PLAN_003.json';plan=parse(planp.read_bytes());assert sha(planp.read_bytes())==args.plan
