"""Own finite phase-source review; no reviewed definitions or phase mains run."""
import ast,datetime,hashlib,json,os,re,stat
from pathlib import Path
BASE=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001');META=BASE/'metadata3-producer-core-prep001';OUT=BASE/'m3-source-independent-review001'
SCOPE='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
PHASE_SHA='e782bfc525dadf8ce5e81acac87c428d4c6eabff3dd1b2b7937edd2d1c952d27'
BOUND_SHA='133e68be431896253adb6880170409adc53c27d56adc7d2ee43a7225ca2feb37'
REVIEW_SHA='84f4876e2331392cfbe881c20ba770c620be6c961e41e3a9355fe56e77d00474'
def sha(b):return hashlib.sha256(b).hexdigest()
def utc():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def enc(x):return (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(x):raise ValueError(x)
def parse(b):return json.loads(b.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def raw(s):return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def read(p):
 s=p.lstat();assert stat.S_ISREG(s.st_mode) and s.st_nlink==1 and not s.st_file_attributes&1024
 with p.open('rb',buffering=0) as f:a=os.fstat(f.fileno());b=f.read(s.st_size+1);z=os.fstat(f.fileno())
 assert raw(s)==raw(p.lstat()) and raw(a)==raw(z) and len(b)==s.st_size
 assert [raw(s)[i] for i in (0,1,2,3,5,6,7,8)]==[raw(a)[i] for i in (0,1,2,3,5,6,7,8)]
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),path_raw9=raw(s),descriptor_raw9=raw(a),observed_utc=utc())
def once(p,b):
 with p.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
def exact(v,keys):assert type(v) is dict and set(v)==set(keys)
def nominal(v,wanted):
 for k,x in wanted.items():assert type(v[k]) is type(x) and v[k]==x,k
oldp=OUT/'INDEPENDENT_ACTUAL_M3_PYTHON_SOURCE_DETAILS_001.json';oldb=oldp.read_bytes();assert sha(oldb)=='89d7a1fbcf6aef8b396b8ce79e5115c2c4fa7ffab19968fe65ba9eba1c996e30';old=parse(oldb)
pins={Path(r['path']):r['sha256'] for r in old['preserved_inputs']}
phasep=META/'PHASE_PS_SOURCE_BINDING_003.json';producerp=META/'ROOT_POWERSHELL_SOURCE_BINDING_PRODUCER_OBSERVATION_003.json';syntaxp=OUT/'INDEPENDENT_ACTUAL_M3_PHASE_SOURCE_SYNTAX_001.json';reviewp=META/'INDEPENDENT_BOUND_METADATA_REVIEW_003.json'
pins.update({oldp:sha(oldb),OUT/'INDEPENDENT_ACTUAL_M3_PYTHON_SOURCE_POST_001.json':'de034954e706cf7edffd5368f591a3a784675cbeb0663b0afe0266a8185352b1',phasep:PHASE_SHA,producerp:'6ee7e8c052b4dfda3b58e36c18e06805cd0247ffa484014b5f89c7360264b9ec',syntaxp:'6c20f93dffc9f484fb196c8e5fc4c00f8edac9d311e0719cc2b493f143a14b66',reviewp:REVIEW_SHA})
phase=parse(phasep.read_bytes());assert sha(phasep.read_bytes())==PHASE_SHA
rows=phase['sources'];assert type(rows) is list and len(rows)==4
for r in rows:exact(r,('path','sha256','template_sha256','exact_two_literal_reversal'));pins[Path(r['path'])]=r['sha256']
checker=BASE/'metadata3-actual-checker-prep001/review-metadata3-actual006-corrected008.TEMPLATE.py';pins[checker]='c097c756d8cf55b1ac98a68313f5e406455b9306af63bd48a6e1cb3add70d3c1'
observations=[];data=None
for phase_index in range(3):
 current={};observed=[]
 for p in sorted(pins,key=str):
  b,r=read(p);assert sha(b)==pins[p],str(p);current[p]=b;observed.append(r)
 if data is None:data=current
 else:assert current==data
 observations.append(dict(phase=phase_index+1,rows=observed))
exact(phase,('schema_version','binder','sources','actual_script_sha256','bound_review_sha256','actual_authorization','prepared_source_actions_executed'))
nominal(phase,dict(schema_version=1,binder='/root',actual_script_sha256=BOUND_SHA,bound_review_sha256=REVIEW_SHA,actual_authorization=None,prepared_source_actions_executed=False))
review=parse(data[reviewp]);exact(review,('actual_script_sha256','metadata_only','phase_set','record_type','reviewer','schema_version','source_author','source_bindings','verdict'))
nominal(review,dict(schema_version=1,record_type='guard006_root_metadata_bound_source_review',reviewer='/root/owner_docs_review',source_author='/root/renewal_runtime_inventory',verdict='PASS_STATIC_BOUND_METADATA_ONLY',metadata_only=True,phase_set=['before','after'],actual_script_sha256=BOUND_SHA,source_bindings=parse(data[META/'ACTUAL_SOURCE_BINDING_003.json'])['bindings']))
syntax=parse(data[syntaxp]);assert syntax['target_execution'] is False and syntax['runtime_acceptance'] is False and syntax['phase_source_binding_sha256']==PHASE_SHA and len(syntax['rows'])==4
names=('WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_003','SUPERVISE_ROOT_METADATA_BEFORE_003','WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_003','SUPERVISE_ROOT_METADATA_AFTER_003')
peer_rows=[]
for name,row,syn in zip(names,rows,syntax['rows']):
 p=META/(name+'.BOUND.ps1');templatep=META/(name+('-corrected004' if name.startswith('SUPERVISE_') else '')+'.TEMPLATE.ps1');original=data[templatep];actual=data[p]
 nominal(row,dict(path=str(p),template_sha256=sha(original),exact_two_literal_reversal=True));nominal(syn,dict(path=str(p),sha256=sha(actual),bytes=len(actual),parser_errors=[],target_execution=False))
 assert len(actual)<=65536
 text=actual.decode('utf8','strict');reverse=text
 for key,pin in (('BoundScriptSha256',BOUND_SHA),('BoundReviewSha256',REVIEW_SHA)):
  pattern=r'(?m)^\$'+key+r" = '"+pin+r"'(\r?)$";assert len(re.findall(pattern,text))==1
  reverse=re.sub(pattern,lambda m:'$'+key+' = $null'+m.group(1),reverse)
 assert reverse.encode('utf8')==original
 peer_rows.append(dict(path=str(p),sha256=sha(actual),bytes=len(actual),template_sha256=sha(original),exact_two_literal_reversal=True,PowerShell_parser_errors=0))
producer=parse(data[producerp]);nominal(producer,dict(schema_version=1,record_type='root_m3_powershell_source_binding_producer_observation',author='/root',scope=SCOPE,source_binder_sha256='3b565b5e7a13b5b8c03754ae347d9d9ae626d44b3878022de8729259da54db56',actual_bound_review_sha256=REVIEW_SHA,four_powershell_sources_created_only=True,authorization_or_supervisor_source_actions_executed=False,capture_timer_started=False,current_tests_run=False,independent_phase_acceptance=False,operational_authority=False))
nominal(producer['root_tool'],dict(chunk_id='9c5122',exit_code=0,session_id=None,complete_tool_return=True))
for p in (reviewp,phasep,*[Path(r['path']) for r in peer_rows]):
 row=producer['selected_sources'][p.name];exact(row,('path','sha256','bytes'));nominal(row,dict(path=str(p),sha256=sha(data[p]),bytes=len(data[p])))
peer20=dict(PowerShell_parser_errors=0,actual_authorization_or_entry_approved=False,after_supervisor_sha256=peer_rows[3]['sha256'],after_writer_sha256=peer_rows[2]['sha256'],binding_author='/root',bound_metadata_source_sha256=BOUND_SHA,bound_source_review_sha256=REVIEW_SHA,created_utc=utc(),exact_two_literal_reversal_all_four=True,metadata_only=True,phase_source_binding_sha256=PHASE_SHA,phase_sources=peer_rows,record_type='guard006_root_metadata_phase_ps_source_binding_review',reviewer='/root/owner_docs_review',reviewer_agent='/root/owner_docs_review',schema_version=1,source_author='/root/renewal_runtime_inventory',supervisor_sha256=peer_rows[1]['sha256'],verdict='PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY',writer_sha256=peer_rows[0]['sha256'])
tree=ast.parse(data[checker]);keys=[ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='PHASE_PEER_KEYS' for t in n.targets)];assert len(keys)==1 and len(peer20)==20 and set(peer20)==set(keys[0]) and 'scope' not in peer20
copydir=OUT/'actual-phase-binding-before001';assert not copydir.exists();copydir.mkdir();preserved=[]
for i,p in enumerate(sorted(data,key=str)):
 cp=copydir/f'{i:03d}.bytes';once(cp,data[p]);assert read(cp)[0]==data[p];preserved.append(dict(path=str(p),copy=str(cp),sha256=sha(data[p]),bytes=len(data[p])))
pre=[]
for p in sorted(data,key=str):b,r=read(p);assert b==data[p];pre.append(r)
details=dict(schema_version=1,record_type='independent_actual_m3_phase_source_binding_details',created_utc=utc(),reviewer='/root/owner_docs_review',source_author='/root/renewal_runtime_inventory',binding_author='/root',scope=SCOPE,verdict='PASS_COMPLETE_ACTUAL_PHASE_SOURCE_BINDINGS_ONLY',finite_input_count=len(data),observations=observations,preserved_inputs=preserved,prepublication_observations=pre,phase_source_binding_sha256=PHASE_SHA,bound_metadata_source_sha256=BOUND_SHA,bound_source_review_sha256=REVIEW_SHA,root_producer_observation_sha256=pins[producerp],root_tool_identity_attributed='Root9c5122 exit0; producer writer5f14d8',independent_OS_tool_attestation=False,syntax_observation_sha256=pins[syntaxp],source_checks=['All29 prior Python-review input bytes reobserved exact; Bound9 and prior details/post preserved.','Actual closed phase binding7 four ordered closed row4 sources authenticated to current accepted four templates; each exact two literal reversal recovers full bytes including original CR line endings.','Four actual PowerShell files independently ParseFile with zero parser errors; no reviewed function or main invoked. Entire source reversal preserves all function bodies and control flow.','Authentic Phase20 reader ABI in selected checker008 independently inspected: no scope field, exact canonical reviewer/reviewer_agent and source/binding authors, ordered row6 facts, genuine Py6 timestamp.','Producer observation is externally selected Root attribution, independently checked against all six published source inputs; it supplies no independent OS process or tool attestation.','Original finite PS7 lease/end and conditional coordination remain source selections; no interval, GO, capture readiness, resource lease, quiet or runtime approval is inferred.'],findings=[],actual_authorization=None,actual_capture=None,current_tests_executed=False,target_definitions_executed=False,operational_authority=False,runtime_acceptance=False)
rp=OUT/'INDEPENDENT_ACTUAL_M3_PHASE_SOURCE_DETAILS_001.json';once(rp,enc(details))
pp=META/'INDEPENDENT_ROOT_METADATA_PHASE_PS_BINDING_REVIEW_003.json';once(pp,enc(peer20))
post=[]
for p in sorted(data,key=str):b,r=read(p);assert b==data[p];post.append(r)
postp=OUT/'INDEPENDENT_ACTUAL_M3_PHASE_SOURCE_POST_001.json';once(postp,enc(dict(schema_version=1,created_utc=utc(),detail_sha256=sha(rp.read_bytes()),phase_review_sha256=sha(pp.read_bytes()),source_post_observations=post)))
handoff=OUT/'HANDOFF_ACTUAL_M3_SOURCE_BINDINGS_001.md';once(handoff,('M3 observed Python and four PowerShell source bindings independently accepted only as source preparations. Bound9 SHA '+REVIEW_SHA+'; Phase20 SHA '+sha(pp.read_bytes())+'. Complete six Python literal and two literals in each PowerShell file reverse to the selected templates; all function bodies remain unchanged. Actual PowerShell parser errors: zero. Full finite source copies, triple observations and post-reads accompany both reviews. Conditional coordination has no concrete interval or GO. No authorization, capture timer, phase action, target test, runtime acceptance or operational authority is granted. Root configuration and actual P16 still require separate review before INIT.\n').encode('ascii'))
print(json.dumps(dict(verdict=details['verdict'],finite_input_count=len(data),outputs=[dict(path=str(p),sha256=sha(p.read_bytes()),bytes=len(p.read_bytes())) for p in (rp,pp,postp,handoff)])))
