def named_rows(v,wanted):
    result=[]
    if type(v)is dict:
        if type(v.get('path'))is str and type(v.get('sha256'))is str and type(v.get('bytes'))is int:
            if str(Path(v['path']))==str(wanted):result.append(v)
        for q in v.values():result.extend(named_rows(q,wanted))
    elif type(v)is list:
        for q in v:result.extend(named_rows(q,wanted))
    return result
actual_source_observed=[];future_absences=[]
for key,name in table['actual_paths'].items():
    p=Path(name)
    if key in ('root_init','root_trust','checker_binding'):
        assert not p.exists();future_absences.append(dict(role=key,path=str(p),observed_absent=True));continue
    rows=named_rows(p16_metadata,p)
    if rows:
        pins={(r['bytes'],r['sha256'])for r in rows};assert len(pins)==1
        length,pin=next(iter(pins));select(p,length,pin,'authenticated_P16_actual_Source_'+key);actual_source_observed.append(dict(role=key,path=str(p),bytes=length,sha256=pin,authentication='genuine externally selected full P16 c6b64b99 row'))
    elif key=='checker_peer':
        r=table['immutable']['checker_peer'];select(p,r['bytes'],r['sha256'],'immutable_checker_peer_actual_role')
    else:raise AssertionError(('P16 full Source lacks compiled actual Source role',key))

copies=OWN/'inputs';copies.mkdir(exist_ok=False)
collection=[];content={};inventory=[];historical_decimal_records=[]
for i,(name,(length,pin))in enumerate(sorted(expected.items())):
    p=Path(name);samples=[]
    for _ in range(3):b,r=read(p);samples.append(r)
    assert samples[0]==samples[1]==samples[2]and len(b)==length and sha(b)==pin
    cp=copies/(f'{i:03d}_'+p.name);once(cp,b);cr=read(cp)[1]
    collection.append(dict(original_path=str(p),copy_path=str(cp),triple_original=samples,copy=cr));content[str(p)]=b
    record=dict(path=str(p),bytes=len(b),sha256=pin,selection_roles=labels[name])
    if p.suffix=='.py':
        tree=ast.parse(b,filename=str(p));record.update(kind='Python_AST_only',module_AST_sha256=sha(AST(tree).encode()),definitions=[dict(name=n.name,line=n.lineno,end_line=n.end_lineno,AST_sha256=sha(AST(n).encode()))for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))])
    elif p.suffix=='.json':
        try:v=decode(b)
        except ValueError as e:
            # Historical metadata records are reviewed byteexact; finite decimal
            # representation is scoped to each recorded SHA, never normalized
            # into constructor's ordinary JSON model boundary.
            assert str(e).startswith('float/nonfinite ordinary Source JSON ')
            v=json.loads(b,object_pairs_hook=duplicate,parse_constant=bad,parse_float=Decimal)
            locations=[]
            def decimal_locations(x,path=''):
                if type(x)is Decimal:
                    assert x.is_finite();locations.append(dict(path=path,decimal_text=str(x)))
                elif type(x)is dict:
                    for k,y in x.items():decimal_locations(y,path+'/'+k)
                elif type(x)is list:
                    for j,y in enumerate(x):decimal_locations(y,path+'/'+str(j))
            decimal_locations(v);assert locations
            historical_decimal_records.append(dict(path=str(p),sha256=pin,record_type=v.get('record_type')if type(v)is dict else None,exact_locations=locations,reviewer_metadata_only_not_constructor_JSON=True))
        record.update(kind='JSON_Source_metadata',top_level_keys=sorted(v)if type(v)is dict else None,record_type=v.get('record_type')if type(v)is dict else None)
    else:record['kind']='preserved_byte_content'
    inventory.append(record)

