KEYS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
API8=(0,1,2,3,5,6,7,8)
MAXIMUM=8388608
def sha(b):return hashlib.sha256(b).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def duplicate(rows):
    d={}
    for k,v in rows:
        assert k not in d,('duplicate Source JSON',k)
        d[k]=v
    return d
def bad(v):raise ValueError('float/nonfinite ordinary Source JSON '+v)
def decode(b):return json.loads(b,object_pairs_hook=duplicate,parse_constant=bad,parse_float=bad)
def raw(s):
    r=[getattr(s,k,None)for k in KEYS];assert all(type(v)is int for v in r)
    return r
def read(p):
    assert p.is_absolute()and p.is_relative_to(WORK)and '..'not in p.parts
    a=p.lstat();ar=raw(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=MAXIMUM
    ancestors=[]
    for q in p.parents:
        s=q.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024
        ancestors.append([str(q),s.st_dev,s.st_ino])
    with p.open('rb')as h:
        s=os.fstat(h.fileno());hr=raw(s);assert stat.S_ISREG(s.st_mode)and s.st_nlink==1 and not s.st_file_attributes&1024
        assert all(ar[i]==hr[i]for i in API8)and ar[4]==ar[8]
        b=h.read(MAXIMUM+1);assert raw(os.fstat(h.fileno()))==hr
    assert raw(p.lstat())==ar and len(b)==ar[2]and len(b)<=MAXIMUM
    assert ancestors==[[str(q),q.lstat().st_dev,q.lstat().st_ino]for q in p.parents]
    return b,dict(path=str(p),bytes=len(b),sha256=sha(b),path_raw9=ar,descriptor_raw9=hr,cross_API8_indices=list(API8),cross_API_ctime_equality_asserted=False)
def once(p,b):
    assert p.is_relative_to(OWN)and type(b)is bytes and len(b)<=MAXIMUM
    p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
    assert read(p)[0]==b
def AST(n):return ast.dump(n,include_attributes=False)
def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
expected={};labels={}
