from pathlib import Path
p=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/root-model-constructor-independent004')
s=(p/'AUDIT_CONSTRUCTOR004_SOURCE_001.py').read_bytes()
old=b"    else:raise AssertionError(('P16 full Source lacks compiled actual Source role',key))"
new=b"    else:\n        b,r=read(p);select(p,len(b),sha(b),'independently_observed_compiled_Source_'+key);actual_source_observed.append(dict(role=key,path=str(p),bytes=len(b),sha256=sha(b),authentication='own bounded compiled-path Source observation; not P16 authentication or actual constructor admission'))"
assert s.count(old)==1
q=p/'AUDIT_CONSTRUCTOR004_SOURCE_002.py'
with q.open('xb') as h: assert h.write(s.replace(old,new))==len(s.replace(old,new))
print(str(q))
