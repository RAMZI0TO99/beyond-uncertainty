def sha(b):return hashlib.sha256(b).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def read(p):
    a=p.lstat();ar=[getattr(a,k)for k in KEYS]
    need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=CAP,'finite plain file')
    chain=[]
    for q in p.parents:
        s=q.lstat();need(stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024,'plain ancestry');chain.append([str(q),s.st_dev,s.st_ino])
    with p.open('rb',buffering=0)as h:
        hs=os.fstat(h.fileno());hr=[getattr(hs,k)for k in KEYS]
        need(ar[:4]+ar[5:]==hr[:4]+hr[5:]and ar[4]==ar[8],'Windows cross8/birth')
        b=h.read(a.st_size+1);need(hr==[getattr(os.fstat(h.fileno()),k)for k in KEYS],'descriptor9')
    need(ar==[getattr(p.lstat(),k)for k in KEYS]and len(b)==a.st_size and chain==[[str(q),q.lstat().st_dev,q.lstat().st_ino]for q in p.parents],'path9/bytes/ancestor')
    return b,dict(path=str(p),bytes=len(b),sha256=sha(b),path_raw9=ar,descriptor_raw9=hr,ancestors=chain)
def once(leaf,b):
    p=OUT/leaf;need(len(b)<=CAP,'own cap')
    with p.open('xb')as h:need(h.write(b)==len(b),'exclusive complete write');h.flush();os.fsync(h.fileno())
    need(read(p)[0]==b,'own output readback')
def decode(b):
    def pair(rows):
        d={}
        for k,v in rows:need(k not in d,'duplicate');d[k]=v
        return d
    def bad(x):raise ValueError('nonfinite/ordinary float')
    return json.loads(b.decode('utf8'),object_pairs_hook=pair,parse_float=bad,parse_constant=bad)

