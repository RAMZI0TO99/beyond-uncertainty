def wire(v):return(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def read(p):
    a=p.lstat();ar=[getattr(a,k)for k in KEYS];need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=8388608,'finite plain')
