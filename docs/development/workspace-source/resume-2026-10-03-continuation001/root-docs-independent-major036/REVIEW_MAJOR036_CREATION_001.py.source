def need(value, message):
    if not value:
        raise ValueError(message)

def sha(value):
    return hashlib.sha256(value).hexdigest()

def wire(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(',',':'), allow_nan=False) + '\n').encode('ascii')

def decode(value):
    def pairs(rows):
        result = {}
        for key, item in rows:
            need(key not in result, 'duplicate JSON key')
            result[key] = item
        return result
    def bad(value):
        raise ValueError('nonfinite JSON refused')
    need(not value.startswith(b'\xef\xbb\xbf'), 'JSON BOM refused')
    return json.loads(value.decode('utf8', 'strict'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def raw(value):
    return [getattr(value, name) for name in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def chain(path):
    result = []
    for item in reversed(path.parents):
        value = item.lstat()
        need(stat.S_ISDIR(value.st_mode) and not value.st_file_attributes & 1024, 'plain ancestors')
        result.append([str(item), value.st_dev, value.st_ino])
    return result

def read(path, pin=None, size=None):
    external = EXTERNAL_PINS
    need(path.is_absolute() and (path.is_relative_to(ROOT) or (path in external and pin == external[path])), 'Root or externally Root-selected finite pinned Pro3 metadata roles')
    ancestors = chain(path)
    first = path.lstat()
    need(stat.S_ISREG(first.st_mode) and first.st_nlink == 1 and not first.st_file_attributes & 1024 and 0 <= first.st_size <= MAX_FILE, 'plain single-link capped input')
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        left, right = raw(first), raw(opened)
        need(left[:4] + left[5:] == right[:4] + right[5:] and left[4] == left[8], 'ordinary cross8 and birth')
        value = stream.read(first.st_size + 1)
        need(raw(opened) == raw(os.fstat(stream.fileno())), 'same-handle raw9')
    need(raw(first) == raw(path.lstat()) and chain(path) == ancestors and len(value) == first.st_size, 'path raw9 ancestry and exact length')
    need(pin is None or sha(value) == pin, 'selected exact SHA')
    need(size is None or len(value) == size, 'selected exact size')
    return value, dict(path=str(path), sha256=sha(value), bytes=len(value), path_raw9=left, descriptor_raw9=right, ancestors=ancestors)

def local(relative):
    need(type(relative) is str and '\\' not in relative and not relative.startswith('/') and all(part not in ('', '.', '..') and ':' not in part for part in relative.split('/')), 'canonical relative path')
    return ROOT.joinpath(*relative.split('/'))

def once(name, value):
    need(type(value) is bytes and len(value) <= MAX_FILE, 'review output8MiB')
    path = OUT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    need(not path.exists(), 'own review output create-once')
    with path.open('xb') as stream:
        need(stream.write(value) == len(value), 'complete own review write')
        stream.flush()
        os.fsync(stream.fileno())
    need(read(path)[0] == value, 'own metadata readback')

