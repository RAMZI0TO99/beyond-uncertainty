"""Own source/AST metadata preparation only; never run the prepared Root auditor."""
import argparse
import ast
import datetime as dt
from decimal import Decimal
import hashlib
import json
import os
from pathlib import Path
import re
import stat

ROOT=Path('D:/Aenv/pro2')
WORK=ROOT/'resume-2026-10-03-continuation001'
OUT=WORK/'root-docs-independent-major036'
STAGE=WORK/'root-docs-major036'
OLD=WORK/'root-docs-independent-major035/ROOT_REVIEW_MAJOR035_SOURCE_001.py'
CAP=8388608
KEYS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')

def need(v,m):
    if not v:raise ValueError(m)
def sha(b):return hashlib.sha256(b).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(s):
    r=[getattr(s,k,None)for k in KEYS];need(all(type(v)is int for v in r),'typed raw9');return r
def read(p):
    a=p.lstat();ar=raw(a);need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=CAP,'plain input cap')
    chain=[]
    for q in p.parents:
        s=q.lstat();need(stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024,'plain ancestors');chain.append([str(q),s.st_dev,s.st_ino])
    with p.open('rb',buffering=0)as h:
        hr=raw(os.fstat(h.fileno()));need(ar[:4]+ar[5:]==hr[:4]+hr[5:]and ar[4]==ar[8],'cross8/birth')
        b=h.read(a.st_size+1);need(raw(os.fstat(h.fileno()))==hr,'same handle9')
    need(raw(p.lstat())==ar and len(b)==a.st_size and chain==[[str(q),q.lstat().st_dev,q.lstat().st_ino]for q in p.parents],'path9/ancestor/bytes')
    return b,dict(path=str(p),sha256=sha(b),bytes=len(b),path_raw9=ar,descriptor_raw9=hr,ancestors=chain)
def once(p,b):
    need(p.is_relative_to(OUT)and len(b)<=CAP,'own finite output');p.parent.mkdir(parents=True,exist_ok=True)
    with p.open('xb')as h:need(h.write(b)==len(b),'own complete exclusive write');h.flush();os.fsync(h.fileno())
    need(read(p)[0]==b,'own readback')
def parse(b,dec=False):
    def pairs(rows):
        d={}
        for k,v in rows:need(k not in d,'duplicates');d[k]=v
        return d
    def bad(v):raise ValueError('ordinary floats/nonfinite')
    need(not b.startswith(b'\xef\xbb\xbf'),'BOM')
    return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=Decimal if dec else bad,parse_constant=bad)
def decimals(obj):
    d={}
    def walk(v,p):
        if type(v)is Decimal:need(v.is_finite(),'finite decimal');d[p]=str(v)
        elif type(v)is dict:
            for k,x in v.items():walk(x,p+'/'+k)
        elif type(v)is list:
            for i,x in enumerate(v):walk(x,p+'/'+str(i))
    walk(obj,'');return d
def row(p,b):return dict(path=p.relative_to(ROOT).as_posix(),sha256=sha(b),bytes=len(b))

def main():
    ap=argparse.ArgumentParser(allow_abbrev=False);ap.add_argument('--freeze',action='store_true');args=ap.parse_args()
    original,om=read(OLD);tree=ast.parse(original)
    globals_={}
    for n in tree.body:
        if type(n)is ast.Assign and len(n.targets)==1 and type(n.targets[0])is ast.Name:
            try:globals_[n.targets[0].id]=ast.literal_eval(n.value)
            except(ValueError,TypeError):pass
    prefix=original[:original.index(b'def main():')].decode('utf8')
    prefix=prefix.replace('Major035','Major036').replace('major035','major036')
    prefix=prefix.replace('Prepared by /root/architecture','Prepared by /root/bootstrap_stage')
    prefix=prefix.replace('CONTINUATION_CHECKPOINT_006.md','CONTINUATION_CHECKPOINT_007.md')
    for name in ('MANIFEST_SHA','PUBLISHER_SHA','CONTEXT_SHA','CONTRACT_SHA','AUTHOR_SHA','CHECKPOINT_SHA'):
        prefix=re.sub(r'^'+name+r' = .*$',name+' = None',prefix,flags=re.M)
    start=prefix.index('PHYSICAL_DECIMALS = {');end=prefix.index('\n\ndef need',start)
    physical=globals_['PHYSICAL_DECIMALS'].copy()
    # These exact fixed record paths are Root-selected failed TYPE004 evidence.
    for p in sorted((WORK/'root-pro3-type004-observation001/before').iterdir()):
        if p.suffix=='.json':
            b,_=read(p);d=decimals(parse(b,dec=True))
            if d:physical[p.relative_to(WORK).as_posix()]=d
    prefix=prefix[:start]+'PHYSICAL_DECIMALS = '+repr(physical)+prefix[end:]
    main_source,mm=read(OUT/'MAIN_MAJOR036_SOURCE_002.txt')
    packet=None
    inputs=[OLD,OUT/'MAIN_MAJOR036_SOURCE_002.txt',Path(__file__),
            WORK/'root-pro3-type004-observation001/ROOT_EXTERNAL_TYPE004_FAILURE_SOURCE_SELECTION_001.json']
    inputs += [OUT/'MAIN_MAJOR036_SOURCE_001.txt',OUT/'PREPARE_ROOT_SOURCE_AUDITOR_036_001.py',
               OUT/'before-preparation001/MAIN_MAJOR036_SOURCE_001.txt',
               OUT/'before-preparation001/PREPARE_ROOT_SOURCE_AUDITOR_036_001.py']
    need(read(inputs[-4])[0]==read(inputs[-2])[0]
         and read(inputs[-3])[0]==read(inputs[-1])[0], 'preserved partial001 preparation exact')
    if args.freeze:
        paths={name:STAGE/leaf for name,leaf in {
            'manifest':'STAGED_DOCUMENTATION_MANIFEST_036_002.json',
            'publisher':'PUBLISH_MAJOR036_DOCS_002.py',
            'context':'SELECTED_SOURCE_CONTEXT_036_002.json',
            'contract':'DOCUMENTATION_SOURCE_CONTRACT_036_002.json',
            'author_audit':'AUTHOR_MAJOR036_STAGE_AUDIT_002.json',
            'facts':'FINAL_FACT_SELECTION_036_002.json'}.items()}
        bodies={k:read(p)[0]for k,p in paths.items()}
        manifest=parse(bodies['manifest']);context=parse(bodies['context']);facts=parse(bodies['facts']);audit=parse(bodies['author_audit']);contract=parse(bodies['contract'])
        need(sha(bodies['manifest'])=='7667c4fdecc2422295ba00fdba51f7a0e2382e9de18d433b4809de99b15847e3'
             and len(bodies['manifest'])==64813
             and sha(bodies['publisher'])=='0a8b501773c4d3b21e933d27acba7dd04f85e6d52f878db15b1c00b6fa982aab'
             and len(bodies['publisher'])==9951
             and sha(bodies['contract'])=='3eab6469ea2456fe7cfc4e053aa1adc2436c3a28dae7fa54a7991c4dece41e8e'
             and sha(bodies['author_audit'])=='a375aec36dae9c762ab50bdb18bc7a8536742b1365ba69ae8927842ceb38b1b3', 'genuine Root final stage002 pin selection')
        acceptance=parse(read(WORK/'root-checker28-actual-independent002/INDEPENDENT_ACTUAL_CHECKER28_REVIEW_002.json')[0])
        post=parse(read(WORK/'root-checker28-actual-independent002/POST_ACTUAL_CHECKER28_REVIEW_002.json')[0])
        type_selection=parse(read(WORK/'root-pro3-type004-observation001/ROOT_EXTERNAL_TYPE004_FAILURE_SOURCE_SELECTION_001.json')[0])
        ctor_path=WORK/'root-model-constructor-independent004/INDEPENDENT_MODEL_CONSTRUCTOR004_SOURCE_DETAILS_001.json'
        cb,_=read(ctor_path);ctor=parse(cb)
        packet={k:row(paths[k],bodies[k])for k in paths}
        packet.update(prepared_utc=manifest['prepared_utc'],pair_count=len(manifest['inputs']),link_count=len(manifest['links']),
            context_keys=list(context),contract_keys=list(contract),author_audit_keys=list(audit),fact_keys=list(facts),fact_roles={r['role']:r for r in facts['selected_records']},
            checkpoint=manifest['checkpoint'],sections=[row(STAGE/'selected-sections002'/f'section-{i}.md',read(STAGE/'selected-sections002'/f'section-{i}.md')[0])for i in range(5)],
            creation_selection=row(WORK/'root-docs-major035/ROOT_CREATION_SELECTION_035_001.json',read(WORK/'root-docs-major035/ROOT_CREATION_SELECTION_035_001.json')[0]),
            ctor_full=row(ctor_path,cb),ctor_full_predicates={k:ctor[k]for k in ('reviewer','source_author','verdict','runtime_acceptance','tests_executed','target_execution','operational_authority')if k in ctor},
            checker_acceptance_keys=list(acceptance),checker_acceptance_predicates={k:acceptance[k]for k in (
                'schema_version','record_type','reviewer','producer','scope','verdict','methods','subtests','events','errors','failures','skips','diagnostic_bytes','conservative_physical_upper_seconds','physical_limit_seconds','actual_project_metadata_or_current24','models_or_bound_pool','hard_OS_Job_or_descendant_or_global_quiet','operational_authority','consumed_no_replay','finite_inputs','source_copies','source_proof_rows','successful_parent_terminals','reviewer_test_execution','reviewer_target_execution')},
            checker_post_predicates={k:post[k]for k in ('reviewer','schema_version','all_exact','finite_inputs','target_execution','operational_authority')},
            TYPE004_selection_keys=list(type_selection),TYPE004_external_paths=[r['path']for r in type_selection['external_source_observations']],
            named_absences=[Path(r['path']).relative_to(WORK).as_posix()for r in audit['named_role_absences']],
            required_document_phrases={'0':['passed28 methods+24 subtests/80 events','no full component PASS','Actual model fit/pool/READY/capture/current24 remain absent'],
                '1':['accept28 successful methods plus24 subtests/80 ordered events','Mypy returned zero errors across205 files','No final native postdeadline checks or full component/runtime/scientific PASS','INIT2/trust2, actual assembled models and fit'],
                '2':['passed28 methods+24 subtests/80 events','no full component PASS','INIT2/trust2, actual assembled models and fit'],
                '3':['accept28 successful methods plus24 subtests/80 ordered events','No final native postdeadline checks or full component/runtime/scientific PASS','INIT2/trust2, actual assembled models and fit'],
                '4':['accept28 successful methods plus24 subtests/80 ordered events','No final native postdeadline checks or full component/runtime/scientific PASS','INIT2/trust2, actual assembled models and fit']},
            required_checkpoint_phrases=['accept28 successful methods plus24 subtests/80 ordered events','Mypy returned zero errors across205 files','No final native postdeadline checks or full component/runtime/scientific PASS','All remain UNRUN','INIT2/trust2, actual assembled models and fit','no new INIT2, model constructor, pool20, capture, unit or test entry'])
        for value in packet['required_document_phrases'].values():
            value += ['finish anything that is running now. and then update the docs and then stop.',
                      'no new INIT2, model constructor, pool20, capture, unit or test entry']
        inputs+=list(paths.values())+[STAGE/'selected-sections002'/f'section-{i}.md'for i in range(5)]+[ctor_path,WORK/'root-checker28-actual-independent002/INDEPENDENT_ACTUAL_CHECKER28_REVIEW_002.json',WORK/'root-checker28-actual-independent002/POST_ACTUAL_CHECKER28_REVIEW_002.json']
        inputs+=[WORK/r['path']for r in facts['selected_records']]
    source=(prefix+'\nPACKET = '+repr(packet)+'\n\n'+main_source.decode('utf8')).encode('utf8')
    source_tree=ast.parse(source)
    # Exact inherited low-level safeguards; no selected definition is executed.
    old_functions={n.name:ast.dump(n,include_attributes=False)for n in tree.body if type(n)is ast.FunctionDef and n.name!='main'}
    new_functions={n.name:ast.dump(n,include_attributes=False)for n in source_tree.body if type(n)is ast.FunctionDef and n.name in old_functions}
    need(old_functions==new_functions,'all inherited reader/JSON/UTC/createonce functions AST-exact')
    leaf='ROOT_REVIEW_MAJOR036_SOURCE_002.py'if args.freeze else'ROOT_REVIEW_MAJOR036_SOURCE_002.UNBOUND.py'
    once(OUT/leaf,source)
    observations=[]
    for index,p in enumerate(dict.fromkeys(inputs)):
        passes=[read(p)for _ in range(3)];need(passes[0]==passes[1]==passes[2],'source prep triple')
        copy=OUT/('before-frozen002'if args.freeze else'before-draft002')/f'{index:03d}.bytes';once(copy,passes[0][0]);b,cm=read(copy)
        need(b==passes[0][0]and cm['path_raw9'][:2]!=passes[0][1]['path_raw9'][:2],'independent before copy')
        observations.append(dict(original=passes[0][1],copy=cm,passes=[m for _,m in passes]))
    for entry in observations:
        need(read(Path(entry['original']['path']))[1]==entry['passes'][0]and read(Path(entry['copy']['path']))[1]==entry['copy'],'source prep post')
    status=dict(schema_version=1,record_type='major036_Root_auditor_source_preparation',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),source_preparer='/root/bootstrap_stage',actual_Source_author='/root/actual_record_checker',future_genuine_Source_reviewer='/root',reviewer_source=row(OUT/leaf,source),status='AUTHOR_FROZEN_UNRUN'if args.freeze else'UNBOUND_DRAFT_UNRUN',inherited_Source_auditor=row(OLD,original),inherited_nonmain_function_ASTs_exact=list(old_functions),new_nominal_function_AST_parsed=True,inputs=observations,prepared_PACKET=packet,actual_Source_review=None,Source_peer_record_created=False,publisher_called=False,target_definitions_import_compile_main_called=False,tests_or_Git_native_FFI_or_models_called=False,publication_performed=False,operational_authority=False)
    once(OUT/('SOURCE_PREPARATION_036_002.json'if args.freeze else'SOURCE_DRAFT_PREPARATION_036_002.json'),wire(status))
    print(json.dumps(dict(status=status['status'],source_sha256=sha(source),source_bytes=len(source),before_pairs=len(observations),inherited_AST_functions=len(old_functions),Root_auditor_run=False),sort_keys=True))

if __name__=='__main__':main()
