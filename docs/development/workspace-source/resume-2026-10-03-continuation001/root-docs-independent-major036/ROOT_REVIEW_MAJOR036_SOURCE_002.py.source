def need(v, message):
    if not v:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def enc(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def now():
    return datetime.now(timezone.utc).isoformat(timespec='microseconds')

def exact(value, keys):
    need(type(value) is dict and set(value) == set(keys), 'closed keyset differs')

def decode(data, physical_name=None):
    def pairs(rows):
        result = {}
        for key, value in rows:
            need(key not in result, 'duplicate JSON key')
            result[key] = value
        return result
    def bad(value):
        raise ValueError('Source float/nonfinite JSON refused')
    need(not data.startswith(b'\xef\xbb\xbf'), 'JSON BOM refused')
    need(physical_name is None or physical_name in PHYSICAL_DECIMALS,
         'only an externally pinned native physical record admits Decimal')
    value = json.loads(data.decode('utf8', 'strict'), object_pairs_hook=pairs,
                       parse_float=Decimal if physical_name else bad,
                       parse_constant=bad)
    if physical_name:
        actual = {}
        def walk(item, path):
            if type(item) is Decimal:
                need(item.is_finite(), 'nonfinite physical measurement')
                actual[path] = str(item)
            elif type(item) is dict:
                for key, child in item.items():
                    walk(child, path + '/' + key)
            elif type(item) is list:
                for index, child in enumerate(item):
                    walk(child, path + '/' + str(index))
        walk(value, '')
        need(actual == PHYSICAL_DECIMALS[physical_name],
             'native record Decimal field/value domain differs')
    return value

def raw(s):
    return [getattr(s, key) for key in (
        'st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns',
        'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def ancestors(p):
    result = []
    for q in reversed(p.parents):
        s = q.lstat()
        need(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode)
             and not s.st_file_attributes & 1024, 'plain ancestor required')
        result.append([str(q), s.st_dev, s.st_ino])
    return result

def read(p, pin=None, size=None):
    need(p.is_absolute(), 'absolute pinned path required')
    ancestry = ancestors(p)
    a = p.lstat()
    need(stat.S_ISREG(a.st_mode) and not stat.S_ISLNK(a.st_mode)
         and a.st_nlink == 1 and not a.st_file_attributes & 1024
         and 0 <= a.st_size <= MAX_FILE, 'plain one-link bounded file')
    with p.open('rb', buffering=0) as handle:
        b = os.fstat(handle.fileno())
        x, y = raw(a), raw(b)
        need(x[:4] + x[5:] == y[:4] + y[5:] and x[4] == x[8],
             'cross-API8 identity excluding ctime; path ctime/birth')
        data = handle.read(a.st_size + 1)
        need(raw(b) == raw(os.fstat(handle.fileno())), 'same-handle raw9 drift')
    need(raw(a) == raw(p.lstat()) and ancestors(p) == ancestry,
         'same-path raw9/ancestor drift')
    need(len(data) == a.st_size, 'bounded exact read')
    need(pin is None or (type(pin) is str and
         re.fullmatch('[0-9a-f]{64}', pin) and sha(data) == pin),
         'external SHA differs')
    need(size is None or (type(size) is int and size == len(data)),
         'external byte count differs')
    return data, dict(path=str(p), sha256=sha(data), bytes=len(data),
                     path_raw9=x, descriptor_raw9=y, ancestors=ancestry)

def local(relative):
    need(type(relative) is str and 0 < len(relative) <= 399
         and '\\' not in relative and not relative.startswith('/')
         and all(part not in ('', '.', '..') and ':' not in part
                 for part in relative.split('/')), 'canonical local path')
    return ROOT.joinpath(*relative.split('/'))

def once(relative, data):
    need(type(data) is bytes and len(data) <= MAX_FILE, 'owned output cap')
    path = OUT.joinpath(*relative.split('/'))
    path.parent.mkdir(parents=True, exist_ok=True)
    ancestry = ancestors(path)
    need(not path.exists() and not path.is_symlink(), 'owned role already exists')
    with path.open('xb') as handle:
        need(handle.write(data) == len(data), 'complete exclusive owned write')
        handle.flush()
        os.fsync(handle.fileno())
    need(ancestors(path) == ancestry and read(path, sha(data), len(data))[0] == data,
         'owned write/readback drift')

def ticks(text):
    need(type(text) is str and re.fullmatch(
        r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,7}\+00:00', text),
         'canonical Py6/PS7 UTC tick string')
    base, fraction = text[:-6].split('.')
    dt = datetime.fromisoformat(base + '+00:00')
    need(dt.strftime('%Y-%m-%dT%H:%M:%S') == base, 'canonical UTC date')
    epoch = datetime(1970, 1, 1, tzinfo=timezone.utc)
    delta = dt - epoch
    return (delta.days * 86400 + delta.seconds) * 10000000 + int(fraction.ljust(7, '0'))


