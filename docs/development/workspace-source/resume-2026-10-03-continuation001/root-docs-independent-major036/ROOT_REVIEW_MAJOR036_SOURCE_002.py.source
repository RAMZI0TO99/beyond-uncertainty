checker_post_predicates': {'reviewer': '/root/owner_docs_review', 'schema_version': 1, 'all_exact': True, 'finite_inputs': 188, 'target_execution': False, 'operational_authority': False}, 'TYPE004_selection_keys': ['Root_pro2_independent_process_scan_or_Job_or_global_quiet_claim', 'TYPE001_original_unretained_failure_cause_explained', 'actual_TYPE005_patch_preparation_or_execution_attested_by_this_observer', 'actual_mypy_zero_exit_205_files_observed', 'actual_runtime_validation_scientific_or_operational_authority_granted', 'all11_fixed_inputs_triple_read_copy_post_exact', 'all58_manual_saved_pin_entries_reaudited_by_this_observer', 'attempt_and_grant004_consumed_no_replay', 'author', 'decision', 'explicit_peer_release_completion_timestamp_unmeasured_preserved', 'external_source_observations', 'full430_source_or3142_runtime_or765_absences_reaudited_by_this_observer', 'full_guarded_component_accepted', 'native_deadline_difference_nanoseconds', 'native_decimal_fields_parsed_documentarily_original_bytes_preserved', 'native_failure', 'native_false_cleanup_claim_preserved', 'native_final_postdeadline_checks_unreached', 'record_type', 'recorded_utc', 'saved_parent_private_job_cleanup_and_three_named_pid_absences_attributed_to_Pro3_Root', 'schema_version', 'separate_actual_audit_abf3_and_manual5679_scopes_selected_only', 'successor_native_floor_only_new_operations_authority_selected_not_execution_grant'], 'TYPE004_external_paths': ['D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\type_execution_audit_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\root_manual_failure_review_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\root_type_physical_witness_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\root_failed_type_cleanup_closeout_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\root_type_peer_release_closeout_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\native_deadline_failure_analysis_001.json', 'D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types4\\native_precision_contract_check_001.json', 'D:\\Aenv\\pro3\\runs\\phase2\\type_validation\\pro3_types_20261003_004\\result.json', 'D:\\Aenv\\pro3\\runs\\phase2\\type_validation\\pro3_types_20261003_004\\mypy.stdout.log', 'D:\\Aenv\\pro3\\runs\\phase2\\type_validation\\pro3_types_20261003_004\\mypy.stderr.log', 'D:\\Aenv\\pro2\\resume-2026-10-03-continuation001\\ROOT_PRO3_TYPE_COMPONENT_RELEASE_004.json'], 'named_absences': ['root-guard006-pipeline-prep001/ROOT_PIPELINE_INIT_TRACE_002.json', 'root-guard006-pipeline-prep001/ROOT_PIPELINE_TRUST_SELECTION_002.json', 'root-guard006-pipeline-prep001/ROOT_METADATA_PIPELINE_GO_002.json', 'metadata3-actual-checker-prep001/CHECKER_READY_BEFORE_006.json', 'metadata3-actual-checker-prep001/CHECKER_READY_AFTER_006.json', 'guard006-bound-late-checker-prep001/BOUND_LATE_CHECKER_READY_006.json', 'root-guard006-model-prep001/ACTUAL_SOURCE_POOL_PROJECTION_002.json', 'root-guard006-model-prep001/UTILITY_SOURCE_BINDINGS_002.json', 'root-guard006-model-prep001/UTILITY_SOURCE_PROTOCOL_002.json', 'root-guard006-model-prep001/COMPOSER_FRESH_SOURCE_MODEL_002.json', 'guard006-bound-late-checker-prep001/review_guard006_actual_records_001.BOUND.py', 'guard006-bound-late-checker-prep001/compose-root-review-packet-006.BOUND.py'], 'required_document_phrases': {'0': ['passed28 methods+24 subtests/80 events', 'no full component PASS', 'Actual model fit/pool/READY/capture/current24 remain absent', 'finish anything that is running now. and then update the docs and then stop.', 'no new INIT2, model constructor, pool20, capture, unit or test entry'], '1': ['accept28 successful methods plus24 subtests/80 ordered events', 'Mypy returned zero errors across205 files', 'No final native postdeadline checks or full component/runtime/scientific PASS', 'INIT2/trust2, actual assembled models and fit', 'finish anything that is ru