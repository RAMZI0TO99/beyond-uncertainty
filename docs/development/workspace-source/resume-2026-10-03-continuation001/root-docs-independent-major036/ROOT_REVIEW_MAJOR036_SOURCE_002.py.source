def nominal(value, expected, message):
    need(type(value) is type(expected) and value == expected, message)

def main():
    need(Path(__file__).absolute() == OUT / 'ROOT_REVIEW_MAJOR036_SOURCE_002.py',
         'fixed genuine Root auditor path')
    need(type(PACKET) is dict, 'author Source packet has not been frozen')
    options = argparse.ArgumentParser(allow_abbrev=False)
    options.add_argument('--expected-self-sha256', required=True)
    args = options.parse_args()
    registry = {}
    def add(path, pin=None, size=None):
        data, _ = read(path, pin, size)
        entry = (sha(data), len(data))
        need(path not in registry or registry[path] == entry, 'conflicting finite pin')
        registry[path] = entry
        need(len(registry) <= MAX_INPUTS, 'finite Source registry cap')
        return data
    def addrow(row):
        exact(row, ('path', 'sha256', 'bytes'))
        need(type(row['bytes']) is int and 0 <= row['bytes'] <= MAX_FILE,
             'typed bounded Source row')
        return add(local(row['path']), row['sha256'], row['bytes'])
    def selected(name):
        key = WORK.relative_to(ROOT).as_posix() + '/' + name
        need(key in final, 'fact absent from final036 finite inputs')
        pin, size = final[key]
        return decode(add(local(key), pin, size),
                      name if name in PHYSICAL_DECIMALS else None)
    def selected_role(role):
        row = roles[role]
        return selected(row['path'])
    def absent(path):
        ancestry = ancestors(path)
        try:
            path.lstat()
        except FileNotFoundError:
            need(ancestors(path) == ancestry, 'absence ancestor drift')
            return str(path)
        raise ValueError('named one-use Source role exists: ' + str(path))
    add(Path(__file__), args.expected_self_sha256)
    manifest = decode(addrow(PACKET['manifest']))
    exact(manifest, ('schema_version', 'record_type', 'author', 'prepared_utc',
        'checkpoint', 'primaries', 'inputs', 'links', 'source_only',
        'publication_performed', 'target_execution', 'operational_authority'))
    nominal(manifest['schema_version'], 1, 'schema1')
    nominal(manifest['record_type'], 'major036_documentation_stage', 'major036 stage')
    nominal(manifest['author'], '/root/actual_record_checker', 'genuine Source author')
    nominal(manifest['prepared_utc'], PACKET['prepared_utc'], 'frozen snapshot')
    nominal(manifest['source_only'], True, 'Source-only stage')
    need(all(manifest[key] is False for key in ('publication_performed',
         'target_execution', 'operational_authority')), 'Source-only manifest flags')
    need(type(manifest['inputs']) is list and len(manifest['inputs']) == PACKET['pair_count']
         and type(manifest['links']) is list and len(manifest['links']) == PACKET['link_count'],
         'actual036 finite pair/link counts')
    prepared = ticks(manifest['prepared_utc'])
    publisher = addrow(PACKET['publisher'])
    context = decode(addrow(PACKET['context']))
    contract = decode(addrow(PACKET['contract']))
    author = decode(addrow(PACKET['author_audit']))
    facts = decode(addrow(PACKET['facts']))
    exact(context, PACKET['context_keys'])
    exact(contract, PACKET['contract_keys'])
    exact(author, PACKET['author_audit_keys'])
    exact(facts, PACKET['fact_keys'])
    for item in (context, contract, author):
        nominal(item['source_author'], '/root/actual_record_checker', 'Source author only')
        nominal(item['scope'], SCOPE, 'exact documentation scope')
        nominal(item['prepared_utc'], manifest['prepared_utc'], 'same frozen stage clock')
        need(item['operational_authority'] is False, 'no operational authority')
    need(context['publication_performed'] is False and context['target_execution'] is False
         and contract['target_execution'] is False
         and contract['publisher_main_or_definitions_executed'] is False
         and author['publication_performed'] is False
         and author['publisher_definitions_import_main_executed'] is False
         and author['helper_test_target_execution'] is False,
         'author did not publish/import/execute selected Source')
    nominal(author['finite_input_count'], PACKET['pair_count'], 'author finite pair count')
    nominal(author['selected_link_count'], PACKET['link_count'], 'author finite links')
    need(author['whole_five_primary035_bytes_preserved'] is True
         and author['current_synthetic28_actual_acceptance_only'] is True
         and author['currentConsumer24_UNRUN'] is True
         and author['utility6_plus_F1_deferred_UNRUN'] is True
         and author['actual_models_or_fit_or_capture'] is None
         and author['selected_pro3_evidence_attributed_only'] is True
         and author['selected_pro3_full_component_PASS'] is False
         and author['old_pending_snapshot_bytes_preserved'] is True,
         'author current scoped/remaining work flags')
    nominal(facts['source_author'], '/root/actual_record_checker', 'own fact author, not Root')
    need(facts['publication_performed'] is False and facts['target_execution'] is False
         and facts['checker_acceptance_complete'] is True
         and facts['TYPE004_external_observation_complete'] is True,
         'genuine completed facts required before staged036')
    roles = {}
    need(type(facts['selected_records']) is list
         and len(facts['selected_records']) == len(PACKET['fact_roles']), 'finite fact roles')
    for row in facts['selected_records']:
        exact(row, ('path', 'sha256', 'bytes', 'role'))
        need(type(row['role']) is str and row['role'] not in roles
             and row['role'] in PACKET['fact_roles'], 'unique allowed selected fact role')
        nominal(row, PACKET['fact_roles'][row['role']], 'externally selected exact fact pointer')
        roles[row['role']] = row
    need(set(roles) == set(PACKET['fact_roles']), 'all required facts present')

    prior = decode(add(WORK / 'root-docs-major035/STAGED_DOCUMENTATION_MANIFEST_035_001.json',
        'a6c2679b368b632f7db6ba04befa0474fa2f499a5e03ecf7ea66c279d10bbb51', 53520))
    exact(prior, ('schema_version','record_type','author','prepared_utc','checkpoint',
        'primaries','inputs','links','source_only','publication_performed',
        'target_execution','operational_authority'))
    need(len(prior['inputs']) == 54 and len(prior['links']) == 59
         and prior['record_type'] == 'major035_documentation_stage', 'whole authentic035 stage')
    prior_rows = {row['destination']: row for row in prior['primaries']}
    unpublished1 = decode(add(STAGE / 'STAGED_DOCUMENTATION_MANIFEST_036_001.json',
        '22e915c37ee438610909ee589cf40070a435204a34326b964da6a0669461cba7', 55592))
    exact(unpublished1, ('schema_version','record_type','author','prepared_utc','checkpoint',
        'primaries','inputs','links','source_only','publication_performed',
        'target_execution','operational_authority'))
    need(len(unpublished1['inputs']) == 64 and len(unpublished1['links']) == 48
         and unpublished1['publication_performed'] is False
         and unpublished1['target_execution'] is False,
         'superseded unpublished036-001 remains immutable Source history')
    superseded = []
    for packet in (manifest, prior, unpublished1):
        addrow(packet['checkpoint'])
        need(tuple(row['destination'] for row in packet['primaries']) == PRIMARY,
             'five canonical primaries/order')
        for row in packet['primaries']:
            exact(row, ('destination', 'before', 'candidate', 'preservation'))
            addrow(row['before'])
            addrow(row['candidate'])
        need(len({row['original']['path'].casefold() for row in packet['inputs']})
             == len(packet['inputs']), 'unique original paths')
        need(len({row['copy']['path'].casefold() for row in packet['inputs']})
             == len(packet['inputs']), 'unique copied paths')
        for row in packet['inputs']:
            exact(row, ('original', 'copy'))
            exact(row['original'], ('path', 'sha256', 'bytes'))
            if packet is prior and row['original']['path'] in PRIMARY:
                old = prior_rows[row['original']['path']]
                need(row['original']['sha256'] == old['before']['sha256']
                     and row['original']['bytes'] == old['before']['bytes']
                     and addrow(old['before']) == addrow(row['copy']),
                     'historical034 whole primary matches archived035 before/copy')
                superseded.append(dict(original=row['original'], archived_before=old['before'],
                    exact_copy=row['copy'], selected_current035=old['candidate'],
                    obsolete034_live_pin_replayed=False))
            else:
                need(addrow(row['original']) == addrow(row['copy']), 'complete exact packet pair')
    need(len(superseded) == 5, 'exact five prior035 superseded live034 primary roles')
    final = {row['original']['path']: (row['original']['sha256'], row['original']['bytes'])
             for row in manifest['inputs']}
    need(len(final) == PACKET['pair_count'], 'exact current pair membership')
    boundary = b'\n\n---\n\nEarlier primary bytes below remain exact history; their pending statements describe the earlier selected snapshot.\n\n'
    texts, history = [], []
    for index, (row, old) in enumerate(zip(manifest['primaries'], prior['primaries'], strict=True)):
        before, candidate = addrow(row['before']), addrow(row['candidate'])
        need(before == add(local(row['destination']), sha(before), len(before))
             == addrow(old['candidate']), 'live035/current036-before/prior035 candidate exact')
        section = addrow(PACKET['sections'][index])
        if index < 3:
            need(row['preservation'] == 'suffix' and candidate == section + boundary + before,
                 'complete035 suffix3 and final new prefix')
            addition = candidate[:-len(before)]
        else:
            need(row['preservation'] == 'prefix' and candidate == before + b'\n\n' + section,
                 'complete035 prefix2 and final new suffix')
            addition = candidate[len(before):]
        need(manifest['prepared_utc'].encode('ascii') in addition
             and b'_WORK_' not in addition and b'_PREPARED_UTC_' not in addition,
             'complete final additions, no draft placeholders')
        text = addition.decode('utf8', 'strict')
        for phrase in PACKET['required_document_phrases'][str(index)]:
            need(phrase in text, 'qualified actual036 wording: ' + phrase)
        need('20:39:32.1487556' in text and 'reserve510=Root450+after60' in text
             and 'whole-host quiet' in text, 'lease/caps/quiet limits')
        texts.append(dict(document=row['destination'], bytes=len(addition), sha256=sha(addition), text=text))
        history.append(dict(destination=row['destination'], preservation=row['preservation'],
            before=row['before'], candidate=row['candidate'], entire_prior035_bytes_exact=True,
            live035_equals_before=True))
    checkpoint = addrow(manifest['checkpoint'])
    need(manifest['checkpoint'] == PACKET['checkpoint'], 'exact checkpoint007 identity')
    texts.append(dict(document=CHECKPOINT.relative_to(ROOT).as_posix(), bytes=len(checkpoint),
                      sha256=sha(checkpoint), text=checkpoint.decode('utf8', 'strict')))
    for phrase in PACKET['required_checkpoint_phrases']:
        need(phrase in texts[-1]['text'], 'checkpoint036 qualification: ' + phrase)
    extracted = []
    for item in texts:
        for target in re.findall(r'\]\(([^)]+)\)', item['text']):
            need(not target.startswith(('https:', 'http:', 'file:')), 'local final-location links')
            resolved = (local(item['document']).parent / target).resolve()
            relative = resolved.relative_to(ROOT).as_posix()
            extracted.append(dict(origin=item['document'], target=target, resolved_path=relative))
            if resolved != CHECKPOINT:
                need(relative in final, 'selected link has an independently pinned036 input')
                add(resolved, *final[relative])
    def linkkey(row):
        exact(row, ('origin', 'target', 'resolved_path'))
        return row['origin'], row['target'], row['resolved_path']
    need(len(extracted) == PACKET['link_count'] and sorted(map(linkkey, extracted))
         == sorted(map(linkkey, manifest['links'])), 'all final036 links reconstructed')
    for row in prior['links']:
        exact(row, ('origin', 'target', 'resolved_path'))
        add(local(row['resolved_path']))
    for row in unpublished1['links']:
        exact(row, ('origin', 'target', 'resolved_path'))
        if local(row['resolved_path']) != CHECKPOINT:
            add(local(row['resolved_path']))

    stop = selected_role('Root_user_stop')
    exact(stop, ('schema_version','record_type','author','recorded_utc','user_quote',
        'supersedes_prior_optional_bound_model_stopping_assumption',
        'finish_current_documentation_and_audit_closeout_only',
        'new_INIT2_model_constructor_pool20_capture_unit_or_test_entry_authorized',
        'actual_INIT2_models_pool20_READY_metadata_GO_capture_current24_remain_absent_or_UNRUN',
        'immutable_owner_master_de8f_endNone_is_not_rewritten',
        'owner_expiry_or_new_finite_lease_or_new_30h_inferred',
        'goal_action_after_documentation_closeout','Goal_currently_already_paused_or_complete',
        'no_replay_public_push_or_operational_authority'))
    need(stop['author'] == '/root'
         and stop['record_type'] == 'root_selected_user_finish_inflight_then_stop_directive'
         and stop['user_quote'] == 'finish anything that is running now. and then update the docs and then stop.'
         and stop['supersedes_prior_optional_bound_model_stopping_assumption'] is True
         and stop['finish_current_documentation_and_audit_closeout_only'] is True
         and stop['new_INIT2_model_constructor_pool20_capture_unit_or_test_entry_authorized'] is False
         and stop['immutable_owner_master_de8f_endNone_is_not_rewritten'] is True
         and stop['owner_expiry_or_new_finite_lease_or_new_30h_inferred'] is False
         and stop['goal_action_after_documentation_closeout'] == 'pause_at_explicit_user_request_not_claim_project_complete',
         'exact latest user boundary: documents/audit only, no new target entry')

    creation = selected('root-docs-major035/ROOT_CREATION_SELECTION_035_001.json')
    for key, value in {
        'author': '/root', 'decision': 'SELECT_DIFFERENT_COMPLETE_MAJOR035_DOCUMENTATION_CREATION_ONLY',
        'creation_review_sha256': '189d74aa156c8935e36163181c99b9eca12d320f3491317dfe280b73f80c0a7d',
        'creation_post_sha256': '03afcf778c3a18ba3ff7de5e56e6a984d477cfe4c5644ce014246e63cef1fd6f',
        'all5_current_candidates_and_whole34_history_preserved': True,
        'checkpoint006_exact': True, 'genuine_root_publication_tool': '37b462',
        'root_current_original_copy_raw9_hash_rechecks': 532,
        'source_review_scope_only_new59_links_not_global_oldlink_revalidation': True,
        'target_or_helper_test_model_capture_execution': False,
        'operational_authority': False}.items():
        nominal(creation[key], value, 'genuine different035 creation selection/' + key)
    full35 = selected('root-docs-independent-major035/INDEPENDENT_MAJOR035_CREATION_REVIEW_001.json')
    need(full35['reviewer'] == '/root/bootstrap_stage'
         and full35['verdict'] == 'PASS_MAJOR035_DOCUMENTATION_CREATION_ONLY'
         and full35['target_execution'] is False and full35['operational_authority'] is False,
