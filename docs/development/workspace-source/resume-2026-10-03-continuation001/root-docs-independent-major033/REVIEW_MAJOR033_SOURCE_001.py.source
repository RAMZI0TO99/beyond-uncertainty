    assert measured['original_over_cap_bytes']==dict(composer=0,utility=3102)and measured['alternate_over_cap_bytes']==dict(composer=0,utility=2520)and all(measured[k]is False for k in ('bound_sources_written','model_outputs_written','projection_written','helper_mains_executed','target_execution','runtime_acceptance','operational_authority'))
    measured_tool=selected('root-guard006-model-prep001/ROOT_ACTUAL_MODEL_FIT_DIAGNOSTIC_TOOL_003.json',True)
