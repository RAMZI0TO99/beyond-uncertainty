    imports=[a.name for n in tree.body if isinstance(n,ast.Import)for a in n.names]+[n.module for n in tree.body if isinstance(n,ast.ImportFrom)];assert set(imports)=={'argparse','hashlib','json','os','re','stat','datetime','pathlib'}
    assert b'automatic_rollback=False'in publisher and b'batch_atomicity_guaranteed=False'in publisher and b'os.replace(temp,destination)'in publisher
