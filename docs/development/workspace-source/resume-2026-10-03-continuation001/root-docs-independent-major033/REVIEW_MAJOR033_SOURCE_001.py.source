    assert cap['retained_Root_INIT']['pid']==34908 and cap['retained_Root_INIT']['retained_cell_exit_code']==-1 and cap['retained_Root_INIT']['Root_owned_stop_tool']=='39a961'and cap['U_or_composer_helper_main_executed']is False and cap['source_caps_grown']is False
