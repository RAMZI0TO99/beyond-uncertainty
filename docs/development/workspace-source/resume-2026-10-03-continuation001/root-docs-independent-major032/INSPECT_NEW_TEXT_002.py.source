from pathlib import Path
import json,sys
root=Path('D:/Aenv/pro2')
stage=root/'resume-2026-10-03-continuation001/root-docs-major032'
with (stage/'STAGED_DOCUMENTATION_MANIFEST_032_002.json').open('rb')as f:body=f.read(200000)
m=json.loads(body)
def read(p):
    with p.open('rb')as f:data=f.read(8388609)
    assert len(data)<=8388608
    return data
if sys.argv[1]=='checkpoint':data=read(root/m['checkpoint']['path'])
else:
    row=next(r for r in m['primaries']if r['destination']==sys.argv[1])
    old=read(root/row['before']['path']);new=read(root/row['candidate']['path'])
    data=new[:-len(old)]if row['preservation']=='suffix'else new[len(old):]
print(data.decode('utf8'))
