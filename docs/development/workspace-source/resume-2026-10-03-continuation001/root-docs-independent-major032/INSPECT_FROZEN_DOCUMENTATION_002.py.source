"""Owned bounded metadata inspection; no publisher or reviewed definitions."""
from pathlib import Path
import hashlib,json
ROOT=Path('D:/Aenv/pro2')
STAGE=ROOT/'resume-2026-10-03-continuation001/root-docs-major032'
def read(path):
    with path.open('rb')as f:data=f.read(8388609)
    assert len(data)<=8388608
    return data
body=read(STAGE/'STAGED_DOCUMENTATION_MANIFEST_032_002.json')
assert hashlib.sha256(body).hexdigest()=='30bb3abe1b49858b47269af2e91fa835acb13d39dc51ce5bd9405dd12b5910fb'
m=json.loads(body)
print('MANIFEST:',json.dumps({k:v for k,v in m.items()if k not in ('inputs','links')},indent=2))
for row in m['primaries']:
    old=read(ROOT/row['before']['path']);new=read(ROOT/row['candidate']['path'])
    addition=new[:-len(old)]if row['preservation']=='suffix'else new[len(old):]
    print('\nFULL ADDITION '+row['destination']+'\n'+addition.decode('utf8'))
print('\nFULL CHECKPOINT\n'+read(ROOT/m['checkpoint']['path']).decode('utf8'))
print('\nINPUT ORIGINALS\n'+json.dumps([r['original']for r in m['inputs']],indent=2))
print('\nLINK ROW EXAMPLE\n'+json.dumps(m['links'][:3],indent=2))
