    assert [absent(path)for path in paths]==absences
    once('POST_MAJOR032_CREATION_REVIEW_002.json',enc(dict(schema_version=1,created_utc=now(),observations=post,all_source_and_copy_bytes_and_raw9_exact=True,post_publication_named_absences=absences,target_execution=False,operational_authority=False)))
    once('INDEPENDENT_MAJOR032_CREATION_REVIEW_002.json',enc(report))
