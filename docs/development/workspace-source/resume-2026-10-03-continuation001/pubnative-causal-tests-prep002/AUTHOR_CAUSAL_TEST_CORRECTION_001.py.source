            cached={str(path):(payload+b'x',(1,))};events.clear()
            with self.assertRaisesRegex(ValueError,'cached witness exceeds fresh finite cap before hash'):
                n['repeat'](cached)
            self.assertFalse(any(event in events for event in ('OPEN','READ','HASH')))
            events.clear();n['repeat'](witness)
