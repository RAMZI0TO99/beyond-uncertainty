def replace_method(text,name,replacement):
    tree=ast.parse(text)
    found=[n for c in tree.body if isinstance(c,ast.ClassDef) for n in c.body if isinstance(n,ast.FunctionDef)and n.name==name]
    assert len(found)==1
    n=found[0];lines=text.splitlines(keepends=True)
    return ''.join(lines[:n.lineno-1])+replacement+'\n'+''.join(lines[n.end_lineno:])
b05='''    def test_b05_string_integer_collection_and_cycle_budgets_are_causal(self):
        with bounded_raw004_fixture()as(n,module):
            table=module._SUCCESSOR_RELEASE_SOURCE_FIELDS;original=table['EntrySha256']
            # New collections are correctly rejected by origin identity, not by
            # their length. Keep that route explicit rather than claiming it
            # demonstrates the collection-size budget.
            mutations=(('x'*65,'raw004 policy string domain'),
                       (10**20,'raw004 policy exact integer domain'),
                       (tuple(range(264)),'raw004 nested source container replaced'),
                       (table,'raw004 policy node/depth budget'))
            for value,reason in mutations:
                self.assertEqual(n['_native_attestation_limit']()[1],395799)
                table['EntrySha256']=value
                try:
                    with self.assertRaisesRegex(ValueError,reason):n['_native_attestation_limit']()
                finally:table['EntrySha256']=original
                self.assertEqual(n['_native_attestation_limit']()[1],395799)
            # This exact dict is retained from authentic Raw004 source. Mutating
            # its contents preserves container identity, so the length gate is
            # reachable before key traversal/child/node commitment checks.
            self.assertTrue(any(table is item for item in n['_NATIVE_POLICY_CONTAINERS']))
            self.assertIs(type(table),dict)
            baseline=dict(table);self.assertLess(len(baseline),264)
            checks=[];real_require=n['require']
            def observed_require(value,message):
                if message in ('raw004 nested source container replaced before callbacks',
                               'raw004 policy collection budget'):
                    checks.append((message,value))
                return real_require(value,message)
            n['require']=observed_require
            self.assertEqual(n['_native_attestation_limit']()[1],395799)
            self.assertTrue(any(message=='raw004 policy collection budget'and value is True for message,value in checks))
            additions={'BUDGET_'+str(index).zfill(3):original for index in range(264-len(baseline))}
            self.assertFalse(set(additions)&set(baseline))
            table.update(additions);self.assertEqual(len(table),264);checks.clear()
            try:
                with self.assertRaisesRegex(ValueError,'raw004 policy collection budget'):
                    n['_native_attestation_limit']()
                self.assertEqual(checks[-1],('raw004 policy collection budget',False))
                self.assertEqual(checks[-2],('raw004 nested source container replaced before callbacks',True))
                self.assertEqual([message for message,value in checks if value is False],['raw004 policy collection budget'])
            finally:
                table.clear();table.update(baseline)
            checks.clear();self.assertEqual(n['_native_attestation_limit']()[1],395799)
            self.assertTrue(checks and all(value is True for _,value in checks))
            n['require']=real_require
'''
