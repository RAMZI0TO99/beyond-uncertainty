def fixed_history_acquisition_namespace(name):
    """Future test selector only: real producer acquisition + real typed caps."""
    ns=grammar_namespace(name)
    context,_=grammar_fixture(ns)
    tree=ast.parse((STAGE/name).read_text(encoding='utf-8',errors='strict'))
    wanted={'pinned','pinned_input_role'}
    nodes=[node for node in tree.body if isinstance(node,ast.FunctionDef)and node.name in wanted]
    assert {node.name for node in nodes}==wanted
    exec(compile(ast.fix_missing_locations(ast.Module(body=nodes,type_ignores=[])),
                 '<fixed-history-acquisition-selected-tests>','exec',dont_inherit=True),ns)
    return ns,context


class FixedHistoryAcquisitionComposition(unittest.TestCase):
    def test_b15_both_producers_fixed_history_caps_precede_open_read_hash(self):
        for template in TEMPLATES:
            with self.subTest(template=template):
                ns,context=fixed_history_acquisition_namespace(template)
                role='predecessor_rows';facts=ns['HISTORICAL']['inputs'][role]
                path=Path(facts['path']);payload=(STAGE/'before/predecessor_rows.bytes').read_bytes()
                pin=hashlib.sha256(payload).hexdigest();bound=context['input_caps'][role]
                self.assertEqual(pin,facts['sha256']);self.assertEqual(len(payload),bound)
                events=[];state={'size':bound};real_sha=ns['sha']
                def info():
                    return SimpleNamespace(st_size=state['size'],st_ctime_ns=0)
                def prefix(actual):
                    self.assertEqual(actual,path);events.append('CHAIN')
                def plain(actual):
                    self.assertEqual(actual,path);events.append('PLAIN');return info()
                def digest(data):events.append('HASH');return real_sha(data)
                class Stream:
                    def __enter__(self):return self
                    def __exit__(self,*args):return None
                    def fileno(self):return 902
                    def read(self,maximum):events.append('READ');return payload
                def opened(actual,*args,**kwargs):
                    self.assertEqual(actual,path);events.append('OPEN');return Stream()
                ns.update(chain=prefix,plain_info=plain,sha=digest,
                    identity=lambda value:(1,),observation_identity=lambda value:(1,),
                    cross_api_identity=lambda *args,**kw:(1,1,bound,0,0,0,1,32))
                with patch.object(type(path),'open',opened),patch.object(ns['os'],'fstat',side_effect=lambda fd:info()):
                    # Real metadata_context remains selected, with the complete
                    # valid synthetic35/17/7 derivation; no cap selector is mocked.
                    self.assertEqual(ns['pinned_input_role'](role,path,pin),payload)
                    self.assertEqual(ns['pinned'](path,pin,maximum=bound),payload)
                    self.assertTrue(all(event in events for event in ('OPEN','READ','HASH')))
                    for route in ('pinned_input_role','pinned'):
                        events.clear();state['size']=bound+1
                        with self.assertRaisesRegex(ns['Refused'],'file exceeds its finite pre-read cap'):
                            if route=='pinned_input_role':ns[route](role,path,pin)
                            else:ns[route](path,pin,maximum=bound)
                        self.assertFalse(any(event in events for event in ('OPEN','READ','HASH')))
                        state['size']=bound;events.clear()
                        self.assertEqual(ns['pinned_input_role'](role,path,pin),payload)
                        self.assertEqual(ns['pinned'](path,pin,maximum=bound),payload)
                        self.assertTrue(all(event in events for event in ('OPEN','READ','HASH')))
