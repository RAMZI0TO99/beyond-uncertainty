        events=[];state={'size':len(payload)};real_sha=n['sha']
        def plain(actual):
            self.assertEqual(actual,path);events.append('PLAIN')
            return types.SimpleNamespace(st_size=state['size'])
        def digest(data):events.append('HASH');return real_sha(data)
        class Stream:
            def __enter__(self):return self
