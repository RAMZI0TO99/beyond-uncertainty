        n.update(plain=plain,identity=lambda info:(1,),cross_api_identity=lambda *args,**kw:(1,),sha=digest)
        with patch.object(type(path),'open',opened),patch.object(n['os'],'fstat',return_value=types.SimpleNamespace(st_size=len(payload))):
            witness={}
            self.assertEqual(n['read'](path,pin,witness),payload)
            n['repeat'](witness)
            self.assertTrue(all(event in events for event in ('OPEN','READ','HASH')))
            # Only the path-reported size changes; correct path, source selector,
