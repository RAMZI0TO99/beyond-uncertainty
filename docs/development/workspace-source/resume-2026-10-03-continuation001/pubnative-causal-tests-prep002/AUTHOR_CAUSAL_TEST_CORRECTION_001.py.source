def record(path):
    s=path.stat();data=path.read_bytes();a=path.stat()
    assert (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)==(a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns)
    result={'bytes':len(data),'sha256':sha(data),'identity':[s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns]}
    if str(path)in inputs:assert inputs[str(path)]==result
    else:inputs[str(path)]=result
    return data
