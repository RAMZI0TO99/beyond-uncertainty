"""Finite author source freeze; no imported/executed stage definition."""
import hashlib
import json
from datetime import datetime,timezone
from pathlib import Path
ROOT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/root-guard006-pipeline-prep001')
def sha(data):return hashlib.sha256(data).hexdigest()
def once(name,obj):
    data=(json.dumps(obj,sort_keys=True,indent=2)+'\n').encode()
    with (ROOT/name).open('xb') as stream:stream.write(data)
    return data
active=('PREPARE_ROOT_GUARD006_RECORDS_001.TEMPLATE.ps1','SUPERVISE_ROOT_WHOLE_BEFORE_006.TEMPLATE.ps1',
    'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.TEMPLATE.ps1','SUPERVISE_ROOT_WHOLE_AFTER_006.TEMPLATE.ps1')
syntax=json.loads((ROOT/'AUTHOR_FOUR_STAGE_FINAL_SYNTAX_002.json').read_bytes())
if len(syntax['rows'])!=4 or any(row['error_count']!=0 or row['path']!=str(ROOT/name) for row,name in zip(syntax['rows'],active)):raise ValueError('Selected four source parser receipt')
names=active+('AUTHOR_FOUR_STAGE_FINAL_SYNTAX_002.json','AUTHOR_FINAL_FOUR_STAGE_SOURCE_SELECTION_002.json',
    'SELECT_FINAL_ROOT_STAGE_SOURCE_002.py','HANDOFF_FOUR_ROOT_STAGES_002.md','FREEZE_FOUR_ROOT_STAGES_002.py')
rows=[]
for name in names:
    a=(ROOT/name).read_bytes();b=(ROOT/name).read_bytes()
    if a!=b:raise ValueError('Selected source drift')
    if name in active and (len(a)>65536 or b'rev002' in a):raise ValueError('Source ceiling/final role selection')
    rows.append(dict(path=name,sha256=sha(a),bytes=len(a),two_read_match=True))
preimages=[]
for name in active:
    path='AUTHOR_REV002_DRAFT_'+name+'.bytes'
    data=(ROOT/path).read_bytes()
    preimages.append(dict(path=path,bytes=len(data),sha256=sha(data)))
prior=json.loads((ROOT/'AUTHOR_FOUR_STAGE_SOURCE_SELECTION_001.json').read_bytes())
for row in prior['historical_inputs']:
    a=Path(row['path']).read_bytes();b=Path(row['path']).read_bytes()
    if a!=b or sha(a)!=row['sha256'] or len(a)!=row['bytes']:raise ValueError('Historical four Root stage input changed')
data=once('FOUR_ROOT_STAGE_SOURCE_MANIFEST_002.json',dict(schema_version=1,record_type='four_root_guard006_stage_source_manifest',
    created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),source_author='/root/renewal_runtime_inventory',actual_producer_role='/root',
    payload_count=len(rows),payloads=rows,selected_source_paths=list(active),preserved_rev002_draft_preimages=preimages,
    historical_inputs=prior['historical_inputs'],root_owned_pipeline_and_binder_excluded=True,
    selected_guard_manifest009_sha256='78320743b0076e5a8cc5056a6f003202a4dcdb19f3bc59a3cbf5da8924bbdba9',
    source_config_record_type='root_metadata_pipeline_source_binding',source_config_fields=20,
    actual_source_config=None,actual_lease=None,actual_bindings=None,actual_results=None,target_or_stage_execution=False,source_approval_issued=False))
print(json.dumps(dict(manifest_sha256=sha(data),payload_count=len(rows),active_source_rows=[dict(path=str(ROOT/r['path']),bytes=r['bytes'],sha256=r['sha256']) for r in rows[:4]],parse_error_counts=[row['error_count'] for row in syntax['rows']]),indent=2))
