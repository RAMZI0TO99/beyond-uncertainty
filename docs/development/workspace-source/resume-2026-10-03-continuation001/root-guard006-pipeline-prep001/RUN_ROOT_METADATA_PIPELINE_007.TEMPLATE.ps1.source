    [void](Read-Bytes $s.path $s.sha256 131072)
    $boundPath=Join-Path $BoundChecker 'compose-root-review-packet-006.BOUND.py'
    $boundSource=Read-Bytes $boundPath $go.value.composer_sha256 131072
    $pool=Record (Join-Path $Work 'guard006-utility-source-independent-review001\INDEPENDENT_GUARD006_BOUND_SOURCE_POOL_REVIEW_001.json') $go.value.composer_source_binding_peer_sha256 2097152
    Exact $pool.value @('schema_version','record_type','created_utc','reviewer','source_author','binder','scope','verdict','source_templates','bound_sources','binding_data','source_pool_projection','owner_master_sha256','execution_lease_sha256','root_trust_selection_sha256','exact_source_assignment_reversal','exact_function_class_ASTs','before_capture_timer','mains_or_target_execution','operational_authority_granted') 'Genuine different post-trust pool peer20'
    Need ($pool.value.schema_version -is [int] -and $pool.value.schema_version -eq 1 -and $pool.value.record_type -ceq 'guard006_bound_actual_source_pool_review' -and $pool.value.reviewer -ceq '/root' -and $pool.value.source_author -ceq '/root/pubnative_review' -and $pool.value.binder -ceq '/root' -and $pool.value.scope -ceq $Scope -and $pool.value.verdict -ceq 'PASS_BOUND_SOURCE_POOL_ONLY_BEFORE_CAPTURE' -and $pool.value.owner_master_sha256 -ceq $MasterSha -and $pool.value.execution_lease_sha256 -ceq $Config.owner_lease_sha256 -and $pool.value.root_trust_selection_sha256 -ceq $TrustRow.sha256) 'Different post-trust peer source/lease/trust exact nominals'
    foreach($key in @('exact_source_assignment_reversal','exact_function_class_ASTs','before_capture_timer')){Need ($pool.value[$key] -is [bool] -and $pool.value[$key]) 'Source-only exact reversal/AST before-timer proof'}
    foreach($key in @('mains_or_target_execution','operational_authority_granted')){Need ($pool.value[$key] -is [bool] -and -not $pool.value[$key]) 'Source peer grants no target or operational authority'}
    Exact $pool.value.source_templates @('utility','composer') 'Two original templates';Exact $pool.value.bound_sources @('utility','composer') 'Two bound sources'
    Need ($pool.value.source_templates.composer.path -ceq $s.path -and $pool.value.source_templates.composer.sha256 -ceq $s.sha256 -and $pool.value.bound_sources.composer.path -ceq $boundPath -and $pool.value.bound_sources.composer.sha256 -ceq $boundSource.sha256) 'Composer T-to-B externally selected peer'
    Need ($pool.value.source_templates.utility.path -ceq (Join-Path $BoundChecker 'review_guard006_actual_records_001-corrected008.TEMPLATE.py') -and $pool.value.bound_sources.utility.path -ceq (Join-Path $BoundChecker 'review_guard006_actual_records_001.BOUND.py') -and $pool.value.bound_sources.utility.sha256 -ceq $boundReady.value.utility_sha256) 'Fixed reviewed utility source and actual independent READY linkage'
    foreach($set in @($pool.value.source_templates,$pool.value.bound_sources)){
        foreach($key in @('utility','composer')){Exact $set[$key] @('path','sha256','bytes') 'Bound-model source row3';$row=$set[$key];Need ($row.bytes -is [int] -and $row.bytes -gt 0 -and $row.bytes -le 131072) 'Existing literal bound-source cap';$observed=Read-Bytes $row.path $row.sha256 $row.bytes;Need ($observed.bytes.Length -eq $row.bytes) 'Exact bound-source size'}
    }
    Exact $pool.value.binding_data @('utility_source_bindings','utility_source_protocol','composer_fresh_source_model') 'Three retained binding inputs'
    foreach($row in $pool.value.binding_data.Values){Exact $row @('path','sha256','bytes') 'Strict source-binding row3';Need ($row.bytes -is [int] -and $row.bytes -gt 0 -and $row.bytes -le 2097152) 'Selected bounded binding-data cap';[void](Record $row.path $row.sha256 $row.bytes)}
    Exact $pool.value.source_pool_projection @('path','sha256') 'Finite Source-pool projection';[void](Record $pool.value.source_pool_projection.path $pool.value.source_pool_projection.sha256 2097152)
    [void](Stamp $pool.value.created_utc 'Py')
    return $boundSource
}
function Packet([string]$Phase){
    $boundSource=Source-Pool
    # Packet creation is an explicit Root-owned metadata helper, separate from
    # the different reviewer that consumes and decides it. Direct fixed BASE.
    $python='D:\Aenv\pro2\runtimes\week8-python313-frozen-001\python.exe'
    [void](Read-Bytes $python '5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed' 105816)
    $ack=Read-Bytes (Join-Path $Guard 'ROOT_EXECUTION_ACK_GUARD_UNIT006.json') '' 65536
    $acceptance=Read-Bytes (Join-Path $Guard 'INDEPENDENT_WHOLE_BEFORE_ACCEPTANCE_006.json') '' 65536
    $auth=Read-Bytes (Join-Path $Guard 'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json') '' 65536
    $metadataCore=Read-Bytes (Core-Path 'capture_before') '' 65536;$wholeCore=Read-Bytes (Core-Path 'whole_before_result') '' 65536
    $argv=@($python,'-I','-S','-B','-X','utf8',$boundSource.path,'--expected-self-sha256',$boundSource.sha256,'--phase',$Phase,'--ack-sha256',$ack.sha256,'--whole-acceptance-sha256',$acceptance.sha256,'--whole-auth-sha256',$auth.sha256,'--metadata-core-sha256',$metadataCore.sha256,'--whole-core-sha256',$wholeCore.sha256)
    if($Phase -ceq 'late'){$bound=Read-Bytes (Join-Path $Guard 'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json') '' 65536;$launcher=Read-Bytes (Join-Path $Guard 'ROOT_FIRST_LAUNCH_006-rev003.BOUND.ps1') '' 65536;$argv+=@('--bound-review-sha256',$bound.sha256,'--root-launcher-sha256',$launcher.sha256)}
    Run-Command ('root_packet_'+$Phase) $argv 15
    $r=Wait-Record (Join-Path $BoundChecker ($Phase.ToUpperInvariant()+'_DECISION_READY_006.json')) 65536 510
    Exact $r.value @('schema_version','record_type','reviewer','phase','created_utc','target_execution') 'Different decision READY6'
    Need ($r.value.schema_version -is [int] -and $r.value.schema_version -eq 1 -and $r.value.record_type -ceq 'guard006_actual_decision_ready') 'Genuine different READY6 nominals';[void](Stamp $r.value.created_utc 'Py')
    Need ($r.value.reviewer -ceq '/root/pubnative_review' -and $r.value.phase -ceq $Phase -and $r.value.target_execution -is [bool] -and -not $r.value.target_execution) 'Different bound/late completed'
    Fresh-Original 90
}

