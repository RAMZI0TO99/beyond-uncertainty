PHASE_KEYS = ['PowerShell_parser_errors', 'actual_authorization_or_entry_approved', 'after_supervisor_sha256',
              'after_writer_sha256', 'binding_author', 'bound_metadata_source_sha256', 'bound_source_review_sha256',
              'created_utc', 'exact_two_literal_reversal_all_four', 'metadata_only', 'phase_source_binding_sha256',
              'phase_sources', 'record_type', 'reviewer', 'reviewer_agent', 'schema_version', 'source_author',
              'supervisor_sha256', 'verdict', 'writer_sha256']

def main():
    OUT.mkdir(parents=True, exist_ok=True)
    manifest_data, _ = observe(MANIFEST, MANIFEST_SHA)
    manifest = json.loads(manifest_data)
    if type(manifest['payload_count']) is not int or manifest['payload_count'] != 28 or len(manifest['payloads']) != 28:
        raise ValueError('unexpected selected author manifest payload count')
    finite = [(MANIFEST, MANIFEST_SHA, len(manifest_data))]
    for row in manifest['payloads']:
        if set(row) != {'path', 'bytes', 'sha256'} or type(row['bytes']) is not int:
            raise ValueError('unexpected payload row')
        relative = Path(row['path'])
        if relative.is_absolute() or len(relative.parts) != 1 or row['path'] in {'.', '..'}:
            raise ValueError('payload must be a finite flat leaf')
        finite.append((PREP / relative, row['sha256'], row['bytes']))
    finite.extend((WORK / relative, pin, None) for relative, pin in DEPENDENCIES)
    if len({path.as_posix().casefold() for path, _, _ in finite}) != len(finite):
        raise ValueError('duplicate finite input')
    observations = []
    contents = {}
    for phase in (1, 2, 3):
        rows = []
        for path, pin, length in finite:
            data, row = observe(path, pin, length)
            rows.append(row)
            contents[path] = data
        observations.append({'phase': phase, 'rows': rows})
    source = contents[SELECTED]
    if digest(source) != SELECTED_SHA or len(source) != 123091:
        raise ValueError('selected source changed')
    tree = ast.parse(source, filename=SELECTED.as_posix())
    functions = [node for node in tree.body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))]
    ast_rows = [{'name': node.name, 'line': node.lineno, 'end_line': node.end_lineno,
                 'ast_sha256': digest(ast.dump(node, include_attributes=False).encode('utf8'))} for node in functions]
    # Compile new checker source only to inert metadata. The resulting CodeType is never executed.
    code = compile(tree, SELECTED.as_posix(), 'exec', dont_inherit=True, optimize=0)
    code_rows = []
    def walk_code(value):
        code_rows.append({'name': value.co_name, 'qualname': value.co_qualname, 'first_line': value.co_firstlineno,
                          'flags': value.co_flags, 'argcount': value.co_argcount, 'bytecode_bytes': len(value.co_code)})
        for item in value.co_consts:
            if isinstance(item, types.CodeType):
                walk_code(item)
    walk_code(code)
    imports = [ast.unparse(node) for node in tree.body if isinstance(node, (ast.Import, ast.ImportFrom))]
    test_tree = ast.parse(contents[PREP / 'test_metadata3_actual_checker_preparation_001.py'])
    planned_tests = [{'class': node.name, 'methods': [item.name for item in node.body
                     if isinstance(item, ast.FunctionDef) and item.name.startswith('test_')]}
                     for node in test_tree.body if isinstance(node, ast.ClassDef)]
    lines = source.decode('utf8').splitlines()
    for finding in FINDINGS:
        finding['severity'] = 'BLOCKING_SOURCE'
        finding['evidence_type'] = 'source_control_flow_and_protocol_comparison_not_runtime_result'
        finding['source_sha256'] = SELECTED_SHA
        finding['source_excerpts'] = [{'line': line, 'text': lines[line-1]} for line in finding['lines']]
    retained = [
        'All 28 author manifest payload bytes and eight explicitly pinned static dependencies were observed in three finite read phases; no recursive project or runtime inventory was taken.',
        'Closed Core12/Auth17/capture14/WholeAuth15/WholeResult19/WholeParent30/MetaParent20/RootACK22 and physical18 versus driver20 boundaries were examined in the full selected source.',
        'Context742/config55/current Git7 path semantics and runtime4 nominal source checks were examined. Reading source is not a current runtime capture or a Git invocation.',
        'Whole two-tree streamed comparisons, bounded complete chunks and diagnostic events, bridge15, exact24 methods and evidence26 were reviewed; planned tests remain UNRUN.',
        'Root trust8, INIT8, phase10 and the nineteen named source pool closure were read as source. Their genuine future actual pins and Root source peer were not fabricated or consumed as live authority.',
        'Ongoing master de8f and its pinned immutable owner peer56a7 were observed unchanged; the genuine short reviewer owner_docs_review is distinct from canonical new actual/source reviewers.',
        'No blanket mode/ctime/birth relaxation is approved by this report. Native EXE exceptions remain tied to authenticated fixed path/SHA roles; WHOLE cross-API comparisons retain the observer policy.',
        'A potential duplicate driver evidence concern was checked and withdrawn: the acceptance and observer result are distinct roles. It is not a finding.',
        'These are source blockers. No runtime failure, exploit, test outcome, physical OS attestation or operational acceptance is claimed.'
    ]
    metadata = publish('SOURCE_AST_AND_INERT_CODE_METADATA_001.json', {
        'schema_version': 1, 'record_type': 'independent_checker_source_ast_and_inert_code_metadata',
        'reviewer': '/root/renewal_runtime_inventory', 'selected_source_sha256': SELECTED_SHA,
        'top_level_functions': ast_rows, 'top_level_function_count': len(ast_rows), 'imports': imports,
        'inert_CodeType_metadata': code_rows, 'inert_CodeType_count': len(code_rows),
        'planned_test_AST_classes': planned_tests, 'tests_executed': False,
        'audited_definitions_imports_mains_executed': False, 'pyc_written': False
    })
    report = {
        'schema_version': 1, 'record_type': 'independent_metadata3_actual_checker_source_audit_details',
        'source_author': '/root/actual_record_checker', 'reviewer': '/root/renewal_runtime_inventory',
        'created_utc': now(), 'verdict': 'REFUSED_SOURCE007_REQUIRES_DISTINCT_CORRECTED_SOURCE',
        'scope': 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY',
        'source_manifest': {'path': MANIFEST.as_posix(), 'sha256': MANIFEST_SHA, 'bytes': len(manifest_data)},
        'selected_source': {'path': SELECTED.as_posix(), 'sha256': SELECTED_SHA, 'bytes': len(source)},
        'manifest_payload_count': 28, 'finite_input_count': len(finite), 'observations': observations,
        'syntax_and_inert_metadata': metadata, 'findings': FINDINGS, 'blocking_finding_count': len(FINDINGS),
        'authentic_phase_peer_contract': {
            'closed_top_level_keys': PHASE_KEYS, 'schema_version': 1,
            'record_type': 'guard006_root_metadata_phase_ps_source_binding_review',
            'source_author': '/root/renewal_runtime_inventory', 'binding_author': '/root',
            'reviewer': '/root/owner_docs_review', 'reviewer_agent': '/root/owner_docs_review',
            'verdict': 'PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY', 'metadata_only': True,
            'actual_authorization_or_entry_approved': False, 'exact_two_literal_reversal_all_four': True,
            'PowerShell_parser_errors': 0, 'phase_sources_exact_row_count': 4,
            'peer_source_row_keys': ['PowerShell_parser_errors', 'bytes', 'exact_two_literal_reversal', 'path', 'sha256', 'template_sha256'],
            'binding_source_row_keys': ['path', 'sha256', 'template_sha256', 'exact_two_literal_reversal'],
            'scope_field_present': False,
            'nominal_policy': 'All booleans and integers are exact builtin types, not interchangeable equality. Four aggregates and ordered rows bind genuine selected sources.'
        },
        'reviewed_preservation_and_limits': retained,
        'implementation_conditions': [
            'Preserve author Source007 bytes, its manifest and history. Correct only through a distinct source selection and require independent complete source audit.',
            'Root may publish its separate canonical source peer only after its own genuine full audit, explicitly crediting this independent worker audit; this report does not impersonate Root.',
            'No actual readiness, binding, lease, source peer, timer, authorization, capture or target GO is supplied by this report.'
        ],
        'actual_results': None, 'runtime_acceptance': False, 'operational_authority': False,
        'audited_definitions_imports_mains_tests_Git_FFI_PS_native_executed': False,
        'post_capture_reference': None
    }
    report_row = publish('INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_001.json', report)
    md = '# Independent Metadata3 checker Source007 audit\n\nSource007 is refused pending a distinct corrected source. This is source reasoning, not runtime execution.\n\n'
    md += 'Reviewer: `/root/renewal_runtime_inventory`. Source author: `/root/actual_record_checker`.\n\n'
    md += 'Frozen manifest: `' + MANIFEST_SHA + '`. Selected checker: `' + SELECTED_SHA + '` / 123091 bytes. All 28 payloads and eight pinned static dependencies were observed three times (37 finite files including the manifest).\n\n'
    for finding in FINDINGS:
        md += '## ' + finding['id'] + ' — ' + finding['title'] + '\n\n' + finding['evidence'] + '\n\n' + finding['required_correction'] + '\n\n'
    md += 'The complete selected checker source was reviewed. AST and inert CodeType metadata were collected without executing definitions, imports, mains or tests. No runtime, binding, lease, authorization or operational acceptance is granted. Keep Source007 exact and independently audit the distinct successor.\n'
    md_path = OUT / 'INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_001.md'
    with md_path.open('xb') as handle:
        handle.write(md.encode('utf8'))
    post_rows = []
    for path, pin, length in finite:
        _, row = observe(path, pin, length)
        post_rows.append(row)
    report_data, report_obs = observe(Path(report_row['path']), report_row['sha256'], report_row['bytes'])
    post = publish('POST_CAPTURE_PRESERVATION_001.json', {
        'schema_version': 1, 'record_type': 'independent_checker_source_post_capture_preservation',
        'reviewer': '/root/renewal_runtime_inventory', 'created_utc': now(),
        'report': report_row, 'report_observation': report_obs, 'finite_input_count': len(finite),
        'post_rows': post_rows, 'all_source_pins_preserved': True, 'runtime_acceptance': False,
        'operational_authority': False
    })
    print(json.dumps({'report': report_row, 'post': post, 'metadata': metadata,
                      'findings': len(FINDINGS), 'finite_inputs': len(finite), 'functions': len(ast_rows)}, indent=2))

if __name__ == '__main__':
    main()
