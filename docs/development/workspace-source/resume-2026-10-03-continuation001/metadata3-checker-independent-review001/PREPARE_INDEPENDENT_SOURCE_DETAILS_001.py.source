def digest(data):
    return hashlib.sha256(data).hexdigest()

def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')

def raw9(st):
    return [st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns,
            st.st_mode, st.st_nlink, getattr(st, 'st_file_attributes', 0), st.st_birthtime_ns]

def observe(path, pin, length=None):
    before = path.stat()
    if not path.is_file() or path.is_symlink() or before.st_size > 2 * 1024 * 1024:
        raise ValueError('invalid finite source input: ' + str(path))
    with path.open('rb') as handle:
        fd_before = os.fstat(handle.fileno())
        data = handle.read(2 * 1024 * 1024 + 1)
        fd_after = os.fstat(handle.fileno())
    after = path.stat()
    if raw9(before) != raw9(after) or raw9(fd_before) != raw9(fd_after):
        raise ValueError('source moved during read: ' + str(path))
    if digest(data) != pin or (length is not None and len(data) != length):
        raise ValueError('source pin mismatch: ' + str(path))
    return data, {'path': path.as_posix(), 'sha256': pin, 'bytes': len(data),
                  'path_raw9': raw9(after), 'descriptor_raw9': raw9(fd_after), 'observed_utc': now()}

def publish(name, value):
    path = OUT / name
    data = (json.dumps(value, ensure_ascii=True, indent=2, allow_nan=False) + '\n').encode('utf8')
    with path.open('xb') as handle:
        handle.write(data)
    return {'path': path.as_posix(), 'sha256': digest(data), 'bytes': len(data)}

