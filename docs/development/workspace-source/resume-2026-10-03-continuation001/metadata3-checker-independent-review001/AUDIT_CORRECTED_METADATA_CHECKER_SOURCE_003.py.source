assert 'own_output_read' in segments['once'] and 'read(' not in segments['once'].replace('own_output_read(', '')
assert "record_type='guard006_root_metadata_bound_source_review'" in segments['bound_metadata_review']
assert 'python_source_reversal' in segments['fixed'] and 'phase_source_review' in segments['fixed']
assert 'binding[\'template_sha256\']==digest(template)' in segments['fixed']
assert 'typed_equal(first,trees[role+\'-second\'])' in segments['whole_before_result'] and 'register_whole_rows(validated_whole_rows)' in segments['whole_before_result']
assert 'register_whole_rows(validated_whole_rows)' in segments['whole_after_result'] and 'exact_raw9' in segments['current_stream_file']
assert r"else r'\.[0-9]{6}'" in segments['stamp'] and "timespec='microseconds'" in segments['now_exact']
for call in ast.walk(t):
 if isinstance(call,ast.Call) and isinstance(call.func,ast.Attribute) and call.func.attr=='isoformat':assert any(k.arg=='timespec' and isinstance(k.value,ast.Constant) and k.value.value=='microseconds' for k in call.keywords)
tp=SOURCE/'test_metadata3_actual_checker_preparation_002.py';tt=ast.parse(data[tp],filename=str(tp));tc=compile(data[tp],str(tp),'exec',dont_inherit=True,optimize=0)
tests=methods(tt);oldtests=methods(ast.parse(data[SOURCE/'test_metadata3_actual_checker_preparation_001.py']))
assert len(tests)==19 and len(oldtests)==9 and all(tests[k]==value for k,value in oldtests.items())
syntax=[]
for p in sorted(data,key=str):
 if p.suffix=='.py' or p.name.endswith('.py.source'):
  body=data[p];fragment=p.name=='CORRECTED_TEST_METHODS_002.py.source'
  if fragment:body=b'class InertSourceFragment:\n'+body
  tree=ast.parse(body,filename=str(p));inert=compile(body,str(p),'exec',dont_inherit=True,optimize=0)
  syntax.append(dict(path=str(p),sha256=sha(data[p]),function_names=list(functions(tree)),inert_code_flags=inert.co_flags,indented_fragment_wrapped_for_syntax_metadata=fragment,execution=False))
