import ast, datetime, hashlib, json, os
from pathlib import Path
BASE=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001')
SOURCE=BASE/'metadata3-actual-checker-prep001';OUT=BASE/'metadata3-checker-independent-review001'
SCOPE='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
MANIFEST_SHA='93f8754ed186873cba93960ce027558b86f70fbb2a9f9ee37a3c18fde7b5d4ee'
CHECKER_SHA='c097c756d8cf55b1ac98a68313f5e406455b9306af63bd48a6e1cb3add70d3c1'
REFUSAL_SHA='92937a787276a18e3d36b012d99febda84fcac5c5f8b2ca5db14dd7e14a419d3'
def sha(b):return hashlib.sha256(b).hexdigest()
def utc():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def enc(x):return (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def invalid(x):raise ValueError(x)
def parse(b):return json.loads(b.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=invalid,parse_constant=invalid)
def raw(s):return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def read(p):
 a=p.lstat();assert a.st_nlink==1 and not a.st_file_attributes&1024
 b=p.read_bytes();z=p.lstat();assert raw(a)==raw(z)
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),raw9=raw(z),observed_utc=utc())
def once(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
def literals(t):
 result={}
 for n in t.body:
  if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
   try:result[n.targets[0].id]=ast.literal_eval(n.value)
   except (ValueError,TypeError):pass
 return result
def functions(t):return {n.name:ast.dump(n,include_attributes=False) for n in t.body if isinstance(n,ast.FunctionDef)}
def methods(t):return {n.name:ast.dump(n,include_attributes=False) for c in t.body if isinstance(c,ast.ClassDef) for n in c.body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}
mp=SOURCE/'AUTHOR_FROZEN_SOURCE_MANIFEST_008.json';b=mp.read_bytes();assert sha(b)==MANIFEST_SHA;m=parse(b)
oldp=OUT/'INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_001.json';b=oldp.read_bytes();assert sha(b)==REFUSAL_SHA;old=parse(b)
assert m['payload_count']==40 and len(m['payloads'])==40 and len({r['path'] for r in m['payloads']})==40
assert m['independent_source007_refusal_sha256']==REFUSAL_SHA and len(old['findings'])==9
assert all(m[k] is None for k in ('different_corrected_source_review','actual_source_binding','actual_lease','actual_ready','actual_before','actual_after','actual_results'))
assert m['runtime_acceptance'] is False and m['operational_authority'] is False and m['reviewed_definitions_imports_mains_tests_Git_FFI_PS_native_executed'] is False
pins={mp:MANIFEST_SHA,oldp:REFUSAL_SHA}
for r in m['payloads']:assert Path(r['path']).name==r['path'];pins[SOURCE/r['path']]=r['sha256']
for r in old['observations'][0]['rows']:pins[Path(r['path'])]=r['sha256']
extra=[
 (BASE/'gg6-source-independent-review001/INDEPENDENT_GG6_SOURCE_REVIEW_003.json','82b9643b78e4d4c388781e53b79c8a0546f9b07afca641ccfa71ff677483dae1'),
 (BASE/'m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json','78bc1b1a7a3e06e6752283e632651faac1b07f8f307f1612ceac4b1bd015bf30'),
 (BASE/'root-pipeline-independent-review001/INDEPENDENT_ROOT_PIPELINE_ARCHITECTURE_REVIEW_001.json','32bdaae92a400d1d117ca7eaa6274d7cb069a79c8abfd62cd7745c7d0a087a57'),
 (BASE/'root-pipeline-independent-review001/INDEPENDENT_ROOT_PIPELINE_BINDER_SOURCE_REVIEW_001.json','389b8131c675637bd91188d0d240deaf0370beacf768d3f64b3ce0d60988f863'),
 (BASE/'root-guard006-pipeline-prep001/RUN_ROOT_METADATA_PIPELINE_006.TEMPLATE.ps1','9b7dbc059cc51601e08bbf4ff748123b53034533173dca5a6254352e47f997e8')]
for p,h in extra:pins[p]=h
observations=[];data=None
for phase in range(1,4):
 current={};rows=[]
 for p in sorted(pins,key=str):
  b,r=read(p);assert sha(b)==pins[p],str(p);current[p]=b;rows.append(r)
 if data is None:data=current
 else:assert current==data
 observations.append(dict(phase=phase,rows=rows))
for r in m['payloads']:assert len(data[SOURCE/r['path']])==r['bytes']
sp=SOURCE/'review-metadata3-actual006-corrected008.TEMPLATE.py';assert sha(data[sp])==CHECKER_SHA and len(data[sp])==137182
t=ast.parse(data[sp],filename=str(sp));code=compile(data[sp],str(sp),'exec',dont_inherit=True,optimize=0);v=literals(t);fn=functions(t)
oldtree=ast.parse(data[SOURCE/'review-metadata3-actual006.TEMPLATE.py']);oldfn=functions(oldtree)
changed=sorted(n for n in fn if oldfn.get(n)!=fn[n]);unchanged=sorted(n for n in fn if oldfn.get(n)==fn[n])
assert len(fn)==65 and fn['read']==oldfn['read'] and fn['typed_equal']==oldfn['typed_equal']
protocol=parse(data[SOURCE/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_008.json'])
for key,names in protocol['closed_source_literal_schemas'].items():assert list(v[key])==names,key
assert list(v['PHASE_PEER_KEYS'])==protocol['phase_peer20_keys'] and len(v['PHASE_PEER_KEYS'])==20 and 'scope' not in v['PHASE_PEER_KEYS']
assert len(v['M3_SOURCE_PEER_KEYS'])==22 and len(v['LEASE_KEYS'])==12 and len(v['CORE_KEYS'])==12
assert v['M3_MANIFEST_SHA']=='df54adc4ef8303124590fc5c8f1191815ceff6c61f7db56a511390f9de9f7e5a'
assert v['SELF_SHA'] is None if 'SELF_SHA' in v else True
text=data[sp].decode('utf8')
segments={n.name:ast.get_source_segment(text,n) for n in t.body if isinstance(n,ast.FunctionDef)}
assert 'preflight_ready(trust_pin)' in segments['main'] and segments['main'].index('preflight_ready(trust_pin)')<segments['main'].index('once(ready')
assert 'fixed()' in segments['preflight_ready'] and 'root_trust_preflight(trust_pin)' in segments['preflight_ready']
assert "read(PIPELINE/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1'" in segments['whole_bridge']
assert 'PREP/\'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.ps1\'' not in segments['whole_bridge']
