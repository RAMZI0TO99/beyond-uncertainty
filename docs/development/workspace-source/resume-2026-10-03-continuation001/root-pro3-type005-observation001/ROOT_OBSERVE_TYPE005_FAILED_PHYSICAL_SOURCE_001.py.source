"""Documentation observation of four fixed spent TYPE005 source records only."""
import datetime
import decimal
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
COORD = Path(r"D:\Aenv\pro3\runs\coordination\next_step_20261003_types5")
FILES = [
    (COORD / "root_type_physical_witness_001.json", "1cfa72bc356e76b9b05a6f0cc4c288c29aed845aaba04291ab8ae494a2e24466"),
    (COORD / "root_failed_type_cleanup_closeout_001.json", "26635f21ae45148d7336669ae07240d6c0f402fe0cb49f1889534881cc287d32"),
    (COORD / "root_type_peer_release_closeout_001.json", "cabe66d57be71bcdd3ca4ac6fa4ff90ac4404b95f276d27d40cbdedd14db1446"),
    (HERE.parent / "ROOT_PRO3_TYPE_COMPONENT_RELEASE_005.json", "ec02f637f17f2296d3da845109cc7e399181b11ccbc9421e5719ffb1f6d85730"),
]

def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns, s.st_mode, s.st_nlink, s.st_file_attributes, s.st_birthtime_ns]

def read(path, pin):
    before = raw9(path.stat()); data = path.read_bytes()
    assert before == raw9(path.stat()) and before[2] == len(data) and hashlib.sha256(data).hexdigest() == pin
    return data, dict(path=str(path), sha256=pin, bytes=len(data), raw9=before)

def main():
    output = HERE / "ROOT_EXTERNAL_TYPE005_FAILED_PHYSICAL_SOURCE_OBSERVATION_001.json"
    assert not output.exists() and not (HERE / "before").exists()
    captured = []
    for path, pin in FILES:
        data, row = read(path, pin)
        for _ in range(2):
            assert read(path, pin) == (data, row)
        captured.append((data, row))
    physical, cleanup, release, grant = [json.loads(data, parse_float=decimal.Decimal) for data, row in captured]
    assert physical["cli_exit_code"] == 1 and physical["within120_seconds"] is True
    assert physical["physical_cli_seconds"] == decimal.Decimal("96.9217687")
    assert cleanup["supervision_reason"] == "session_deadline" and cleanup["child_result_exists"] is False
    assert cleanup["actual_mypy_invocation_or_return_not_certified"] is True
    assert cleanup["final_source_runtime_operations_checks_not_completed"] is True
    assert cleanup["native_failed_candidate_whole_cleanup_claim"] is False
    assert release["attempt_and_grant_consumed"] is True and release["automatic_retry_authorized"] is False
    assert release["full_guarded_component_accepted"] is False
    assert release["exact_message_completion_timestamp_not_recorded"] is True
    (HERE / "before").mkdir()
    observations = []
    for data, row in captured:
        copy = HERE / "before" / Path(row["path"]).name
        with copy.open("xb") as handle:
            handle.write(data)
        copied, copy_row = read(copy, row["sha256"])
        assert copied == data
        assert read(Path(row["path"]), row["sha256"]) == (data, row)
        observations.append(dict(row, before_copy=copy_row, triple_copy_post_exact=True))
    report = dict(schema_version=1, record_type="root_external_type005_failed_physical_source_observation", author="/root",
                  recorded_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), observations=observations,
                  scope="Four fixed saved Source records only; actual different failure audit pending at this observation",
                  native_exit_code=1, physical_seconds_decimal_literal="96.9217687", physical120_and_both_ends_saved=True,
                  session_deadline_refusal=True, completed_child_result_or_new_mypy_API_invocation_or_return_certified=False,
                  native_precision_comparison_stage_not_reached_attributed_to_Pro3_Root=True,
                  native_final_source_runtime_operations_checks_uncompleted=True, native_false_cleanup_claim_preserved=True,
                  owned_Job_termination_empty_closed_and_four_named_PID_absences_attributed_to_Pro3_Root=True,
                  Root_pro2_independent_OS_Job_process_scan_or_whole_host_quiet_attestation=False,
                  Root_owned_hold_from_final_grant_ed36ad_through_explicit_release_ack_175622=True,
                  exact_external_release_message_completion_timestamp_unmeasured_preserved=True,
                  grant005_and_attempt005_spent_no_replay=True, repaired_gate_component_runtime_science_or_operational_PASS=False,
                  TYPE004_prior_mypy_zero_history_unchanged=True, TYPE001_original_unretained_failure_cause_inferred=False,
                  no_new_phase_compute_grant_or_goal_renewal=True, documentation_closeout_only=True)
    body = (json.dumps(report, indent=2, sort_keys=True) + "\n").encode()
    with output.open("xb") as handle:
        handle.write(body)
    assert output.read_bytes() == body
    print(json.dumps(dict(path=str(output), sha256=hashlib.sha256(body).hexdigest(), bytes=len(body))))

if __name__ == "__main__":
    main()
