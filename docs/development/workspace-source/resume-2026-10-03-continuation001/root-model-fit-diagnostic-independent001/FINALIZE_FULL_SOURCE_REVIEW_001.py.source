def need(ok,message):
    if not ok:raise ValueError(message)

def sha(data):return hashlib.sha256(data).hexdigest()
def wire(value):return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(info):return [getattr(info,key) for key in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def parents(path):
    rows=[]
    for p in reversed(path.parents):
        info=p.lstat();need(stat.S_ISDIR(info.st_mode) and not info.st_file_attributes&1024,'plain ancestors')
        rows.append([str(p),info.st_dev,info.st_ino])
    return rows
def observe(path,cap):
    chain=parents(path);a=raw(path.lstat())
    need(stat.S_ISREG(a[5]) and a[6]==1 and not a[7]&1024 and 0<=a[2]<=cap and a[4]==a[8],'bounded plain input')
    with path.open('rb',buffering=0) as stream:
        b=raw(os.fstat(stream.fileno()));need(all(a[i]==b[i] for i in (0,1,2,3,5,6,7,8)),'paired identity')
        data=stream.read(a[2]+1);need(raw(os.fstat(stream.fileno()))==b,'descriptor drift')
    need(raw(path.lstat())==a and parents(path)==chain and len(data)==a[2],'complete current bytes')
    return data,dict(path=str(path),sha256=sha(data),bytes=len(data),path_raw9=a,descriptor_raw9=b,ancestors=chain)
def pairs(items):
    result={}
    for key,value in items:need(key not in result,'duplicate JSON');result[key]=value
    return result
def forbidden(value):raise ValueError('noninteger JSON '+value)
def decode(data):return json.loads(data.decode('utf8'),object_pairs_hook=pairs,parse_float=forbidden,parse_constant=forbidden)
def own(path,pin=None):
    data,row=observe(path,8388608);need(pin is None or sha(data)==pin,'own selected hash');return data

