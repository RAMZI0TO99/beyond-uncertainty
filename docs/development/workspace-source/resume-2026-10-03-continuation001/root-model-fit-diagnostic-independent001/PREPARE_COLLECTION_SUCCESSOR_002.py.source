text=text.replace("pool_discrepancy=record(WORK/'guard006-actual-bound-pool-independent001/INDEPENDENT_SOURCE_POOL_PREPARATION_DISCREPANCY_001.json',",
    "pool_discrepancy=collect(WORK/'guard006-actual-bound-pool-independent001/INDEPENDENT_SOURCE_POOL_PREPARATION_DISCREPANCY_001.json',")
text=text.replace("pool_discrepancy_keys=list(pool_discrepancy),", "pool_discrepancy_retention='Externally pinned opaque Source evidence; not model-admission JSON or operational acceptance',")
