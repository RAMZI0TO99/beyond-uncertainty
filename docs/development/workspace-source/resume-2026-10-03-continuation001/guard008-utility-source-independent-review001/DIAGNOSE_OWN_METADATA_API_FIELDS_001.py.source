"""Read metadata fields only; no reviewed definitions are imported or called."""
import json
import os
from pathlib import Path

u = Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/guard006-bound-late-checker-prep001')
keys = ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
out = []
for leaf in ('AUTHOR_FROZEN_SOURCE_MANIFEST_008.json','AUTHOR_FROZEN_SOURCE_MANIFEST_007.json'):
    for row in json.loads((u / leaf).read_text(encoding='utf-8'))['payloads']:
        p = u / row['path']
        a = p.lstat()
        fd = os.open(p, os.O_RDONLY | os.O_BINARY)
        try:
            b = os.fstat(fd)
        finally:
            os.close(fd)
        diff = {k:[getattr(a,k),getattr(b,k)] for k in keys if getattr(a,k) != getattr(b,k)}
        if diff:
            out.append({'path':str(p),'different_fields':diff})
print(json.dumps(out,sort_keys=True))
