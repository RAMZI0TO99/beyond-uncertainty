KEYS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
API8=(0,1,2,3,5,6,7,8)
def sha(data):return hashlib.sha256(data).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(i):
    row=[getattr(i,k,None)for k in KEYS];assert all(type(v)is int for v in row);return row
def read(p):
    a=p.lstat();ar=raw(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&0x400 and 0<a.st_size<=8388608
    parents=[]
    for q in p.parents:
        info=q.lstat();assert stat.S_ISDIR(info.st_mode)and not stat.S_ISLNK(info.st_mode)and not info.st_file_attributes&0x400
        parents.append((str(q),info.st_dev,info.st_ino))
    with p.open('rb')as stream:
        h=os.fstat(stream.fileno());hr=raw(h);assert stat.S_ISREG(h.st_mode)and h.st_nlink==1 and not h.st_file_attributes&0x400
        assert all(ar[i]==hr[i]for i in API8)and a.st_ctime_ns==a.st_birthtime_ns
        data=stream.read(8388609);assert raw(os.fstat(stream.fileno()))==hr
    assert len(data)==a.st_size and raw(p.lstat())==ar
    assert parents==[(str(q),q.lstat().st_dev,q.lstat().st_ino)for q in p.parents]
    return data,dict(path=str(p),bytes=len(data),sha256=sha(data),path_raw9=ar,descriptor_raw9=hr,
                     API8_indices=list(API8),cross_API_ctime_equality_asserted=False)
def once(p,data):
    with p.open('xb')as stream:stream.write(data);stream.flush();os.fsync(stream.fileno())
    assert read(p)[0]==data

