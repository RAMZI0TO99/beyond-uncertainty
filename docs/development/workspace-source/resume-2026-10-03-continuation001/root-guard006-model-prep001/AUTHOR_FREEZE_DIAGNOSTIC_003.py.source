    historical_selection19=dict(path=str(OWN/'ROOT_ACTUAL_MODEL_SELECTION_001.json'),sha256=read(OWN/'ROOT_ACTUAL_MODEL_SELECTION_001.json')[1]['sha256'],builder_source_peer_stays_predecessor=True),
    retained_option_names=['--expected-self-sha256','--expected-source-review-sha256','--expected-selection-sha256'],
