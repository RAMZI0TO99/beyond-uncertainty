        required_values=dict(schema_version=1,record_type='guard006_data_model_constructor_source_review',source_author='/root/pubnative_review',verdict='PASS_SOURCE_DATA_ASSEMBLY_ONLY',constructor_sha256=sha(newbytes),actual_selection=None,source_bindings_created=False,target_execution=False)),
    manifest_path=str(OWN/'AUTHOR_FROZEN_MODEL_FIT_DIAGNOSTIC_SOURCE_MANIFEST_003.json'),
