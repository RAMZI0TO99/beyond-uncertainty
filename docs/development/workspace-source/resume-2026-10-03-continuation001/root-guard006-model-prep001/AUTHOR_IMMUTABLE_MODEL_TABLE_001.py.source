"""Own metadata author: reads JSON/AST literals; no target imports/calls."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path(__file__).parent
WORK=OWN.parent
P=WORK/'root-guard006-pipeline-prep001'
G=WORK/'consumer005-guard006-runtime-prep001'
M=WORK/'metadata3-producer-core-prep001'
K=WORK/'metadata3-actual-checker-prep001'
U=WORK/'guard006-bound-late-checker-prep001'
observed={}


def read(path):
    data=path.read_bytes()
    previous=observed.get(str(path))
    assert previous is None or previous==data
    observed[str(path)]=data
    return data


def sha(data):
    return hashlib.sha256(data).hexdigest()


def decoded(path):
    return json.loads(read(path))


def literals(path):
    result={}
    for node in ast.parse(read(path)).body:
        if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
            try:result[node.targets[0].id]=ast.literal_eval(node.value)
            except (ValueError,TypeError):pass
    return result


def pinned(path,cap):
    data=read(path)
    assert len(data)<=cap
    return dict(path=str(path),sha256=sha(data),bytes=len(data),cap=cap)


def wire(value):
    return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode('ascii')


def once(path,data):
    with path.open('xb') as stream:stream.write(data)


