"""Own metadata closeout after author-only failures; constructor main UNRUN."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path(__file__).parent
WORK=OWN.parent


def sha(data):return hashlib.sha256(data).hexdigest()


def wire(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode('ascii')


def once(name,data):
    with (OWN/name).open('xb') as stream:stream.write(data)


def literal(value):
    if type(value) is dict:return '{'+','.join(ascii(key)+':'+literal(value[key]) for key in sorted(value))+'}'
    if type(value) is list:return '['+','.join(literal(item) for item in value)+']'
    return ascii(value)


constructor=OWN/'ASSEMBLE_GUARD006_SOURCE_MODELS_001.TEMPLATE.py'
source=constructor.read_bytes();tree=ast.parse(source)
constants={}
for node in tree.body:
    if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
        try:constants[node.targets[0].id]=ast.literal_eval(node.value)
        except (ValueError,TypeError):pass
assert constants['SOURCE_ACTUAL_SELECTION'] is None
table_path=OWN/'IMMUTABLE_MODEL_INPUTS_001.json'
table_data=table_path.read_bytes();table=json.loads(table_data)
assert constants['TABLE_SHA']==sha(table_data)
assert len(table)==27
assert table['immutable']['checker_peer']['sha256']=='4a7188b0f44de5ac2b454de0ba6bc0e4a07b1891fa24b23c88e119d0547d4137'
selected=[constructor,table_path,OWN/'AUTHOR_IMMUTABLE_MODEL_TABLE_001.py',Path(__file__).absolute()]
selected.extend(Path(row['path']) for row in table['immutable'].values())
selected=list(dict.fromkeys(selected))
contents=[path.read_bytes() for path in selected]
for row in table['immutable'].values():
    data=Path(row['path']).read_bytes();assert sha(data)==row['sha256'] and len(data)==row['bytes'] and len(data)<=row['cap']
for unused in range(2):
    for path,data in zip(selected,contents):assert path.read_bytes()==data
copies=OWN/'selected-model-source-002';copies.mkdir()
rows=[]
for index,(path,data) in enumerate(zip(selected,contents)):
    copy=copies/(str(index).zfill(2)+'.bytes')
    with copy.open('xb') as stream:stream.write(data)
    assert copy.read_bytes()==data
    rows.append(dict(path=str(path),sha256=sha(data),bytes=len(data),copy_path=str(copy),three_reads_exact=True,copy_readback_exact=True))
selection={key:None for key in constants['SELECTED_KEYS']}
selection.update(schema_version=1,record_type='root_guard006_actual_model_input_selection',author='/root',scope=constants['SCOPE'],actual_context=None,actual_results=None,capture_started=False)
once('ROOT_ACTUAL_MODEL_SELECTION_001.TEMPLATE.json',wire(selection))
