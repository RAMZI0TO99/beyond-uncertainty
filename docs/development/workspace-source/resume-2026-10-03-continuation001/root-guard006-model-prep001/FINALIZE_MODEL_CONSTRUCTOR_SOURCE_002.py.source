 ('MC18','Healthy exclusive Source model writes then owned staging rename refuses on an existing destination; partial outputs remain consumed and no peer/GO is emitted.','one-use source output or capture role already exists'),
]
plan=dict(schema_version=1,record_type='guard006_data_model_constructor_causal_source_controls',author='/root/pubnative_review',
 common_healthy='Every case begins with a complete explicitly synthetic Source fixture satisfying all earlier named schema/Source/lease/trust/reversal gates. Verify healthy success, mutate one named guard, require exact cause and IO/publication spy counts, restore and verify success. Synthetic fixture records never become actual Root selections/records.',
 planned_controls=[dict(id=cid,case=description,cause=marker,restored_healthy_required=True,result=None) for cid,description,marker in ordinary_cases],
 planned_control_count=len(ordinary_cases),executable_tests_authored=False,tests_executed=False,actual_collection=None,actual_results=None,
 qualified_AST_negative_gap='In bind(), exact source assignment byte reversal precedes the AST comparison. A function-body mutation would be refused by byte reversal first, so it does not independently exercise the AST comparison. Builtin escaped literal substitution cannot independently mutate functions/classes. AST comparison remains a checked internal invariant; no fake compiler/interception control is advertised as reachable production coverage.')
once('CAUSAL_MODEL_SOURCE_CONTROLS_001.json',wire(plan))
