ROOT_PEER16 = ('schema_version','record_type','created_utc','reviewer','source_author','scope','verdict','pipeline_source_sha256','pipeline_binding_sha256','architecture_review_sha256','binder_source_review_sha256','source_binding_provenance','phase_argv_templates','before_capture_timer','target_execution','operational_authority_granted')
