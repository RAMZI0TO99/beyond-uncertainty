CONFIG20 = ('schema_version','record_type','author','scope','sources','profile','projection','owner_lease_sha256','owner_lease_end_utc','coordination_peer_reply','coordination_root_response','metadata_checker_ready','bound_checker_ready','packet_composer','maximum_retained_seconds','guard_sources','harness_static_review','source_manifest','source_capsule','source_capsule_review')
