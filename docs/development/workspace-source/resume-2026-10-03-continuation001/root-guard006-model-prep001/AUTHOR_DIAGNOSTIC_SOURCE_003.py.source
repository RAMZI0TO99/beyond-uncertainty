"""Author inert diagnostic Source; no reviewed definition/import/main is executed."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/root-guard006-model-prep001')
old=OWN/'ASSEMBLE_GUARD006_SOURCE_MODELS_002.TEMPLATE.py'
data=old.read_bytes()
assert hashlib.sha256(data).hexdigest()=='e6886127e80c85bbdccfc9748b5cdca28917a746feac7389cd514cb649cb092c'
text=data.decode('utf8')
newline='\r\n' if '\r\n' in text else '\n'

extra=r'''
def diagnostic_literal(value):
    # Literal-only alternatives; no references, eval, imports, callbacks or tables.
    value = clone(value)
    if type(value) is dict:
        return '{' + ','.join(diagnostic_literal(key) + ':' + diagnostic_literal(value[key]) for key in sorted(value)) + '}'
    if type(value) is list:
        return '[' + ','.join(diagnostic_literal(item) for item in value) + ']'
    if type(value) is not str:
        return ascii(value)
    candidates = [ascii(value), json.dumps(value,ensure_ascii=True)]
    if all(32 <= ord(char) < 127 for char in value):
        for quote in ("'", '"'):
            if quote not in value:
                token = 'r' + quote + value + quote
                try:
                    restored = ast.literal_eval(token)
                except (SyntaxError, ValueError):
                    continue
                if type(restored) is str and restored == value:
                    candidates.append(token)
    token = min(candidates,key=lambda item:(len(item.encode('ascii')),item))
    typed(ast.literal_eval(token),value,'diagnostic exact builtin string token')
    return token


def diagnostic_bind(data, values, originals):
    text, old_tree, found = assignments(data, values)
    edits = []
    for name,(start,end,node) in found.items():
        typed(ast.literal_eval(node),originals[name],'diagnostic original source literal')
        edits.append((start,end,diagnostic_literal(values[name])))
    for start,end,replacement in sorted(edits,reverse=True):
        text=text[:start]+replacement+text[end:]
    bound=text.encode('utf8')
    back,new_tree,changed=assignments(bound,values)
    undo=[]
    for name,(start,end,node) in changed.items():
        typed(ast.literal_eval(node),values[name],'diagnostic exact complete builtin model')
        old_start,old_end,_=found[name]
        undo.append((start,end,data.decode('utf8')[old_start:old_end]))
    for start,end,replacement in sorted(undo,reverse=True):
        back=back[:start]+replacement+back[end:]
    need(back.encode('utf8')==data,'diagnostic exact original source byte reversal')
    kinds=(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)
    typed([ast.dump(node,include_attributes=False)for node in old_tree.body if isinstance(node,kinds)],
          [ast.dump(node,include_attributes=False)for node in new_tree.body if isinstance(node,kinds)],
          'diagnostic unchanged utility/composer function/class ASTs')
    return bound


def diagnostic_sizes(value):
    return dict(json_bytes=len(wire(value)),original_literal_bytes=len(literal(value).encode('ascii')),
                alternate_literal_bytes=len(diagnostic_literal(value).encode('ascii')))
'''.strip().replace('\n',newline)
marker='def main():'
assert text.count(marker)==1
text=text.replace(marker,extra+newline*3+marker)
text=text.replace("own == OWN/'ASSEMBLE_GUARD006_SOURCE_MODELS_002.TEMPLATE.py'","own == OWN/'DIAGNOSE_GUARD006_SOURCE_MODEL_FIT_003.TEMPLATE.py'")
text=text.replace("source_review = record(OWN/'INDEPENDENT_MODEL_CONSTRUCTOR_SOURCE_REVIEW_001.json',pin(args.expected_source_review_sha256))",
                  "source_review = record(OWN/'INDEPENDENT_MODEL_FIT_DIAGNOSTIC_SOURCE_REVIEW_003.json',pin(args.expected_source_review_sha256))")
text=text.replace("source_manifest = record(OWN/'AUTHOR_FROZEN_MODEL_CONSTRUCTOR_SOURCE_MANIFEST_002.json'",
                  "source_manifest = record(OWN/'AUTHOR_FROZEN_MODEL_FIT_DIAGNOSTIC_SOURCE_MANIFEST_003.json'")
