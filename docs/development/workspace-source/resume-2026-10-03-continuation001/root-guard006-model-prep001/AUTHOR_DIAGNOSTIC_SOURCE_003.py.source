        typed(predecessor_peer[key],expected,'accepted002 exact preserved Source receipt')
    moment(predecessor_peer['created_utc'],6)
    predecessor_manifest = record(OWN/'AUTHOR_FROZEN_MODEL_CONSTRUCTOR_SOURCE_MANIFEST_002.json',predecessor_peer['source_manifest_sha256'],2097152)
    typed(predecessor_manifest['active_source_rows'],[dict(path='ASSEMBLE_GUARD006_SOURCE_MODELS_002.TEMPLATE.py',sha256=digest(predecessor_source),bytes=len(predecessor_source))],'accepted002 Source manifest')
'''.strip().replace('\n',newline)
assert text.count(needle)==1
text=text.replace(needle,'    '+original_check+newline+needle)
text=text.replace('builder_source_peer_sha256=args.expected_source_review_sha256,actual_context=None','builder_source_peer_sha256=predecessor_peer_pin,actual_context=None')
start=text.index('    # Actual complete bound byte count, not an estimated model lower bound.')
end=text.index('def validate_metadata(',start)
report=r'''
    # Nonpublishing diagnostic only. Exact current encoded sizes, not future fit.
    alternate_utility = diagnostic_bind(sources['utility'],dict(SOURCE_BINDINGS=bindings,SOURCE_PROTOCOL=protocol),dict(SOURCE_BINDINGS=None,SOURCE_PROTOCOL=None))
    alternate_composer = diagnostic_bind(sources['composer'],dict(FRESH_SOURCE_MODEL=composer),dict(FRESH_SOURCE_MODEL=None))
    for name,facts in list(OBSERVATIONS.items()):
        read(Path(name),facts['sha256'],facts['maximum'])
    lease(selection)
    capture_absent()
    report = dict(schema_version=1,record_type='root_guard006_actual_source_model_fit_diagnostic',scope=SCOPE,
        source_selection_sha256=args.expected_selection_sha256,diagnostic_source_sha256=args.expected_self_sha256,
        diagnostic_source_peer_sha256=args.expected_source_review_sha256,
        consumed_constructor002_sha256=digest(predecessor_source),
        existing_caps=dict(utility=131072,composer=131072,model=131072),
        actual_source_template_bytes=dict(utility=len(sources['utility']),composer=len(sources['composer'])),
        original_bound_bytes=dict(utility=len(utility_bytes),composer=len(composer_bytes)),
        alternate_bound_bytes=dict(utility=len(alternate_utility),composer=len(alternate_composer)),
        original_over_cap_bytes=dict(utility=max(0,len(utility_bytes)-131072),composer=max(0,len(composer_bytes)-131072)),
        alternate_over_cap_bytes=dict(utility=max(0,len(alternate_utility)-131072),composer=max(0,len(alternate_composer)-131072)),
        model_totals=dict(bindings=diagnostic_sizes(bindings),protocol=diagnostic_sizes(protocol),composer=diagnostic_sizes(composer)),
        per_binding_field={key:diagnostic_sizes(value)for key,value in bindings.items()},
        per_protocol_field={key:diagnostic_sizes(value)for key,value in protocol.items()},
        finite_before_capture_absence_count=len(missing),source_observation_count=len(OBSERVATIONS),
        source_observation_sha256=digest(wire(list(OBSERVATIONS.values()))),
        exact_literal_values_and_source_reversal_checked=True,unchanged_utility_composer_function_class_ASTs_checked=True,
        model_outputs_written=False,bound_sources_written=False,projection_written=False,
        actual_source_pool_peer=None,actual_source_binding_approval=None,Root_GO=None,
        helper_mains_executed=False,target_execution=False,runtime_acceptance=False,operational_authority=False)
    encoded = wire(report)
    need(len(encoded)<=65536,'owned diagnostic stdout record cap before print')
    print(encoded.decode('ascii'),end='')



'''.lstrip().replace('\n',newline)
text=text[:start]+report+text[end:]
newdata=text.encode('utf8')
newtree=ast.parse(text)
oldtree=ast.parse(data)
oldfunc={n.name:ast.dump(n,include_attributes=False)for n in oldtree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
newfunc={n.name:ast.dump(n,include_attributes=False)for n in newtree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
assert [name for name in oldfunc if oldfunc[name]!=newfunc[name]]==['main']
assert set(newfunc)-set(oldfunc)=={'diagnostic_literal','diagnostic_bind','diagnostic_sizes'}
target=OWN/'DIAGNOSE_GUARD006_SOURCE_MODEL_FIT_003.TEMPLATE.py'
with target.open('xb')as stream:stream.write(newdata)
print(json.dumps(dict(path=str(target),bytes=len(newdata),sha256=hashlib.sha256(newdata).hexdigest(),changed_old_function_ASTs=['main'],new_functions=['diagnostic_literal','diagnostic_bind','diagnostic_sizes'],diagnostic_executed=False),sort_keys=True))
