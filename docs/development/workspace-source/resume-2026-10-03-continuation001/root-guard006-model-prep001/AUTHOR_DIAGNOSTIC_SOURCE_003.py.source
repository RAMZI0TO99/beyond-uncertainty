original_check=r'''
    # Accepted002 is consumed. Read its source/peer as data; never call its main.
    predecessor_source = read(OWN/'ASSEMBLE_GUARD006_SOURCE_MODELS_002.TEMPLATE.py',
        'e6886127e80c85bbdccfc9748b5cdca28917a746feac7389cd514cb649cb092c',131072)
    predecessor_peer_pin = 'b35eb59954aa643cc856c3d272a42080beacd27ff935326eaaafe50e030cdcf2'
    predecessor_peer = record(OWN/'INDEPENDENT_MODEL_CONSTRUCTOR_SOURCE_REVIEW_001.json',predecessor_peer_pin)
    exact(predecessor_peer,SOURCE_PEER12,'accepted002 Source peer12')
    for key,expected in dict(schema_version=1,record_type='guard006_data_model_constructor_source_review',reviewer='/root',
        source_author='/root/pubnative_review',scope=SCOPE,verdict='PASS_SOURCE_DATA_ASSEMBLY_ONLY',
        constructor_sha256=digest(predecessor_source),source_manifest_sha256='eb8ef25a758d81abe5f0a296f5e080718f9f072a814873eb559f08d96f4cb99f',
