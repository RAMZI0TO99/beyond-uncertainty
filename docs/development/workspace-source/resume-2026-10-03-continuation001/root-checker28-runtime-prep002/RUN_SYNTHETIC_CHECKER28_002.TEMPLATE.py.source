 typed(peer,dict(schema_version=1,record_type='independent_metadata3_checker_source_review',reviewer='/root',source_author='/root/actual_record_checker',scope='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY',verdict='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY',checker_template_sha256=HELPER_SHA,source_manifest_sha256=SOURCE_MANIFEST_SHA,full_source_details_sha256=FULL_PEER_SHA,target_execution=False,actual_binding=None,tests_executed=False,runtime_acceptance=False,operational_authority=False))
