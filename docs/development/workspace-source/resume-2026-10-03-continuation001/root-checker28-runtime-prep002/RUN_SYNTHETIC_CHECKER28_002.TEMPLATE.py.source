 fixed=[(own,a.expected_self_sha256,65536),(PARENT,a.expected_parent_sha256,65536),(TEST,TEST_SHA,52200),(HELPER,HELPER_SHA,146200),(PEER,PEER_SHA,65536),(PROJECTION,PROJECTION_SHA,65536),(GO,a.expected_root_go_sha256,65536),(FULL_PEER,FULL_PEER_SHA,525323),(SOURCE_MANIFEST,SOURCE_MANIFEST_SHA,28249),(SOURCE_POST,SOURCE_POST_SHA,157247),(ROOT_SELECTION,ROOT_SELECTION_SHA,2977),
  (WORK/'OWNER_CONTINUATION_20261003_001.json',MASTER_SHA,65536),(WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json',MASTER_PEER_SHA,65536),*[(x,y,z) for x,y,z in RUNTIME4]]
