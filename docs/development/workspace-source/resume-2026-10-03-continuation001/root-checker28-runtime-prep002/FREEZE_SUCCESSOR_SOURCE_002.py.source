from pathlib import Path

WORK=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001')
PREP=WORK/'root-checker28-runtime-prep002'
OLD=WORK/'root-checker28-runtime-prep001'
AUTHOR='/root/bootstrap_stage'
SCOPE='SYNTHETIC_METADATA3_CHECKER28_STDLIB_REGRESSIONS_ONLY'
RUNNER='RUN_SYNTHETIC_CHECKER28_002.TEMPLATE.py'
PARENT='SUPERVISE_SYNTHETIC_CHECKER28_002.TEMPLATE.ps1'
RUNNER_SHA='f02c64855d86548653c4b5bac587b475a024fda8728113e9a5b39206a8dbd8f9'
PARENT_SHA='749781f580120b1974614b60572ce919559ef51fa17e626679e41ccae91ea7af'
def need(value,message):
 if not value:raise ValueError(message)
def sha(value):return hashlib.sha256(value).hexdigest()
def wire(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(value):return [getattr(value,name) for name in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def ancestors(path):
 rows=[]
 for item in reversed(path.parents):
  value=item.lstat();need(stat.S_ISDIR(value.st_mode) and not value.st_file_attributes&1024,'plain finite ancestor');rows.append([str(item),value.st_dev,value.st_ino])
 return rows
def read(path):
 need(path.is_absolute() and path.is_relative_to(WORK),'finite WORK metadata')
 chain=ancestors(path);first=path.lstat();need(stat.S_ISREG(first.st_mode) and first.st_nlink==1 and not first.st_file_attributes&1024 and 0<=first.st_size<=2097152,'unchanged2MiB finite Source cap')
 with path.open('rb',buffering=0) as stream:
  opened=os.fstat(stream.fileno());left,right=raw(first),raw(opened);need(left[:4]+left[5:]==right[:4]+right[5:] and left[4]==left[8],'ordinary cross8/birth');value=stream.read(first.st_size+1);need(raw(opened)==raw(os.fstat(stream.fileno())),'sameAPI descriptor9')
 need(raw(first)==raw(path.lstat()) and ancestors(path)==chain and len(value)==first.st_size,'Source raw9/ancestor/bytes stable');return value,dict(path=str(path),bytes=len(value),sha256=sha(value),path_raw9=left,descriptor_raw9=right,ancestors=chain)
def put(name,value):
 path=PREP/name;need(not path.exists(),'one-use freeze output')
 with path.open('xb') as stream:need(stream.write(value)==len(value),'complete metadata write')
 need(read(path)[0]==value,'metadata readback')
def ah(node):return sha(ast.dump(node,include_attributes=False).encode('utf8'))
def main():
 need(Path(__file__).absolute()==PREP/'FREEZE_SUCCESSOR_SOURCE_002.py','own finite metadata source')
 need(not (PREP/'SOURCE_MANIFEST_002.json').exists(),'first Source freeze')
 contract=json.loads(read(PREP/'SOURCE_CONTRACT_002.json')[0]);recipe=json.loads(read(PREP/'ROOT_LAUNCH_RECIPE_002.json')[0]);delta=json.loads(read(PREP/'SOURCE_DELTA_AUDIT_002.json')[0])
 runner,runner_meta=read(PREP/RUNNER);parent,parent_meta=read(PREP/PARENT)
 need((sha(runner),len(runner))==(RUNNER_SHA,16549) and (sha(parent),len(parent))==(PARENT_SHA,20451),'fixed successor byte pins')
 need(contract['runner']['sha256']==recipe['runner']['sha256']==RUNNER_SHA and contract['parent']['sha256']==recipe['parent']['sha256']==PARENT_SHA,'Source metadata matches bytes')
 need(contract['source_peer_path']=='root-checker28-runtime-prep002/INDEPENDENT_CHECKER28_RUNNER_SOURCE_REVIEW_002.json' and contract['Root_GO_path']=='root-checker28-runtime-prep002/ROOT_SYNTHETIC_CHECKER28_GO_002.json','fixed successor Sourcepeer/GO paths')
 need(len(contract['source_peer_keys'])==12 and len(contract['Root_GO_keys'])==15 and contract['source_peer_nominals']['record_type']=='independent_checker28_runner_source_review' and contract['source_peer_nominals']['verdict']=='PASS_STATIC_SYNTHETIC_CHECKER28_RUNNER_ONLY' and contract['source_peer_nominals']['source_author']==AUTHOR and contract['source_peer_nominals']['actual_runtime'] is None,'unchanged closed12 Sourcepeer nominals')
 need(contract['eligible_source_reviewers']==['/root','/root/capsule_design_review','/root/owner_docs_review','/root/binder_correction_audit'] and AUTHOR not in contract['eligible_source_reviewers'],'exact genuine different reviewer identities')
 old_runner=read(OLD/'RUN_SYNTHETIC_CHECKER28_001.TEMPLATE.py')[0];old_parent=read(OLD/'SUPERVISE_SYNTHETIC_CHECKER28_001.TEMPLATE.ps1')[0]
 reversed_runner,reversed_parent=runner.decode('utf8'),parent.decode('utf8')
 for change in reversed(delta['changes']):reversed_runner=reversed_runner.replace(change['selected'],change['original']);reversed_parent=reversed_parent.replace(change['selected'],change['original'])
 need(reversed_runner.encode('utf8')==old_runner and reversed_parent.encode('utf8')==old_parent,'full exact literal reversal')
 old_tree,new_tree=ast.parse(old_runner),ast.parse(runner)
 old_defs={n.name:ah(n) for n in old_tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))};new_defs={n.name:ah(n) for n in new_tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
 need(set(old_defs)==set(new_defs) and all(old_defs[k]==new_defs[k] for k in old_defs if k!='main'),'all unchanged Source guard definitions')
 stamp=next(n for n in new_tree.body if isinstance(n,ast.FunctionDef) and n.name=='stamp')
 stamp_regex=next(n.args[0].value for n in ast.walk(stamp) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='fullmatch' and isinstance(n.args[0],ast.Constant))
 old_GO=json.loads(read(OLD/'ROOT_SYNTHETIC_CHECKER28_GO_001.json')[0]);old_terminal=json.loads(read(OLD/'ROOT_PARENT_TERMINAL_001.json')[0])
 need(not re.fullmatch(stamp_regex,old_GO['created_utc']) and not re.fullmatch(stamp_regex,old_GO['expires_utc']) and re.fullmatch(stamp_regex,old_terminal['started_utc']) and re.fullmatch(stamp_regex,old_terminal['finished_utc']),'real preserved Py6 refusal/native7 positive data distinction, no guard call')
 source_control='\n'.join(recipe['native_GO_stamp_control_source_only']['minimal_native_PS_statements'])
 need("$created=[DateTimeOffset]::UtcNow" in source_control and "$expires=$created.AddSeconds($RootSelectedDurationSeconds)" in source_control and "created_utc=$created.ToString('o');expires_utc=$expires.ToString('o')" in source_control and 'Pad' not in source_control,'native actual tick-domain stamp recipe, no padding')
 GO_assignments=re.search(r'\$record=\[ordered\]@\{(.*)\}',source_control).group(1).split(';')
 need([entry.split('=',1)[0] for entry in GO_assignments]==contract['Root_GO_keys'],'minimal native control15 exact ordered field keys')
 projection=read(PREP/'CHECKER28_DISCOVERY_PROJECTION_001.json')[0];events=read(PREP/'CHECKER28_TEST_EVENT_PLAN_001.json')[0]
 need(projection==read(OLD/'CHECKER28_DISCOVERY_PROJECTION_001.json')[0] and events==read(OLD/'CHECKER28_TEST_EVENT_PLAN_001.json')[0],'same complete discovery/event bytes')
 before=json.loads(read(PREP/'BEFORE_PROVENANCE_002.json')[0]);need(before['pair_count']==len(before['pairs'])==596 and before['all_prior001_files']==326,'exact author pair counts')
 old_files=[path for path in OLD.rglob('*') if path.is_file()];need(len(old_files)==326,'old frozen/spent folder inventory unchanged')
 paths={row['original'] for row in before['pairs']};need(all(str(path) in paths for path in old_files),'all prior001 files preserved')
 categories={'prior001_complete_files':0,'inherited_original265_inputs':0,'prior_different_peer_top_files':0};observations=[]
 for row in before['pairs']:
  path=Path(row['original']);left,left_meta=read(path);right,right_meta=read(PREP/row['copy']);need(left==right and left_meta==row['initial'] and right_meta==row['copy_initial'] and left_meta['path_raw9'][:2]!=right_meta['path_raw9'][:2],'whole596 original/copy third observations')
  role='prior001_complete_files' if path.is_relative_to(OLD) else 'prior_different_peer_top_files' if path.parent==WORK/'root-checker28-runtime-independent001' else 'inherited_original265_inputs';categories[role]+=1
  observations.append(dict(original=row['original'],copy=row['copy'],role=role,third=left_meta,copy_third=right_meta))
 need(categories==dict(prior001_complete_files=326,inherited_original265_inputs=265,prior_different_peer_top_files=5),'typed exact596=326+265+5 count explanation')
 future=[contract['source_peer_path'].split('/')[-1],contract['Root_GO_path'].split('/')[-1],'PRO3_CHECKER28_INTERVAL_ACK_002.json',*contract['parent_outputs']]
 need(all(not (PREP/name).exists() for name in future) and not (WORK/'root-checker28-runtime002').exists(),'all future authority/entry/output roles absent')
 checks=dict(schema_version=1,source_author=AUTHOR,scope=SCOPE,status='AUTHOR_SOURCE_METADATA_ONLY_UNRUN',official_pairs=596,pair_categories=categories,all326_prior001_files_unchanged=True,full_source_byte_reversal=True,runner_nonmain_definitions_AST_exact=True,parent9_function_text_exact=delta['parent_all9_function_texts_exact'],discovery_and_event_plan_bytes_exact=True,stamp_regex_unchanged=True,old_Python6_created_expires_refused_by_unchanged_regex=True,preserved_native7_parent_clock_samples_match=True,selected_stamp_definitions_called=False,GO_control15_closed_keys_match=True,PS_parser_only=dict(tool_chunk='c91a24',parent_errors=0,parent_functions=9,control_recipe_errors=0,control_statements=5),future_role_absences=future,private_runtime_absent=True,actual_GO=None,actual_ACK=None,actual_Runtime=None,compiler_or_selected_definition_import_test_Git_FFI_native_parent_entry=False,observations=observations)
 put('SOURCE_FREEZE_CHECKS_002.json',wire(checks))
 local_rows=[];local_initial={}
 for path in sorted((p for p in PREP.rglob('*') if p.is_file()),key=lambda p:p.relative_to(PREP).as_posix()):
  value,meta=read(path);local_initial[path]=meta;local_rows.append(dict(path=path.relative_to(PREP).as_posix(),sha256=sha(value),bytes=len(value)))
 manifest=dict(schema_version=1,record_type='checker28_author_frozen_source_successor002_manifest',source_author=AUTHOR,scope=SCOPE,created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),status='AUTHOR_FROZEN_SOURCE_ONLY_DIFFERENT_COMPLETE_PEER_REQUIRED',prior_source_manifest_sha256='9fb8f37eb94a45ce13d508a49d6ab0923967b0f96ed2bf003da47eda14b36812',prior_actual_prechild_refusal_sha256='6649c3ebd31bdc3408397c72b945eee461f44d5065071efdcdc4b2c5d5f33c86',payload_count=len(local_rows),declared_total_with_manifest=len(local_rows)+1,payload_bytes=sum(row['bytes'] for row in local_rows),official_pairs=596,pair_categories=categories,runner_sha256=RUNNER_SHA,parent_sha256=PARENT_SHA,planned_methods=28,conditional_healthy_subtests=24,conditional_healthy_events=80,actual_Sourcepeer=None,actual_Root_GO=None,actual_Pro3_ACK=None,actual_Runtime=None,target_execution=False,operational_authority=False,payloads=local_rows)
 manifest_bytes=wire(manifest);put('SOURCE_MANIFEST_002.json',manifest_bytes)
 for _ in range(2):
  for path,meta in local_initial.items():need(read(path)[1]==meta,'full local payload postpublication stability')
  for row in observations:need(read(Path(row['original']))[1]==row['third'] and read(PREP/row['copy'])[1]==row['copy_third'],'all originals/copies postpublication stability')
  need(read(PREP/'SOURCE_MANIFEST_002.json')[0]==manifest_bytes,'Source manifest final readback')
 print(json.dumps(dict(status='CHECKER28_SUCCESSOR002_AUTHOR_FROZEN_UNRUN',manifest_sha256=sha(manifest_bytes),manifest_bytes=len(manifest_bytes),payloads=len(local_rows),declared_total=len(local_rows)+1,pair_categories=categories,official_pairs=596,runner_sha256=RUNNER_SHA,parent_sha256=PARENT_SHA,contract_sha256=read(PREP/'SOURCE_CONTRACT_002.json')[1]['sha256'],recipe_sha256=read(PREP/'ROOT_LAUNCH_RECIPE_002.json')[1]['sha256'],handoff_sha256=read(PREP/'HANDOFF.md')[1]['sha256'],target_execution=False,all_future_roles_absent=True)))

if __name__=='__main__':main()
