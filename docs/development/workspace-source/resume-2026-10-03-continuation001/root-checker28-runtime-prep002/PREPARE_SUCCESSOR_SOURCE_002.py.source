OLD_RUNNER='RUN_SYNTHETIC_CHECKER28_001.TEMPLATE.py'
OLD_PARENT='SUPERVISE_SYNTHETIC_CHECKER28_001.TEMPLATE.ps1'
CHANGES=[('root-checker28-runtime-prep001','root-checker28-runtime-prep002'),('root-checker28-runtime001','root-checker28-runtime002'),('RUN_SYNTHETIC_CHECKER28_001','RUN_SYNTHETIC_CHECKER28_002'),('SUPERVISE_SYNTHETIC_CHECKER28_001','SUPERVISE_SYNTHETIC_CHECKER28_002'),('ROOT_SYNTHETIC_CHECKER28_GO_001.json','ROOT_SYNTHETIC_CHECKER28_GO_002.json'),('INDEPENDENT_CHECKER28_RUNNER_SOURCE_REVIEW_001.json','INDEPENDENT_CHECKER28_RUNNER_SOURCE_REVIEW_002.json'),('ROOT_PARENT_STARTED_001.json','ROOT_PARENT_STARTED_002.json'),('ROOT_PARENT_TERMINAL_001.json','ROOT_PARENT_TERMINAL_002.json'),('ROOT_PARENT_STDOUT_001.bin','ROOT_PARENT_STDOUT_002.bin'),('ROOT_PARENT_STDERR_001.bin','ROOT_PARENT_STDERR_002.bin')]

def need(value,message):
 if not value:raise ValueError(message)
def sha(value):return hashlib.sha256(value).hexdigest()
def wire(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def raw(value):return [getattr(value,name) for name in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def ancestors(path):
 rows=[]
 for item in reversed(path.parents):
  value=item.lstat();need(stat.S_ISDIR(value.st_mode) and not value.st_file_attributes&1024,'plain metadata ancestry');rows.append([str(item),value.st_dev,value.st_ino])
 return rows
def read(path):
 need(path.is_absolute() and path.is_relative_to(WORK),'finite WORK Source inputs')
 chain=ancestors(path);first=path.lstat();need(stat.S_ISREG(first.st_mode) and first.st_nlink==1 and not first.st_file_attributes&1024 and 0<=first.st_size<=2097152,'unchanged Source2MiB input cap')
 with path.open('rb',buffering=0) as stream:
  opened=os.fstat(stream.fileno());left,right=raw(first),raw(opened);need(left[:4]+left[5:]==right[:4]+right[5:] and left[4]==left[8],'ordinary Source cross8/birth');value=stream.read(first.st_size+1);need(raw(opened)==raw(os.fstat(stream.fileno())),'Source raw9 descriptor drift')
 need(raw(first)==raw(path.lstat()) and ancestors(path)==chain and len(value)==first.st_size,'Source path/ancestor drift');return value,dict(path=str(path),bytes=len(value),sha256=sha(value),path_raw9=left,descriptor_raw9=right,ancestors=chain)
def put(name,value):
 path=PREP/name;path.parent.mkdir(parents=True,exist_ok=True);need(not path.exists(),'own Source create-once')
 with path.open('xb') as stream:need(stream.write(value)==len(value),'full metadata write')
 need(read(path)[0]==value,'own Source readback')
def ah(node):return sha(ast.dump(node,include_attributes=False).encode('utf8'))
def ps_functions(text):
 lines=text.splitlines(keepends=True);rows={}
 for i,line in enumerate(lines):
  match=re.match(r'^function ([A-Za-z0-9_-]+)',line)
  if match:
   end=i+1 if line.rstrip().endswith('}') else next(j+1 for j in range(i+1,len(lines)) if lines[j].rstrip()=='}');rows[match.group(1)]=''.join(lines[i:end])
 return rows
def rebase(value):
 if type(value) is str:
  for old,new in CHANGES:value=value.replace(old,new)
  return value
 if type(value) is list:return [rebase(x) for x in value]
 if type(value) is dict:return {k:rebase(v) for k,v in value.items()}
 return value

def main():
 need(Path(__file__).absolute()==PREP/'PREPARE_SUCCESSOR_SOURCE_002.py','own metadata source')
 need(not OUT.exists() and not (PREP/'SOURCE_MANIFEST_002.json').exists(),'fresh successor Source/private namespace')
 old_manifest_data,_=read(OLD/'SOURCE_MANIFEST_001.json');need(sha(old_manifest_data)=='9fb8f37eb94a45ce13d508a49d6ab0923967b0f96ed2bf003da47eda14b36812','unchanged old Source freeze');old_manifest=json.loads(old_manifest_data)
 for row in old_manifest['payloads']:
  value,_=read(OLD/row['path']);need((sha(value),len(value))==(row['sha256'],row['bytes']),'all prior316 payloads unchanged')
 failure_data,_=read(OLD/'ROOT_ACTUAL_CHECKER28_PRECHILD_REFUSAL_001.json');need((sha(failure_data),len(failure_data))==('6649c3ebd31bdc3408397c72b945eee461f44d5065071efdcdc4b2c5d5f33c86',12637),'genuine Root failure witness')
 failure=json.loads(failure_data);need(failure['author']=='/root' and failure['helper_execution'] is False and failure['current_runtime_PASS'] is False and failure['actual_root_physical_tool']['exit_code']==1,'Root-attributed failed prechild scope')
 original_paths=[path for path in OLD.rglob('*') if path.is_file()]
 old_count=len(original_paths)
 # Root explicitly requests the complete prior Source/failure folder; no other forest is inventoried.
 original_paths += [Path(row['original']) for row in json.loads(read(OLD/'BEFORE_PROVENANCE_001.json')[0])['pairs']]
 peer_dir=WORK/'root-checker28-runtime-independent001'
 original_paths += [path for path in peer_dir.glob('*') if path.is_file()]
 original_paths=list(dict.fromkeys(original_paths));captures={};pairs=[]
 for ordinal,path in enumerate(original_paths):
  value,first=read(path);name='before/%04d.bytes'%ordinal;put(name,value);copied,copy_meta=read(PREP/name);need(copied==value and first['path_raw9'][:2]!=copy_meta['path_raw9'][:2],'independent original-copy Source bytes')
  captures[path]=value;pairs.append(dict(original=str(path),copy=name,initial=first,copy_initial=copy_meta))
 put('BEFORE_PROVENANCE_002.json',wire(dict(schema_version=1,source_author=AUTHOR,scope=SCOPE,pair_count=len(pairs),all_prior001_files=old_count,old_GO_ACK_parent_spent=True,pairs=pairs)))
 old_runner=captures[OLD/OLD_RUNNER].decode('utf8');old_parent=captures[OLD/OLD_PARENT].decode('utf8')
 need(sha(old_runner.encode('utf8'))=='c9800e96437a341601cd43036fd5ed9d20ff298d58d0be5c3bdb27e93908465d' and sha(old_parent.encode('utf8'))=='e733a2551f6c0b524c173a121733b819fd327d84eebf160f3ef3a83fbd07c5fa','exact prior runner/parent')
 runner,parent=old_runner,old_parent;deltas=[]
 for old,new in CHANGES:
  count=dict(runner=runner.count(old),parent=parent.count(old));need(sum(count.values())>0,'only declared namespace anchors');runner,parent=runner.replace(old,new),parent.replace(old,new);deltas.append(dict(original=old,selected=new,occurrences=count))
 for old,new in reversed(CHANGES):runner_reverse,parent_reverse=(runner if 'runner_reverse' not in locals() else runner_reverse).replace(new,old),(parent if 'parent_reverse' not in locals() else parent_reverse).replace(new,old)
 need(runner_reverse==old_runner and parent_reverse==old_parent,'complete exact namespace-only byte reversal')
 old_defs={node.name:ah(node) for node in ast.parse(old_runner).body if isinstance(node,(ast.FunctionDef,ast.ClassDef))};new_defs={node.name:ah(node) for node in ast.parse(runner).body if isinstance(node,(ast.FunctionDef,ast.ClassDef))}
 need(old_defs.keys()==new_defs.keys() and all(old_defs[k]==new_defs[k] for k in old_defs if k!='main'),'all reader/Results/stamp function ASTs unchanged')
 need(ps_functions(old_parent)==ps_functions(parent) and len(ps_functions(parent))==9,'all nine PS function texts unchanged')
 put(RUNNER,runner.encode('utf8'));put(PARENT,parent.encode('utf8'))
 for name in ('CHECKER28_DISCOVERY_PROJECTION_001.json','CHECKER28_TEST_EVENT_PLAN_001.json'):put(name,captures[OLD/name])
 projection=json.loads(captures[OLD/'CHECKER28_DISCOVERY_PROJECTION_001.json']);events=json.loads(captures[OLD/'CHECKER28_TEST_EVENT_PLAN_001.json'])
 need(len(projection['ordered_ids'])==28 and events['conditional_healthy_events']==80 and events['conditional_healthy_subtests']==24,'same unchanged discovery/event plan')
 contract=rebase(json.loads(captures[OLD/'SOURCE_CONTRACT_001.json']))
 contract.update(status='AUTHOR_SOURCE_SUCCESSOR002_UNRUN_DIFFERENT_COMPLETE_REVIEW_REQUIRED',runner=dict(path=RUNNER,sha256=sha(runner.encode('utf8')),bytes=len(runner.encode('utf8'))),parent=dict(path=PARENT,sha256=sha(parent.encode('utf8')),bytes=len(parent.encode('utf8'))),time_policy='PS7 means the genuine seven-fractional-digit native DateTimeOffset UTC roundtrip domain, not a PowerShell version. ROOT creates BOTH created_utc and expires_utc using native DateTimeOffset.ToString(\'o\'); never pad, normalize or retimestamp Python six-digit strings. Existing duration<=600 and parent remaining60 checks are unchanged; Python inherited stamp comparison floors the seventh digit to microseconds and remains qualified.',fresh_namespace='Every successor002 peer/GO/ACK/parent/private output remains absent. All prior001 Source, actual Root prechild refusal, GO/ACK/terminal/empty captures and old25 history remain exact SPENT history; no replay.',old_prechild_refusal=dict(path=str(OLD/'ROOT_ACTUAL_CHECKER28_PRECHILD_REFUSAL_001.json'),sha256=sha(failure_data),bytes=len(failure_data)),actual_Runtime=None)
 put('SOURCE_CONTRACT_002.json',wire(contract))
 recipe=rebase(json.loads(captures[OLD/'ROOT_LAUNCH_RECIPE_001.json']))
 recipe['parent'].update(path=str(PREP/PARENT),sha256=sha(parent.encode('utf8')),bytes=len(parent.encode('utf8')));recipe['runner'].update(path=str(PREP/RUNNER),sha256=sha(runner.encode('utf8')),bytes=len(runner.encode('utf8')))
 recipe['required_source_peer']['source_manifest_path']=str(PREP/'SOURCE_MANIFEST_002.json')
 recipe['native_GO_stamp_control_source_only']={
  'author_of_this_recipe':AUTHOR,'actual_Root_writer_execution':None,'timestamp_domain':'native7fraction+00:00, not PS version; no Py padding','trusted_external_source_pin_values':'ROOT independently selects reviewed actual source/owner/helper/projection hashes before genuine GO creation; no pins inferred from GO itself','expires_generation':'Derive a future DateTimeOffset from native created.AddSeconds(ROOT_selected_seconds); formatting both objects directly preserves ticks.',
  'minimal_native_PS_statements':["$created=[DateTimeOffset]::UtcNow","$expires=$created.AddSeconds($RootSelectedDurationSeconds)","$record=[ordered]@{schema_version=1;record_type='root_synthetic_checker28_GO';author='/root';scope='SYNTHETIC_METADATA3_CHECKER28_STDLIB_REGRESSIONS_ONLY';created_utc=$created.ToString('o');expires_utc=$expires.ToString('o');owner_master_sha256=$RootTrustedOwnerSha;owner_review_sha256=$RootTrustedOwnerPeerSha;parent_source_sha256=$RootTrustedParentSha;runner_source_sha256=$RootTrustedRunnerSha;test_source_sha256=$RootTrustedTestSha;helper_source_sha256=$RootTrustedHelperSha;helper_source_peer_sha256=$RootTrustedHelperPeerSha;discovery_projection_sha256=$RootTrustedProjectionSha;decision='execute_fixed_synthetic_checker28_once'}","$bytes=[Text.UTF8Encoding]::new($false).GetBytes(($record|ConvertTo-Json -Compress -Depth 5)+\"`n\")","$file=[IO.File]::Open($RootReviewedFixedGOPath,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None);try{$file.Write($bytes,0,$bytes.Length);$file.Flush($true)}finally{$file.Dispose()}"],
  'prerequisites':'Before running the control-only writer, ROOT validates the genuine fresh Pro3 ACK, Sourcepeer12, Source manifest and source hashes; duration positive<=600 with>=60 left for parent; closed GO15 and canonical strings then different actual acceptance. This recipe does not issue GO or supply Root author attestation.',
  'GO_closed_keys':contract['Root_GO_keys'],'actual_GO':None}
 put('ROOT_LAUNCH_RECIPE_002.json',wire(recipe))
 put('SOURCE_DELTA_AUDIT_002.json',wire(dict(schema_version=1,source_author=AUTHOR,scope=SCOPE,changes=deltas,all_source_bytes_reverse_to001=True,all_runner_definitions_after_literal_reversal_AST_exact=True,all_runner_nonmain_definitions_AST_exact=True,parent_all9_function_texts_exact=True,discovery_projection_bytes_exact=True,event_plan_bytes_exact=True,guards_caps_floors_timers_source_pin_bus_keysets_unchanged=True,stamp_guard_unchanged=True,source_main_behavior_delta='only fresh fixed filenames/namespace, no acceptance predicate change',actual_target_execution=False)))
 text='''# Checker28 namespace002 Source successor\n\nAuthor /root/bootstrap_stage. Source-only, UNRUN; a different complete Source review and fresh genuine ROOT physical GO/Pro3 ACK are required. No actual GO/ACK/nonce/parent/private output is created here.\n\nPrior001 parent physically refused before resource sampling/start record/child Start with Genuine PS7. Genuine Root witness6649c3eb and owning ee39ea exit1/1.0891236s are preserved. The supplied GO had Python six-digit created/expires strings; the existing guard requires native DateTimeOffset seven-digit roundtrip+00:00. PS7 denotes that timestamp domain, not PowerShell version. Terminal false child-cleanup fields describe nonentry and do not prove cleanup of a launched child. GO001/ACK001/parent001 are spent forever.\n\nThe new runner/parent differ only through the declared fixed namespace/filename substitutions in SOURCE_DELTA_AUDIT_002.json. Reversal recovers complete001 source bytes; all reader/Results/stamp ASTs and all nine PS function texts are unchanged. Checker010/test004/141 Source packet/owner/runtime4/hash pins and closed Sourcepeer12/GO15 remain unchanged. Discovery projection and event plan bytes are exact:28 methods, old25 bodies preserved, conditional24 subtests/80 healthy events. No U010fixture7/project metadata/current24/science/native acceptance follows.\n\nROOT must generate both actual GO stamps directly from native DateTimeOffset objects using ToString('o'); expiry is a genuine future DateTimeOffset derived from its native created object and a reviewed ROOT duration. Do not pad/normalize Python stamps, reuse the old GO/ACK or alter the guard. ROOT_LAUNCH_RECIPE_002.json carries the full15-key minimal native control-only generation expression and genuine external Source/coordination prerequisites; that Source expression is not executed by this author and is not a Root-produced GO.\n\nPhysical52 child/57 cleanup inside separately observed ROOT60,64KiB stdout/stderr,1GiB RAM/10GiB D floors/resource60 throughspawn remain exact. Roughly40MiB Source/runtime acquisition implies conditional timer fit; no cap or deadline grows. There is no OS Job, descendant/loaded-site/host-quiet proof, unconditional IO deadline or operational authority. All previous frozen/refused/spent source and evidence remain exact independent copies.\n\nSOURCE_MANIFEST_002.json gives the complete finite package inventory. BEFORE_PROVENANCE_002.json and SOURCE_PRESERVATION_POST_002.json provide the finite prior inputs/copies and three+post raw9/hash observations. No selected source compiler/import/definitions/loader/tests/Git/FFI/native/parent/runner or actual GO writer was invoked. Separate genuine Root correlation is required for owning physical evidence.\n'''
 put('HANDOFF.md',text.encode('utf8'))
 post=[]
 for row in pairs:
  left,meta=read(Path(row['original']));right,copy_meta=read(PREP/row['copy']);need(left==right==captures[Path(row['original'])] and meta==row['initial'] and copy_meta==row['copy_initial'],'all prior input-copy second observations');post.append(dict(original=row['original'],copy=row['copy'],second=meta,copy_second=copy_meta))
 put('SOURCE_PRESERVATION_POST_002.json',wire(dict(schema_version=1,source_author=AUTHOR,pairs=post,source_bytes_unchanged=True,old_history_spent=True,actual28tests=None)))
 print(json.dumps(dict(status='CHECKER28_SUCCESSOR002_COMPOSED_SOURCE_ONLY',old001files=old_count,official_pairs=len(pairs),runner_sha256=sha(runner.encode('utf8')),runner_bytes=len(runner.encode('utf8')),parent_sha256=sha(parent.encode('utf8')),parent_bytes=len(parent.encode('utf8')),selected_target_execution=False)))

if __name__=='__main__':main()
