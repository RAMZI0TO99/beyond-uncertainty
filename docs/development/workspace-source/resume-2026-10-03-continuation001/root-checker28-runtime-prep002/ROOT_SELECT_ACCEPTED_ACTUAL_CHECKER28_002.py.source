"""Root select different full actual checker28 audit; no test or helper replay."""
import datetime
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
PEER = HERE.parent / "root-checker28-actual-independent002"
OUTPUT = HERE / "ROOT_ACTUAL_CHECKER28_ACCEPTANCE_SELECTION_002.json"
FILES = [
    (PEER / "INDEPENDENT_ACTUAL_CHECKER28_REVIEW_002.json", "0ab74ef0c01f50b9b4ee2629cda76c609d94b35ed16cfcbf167a5a59c5c637ad", 3109),
    (PEER / "INDEPENDENT_ACTUAL_CHECKER28_DETAILS_002.json", "198c2180ccae6dcc32d41ff0dafb589fff52272588cbf598630a829cb39e6d72", 655256),
    (PEER / "POST_ACTUAL_CHECKER28_REVIEW_002.json", "3197dfee7f980a703df0ced0b63453bbdd35dbc929910b8a9187969de1dabce5", 110700),
    (PEER / "HANDOFF.md", "21bbda83ece872ba3af7cbf1102808c3f92cf5e45294ce9f9e4239f2be9e1590", 1268),
    (HERE / "ROOT_ACTUAL_CHECKER28_PHYSICAL_WITNESS_002.json", "35571fbe0d9d1931b813c40cab7cfef2a37063100ffdf118515c0883fa40c82d", 7630),
    (HERE / "ROOT_PARENT_TERMINAL_002.json", "28218a78c1a63c4e8c9818ed4f34a654b91e373753bf0c55e6f475d3b36f1fcc", 1005),
]

def raw9(s):
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns, s.st_mode,
            s.st_nlink, s.st_file_attributes, s.st_birthtime_ns]

def read(path, pin, size):
    before = raw9(path.stat())
    data = path.read_bytes()
    assert before == raw9(path.stat()) and before[2] == len(data) == size
    assert hashlib.sha256(data).hexdigest() == pin
    return data, dict(path=str(path), sha256=pin, bytes=size, raw9=before)

def main():
    assert not OUTPUT.exists()
    captured = [read(*spec) for spec in FILES]
    review = json.loads(captured[0][0])
    terminal = json.loads(captured[-1][0])
    assert review["reviewer"] == "/root/owner_docs_review" and review["producer"] == "/root"
    assert review["verdict"] == "PASS_ACTUAL_SYNTHETIC_CHECKER28_ONLY"
    assert (review["methods"], review["subtests"], review["events"], review["successful_parent_terminals"]) == (28, 24, 80, 28)
    assert all(review[k] == 0 for k in ("failures", "errors", "skips", "diagnostic_bytes"))
    assert review["finite_inputs"] == 188 and review["source_copies"] == 188 and review["source_proof_rows"] == 156
    assert review["conservative_physical_upper_seconds"] == 38 and review["physical_limit_seconds"] == 60
    assert review["consumed_no_replay"] is True
    assert all(review[k] is False for k in ("actual_project_metadata_or_current24", "models_or_bound_pool", "operational_authority", "hard_OS_Job_or_descendant_or_global_quiet"))
    assert terminal["exit_code"] == 0 and terminal["failure"] is None
    assert terminal["direct_child_reaped"] is True and terminal["capture_drain_complete"] is True
    for (data, row), spec in zip(captured, FILES):
        again, after = read(*spec)
        assert again == data and after == row
    report = dict(schema_version=1, record_type="root_actual_checker28_acceptance_selection", author="/root",
                  created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  verdict="ACCEPT_DIFFERENT_ACTUAL_SYNTHETIC_CHECKER28_ONLY",
                  selected_fixed_evidence=[row for data, row in captured],
                  different_full188_triple_copy_post_audit_selected_not_repeated=True,
                  methods=28, subtests=24, events=80, failures=0, errors=0, skips=0,
                  Root_conservative_physical_upper_seconds=38, physical_limit_seconds=60,
                  parent_direct_child_reap_and_stream_drain_only=True,
                  GO002_ACK003_parent002_runner002_spent_no_replay=True,
                  actual_project_metadata_current24_models_bound_pool_native_scientific_or_operational_acceptance=False,
                  independent_OS_Job_descendant_or_whole_host_quiet_claim=False)
    body = (json.dumps(report, indent=2, sort_keys=True) + "\n").encode()
    with OUTPUT.open("xb") as handle:
        assert handle.write(body) == len(body)
    assert OUTPUT.read_bytes() == body
    print(json.dumps(dict(path=str(OUTPUT), sha256=hashlib.sha256(body).hexdigest(), bytes=len(body))))

if __name__ == "__main__":
    main()
