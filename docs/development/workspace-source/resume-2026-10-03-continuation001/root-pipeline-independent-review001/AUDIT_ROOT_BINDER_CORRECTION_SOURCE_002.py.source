def sha(b): return hashlib.sha256(b).hexdigest()
def utc(): return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def enc(x): return (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
 d={}
 for k,v in rows: assert k not in d; d[k]=v
 return d
def bad(x): raise ValueError(x)
def parse(b):
 assert not b.startswith(b'\xef\xbb\xbf')
 return json.loads(b.decode('utf-8','strict'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def raw(s): return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def read(p):
 a=p.lstat(); assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not a.st_file_attributes&1024
 with p.open('rb',buffering=0) as f:
  d=os.fstat(f.fileno()); b=f.read(a.st_size+1); z=os.fstat(f.fileno())
 assert raw(d)==raw(z) and raw(a)==raw(p.lstat()) and len(b)==a.st_size
 assert [raw(a)[i] for i in (0,1,2,3,5,6,7,8)]==[raw(d)[i] for i in (0,1,2,3,5,6,7,8)]
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),path_raw9=raw(a),descriptor_raw9=raw(d),observed_utc=utc())
def once(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f: assert f.write(b)==len(b); f.flush(); os.fsync(f.fileno())
def literal(t,name):
 nodes=[n.value for n in t.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==name]
 assert len(nodes)==1,name
 return ast.literal_eval(nodes[0])
def funcs(t): return {n.name:ast.dump(n,include_attributes=False) for n in t.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
def own_literal_edit(b,values):
 # Independent byte-span model; never calls the author's bind/projection code.
 t=ast.parse(b); lines=b.splitlines(keepends=True); edits=[]
 for name,value in values.items():
  nodes=[n.value for n in t.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==name]
  assert len(nodes)==1 and isinstance(nodes[0],ast.Constant),name
  n=nodes[0]; start=sum(map(len,lines[:n.lineno-1]))+n.col_offset; end=sum(map(len,lines[:n.end_lineno-1]))+n.end_col_offset
  edits.append((start,end,repr(value).encode('ascii')))
 for start,end,value in sorted(edits,reverse=True): b=b[:start]+value+b[end:]
 return b
