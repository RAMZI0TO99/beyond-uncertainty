"""Owned finite source observer. Does not import or execute reviewed definitions."""
import ast, hashlib, json, os, stat
from pathlib import Path
from datetime import datetime, timezone
W=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001')
R=W/'root-guard006-pipeline-prep001'
O=W/'root-pipeline-independent-review001'/'binder-correction-audit003'
def sha(b): return hashlib.sha256(b).hexdigest()
def raw(s): return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def obs(p):
 s=p.lstat(); assert stat.S_ISREG(s.st_mode) and s.st_nlink==1 and not s.st_file_attributes&1024 and s.st_size<=2097152
 with p.open('rb',buffering=0) as f:
  a=os.fstat(f.fileno()); b=f.read(s.st_size+1); z=os.fstat(f.fileno())
 assert raw(a)==raw(z) and raw(s)==raw(p.lstat()) and len(b)==s.st_size
 assert [raw(s)[i] for i in (0,1,2,3,5,6,7,8)]==[raw(a)[i] for i in (0,1,2,3,5,6,7,8)]
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),path_raw9=raw(s),descriptor_raw9=raw(a))
def funcs(b): return {n.name:ast.dump(n,include_attributes=False) for n in ast.parse(b).body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef))}
manifest,mm=obs(R/'SOURCE_BINDER_MANIFEST_002.json'); m=json.loads(manifest)
paths={str(R/'SOURCE_BINDER_MANIFEST_002.json'):None}
for row in m['payloads']: paths[str(R/row['path'])]=row
for row in m['immutable_inputs'].values(): paths[row['path']]=row
for leaf,pin in m['original001_bytes_preserved'].items(): paths[str(R/leaf)]={'sha256':pin}
paths[str(W/'guard006-bound-late-checker-prep001'/'review_guard006_actual_records_001-corrected006.TEMPLATE.py')]={'sha256':'1ab45b85e38447c40a99abdc5849eed5547700fbc9f84aefc842055b7a5b0ea1'}
O.mkdir(exist_ok=False)
records=[]; data={}
for i,(name,pin) in enumerate(paths.items()):
 p=Path(name); b,a=obs(p); c,second=obs(p); assert b==c and a==second
 if pin: assert sha(b)==pin['sha256'] and ('bytes' not in pin or len(b)==pin['bytes'])
 cp=O/(str(i).zfill(3)+'-'+p.name+'.bytes'); cp.write_bytes(b); cb,cm=obs(cp); assert cb==b and cm['path_raw9'][:2]!=a['path_raw9'][:2]
 records.append(dict(first=a,second=second,copy=cm)); data[name]=b
old=data[str(R/'BIND_ROOT_PIPELINE_SOURCE_001.TEMPLATE.py')]; new=data[str(R/'BIND_ROOT_PIPELINE_SOURCE_002.TEMPLATE.py')]
fo,fn=funcs(old),funcs(new); changed=[k for k in fo if fo[k]!=fn[k]]; assert changed==['main'] and len(fo)==27
tree=ast.parse(new); literals={n.targets[0].id:ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('PINNED_INPUTS','SOURCE_ROWS','CONFIG_KEYS','PEER_KEYS')}
assert literals['PINNED_INPUTS']==m['immutable_inputs'] and len(literals['CONFIG_KEYS'])==20 and len(literals['PEER_KEYS'])==12
contract=json.loads(data[str(R/'SOURCE_BINDING_CONTRACT_002.json')]); assert contract['driver_bound_assignments']==['OWNER_SHA256','SOURCE_CAPSULE_PEER_SHA256','HARNESS_STATIC_PEER_SHA256'] and contract['observer_bound_assignments']==['HARNESS_STATIC_PEER_SHA256']
outputs=[W/'consumer005-guard006-runtime-prep001'/x for x in ('run-consumer-guard-unit006-rev003.bound.py','observe-whole-runtime-006-rev003.BOUND.py')]
outputs += [R/literals['SOURCE_ROWS'][role] for role in ('root_records','whole_before_parent','whole_after_writer','whole_after_parent','pipeline')]
outputs += [R/'ROOT_PIPELINE_BINDING_001.json',R/'ROOT_PIPELINE_SOURCE_BINDING_PROVENANCE_001.json']
absence=[dict(path=str(p),absent=not p.exists(),staging_absent=not Path(str(p)+'.staging').exists()) for p in outputs]; assert all(x['absent'] and x['staging_absent'] for x in absence)
for rec in records:
 b,post=obs(Path(rec['first']['path'])); assert post==rec['first']; rec['post']=post
report=dict(schema_version=1,record_type='independent_binder002_complete_source_audit_and_architecture_supplement',reviewer='/root/binder_correction_audit',source_author='/root/root_pipeline_binder',created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),verdict='REFUSED_PROPOSED_ROOT_PEER_ADMISSION_SOURCE_TRANSFORMATION_QUALIFIED_ACCEPTED',source_manifest_sha256=sha(manifest),binder_sha256=sha(new),finite_inputs=records,input_count=len(records),observations_per_input=3,copy_count=len(records),changed_function_ASTs=changed,unchanged_other_functions=26,output_absences=absence,target_definitions_executed=False,tests_executed=False,actual_binding=None,operational_authority=False,
 findings=[dict(id='ROLE001',severity='blocks_proposed_root_selection',fact='Binder002 main fixes preliminary peer12 reviewer to /root/owner_docs_review. A genuine /root compact peer is refused; assigning the unavailable reviewer name would impersonate its authorship.'),dict(id='ROLE002',severity='blocks_proposed_root_selection',fact='Root main9b7dbc line296 fixes actual pipeline peer16 reviewer to /root/owner_docs_review. M3 bound9 and generic006 likewise retain that reviewer. No authority to silently rewrite accepted reader bytes is inferred.')],
 architecture_supplement=dict(original_binder001_acceptance_preserved=True,original_binder001_actual_binding_inapplicable=True,original_root_main_and_four_stage_source_acceptance_preserved=True,corrected_driver_binding_count=3,corrected_observer_binding_count=1,driver_OWNER_END_derived_at_runtime=True,observer_OWNER_SHA256_and_OWNER_END_derived_at_runtime=True,config20_acyclic_sources_before_INIT=True,provenance17_after_config=True,source_models_and_trust_after_INIT=True,source_binding_only_no_runtime_proof=True),
 manual_full_source_checks=['All binder functions inspected including strict JSON/depth/ticks, ordinary-file paired read, six-literal M3 reversal, four CR-preserving PS reversals, closed Source11/phase7/bound9, lease43200/preparation1200, coordination canonical paths, full immutable final reread, nine output absence/staging guards, atomic no-replace publication/readback, configuration20 and provenance17.','Corrected driver three literal names match driver_projection and generic006 reverse_literals; observer one literal matches template_projection and generic protocol. Function/class ASTs unchanged under literal transformation.','Only main differs from binder001; all26 other function ASTs exact. Immutable29 selected Source pins and Root main/four stage templates remain byte-exact. No target functions were called.','Publication may leave consumed partial outputs on failure. No rollback/replay claim; actual Source/config still absent at this finite audit.','Binder authenticates M3 phase binding7 and bound9; genuine independent phase20 remains a separate downstream pre-capture prerequisite, not a binder-produced PASS.'])
