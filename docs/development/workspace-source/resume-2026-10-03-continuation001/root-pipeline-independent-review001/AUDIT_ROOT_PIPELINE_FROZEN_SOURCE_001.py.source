]
report=dict(schema_version=1,record_type='independent_root_pipeline_complete_source_architecture_review',reviewer='/root/owner_docs_review',source_author='/root',component_source_authors=['/root','/root/renewal_runtime_inventory','/root/root_pipeline_binder'],created_utc=utc(),scope=SCOPE,verdict='PASS_COMPLETE_ROOT_PIPELINE_SOURCE_PREPARATION_ONLY',pipeline_template_sha256=MAIN_SHA,binder_template_sha256=sha(data[bp]),source_manifest_sha256=MANIFEST_SHA,finite_input_count=len(data),observations=observations,preserved_inputs=preserved,prepublication_observations=pre,source_checks=checks,findings=[],implementation_conditions=conditions,syntax_and_inert_metadata=dict(ps_syntax_sha256=sha(data[sp]),binder_function_count=27,inert_code_flags=inert.co_flags,target_execution=False),actual_binding=None,actual_configuration=None,actual_results=None,runtime_acceptance=False,operational_authority=False)
assert len(enc(report))<=2097152
rp=OUT/'INDEPENDENT_ROOT_PIPELINE_ARCHITECTURE_REVIEW_001.json';once(rp,enc(report))
peer=dict(schema_version=1,record_type='root_pipeline_binder_source_review',reviewer='/root/owner_docs_review',source_author='/root/root_pipeline_binder',scope=SCOPE,verdict='PASS_STATIC_ROOT_PIPELINE_BINDER_SOURCE_ONLY',created_utc=utc(),binder_template_sha256=sha(data[bp]),pipeline_template_sha256=MAIN_SHA,source_manifest_sha256=MANIFEST_SHA,target_execution=False,actual_binding=None)
assert len(peer)==12 and set(peer)==set(literal(tree,'PEER_KEYS'))
pp=OUT/'INDEPENDENT_ROOT_PIPELINE_BINDER_SOURCE_REVIEW_001.json';once(pp,enc(peer))
selection=OUT/'INDEPENDENT_ROOT_PIPELINE_SOURCE_SELECTION_001.json';once(selection,enc(dict(schema_version=1,created_utc=utc(),architecture_review_sha256=sha(rp.read_bytes()),binder_source_review_sha256=sha(pp.read_bytes()),source_manifest_sha256=MANIFEST_SHA,actual_binding=None,target_execution=False)))
md=OUT/'INDEPENDENT_ROOT_PIPELINE_ARCHITECTURE_REVIEW_001.md';once(md,b'Final Root pipeline and binder source preparation accepted. Complete finite selected source pool, current stage readers, timestamp/budget guards and acyclic source-binding order reviewed. No actual binding, lease, configuration, capture, INIT/trust/GO, P16, unit or runtime result is accepted.\n')
post=[]
for p in sorted(data,key=str):b,r=read(p);assert b==data[p];post.append(r)
postpath=OUT/'INDEPENDENT_ROOT_PIPELINE_SOURCE_POST_001.json';once(postpath,enc(dict(schema_version=1,created_utc=utc(),architecture_review_sha256=sha(rp.read_bytes()),binder_source_review_sha256=sha(pp.read_bytes()),source_post_observations=post)))
print(json.dumps(dict(verdict=report['verdict'],finite_input_count=len(data),outputs=[dict(path=str(p),sha256=sha(p.read_bytes()),bytes=len(p.read_bytes())) for p in (rp,pp,selection,md,postpath)])))
