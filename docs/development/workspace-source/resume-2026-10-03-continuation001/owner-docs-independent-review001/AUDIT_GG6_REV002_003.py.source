"""Own finite source metadata only; never execute reviewed code."""
import ast, datetime, hashlib, json, os
from pathlib import Path
BASE=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001')
GG=BASE/'consumer005-guard006-runtime-prep001';OUT=BASE/'gg6-source-independent-review001'
def sha(b):return hashlib.sha256(b).hexdigest()
def utc():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def enc(x):return (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def parse(b):return json.loads(b.decode('utf-8','strict'),object_pairs_hook=pairs,parse_constant=lambda x:(_ for _ in ()).throw(ValueError(x)))
def raw(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None)]
def read(p):
 a=p.lstat();b=p.read_bytes();z=p.lstat();assert raw(a)==raw(z)
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),raw9=raw(z),observed_utc=utc())
def once(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
def literal(t,n):
 v=[x.value for x in t.body if isinstance(x,ast.Assign) and len(x.targets)==1 and isinstance(x.targets[0],ast.Name) and x.targets[0].id==n];assert len(v)==1,n
 return ast.literal_eval(v[0])
def fn(t):return {x.name:ast.dump(x,include_attributes=False) for x in t.body if isinstance(x,ast.FunctionDef)}
oldreview=OUT/'INDEPENDENT_GG6_SOURCE_REVIEW_001.json'
assert sha(oldreview.read_bytes())=='b3da7f253694379d5fceab2f671fc03a3e595cdc89180b338c58baceefe442e3'
old=parse(oldreview.read_bytes());manifest_path=GG/'FINAL_AUTHOR_SOURCE_MANIFEST_007.json'
pin='81955b3810fb7a212856bc4b549be244de1ed0a28b09f48d4364e043e73aeff3'
assert sha(manifest_path.read_bytes())==pin;manifest=parse(manifest_path.read_bytes())
pins={Path(r['path']):r['sha256'] for r in old['preserved_inputs']}
pins[oldreview]=sha(oldreview.read_bytes());pins[manifest_path]=pin
for r in manifest['selected_files']+manifest['preserved_first_payloads']:pins[GG/r['path']]=r['sha256']
data=None;observations=[]
for phase in range(1,4):
 current={};rows=[]
 for p in sorted(pins,key=str):
  b,r=read(p);assert sha(b)==pins[p],str(p);current[p]=b;rows.append(r)
 if data is None:data=current
 else:assert current==data
 observations.append(dict(phase=phase,rows=rows))
for r in manifest['selected_files']+manifest['preserved_first_payloads']:assert len(data[GG/r['path']])==r['bytes']
assert len(manifest['selected_files'])==15 and len(manifest['preserved_first_payloads'])==34
profile=parse(data[GG/'GUARD_RUNTIME_PROFILE_006-rev002.json']);contract=parse(data[GG/'EXTERNAL_CANONICAL_TIMESTAMP_ROLE_CONTRACT_006.json'])
owner=parse(data[BASE/'OWNER_CONTINUATION_20261003_001.json']);peer=parse(data[BASE/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json'])
names=['consumer-guard-child-006-rev002.TEMPLATE.py','run-consumer-guard-unit006-rev002.TEMPLATE.py','observe-whole-runtime-006-rev002.TEMPLATE.py']
oldnames=['consumer-guard-child-006.TEMPLATE.py','run-consumer-guard-unit006.TEMPLATE.py','observe-whole-runtime-006.TEMPLATE.py']
syntax=[];deltas=[];trees=[]
for name,oldname in zip(names,oldnames):
 p=GG/name;t=ast.parse(data[p],filename=str(p));code=compile(data[p],str(p),'exec',dont_inherit=True,optimize=0);trees.append(t)
 syntax.append(dict(path=str(p),sha256=sha(data[p]),inert_code_flags=code.co_flags,functions=list(fn(t)),execution=False))
 assert literal(t,'TIMESTAMP_ROLE_CONTRACT')==contract
 assert literal(t,'OWNER_MASTER_EXPECTED')==owner and len(owner)==27
 assert set(literal(t,'OWNER_REVIEW_KEYS'))==set(peer) and len(peer)==19
 assert literal(t,'MAX_RECEIPT')==262144 and literal(t,'MAX_CAPTURE')==131072
 a=fn(ast.parse(data[GG/oldname]));b=fn(t)
 added=sorted(set(b)-set(a));changed=sorted(n for n in a if a[n]!=b.get(n));removed=sorted(set(a)-set(b))
 assert removed==[]
 allowed={'consumer-guard-child-006-rev002.TEMPLATE.py':['capsule_snapshot','child_main'],'run-consumer-guard-unit006-rev002.TEMPLATE.py':['capsule_snapshot','driver_main'],'observe-whole-runtime-006-rev002.TEMPLATE.py':['capsule_snapshot','observer_main']}[name]
 assert changed==sorted(allowed),(name,changed)
 assert added==(['reconcile_events'] if name.startswith('run-') else [])
 deltas.append(dict(path=name,changed_functions=changed,added_functions=added,unchanged_function_count=len(a)-len(changed)))
 for n in ['typed_equal','exact_ticks','lease_entry','source_snapshot','capsule_snapshot']:assert n in b
 for n in ['typed_equal','exact_ticks','lease_entry','source_snapshot']:assert a[n]==b[n]
 for call in ast.walk(t):
  if isinstance(call,ast.Call) and isinstance(call.func,ast.Attribute) and call.func.attr=='isoformat':assert any(k.arg=='timespec' and isinstance(k.value,ast.Constant) and k.value.value=='microseconds' for k in call.keywords),(name,call.lineno)
assert literal(trees[1],'PROFILE_SHA256')==sha(data[GG/'GUARD_RUNTIME_PROFILE_006-rev002.json'])
for k in ['child','whole_observer','root_supervisor','external_canonical_timestamp_role_contract']:
 r=profile[k];assert sha(data[GG/r['path']])==r['sha256'] and len(data[GG/r['path']])==r['bytes']
assert profile['driver_evidence_rows']==26
assert all(profile[k] is None for k in ['execution_lease','root_ack','bound_driver','current_context_before','fresh_runtime4_metadata_snapshot','fresh_whole_runtime_before','actual_late_launch_review','harness_static_review'])
test=ast.parse(data[GG/'test_raw_consumer_guards_005.TEMPLATE.py']);classes=[n for n in test.body if isinstance(n,ast.ClassDef)]
methods={n.name:sorted(x.name for x in n.body if isinstance(x,ast.FunctionDef) and x.name.startswith('test_')) for n in classes}
assert [len(methods[n.name]) for n in classes]==[19,5] and methods==profile['prepared_class_method_names']
ids=['isolated_consumer_guard_unit006.'+n.name+'.'+m for n in classes for m in methods[n.name]];assert ids==profile['prepared_full_ids'] and len(set(ids))==24
projection=parse(data[GG/'CURRENT24_BODY_AND_FULL_ID_PROJECTION_006.json'])
for c in classes:
 for n in c.body:
  if isinstance(n,ast.FunctionDef) and n.name.startswith('test_'):assert sha(ast.dump(n,include_attributes=False).encode())==projection['body_AST_sha256'][c.name][n.name]
