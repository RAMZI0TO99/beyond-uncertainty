for idx,p in enumerate(sorted(data,key=str)):
 d=before/f'{idx:02d}.bytes';once(d,data[p]);assert d.read_bytes()==data[p];preserved.append(dict(path=str(p),copy=str(d),sha256=sha(data[p]),bytes=len(data[p])))
