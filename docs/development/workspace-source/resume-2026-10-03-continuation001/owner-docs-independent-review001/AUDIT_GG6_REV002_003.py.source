assert profile['fixed_runtime_leaves']['driver'] in driver and profile['fixed_runtime_leaves']['driver'] in ps
assert profile['fixed_runtime_leaves']['root_launcher'] in ps
assert 'bound-review.created_utc' in contract['external_python6_roles'] and 'bound-review.expires_utc' in contract['external_python6_roles']
assert 'created_utc' not in literal(trees[1],'BOUND_KEYS') and 'expires_utc' not in literal(trees[1],'BOUND_KEYS')
findings=[dict(id='GG006-REV002-01',severity='blocking_source_precision',finding='The closed timestamp-role contract lists bound-review.created_utc and bound-review.expires_utc, but the authentic BOUND22 schema has neither field. This is corroborated by the author and exact BOUND_KEYS source.',required='Select a distinct truthful contract and versioned dependent profile/leaves preserving rev002 bytes. Do not add timestamps to BOUND22 or infer external actual producer acceptance.')]
checks=['Full initial finite source closure re-read from genuine first source review, including12 current source/test/capsule pairs and5 old leaf originals; all34 first payload bytes preserved.','All15 selected rev002 payload pins and full active Python AST/inert compile verified; exact named-function deltas record unchanged guard routes.','Ongoing owner27, distinct peer19 and finite lease12 remain authentic; strict PS7 seventh digit chronology and max43200 guards are unchanged, owner end remains None.','Current24 copied test methods/full IDs reconstructed19+5 and AST hashes unchanged.','Pinned strict typed timestamp contract before capsule I/O; actual external producer/authentication decisions remain absent.','Driver independently reconstructs exact ordered24 starts/single success terminals and active subtest parents, closed methods, complete contiguous diagnostic bytes and evidence26.','RootPS versioned driver/profile/root source mappings and ACK/BOUND/LATE fixed namespace inspected; source launch remains unbound.','Full inherited caps and original context/runtime90 throughspawn, resource60,context600,driver420,Root450,after60 preserved; no actual result or operational acceptance.']
