result=dict(schema_version=1,record_type='independent_gg6_complete_finite_source_review',source_author='/root/capsule_design_review',reviewer='/root/owner_docs_review',created_utc=utc(),verdict='REFUSED_SOURCE_PREPARATION_REQUIRES_DISTINCT_CORRECTION',scope=profile['scope'],source_manifest_sha256=pin,manifest_payload_count=15,finite_input_count=len(data),observations=observations,preserved_inputs=preserved,prepublication_observations=pre,syntax_and_inert_metadata=syntax,source_function_deltas=deltas,source_checks=checks,findings=findings,implementation_conditions=['Source only: no reviewed definitions/imports/main/tests/Git/FFI/PS target/binding/lease entry executed.','No physical loaded-source, hard OS sandbox, Job, descendant, memory or atomic lock proof.','Canonical actual role provenance and full different actual before/BOUND/LATE/after acceptance still required.','No compact static PASS emitted from this refusal.'],actual_results=None,runtime_acceptance=False,operational_authority=False)
