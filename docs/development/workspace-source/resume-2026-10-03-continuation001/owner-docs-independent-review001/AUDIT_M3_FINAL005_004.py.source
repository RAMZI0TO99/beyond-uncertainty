assert manifest['payload_count']==len(manifest['payloads'])==12 and manifest['active_source_count']==6
assert all(manifest[k] is None for k in ['actual_authorization','actual_bindings','actual_capture','actual_lease'])
names=manifest['selected_source_paths'];assert len(names)==6 and len(set(names))==6
