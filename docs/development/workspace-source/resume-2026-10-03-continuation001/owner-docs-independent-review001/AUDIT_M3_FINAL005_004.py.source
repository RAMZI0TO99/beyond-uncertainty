 p=M3/name;t=ast.parse(data[p],filename=str(p));code=compile(data[p],str(p),'exec',dont_inherit=True,optimize=0);trees.append(t)
 syntax.append(dict(path=str(p),sha256=sha(data[p]),inert_code_flags=code.co_flags,functions=list(fn(t)),execution=False))
