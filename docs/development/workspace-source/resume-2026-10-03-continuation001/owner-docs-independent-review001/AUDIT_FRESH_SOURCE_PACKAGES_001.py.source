assert literal(mt,'OWNER_MASTER_EXPECTED')==owner and set(literal(mt,'OWNER_REVIEW_KEYS'))==set(peer)
assert len(literal(mt,'LEASE_KEYS'))==12 and literal(mt,'MAX_SECONDS')==300 and literal(mt,'JSON_CAP')==2097152
old=parse(m3data[M3/'SELECTED_HISTORICAL_INPUTS_001.json'])['source_inputs'][0]['path'];of=functions(ast.parse(m3data[Path(old)]));nf=functions(mt)
