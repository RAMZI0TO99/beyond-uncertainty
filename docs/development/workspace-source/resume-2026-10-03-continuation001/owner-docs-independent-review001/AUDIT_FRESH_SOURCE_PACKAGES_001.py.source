assert m3manifest['payload_count']==21 and len(m3manifest['payloads'])==21
m3find=[dict(id='M3003-01',severity='blocking_source_role',path='capture-root-metadata003.TEMPLATE.py:455',finding='Capture pins fixed SOURCE_STAGED_MANIFEST_003.json and ACTUAL_SOURCE_CAPSULE_003.json, whereas its GG6 current source package provides fixed005 filenames.',required='Distinct capture/binder source selection with authentic fixed005 roles, exact reverse/pin updates and original003 preservation.'),dict(id='M3003-02',severity='blocking_source_call',path='SUPERVISE_ROOT_METADATA_BEFORE_003.TEMPLATE.ps1:130; SUPERVISE_ROOT_METADATA_AFTER_003.TEMPLATE.ps1:130',finding='Both supervisors call undefined Pin to read authBytes; their only pinned-byte function is Read-Pinned. This source route would refuse before process launch.',required='Distinct preserved-source supervisor correction to the real Read-Pinned function; parse/full call closure review before binding.'),dict(id='M3003-A01',severity='producer_precision_advisory',finding='Capture fresh timestamps use isoformat() default precision, so zero-microsecond stamps lack the mandatory six fraction digits.',required='Explicit microseconds producer precision in distinct source, without relaxing or retimestamping old records.')]
commonlimits=['AST and inert CodeType only; no reviewed definitions/imports/main, tests, Git, FFI, binding, PowerShell target or native action executed.','Exact finite selected dependency pool; no ancestor forest, unknown-file absence or full current742/263 acceptance.','Physical producer and actual source/lease/phase decisions remain externally reviewed; source fields do not prove OS witness/Job/lock/descendant or loaded-site closure.','No compact PASS source record is emitted from a refusal; original sources remain UNRUN and unchanged.']
def publish(tag,package,manifest,data,observations,syntax_rows,findings,checks):
 out=BASE/(tag+'-source-independent-review001');before=out/'selected-before001';assert not before.exists();before.mkdir(parents=True)
 preserved=[]
 for idx,p in enumerate(sorted(data,key=str)):
  dest=before/f'{idx:02d}.bytes';once(dest,data[p]);assert dest.read_bytes()==data[p]
  preserved.append(dict(path=str(p),copy=str(dest),sha256=sha(data[p]),bytes=len(data[p])))
 post=[]
 for p in sorted(data,key=str):b,row=read(p);assert b==data[p];post.append(row)
 manifest_name='FINAL_AUTHOR_SOURCE_MANIFEST_006.json' if tag=='gg6' else 'STAGED_MANIFEST_003.json'
 result=dict(schema_version=1,record_type='independent_'+tag+'_complete_finite_source_review',reviewer='/root/owner_docs_review',created_utc=utc(),verdict='REFUSED_SOURCE_PREPARATION_REQUIRES_DISTINCT_CORRECTION',source_manifest_sha256=sha(data[package/manifest_name]),manifest_payload_count=len(manifest['files'] if tag=='gg6' else manifest['payloads']),finite_input_count=len(data),observations=observations,preserved_inputs=preserved,prepublication_observations=post,syntax_and_inert_metadata=syntax_rows,source_checks=checks,findings=findings,implementation_conditions=commonlimits,actual_results=None,runtime_acceptance=False,operational_authority=False)
 review=out/('INDEPENDENT_'+tag.upper()+'_SOURCE_REVIEW_001.json');md=out/('INDEPENDENT_'+tag.upper()+'_SOURCE_REVIEW_001.md');postpath=out/('INDEPENDENT_'+tag.upper()+'_SOURCE_POST_001.json')
 once(review,enc(result));once(md,('# Independent '+tag.upper()+' source review\n\nREFUSED_SOURCE_PREPARATION_REQUIRES_DISTINCT_CORRECTION.\n\n'+'\n\n'.join(f['id']+': '+f['finding']+' '+f['required'] for f in findings)+'\n\nFinite selected input hashes, exact copies, three source reads and postread are recorded in JSON. All source remains UNRUN. This is not a runtime failure, source production defect claim or execution/binding approval.\n').encode('utf-8'))
 rows=[]
 for p in sorted(data,key=str):b,row=read(p);assert b==data[p];rows.append(row)
 once(postpath,enc(dict(schema_version=1,created_utc=utc(),review_sha256=sha(review.read_bytes()),source_post_observations=rows)))
 print(json.dumps(dict(tag=tag,verdict=result['verdict'],finite_inputs=len(data),outputs=[dict(path=str(p),sha256=sha(p.read_bytes()),bytes=p.stat().st_size) for p in [review,md,postpath]])))
publish('gg6',GG,ggmanifest,ggdata,ggobs,ggsyntax,ggfind,['All34 payload pins and12 genuine current source/capsule/test projection pairs','Current test file byte identity and24 method AST hashes/full IDs reconstructed19+5','Strong ongoing master27/owner peer19 separated from exact finite lease12 with seventh-tick interval chronology','Closed capsule/schema/derivation roles and external capsule peer pins','Event1024LF/count4096/chunk131072/combined32+4MiB/source receipt and physical capture caps','Direct I-S-B frozen child, audit-denied process/FFI/network and scratch writes, cold/reuse fixtures preserved','Both context/runtime90/resource60 before spawn, context600, source/runtime repeated before/after','RootPS3 BOUND-to-launcher-to-LATE roles inspected; no OS/descendant hard guarantee'])
