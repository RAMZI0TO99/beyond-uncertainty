m3selected=[M3/'capture-root-metadata003.TEMPLATE.py',M3/'BIND_SOURCE_AND_PHASES_003.TEMPLATE.py']
ggsyntax=syntax(ggdata,ggselected);m3syntax=syntax(m3data,m3selected)
profile=parse(ggdata[GG/'GUARD_RUNTIME_PROFILE_006.json']);owner=parse(ggdata[shared[0][0]]);peer=parse(ggdata[shared[1][0]])
trees=[ast.parse(ggdata[p]) for p in ggselected[:3]]
for t in trees:
 assert literal(t,'OWNER_MASTER_EXPECTED')==owner and len(owner)==27
