assert m3pin.startswith('ab814266')
m3manifest,m3data,m3obs=collect(M3,'STAGED_MANIFEST_003.json',m3pin,'payloads',m3extras)
def syntax(data,selected):
 answer=[]
 for p in selected:
  t=ast.parse(data[p],filename=str(p));code=compile(data[p],str(p),'exec',dont_inherit=True,optimize=0)
  answer.append(dict(path=str(p),sha256=sha(data[p]),functions=[n.name for n in t.body if isinstance(n,ast.FunctionDef)],classes=[n.name for n in t.body if isinstance(n,ast.ClassDef)],inert_code_flags=code.co_flags,execution=False))
 return answer
