m3extras=shared+[(GG/'GUARD_RUNTIME_PROFILE_006.json','f42eba7aad5778d9f39d0db342cec86d54db5d3f6a639e349aae2c0d564285a9')]
for row in parse((M3/'SELECTED_HISTORICAL_INPUTS_001.json').read_bytes())['source_inputs']:m3extras.append((Path(row['path']),row['sha256']))
