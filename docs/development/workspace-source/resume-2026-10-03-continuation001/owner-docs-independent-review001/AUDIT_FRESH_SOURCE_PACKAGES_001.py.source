"""Own finite AST/metadata audit, no reviewed definitions/main or tests executed."""
import ast, datetime, hashlib, json, os
from pathlib import Path
ROOT=Path('D:/Aenv/pro2');BASE=ROOT/'resume-2026-10-03-continuation001';OLD=ROOT/'resume-2026-10-01-30h-001'
GG=BASE/'consumer005-guard006-runtime-prep001';M3=BASE/'metadata3-producer-core-prep001'
def sha(b):return hashlib.sha256(b).hexdigest()
def utc():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def enc(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def parse(b):return json.loads(b.decode('utf-8','strict'),object_pairs_hook=pairs,parse_constant=lambda s:(_ for _ in ()).throw(ValueError(s)))
def raw(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,getattr(s,'st_file_attributes',0),getattr(s,'st_birthtime_ns',None)]
def read(p):
 a=p.lstat();b=p.read_bytes();z=p.lstat();assert raw(a)==raw(z)
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),raw9=raw(z),observed_utc=utc())
def once(p,b):
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
def literal(tree,name):
 rows=[n.value for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==name]
 assert len(rows)==1,name
 return ast.literal_eval(rows[0])
def functions(tree):return {n.name:ast.dump(n,include_attributes=False) for n in tree.body if isinstance(n,ast.FunctionDef)}
def collect(package,manifest_name,manifest_pin,payload_key,extra):
 manifest_path=package/manifest_name;b=manifest_path.read_bytes();assert sha(b)==manifest_pin
 manifest=parse(b);paths={manifest_path};pins={manifest_path:manifest_pin}
 for row in manifest[payload_key]:
  p=package/row['path'];paths.add(p);pins[p]=row['sha256']
 for p,pin in extra:paths.add(p);pins[p]=pin
 data=None;observations=[]
 for phase in range(3):
  current={};rows=[]
  for p in sorted(paths,key=str):
   b,row=read(p);assert sha(b)==pins[p],str(p);current[p]=b;rows.append(row)
  if data is None:data=current
  else:assert data==current
  observations.append(dict(phase=phase+1,rows=rows))
 for row in manifest[payload_key]:assert len(data[package/row['path']])==row['bytes']
 return manifest,data,observations
