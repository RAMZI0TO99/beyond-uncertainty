 fn=functions(t)
 for name in ['typed_equal','exact_ticks','lease_entry','source_snapshot','capsule_snapshot']:assert name in fn
assert len(ggmanifest['files'])==34
for row in parse(ggdata[GG/'AUTHOR_LEAF_STABILITY_AND_LIMITATIONS_006.json'])['pairs']:
 assert ggdata[Path(row['original'])]==ggdata[Path(row['copy'])]
test=ast.parse(ggdata[GG/'test_raw_consumer_guards_005.TEMPLATE.py']);classes=[n for n in test.body if isinstance(n,ast.ClassDef)]
assert [n.name for n in classes]==['RawConsumerGuardRegressions','RawConsumerMetaclassIdentityRegressions']
methods={n.name:sorted(m.name for m in n.body if isinstance(m,ast.FunctionDef) and m.name.startswith('test_')) for n in classes}
assert [len(methods[n.name]) for n in classes]==[19,5] and methods==profile['prepared_class_method_names']
ids=['isolated_consumer_guard_unit006.'+n.name+'.'+m for n in classes for m in methods[n.name]]
assert ids==profile['prepared_full_ids'] and len(set(ids))==24
projection=parse(ggdata[GG/'CURRENT24_BODY_AND_FULL_ID_PROJECTION_006.json'])
for c in classes:
 for n in c.body:
  if isinstance(n,ast.FunctionDef) and n.name.startswith('test_'):assert sha(ast.dump(n,include_attributes=False).encode())==projection['body_AST_sha256'][c.name][n.name]
driver=ggdata[ggselected[1]].decode();child=ggdata[ggselected[0]].decode();observer=ggdata[ggselected[2]].decode()
assert literal(trees[1],'PROFILE_SHA256')==sha(ggdata[GG/'GUARD_RUNTIME_PROFILE_006.json'])
for p,row in [('child',profile['child']),('observer',profile['whole_observer']),('RootPS',profile['root_supervisor'])]:assert sha(ggdata[GG/row['path']])==row['sha256']
assert all(profile[k] is None for k in ['execution_lease','root_ack','bound_driver','current_context_before','fresh_runtime4_metadata_snapshot','fresh_whole_runtime_before','actual_late_launch_review'])
for body in [child,driver]:
 for route in ['class EvidenceStream','def validate_event','def stream_read','MAX_EVENT_ROW = 1024','MAX_STREAM_CHUNKS = 32','MAX_STREAM_CHUNK = 131072','MAX_STREAM_BYTES = 4194304']:assert route in body
assert 'type(lease["maximum_lease_seconds"]) is int' in child and '43200*10000000' in child
assert '"both original90 throughspawn"' in driver and '"resource60 throughspawn"' in driver
assert '["offset"]+item["bytes"]<=MAX_STREAM_BYTES' in child
missing_contract=GG/profile['external_canonical_timestamp_role_contract']['path'];assert not missing_contract.exists()
ggfind=[dict(id='GG006-01',severity='blocking_source_contract',path='GUARD_RUNTIME_PROFILE_006.json',finding='The external canonical timestamp role points at absent EXTERNAL_CANONICAL_TIMESTAMP_ROLE_CONTRACT_005.json while child, observer and RootPS comments require a006 contract. No selected contract payload exists in the34-file freeze.',required='Distinct versioned sources/profile and a preserved, reviewed genuine006 timestamp-role contract; preserve first freeze.'),dict(id='GG006-02',severity='blocking_source_precision',path='GUARD_RUNTIME_PROFILE_006.json',finding='Preparation limitations still attribute Source003 peer/all14 and Source00314-only scope even though this harness executes current00524.',required='Distinct profile wording qualified to current005/capsule peer and all24; keep old wording historical.'),dict(id='GG006-C01',severity='required_actual_acceptance_condition',path='run-consumer-guard-unit006.TEMPLATE.py:750',finding='Driver reconciles exact24 method rows and subtest count/status, but does not independently reconstruct each start/success event and subtest parent ownership.',required='The different actual result checker must reconstruct ordered start/terminal method IDs and valid subtest parents, or the distinct driver must add that reconstruction before acceptance.'),dict(id='GG006-A01',severity='producer_precision_advisory',finding='Fresh Python-produced timestamps use isoformat() default precision; exact zero microseconds produces a no-fraction form.',required='Prefer explicit timespec=microseconds in new producer source; retain strict actual role review and never normalize an expired/spent record.')]
