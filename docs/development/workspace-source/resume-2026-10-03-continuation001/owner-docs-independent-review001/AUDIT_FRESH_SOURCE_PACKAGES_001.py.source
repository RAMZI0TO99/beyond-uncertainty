for row in parse((GG/'AUTHOR_LEAF_STABILITY_AND_LIMITATIONS_006.json').read_bytes())['pairs']:ggextras.append((Path(row['original']),row['sha256']))
oldleaf=['consumer-guard-child-005.TEMPLATE.py','run-consumer-guard-unit005.TEMPLATE.py','observe-whole-runtime-005.TEMPLATE.py','ROOT_FIRST_LAUNCH_005.TEMPLATE.ps1','GUARD_RUNTIME_PROFILE_005.json']
for idx,name in enumerate(oldleaf):
 p=OLD/'consumer-guard-test-runtime005'/name
