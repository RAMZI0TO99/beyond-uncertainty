    ids=sorted(projection['module_name']+'.'+c+'.'+n for c,n in mt);need(ids==projection['ordered_ids'] and len(set(ids))==28 and sha(('\n'.join(ids)+'\n').encode())==projection['ordered_ids_sha256'],'independent ordered28 IDs')
