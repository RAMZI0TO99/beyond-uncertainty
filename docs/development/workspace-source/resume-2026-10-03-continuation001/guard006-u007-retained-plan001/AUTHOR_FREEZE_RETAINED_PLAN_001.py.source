"""Owned metadata only: finite source reads/copies, AST parser inspection, plan freeze.
Never imports or executes the reviewed utility, constructor, checker or pipeline.
"""
import ast
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path

PROJECT = Path('D:/Aenv/pro2')
WORK = PROJECT / 'resume-2026-10-03-continuation001'
OWN = WORK / 'guard006-u007-retained-plan001'
U = WORK / 'guard006-bound-late-checker-prep001'
C = WORK / 'root-guard006-model-prep001'
SCOPE = 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'

def wire(value):
    return (json.dumps(value,sort_keys=True,ensure_ascii=True,separators=(',',':'))+'\n').encode('ascii')

def digest(data):
    return hashlib.sha256(data).hexdigest()

def raw(info):
    return [getattr(info,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]

def observe(p, cap=262144):
    before=p.lstat()
    assert stat.S_ISREG(before.st_mode) and before.st_nlink==1 and not before.st_file_attributes & 0x400
    assert 0<=before.st_size<=cap
    with p.open('rb') as stream:
        handle=raw(os.fstat(stream.fileno()))
        data=stream.read(cap+1)
        assert raw(os.fstat(stream.fileno()))==handle
    assert raw(p.lstat())==raw(before) and len(data)==before.st_size and len(data)<=cap
    return data,dict(path=str(p),bytes=len(data),sha256=digest(data),path_raw9=raw(before),descriptor_raw9=handle)

def once(p,data):
    with p.open('xb') as stream:
        stream.write(data);stream.flush();os.fsync(stream.fileno())
    assert observe(p,max(len(data),1))[0]==data

inputs = [
    U/'review_guard006_actual_records_001-corrected007.TEMPLATE.py',
    U/'compose-root-review-packet-006.TEMPLATE.py',
    U/'ACYCLIC_BOUND_MODEL_PEER_PROTOCOL_006.json',
    WORK/'root-guard006-pipeline-prep001/RUN_ROOT_METADATA_PIPELINE_006.TEMPLATE.ps1',
    C/'MODEL_CONSTRUCTOR_SOURCE_CONTRACT_002.json',
    C/'INDEPENDENT_MODEL_CONSTRUCTOR_SOURCE_REVIEW_001.json',
    WORK/'root-model-constructor-independent-review001/source002/INDEPENDENT_MODEL_CONSTRUCTOR_SOURCE_REVIEW_002.json',
    WORK/'metadata3-actual-checker-prep001/ROOT_ACTUAL_CHECKER_BINDING_DRAFT_010.json',
    WORK/'guard006-utility-source-independent-review001/source-audit004/INDEPENDENT_GENERIC_PUB_SOURCE_REVIEW_003.json',
    WORK/'EXECUTION_LEASE_GG6_M3_001.json',
]
observations=[];payload=[];data_by_path={}
(OWN/'inputs').mkdir(exist_ok=False)
for index,p in enumerate(inputs):
    rows=[]
    for _ in range(3):
        data,row=observe(p);rows.append(row)
    assert all(row==rows[0] for row in rows)
    data_by_path[str(p)]=data
    copy=OWN/'inputs'/('%02d-'%index+p.name)
    once(copy,data)
    _,copyrow=observe(copy)
    observations.append(dict(original_path=str(p),copy_path=str(copy),observations=rows,copy_observation=copyrow))
    payload.append(copy)

tree=ast.parse(data_by_path[str(inputs[0])])
waiter=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='retained_waiter')
options=[n.args[0].value for n in ast.walk(waiter) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='add_argument']
assert options==['--expected-self-sha256','--retained-deadline-utc']
utility_pin='8f620adad426d38315392b94e5a9e46a66f1a1eb63613aa5fb79a9715abbc8fd'
assert digest(data_by_path[str(inputs[0])])==utility_pin
lease=json.loads(data_by_path[str(WORK/'EXECUTION_LEASE_GG6_M3_001.json')])
lease_pin=digest(data_by_path[str(WORK/'EXECUTION_LEASE_GG6_M3_001.json')])
assert lease_pin=='43cb0552e3117842868eb78ff4e6b52913a16e78f3c26b8caa754cfb6b29fc48'
ready_keys=['schema_version','record_type','reviewer','pid','created_utc','utility_sha256','lease_sha256','root_trust_selection_sha256','target_execution']
plan=dict(schema_version=1,record_type='guard006_retained_u007_source_launch_plan',author='/root/pubnative_review',scope=SCOPE,
    created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
    argv_template=[str(PROJECT/'runtimes/week8-python313-frozen-001/python.exe'),'-I','-S','-B','-X','utf8',str(U/'review_guard006_actual_records_001.BOUND.py'),'--expected-self-sha256','<ROOT_SELECTED_ACTUAL_BOUND_UTILITY_SHA256>','--retained-deadline-utc','<ROOT_SELECTED_PS7_ABSOLUTE_POLL_DEADLINE>'],
    actual_cli_sha256=None,retained_deadline_utc=None,execution_nonce=None,nonce_argument_supported=False,
    literal_models=['SOURCE_BINDINGS','SOURCE_PROTOCOL'],
    constructor_provenance=[str(C/n) for n in ('UTILITY_SOURCE_BINDINGS_001.json','UTILITY_SOURCE_PROTOCOL_001.json','COMPOSER_FRESH_SOURCE_MODEL_001.json','ACTUAL_SOURCE_POOL_PROJECTION_001.json')],
    actual_bound_source_paths=[str(U/n) for n in ('review_guard006_actual_records_001.BOUND.py','compose-root-review-packet-006.BOUND.py')],
    external_Root_pool_gate=dict(path=str(WORK/'guard006-utility-source-independent-review001/INDEPENDENT_GUARD006_BOUND_SOURCE_POOL_REVIEW_001.json'),sha256=None,utility_directly_reads_peer20=False),
    external_actual_checker_config=dict(path=str(WORK/'metadata3-actual-checker-prep001/ACTUAL_CHECKER_BINDING_001.json'),sha256=None,draft_is_actual=False),
    external_Root_trust=dict(path=str(WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_TRUST_SELECTION_001.json'),sha256=None),
    finite_lease=dict(path=str(WORK/'EXECUTION_LEASE_GG6_M3_001.json'),sha256=lease_pin,end_utc=lease['lease_end_utc'],is_owner_deadline=False),
    ready9=dict(path=str(U/'BOUND_LATE_CHECKER_READY_006.json'),keys=ready_keys,maximum_bytes=65536,actual_record=None),
    poll=dict(order=['bound','late'],sleep_seconds='0.05',maximum_remaining_seconds=3600,deadline_at_or_before_lease_end=True,synchronous_read_deadline_proved=False),
    timing=dict(original_context_seconds=600,both_context_runtime_age_at_GO_maximum_seconds=90,resource_age_through_spawn_maximum_seconds=60,reserve_seconds=510,Root_unit_seconds=450,after_seconds=60,retained_deadline_refreshes_clocks=False),
    readcaps=dict(bound_self=131072,checker_source=262144,marker=65536,ready=65536,whole_table=4194304,detail=2097152,detail_observations=4096,absolute_source_ceiling=8388608),
    supervision=dict(implementation_selected=None,total_lifetime_cutoff=None,cleanup_cutoff=None,physical_stdout_cap_bytes=65536,physical_stderr_cap_bytes=65536,direct_owned_process_only=True,drain_and_reap_observations_required=True,tool_token_cap_is_physical_stream_cap=False,accepted_new_supervisor=False,hard_Job_descendant_provider_deadline_proof=False),
    preconditions=['Root external full P16/Binder17/C20 prerequisite before physical INIT','genuine actual INIT/trust externally selected by Root','genuine actual config18 and constructor outputs with complete actual fit','independent Root pool20 admission of full source closure/reversal','applicable accepted physical supervision selected','Root explicit actual retained-entry release','both genuine READY records authenticated before capture'],
    SourceActualInputs=None,actual_models=None,actual_pool_peer=None,actual_tool=None,actual_pid=None,actual_ready=None,actual_decisions=None,helper_execution=False,target_execution=False,runtime_acceptance=False,operational_authority=False,
    source_inspection=dict(utility_template_sha256=utility_pin,retained_parser_options=options,AST_inspected_only=True,no_definitions_or_mains_executed=True))
plan_path=OWN/'RETAINED_U007_LAUNCH_PLAN_001.json';once(plan_path,wire(plan));payload.append(plan_path)
payload.extend([OWN/'RETAINED_U007_LAUNCH_CHECKLIST_001.md',Path(__file__)])
for item in observations:
    _,post=observe(Path(item['original_path']))
    assert post==item['observations'][0]
    item['post_observation']=post
observation_path=OWN/'FINITE_SOURCE_OBSERVATIONS_001.json';once(observation_path,wire(dict(schema_version=1,record_type='retained_plan_finite_source_observations',author='/root/pubnative_review',inputs=observations,whole_ancestor_closure_claimed=False,target_execution=False)));payload.append(observation_path)
manifest=dict(schema_version=1,record_type='author_frozen_retained_u007_source_plan',author='/root/pubnative_review',scope=SCOPE,
    created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
    payloads=[dict(path=str(p),sha256=observe(p)[1]['sha256'],bytes=observe(p)[1]['bytes'])for p in payload],
    finite_source_inputs=len(inputs),SourceActualInputs=None,actual_admission=False,actual_launch=False,actual_ready=None,target_execution=False,operational_authority=False,
    limitation='Finite exact selected Source observations only; dynamic bindings/trust/pool/cleanup selections remain unready. No helper definition/import/main/test executed.')
manifest_path=OWN/'AUTHOR_FROZEN_RETAINED_PLAN_MANIFEST_001.json';once(manifest_path,wire(manifest))
for p in (plan_path,manifest_path):
    row=observe(p)[1];print(json.dumps(dict(path=str(p),sha256=row['sha256'],bytes=row['bytes']),sort_keys=True))
