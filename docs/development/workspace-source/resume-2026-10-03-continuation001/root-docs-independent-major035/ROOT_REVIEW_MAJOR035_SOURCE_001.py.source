def need(v, message):
    if not v:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def enc(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True,
                       allow_nan=False) + '\n').encode('ascii')

def now():
    return datetime.now(timezone.utc).isoformat(timespec='microseconds')

def exact(value, keys):
    need(type(value) is dict and set(value) == set(keys), 'closed keyset differs')

def decode(data, physical_name=None):
    def pairs(rows):
        result = {}
        for key, value in rows:
            need(key not in result, 'duplicate JSON key')
            result[key] = value
        return result
    def bad(value):
        raise ValueError('Source float/nonfinite JSON refused')
    need(not data.startswith(b'\xef\xbb\xbf'), 'JSON BOM refused')
    need(physical_name is None or physical_name in PHYSICAL_DECIMALS,
         'only an externally pinned native physical record admits Decimal')
    value = json.loads(data.decode('utf8', 'strict'), object_pairs_hook=pairs,
                       parse_float=Decimal if physical_name else bad,
                       parse_constant=bad)
    if physical_name:
        actual = {}
        def walk(item, path):
            if type(item) is Decimal:
                need(item.is_finite(), 'nonfinite physical measurement')
                actual[path] = str(item)
            elif type(item) is dict:
                for key, child in item.items():
                    walk(child, path + '/' + key)
            elif type(item) is list:
                for index, child in enumerate(item):
                    walk(child, path + '/' + str(index))
        walk(value, '')
        need(actual == PHYSICAL_DECIMALS[physical_name],
             'native record Decimal field/value domain differs')
    return value

def raw(s):
    return [getattr(s, key) for key in (
        'st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns',
        'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def ancestors(p):
    result = []
    for q in reversed(p.parents):
        s = q.lstat()
        need(stat.S_ISDIR(s.st_mode) and not stat.S_ISLNK(s.st_mode)
             and not s.st_file_attributes & 1024, 'plain ancestor required')
        result.append([str(q), s.st_dev, s.st_ino])
    return result

def read(p, pin=None, size=None):
    need(p.is_absolute(), 'absolute pinned path required')
    ancestry = ancestors(p)
    a = p.lstat()
    need(stat.S_ISREG(a.st_mode) and not stat.S_ISLNK(a.st_mode)
         and a.st_nlink == 1 and not a.st_file_attributes & 1024
         and 0 <= a.st_size <= MAX_FILE, 'plain one-link bounded file')
    with p.open('rb', buffering=0) as handle:
        b = os.fstat(handle.fileno())
        x, y = raw(a), raw(b)
        need(x[:4] + x[5:] == y[:4] + y[5:] and x[4] == x[8],
             'cross-API8 identity excluding ctime; path ctime/birth')
        data = handle.read(a.st_size + 1)
        need(raw(b) == raw(os.fstat(handle.fileno())), 'same-handle raw9 drift')
    need(raw(a) == raw(p.lstat()) and ancestors(p) == ancestry,
         'same-path raw9/ancestor drift')
    need(len(data) == a.st_size, 'bounded exact read')
    need(pin is None or (type(pin) is str and
         re.fullmatch('[0-9a-f]{64}', pin) and sha(data) == pin),
         'external SHA differs')
    need(size is None or (type(size) is int and size == len(data)),
         'external byte count differs')
    return data, dict(path=str(p), sha256=sha(data), bytes=len(data),
                     path_raw9=x, descriptor_raw9=y, ancestors=ancestry)

def local(relative):
    need(type(relative) is str and 0 < len(relative) <= 399
         and '\\' not in relative and not relative.startswith('/')
         and all(part not in ('', '.', '..') and ':' not in part
                 for part in relative.split('/')), 'canonical local path')
    return ROOT.joinpath(*relative.split('/'))

def once(relative, data):
    need(type(data) is bytes and len(data) <= MAX_FILE, 'owned output cap')
    path = OUT.joinpath(*relative.split('/'))
    path.parent.mkdir(parents=True, exist_ok=True)
    ancestry = ancestors(path)
    need(not path.exists() and not path.is_symlink(), 'owned role already exists')
    with path.open('xb') as handle:
        need(handle.write(data) == len(data), 'complete exclusive owned write')
        handle.flush()
        os.fsync(handle.fileno())
    need(ancestors(path) == ancestry and read(path, sha(data), len(data))[0] == data,
         'owned write/readback drift')

def ticks(text):
    need(type(text) is str and re.fullmatch(
        r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{6,7}\+00:00', text),
         'canonical Py6/PS7 UTC tick string')
    base, fraction = text[:-6].split('.')
    dt = datetime.fromisoformat(base + '+00:00')
    need(dt.strftime('%Y-%m-%dT%H:%M:%S') == base, 'canonical UTC date')
    epoch = datetime(1970, 1, 1, tzinfo=timezone.utc)
    delta = dt - epoch
    return (delta.days * 86400 + delta.seconds) * 10000000 + int(fraction.ljust(7, '0'))

def main():
    need(Path(__file__).absolute() == OUT / 'ROOT_REVIEW_MAJOR035_SOURCE_001.py',
         'fixed genuine Root auditor path')
    options = argparse.ArgumentParser(allow_abbrev=False)
    options.add_argument('--expected-self-sha256', required=True)
    args = options.parse_args()
    registry = {}
    def add(path, pin=None, size=None):
        data, _ = read(path, pin, size)
        entry = (sha(data), len(data))
        need(path not in registry or registry[path] == entry, 'conflicting finite pin')
        registry[path] = entry
        need(len(registry) <= MAX_INPUTS, 'finite Source registry cap')
        return data
    def addrow(row):
        exact(row, ('path', 'sha256', 'bytes'))
        need(type(row['bytes']) is int and 0 <= row['bytes'] <= MAX_FILE, 'typed bounded size')
        return add(local(row['path']), row['sha256'], row['bytes'])
    def selected(name):
        key = WORK.relative_to(ROOT).as_posix() + '/' + name
        need(key in final, 'fact absent from selected035 finite inputs')
        pin, size = final[key]
        return decode(add(local(key), pin, size),
                      name if name in PHYSICAL_DECIMALS else None)
    def absent(path):
        ancestry = ancestors(path)
        try:
            path.lstat()
        except FileNotFoundError:
            need(ancestors(path) == ancestry, 'absence ancestor drift')
            return str(path)
        raise ValueError('named one-use Source role exists: ' + str(path))

    add(Path(__file__), args.expected_self_sha256)
    manifest = decode(add(STAGE / 'STAGED_DOCUMENTATION_MANIFEST_035_001.json',
                          MANIFEST_SHA, 53520))
    exact(manifest, ('schema_version', 'record_type', 'author', 'prepared_utc',
        'checkpoint', 'primaries', 'inputs', 'links', 'source_only',
        'publication_performed', 'target_execution', 'operational_authority'))
    need(type(manifest['schema_version']) is int and manifest['schema_version'] == 1
         and manifest['record_type'] == 'major035_documentation_stage'
         and manifest['author'] == '/root/actual_record_checker'
         and manifest['source_only'] is True, 'Major035 genuine author/stage nominals')
    need(all(manifest[k] is False for k in ('publication_performed',
         'target_execution', 'operational_authority')), 'Source-only manifest')
    need(type(manifest['inputs']) is list and len(manifest['inputs']) == 54
         and type(manifest['links']) is list and len(manifest['links']) == 59,
         'actual035 fixed54 pairs/59 links')
    prepared = ticks(manifest['prepared_utc'])
    need(manifest['prepared_utc'] == '2026-10-03T16:11:12.832234+00:00',
         'exact immutable035 snapshot date')
    publisher = add(STAGE / 'PUBLISH_MAJOR035_DOCS_001.py', PUBLISHER_SHA, 9951)
    context = decode(add(STAGE / 'SELECTED_SOURCE_CONTEXT_035_001.json', CONTEXT_SHA, 875))
    contract = decode(add(STAGE / 'DOCUMENTATION_SOURCE_CONTRACT_035_001.json', CONTRACT_SHA, 2287))
    author = decode(add(STAGE / 'AUTHOR_MAJOR035_STAGE_AUDIT_001.json', AUTHOR_SHA, 288229))
    exact(context, ('schema_version','record_type','source_author','prepared_utc','scope',
        'prior034_creation_sha256','current_P16_source_only_sha256',
        'checker28_prechild_refusal_sha256','Root_selected_TYPE003_Source_selection_sha256',
        'utility_regression_full_Source_sha256','publication_performed',
        'target_execution','operational_authority'))
    for obj in (context, contract, author):
        need(obj['source_author'] == '/root/actual_record_checker'
             and obj['scope'] == SCOPE and obj['prepared_utc'] == manifest['prepared_utc'],
             'actual035 author/scope/timestamp')
        need(obj['operational_authority'] is False, 'no operational authority')
    for obj in (context, manifest):
        need(obj['publication_performed'] is False and obj['target_execution'] is False,
             'no publication or target execution')
    need(contract['target_execution'] is False
         and contract['publisher_main_or_definitions_executed'] is False
         and author['publication_performed'] is False
         and author['publisher_definitions_import_main_executed'] is False
         and author['helper_test_target_execution'] is False
         and author['whole_five_primary034_bytes_preserved'] is True
         and author['finite_input_count'] == 54 and author['selected_link_count'] == 59
         and author['current28_UNRUN'] is True
         and author['utility6_plus_F1_deferred_UNRUN'] is True
         and author['selected_pro3_TYPE_PASS'] is False
         and author['selected_pro3_evidence_attributed_only'] is True
         and author['actual_models_or_fit_or_capture'] is None
         and author['old_pending_snapshot_bytes_preserved'] is True,
         'complete author035 preparation limits')

    prior = decode(add(WORK / 'root-docs-major034/STAGED_DOCUMENTATION_MANIFEST_034_001.json',
        '1a73af8a6e5dd49dde9446ff6355c2fe230140971bfe0853ce5f2ed82e03d34d', 48370))
    exact(prior, ('schema_version','record_type','author','prepared_utc','checkpoint',
        'primaries','inputs','links','source_only','publication_performed',
        'target_execution','operational_authority'))
    need(len(prior['inputs']) == 60 and len(prior['links']) == 32
         and prior['record_type'] == 'major034_documentation_stage', 'authentic034 stage')
    prior_rows = {row['destination']: row for row in prior['primaries']}
    superseded = []
    for packet in (manifest, prior):
        addrow(packet['checkpoint'])
        need(tuple(row['destination'] for row in packet['primaries']) == PRIMARY,
             'exact five canonical primaries/order')
        for row in packet['primaries']:
            exact(row, ('destination','before','candidate','preservation'))
            addrow(row['before'])
            addrow(row['candidate'])
        need(len({row['original']['path'].casefold() for row in packet['inputs']})
             == len(packet['inputs']), 'unique finite original paths')
        need(len({row['copy']['path'].casefold() for row in packet['inputs']})
             == len(packet['inputs']), 'unique finite copied paths')
        for row in packet['inputs']:
            exact(row, ('original','copy'))
            exact(row['original'], ('path','sha256','bytes'))
            if packet is prior and row['original']['path'] in PRIMARY:
                old = prior_rows[row['original']['path']]
                need(row['original']['sha256'] == old['before']['sha256']
                     and row['original']['bytes'] == old['before']['bytes']
                     and addrow(old['before']) == addrow(row['copy']),
                     'historical033 primary bytes match archived034 before/copy')
                superseded.append(dict(original=row['original'], archived_before=old['before'],
                    exact_copy=row['copy'], selected_current034=old['candidate'],
                    obsolete033_live_pin_replayed=False))
            else:
                need(addrow(row['original']) == addrow(row['copy']), 'exact complete packet pair')
    need(len(superseded) == 5, 'actual034 has exactly five superseded live033 primary roles')
    final = {row['original']['path']: (row['original']['sha256'],row['original']['bytes'])
             for row in manifest['inputs']}
    need(len(final) == 54, 'exact current original count')

    section_pins = [
        ('c989eb35ba7a34d9a48020244d5a01cf1e7702abb0cfd0cf7baa9728c0966761',1205),
        ('d764b9ef412d0e57b09d5fc19d5bc8590d74de387447c694abd7a32a78724bab',5980),
        ('a0b7cc2976f913d14e377b75de4c58050bff81e7782e4527baeda6e4ed68042d',1264),
        ('f2d0b8b5449eef9bf5ea4e6687a0283bf4c51ca0f1cd1b794647c5646b65223d',6059),
        ('0c7155dac8406e51c30e4281b3b27241f825437962ef08af0ee15c43e301d8ec',3737)]
    boundary = b'\n\n---\n\nEarlier primary bytes below remain exact history; their pending statements describe the earlier selected snapshot.\n\n'
    texts, history = [], []
    for index, (row, old) in enumerate(zip(manifest['primaries'], prior['primaries'])):
        before, candidate = addrow(row['before']), addrow(row['candidate'])
        need(before == add(local(row['destination']), sha(before), len(before))
             == addrow(old['candidate']), 'live034/candidate/current035-before exact')
        section = add(STAGE / ('selected-sections/section-' + str(index) + '.md'),
                      *section_pins[index])
        if index < 3:
            need(row['preservation'] == 'suffix' and candidate == section + boundary + before,
                 'complete034 suffix3 history and final selected prefix')
            addition = candidate[:-len(before)]
        else:
            need(row['preservation'] == 'prefix' and candidate == before + b'\n\n' + section,
                 'complete034 prefix2 history and final selected suffix')
            addition = candidate[len(before):]
        need(manifest['prepared_utc'].encode('ascii') in addition
             and b'_WORK_' not in addition and b'_PREPARED_UTC_' not in addition,
             'all complete final candidate additions, no draft placeholders')
        text = addition.decode('utf8','strict')
        if index in (0, 2):
            need('28 remain UNRUN' in text and 'no TYPE PASS' in text,
                 'current short-form prechild/TYPE failure wording qualified')
        else:
            need('No test, helper, event or result occurred' in text
                 and 'No TYPE/runtime PASS' in text,
                 'current long-form prechild/TYPE failure wording qualified')
        need('whole-host quiet' in text and '20:39:32.1487556' in text
             and 'reserve510=Root450+after60' in text, 'owner/lease/caps/quiet qualifications')
        texts.append(dict(document=row['destination'], bytes=len(addition),
                          sha256=sha(addition), text=text))
        history.append(dict(destination=row['destination'], preservation=row['preservation'],
                            before=row['before'], candidate=row['candidate'],
                            entire_prior034_bytes_exact=True, live034_equals_before=True))
    checkpoint = addrow(manifest['checkpoint'])
    need(sha(checkpoint) == CHECKPOINT_SHA and len(checkpoint) == 6166, 'fixed checkpoint006')
    texts.append(dict(document=CHECKPOINT.relative_to(ROOT).as_posix(),bytes=len(checkpoint),
                      sha256=sha(checkpoint),text=checkpoint.decode('utf8','strict')))
    extracted = []
    for item in texts:
        for target in re.findall(r'\]\(([^)]+)\)',item['text']):
            need(not target.startswith(('https:','http:','file:')), 'local final-location links')
            resolved = (local(item['document']).parent/target).resolve()
            relative = resolved.relative_to(ROOT).as_posix()
            extracted.append(dict(origin=item['document'],target=target,resolved_path=relative))
            if resolved != CHECKPOINT:
                need(relative in final, 'every nonfuture selected link has a pinned035 input')
                pin,size = final[relative]
                add(resolved,pin,size)
    def linkkey(row):
        exact(row,('origin','target','resolved_path'))
        return row['origin'],row['target'],row['resolved_path']
    need(len(extracted) == 59 and sorted(map(linkkey,extracted)) ==
         sorted(map(linkkey,manifest['links'])), 'all59 complete selected links')
    # Also retain every old034 declared target. Its future005 checkpoint is now
    # genuinely published; all other old links remain finite historical Source.
    for row in prior['links']:
        exact(row,('origin','target','resolved_path'))
        path=local(row['resolved_path'])
        if path != CHECKPOINT:
            add(path)

    creation = selected('root-docs-major034/ROOT_CREATION_SELECTION_034_001.json')
    need(creation['author'] == '/root'
         and creation['verdict'] == 'SELECTED_GENUINE_DIFFERENT_CREATION_ACCEPTANCE'
         and creation['Root_owning_exit_code'] == 0
         and creation['Root_owning_publication_tool_chunk'] == '073625'
         and creation['Root_current_finite_original_and_copy_rows_verified'] == 621
         and creation['whole_history_suffix3_prefix2_exact'] is True
         and creation['source_input_cohort'] == 306 and creation['selected_links'] == 32
         and creation['creation_review']['sha256'] ==
             'bd59d4beca4c277f2eb9ca02fbf1c26f7008cb82326a6274deec866c026386e5'
         and creation['post_sha256'] ==
             '70003aa0a900f95d1228b32068fdd3472a4ef9b126f26379bdad9daf922404ba'
         and creation['operational_authority'] is False, 'genuine621-row historical034 creation')
    full34 = selected('root-docs-independent-major034/INDEPENDENT_MAJOR034_CREATION_REVIEW_001.json')
    need(full34['reviewer'] == '/root/bootstrap_stage'
         and full34['verdict'] == 'PASS_MAJOR034_DOCUMENTATION_CREATION_ONLY'
         and full34['target_execution'] is False and full34['operational_authority'] is False,
         'different034 actual creation scope')
    selected('root-docs-independent-major034/POST_MAJOR034_CREATION_REVIEW_001.json')
    producer = selected('root-guard006-pipeline-prep001/ROOT_BINDER003_PHYSICAL_SOURCE_PRODUCER_001.json')
    need(producer['author'] == '/root' and producer['owning_tool']['chunk_id'] == '0854a9'
         and producer['owning_tool']['exit_code'] == 0
         and producer['three_fresh_files_only'] is True
         and producer['six_bound_sources_retained_read_only'] is True
         and producer['binder003_spent_no_replay'] is True
         and producer['pipeline_INIT_started'] is False and producer['capture_started'] is False
         and producer['models_CREATED'] is False and producer['target_execution'] is False
         and producer['operational_authority'] is False, 'actual binder Source-only attribution')
    need(len(producer['current_output_readback']) == 9, 'three fresh plus six retained Source files')
    for row in producer['current_output_readback']:
        add(Path(row['path']),row['sha256'],row['bytes'])
    oldconfig = add(WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_BINDING_001.json',
        'ef3a6f208158ca2809aecf6d92b62b63777d4b795574c8cdccec1f882c669488',6814)
    need(oldconfig == add(WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_BINDING_002.json',
        'ef3a6f208158ca2809aecf6d92b62b63777d4b795574c8cdccec1f882c669488',6814),
        'freshconfig002 exact canonical001 bytes')
    provenance = selected('root-guard006-pipeline-prep001/ROOT_PIPELINE_SOURCE_BINDING_PROVENANCE_002.json')
    need(len(provenance) == 17, 'retained closed17 source provenance')
    p16 = selected('root-pipeline-independent-review001/SOURCE_REVIEW_ROOT_PIPELINE_002.json')
    need(len(p16) == 16 and p16['reviewer'] == '/root/owner_docs_review'
         and p16['source_author'] == '/root' and p16['verdict'] == 'PASS_STATIC_ROOT_PIPELINE_SOURCE_ONLY'
         and p16['pipeline_binding_sha256'] ==
             'ef3a6f208158ca2809aecf6d92b62b63777d4b795574c8cdccec1f882c669488'
         and p16['pipeline_source_sha256'] ==
             '84ddc157d2c2b9eba3998afc8ca57e09110cd34e24e403422e574a97b20165d3'
         and p16['before_capture_timer'] is True and p16['target_execution'] is False
         and p16['operational_authority_granted'] is False
         and len(p16['phase_argv_templates']) == 8, 'genuine successor P16 Source only')
    p16full = selected('root-pipeline-independent-review001/actual-source-002/INDEPENDENT_ACTUAL_ROOT_SOURCE_DETAILS_002.json')
    need(p16full['finite_input_count'] == 188 and p16full['actual_source_binding_accepted'] is True
         and p16full['runtime_acceptance'] is False and p16full['tests_executed'] is False
         and p16full['independent_OS_or_tool_attestation'] is False
         and p16full['target_execution'] is False, 'full188 different Source acceptance limits')
    placeholders=[]
    for tokens in p16['phase_argv_templates'].values():
        need(type(tokens) is list and all(type(token) is str for token in tokens), 'argv primitives')
        placeholders.extend(token for token in tokens if re.fullmatch(r'\{[a-z][a-z0-9_]*\}',token))
    need(len(placeholders) == 11 and len(set(placeholders)) == 6, 'eight argv11 flat tokens/six names')
    for name in ('PREPARE_ROOT_GUARD006_RECORDS_001.BOUND.ps1',
                 'SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1',
                 'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1',
                 'SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1'):
