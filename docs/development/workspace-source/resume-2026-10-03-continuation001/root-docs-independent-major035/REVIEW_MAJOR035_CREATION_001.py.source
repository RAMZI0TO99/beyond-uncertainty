"""Different reviewer owned metadata observer. Never invokes selected sources."""
import ast
import hashlib
import json
import os
import re
import stat
from datetime import datetime, timezone
from decimal import Decimal
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(r'D:\Aenv\pro2')
WORK = ROOT / 'resume-2026-10-03-continuation001'
STAGE = WORK / 'root-docs-major035'
OUT = WORK / 'root-docs-independent-major035'
AUTHOR = '/root/bootstrap_stage'
MAX_FILE = 8388608
PRIMARY = ('AGENTS.md', 'HANDOFF.md', 'START_HERE.md', 'resume-2026-09-28-001/SESSION.md', 'resume-2026-10-01-30h-001/RESOURCE_COORDINATION.md')
MANIFEST_SHA = 'a6c2679b368b632f7db6ba04befa0474fa2f499a5e03ecf7ea66c279d10bbb51'
PUBLISHER_SHA = '4da4b3266c6bcb3a972bd695cd772b1e6b2b9f44051735d5be188e931430377a'
DETAILS_SHA = 'cb902d26f41b21458f29f4082d848cae06a872e032adca95348ddee427cc1bf6'
POST_SHA = 'ddb6074262f66dc5baf9754341f659770b474e13ca0a5fb1ce0ec0e7e4a458f0'
PEER_SHA = '241a6ee114c62adde5daeed597949f6bbd3585bb3a3d1a5954146b0c52e23b8e'

def need(value, message):
    if not value:
        raise ValueError(message)

def sha(value):
    return hashlib.sha256(value).hexdigest()

def wire(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=True, indent=2, allow_nan=False) + '\n').encode('ascii')

def decode(value):
    def pairs(rows):
        result = {}
        for key, item in rows:
            need(key not in result, 'duplicate JSON key')
            result[key] = item
        return result
    def bad(value):
        raise ValueError('nonfinite JSON refused')
    need(not value.startswith(b'\xef\xbb\xbf'), 'JSON BOM refused')
    return json.loads(value.decode('utf8', 'strict'), object_pairs_hook=pairs, parse_float=Decimal, parse_constant=bad)

def raw(value):
    return [getattr(value, name) for name in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def chain(path):
    result = []
    for item in reversed(path.parents):
        value = item.lstat()
        need(stat.S_ISDIR(value.st_mode) and not value.st_file_attributes & 1024, 'plain ancestors')
        result.append([str(item), value.st_dev, value.st_ino])
    return result

def read(path, pin=None, size=None):
    external = {Path('D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types3\\root_failed_type_cleanup_closeout_001.json'): '285fbad78a326c54eb96f0c16acfdb3c5812f67b19cf42cb6747d36e266f1444', Path('D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types3\\root_type_peer_release_closeout_001.json'): '8510f04d31d1b506bfd6222e324557aa7794e48d965f793dc01e0465368921e0', Path('D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types3\\root_type_physical_witness_001.json'): '2c8ce6e9bdd199ad792a32a7a7989d6fcb30a1191bf9c3405ef8d11846485d0e', Path('D:\\Aenv\\pro3\\runs\\coordination\\next_step_20261003_types3\\type_execution_audit_001.json'): 'e7103786d9ee380b63932a3de357349e31ce903fb8c13a56c2a5c8421b05e7f3', Path('D:\\Aenv\\pro3\\runs\\phase2\\type_validation\\pro3_types_20261003_003\\mypy.stderr.log'): 'b67de786706f2ed03456016fe05cfce146ec138d208115b5bf0a924184d02aad', Path('D:\\Aenv\\pro3\\runs\\phase2\\type_validation\\pro3_types_20261003_003\\mypy.stdout.log'): '0ea4ff7b2ff88e2e5bd55c9b2cd93c6b6f1b626bd3c89dbcb38f4b79c0f863bf'}
    need(path.is_absolute() and (path.is_relative_to(ROOT) or (path in external and pin == external[path])), 'Root or six exact pinned external metadata roles')
    ancestors = chain(path)
    first = path.lstat()
    need(stat.S_ISREG(first.st_mode) and first.st_nlink == 1 and not first.st_file_attributes & 1024 and 0 <= first.st_size <= MAX_FILE, 'plain single-link capped input')
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        left, right = raw(first), raw(opened)
        need(left[:4] + left[5:] == right[:4] + right[5:] and left[4] == left[8], 'ordinary cross8 and birth')
        value = stream.read(first.st_size + 1)
        need(raw(opened) == raw(os.fstat(stream.fileno())), 'same-handle raw9')
    need(raw(first) == raw(path.lstat()) and chain(path) == ancestors and len(value) == first.st_size, 'path raw9 ancestry and exact length')
    need(pin is None or sha(value) == pin, 'selected exact SHA')
    need(size is None or len(value) == size, 'selected exact size')
    return value, dict(path=str(path), sha256=sha(value), bytes=len(value), path_raw9=left, descriptor_raw9=right, ancestors=ancestors)

def local(relative):
    need(type(relative) is str and '\\' not in relative and not relative.startswith('/') and all(part not in ('', '.', '..') and ':' not in part for part in relative.split('/')), 'canonical relative path')
    return ROOT.joinpath(*relative.split('/'))

def once(name, value):
    need(type(value) is bytes and len(value) <= MAX_FILE, 'review output8MiB')
    path = OUT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    need(not path.exists(), 'own review output create-once')
    with path.open('xb') as stream:
        need(stream.write(value) == len(value), 'complete own review write')
    need(read(path)[0] == value, 'own metadata readback')

def main():
    need(Path(__file__).absolute() == OUT / 'REVIEW_MAJOR035_CREATION_001.py', 'own observer identity')
    need(not (OUT / 'INDEPENDENT_MAJOR035_CREATION_REVIEW_001.json').exists(), 'creation first entry')
    manifest_bytes, manifest_meta = read(STAGE / 'STAGED_DOCUMENTATION_MANIFEST_035_001.json', MANIFEST_SHA, 53520)
    publisher, _ = read(STAGE / 'PUBLISH_MAJOR035_DOCS_001.py', PUBLISHER_SHA, 9951)
    peer_bytes, peer_meta = read(OUT / 'INDEPENDENT_MAJOR035_PREPUBLICATION_SOURCE_REVIEW_001.json', PEER_SHA, 624)
    details_bytes, details_meta = read(OUT / 'INDEPENDENT_MAJOR035_SOURCE_DETAILS_001.json', DETAILS_SHA)
    source_post_bytes, source_post_meta = read(OUT / 'POST_MAJOR035_SOURCE_REVIEW_001.json', POST_SHA)
    receipt_bytes, receipt_meta = read(STAGE / 'ROOT_PUBLISH_RECEIPT_035.json', '92509c49d79abce619acac1bac27c13b1a59b5cf1e3e8f446b661f73775bc69b')
    manifest, peer, details, source_post, receipt = map(decode, (manifest_bytes, peer_bytes, details_bytes, source_post_bytes, receipt_bytes))
    need(details_meta['sha256'] == DETAILS_SHA, 'Root-selected full Source details')
    need(peer['reviewer'] == '/root' and peer['source_author'] == '/root/actual_record_checker' and peer['verdict'] == 'PASS_MAJOR035_DOCUMENTATION_SOURCE_ONLY' and peer['publisher_sha256'] == PUBLISHER_SHA and peer['manifest_sha256'] == MANIFEST_SHA and peer['publication_performed'] is False and peer['target_execution'] is False, 'genuine distinct Source review')
    need(details['finite_input_count'] == len(details['finite_inputs']) == 262 and details['current_original_copy_pairs'] == 54 and details['complete_prior034_pairs'] == 60 and len(details['superseded_prior034_live_primary_roles']) == 5 and not details['findings'], 'complete Source cohort and corrected zero prior roles')
    need(receipt['author'] == '/root' and receipt['record_type'] == 'root_documentation_publish' and receipt['publisher_sha256'] == PUBLISHER_SHA and receipt['manifest_sha256'] == MANIFEST_SHA and receipt['source_review_sha256'] == PEER_SHA and tuple(receipt['changes']) == PRIMARY and receipt['batch_atomicity_guaranteed'] is False and receipt['target_execution'] is False and receipt['operational_authority'] is False, 'physical Root publication receipt fields')
    need(tuple(row['destination'] for row in manifest['primaries']) == PRIMARY and len(manifest['inputs']) == 54 and len(manifest['links']) == 59, 'exact current documentation scope')
    pins, expected_rows, allowed_changed = {}, {}, {}
    for row in manifest['primaries']:
        allowed_changed[local(row['destination'])] = row['candidate']
    for row in details['finite_inputs']:
        path = Path(row['path'])
        if path in allowed_changed:
            selected = allowed_changed[path]
            pins[path] = (selected['sha256'], selected['bytes'])
        else:
            pins[path] = (row['sha256'], row['bytes'])
            expected_rows[path] = row['passes'][0]
        copy = OUT / row['copy_path']
        pins[copy] = (row['sha256'], row['bytes'])
        expected_rows[copy] = row['copy_observation']
    need(len([row for row in details['finite_inputs'] if Path(row['path']) in allowed_changed]) == 5, 'exact five current source originals changed')
    fixed_top = [STAGE / name for name in ('STAGED_DOCUMENTATION_MANIFEST_035_001.json', 'AUTHOR_MAJOR035_STAGE_AUDIT_001.json', 'DOCUMENTATION_SOURCE_CONTRACT_035_001.json', 'HANDOFF_MAJOR035_FROZEN_SOURCE_001.md', 'ROOT_PUBLISH_RECEIPT_035.json', 'SELECTED_SOURCE_CONTEXT_035_001.json')]
    fixed_top += [OUT / name for name in ('INDEPENDENT_MAJOR035_PREPUBLICATION_SOURCE_REVIEW_001.json', 'INDEPENDENT_MAJOR035_SOURCE_DETAILS_001.json', 'POST_MAJOR035_SOURCE_REVIEW_001.json', 'ROOT_REVIEW_MAJOR035_SOURCE_001.py', 'HANDOFF_MAJOR035_SOURCE_REVIEW_001.md', 'HANDOFF_PREPARED_ROOT_MAJOR035_SOURCE_AUDITOR_001.md')]
    for path in fixed_top:
        value, meta = read(path)
        if path in pins:
            need(pins[path] == (sha(value), len(value)), 'fixed role overlaps agree')
        pins[path] = (sha(value), len(value))
    checkpoints = manifest['checkpoint']
    pins[local(checkpoints['path'])] = (checkpoints['sha256'], checkpoints['bytes'])
    checkpoint = WORK / 'CONTINUATION_CHECKPOINT_006.md'
    pins[checkpoint] = (checkpoints['sha256'], checkpoints['bytes'])
    captures, initial, copies = {}, {}, {}
    for ordinal, (path, (pin, size)) in enumerate(sorted(pins.items(), key=lambda row: str(row[0]))):
        value, first = read(path, pin, size)
        if path in expected_rows:
            need(first == expected_rows[path], 'unchanged Source original/copy metadata')
        copy_name = 'creation001-inputs/%03d.bytes' % ordinal
        once(copy_name, value)
        copy_bytes, copy_meta = read(OUT / copy_name, pin, size)
        need(copy_bytes == value and copy_meta['path_raw9'][:2] != first['path_raw9'][:2], 'independent retained review copy')
        captures[path], initial[path], copies[path] = value, first, dict(path=copy_name, observation=copy_meta)
    history, regions = [], {}
    for row in manifest['primaries']:
        old = captures[local(row['before']['path'])]
        new = captures[local(row['candidate']['path'])]
        actual = captures[local(row['destination'])]
        need(actual == new and (new.endswith(old) if row['preservation'] == 'suffix' else new.startswith(old)), 'physical candidate and complete whole034 preservation')
        addition = new[:len(new)-len(old)] if row['preservation'] == 'suffix' else new[len(old):]
        need(addition and re.search(rb'(?:Major035|major035|MAJOR STEP035)', addition), 'actual selected035 title spelling')
        regions[row['destination']] = addition.decode('utf8', 'strict')
        history.append(dict(destination=row['destination'], actual_sha256=sha(actual), bytes=len(actual), preservation=row['preservation'], whole034_bytes=len(old), whole034_sha256=sha(old), new_region_sha256=sha(addition), new_region_bytes=len(addition), exact_physical_candidate=True))
    checkpoint_bytes = captures[checkpoint]
    need(checkpoint_bytes == captures[local(checkpoints['path'])], 'physical checkpoint candidate')
    regions[checkpoint.relative_to(ROOT).as_posix()] = checkpoint_bytes.decode('utf8', 'strict')
    discovered = []
    for origin, text in regions.items():
        for match in re.finditer(r'\[[^\]]+\]\(([^)]+)\)', text):
            target = match.group(1)
            need('://' not in target and not target.startswith('#'), 'current selected links local')
            resolved = (local(origin).parent / unquote(target.split('#', 1)[0])).resolve(strict=True)
            need(resolved.is_relative_to(ROOT), 'current link Root-contained')
            discovered.append(dict(origin=origin, target=target, resolved_path=resolved.relative_to(ROOT).as_posix()))
    need(sorted(discovered, key=lambda row: (row['origin'], row['target'], row['resolved_path'])) == sorted(manifest['links'], key=lambda row: (row['origin'], row['target'], row['resolved_path'])) and len(discovered) == 59, 'all exact newly maintained32 links')
    prior = decode(captures[WORK / 'root-docs-major034/STAGED_DOCUMENTATION_MANIFEST_034_001.json'])
    need(len(prior['inputs']) == 60 and sum(local(row['original']['path']) in allowed_changed for row in prior['inputs']) == 5, 'prior034 cohort exactly five historical live roles')
    for row in manifest['inputs']:
        original, copy = local(row['original']['path']), local(row['copy']['path'])
        if original in allowed_changed:
            before_row = next(r['before'] for r in manifest['primaries'] if local(r['destination']) == original)
            need(captures[copy] == captures[local(before_row['path'])], 'current changed originals retain exact034 before')
        else:
            need(captures[original] == captures[copy], 'all remaining current54 pairs exact')
    for row in prior['inputs']:
        original, copy = local(row['original']['path']), local(row['copy']['path'])
        if original in allowed_changed:
            prior_role = next(r for r in prior['primaries'] if local(r['destination']) == original)
            current_before = next(r['before'] for r in manifest['primaries'] if local(r['destination']) == original)
            need(captures[copy] == captures[local(prior_role['before']['path'])], 'prior034 five input copies retain033 baseline')
            need(captures[local(prior_role['candidate']['path'])] == captures[local(current_before['path'])], 'whole actual034 candidate becomes035 before')
        else:
            need(captures[original] == captures[copy], 'prior034 other55 pairs exact')
    # Only four fixed physical record roles admit their exact finite Decimal fields.
    physical_domains = source_domains = details['native_Decimal_exception_field_domains']
    need(len(physical_domains) == 4, 'four exact native physical Decimal role domains')
    for relative, expected in physical_domains.items():
        value = decode(captures[WORK / relative]);actual = {}
        def walk(item, prefix=''):
            if type(item) is Decimal:
                need(item.is_finite(), 'finite native Decimal');actual[prefix] = str(item)
            elif type(item) is dict:
                for key, child in item.items():walk(child, prefix+'/'+key)
            elif type(item) is list:
                for ordinal, child in enumerate(item):walk(child, prefix+'/'+str(ordinal))
        walk(value);need(actual == expected, 'exact externally pinned physical Decimal field/domain values')
    # Third own observation is paired with exact prior observations; no selected definitions are called.
    evidence = []
    for path in captures:
        passes = [initial[path]]
        for _ in range(2):
            value, observation = read(path, *pins[path])
            need(value == captures[path] and observation == initial[path], 'full own triple stability')
            passes.append(observation)
        copied, copied_meta = read(OUT / copies[path]['path'], *pins[path])
        need(copied == captures[path] and copied_meta == copies[path]['observation'], 'full own copy stability')
        evidence.append(dict(path=str(path), bytes=len(captures[path]), sha256=sha(captures[path]), passes=passes, own_copy=copies[path]))
    review = dict(schema_version=1,record_type='independent_major035_documentation_creation_review',created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),reviewer=AUTHOR,source_author='/root/actual_record_checker',publisher='/root',scope='LOCAL_PRIVATE_MAJOR035_DOCUMENTATION_CREATION_ONLY',verdict='PASS_MAJOR035_DOCUMENTATION_CREATION_ONLY',staged_manifest_sha256=MANIFEST_SHA,publisher_sha256=PUBLISHER_SHA,source_review_sha256=PEER_SHA,source_details_sha256=details_meta['sha256'],source_post_sha256=source_post_meta['sha256'],publication_receipt_sha256=receipt_meta['sha256'],owning_Root_tool_attribution=dict(tool_chunk='37b462',reported_exit=0,reported_wall_seconds='0.5121641',correlation_required_by_Root=True,reviewer_independent_OS_attestation=False),reviewed_finite_inputs=len(evidence),source_input_cohort=262,source_cohort_declared_copies=262,current035_stage_pairs=54,prior034_stage_pairs=60,prior034_historical_superseded_live_roles=5,changed_current_primary_originals=5,physical_checkpoint_exact=True,new_link_count=59,whole_history_suffix_count=3,whole_history_prefix_count=2,current_primary_history=history,selected_links=discovered,findings=[],semantic_scope_notes=['All five complete published additions and checkpoint006 were read; physical candidates and complete034 history match.','Binder003 created exactly3Source outputs/retained6; P16 genuine Source002 accepted only Source; no INIT/model/capture follows.','Utility controls are6runnable plus1explicit F1deferred skip/7planned IDs/10subtests/24hypothetical events and30planned provenance calls, all unrun; L1/L2 machine_core fields give no Core/pool/runtime authority.','Parent checker001 refused genuine7stamp domain before child; null exit/false child reap-drain reflect nonentry; GO/ACK/parent are spent. This reviewer authenticates own preparation facts only, not semantic approval of its own Checker28 successor.','TYPE003 evidence accepts FAILED attempt,4mypy errors/205files and attributable56.482255099999996s/exit1. Parent cleanup true/native failure wholecleanup false/extra83372unqueried/final checks incomplete: no TYPE pass/quiet or retrospectiveTYPE001 cause.','The explicit Pro3 release15:28:40 chronology is attributed and preserves older15:27estimate; this reviewer makes no native process/Job/timing query or grant replay.','Stage16:11:12.832234source snapshot pending Checker002/Ctor004 remains exact. Later Source acceptances lie outside this stage and grant no runtime/model/pool20/READY/metadataGO/capture/current24 authority.','Ongoing owner/endNone is separate from finite lease43cb; caps600/both90/resource60/510reserve/450+after60/sourcehistory/science/epoch/no replay/public/push remain exact.'],no_prior_old_link_global_revalidation_claim=True,root_batch_atomicity=False,native_Decimal_exception_field_domains=physical_domains,target_execution=False,selected_import_definitions_compile_main_called=False,production_or_Git_or_native_actions=False,operational_authority=False,evidence=evidence)
    review_bytes = wire(review)
    once('INDEPENDENT_MAJOR035_CREATION_REVIEW_001.json', review_bytes)
    post_rows = []
    for path in captures:
        value, observation = read(path, *pins[path])
        copied, copied_meta = read(OUT / copies[path]['path'], *pins[path])
        need(value == copied == captures[path] and observation == initial[path] and copied_meta == copies[path]['observation'], 'all inputs and reviewer copies postpublication')
        post_rows.append(dict(path=str(path), observation=observation, own_copy=copies[path]['path'], copy_observation=copied_meta))
    post = dict(schema_version=1, created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'), reviewer=AUTHOR, review_sha256=sha(review_bytes), all_finite_inputs_and_copies_exact=True, rows=post_rows, target_execution=False, operational_authority=False)
    post_bytes = wire(post)
    once('POST_MAJOR035_CREATION_REVIEW_001.json', post_bytes)
    handoff = ('Different Major035 documentation creation review only, /root/bootstrap_stage.\n\nFive actual primaries/checkpoint006 match candidates; complete034 suffix3/prefix2 and59 maintained links exact. Current54/prior34-60 stages and Source262 finite original/copy cohort authenticated, including five historical superseded033 live roles in prior34 and exactly five newly changed current primaries. Every selected input and own independent copy has triple+post/final raw9/hash stability. Root37b462 owns physical publication correlation; reviewer makes no OS attestation or target action. All selected stage16:11 pending statements remain their historical scopes; later Source acceptances are separate, not runtime/model/pool authority.\n\nReview '+sha(review_bytes)+'\nPost '+sha(post_bytes)+'\n')
    once('HANDOFF_MAJOR035_CREATION_REVIEW_001.md', handoff.encode('utf8'))
    for path in captures:
        need(read(path, *pins[path])[1] == initial[path] and read(OUT / copies[path]['path'], *pins[path])[1] == copies[path]['observation'], 'final paired preservation')
    need(read(OUT / 'INDEPENDENT_MAJOR035_CREATION_REVIEW_001.json')[0] == review_bytes and read(OUT / 'POST_MAJOR035_CREATION_REVIEW_001.json')[0] == post_bytes, 'review output final readback')
    print(json.dumps(dict(verdict=review['verdict'], reviewed_inputs=len(evidence), own_copies=len(evidence), review_sha256=sha(review_bytes), review_bytes=len(review_bytes), post_sha256=sha(post_bytes), post_bytes=len(post_bytes), handoff_sha256=sha(handoff.encode('utf8')), target_execution=False)))

if __name__ == '__main__':
    main()
