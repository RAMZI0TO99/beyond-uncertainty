            'BEFORE_PARENT','AFTER_PARENT','WHOLE_BEFORE_PARENT','WHOLE_AFTER_PARENT','WHOLE_AFTER_WRITER','OBSERVER','DRIVER','CHILD','BINDINGS','INPUTS','SELF_SHA','SOURCE_PEER_SHA','BINDING_SHA')
