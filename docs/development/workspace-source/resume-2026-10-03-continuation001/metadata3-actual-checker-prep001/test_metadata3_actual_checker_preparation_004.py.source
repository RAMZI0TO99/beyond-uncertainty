        with patch.object(c,'CONFIG',config),patch.object(c,'selected',selected),patch.object(c,'read',read):
            def healthy():
                mode[0]='healthy';calls.clear();result=c.root_trust_preflight('0'*64)
                self.assertEqual(result,(trust,config['root_pipeline_source'],init,peer))
                self.assertEqual([row[1]for row in calls if row[0]=='selected'],[trust_path,peer_path,init_path])
                self.assertIn(('read',pipeline,'1'*64,131072),calls)
            healthy()
            for key,old in (('path',str(pipeline.with_name('RUN_ROOT_METADATA_PIPELINE_006.BOUND.ps1'))),
                ('source_peer_path',str(peer_path.with_name('SOURCE_REVIEW_ROOT_PIPELINE_001.json')))):
                original=config['root_pipeline_source'][key];config['root_pipeline_source'][key]=old
                with self.assertRaisesRegex(ValueError,'Root-selected pipeline source/peer'):c.root_trust_preflight('0'*64)
                config['root_pipeline_source'][key]=original;healthy()
            original=trust['init_trace']['path'];trust['init_trace']['path']=str(init_path.with_name('ROOT_PIPELINE_INIT_TRACE_001.json'))
            with self.assertRaisesRegex(ValueError,'fixed trusted init path'):c.root_trust_preflight('0'*64)
            trust['init_trace']['path']=original;healthy()
            for old,requested in (('old-trust',trust_path),('old-init',init_path)):
                mode[0]=old;calls.clear()
                with self.assertRaises(KeyError) as caught:c.root_trust_preflight('0'*64)
                self.assertEqual(caught.exception.args,(requested,));self.assertIn(requested,[row[1]for row in calls]);healthy()
            original=peer['reviewer'];peer['reviewer']='owner_docs_review'
            with self.assertRaisesRegex(ValueError,'different authentic Root source peer'):c.root_trust_preflight('0'*64)
            peer['reviewer']=original;healthy()
            original=init['pid'];init['pid']=True
            with self.assertRaisesRegex(ValueError,'fixed Root init identity'):c.root_trust_preflight('0'*64)
            init['pid']=original;healthy()
            original=peer['phase_argv_templates']['auth_before'];peer['phase_argv_templates']['auth_before']=['{unreviewed_name}']
            with self.assertRaisesRegex(ValueError,'closed reviewed argv substitution'):c.root_trust_preflight('0'*64)
            peer['phase_argv_templates']['auth_before']=original;healthy()

    def test_fresh_decision_reopens_current_peer003_config002_before_provenance_or_output(self):
        c=self.checker;calls=[];mode=['healthy'];ticket={'synthetic_fixture':1}
        peer_path=c.WORK/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_003.json'
        config_path=c.CHECKER/'ACTUAL_CHECKER_BINDING_002.json'
        ticket_path=c.CHECKER/'ACTUAL_TICKET_AUTH_BEFORE_006.json'
        wire=c.encoded(ticket)
        def read(path,pin=None,cap=2097152,runtime=False):
            calls.append(path);pool={SOURCE:b'synthetic-source',peer_path:b'synthetic-peer',config_path:b'synthetic-config',ticket_path:wire}
            if path==SOURCE:self.assertEqual((pin,cap),(SOURCE_SHA256,262144))
            elif path==peer_path:self.assertEqual((pin,cap),('1'*64,8388608))
            elif path==config_path:self.assertEqual((pin,cap),('2'*64,131072))
            else:self.assertEqual((path,pin,cap),(ticket_path,'3'*64,65536))
            if mode[0]=='old-peer':pool[peer_path.with_name('INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_002.json')]=pool.pop(peer_path)
            if mode[0]=='old-config':pool[config_path.with_name('ACTUAL_CHECKER_BINDING_001.json')]=pool.pop(config_path)
            return pool[path],{}
        def provenance(*args):
            calls.append('provenance');raise RuntimeError('synthetic fixture stops before any decision publication')
        with (patch.object(c,'ticket_check',lambda *args:object()),patch.object(c,'fixed',lambda:({},{})),
            patch.object(c,'EVIDENCE',[]),patch.object(c,'WHOLE_REOBSERVATIONS',{}),patch.object(c,'WHOLE_ORIGIN_ROWS',[]),patch.object(c,'WHOLE_PROJECTION_STATE',{}),
            patch.object(c,'SELF_SHA',SOURCE_SHA256),patch.object(c,'SOURCE_PEER_SHA','1'*64),patch.object(c,'BINDING_SHA','2'*64),
            patch.object(c,'read',read),patch.object(c,'provenance',provenance),patch.object(c,'once',side_effect=AssertionError('synthetic fixture must not publish'))):
            def healthy():
                mode[0]='healthy';calls.clear()
                with self.assertRaisesRegex(RuntimeError,'stops before any decision publication'):c.decision('auth_before',ticket,'4'*64,'3'*64)
                self.assertEqual(calls,[SOURCE,peer_path,config_path,ticket_path,'provenance'])
            healthy()
            for old,requested in (('old-peer',peer_path),('old-config',config_path)):
                mode[0]=old;calls.clear()
                with self.assertRaises(KeyError) as caught:c.decision('auth_before',ticket,'4'*64,'3'*64)
                self.assertEqual(caught.exception.args,(requested,));self.assertIn(requested,calls)
                self.assertNotIn('provenance',calls);healthy()



