    def test_after_bridge_roundtrip_uses_selected_root_bound_writer(self):
        c=self.checker;wire=b'fixture retained driver20 bytes';pin=c.digest(wire);writer='1'*64
        args=type('Args',(),dict(driver_finished_sha256=pin,bridge_provenance_sha256='2'*64,unit_terminal_sha256='3'*64,before_result_sha256='4'*64))()
        provenance={key:None for key in c.COPY_KEYS}
        provenance.update(schema_version=1,record_type='root_guard006_driver_scoped_finished_receipt_copy',author='/root',scope=c.SCOPE,created_utc='2026-10-03T06:00:00.0000002+00:00',source_path=str(c.RUNS/'finished.json'),copy_path=str(c.GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'),sha256=pin,bytes=len(wire),producer_sha256=writer,physical_root_unit_terminal_sha256=args.unit_terminal_sha256,whole_before_result_sha256=args.before_result_sha256,byte_identical_copy=True,canonical_fullQA_native_fit_authority=False,target_execution_performed=False)
        data=(json.dumps(provenance,separators=(',',':'),ensure_ascii=True)+'\n').encode('ascii');calls=[]
        def reader(path,pin=None,cap=2097152,runtime=False):
            calls.append(path)
            if path==c.GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_PROVENANCE_006.json':return data,{}
            if path==c.PIPELINE/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1':self.assertEqual(pin,writer);return b'fixture source',{}
            self.assertIn(path,(c.RUNS/'finished.json',c.GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'));return wire,{}
        with patch.object(c,'actual_unit',lambda *args:({},dict(finished_utc='2026-10-03T06:00:00.0000001+00:00'))),patch.object(c,'WHOLE_AFTER_WRITER',writer),patch.object(c,'read',reader):
            healthy=lambda:c.whole_bridge(args,{})
            healthy();self.assertIn(c.PIPELINE/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1',calls)
            wrong=copy.deepcopy(provenance);wrong['producer_sha256']='9'*64
            original=data;data=(json.dumps(wrong,separators=(',',':'),ensure_ascii=True)+'\n').encode('ascii')
            with self.assertRaises(ValueError):c.whole_bridge(args,{})
            data=original;healthy()

