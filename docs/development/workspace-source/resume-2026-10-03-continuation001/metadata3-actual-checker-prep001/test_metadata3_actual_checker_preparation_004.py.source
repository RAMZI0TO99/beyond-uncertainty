    def test_exact_detail2mib_boundary_refuses_before_any_output_and_restores(self):
        c=self.checker;detail=dict(observations=[dict(value=1)],padding='')
        overhead=len(c.encoded(detail));detail['padding']='x'*(2097152-overhead)
        # Exercise the actual byte publication gate without Root evidence or PASS.
        self.assertEqual(len(c.detail_publication_bytes(detail)),2097152)
        with patch.object(c,'once',side_effect=AssertionError('output published despite refusal')):
            detail['padding']+='x'
            with self.assertRaises(ValueError):c.detail_publication_bytes(detail)
            detail['padding']=detail['padding'][:-1];self.assertEqual(len(c.detail_publication_bytes(detail)),2097152)
            detail['observations']=[dict(value=1) for _ in range(4097)]
            with self.assertRaises(ValueError):c.detail_publication_bytes(detail)


