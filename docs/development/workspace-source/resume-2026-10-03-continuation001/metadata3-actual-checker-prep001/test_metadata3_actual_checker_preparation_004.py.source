        return trees,expected,args,dict(phase='before',observation_files=pointers)

    def test_lossless5390_projection_roundtrip_retains_equal_runtime_and_ordinary_rows(self):
        c=self.checker;trees,expected,args,result=self.projection_fixture()
        with patch.object(c,'WHOLE_EXPECTED',expected),patch.object(c,'EVIDENCE',[]),patch.object(c,'WHOLE_REOBSERVATIONS',{}),patch.object(c,'WHOLE_ORIGIN_ROWS',[]),patch.object(c,'WHOLE_PROJECTION_STATE',{}):
            rows,counts=c.reconstruct_whole_projection_rows(trees)
            self.assertEqual(counts,dict(base=5368,scripts=22));self.assertEqual(len(rows),5390)
            # Same facts, different observation origins: runtime4/source rows stay.
            runtime=copy.deepcopy(rows[0]);ordinary=copy.deepcopy(rows[-1])
            c.EVIDENCE.extend([runtime]+rows+[ordinary]);c.register_whole_projection(rows,args,result,trees,'before')
            compact,projection=c.compact_whole_observations('whole_before_result',args,list(c.EVIDENCE))
            self.assertEqual(len(compact),2);self.assertIs(compact[0],runtime);self.assertIs(compact[1],ordinary)
            self.assertEqual(projection['ordered_projected_observations_sha256'],c.digest(c.encoded(rows)))
            self.assertEqual(projection['counts'],dict(unique_file_count=5390,omitted_observation_count=5390,retained_observation_count=2,total_observation_count=5392,per_tree=counts))
            self.assertEqual(set(projection),set(c.PROJECTION_KEYS))

    def test_projection_all_table_pointer_mutations_refuse_and_restore_lossless_roundtrip(self):
        c=self.checker;trees,expected,args,result=self.projection_fixture()
        def run(changed):
            with patch.object(c,'WHOLE_EXPECTED',expected),patch.object(c,'EVIDENCE',[]),patch.object(c,'WHOLE_REOBSERVATIONS',{}),patch.object(c,'WHOLE_ORIGIN_ROWS',[]),patch.object(c,'WHOLE_PROJECTION_STATE',{}):
                rows,_=c.reconstruct_whole_projection_rows(trees);c.EVIDENCE.extend(rows)
                c.register_whole_projection(rows,args,changed,trees,'before')
        healthy=lambda:run(result)
        mutations=[]
        for key,value in (('path',result['observation_files'][1]['path']),('sha256','b'*64),('bytes',True),('bytes',4194305)):
            changed=copy.deepcopy(result);changed['observation_files'][0][key]=value;mutations.append(changed)
        missing=copy.deepcopy(result);missing['observation_files'].pop();mutations.append(missing)
        duplicate=copy.deepcopy(result);duplicate['observation_files'][1]=copy.deepcopy(duplicate['observation_files'][0]);mutations.append(duplicate)
        for changed in mutations:self.recovered(healthy,lambda changed=changed:run(changed))

