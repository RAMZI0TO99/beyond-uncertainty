        c=self.checker;bindings={'source': '1'*64};pin='2'*64
        record=dict(schema_version=1,record_type='guard006_root_metadata_bound_source_review',reviewer='/root/owner_docs_review',source_author='/root/renewal_runtime_inventory',verdict='PASS_STATIC_BOUND_METADATA_ONLY',actual_script_sha256=pin,source_bindings=bindings,phase_set=['before','after'],metadata_only=True)
        with patch.object(c,'BOUND',pin),patch.object(c,'BINDINGS',bindings):
            healthy=lambda:self.assertEqual(c.bound_metadata_review(record),record)
            for key,value in (('record_type','wrong'),('schema_version',True),('metadata_only',1),('reviewer','owner_docs_review'),('phase_set',['after','before'])):
                bad=copy.deepcopy(record);bad[key]=value
                self.recovered(healthy,lambda:c.bound_metadata_review(bad))
