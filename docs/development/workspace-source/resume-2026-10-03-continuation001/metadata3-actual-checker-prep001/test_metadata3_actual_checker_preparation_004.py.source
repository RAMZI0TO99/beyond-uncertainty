            def healthy():
                mode[0]='healthy';calls.clear();c.configure(args)
                self.assertEqual([path for kind,path in calls if kind=='selected'],[peer_path,config_path])
                self.assertEqual(c.CONFIG['checker_template_sha256'],SOURCE_SHA256)
            healthy()
            with patch.object(c,'__file__',str(SOURCE.with_name('review-metadata3-actual006-corrected009.TEMPLATE.py'))):
                calls.clear()
                with self.assertRaisesRegex(ValueError,'fixed reviewed checker source path'):c.configure(args)
                self.assertEqual(calls,[])
            healthy()
            for old,requested in (('old-peer',peer_path),('old-config',config_path)):
                mode[0]=old;calls.clear()
                with self.assertRaises(KeyError) as caught:c.configure(args)
                self.assertEqual(caught.exception.args,(requested,))
