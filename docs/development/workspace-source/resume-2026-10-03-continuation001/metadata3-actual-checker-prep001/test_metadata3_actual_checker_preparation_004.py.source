    def test_complete_manifest_and_six_source_closure_refuse_partial_proofs(self):
        c=self.checker;peer,manifest,reader=self.source_peer_fixture()
        with patch.object(c,'selected',lambda path,pin,cap=2097152:manifest),patch.object(c,'read',reader):
            healthy=lambda:self.assertEqual(tuple(c.m3_source_review(peer)),c.M3_SOURCE_NAMES)
            for key,value in (('manifest_payload_count',True),('source_manifest_sha256','9'*64),('post_capture_reference',{}),('findings',['blocking']),('finite_input_count',14)):
