metadata={'schema_version':1,'record_type':'metadata3_checker_corrected008_author_metadata','source_author':'/root/actual_record_checker','selected_checker':{'path':NEW_NAME,'sha256':digest(new),'bytes':len(new)},'prior_checker_sha256':OLD_SHA,'independent_refusal_sha256':REPORT_SHA,'source_only_AST_and_inert_CodeType':True,'source_author_checks_not_independent_approval':True,'functions_unchanged':[k for k,v in old_functions.items() if new_functions.get(k)==v],'functions_changed':[k for k,v in old_functions.items() if new_functions.get(k)!=v],'functions_added':[k for k in new_functions if k not in old_functions],'actual_source_binding':None,'actual_lease':None,'actual_source_peer':None,'actual_ready':None,'actual_before':None,'actual_after':None,'actual_results':None,'helper_or_target_definitions_imports_mains_tests_Git_FFI_PS_native_executed':False}
