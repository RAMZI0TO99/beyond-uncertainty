replace("need(typed_equal(bound['schema_version'],1) and bound['reviewer']=='/root/owner_docs_review'", "need(typed_equal(bound['schema_version'],1) and bound['record_type']=='guard006_root_metadata_bound_source_review' and bound['reviewer']=='/root/owner_docs_review'")

bound_start=text.index("    exact(bound,",text.index('def fixed():'))
bound_end=text.index("    source=selected(INPUTS['preparer_static_review_sha256']",bound_start)
text=text[:bound_start]+"    bound_metadata_review(bound)\n"+text[bound_end:]

start=text.index("    source=selected(INPUTS['preparer_static_review_sha256']",text.index('def fixed():'))
end=text.index("    profile=selected(GUARD/'GUARD_RUNTIME_PROFILE_006-rev003.json'",start)
replacement="""    source=selected(INPUTS['preparer_static_review_sha256'],BINDINGS['preparer_static_review_sha256'])
    templates=m3_source_review(source)
    binding=selected(PREP/'ACTUAL_SOURCE_BINDING_003.json',SOURCE_BINDING,65536)
    exact(binding,('schema_version','binder','template_sha256','actual_script_sha256','bindings','role_selections','exact_six_assignment_reversal','exact_function_ASTs','actual_before_authorization','actual_after_authorization','target_capture_executed'))
    template=templates[M3_SOURCE_NAMES[0]]
    need(typed_equal(binding['schema_version'],1) and binding['binder']=='/root' and binding['template_sha256']==digest(template) and binding['actual_script_sha256']==BOUND
        and typed_equal(binding['bindings'],BINDINGS) and binding['exact_six_assignment_reversal'] is True and binding['exact_function_ASTs'] is True
        and binding['actual_before_authorization'] is None and binding['actual_after_authorization'] is None and binding['target_capture_executed'] is False,'actual source binding11 selected template/source links')
    roles={key:values[key] for key in ('UNIT_TERMINAL_RELATIVE','COORDINATION_PEER_REPLY_RELATIVE','COORDINATION_ROOT_RESPONSE_RELATIVE')}
    need(typed_equal(binding['role_selections'],roles),'exact three source-bound roles')
    replacements=dict(roles,BINDINGS=BINDINGS,OWNER_SHA=OWNER,OWNER_END=OWNER_END_TEXT)
    python_source_reversal(template,read(PREP/'capture-root-metadata003.BOUND.py',BOUND,65536)[0],replacements)
    phases=selected(PREP/'INDEPENDENT_ROOT_METADATA_PHASE_PS_BINDING_REVIEW_003.json',PHASE_REVIEW,65536)
    phase_binding=selected(PREP/'PHASE_PS_SOURCE_BINDING_003.json',PHASE_BINDING,65536)
    exact(phase_binding,('schema_version','binder','actual_script_sha256','bound_review_sha256','actual_authorization','prepared_source_actions_executed','sources'))
    need(typed_equal(phase_binding['schema_version'],1) and phase_binding['binder']=='/root' and phase_binding['actual_script_sha256']==BOUND and phase_binding['bound_review_sha256']==BOUND_REVIEW
        and phase_binding['actual_authorization'] is None and phase_binding['prepared_source_actions_executed'] is False and type(phase_binding['sources']) is list and len(phase_binding['sources'])==4,'phase binding7 exact roles')
    phase_source_review(phases,phase_binding,templates)
"""
text=text[:start]+replacement+text[end:]
helpers=(OWN/'CORRECTED_SOURCE_HELPERS_008.py.source').read_text(encoding='utf8')
marker='\ndef fixed():\n';assert text.count(marker)==1
text=text.replace(marker,'\n'+helpers+'\n\ndef fixed():\n')

# Full WHOLE proof registers membership only after both complete tree identities pass.
for name in ('whole_before_result','whole_after_result'):
    start=text.index('def '+name+'(');end=text.index('\n\ndef ',start+1)
    part=text[start:end]
    assert part.count("    trees={}")==1
    part=part.replace("    trees={}","    trees={};validated_whole_rows=[]")
    part=part.replace("need(first==trees[role+'-second'],'both whole streams equal')","need(typed_equal(first,trees[role+'-second']),'both whole streams exact typed equal')")
    part=part.replace("need(first['identity']==WHOLE_EXPECTED[role]==result['trees'][role],'pinned whole identity')","need(typed_equal(first['identity'],WHOLE_EXPECTED[role]) and typed_equal(result['trees'][role],WHOLE_EXPECTED[role]),'typed pinned whole identity')")
    part=part.replace("        need(raw(root.lstat())==first['root_raw9'],'whole root current metadata')","        exact_raw9(first['root_raw9']);need(typed_equal(raw(root.lstat()),first['root_raw9']),'whole root current metadata')")
    part=part.replace("exact(row,('kind','path','path_raw9'));need(raw(path.lstat())==row['path_raw9'] and stat.S_ISDIR(path.lstat().st_mode),'whole directory')","exact(row,('kind','path','path_raw9'));exact_raw9(row['path_raw9']);need(typed_equal(raw(path.lstat()),row['path_raw9']) and stat.S_ISDIR(path.lstat().st_mode),'whole directory')")
    part=part.replace("current_stream_file(path,row);files+=1", "exact_raw9(row['path_raw9']);exact_raw9(row['descriptor_raw9']);current_stream_file(path,row);validated_whole_rows.append(dict(EVIDENCE[-1]));files+=1")
    part=part.replace("directories[str(root)]=first['root_raw9'];need(directories==first['directory_metadata'],'whole directory map coverage')","directories[str(root)]=first['root_raw9'];need(type(first['directory_metadata']) is dict,'whole directory map type')\n        for key,value in first['directory_metadata'].items():need(type(key) is str,'whole directory map key');exact_raw9(value)\n        need(typed_equal(directories,first['directory_metadata']),'whole directory map exact typed coverage')")
    part=part.replace("need(dict(files=files,directories=dirs,bytes=total,sha256=digest(''.join(lines).encode('utf-8')))==first['identity'],'whole digest reconstruction')","need(typed_equal(dict(files=files,directories=dirs,bytes=total,sha256=digest(''.join(lines).encode('utf-8'))),first['identity']),'whole typed digest reconstruction')")
    part=part.replace("    return dict(whole_before_sha256=", "    register_whole_rows(validated_whole_rows)\n    return dict(whole_before_sha256=")
    assert part.count('register_whole_rows(validated_whole_rows)')==1
    text=text[:start]+part+text[end:]

replace("chain=ancestors(path);pre=path.lstat();a=raw(pre)\n    need(stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and not pre.st_file_attributes&1024\n         and a==row['path_raw9'] and pre.st_size==row['bytes'],'whole emitted file current')", "exact_raw9(row['path_raw9']);exact_raw9(row['descriptor_raw9'])\n    need(type(row['bytes']) is int and 0<=row['bytes']<=67108864,'whole source-approved stream cap')\n    chain=ancestors(path);pre=path.lstat();a=raw(pre)\n    need(stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and not pre.st_file_attributes&1024\n         and typed_equal(a,row['path_raw9']) and pre.st_size==row['bytes'],'whole emitted file current')")
replace("b=raw(os.fstat(stream.fileno()));need(b==row['descriptor_raw9'],'whole descriptor')", "b=raw(os.fstat(stream.fileno()));need(typed_equal(b,row['descriptor_raw9']),'whole descriptor')\n        need(a[:4]+[a[6]]==b[:4]+[b[6]],'whole restricted cross-API dev/ino/size/mtime/nlink identity')")

# Split ticket-independent trust/init/source readiness from phase-specific provenance.
start=text.index('def provenance(role,ticket,trust_pin):')
phase=text.index("    trace_path=PIPELINE/('ROOT_PIPELINE_PHASE_TRACE_'",start)
prefix=text[start:phase].replace('def provenance(role,ticket,trust_pin):','def root_trust_preflight(trust_pin):',1)
prefix+="""    templates=peer['phase_argv_templates'];exact(templates,tuple(PHASES))
    substitutions=set(TICKET_KEYS)|{'metadata_script_sha256','metadata_bound_review_sha256','observer_sha256','profile_sha256','harness_static_review_sha256','owner_lease_sha256'}
    for role,tokens in templates.items():
        need(type(tokens) is list and 1<=len(tokens)<=64,'all eight source-reviewed bounded argv templates')
        for token in tokens:
            need(type(token) is str and len(token)<=4096,'source argv primitive bounds')
            if re.fullmatch(r'\\{[a-z][a-z0-9_]*\\}',token):need(token[1:-1] in substitutions,'closed reviewed argv substitution')
            else:need('{' not in token and '}' not in token,'no arbitrary argv interpolation')
    return trust,source,init,peer


def preflight_ready(trust_pin):
    EVIDENCE.clear();WHOLE_REOBSERVATIONS.clear()
    values,profile=fixed();root_trust_preflight(trust_pin);lease_check()
    EVIDENCE.clear()
    return values,profile


def provenance(role,ticket,trust_pin):
    trust,source,init,peer=root_trust_preflight(trust_pin)
"""
text=text[:start]+prefix+text[phase:]
replace("EVIDENCE.clear();_,profile=fixed()", "EVIDENCE.clear();WHOLE_REOBSERVATIONS.clear();_,profile=fixed()")
start=text.index('    for row in initial:',text.index('def decision('));end=text.index("    now=datetime.now",start)
text=text[:start]+"    final_reobserve(initial,profile)\n"+text[end:]
replace("need(read(stage,digest(data),cap)[0]==data,'staged complete readback before publication')", "need(own_output_read(stage,digest(data),cap)==data,'staged complete readback before publication')")
replace("fresh=read(path,digest(data),cap)[0];need(fresh==data,'own exact emitted readback')", "fresh=own_output_read(path,digest(data),cap);need(fresh==data,'own exact emitted readback')")
replace("need(type(data) is bytes and len(data)<=cap,'own emitted bounded bytes');absent(path)", "need(type(cap) is int and cap==own_output_cap(path) and type(data) is bytes and len(data)<=cap,'own emitted role-bound bytes');absent(path)")
replace("args=parser.parse_args();configure(args);trust_pin=sha(args.root_trust_sha256)", "args=parser.parse_args();configure(args);trust_pin=sha(args.root_trust_sha256)\n    preflight_ready(trust_pin)")

new=text.encode('utf8');assert len(new)<=262144
new_tree=ast.parse(new,filename=NEW_NAME)
inert=compile(new,NEW_NAME,'exec',dont_inherit=True)
assert inert.co_name=='<module>'
old_tree=ast.parse(old)
old_functions={node.name:ast.dump(node,include_attributes=False) for node in old_tree.body if isinstance(node,ast.FunctionDef)}
new_functions={node.name:ast.dump(node,include_attributes=False) for node in new_tree.body if isinstance(node,ast.FunctionDef)}
assert old_functions['read']==new_functions['read'],'general input8MiB/read/API policy must stay exact'
assert old_functions['typed_equal']==new_functions['typed_equal']
assert "READINESS BEFORE TIMER" not in text
create(NEW_NAME,new)
old_test=(OWN/'test_metadata3_actual_checker_preparation_001.py').read_text(encoding='utf8')
assert digest(old_test.encode('utf8'))=='a07f641887fe854d3003c122ad4f7cf5fd0f1a129fa7ff9825a95f602c75df30'
new_test=old_test.replace('review-metadata3-actual006.TEMPLATE.py',NEW_NAME).replace('isolated_metadata3_checker_source_001','isolated_metadata3_checker_source_002')
assert new_test.count("\n\nif __name__=='__main__':")==1
new_test=new_test.replace("\n\nif __name__=='__main__':","\n"+(OWN/'CORRECTED_TEST_METHODS_002.py.source').read_text(encoding='utf8')+"\n\nif __name__=='__main__':")
test_tree=ast.parse(new_test,filename='test_metadata3_actual_checker_preparation_002.py')
test_code=compile(new_test,'test_metadata3_actual_checker_preparation_002.py','exec',dont_inherit=True)
assert test_code.co_name=='<module>'
test_methods=[node.name for cls in test_tree.body if isinstance(cls,ast.ClassDef) for node in cls.body if isinstance(node,ast.FunctionDef) and node.name.startswith('test_')]
create('test_metadata3_actual_checker_preparation_002.py',new_test.encode('utf8'))
old_config=json.loads((OWN/'ACTUAL_CHECKER_BINDING_001.TEMPLATE.json').read_bytes())
old_config['checker_template_sha256']=digest(new)
create('ACTUAL_CHECKER_BINDING_008.TEMPLATE.json',(json.dumps(old_config,indent=2)+'\n').encode('ascii'))
protocol=json.loads((OWN/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_001.json').read_bytes())
protocol['selected_checker']={'path':NEW_NAME,'sha256':digest(new),'bytes':len(new)}
protocol['record_type']='metadata3_actual_checker_corrected008_source_protocol'
protocol['independent_source007_refusal']={'path':str(ROOT/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_001.json'),'sha256':REPORT_SHA,'blocking_group_count':9}
