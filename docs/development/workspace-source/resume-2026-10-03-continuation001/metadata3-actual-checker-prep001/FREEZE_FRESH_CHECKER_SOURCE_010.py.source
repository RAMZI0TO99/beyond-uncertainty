"""Own metadata/AST freezer only. Never loads or compiles selected code."""
import ast
import hashlib
import json
import os
import stat
import sys
from datetime import datetime, timezone
from pathlib import Path

OWN = Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
WORK = OWN.parent
SELF = OWN / 'FREEZE_FRESH_CHECKER_SOURCE_010.py'
OUT = OWN / 'source010-finite-inputs001'
CAP = 8388608
SCOPE = 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
HELPER = 'review-metadata3-actual006-corrected010.TEMPLATE.py'
HELPER_SHA = '9efa6deb54721a531159545ffa5e4e9bd90606f3dc12d7b0ab6cf5f4af51ee16'
TEST = 'test_metadata3_actual_checker_preparation_004.py'
TEST_SHA = 'daf2d526c1d751e6b10b78d8b421bdd2329b652e3a8cba23a761fcde35931fd9'
OLD_MANIFEST_SHA = '8b296a86c7912141f3e2b880927e515408b7d73994edde6b2bfd7f1676fa0e31'

def sha(data):
    return hashlib.sha256(data).hexdigest()

def raw(info):
    return [info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_mode, info.st_nlink,
            getattr(info, 'st_file_attributes', 0), info.st_birthtime_ns]

def observe(path):
    before = path.lstat()
    assert stat.S_ISREG(before.st_mode) and not stat.S_ISLNK(before.st_mode)
    assert not getattr(before, 'st_file_attributes', 0) & 1024
    assert before.st_nlink == 1 and before.st_size <= CAP
    with path.open('rb') as stream:
        opened = os.fstat(stream.fileno())
        data = stream.read(CAP + 1)
        closed = os.fstat(stream.fileno())
    after = path.lstat()
    pr, dr = raw(before), raw(opened)
    assert pr == raw(after) and dr == raw(closed)
    assert all(type(value) is int for value in pr + dr)
    # Windows path and descriptor modes/ctime differ on genuine files. Keep
    # both complete tuples; cross-API equality is limited to stable identity.
    assert all(pr[index] == dr[index] for index in (0, 1, 2, 3, 6))
    assert len(data) == before.st_size == opened.st_size and len(data) <= CAP
    return data, dict(path=str(path), bytes=len(data), sha256=sha(data),
                      path_raw9=pr, descriptor_raw9=dr)

def once(path, data):
    with path.open('xb') as stream:
        stream.write(data)
    reread, _ = observe(path)
    assert reread == data

def encode(value):
    return (json.dumps(value, indent=2, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')

def functions(tree):
    return {node.name: ast.dump(node, include_attributes=False) for node in tree.body
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))}

def tests(tree):
    return {node.name: ast.dump(node, include_attributes=False)
            for cls in tree.body if isinstance(cls, ast.ClassDef)
            for node in cls.body if isinstance(node, ast.FunctionDef) and node.name.startswith('test_')}

assert sys.version_info[:2] == (3, 13)
assert not OUT.exists()
assert not (OWN / 'AUTHOR_FROZEN_SOURCE_MANIFEST_010.json').exists()

# This is the last permitted editorial correction to the UNFROZEN protocol.
# No helper/test bytes change, and no future selected Source or PASS is made.
protocol_path = OWN / 'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_010.json'
protocol = json.loads(protocol_path.read_bytes())
assert protocol['fresh_source_successor']['generic_reader'].startswith('Distinct Root-choice utility008')
protocol['fresh_source_successor']['generic_reader'] = (
    'Root reported an inherited U007/U008 placeholder regex refusal for digit-bearing sha256 tokens. '
    'U008 remains immutable history, not an accepted fresh reader. Root reported U009 is its '
    'proposal only, and the hard pool20 source-author boundary needs genuine Pub-authored U010. '
    'Root plans choice004 and pipeline TEMPLATE009 binding to the still-uncreated BOUND007; '
    'the author has not selected hashes or different reviews for these planned sources. '
    'Composer template remains exact. '
    'All actual reader/model/Root source pins remain externally selected, None here.')
protocol['fresh_source_successor']['parent_reported_reader_successor_planning'] = dict(
    source='Root collaboration message; planning only, not an authenticated future receipt',
    preserved_utility='008', root_proposal_utility='009', planned_pub_utility='010',
    planned_pipeline_template='009', still_fixed_bound_pipeline='007',
    actual_source_choice004=None, actual_bound_pool=None)
protocol_path.write_bytes(encode(protocol))
handoff = OWN / 'HANDOFF_FROZEN_FRESH_010.md'
text = handoff.read_text(encoding='utf-8')
text = text.replace('Independent utility008 and future binder003/constructor004/table002/selection002 require their own accepted Source/actual relationships;',
    'The preserved utility008 and future Pub utility010/binder003/constructor004/table002/selection002 require separate accepted Source/actual relationships;')
text += ('\nRoot reported a different Source reviewer found U008 inherited U007\'s placeholder regex '
         'refusal for digit-bearing sha256 tokens. U008 is preserved exact history. Root\'s U009 '
         'is a proposal only; the hard pool20 source-author boundary requires genuine Pub-authored '
         'U010. That successor, choice004 and pipeline TEMPLATE009-to-BOUND007 are parent-reported '
         'planning; this freeze does not authenticate their review selection. The never-created BOUND007/config002/peer002/trust002/INIT002 '
         'roles remain fixed. Checker010 already permits digits in its reviewed placeholder grammar. '
         'Neither this note nor a planned successor supplies actual pool, fit or execution authority.\n')
handoff.write_text(text, encoding='utf-8', newline='\n')

old_manifest_bytes, _ = observe(OWN / 'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json')
assert sha(old_manifest_bytes) == OLD_MANIFEST_SHA
old_manifest = json.loads(old_manifest_bytes)
assert old_manifest['payload_count'] == len(old_manifest['payloads']) == 55

fresh_names = [HELPER, TEST, 'ACTUAL_CHECKER_BINDING_010.TEMPLATE.json',
    'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_010.json', 'CHECKER010_LITERAL_DELTA_AND_FRESH_ROLES_001.json',
    'CHECKER010_FRESH_PATH_TEST_PLAN_004.json', 'NEW_FRESH_PATH_CONTROLS_004.txt',
    'AUTHOR_FRESH_CHECKER_SOURCE_010.py', 'AUTHOR_FRESH_TEST_SOURCE_004.py',
    'COMPLETE_SOURCE010_CONTRACT_001.py', SELF.name, handoff.name]
paths = [OWN / row['path'] for row in old_manifest['payloads']]
paths += [OWN / 'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json']
paths += [OWN / name for name in fresh_names]
external = [
    (WORK / 'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_002.json',
     '4a7188b0f44de5ac2b454de0ba6bc0e4a07b1891fa24b23c88e119d0547d4137'),
    (WORK / 'root-pipeline-source-successor-design001/ROOT_SUCCESSOR_SOURCE_CHOICE_002.json',
     '1edf53523771c936c961a3617115a1d5d56af2f3c5bb04380059e4164cb741dc'),
    (WORK / 'root-checker25-runtime-prep001/ROOT_SYNTHETIC_CHECKER25_ACCEPTANCE_001.json', None),
    (WORK / 'root-checker25-runtime-audit001/INDEPENDENT_ACTUAL_CHECKER25_REVIEW_001.json',
     '4b33ac62deb645bf3baf9cc0a74c48b737cc87ea89bab01c2ef83a4b2597ec53'),
]
paths += [path for path, _ in external]
assert len(paths) == len({str(path).casefold() for path in paths})
OUT.mkdir()
rows, content = [], {}
for index, path in enumerate(paths):
    samples = [observe(path) for _ in range(3)]
    assert all(item == samples[0] for item in samples)
    data, record = samples[0]
    relative = f'{index:03d}-{path.name}'
    copy_path = OUT / relative
    once(copy_path, data)
    copy_data, copy_record = observe(copy_path)
    assert copy_data == data
    content[str(path)] = data
    rows.append(dict(input_path=str(path), observations=[sample[1] for sample in samples],
                     owned_copy_path=str(copy_path), owned_copy=copy_record))

for expected in old_manifest['payloads']:
    data = content[str(OWN / expected['path'])]
    assert len(data) == expected['bytes'] and sha(data) == expected['sha256']
for path, pin in external:
    if pin is not None:
        assert sha(content[str(path)]) == pin
new_bytes = content[str(OWN / HELPER)]
new_tests = content[str(OWN / TEST)]
assert len(new_bytes) == 146200 and sha(new_bytes) == HELPER_SHA
assert len(new_tests) == 52200 and sha(new_tests) == TEST_SHA
old_bytes = content[str(OWN / 'review-metadata3-actual006-corrected009.TEMPLATE.py')]
delta = json.loads(content[str(OWN / 'CHECKER010_LITERAL_DELTA_AND_FRESH_ROLES_001.json')])
reversed_bytes = new_bytes
assert sum(row['occurrences'] for row in delta['replacements']) == 10
for row in delta['replacements']:
    assert new_bytes.count(row['selected'].encode()) == row['occurrences']
    assert old_bytes.count(row['original'].encode()) == row['occurrences']
    assert row['original'].encode() not in new_bytes
    reversed_bytes = reversed_bytes.replace(row['selected'].encode(), row['original'].encode())
assert reversed_bytes == old_bytes
old_tree, new_tree = ast.parse(old_bytes), ast.parse(new_bytes)
old_functions, new_functions = functions(old_tree), functions(new_tree)
changed = [name for name in old_functions if old_functions[name] != new_functions[name]]
assert len(old_functions) == len(new_functions) == 69
assert changed == ['configure', 'root_trust_preflight', 'decision']
assert old_functions['main'] == new_functions['main']
nonfunction = lambda tree: [ast.dump(node, include_attributes=False) for node in tree.body
                           if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))]
assert nonfunction(old_tree) == nonfunction(new_tree)
old_tests = tests(ast.parse(content[str(OWN / 'test_metadata3_actual_checker_preparation_003.py')]))
planned_tests = tests(ast.parse(new_tests))
assert len(old_tests) == 25 and len(planned_tests) == 28
assert all(planned_tests[name] == value for name, value in old_tests.items())
for token in (HELPER, HELPER_SHA, 'isolated_metadata3_checker_source_004', 'stream.read(262145)'):
    assert token.encode() in new_tests
config = json.loads(content[str(OWN / 'ACTUAL_CHECKER_BINDING_010.TEMPLATE.json')])
assert len(config) == 18 and config['checker_template_sha256'] == HELPER_SHA
assert config['checker_source_peer_sha256'] is None and config['owner_lease_sha256'] is None
assert config['owner_lease_end_utc'] is None and config['maximum_wait_seconds'] is None
