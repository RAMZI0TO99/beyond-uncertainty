    runtime_acceptance=False, operational_authority=False,
    selected_definitions_imports_compilers_mains_tests_executed=False)
manifest_path = OWN / 'AUTHOR_FROZEN_SOURCE_MANIFEST_010.json'
once(manifest_path, encode(manifest))
print(json.dumps(dict(manifest_path=str(manifest_path), manifest_sha256=sha(manifest_path.read_bytes()),
    manifest_bytes=manifest_path.stat().st_size, payload_count=len(payloads), finite_input_count=len(rows),
    helper_sha256=HELPER_SHA, helper_bytes=len(new_bytes), planned_test_sha256=TEST_SHA,
    planned_test_bytes=len(new_tests), planned_method_count=28, metadata_report_sha256=sha(report_path.read_bytes()),
    selected_execution=False), separators=(',', ':')))
