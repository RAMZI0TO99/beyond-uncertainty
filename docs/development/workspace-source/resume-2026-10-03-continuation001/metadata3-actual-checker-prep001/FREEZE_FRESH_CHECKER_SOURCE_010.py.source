assert config['actual_actions_executed'] is False
assert config['root_pipeline_source']['sha256'] is None
assert config['root_pipeline_source']['source_peer_sha256'] is None
for group in ('metadata_sources', 'phase_sources', 'whole_sources', 'guard_sources'):
    assert all(row['sha256'] is None for row in config[group].values())
assert all(value is None for value in config['metadata_bindings'].values())
assert protocol['selected_planned_tests']['actual_results'] is None
assert protocol['selected_planned_tests']['executed'] is False

for row in rows:
    data, post = observe(Path(row['input_path']))
    assert post == row['observations'][0] and data == content[row['input_path']]
    row['post_read'] = post
    copy_data, copy_post = observe(Path(row['owned_copy_path']))
