    row['owned_copy_post_read'] = copy_post
report = dict(schema_version=1, record_type='metadata3_checker010_finite_author_source_freeze',
    source_author='/root/actual_record_checker', scope=SCOPE,
    created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),
    finite_input_count=len(rows), inputs=rows, predecessor_payload_count=55,
    exact_predecessor_payloads=True, exact_helper_literal_reversal=True,
    helper_function_count=69, changed_functions=changed, exact_remaining_function_count=66,
    actual_main_AST_exact=True, nonfunction_AST_exact=True,
    planned_test_count=28, prior25_test_ASTs_exact=True,
    new_test_names=sorted(set(planned_tests) - set(old_tests)),
    syntax_method='ast.parse only; no CodeType compilation or selected definitions/imports/main/tests',
    historical_source009_test_acceptance_only=True,
    future_pub_utility010_pipeline_template009='Parent-reported planning only; no source acceptance or actual pins',
