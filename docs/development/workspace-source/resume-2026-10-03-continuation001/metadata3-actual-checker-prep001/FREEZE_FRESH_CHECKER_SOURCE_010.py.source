    selected_planned_tests=dict(path=TEST, bytes=len(new_tests), sha256=TEST_SHA,
                                method_count=28, actual_results=None),
    prior_source009_manifest_sha256=OLD_MANIFEST_SHA, predecessor55_payloads_exact=True,
    author_metadata_report=dict(path=report_path.name, bytes=report_path.stat().st_size,
                                sha256=sha(report_path.read_bytes())),
    different_source_review=None, actual_binding=None, actual_nonce=None, actual_root_process=None,
