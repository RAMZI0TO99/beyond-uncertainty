    need(type(result['schema_version']) is int and result['schema_version']==1 and result['record_type']=='consumer_guard_unit006_whole_metadata_result'
         and result['scope']==SCOPE and result['phase']=='after' and result['verdict']=='MATCHES_PINNED_BYTES_METADATA_TWICE'
         and result['observer_sha256']==OBSERVER and result['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and result['profile_sha256']==PROFILE and result['owner_sha256']==OWNER
         and result['runtime_snapshot_sha256']==args.runtime_sha256 and result['context_selection_sha256']==args.context_sha256
         and result['before_record_sha256']==args.before_result_sha256 and result['unit_receipt']==dict(path=str(GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'),sha256=args.driver_finished_sha256) and result['target_execution'] is False
         and result['whole_site_loaded_closure_retained_lock_OS_Job_guaranteed'] is False,'whole19 source and scope')
    stamp(result['captured_utc'],'Py',600)
    runtime=canonical_record(read(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json',args.runtime_sha256,65536)[0])
    need(runtime['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256),'whole original context')
    runtime_check(runtime,profile)
    source_rows=source_projection(profile)
    need(digest(json.dumps(source_rows,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')+b'\n')==result['source_snapshot_sha256'],'whole source snapshot')
    exact(result['trees'],('base','scripts'));need(type(result['observation_files']) is list and len(result['observation_files'])==4,'four row streams')
    trees={}
    expected_paths=[GUARD/'whole-runtime-after'/(role+'-'+suffix+'.json') for role in ('base','scripts') for suffix in ('first','second')]
    for r,p in zip(result['observation_files'],expected_paths):
        exact(r,('path','sha256','bytes'));need(r['path']==str(p) and type(r['bytes']) is int and 0<r['bytes']<=4194304,'row stream role/cap')
        b=read(p,r['sha256'],4194304)[0];need(len(b)==r['bytes'],'row stream byte length');trees[p.stem]=canonical_record(b)
    for role,root in WHOLE_ROOTS.items():
        first=trees[role+'-first'];need(first==trees[role+'-second'],'both whole streams equal')
        exact(first,('root','identity','rows','root_raw9','directory_metadata'));need(first['root']==str(root),'fixed whole root')
        need(first['identity']==WHOLE_EXPECTED[role]==result['trees'][role],'pinned whole identity')
        need(type(first['rows']) is list and len(first['rows'])<=6000 and type(first['root_raw9']) is list
             and len(first['root_raw9'])==9 and all(type(v) is int for v in first['root_raw9']),'whole shape')
        need(raw(root.lstat())==first['root_raw9'],'whole root current metadata')
        paths=[];lines=[];files=dirs=total=0;directories={}
        for row in first['rows']:
            need(type(row) is dict and type(row.get('path')) is str and len(row['path'])<=399
                 and '\t' not in row['path'] and '\r' not in row['path'] and '\n' not in row['path'],'whole finite row path')
            rel=Path(row['path']);need(not rel.is_absolute() and rel.as_posix()==row['path'] and all(x not in ('','..','.') and ':' not in x for x in row['path'].split('/')),'whole row confinement')
            path=root/rel;paths.append(row['path'])
            if row['kind']=='directory':
                exact(row,('kind','path','path_raw9'));need(raw(path.lstat())==row['path_raw9'] and stat.S_ISDIR(path.lstat().st_mode),'whole directory')
                dirs+=1;lines.append('D\t'+row['path']+'\n');directories[str(path)]=row['path_raw9']
            else:
                exact(row,('kind','path','bytes','sha256','path_raw9','descriptor_raw9'));need(row['kind']=='file' and type(row['bytes']) is int and 0<=row['bytes']<=67108864,'whole file size')
                current_stream_file(path,row);files+=1;total+=row['bytes'];lines.append('F\t'+row['path']+'\t'+str(row['bytes'])+'\t'+row['sha256']+'\n')
        need(paths==sorted(paths,key=lambda v:tuple(int.from_bytes(v.encode('utf-16-le','surrogatepass')[i:i+2],'little') for i in range(0,len(v.encode('utf-16-le','surrogatepass')),2))), 'ordinal stream order')
        need(len(paths)==len(set(v.casefold() for v in paths)),'whole aliases')
        directories[str(root)]=first['root_raw9'];need(directories==first['directory_metadata'],'whole directory map coverage')
        need(dict(files=files,directories=dirs,bytes=total,sha256=digest(''.join(lines).encode('utf-8')))==first['identity'],'whole digest reconstruction')
    return dict(whole_before_sha256=args.sha256,runtime_snapshot_sha256=args.runtime_sha256,context_sha256=args.context_sha256,
                two_inventory_trees=2,four_runtime_files=4,whole_site_loaded_Job_descendant_guarantee=False,
                physical_parent_and_producer_provenance_requires_independent_actual_review=True)


def whole_parent_after(args, result):
    need(args.authorization_sha256 is not None and args.terminal_path is not None and args.terminal_sha256 is not None, 'whole actual Auth/physical terminal required')
    read(PIPELINE/'SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1',WHOLE_AFTER_PARENT,65536)
    auth=canonical_record(read(GUARD/'ROOT_WHOLE_AFTER_AUTHORIZATION_006.json',args.authorization_sha256,65536)[0],"PS")
    exact(auth,WHOLE_AUTH_KEYS)
    need(list(auth)==list(WHOLE_AUTH_KEYS),'PS source WholeAuth15 property order')
    need(type(auth['schema_version']) is int and auth['schema_version']==1 and auth['phase']=='after'
         and auth['record_type']=='consumer_guard_unit006_metadata_observation_authorization' and auth['author']=='/root' and auth['scope']==SCOPE
         and auth['observer_sha256']==OBSERVER and auth['profile_sha256']==PROFILE and auth['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and auth['owner_sha256']==OWNER and auth['before_record_sha256']==args.before_result_sha256 and auth['unit_receipt']==dict(path=str(GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'),sha256=args.driver_finished_sha256), 'whole historical Auth role')
    need(auth['runtime_snapshot']==dict(path=str(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json'),sha256=args.runtime_sha256)
         and auth['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256),'whole original pointer pins')
    created=moment_exact(auth['created_utc'],'PS');expires=moment_exact(auth['expires_utc'],'PS');published=moment_exact(result['captured_utc'],'Py')
    need(created<=published<=expires and expires<=OWNER_END_TICKS and 0<expires-created<=1800,'historical observer inside Auth expiry/owner')
    need(Path(args.terminal_path)==GUARD/'ROOT_WHOLE_AFTER_PARENT_TERMINAL_006.json','whole parent terminal fixed')
    parent=canonical_record(read(Path(args.terminal_path),args.terminal_sha256,65536)[0],"PS")
    exact(parent,WHOLE_PARENT_KEYS)
    need(list(parent)==list(WHOLE_PARENT_KEYS),'PS source WholeParent30 property order')
    need(type(parent['schema_version']) is int and parent['schema_version']==1 and parent['phase']=='after'
         and type(parent['exit_code']) is int and parent['exit_code']==0 and parent['failure'] is None
         and parent['authorization_sha256']==args.authorization_sha256 and parent['supervisor_sha256']==WHOLE_AFTER_PARENT
         and parent['observer_sha256']==OBSERVER and parent['profile_sha256']==PROFILE
         and parent['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256'],'whole physical terminal role')
    for k in ('capture_drain_complete','direct_child_reaped','metadata_only','spent'):need(parent[k] is True,'whole parent positive flag')
    for k in ('timed_out','capture_overflow','observer_result_reconciled','whole_site_loaded_closure_guaranteed','target_tests_executed',
              'operational_authority_granted','native_authority_granted','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound',
              'unconditional_physical_IO_deadline_guaranteed'):need(parent[k] is False,'whole parent negative flag')
    need(type(parent['expected_inventory_trees']) is int and parent['expected_inventory_trees']==2
         and type(parent['expected_runtime_file_guards']) is int and parent['expected_runtime_file_guards']==4
         and parent['whole_inventory_trees_observed'] is None and parent['runtime_file_guards_observed'] is None,'whole parent expected not accepted counts')
    need(moment_exact(parent['finished_utc'],'PS')>=published,'whole physical completion order')
    for k,filename in (('stdout_bytes','ROOT_WHOLE_AFTER_PARENT_STDOUT_006.txt'),('stderr_bytes','ROOT_WHOLE_AFTER_PARENT_STDERR_006.txt')):
        need(type(parent[k]) is int and 0<=parent[k]<=65536 and len(read(GUARD/filename,cap=65536)[0])==parent[k],'whole capture count')


def finite_unit_record(data, duration_key, maximum):
    # Only the actual child duration field admits finite IEEE floats; other metadata stays integer-only.
    import math
    def pairs(items):
        answer={}
        for k,v in items:need(k not in answer,'unit duplicate key');answer[k]=v
        return answer
    def invalid(value):raise ValueError('unit nonfinite token: '+value)
    need(not data.startswith(b'\xef\xbb\xbf'),'unit BOM')
    obj=json.loads(data.decode('utf8','strict'),object_pairs_hook=pairs,parse_constant=invalid)
    need(type(obj) is dict and type(obj.get(duration_key)) is float and math.isfinite(obj[duration_key])
         and 0<=obj[duration_key]<=maximum,'actual finite unit duration')
    def no_other_float(value,path=()):
        if type(value) is float:need(path==(duration_key,),'float outside actual duration role')
        elif type(value) is dict:
            for k,v in value.items():no_other_float(v,path+(k,))
        elif type(value) is list:
            for i,v in enumerate(value):no_other_float(v,path+(i,))
    no_other_float(obj)
    need((json.dumps(obj,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')==data,'canonical unit record')
    return obj


def original_before(args,profile):
    runtime=canonical_record(read(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json',args.runtime_sha256,65536)[0])
    context=canonical_record(read(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json',args.context_sha256,1048576)[0])
    need(runtime['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256)
         and runtime['captured_utc']==context['captured_utc'],'original before relationship')
    runtime_check(runtime,profile)
    remaining=Decimal(600)-(now_exact()-moment_exact(context['captured_utc'],'Py'))
    need(remaining>=0,'original before context expired; no after substitution')
    return runtime,context,remaining


def actual_unit(args,profile):
    # This validates recorded first-use outcomes, not permission to launch or rerun them.
    read(GUARD/'run-consumer-guard-unit006-rev003.bound.py',DRIVER,65536)
    read(GUARD/'consumer-guard-child-006-rev003.TEMPLATE.py',CHILD,65536)
    ack=canonical_record(read(GUARD/'ROOT_EXECUTION_ACK_GUARD_UNIT006.json',args.root_ack_sha256,65536)[0],'PS')
    exact(ack,ROOT_ACK_KEYS)
    need(list(ack)==list(ROOT_ACK_KEYS),'PS source Root ACK22 property order')
    need(type(ack['schema_version']) is int and ack['schema_version']==1 and ack['record_type']=='consumer_guard_unit006_first_run_ack'
         and ack['decision']=='execute_copied_consumer_guard_unit006_once' and ack['scope']==SCOPE
         and ack['author']==ack['executor']=='/root','actual historical Root ACK22')
    common={'driver_sha256':DRIVER,'child_sha256':CHILD,'source_manifest_sha256':BINDINGS['source_manifest_sha256'],
            'source_peer_sha256':CAPSULE_PEER_SHA,'harness_static_review_sha256':BINDINGS['guard_harness_static_review_sha256'],
            'profile_sha256':PROFILE,'source_projection_sha256':BINDINGS['source_projection_sha256'],'owner_sha256':OWNER}
    need(all(ack[k]==v for k,v in common.items()),'actual Root ACK source pins')
    for k,v in (('max_collection_seconds',60),('max_test_seconds',300)):need(type(ack[k]) is int and ack[k]==v,'actual ACK budget')
    created=moment_exact(ack['created_utc'],'PS');expiry=moment_exact(ack['expires_utc'],'PS')
    need(created<expiry<=OWNER_END_TICKS and expiry-created<=18000,'historical Root ACK interval')
    start=canonical_record(read(GUARD/'ROOT_LAUNCH_START_006.json',cap=65536)[0],'PS');exact(start,UNIT_START_KEYS)
    need(list(start)==list(UNIT_START_KEYS) and type(start['schema_version']) is int and start['schema_version']==1
         and start['scope']==SCOPE and start['root_ack_sha256']==args.root_ack_sha256
         and start['driver_sha256']==DRIVER and start['consumed'] is True,'actual unit Root start')
    terminal=canonical_record(read(GUARD/'ROOT_LAUNCH_TERMINAL_006.json',args.unit_terminal_sha256,65536)[0],'PS');exact(terminal,UNIT_TERMINAL_KEYS)
    need(list(terminal)==list(UNIT_TERMINAL_KEYS) and type(terminal['schema_version']) is int and terminal['schema_version']==1
         and terminal['scope']==SCOPE and type(terminal['exit_code']) is int and terminal['exit_code']==0
         and terminal['failure'] is None and terminal['driver_sha256']==DRIVER
         and terminal['root_ack_sha256']==args.root_ack_sha256,'physical unit terminal18')
    for k in ('capture_drain_complete','direct_driver_reaped','spent'):need(terminal[k] is True,'physical unit positive flag')
    for k in ('timed_out','capture_overflow','canonical_qa_native_fit_authority','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound','automatic_cleanup_performed'):
        need(terminal[k] is False,'physical unit scope negative flag')
    started=moment_exact(start['started_utc'],'PS');finished=moment_exact(terminal['finished_utc'],'PS')
    need(created<=started<=finished<=expiry and finished-started<=451,'physical unit historical first-use interval')
    need(start['launch_sha256']==args.unit_launcher_sha256,'externally pinned physical source')
    launch_bytes=read(GUARD/'ROOT_FIRST_LAUNCH_006-rev003.BOUND.ps1',args.unit_launcher_sha256,65536)[0]
    expected_slots={'BoundDriverSha256':DRIVER,'RootAckSha256':args.root_ack_sha256,'BoundReviewSha256':start['bound_review_sha256']}
    # Pure captured PS text inspection, never parser execution or script invocation.
    text=launch_bytes.decode('utf8','strict')
    for name,pin in expected_slots.items():
        need(re.search(r'^\$'+name+r"\s*=\s*'"+re.escape(pin)+r"'\s*$",text,re.M) is not None,'actual PS source slot')
    bound=canonical_record(read(GUARD/'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json',start['bound_review_sha256'],65536)[0])
    late=canonical_record(read(GUARD/'INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_006.json',start['late_review_sha256'],65536)[0])
    exact(bound,GUARD_BOUND_KEYS);exact(late,GUARD_LATE_KEYS)
    need(bound['reviewer']==BOUND_REVIEWER
         and late['reviewer']==BOUND_REVIEWER
         and bound['verdict']=='PASS_BOUND_STATIC' and late['verdict']=='PASS_LATE_BOUND_ONLY'
         and bound['root_ack_sha256']==late['root_ack_sha256']==args.root_ack_sha256
         and bound['driver_sha256']==late['driver_sha256']==DRIVER,'authentic recorded bound/late scopes')
    for k,filename in (('stdout_bytes','ROOT_LAUNCH_STDOUT_006.txt'),('stderr_bytes','ROOT_LAUNCH_STDERR_006.txt')):
        need(type(terminal[k]) is int and 0<=terminal[k]<=131072 and len(read(GUARD/filename,cap=131072)[0])==terminal[k],'physical unit pipe bytecount')
    receipt=canonical_record(read(RUNS/'finished.json',args.driver_finished_sha256,262144)[0]);exact(receipt,DRIVER_KEYS)
    need(receipt['scope']==SCOPE and receipt['root_ack_sha256']==args.root_ack_sha256 and receipt['profile_sha256']==PROFILE
         and receipt['source_peer_sha256']==CAPSULE_PEER_SHA and receipt['harness_static_peer_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and receipt['whole_before_result_sha256']==args.before_result_sha256 and receipt['driver_sha256']==DRIVER,'driverfinished20 pins')
    for k in ('accepted_copied_guard_units','direct_child_reaped','external_whole_after_acceptance_pending'):need(receipt[k] is True,'driver finished positive flag')
    for k in ('canonical_fullQA_native_fit_authority','hard_Job_OS_sandbox_descendant_cleanup_proved'):need(receipt[k] is False,'driver no broad authority')
    for k in ('collected_methods','passed','reported_subtests','passing_subtests'):need(type(receipt[k]) is int and receipt[k]>=0,'actual driver counts')
    need(receipt['collected_methods']==receipt['passed']==24 and receipt['reported_subtests']==receipt['passing_subtests'],'actual24 and subtest counts')
    need(type(receipt['evidence_initial']) is list and receipt['evidence_initial']==receipt['evidence_final'],'driver paired evidence')
    need(len({r['path'].casefold() for r in receipt['evidence_initial']})==len(receipt['evidence_initial']),'driver evidence aliases')
    closed_driver_evidence(args,profile,ack,receipt['evidence_initial'])
    for row in receipt['evidence_initial']:
        need(Path(row['path']).is_relative_to(WORK),'driver evidence finite WORK confinement')
        rowcheck(row,Path(row['path']),2097152)
    wire=canonical_record(read(RUNS/'stdout.txt',cap=131072)[0]);exact(wire,('result_sha256','collection_sha256','transcript_sha256','profile_sha256','child_sha256','root_ack_sha256'))
    need(wire['result_sha256']==receipt['result_sha256'] and wire['collection_sha256']==receipt['collection_sha256']
         and wire['profile_sha256']==PROFILE and wire['child_sha256']==CHILD and wire['root_ack_sha256']==args.root_ack_sha256,'owned child wire pins')
    collection=finite_unit_record(read(RUNS/'collection.json',wire['collection_sha256'],262144)[0],'collection_elapsed_seconds',60);exact(collection,COLLECTION_KEYS)
    result=finite_unit_record(read(RUNS/'result.json',wire['result_sha256'],262144)[0],'elapsed_test_seconds',300);exact(result,UNIT_RESULT_KEYS)
    ids=collection['ordered_ids'];expected_ids=profile['prepared_full_ids']
    need(type(ids) is list and all(type(v) is str for v in ids) and len(ids)==len(set(ids))==24 and ids==expected_ids,'actual exact namespace/class/ordered24 method IDs')
    encoded_ids=(json.dumps(ids,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
    need(collection['ordered_ids_sha256']==result['ordered_ids_sha256']==digest(encoded_ids),'actual ordered IDs digest')
    need(collection['scope']==result['scope']==SCOPE and collection['profile_sha256']==result['profile_sha256']==PROFILE
         and collection['child_sha256']==CHILD and collection['root_ack_sha256']==result['root_ack_sha256']==args.root_ack_sha256
         and result['source_peer_sha256']==CAPSULE_PEER_SHA and result['accepted'] is True,'actual child scope/source')
    for k in ('collected_methods','tests_run','passed','skipped','failures','errors','reported_subtests','passing_subtests'):
        need(type(result[k]) is int and result[k]>=0,'actual unittest count type')
    need(type(collection['collected_methods']) is int and collection['collected_methods']==result['collected_methods']==result['tests_run']==result['passed']==24
         and result['skipped']==result['failures']==result['errors']==0,'actual unittest14 success/zero skip-failure-error')
    for k in ('private_raw_namespaces_restored','import_path_state_restored','owned_test_namespace_removed'):need(result[k] is True,'actual restoration flag')
    for k in ('native_fit_Git_fullQA','OS_sandbox_hard_Job_memory_descendant_cleanup_proved'):need(result[k] is False,'actual child no broad authority')
    need(result['forbidden_project_or_thirdparty_modules']==[] and result['import_state_before']==result['import_state_after'],'actual imports restored')
    need(type(result['methods']) is list and len(result['methods'])==24,'actual methods count')
    for row,id in zip(result['methods'],ids):exact(row,('id','status'));need(row==dict(id=id,status='passed'),'actual method healthy')
    events,diagnostics=event_streams(result)
    need(type(events) is list and len(events)<=4096,'actual finite events')
    starts=[];successes=[];subtests=[];active=None
    for event in events:
        need(type(event) is dict,'event shape')
        if event.get('event')=='start':
            exact(event,('event','id'));need(active is None and event['id']==ids[len(starts)],'ordered actual start');active=event['id'];starts.append(active)
        elif event.get('event')=='success':
            exact(event,('event','id'));need(event['id']==active,'actual success parent');successes.append(active);active=None
        else:
            exact(event,('event','parent_id','id','status','diagnostic'));need(event['diagnostic'] is None,'healthy subtest no diagnostic');need(event['event']=='subtest' and event['parent_id']==active
                and type(event['id']) is str and event['status']=='passed','actual subtest parent/healthy');subtests.append(event)
    need(active is None and starts==successes==ids and len(subtests)==result['reported_subtests']==result['passing_subtests']==receipt['reported_subtests'],'actual sequential method/subtest reconciliation')
    transcript=read(RUNS/'transcript.txt',wire['transcript_sha256'],262144)[0]
    need(result['transcript_sha256']==wire['transcript_sha256'] and transcript.decode('utf8','strict'),'actual transcript pin/UTF8')
    need(result['sources_initial']==result['sources_final']==source_projection(profile),'actual child source pairs')
    return receipt,terminal



def whole_bridge(args,profile):
    receipt,terminal=actual_unit(args,profile)
    copy=GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'
    copied=read(copy,args.driver_finished_sha256,262144)[0]
    original=read(RUNS/'finished.json',args.driver_finished_sha256,262144)[0]
    need(copied==original,'same-byte WORK bridge')
    provenance=canonical_record(read(GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_PROVENANCE_006.json',args.bridge_provenance_sha256,65536)[0],'PS');exact(provenance,COPY_KEYS)
    need(list(provenance)==list(COPY_KEYS) and type(provenance['schema_version']) is int and provenance['schema_version']==1
         and provenance['record_type']=='root_guard006_driver_scoped_finished_receipt_copy' and provenance['author']=='/root' and provenance['scope']==SCOPE
         and provenance['source_path']==str(RUNS/'finished.json') and provenance['copy_path']==str(copy)
         and provenance['sha256']==args.driver_finished_sha256 and type(provenance['bytes']) is int and provenance['bytes']==len(copied)
         and provenance['producer_sha256']==WHOLE_AFTER_WRITER and provenance['physical_root_unit_terminal_sha256']==args.unit_terminal_sha256
         and provenance['whole_before_result_sha256']==args.before_result_sha256 and provenance['byte_identical_copy'] is True
         and provenance['canonical_fullQA_native_fit_authority'] is False and provenance['target_execution_performed'] is False,'bridge15 exact source/provenance')
    read(PREP/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.ps1',WHOLE_AFTER_WRITER,65536)
    need(moment_exact(provenance['created_utc'],'PS')>=moment_exact(terminal['finished_utc'],'PS'),'copy after physical unit')
    return receipt


def whole_after_auth(args,profile,require_fresh=True):
    need(Path(args.path)==GUARD/'ROOT_WHOLE_AFTER_AUTHORIZATION_006.json','fixed whole-after Auth15')
    auth=canonical_record(read(Path(args.path),args.sha256,65536)[0],'PS');exact(auth,WHOLE_AUTH_KEYS)
    need(list(auth)==list(WHOLE_AUTH_KEYS) and type(auth['schema_version']) is int and auth['schema_version']==1
         and auth['record_type']=='consumer_guard_unit006_metadata_observation_authorization' and auth['author']=='/root' and auth['scope']==SCOPE
         and auth['phase']=='after' and auth['observer_sha256']==OBSERVER and auth['profile_sha256']==PROFILE
         and auth['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256'] and auth['owner_sha256']==OWNER
         and auth['before_record_sha256']==args.before_result_sha256
         and auth['unit_receipt']==dict(path=str(GUARD/'ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006.json'),sha256=args.driver_finished_sha256),'whole-after Auth15 exact pins')
    before=canonical_record(read(GUARD/'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json',args.before_authorization_sha256,65536)[0],'PS');exact(before,WHOLE_AUTH_KEYS)
    need(list(before)==list(WHOLE_AUTH_KEYS) and before['phase']=='before' and before['before_record_sha256'] is None and before['unit_receipt'] is None
         and auth['runtime_snapshot']==before['runtime_snapshot']==dict(path=str(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json'),sha256=args.runtime_sha256)
         and auth['context_selection']==before['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256),'whole AFTER preserves ORIGINAL before pointers')
    _,_,remaining=original_before(args,profile)
    created=moment_exact(auth['created_utc'],'PS');expiry=moment_exact(auth['expires_utc'],'PS');now=now_exact()
    need(created<expiry<=OWNER_END_TICKS and expiry-created<=1800,'whole-after historical interval')
    if require_fresh:need(0<=now-created<=600 and expiry-now>=315 and OWNER_END_TICKS-now>=350,'whole-after fresh owner/reserves')
    whole_bridge(args,profile)
    if require_fresh:absent(GUARD/'whole-runtime-after')
    return dict(whole_after_auth_sha256=args.sha256,original_context_remaining_seconds=str(remaining),two_inventory_trees_not_observed_by_Auth=True)


def metadata_after_authorization(args,profile,require_fresh=True):
    # Reuse exact Auth17 nominal/source checks, but parse physical UNIT PS18 in its actual role.
    path=PREP/'ROOT_METADATA_AUTHORIZATION_AFTER_003.json'
    need(Path(args.path)==path,'fixed metadata-after Auth17')
    auth=canonical_record(read(path,args.sha256,65536)[0],'PS');exact(auth,AUTH_KEYS)
    need(list(auth)==list(AUTH_KEYS) and type(auth['schema_version']) is int and auth['schema_version']==1
         and auth['record_type']=='root_guard006_metadata_phase_authorization' and auth['author']=='/root'
         and auth['decision']=='capture_current_metadata_once' and auth['phase']=='after' and auth['scope']==SCOPE,'metadata-after Auth17 nominal')
    expected=dict(owner_sha256=OWNER,owner_end_utc=OWNER_END_TEXT,script_sha256=BOUND,bound_review_sha256=BOUND_REVIEW,
        profile_sha256=PROFILE,source_projection_sha256=BINDINGS['source_projection_sha256'],coordination_peer_reply_sha256=BINDINGS['coordination_peer_reply_sha256'],coordination_root_response_sha256=BINDINGS['coordination_root_response_sha256'])
    need(all(type(auth[k]) is str and auth[k]==v for k,v in expected.items()),'metadata-after Auth17 exact source/owner')
    need(auth['before_capture']==dict(path=str(PREP/'phase-before-003/METADATA_CAPTURE_003.json'),sha256=args.before_capture_sha256)
         and auth['unit_terminal']==dict(path=str(GUARD/'ROOT_LAUNCH_TERMINAL_006.json'),sha256=args.unit_terminal_sha256),'metadata-after actual prerequisites')
    stamp(auth['created_utc'],'PS',600 if require_fresh else None)
    if require_fresh:need(OWNER_END_TICKS-now_exact()>=350,'metadata-after owner reserve');absent(PREP/'phase-after-003')
    actual_unit(args,profile);original_before(args,profile)
    return auth


def after_whole_compare(args,profile):
    result=whole_after_result(args,profile)
    before=canonical_record(read(GUARD/'whole-runtime-before/result.json',args.before_result_sha256,262144)[0]);exact(before,WHOLE_RESULT_KEYS)
    current=canonical_record(read(GUARD/'whole-runtime-after/result.json',args.sha256,262144)[0]);exact(current,WHOLE_RESULT_KEYS)
    need(before['phase']=='before' and before['runtime_snapshot_sha256']==current['runtime_snapshot_sha256']==args.runtime_sha256
         and before['context_selection_sha256']==current['context_selection_sha256']==args.context_sha256
         and before['source_snapshot_sha256']==current['source_snapshot_sha256'] and before['trees']==current['trees'],'whole before-after source/trees relationship')
    for old,new in zip(before['observation_files'],current['observation_files']):
        need(read(Path(old['path']),old['sha256'],4194304)[0]==read(Path(new['path']),new['sha256'],4194304)[0],'whole AFTER byte/raw9 tables identical to before')
    need(moment_exact(current['captured_utc'],'Py')>=moment_exact(before['captured_utc'],'Py'),'whole after publication order')
    whole_bridge(args,profile)
    return result


def after_capture_compare(args,profile):
    result=capture_after(args,profile)
    after=canonical_record(read(PREP/'phase-after-003/METADATA_CAPTURE_003.json',args.sha256)[0])
    before=canonical_record(read(PREP/'phase-before-003/METADATA_CAPTURE_003.json',args.before_capture_sha256)[0])
    exact(before,tuple(after))
    need(before['phase']=='before' and before['metadata_only'] is True and before['operational_authority_granted'] is False,'actual metadata-before role')
    oldruntime,oldcontext,remaining=original_before(args,profile)
    newruntime=pointer(after['runtime_selection'],PREP/'phase-after-003/RUNTIME4_METADATA_SELECTION_003.json',65536)
    newcontext=pointer(after['context'],PREP/'phase-after-003/OPAQUE_CURRENT_CONTEXT_003.json',1048576)
    need(before['runtime_selection']['sha256']==args.runtime_sha256 and before['context']['sha256']==args.context_sha256,'original metadata capture pins')
    need(all(oldcontext[k]==newcontext[k] for k in ('head','tracked_rows','git_metadata','configurations'))
         and oldruntime['entries']==newruntime['entries'],'metadata AFTER own context plus unchanged before full742/config/runtime4')
    need(moment_exact(after['captured_utc'],'Py')>=moment_exact(before['captured_utc'],'Py'),'metadata AFTER publication order')
    result.update(original_context_remaining_seconds=str(remaining),own_after_context_sha256=after['context']['sha256'],own_after_runtime_sha256=after['runtime_selection']['sha256'])
    return result



def sha(value):
    need(type(value) is str and re.fullmatch('[0-9a-f]{64}',value),'exact external SHA nominal')
    return value


def typed_equal(left,right):
    if type(left) is not type(right):return False
    if type(left) is dict:
        return set(left)==set(right) and all(typed_equal(left[k],right[k]) for k in left)
    if type(left) is list or type(left) is tuple:
        return len(left)==len(right) and all(typed_equal(a,b) for a,b in zip(left,right))
    return (type(left) is str or type(left) is int or type(left) is bool or type(left) is type(None)) and left==right


def selected(path,pin,cap=2097152,role='Py'):
    data=read(path,sha(pin),cap)[0]
    return canonical_record(data,'PS') if role=='PS' else decode(data)


def lease_check():
    lease=selected(WORK/'EXECUTION_LEASE_GG6_M3_001.json',OWNER,65536,'PS')
    exact(lease,LEASE_KEYS);need(list(lease)==list(LEASE_KEYS),'lease exact12 ordered PS keys')
    expected=dict(schema_version=1,record_type='root_local_private_execution_lease',author='/root',scope=SCOPE,
                  owner_master_sha256=MASTER_SHA,owner_review_sha256=MASTER_PEER_SHA,
                  decision='authorize_bounded_selected_unit_metadata_and_copied_tests_once',maximum_lease_seconds=43200,
                  lease_is_owner_deadline=False,operational_authority=False)
    need(all(typed_equal(lease[k],v) for k,v in expected.items()),'finite lease nominal/master/authority')
    a=moment_exact(lease['created_utc'],'PS');b=moment_exact(lease['lease_end_utc'],'PS')
    need(0<b-a<=43200 and a<=now_exact()<b and lease['lease_end_utc']==OWNER_END_TEXT,'finite selected lease unchanged')
    master=selected(WORK/'OWNER_CONTINUATION_20261003_001.json',MASTER_SHA,65536)
    peer=selected(WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json',MASTER_PEER_SHA,262144)
    need(master['work_end_utc'] is None and master['fixed_deadline_invented'] is False,'ongoing master carries no deadline')
    need(type(peer.get('reviewer')) is str and peer['reviewer']=='owner_docs_review','exact genuine SHA-known owner reviewer short nominal')
    return lease


def configure(args):
    global CONFIG,OWNER,OWNER_END,OWNER_END_TEXT,OWNER_END_TICKS,BOUND,BOUND_REVIEW,PROFILE,PHASE_REVIEW,SOURCE_BINDING,PHASE_BINDING
    global BEFORE_PARENT,AFTER_PARENT,WHOLE_BEFORE_PARENT,WHOLE_AFTER_PARENT,WHOLE_AFTER_WRITER,OBSERVER,DRIVER,CHILD,BINDINGS,INPUTS
    global SELF_SHA,SOURCE_PEER_SHA,BINDING_SHA
    SELF_SHA=sha(args.self_sha256);SOURCE_PEER_SHA=sha(args.source_peer_sha256);BINDING_SHA=sha(args.binding_sha256)
    need(Path(__file__).absolute()==CHECKER/'review-metadata3-actual006.TEMPLATE.py','fixed reviewed checker source path')
    read(Path(__file__),SELF_SHA,262144)
    peer=selected(WORK/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json',SOURCE_PEER_SHA,8388608)
    need(type(peer.get('reviewer')) is str and peer['reviewer'] in ('/root','/root/owner_docs_review')
         and peer.get('source_author')==REVIEWER and peer.get('verdict')=='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY'
         and peer.get('checker_template_sha256')==SELF_SHA,'different externally selected checker source peer')
    CONFIG=selected(CHECKER/'ACTUAL_CHECKER_BINDING_001.json',BINDING_SHA,131072)
    exact(CONFIG,('schema_version','record_type','binder','checker_template_sha256','checker_source_peer_sha256','metadata_bindings',
                  'metadata_sources','metadata_input_paths','phase_sources','whole_sources','guard_sources','owner_lease_sha256',
                  'owner_lease_end_utc','root_pipeline_source','execution_launch_witness','actual_actions_executed','scope','maximum_wait_seconds'))
    need(typed_equal(CONFIG['schema_version'],1) and CONFIG['record_type']=='metadata3_actual_checker_binding'
         and CONFIG['binder']=='/root' and CONFIG['scope']==SCOPE and CONFIG['actual_actions_executed'] is False
         and CONFIG['checker_template_sha256']==SELF_SHA and CONFIG['checker_source_peer_sha256']==SOURCE_PEER_SHA,'binding closed source-only provenance')
    need(type(CONFIG['maximum_wait_seconds']) is int and 1<=CONFIG['maximum_wait_seconds']<=3600,'retained bounded wait')
    OWNER=sha(CONFIG['owner_lease_sha256']);OWNER_END_TEXT=CONFIG['owner_lease_end_utc']
    OWNER_END_TICKS=moment_exact(OWNER_END_TEXT,'PS');OWNER_END=stamp(OWNER_END_TEXT,'PS')
    BINDINGS=CONFIG['metadata_bindings']
    exact(BINDINGS,('guard_profile_sha256','source_projection_sha256','raw_source_sha256','source_manifest_sha256','source_peer_sha256',
                    'guard_harness_static_review_sha256','preparer_static_review_sha256','coordination_peer_reply_sha256','coordination_root_response_sha256'))
    for value in BINDINGS.values():sha(value)
    PROFILE=BINDINGS['guard_profile_sha256']
    sources=CONFIG['metadata_sources']
    exact(sources,('metadata_script','metadata_source_binding','metadata_bound_review','phase_source_binding','phase_source_review'))
    paths={'metadata_script':PREP/'capture-root-metadata003.BOUND.py','metadata_source_binding':PREP/'ACTUAL_SOURCE_BINDING_003.json',
           'metadata_bound_review':PREP/'INDEPENDENT_BOUND_METADATA_REVIEW_003.json','phase_source_binding':PREP/'PHASE_PS_SOURCE_BINDING_003.json',
           'phase_source_review':PREP/'INDEPENDENT_ROOT_METADATA_PHASE_PS_BINDING_REVIEW_003.json'}
    for key,path in paths.items():
        exact(sources[key],('path','sha256'));need(type(sources[key]['path']) is str and Path(sources[key]['path'])==path,'fixed closure source path')
        read(path,sha(sources[key]['sha256']),2097152)
    BOUND=sources['metadata_script']['sha256'];SOURCE_BINDING=sources['metadata_source_binding']['sha256']
    BOUND_REVIEW=sources['metadata_bound_review']['sha256'];PHASE_BINDING=sources['phase_source_binding']['sha256'];PHASE_REVIEW=sources['phase_source_review']['sha256']
    phases=CONFIG['phase_sources'];exact(phases,('before_writer','before_parent','after_writer','after_parent'))
    for key,filename in (('before_writer','WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_003.BOUND.ps1'),('before_parent','SUPERVISE_ROOT_METADATA_BEFORE_003.BOUND.ps1'),
                         ('after_writer','WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_003.BOUND.ps1'),('after_parent','SUPERVISE_ROOT_METADATA_AFTER_003.BOUND.ps1')):
        exact(phases[key],('path','sha256'));need(Path(phases[key]['path'])==PREP/filename,'fixed four PS source roles');read(PREP/filename,sha(phases[key]['sha256']),65536)
    BEFORE_PARENT=phases['before_parent']['sha256'];AFTER_PARENT=phases['after_parent']['sha256']
    whole=CONFIG['whole_sources'];exact(whole,('before_parent','after_writer','after_parent'))
    for key,filename in (('before_parent','SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1'),('after_writer','WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1'),
                         ('after_parent','SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1')):
        exact(whole[key],('path','sha256'));need(Path(whole[key]['path'])==PIPELINE/filename,'fixed Root whole source role');read(PIPELINE/filename,sha(whole[key]['sha256']),65536)
    WHOLE_BEFORE_PARENT=whole['before_parent']['sha256'];WHOLE_AFTER_WRITER=whole['after_writer']['sha256'];WHOLE_AFTER_PARENT=whole['after_parent']['sha256']
    guard=CONFIG['guard_sources'];exact(guard,('driver','child','observer'))
    for key,name in (('driver','run-consumer-guard-unit006-rev003.bound.py'),('child','consumer-guard-child-006-rev003.TEMPLATE.py'),('observer','observe-whole-runtime-006-rev003.BOUND.py')):
        exact(guard[key],('path','sha256'));need(Path(guard[key]['path'])==GUARD/name,'fixed GG6 source role');read(GUARD/name,sha(guard[key]['sha256']),131072)
    DRIVER=guard['driver']['sha256'];CHILD=guard['child']['sha256'];OBSERVER=guard['observer']['sha256']
    input_paths=CONFIG['metadata_input_paths']
    expected_keys=('source_projection_sha256','raw_source_sha256','source_manifest_sha256','source_peer_sha256','guard_harness_static_review_sha256',
                   'preparer_static_review_sha256','coordination_peer_reply_sha256','coordination_root_response_sha256')
    exact(input_paths,expected_keys);INPUTS={}
    # These exact paths must also match the authenticated metadata source's INPUTS literal map in fixed().
    for key in expected_keys:
        need(type(input_paths[key]) is str,'input literal path string');path=Path(input_paths[key])
        need(path.is_absolute() and (path.is_relative_to(WORK) or path.is_relative_to(PROJECT/'resume-2026-10-01-30h-001')),'finite source input roots')
        INPUTS[key]=path;read(path,BINDINGS[key],2097152)
    fixed_inputs={'source_projection_sha256':GUARD/'SOURCE_INPUTS_PROJECTION_006.json','raw_source_sha256':GUARD/'inputs/raw004-source.bytes',
                  'source_manifest_sha256':GUARD/'inputs/SOURCE_STAGED_MANIFEST_005.json','source_peer_sha256':GUARD/'inputs/ACTUAL_SOURCE_CAPSULE_005.json',
                  'guard_harness_static_review_sha256':GUARD/'INDEPENDENT_GUARD_RUNTIME_STATIC_REVIEW_006.json',
                  'preparer_static_review_sha256':WORK/'m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json'}
    need(all(INPUTS[key]==path for key,path in fixed_inputs.items()),'source-reviewed fixed immutable input leaf names')
    need(len({str(path).casefold() for path in INPUTS.values()})==len(INPUTS),'input source path aliases')
    lease_check()
    launch=CONFIG['execution_launch_witness']
    exact(launch,('reviewer','nonce','tool_trace_kind'));need(launch['reviewer']==REVIEWER and type(launch['nonce']) is str
        and re.fullmatch('[0-9a-f]{32}',launch['nonce']) and launch['nonce']==args.execution_nonce
        and launch['tool_trace_kind']=='EXTERNALLY_CORROBORATED_REVIEWER_TOOL_CELL_NOT_OS_ATTESTATION','selected reviewer invocation witness')


def fixed():
    lease_check()
    values=literals(read(PREP/'capture-root-metadata003.BOUND.py',BOUND,65536)[0])
    need(typed_equal(values['BINDINGS'],BINDINGS) and values['UNIT_TERMINAL_RELATIVE']=='ROOT_LAUNCH_TERMINAL_006.json'
        and values['OWNER_SHA']==OWNER and values['OWNER_END']==OWNER_END_TEXT,'actual M3 literals owner and complete9 source pins')
    need(values['COORDINATION_PEER_REPLY_RELATIVE']==INPUTS['coordination_peer_reply_sha256'].relative_to(WORK).as_posix()
         and values['COORDINATION_ROOT_RESPONSE_RELATIVE']==INPUTS['coordination_root_response_sha256'].relative_to(WORK).as_posix(),'actual coordination roles')
    bound=selected(PREP/'INDEPENDENT_BOUND_METADATA_REVIEW_003.json',BOUND_REVIEW,65536)
    exact(bound,('schema_version','record_type','reviewer','source_author','verdict','actual_script_sha256','source_bindings','phase_set','metadata_only'))
    need(typed_equal(bound['schema_version'],1) and bound['reviewer']=='/root/owner_docs_review' and bound['source_author']=='/root/renewal_runtime_inventory'
        and bound['verdict']=='PASS_STATIC_BOUND_METADATA_ONLY' and bound['actual_script_sha256']==BOUND
        and typed_equal(bound['source_bindings'],BINDINGS) and typed_equal(bound['phase_set'],['before','after']) and bound['metadata_only'] is True,'different bound9 source proof')
    source=selected(INPUTS['preparer_static_review_sha256'],BINDINGS['preparer_static_review_sha256'])
    exact(source,('schema_version','record_type','source_author','reviewer','created_utc','verdict','scope','source_manifest_sha256','manifest_payload_count',
                  'finite_input_count','observations','preserved_inputs','prepublication_observations','syntax_and_inert_metadata','active_source_rows','source_checks',
                  'findings','implementation_conditions','actual_results','runtime_acceptance','operational_authority','post_capture_reference'))
    need(typed_equal(source['schema_version'],1) and source['source_author']=='/root/renewal_runtime_inventory'
         and source['record_type']=='guard006_metadata_successor_source_preparation_review' and source['reviewer']=='/root/owner_docs_review'
         and source['verdict']=='PASS_STATIC_METADATA_PREPARATION_ONLY' and source['scope']==SCOPE
         and source['actual_results'] is None and source['runtime_acceptance'] is False and source['operational_authority'] is False,'different closed22 source preparation peer')
    binding=selected(PREP/'ACTUAL_SOURCE_BINDING_003.json',SOURCE_BINDING,65536)
    exact(binding,('schema_version','binder','template_sha256','actual_script_sha256','bindings','role_selections','exact_six_assignment_reversal',
                  'exact_function_ASTs','actual_before_authorization','actual_after_authorization','target_capture_executed'))
    need(typed_equal(binding['schema_version'],1) and binding['binder']=='/root' and binding['actual_script_sha256']==BOUND
        and typed_equal(binding['bindings'],BINDINGS) and binding['exact_six_assignment_reversal'] is True and binding['exact_function_ASTs'] is True
        and binding['actual_before_authorization'] is None and binding['actual_after_authorization'] is None and binding['target_capture_executed'] is False,'actual source binding11')
    need(typed_equal(binding['role_selections'],{key:values[key] for key in ('UNIT_TERMINAL_RELATIVE','COORDINATION_PEER_REPLY_RELATIVE','COORDINATION_ROOT_RESPONSE_RELATIVE')}),'exact three roles')
    phases=selected(PREP/'INDEPENDENT_ROOT_METADATA_PHASE_PS_BINDING_REVIEW_003.json',PHASE_REVIEW,65536)
    phase_binding=selected(PREP/'PHASE_PS_SOURCE_BINDING_003.json',PHASE_BINDING,65536)
    exact(phase_binding,('schema_version','binder','actual_script_sha256','bound_review_sha256','actual_authorization','prepared_source_actions_executed','sources'))
    need(typed_equal(phase_binding['schema_version'],1) and phase_binding['binder']=='/root' and phase_binding['actual_script_sha256']==BOUND
        and phase_binding['bound_review_sha256']==BOUND_REVIEW and phase_binding['actual_authorization'] is None
        and phase_binding['prepared_source_actions_executed'] is False and type(phase_binding['sources']) is list and len(phase_binding['sources'])==4,'phase binding7')
    need(phases['reviewer']=='/root/owner_docs_review' and phases['verdict']=='PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY'
        and phases['bound_metadata_source_sha256']==BOUND and phases['bound_source_review_sha256']==BOUND_REVIEW
        and phases['phase_source_binding_sha256']==PHASE_BINDING and type(phases['phase_sources']) is list and len(phases['phase_sources'])==4,'different PS source peer')
    expected_order=('before_writer','before_parent','after_writer','after_parent')
    for row,peer,key in zip(phase_binding['sources'],phases['phase_sources'],expected_order):
        exact(row,('path','sha256','template_sha256','exact_two_literal_reversal'))
        need(all(typed_equal(row[k],peer[k]) for k in row) and row['exact_two_literal_reversal'] is True
            and row['path']==CONFIG['phase_sources'][key]['path'] and row['sha256']==CONFIG['phase_sources'][key]['sha256'],'all4PS complete source binding-to-peer relationship')
        text=read(Path(row['path']),row['sha256'],65536)[0].decode('utf8','strict')
        for name,pin in (('BoundScriptSha256',BOUND),('BoundReviewSha256',BOUND_REVIEW)):
            need(re.search(r'^\$'+name+r"\s*=\s*'"+re.escape(pin)+r"'\s*$",text,re.M) is not None,'four actual PS literals match externally pinned source map')
    profile=selected(GUARD/'GUARD_RUNTIME_PROFILE_006-rev003.json',PROFILE,65536)
    need(profile['scope']==SCOPE and type(profile['prepared_full_ids']) is list and len(profile['prepared_full_ids'])==24,'GG6 exact24 source profile')
    test=profile['test'];exact(test,('path','sha256','bytes'))
    need(test['path']=='test_raw_consumer_guards_005.TEMPLATE.py' and test['sha256']=='e5c17197561357dd9826a76f1d8f18a7a02306fe8235b455af0aeb32a5bcf7ca'
         and typed_equal(test['bytes'],48580),'exact externally pinned current Source5 test body')
    test_tree=ast.parse(read(GUARD/test['path'],test['sha256'],48580)[0])
    classes=[node for node in test_tree.body if isinstance(node,ast.ClassDef)]
    need([node.name for node in classes]==['RawConsumerGuardRegressions','RawConsumerMetaclassIdentityRegressions'],'two exact direct Source5 siblings')
    names={};ids=[]
    for node in classes:
        need([ast.unparse(base) for base in node.bases]==['unittest.TestCase'] and not node.keywords,'source sibling inheritance')
        names[node.name]=sorted(fn.name for fn in node.body if isinstance(fn,ast.FunctionDef) and fn.name.startswith('test_'))
        ids.extend(CHILD_TEST_NAMESPACE+'.'+node.name+'.'+name for name in names[node.name])
    need([len(names[node.name]) for node in classes]==[19,5] and typed_equal(profile['test_classes'],[node.name for node in classes])
         and typed_equal(profile['prepared_class_method_names'],names) and typed_equal(profile['prepared_full_ids'],ids),'independent source AST exact24 full IDs')
    capsule_peer=selected(CAPSULE_PEER_PATH,CAPSULE_PEER_SHA,131072)
    need(type(capsule_peer.get('reviewer')) is str and capsule_peer['reviewer']=='/root/capsule_design_review','different Source capsule peer selected separately from capsule bytes')
    need(literals(read(GUARD/'run-consumer-guard-unit006-rev003.bound.py',DRIVER,131072)[0])['SOURCE_CAPSULE_PEER_SHA256']==CAPSULE_PEER_SHA,'actual bound driver capsule-peer literal')
    for key,path in INPUTS.items():read(path,BINDINGS[key])
    return values,profile


def source_closure():
    return CONFIG['metadata_sources']


def chunk_stream(manifest,role):
    exact(manifest,('role','chunks','bytes','rows','maximum_chunks','maximum_chunk_bytes','maximum_stream_bytes'))
    need(type(manifest['role']) is str and manifest['role']==role and type(manifest['chunks']) is list and len(manifest['chunks'])<=32
        and type(manifest['bytes']) is int and 0<=manifest['bytes']<=4194304 and type(manifest['rows']) is int
        and 0<=manifest['rows']<=4096,'chunk stream finite nominal/count/bytes')
    need(all(typed_equal(manifest[k],v) for k,v in (('maximum_chunks',32),('maximum_chunk_bytes',131072),('maximum_stream_bytes',4194304))),'fixed chunk cap literals')
    data=bytearray()
    for i,row in enumerate(manifest['chunks']):
        exact(row,('ordinal','path','bytes','sha256'))
        need(type(row['ordinal']) is int and row['ordinal']==i and type(row['path']) is str and row['path']==role+'-'+str(i).zfill(2)+'.bin'
            and type(row['bytes']) is int and 0<row['bytes']<=131072 and len(data)+row['bytes']<=4194304,'chunk finite compiled path/ordinal/size')
        part=read(RUNS/row['path'],sha(row['sha256']),row['bytes'])[0];need(len(part)==row['bytes'],'complete declared chunk size');data.extend(part)
    need(len(data)==manifest['bytes'],'all chunk bytes reconciled')
    if role=='diagnostics':need(manifest['rows']==0,'diagnostics count is bytes not inferred rows');return bytes(data)
    events=[]
    for line in bytes(data).splitlines(keepends=True):
        need(line.endswith(b'\n') and len(line)<=1024 and len(events)<4096,'each canonical event <=1024 LF complete/4096')
        event=canonical_record(line);need(type(event) is dict and type(event.get('event')) is str,'event nominal')
        kind=event['event'];keys={'start':('event','id'),'success':('event','id'),'failure':('event','id','diagnostic'),
           'error':('event','id','diagnostic'),'skip':('event','id','diagnostic'),'subtest':('event','parent_id','id','status','diagnostic')}
        need(kind in keys,'closed event kind');exact(event,keys[kind])
        for key in ('id','parent_id','status'):
            if key in event:need(type(event[key]) is str,'event primitive text')
        if kind=='subtest':need(event['status'] in ('passed','failed'),'finite subtest status')
        if 'diagnostic' in event:
            ref=event['diagnostic'];need(ref is None or type(ref) is dict,'diagnostic pointer type')
            if ref is not None:
                exact(ref,('offset','bytes','sha256'));need(type(ref['offset']) is int and type(ref['bytes']) is int and 0<=ref['offset']<=4194304
                    and 0<=ref['bytes']<=4194304 and ref['offset']+ref['bytes']<=4194304,'diagnostic finite integer range');sha(ref['sha256'])
        events.append(event)
    need(len(events)==manifest['rows'],'all event rows accounted')
    return events


def event_streams(result):
    events_manifest=result['event_manifest'];diagnostic_manifest=result['diagnostic_manifest']
    exact(events_manifest,('role','chunks','bytes','rows','maximum_chunks','maximum_chunk_bytes','maximum_stream_bytes'))
    exact(diagnostic_manifest,tuple(events_manifest))
    need(type(events_manifest['bytes']) is int and type(diagnostic_manifest['bytes']) is int and events_manifest['bytes']>=0 and diagnostic_manifest['bytes']>=0
        and events_manifest['bytes']+diagnostic_manifest['bytes']<=4194304 and type(events_manifest['chunks']) is list and type(diagnostic_manifest['chunks']) is list
        and len(events_manifest['chunks'])+len(diagnostic_manifest['chunks'])<=32,'combined physical evidence caps pre-read')
    events=chunk_stream(events_manifest,'events');diagnostics=chunk_stream(diagnostic_manifest,'diagnostics')
    need(type(result['event_count']) is int and result['event_count']==len(events),'actual complete event count')
    references=[]
    for event in events:
        ref=event.get('diagnostic')
        if ref is not None:
            part=diagnostics[ref['offset']:ref['offset']+ref['bytes']]
            need(len(part)==ref['bytes'] and digest(part)==ref['sha256'],'complete diagnostic byte-linked evidence');references.append(ref)
    # Successful runs have no diagnostic material. Failure diagnostics remain retained, never truncated or represented as a PASS.
    need(not diagnostics and not references,'healthy acceptance contains no diagnostic failure payload')
    return events,diagnostics


def closed_driver_evidence(args,profile,ack,rows):
    need(type(rows) is list and len(rows)==26,'closed exact26 driver evidence roles')
    runtime_path=PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json'
    context_path=PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'
    whole_path=GUARD/'INDEPENDENT_WHOLE_BEFORE_ACCEPTANCE_006.json'
    resource_path=GUARD/'ROOT_RESOURCE_SNAPSHOT_006.json'
    coord_path=GUARD/'ROOT_COORDINATION_ACK_GUARD_UNIT006.json'
    expected={'runtime_snapshot':runtime_path,'whole_runtime_before':whole_path,'resource_snapshot':resource_path,'coordination_acknowledgement':coord_path}
    for key,path in expected.items():
        exact(ack[key],('path','sha256'));need(type(ack[key]['path']) is str and Path(ack[key]['path'])==path,'ACK fixed evidence pointer path');sha(ack[key]['sha256'])
    need(ack['runtime_snapshot']['sha256']==args.runtime_sha256,'ACK original runtime pin')
    start=canonical_record(read(GUARD/'ROOT_LAUNCH_START_006.json',cap=65536)[0],'PS')
    whole=canonical_record(read(GUARD/'whole-runtime-before/result.json',args.before_result_sha256,262144)[0])
    coord=canonical_record(read(coord_path,ack['coordination_acknowledgement']['sha256'],65536)[0])
    exact(coord,('schema_version','scope','created_utc','other_session_acknowledgement','root_response','live_execution_authorized'))
    need(typed_equal(coord['schema_version'],1) and coord['scope']==SCOPE and coord['live_execution_authorized'] is False,'isolated coordination6 type/scope')
    pairs=[(GUARD/'run-consumer-guard-unit006-rev003.bound.py',DRIVER),
           (GUARD/'GUARD_RUNTIME_PROFILE_006-rev003.json',PROFILE),(GUARD/'SOURCE_INPUTS_PROJECTION_006.json',BINDINGS['source_projection_sha256']),
           (GUARD/profile['child']['path'],CHILD),(GUARD/profile['root_supervisor']['path'],profile['root_supervisor']['sha256']),
           (GUARD/profile['whole_observer']['path'],profile['whole_observer']['sha256']),
           (GUARD/'ROOT_EXECUTION_ACK_GUARD_UNIT006.json',args.root_ack_sha256),
           (GUARD/'INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.json',start['bound_review_sha256']),
           (CAPSULE_PEER_PATH,CAPSULE_PEER_SHA),(INPUTS['guard_harness_static_review_sha256'],BINDINGS['guard_harness_static_review_sha256']),
           (runtime_path,args.runtime_sha256),(context_path,args.context_sha256),(whole_path,ack['whole_runtime_before']['sha256']),
           (resource_path,ack['resource_snapshot']['sha256']),(coord_path,ack['coordination_acknowledgement']['sha256']),
           (GUARD/'whole-runtime-before/result.json',args.before_result_sha256)]
    for key,source_key in (('other_session_acknowledgement','coordination_peer_reply_sha256'),('root_response','coordination_root_response_sha256')):
        exact(coord[key],('path','sha256'));need(coord[key]['path']==str(INPUTS[source_key]) and coord[key]['sha256']==BINDINGS[source_key],'coordination sources match metadata source pool')
        pairs.append((INPUTS[source_key],BINDINGS[source_key]))
    need(type(whole['observation_files']) is list and len(whole['observation_files'])==4,'four fixed whole streams in driver role list')
    stream_paths=[GUARD/'whole-runtime-before'/(role+'-'+suffix+'.json') for role in ('base','scripts') for suffix in ('first','second')]
    for row,path in zip(whole['observation_files'],stream_paths):
        exact(row,('path','sha256','bytes'));need(row['path']==str(path),'ordered fixed whole stream role');pairs.append((path,sha(row['sha256'])))
    pairs.extend([(WORK/'OWNER_CONTINUATION_20261003_001.json',MASTER_SHA),
                  (WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json',MASTER_PEER_SHA),
                  (WORK/'EXECUTION_LEASE_GG6_M3_001.json',OWNER)])
    contract=profile['external_canonical_timestamp_role_contract'];exact(contract,('path','sha256','bytes'))
    need(type(contract['path']) is str and '/' not in contract['path'] and '\\' not in contract['path']
         and type(contract['bytes']) is int and 0<contract['bytes']<=65536,'fixed source timestamp contract role')
    pairs.append((GUARD/contract['path'],sha(contract['sha256'])))
    need(len(pairs)==26 and len({str(path).casefold() for path,pin in pairs})==26,'all exact26 driver roles distinct')
    for row,(path,pin) in zip(rows,pairs):
        exact(row,('path','sha256','bytes','path_raw9','descriptor_raw9'))
        need(type(row['path']) is str and row['path']==str(path) and row['sha256']==pin,'exact ordered source-owned evidence26 path/SHA')



def role_path(role):
    return {
      'auth_before':PREP/'ROOT_METADATA_AUTHORIZATION_BEFORE_003.json',
      'capture_before':PREP/'phase-before-003/METADATA_CAPTURE_003.json',
      'whole_before_auth':GUARD/'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json',
      'whole_before_result':GUARD/'whole-runtime-before/result.json',
      'whole_after_auth':GUARD/'ROOT_WHOLE_AFTER_AUTHORIZATION_006.json',
      'whole_after_result':GUARD/'whole-runtime-after/result.json',
      'metadata_after_auth':PREP/'ROOT_METADATA_AUTHORIZATION_AFTER_003.json',
      'metadata_after_capture':PREP/'phase-after-003/METADATA_CAPTURE_003.json',
    }[role]


def provenance(role,ticket,trust_pin):
    trust=selected(PIPELINE/'ROOT_PIPELINE_TRUST_SELECTION_001.json',trust_pin,65536)
    exact(trust,('schema_version','record_type','author','scope','pipeline_source_sha256','pipeline_source_peer_sha256','init_trace','physical_root_tool_chunk'))
    need(typed_equal(trust['schema_version'],1) and trust['record_type']=='root_pipeline_trust_selection' and trust['author']=='/root' and trust['scope']==SCOPE,'external Root trust selection exact nominal')
    need(type(trust['physical_root_tool_chunk']) is str and re.fullmatch('[0-9A-Za-z_-]{1,128}',trust['physical_root_tool_chunk']),'external Root-correlated tool token')
    source=CONFIG['root_pipeline_source'];exact(source,('path','sha256','source_peer_path','source_peer_sha256'))
    need(Path(source['path'])==PIPELINE/'RUN_ROOT_METADATA_PIPELINE_006.BOUND.ps1'
        and Path(source['source_peer_path'])==WORK/'root-pipeline-independent-review001/SOURCE_REVIEW_ROOT_PIPELINE_001.json'
        and source['sha256']==trust['pipeline_source_sha256'] and source['source_peer_sha256']==trust['pipeline_source_peer_sha256'],'Root-selected pipeline source/peer')
    read(Path(source['path']),sha(source['sha256']),131072)
    peer=selected(Path(source['source_peer_path']),source['source_peer_sha256'],8388608)
    need(type(peer.get('reviewer')) is str and peer['reviewer']=='/root/owner_docs_review'
        and peer.get('source_author')=='/root' and peer.get('pipeline_source_sha256')==source['sha256']
        and peer.get('verdict')=='PASS_STATIC_ROOT_PIPELINE_SOURCE_ONLY','different authentic Root source peer')
    exact(trust['init_trace'],('path','sha256'));need(Path(trust['init_trace']['path'])==PIPELINE/'ROOT_PIPELINE_INIT_TRACE_001.json','fixed trusted init path')
    init=selected(PIPELINE/'ROOT_PIPELINE_INIT_TRACE_001.json',trust['init_trace']['sha256'],65536,'PS')
    exact(init,('schema_version','record_type','author','scope','created_utc','pid','nonce','pipeline_source_sha256'))
    need(typed_equal(init['schema_version'],1) and init['record_type']=='root_pipeline_init_trace' and init['author']=='/root'
        and init['scope']==SCOPE and type(init['pid']) is int and init['pid']>0 and type(init['nonce']) is str
        and re.fullmatch('[0-9a-f]{32}',init['nonce']) and init['pipeline_source_sha256']==source['sha256'],'fixed Root init identity consistent with externally selected witness')
    stamp(init['created_utc'],'PS')
    trace_path=PIPELINE/('ROOT_PIPELINE_PHASE_TRACE_'+role.upper()+'_006.json')
    trace=selected(trace_path,ticket['phase_trace_sha256'],65536,'PS')
    exact(trace,('schema_version','record_type','author','scope','phase','created_utc','pipeline_source_sha256','init_trace_sha256','argv','outputs'))
    need(typed_equal(trace['schema_version'],1) and trace['record_type']=='root_pipeline_phase_trace' and trace['author']=='/root'
        and trace['scope']==SCOPE and trace['phase']==role and trace['pipeline_source_sha256']==source['sha256']
        and trace['init_trace_sha256']==trust['init_trace']['sha256'],'phase trace source/init/role')
    need(moment_exact(init['created_utc'],'PS')<=moment_exact(trace['created_utc'],'PS')<=now_exact(),'physical trace chronological order')
    templates=peer['phase_argv_templates'];exact(templates,tuple(PHASES))
    expected=[]
    substitutions={k:str(v) for k,v in ticket.items() if type(v) is str}
    substitutions.update({k:str(v) for k,v in {'metadata_script_sha256':BOUND,'metadata_bound_review_sha256':BOUND_REVIEW,
        'observer_sha256':OBSERVER,'profile_sha256':PROFILE,'harness_static_review_sha256':BINDINGS['guard_harness_static_review_sha256'],
        'owner_lease_sha256':OWNER}.items()})
    need(type(templates[role]) is list and 1<=len(templates[role])<=64,'bounded source-reviewed exact argv template')
    for token in templates[role]:
        need(type(token) is str and len(token)<=4096,'argv source token primitive/bound')
        if re.fullmatch(r'\{[a-z][a-z0-9_]*\}',token):
            name=token[1:-1];need(name in substitutions,'argv closed named substitution');token=substitutions[name]
        need('{' not in token and '}' not in token,'no arbitrary argv interpolation');expected.append(token)
    need(typed_equal(trace['argv'],expected),'actual argv exactly matches different reviewed source template')
    need(type(trace['outputs']) is list and 1<=len(trace['outputs'])<=12,'finite phase outputs')
    compiled={str(role_path(role)):ticket['sha256']}
    if ticket['terminal_path'] is not None:compiled[ticket['terminal_path']]=ticket['terminal_sha256']
    if role in ('capture_before','metadata_after_capture'):
        phase='before' if role=='capture_before' else 'after'
        result=selected(role_path(role),ticket['sha256'])
        compiled[str(PREP/f'phase-{phase}-003/OPAQUE_CURRENT_CONTEXT_003.json')]=result['context']['sha256']
        compiled[str(PREP/f'phase-{phase}-003/RUNTIME4_METADATA_SELECTION_003.json')]=result['runtime_selection']['sha256']
    need(len(trace['outputs'])==len(compiled),'exact compiled phase output count')
    seen=set()
    for row in trace['outputs']:
        exact(row,('path','sha256'));need(type(row['path']) is str and row['path'] in compiled and row['path'] not in seen
            and row['sha256']==compiled[row['path']],'only finite source-reviewed output roles/hashes');seen.add(row['path'])
        read(Path(row['path']),sha(row['sha256']),2097152)
    return dict(root_trust_selection_sha256=trust_pin,root_reported_tool_chunk=trust['physical_root_tool_chunk'],
        init_trace_sha256=trust['init_trace']['sha256'],phase_trace_sha256=ticket['phase_trace_sha256'],pipeline_source_sha256=source['sha256'],
        root_launch_nonce=init['nonce'],root_launch_pid=init['pid'],checker_pid=os.getpid(),checker_launch_nonce=CONFIG['execution_launch_witness']['nonce'],
        reviewer=REVIEWER,physical_tool_identity_externally_correlated_by_Root=True,independent_OS_or_tool_attestation=False,
        hard_Job_or_descendant_or_provider_deadline_proved=False)


TICKET_KEYS=('schema_version','record_type','author','scope','role','path','sha256','authorization_sha256','terminal_path','terminal_sha256',
             'runtime_sha256','context_sha256','before_result_sha256','before_capture_sha256','root_ack_sha256','unit_terminal_sha256',
             'unit_launcher_sha256','driver_finished_sha256','before_authorization_sha256','bridge_provenance_sha256','phase_trace_sha256','root_trust_sha256')


def ticket_check(role,ticket,trust_pin):
    exact(ticket,TICKET_KEYS)
    need(typed_equal(ticket['schema_version'],1) and ticket['record_type']=='root_metadata_checker_input_ticket' and ticket['author']=='/root'
        and ticket['scope']==SCOPE and ticket['role']==role and type(ticket['path']) is str and Path(ticket['path'])==role_path(role)
        and ticket['root_trust_sha256']==trust_pin,'closed exact phase ticket source/role/trust')
    for key in ('sha256','phase_trace_sha256','root_trust_sha256'):sha(ticket[key])
    for key in ('authorization_sha256','terminal_sha256','runtime_sha256','context_sha256','before_result_sha256','before_capture_sha256',
                'root_ack_sha256','unit_terminal_sha256','unit_launcher_sha256','driver_finished_sha256','before_authorization_sha256','bridge_provenance_sha256'):
        if ticket[key] is not None:sha(ticket[key])
    has_parent=role in ('capture_before','whole_before_result','whole_after_result','metadata_after_capture')
    need((ticket['terminal_path'] is not None)==has_parent and (ticket['terminal_sha256'] is not None)==has_parent,'exact phase parent presence')
    if has_parent:
        expected={'capture_before':PREP/'ROOT_METADATA_PARENT_TERMINAL_BEFORE_003.json','whole_before_result':GUARD/'ROOT_WHOLE_BEFORE_PARENT_TERMINAL_006.json',
                  'whole_after_result':GUARD/'ROOT_WHOLE_AFTER_PARENT_TERMINAL_006.json','metadata_after_capture':PREP/'ROOT_METADATA_PARENT_TERMINAL_AFTER_003.json'}[role]
        need(type(ticket['terminal_path']) is str and Path(ticket['terminal_path'])==expected,'fixed phase terminal role')
    if role=='auth_before':
        need(all(ticket[key] is None for key in ('authorization_sha256','runtime_sha256','context_sha256','before_result_sha256','before_capture_sha256','root_ack_sha256',
            'unit_terminal_sha256','unit_launcher_sha256','driver_finished_sha256','before_authorization_sha256','bridge_provenance_sha256')),'auth-before no future selected data')
    else:
        need(ticket['runtime_sha256'] is not None and ticket['context_sha256'] is not None,'actual selected original runtime/context required')
    if role in ('whole_after_auth','whole_after_result','metadata_after_auth','metadata_after_capture'):
        need(all(ticket[key] is not None for key in ('before_result_sha256','before_capture_sha256','root_ack_sha256','unit_terminal_sha256',
            'unit_launcher_sha256','driver_finished_sha256','before_authorization_sha256','bridge_provenance_sha256')),'after complete actual before/unit/bridge provenance')
    return argparse.Namespace(**ticket)


def once(path,data,cap):
    need(os.name=='nt','reviewed Windows atomic create-only publication')
    need(type(data) is bytes and len(data)<=cap,'own emitted bounded bytes');absent(path)
    stage=path.with_name(path.name+'.publishing');absent(stage)
    with stage.open('xb',buffering=0) as stream:
        need(stream.write(data)==len(data),'own complete write');os.fsync(stream.fileno())
    need(read(stage,digest(data),cap)[0]==data,'staged complete readback before publication')
    # On Windows os.rename fails if destination exists; no replace/overwrite flag.
    # Same-directory staging makes the final namespace transition atomic.
    absent(path);os.rename(stage,path)
    fresh=read(path,digest(data),cap)[0];need(fresh==data,'own exact emitted readback')
    return dict(path=str(path),sha256=digest(data),bytes=len(data))


def encoded(value):
    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')+b'\n'


def decision(role,ticket,trust_pin,ticket_pin):
    args=ticket_check(role,ticket,trust_pin)
    EVIDENCE.clear();_,profile=fixed()
    read(Path(__file__),SELF_SHA,262144)
    read(WORK/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json',SOURCE_PEER_SHA,8388608)
    read(CHECKER/'ACTUAL_CHECKER_BINDING_001.json',BINDING_SHA,131072)
    ticket_path=CHECKER/('ACTUAL_TICKET_'+role.upper()+'_006.json')
    need(typed_equal(canonical_record(read(ticket_path,sha(ticket_pin),65536)[0]),ticket),'exact current fixed ticket retained inside cryptobound evidence')
    execution_trace=provenance(role,ticket,trust_pin)
    if role=='auth_before':authorization(role_path(role),args.sha256,'before');checks=dict(authorization_sha256=args.sha256)
    elif role=='capture_before':checks=capture_before(args,profile)
    elif role=='whole_before_auth':checks=whole_auth_before(args,profile)
    elif role=='whole_before_result':checks=whole_before_result(args,profile)
    elif role=='whole_after_auth':checks=whole_after_auth(args,profile)
    elif role=='whole_after_result':checks=after_whole_compare(args,profile)
    elif role=='metadata_after_auth':metadata_after_authorization(args,profile);checks=dict(after_auth_sha256=args.sha256,actual_Auth17=True)
    else:checks=after_capture_compare(args,profile)
    checks['source_closure']=source_closure();checks['phase_sources']=CONFIG['phase_sources']
    initial=list(EVIDENCE)
    for row in initial:
        if row['bytes']<=8388608:
            _,fresh=read(Path(row['path']),row['sha256'],max(1,row['bytes']));need(typed_equal(fresh,row),'final paired raw9 full-byte metadata drift')
        else:current_stream_file(Path(row['path']),row)
    now=datetime.now(timezone.utc).isoformat(timespec='microseconds')
    detail=dict(schema_version=1,record_type='guard006_actual_metadata_checker_detail',reviewer=REVIEWER,role=role,created_utc=now,checks=checks,
        source_closure=source_closure(),phase_sources=CONFIG['phase_sources'],execution_owner_trace=execution_trace,checker_source_sha256=SELF_SHA,
        checker_source_peer_sha256=SOURCE_PEER_SHA,checker_binding_sha256=BINDING_SHA,observations=initial,target_execution=False,action_authorization=False)
    if role in ('whole_after_auth','whole_after_result','metadata_after_auth','metadata_after_capture'):
        _,_,remaining=original_before(args,profile);need(remaining>=0,'original lifetime at actual decision; no retimestamp substitution')
        detail['original_context_remaining_seconds']=str(remaining)
    elif role!='auth_before':
        runtime=selected(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json',args.runtime_sha256,65536)
        context=selected(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json',args.context_sha256,1048576)
        need(all(0<=now_exact()-moment_exact(obj['captured_utc'],'Py')<=600 for obj in (runtime,context)),'both ORIGINAL600 at decision')
    lease_check()
    record_type,verdict,filename=PHASES[role]
    context_pin=runtime_pin=parent_pin=None
    if role!='auth_before':context_pin=args.context_sha256;runtime_pin=args.runtime_sha256
    if role in ('capture_before','metadata_after_capture'):
        capture=selected(role_path(role),args.sha256)
        context_pin=capture['context']['sha256'];runtime_pin=capture['runtime_selection']['sha256']
    if role in ('capture_before','whole_before_result','whole_after_result','metadata_after_capture'):parent_pin=args.terminal_sha256
    detail_path=PREP/('INDEPENDENT_ACTUAL_DETAIL_'+role.upper()+'_006.json')
    detail_data=encoded(detail)
    core=dict(schema_version=1,record_type=record_type,reviewer=REVIEWER,created_utc=now,verdict=verdict,input_sha256=args.sha256,
        context_sha256=context_pin,runtime_snapshot_sha256=runtime_pin,parent_terminal_sha256=parent_pin,metadata_only=True,
        operational_authority_granted=False,evidence_sha256=digest(detail_data))
    exact(core,CORE_KEYS)
    outputs=[(detail_path,detail_data,16777216),(PREP/filename,encoded(core),65536)]
    if role=='whole_before_result':
        acceptance=dict(schema_version=1,scope=SCOPE,captured_utc=now,verifier=REVIEWER,runtime_snapshot_sha256=runtime_pin,
            whole_before_evidence=dict(path=str(role_path(role)),sha256=args.sha256),unchanged_against_reviewed_runtime=True)
        outputs.append((GUARD/'INDEPENDENT_WHOLE_BEFORE_ACCEPTANCE_006.json',encoded(acceptance),65536))
    for path,data,cap in outputs:absent(path)
    records=[once(path,data,cap) for path,data,cap in outputs]
    print(json.dumps(dict(role=role,verdict=verdict,core12=core,outputs=records,all_predicates_passed=True,target_execution=False,unit_GO=False),sort_keys=True,separators=(',',':')),flush=True)


def main():
    parser=argparse.ArgumentParser(allow_abbrev=False)
    for name in ('self-sha256','source-peer-sha256','binding-sha256','root-trust-sha256','execution-nonce'):parser.add_argument('--'+name,required=True)
    parser.add_argument('--roles',choices=('before','after','all'),required=True)
    args=parser.parse_args();configure(args);trust_pin=sha(args.root_trust_sha256)
    roles=list(PHASES)[:4] if args.roles=='before' else list(PHASES)[4:] if args.roles=='after' else list(PHASES)
    ready=CHECKER/('CHECKER_READY_'+args.roles.upper()+'_006.json')
    once(ready,encoded(dict(schema_version=1,record_type='guard006_independent_actual_checker_ready',reviewer=REVIEWER,created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),
         pid=os.getpid(),execution_nonce=args.execution_nonce,checker_source_sha256=SELF_SHA,checker_source_peer_sha256=SOURCE_PEER_SHA,
         checker_binding_sha256=BINDING_SHA,root_trust_selection_sha256=trust_pin,roles=roles,metadata_only=True,unit_GO=False)),65536)
    print(json.dumps(dict(status='READY_RETAINED_METADATA_REVIEWER_ONLY',ready=str(ready),reviewer=REVIEWER,pid=os.getpid(),target_execution=False)),flush=True)
    start=time.monotonic()
    for role in roles:
        path=CHECKER/('ACTUAL_TICKET_'+role.upper()+'_006.json')
        while True:
            need(time.monotonic()-start<=CONFIG['maximum_wait_seconds'],'retained checker bounded waiting expiry')
            EVIDENCE.clear()
            lease_check()
            try:path.lstat()
            except FileNotFoundError:time.sleep(0.025);continue
            break
        ticket_data,ticket_row=read(path,cap=65536);ticket=canonical_record(ticket_data)
        try:
            decision(role,ticket,trust_pin,ticket_row['sha256'])
        except (ValueError,TypeError,KeyError,OSError,OverflowError,IndexError) as error:
            message=str(error);need(len(message)<=4096,'complete refusal reason exceeds preparation cap')
            failure=dict(schema_version=1,record_type='guard006_actual_metadata_checker_refusal',reviewer=REVIEWER,role=role,
                created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),error_type=type(error).__name__,reason=message,
                ticket_sha256=ticket_row['sha256'],checker_source_sha256=SELF_SHA,checker_binding_sha256=BINDING_SHA,
                metadata_accepted=False,target_execution=False,unit_GO=False)
            once(CHECKER/('CHECKER_REFUSAL_'+role.upper()+'_006.json'),encoded(failure),65536)
            print(json.dumps(failure,sort_keys=True,separators=(',',':')),flush=True)
            raise
    print(json.dumps(dict(status='FINISHED_METADATA_REVIEWER_ONLY',reviewer=REVIEWER,roles=roles,target_execution=False,unit_GO=False)),flush=True)


if __name__=='__main__':
    main()
