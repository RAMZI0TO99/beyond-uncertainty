def need(value, message):
    if not value:
        raise ValueError(message)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def exact(obj, names):
    need(type(obj) is dict and set(obj) == set(names), 'closed keyset differs')


def raw(info):
    return [info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_mode, info.st_nlink,
            getattr(info, 'st_file_attributes', 0), info.st_birthtime_ns]


def ancestors(path):
    rows = []
    for item in reversed(path.absolute().parents):
        info = item.lstat()
        need(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode)
             and not info.st_file_attributes & 1024, 'nonplain ancestor')
        rows.append((str(item), info.st_dev, info.st_ino))
    return rows


def absent(path):
    path = Path(path)
    chain = ancestors(path)
    try:
        path.lstat()
    except FileNotFoundError:
        need(ancestors(path) == chain, 'absence ancestry drift')
        return
    raise ValueError('one-use path exists: ' + str(path))


def read(path, pin=None, cap=2097152, runtime=False):
    path = Path(path)
    need(type(cap) is int and 0 <= cap <= 8388608, 'invalid cap')
    need(pin is None or type(pin) is str and re.fullmatch('[0-9a-f]{64}', pin), 'invalid external SHA')
    chain = ancestors(path)
    pre = path.lstat()
    need(stat.S_ISREG(pre.st_mode) and pre.st_nlink == 1
         and not pre.st_file_attributes & 1024 and 0 <= pre.st_size <= cap, 'pre-open file/cap')
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        a, b = raw(pre), raw(opened)
        need(opened.st_size <= cap and opened.st_nlink == 1 and stat.S_ISREG(opened.st_mode), 'opened cap/plain')
        need(a[:4] + [a[8], a[6], a[7]] == b[:4] + [b[8], b[6], b[7]] and a[4] == a[8], 'birth/identity cross-API')
        if runtime and pin in ('935016795f3e6908e75acbc2040a01e2e4cdb494a57c42f63a0d6eedb2372256','5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed','c115a66a1bede6694b513af420cc90f8775be03666a54d1ecb82d6196b929fe9') and path in (PROJECT/'pro2/.venv/Scripts/python.exe',PROJECT/'runtimes/week8-python313-frozen-001/python.exe',PROJECT/'runtimes/git/mingw64/bin/git.exe'):
            need(a[5] & 0o111 == 0o111 and b[5] & 0o111 == 0 and a[5] & ~0o111 == b[5], 'fixed EXE mode projection')
        else:
            need(a[5] == b[5], 'ordinary mode mismatch')
        data = stream.read(pre.st_size + 1)
        need(raw(os.fstat(stream.fileno())) == b, 'descriptor raw9 drift')
    need(raw(path.lstat()) == a and ancestors(path) == chain and len(data) == pre.st_size, 'path/raw9/bytes drift')
    need(pin is None or digest(data) == pin, 'external SHA mismatch')
    row = dict(path=str(path), sha256=digest(data), bytes=len(data), path_raw9=a, descriptor_raw9=b)
    EVIDENCE.append(row)
    return data, row


def decode(data):
    need(not data.startswith(b'\xef\xbb\xbf'), 'UTF8 BOM')
    def pairs(items):
        obj = {}
        for key, value in items:
            need(key not in obj, 'duplicate key')
            obj[key] = value
        return obj
    def forbidden(token):
        raise ValueError('float/nonfinite token outside metadata grammar: ' + token)
    return json.loads(data.decode('utf8', errors='strict'), object_pairs_hook=pairs,
                      parse_float=forbidden, parse_constant=forbidden)


def literals(source):
    values = {}
    for node in ast.parse(source).body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
            try:
                values[node.targets[0].id] = ast.literal_eval(node.value)
            except ValueError:
                pass
    return values


def rowcheck(row, expected_path, cap, runtime=False):
    exact(row, ('path', 'sha256', 'bytes', 'path_raw9', 'descriptor_raw9'))
    need(type(row['bytes']) is int and all(type(x) is int for x in row['path_raw9']+row['descriptor_raw9'])
         and len(row['path_raw9']) == len(row['descriptor_raw9']) == 9, 'metadata integer grammar')
    data, observed = read(expected_path, row['sha256'], cap, runtime)
    need(observed['bytes'] == row['bytes'] and observed['path_raw9'] == row['path_raw9']
         and observed['descriptor_raw9'] == row['descriptor_raw9'], 'current row differs from paired capture')
    return data


def context_check(context, profile):
    exact(context, ('schema_version', 'scope', 'captured_utc', 'runtime_roles_projection_sha256',
                    'head', 'tracked_rows', 'git_metadata', 'configurations'))
    need(type(context['schema_version']) is int and context['schema_version'] == 1 and context['scope'] == SCOPE, 'context role')
    stamp(context['captured_utc'], 'Py', 600)
    need(context['runtime_roles_projection_sha256'] == profile['runtime_roles_projection_sha256']
         and re.fullmatch('[0-9a-f]{40}', context['head']), 'context runtime/head')
    cfg = profile['context_profile']
    ref = decode(read(PREP/'AUTHENTICATED_742_PATH_SEQUENCE_003.json', 'd4d35ae3ad87f7feca0f4770192ce14877d6077ef9543d89b3878cc094863db1')[0])
    paths = ref['paths']
    need(type(context['tracked_rows']) is list and len(paths) == len(context['tracked_rows']) == 742, 'tracked742 count')
    need([r['path'] for r in context['tracked_rows']] == paths, 'fixed742 ordered sequence')
    for row in context['tracked_rows']:
        rowcheck(row, Path(cfg['live_root'])/row['path'], cfg['maximum_file_bytes'])
    groups = [('git_metadata', cfg['head_paths']+cfg['optional_git_metadata_paths']),
              ('configurations', [str(Path(parent)/name) for parent in cfg['configuration_parents'] for name in cfg['configuration_names']])]
    for field, paths in groups:
        need(type(context[field]) is list and len(context[field]) == len(paths), 'finite optional row count')
        for row, path in zip(context[field], paths):
            exact(row, ('path', 'exists', 'identity'))
            need(row['path'] == str(Path(path)) and type(row['exists']) is bool, 'fixed optional path/type')
            if row['exists']:
                need(row['identity']['path'] == row['path'], 'optional identity path')
                data = rowcheck(row['identity'], Path(path), cfg['maximum_git_metadata_bytes'])
                if path == cfg['head_paths'][-1]:
                    need(data.decode('ascii').strip() == context['head'], 'branch HEAD differs')
            else:
                need(row['identity'] is None and path not in cfg['head_paths'], 'required HEAD absence')
                absent(Path(path))


def runtime_check(runtime, profile):
    exact(runtime, ('schema_version', 'scope', 'captured_utc', 'entries', 'context_selection'))
    need(type(runtime['schema_version']) is int and runtime['schema_version'] == 1 and runtime['scope'] == SCOPE, 'runtime role')
    stamp(runtime['captured_utc'], 'Py', 600)
    need(type(runtime['entries']) is list and len(runtime['entries']) == 4, 'FOUR runtime files')
    for row, role in zip(runtime['entries'], profile['runtime4_roles']):
        need(row['path'] == role['path'] and row['sha256'] == role['sha256'] and row['bytes'] == role['size'], 'fixed runtime4 role')
        rowcheck(row, Path(role['path']), role['size'], True)
    context = pointer(runtime['context_selection'], PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json', 1048576)
    context_check(context, profile)


def display(value):
    if type(value) is dict:
        return {key: display(item) for key, item in value.items()}
    if type(value) in (tuple, list):
        return [display(item) for item in value]
    if type(value) is int and abs(value) > 9007199254740991:
        return str(value)
    return value


def stamp(value, role, maximum_age=None):
    need(type(value) is str, 'timestamp string')
    fraction = r'\.[0-9]{7}' if role == 'PS' else r'(?:\.[0-9]{6})?'
    need(re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}'+fraction+r'\+00:00', value), 'canonical timestamp role')
    base = datetime.fromisoformat(value)
    need(base.utcoffset() == timedelta(0), 'UTC role')
    if maximum_age is not None:
        need(Decimal(0) <= now_exact()-moment_exact(value,role) <= Decimal(maximum_age), 'role expired/future')
    return base


def moment_exact(value, role):
    stamp(value, role)
    head = value.split('+')[0]
    plain, fraction = (head.split('.',1) + [''])[:2] if '.' in head else (head, '')
    seconds = int(datetime.fromisoformat(plain+'+00:00').timestamp())
    return Decimal(seconds) + (Decimal('0.'+fraction) if fraction else Decimal(0))


def now_exact():
    return moment_exact(datetime.now(timezone.utc).isoformat(), 'Py')


def canonical_record(data, role="Py"):
    value = decode(data)
    need(json.dumps(value, sort_keys=(role == 'Py'), ensure_ascii=True, separators=(',', ':'), allow_nan=False).encode('ascii')+b'\n' == data, 'compact ASCII plus LF record')
    return value


def pointer(value, expected, cap, pin=None):
    exact(value, ('path','sha256'))
    need(type(value['path']) is str and Path(value['path']) == expected, 'fixed pointer path')
    need(type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}',value['sha256']), 'pointer SHA')
    need(pin is None or pin == value['sha256'], 'externally pinned pointer differs')
    data, row = read(expected,value['sha256'],cap)
    return canonical_record(data)


def authorization(path,pin,phase,require_fresh=True):
    need(path==PREP/('ROOT_METADATA_AUTHORIZATION_'+phase.upper()+'_003.json'), 'fixed Auth17 path')
    data,row=read(path,pin,65536);auth=canonical_record(data,"PS");exact(auth,AUTH_KEYS)
    need(list(auth)==list(AUTH_KEYS), "PS source Auth17 property order")
    need(type(auth['schema_version']) is int and auth['schema_version']==1 and auth['record_type']=='root_guard006_metadata_phase_authorization'
         and auth['author']=='/root' and auth['decision']=='capture_current_metadata_once' and auth['phase']==phase and auth['scope']==SCOPE, 'Auth17 role')
    expected=dict(owner_sha256=OWNER,owner_end_utc=OWNER_END_TEXT,script_sha256=BOUND,bound_review_sha256=BOUND_REVIEW,
                  profile_sha256=PROFILE,source_projection_sha256=BINDINGS['source_projection_sha256'],
                  coordination_peer_reply_sha256=BINDINGS['coordination_peer_reply_sha256'],
                  coordination_root_response_sha256=BINDINGS['coordination_root_response_sha256'])
    need(all(type(auth[k]) is str and auth[k]==v for k,v in expected.items()),'Auth17 exact source/owner/provenance fields')
    stamp(auth['created_utc'],'PS',600 if require_fresh else None)
    if require_fresh:need(OWNER_END_TICKS-now_exact()>=350,'owner350 reserve')
    if phase=='before':
        need(auth['before_capture'] is None and auth['unit_terminal'] is None,'before no future prereqs')
        absent(PREP/'ROOT_METADATA_AUTHORIZATION_AFTER_003.json');absent(PREP/'phase-after-003')
    else:
        pointer(auth['before_capture'],PREP/'phase-before-003/METADATA_CAPTURE_003.json',2097152)
        pointer(auth['unit_terminal'],GUARD/'ROOT_LAUNCH_TERMINAL_006.json',2097152)
    return auth


def capture_before(args,profile):
    auth=authorization(PREP/'ROOT_METADATA_AUTHORIZATION_BEFORE_003.json',args.authorization_sha256,'before',False)
    need(Path(args.path)==PREP/'phase-before-003/METADATA_CAPTURE_003.json','fixed actual capture path')
    result=canonical_record(read(Path(args.path),args.sha256)[0])
    exact(result,('schema_version','phase','started_utc','captured_utc','context','runtime_selection','head','porcelain_normal',
                  'paired742_and_git_config_runtime_matched','bound_inputs','metadata_only','whole_inventory_trees_observed',
                  'guard_or_test_or_native_executed','operational_authority_granted'))
    need(type(result['schema_version']) is int and result['schema_version']==1 and result['phase']=='before'
         and result['paired742_and_git_config_runtime_matched'] is True and result['metadata_only'] is True
         and type(result['whole_inventory_trees_observed']) is int and result['whole_inventory_trees_observed']==0
         and result['guard_or_test_or_native_executed'] is False and result['operational_authority_granted'] is False, 'capture14 scope')
    stamp(result['captured_utc'],'Py',600);stamp(result['started_utc'],'Py')
    a=moment_exact(auth['created_utc'],'PS');start=moment_exact(result['started_utc'],'Py');end=moment_exact(result['captured_utc'],'Py')
    need(a<=start<=end<=a+600,'historical entry/publication inside original Auth TTL')
    run=PREP/'phase-before-003'
    intent=canonical_record(read(run/'started.json',cap=65536)[0])
    exact(intent,('schema_version','phase','started_utc','script_sha256','metadata_only'))
    need(type(intent['schema_version']) is int and intent['schema_version']==1 and intent['phase']=='before'
         and intent['started_utc']==result['started_utc'] and intent['script_sha256']==BOUND and intent['metadata_only'] is True,'actual helper intent')
    terminal=canonical_record(read(run/'terminal.json',cap=65536)[0])
    exact(terminal,('schema_version','phase','finished_utc','status','error_type','guard_or_test_or_native_executed','operational_authority_granted'))
    need(type(terminal['schema_version']) is int and terminal['schema_version']==1 and terminal['phase']=='before'
         and terminal['status']=='CAPTURED_METADATA_ONLY' and terminal['error_type'] is None and terminal['guard_or_test_or_native_executed'] is False
         and terminal['operational_authority_granted'] is False,'helper captured terminal')
    need(moment_exact(terminal['finished_utc'],'Py')>=end,'helper terminal order')
    parent=canonical_record(read(Path(args.terminal_path),args.terminal_sha256,65536)[0],"PS")
    exact(parent,('schema_version','finished_utc','phase','exit_code','timed_out','capture_overflow','capture_drain_complete',
                  'direct_child_reaped','failure','stdout_bytes','stderr_bytes','authorization_sha256','supervisor_sha256',
                  'metadata_only','spent','whole_inventory_trees_observed','target_tests_executed','operational_authority_granted',
                  'descendant_cleanup_guaranteed','OS_Job_hard_memory_bound'))
    need(list(parent)==list(METADATA_PARENT_KEYS),'PS source metadataParent20 property order')
    need(Path(args.terminal_path)==PREP/'ROOT_METADATA_PARENT_TERMINAL_BEFORE_003.json','fixed parent terminal')
    need(type(parent['schema_version']) is int and parent['schema_version']==1 and parent['phase']=='before'
         and type(parent['exit_code']) is int and parent['exit_code']==0 and parent['failure'] is None
         and parent['authorization_sha256']==args.authorization_sha256 and parent['supervisor_sha256']==BEFORE_PARENT
         and type(parent['whole_inventory_trees_observed']) is int and parent['whole_inventory_trees_observed']==0,'parent role')
    for k in ('capture_drain_complete','direct_child_reaped','metadata_only','spent'):need(parent[k] is True,'parent positive flag')
    for k in ('timed_out','capture_overflow','target_tests_executed','operational_authority_granted','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound'):need(parent[k] is False,'parent negative flag')
    need(moment_exact(parent['finished_utc'],'PS')>=moment_exact(terminal['finished_utc'],'Py'),'parent physical order')
    for k,filename in (('stdout_bytes','ROOT_METADATA_PARENT_STDOUT_BEFORE_003.txt'),('stderr_bytes','ROOT_METADATA_PARENT_STDERR_BEFORE_003.txt')):
        need(type(parent[k]) is int and 0<=parent[k]<=65536,'capture count domain');need(len(read(PREP/filename,cap=65536)[0])==parent[k],'parent capture count')
    context=pointer(result['context'],run/'OPAQUE_CURRENT_CONTEXT_003.json',1048576)
    runtime=pointer(result['runtime_selection'],run/'RUNTIME4_METADATA_SELECTION_003.json',65536)
    need(runtime['context_selection']==result['context'] and runtime['captured_utc']==context['captured_utc']==result['captured_utc']
         and context['head']==result['head'],'capture context/runtime/head same')
    runtime_check(runtime,profile)
    expected_inputs=[(PREP/'capture-root-metadata003.BOUND.py',BOUND),(PREP/'INDEPENDENT_BOUND_METADATA_REVIEW_003.json',BOUND_REVIEW),
                     (PREP/'ROOT_METADATA_AUTHORIZATION_BEFORE_003.json',args.authorization_sha256),(GUARD/'GUARD_RUNTIME_PROFILE_006-rev003.json',PROFILE),
                     (WORK/'OWNER_CONTINUATION_20261003_001.json',MASTER_SHA),
                     (WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json',MASTER_PEER_SHA),
                     (WORK/'EXECUTION_LEASE_GG6_M3_001.json',OWNER)] + [(p,BINDINGS[k]) for k,p in INPUTS.items()]
    need(type(result['bound_inputs']) is list and len(result['bound_inputs'])==len(expected_inputs)==15,'exact15 master-peer-lease bound inputs')
    for row,(p,pin) in zip(result['bound_inputs'],expected_inputs):
        need(row['path']==str(p) and row['sha256']==pin,'bound input source/position');rowcheck(row,p,2097152)
    need(type(result['porcelain_normal']) is list and all(type(s) is str for s in result['porcelain_normal']),'normal status capture strings')
    remaining=Decimal(600)-(now_exact()-moment_exact(result['captured_utc'],'Py'))
    return dict(capture_sha256=args.sha256,context_sha256=result['context']['sha256'],runtime_snapshot_sha256=result['runtime_selection']['sha256'],
                parent_terminal_sha256=args.terminal_sha256,current_files=742,configurations=55,runtime_files=4,trees=0,
                context_remaining_seconds=str(remaining),historical_authorization_age_at_publication=str(end-a),
                producer_provenance_still_requires_Root_actual_tool_record_review=True,porcelain_normal=result['porcelain_normal'])


def whole_auth_before(args,profile):
    data,row=read(Path(args.path),args.sha256,65536);auth=canonical_record(data,"PS")
    need(Path(args.path)==GUARD/'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json','fixed wholeAuth before role')
    exact(auth,WHOLE_AUTH_KEYS)
    need(list(auth)==list(WHOLE_AUTH_KEYS),'PS source WholeAuth15 property order')
    need(type(auth['schema_version']) is int and auth['schema_version']==1 and auth['record_type']=='consumer_guard_unit006_metadata_observation_authorization'
         and auth['author']=='/root' and auth['scope']==SCOPE and auth['phase']=='before'
         and auth['observer_sha256']==OBSERVER and auth['profile_sha256']==PROFILE and auth['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and auth['owner_sha256']==OWNER and auth['before_record_sha256'] is None and auth['unit_receipt'] is None,'wholeAuth15 before role')
    stamp(auth['created_utc'],'PS',600)
    created=moment_exact(auth['created_utc'],'PS');expires=moment_exact(auth['expires_utc'],'PS');now=now_exact();owner=OWNER_END_TICKS
    need(created<expires<=owner and 0<expires-created<=1800 and expires-now>=315
         and owner-now>=350,'wholeAuth clock/reserves')
    runtime=pointer(auth['runtime_snapshot'],PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json',65536,args.runtime_sha256)
    context=pointer(auth['context_selection'],PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json',1048576,args.context_sha256)
    need(runtime['context_selection']==auth['context_selection'],'original context pins');runtime_check(runtime,profile)
    absent(GUARD/'whole-runtime-before');absent(GUARD/'whole-runtime-after')
    return dict(whole_authorization_sha256=args.sha256,context_sha256=args.context_sha256,runtime_snapshot_sha256=args.runtime_sha256,
                actual_runtime_files=4,actual_inventory_trees_observed=0,all_role_producer_provenance_requires_independent_review=True)


def source_projection(profile):
    obj=decode(read(GUARD/'SOURCE_INPUTS_PROJECTION_006.json',BINDINGS['source_projection_sha256'])[0]);answer=[]
    for row in obj['entries']:
        if not row['runtime_source_reobserve_required']:continue
        original=Path(row['original_path']);copied=GUARD/row['copy_path']
        ob,om=read(original,row['sha256'],row['bytes']);cb,cm=read(copied,row['sha256'],row['bytes'])
        need(ob==cb and om==dict(path=str(original),**row['original_metadata'])
             and cm==dict(path=str(copied),**row['copy_metadata']),'source projection bytes/raw9')
        answer.append(dict(path=row['copy_path'],original={k:v for k,v in om.items() if k!='path'},copy={k:v for k,v in cm.items() if k!='path'}))
    return answer


def whole_before_result(args,profile):
    need(Path(args.path)==GUARD/'whole-runtime-before/result.json','fixed whole before result')
    result=canonical_record(read(Path(args.path),args.sha256,262144)[0]);exact(result,WHOLE_RESULT_KEYS)
    whole_parent(args, result)
    need(type(result['schema_version']) is int and result['schema_version']==1 and result['record_type']=='consumer_guard_unit006_whole_metadata_result'
         and result['scope']==SCOPE and result['phase']=='before' and result['verdict']=='MATCHES_PINNED_BYTES_METADATA_TWICE'
         and result['observer_sha256']==OBSERVER and result['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and result['profile_sha256']==PROFILE and result['owner_sha256']==OWNER
         and result['runtime_snapshot_sha256']==args.runtime_sha256 and result['context_selection_sha256']==args.context_sha256
         and result['before_record_sha256'] is None and result['unit_receipt'] is None and result['target_execution'] is False
         and result['whole_site_loaded_closure_retained_lock_OS_Job_guaranteed'] is False,'whole19 source and scope')
    stamp(result['captured_utc'],'Py',600)
    runtime=canonical_record(read(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json',args.runtime_sha256,65536)[0])
    need(runtime['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256),'whole original context')
    runtime_check(runtime,profile)
    source_rows=source_projection(profile)
    need(digest(json.dumps(source_rows,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')+b'\n')==result['source_snapshot_sha256'],'whole source snapshot')
    exact(result['trees'],('base','scripts'));need(type(result['observation_files']) is list and len(result['observation_files'])==4,'four row streams')
    trees={}
    expected_paths=[GUARD/'whole-runtime-before'/(role+'-'+suffix+'.json') for role in ('base','scripts') for suffix in ('first','second')]
    for r,p in zip(result['observation_files'],expected_paths):
        exact(r,('path','sha256','bytes'));need(r['path']==str(p) and type(r['bytes']) is int and 0<r['bytes']<=4194304,'row stream role/cap')
        b=read(p,r['sha256'],4194304)[0];need(len(b)==r['bytes'],'row stream byte length');trees[p.stem]=canonical_record(b)
    for role,root in WHOLE_ROOTS.items():
        first=trees[role+'-first'];need(first==trees[role+'-second'],'both whole streams equal')
        exact(first,('root','identity','rows','root_raw9','directory_metadata'));need(first['root']==str(root),'fixed whole root')
        need(first['identity']==WHOLE_EXPECTED[role]==result['trees'][role],'pinned whole identity')
        need(type(first['rows']) is list and len(first['rows'])<=6000 and type(first['root_raw9']) is list
             and len(first['root_raw9'])==9 and all(type(v) is int for v in first['root_raw9']),'whole shape')
        need(raw(root.lstat())==first['root_raw9'],'whole root current metadata')
        paths=[];lines=[];files=dirs=total=0;directories={}
        for row in first['rows']:
            need(type(row) is dict and type(row.get('path')) is str and len(row['path'])<=399
                 and '\t' not in row['path'] and '\r' not in row['path'] and '\n' not in row['path'],'whole finite row path')
            rel=Path(row['path']);need(not rel.is_absolute() and rel.as_posix()==row['path'] and all(x not in ('','..','.') and ':' not in x for x in row['path'].split('/')),'whole row confinement')
            path=root/rel;paths.append(row['path'])
            if row['kind']=='directory':
                exact(row,('kind','path','path_raw9'));need(raw(path.lstat())==row['path_raw9'] and stat.S_ISDIR(path.lstat().st_mode),'whole directory')
                dirs+=1;lines.append('D\t'+row['path']+'\n');directories[str(path)]=row['path_raw9']
            else:
                exact(row,('kind','path','bytes','sha256','path_raw9','descriptor_raw9'));need(row['kind']=='file' and type(row['bytes']) is int and 0<=row['bytes']<=67108864,'whole file size')
                current_stream_file(path,row);files+=1;total+=row['bytes'];lines.append('F\t'+row['path']+'\t'+str(row['bytes'])+'\t'+row['sha256']+'\n')
        need(paths==sorted(paths,key=lambda v:tuple(int.from_bytes(v.encode('utf-16-le','surrogatepass')[i:i+2],'little') for i in range(0,len(v.encode('utf-16-le','surrogatepass')),2))), 'ordinal stream order')
        need(len(paths)==len(set(v.casefold() for v in paths)),'whole aliases')
        directories[str(root)]=first['root_raw9'];need(directories==first['directory_metadata'],'whole directory map coverage')
        need(dict(files=files,directories=dirs,bytes=total,sha256=digest(''.join(lines).encode('utf-8')))==first['identity'],'whole digest reconstruction')
    return dict(whole_before_sha256=args.sha256,runtime_snapshot_sha256=args.runtime_sha256,context_sha256=args.context_sha256,
                two_inventory_trees=2,four_runtime_files=4,whole_site_loaded_Job_descendant_guarantee=False,
                physical_parent_and_producer_provenance_requires_independent_actual_review=True)


def whole_parent(args, result):
    need(args.authorization_sha256 is not None and args.terminal_path is not None and args.terminal_sha256 is not None, 'whole actual Auth/physical terminal required')
    read(PIPELINE/'SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1',WHOLE_BEFORE_PARENT,65536)
    auth=canonical_record(read(GUARD/'ROOT_WHOLE_BEFORE_AUTHORIZATION_006.json',args.authorization_sha256,65536)[0],"PS")
    exact(auth,WHOLE_AUTH_KEYS)
    need(list(auth)==list(WHOLE_AUTH_KEYS),'PS source WholeAuth15 property order')
    need(type(auth['schema_version']) is int and auth['schema_version']==1 and auth['phase']=='before'
         and auth['record_type']=='consumer_guard_unit006_metadata_observation_authorization' and auth['author']=='/root' and auth['scope']==SCOPE
         and auth['observer_sha256']==OBSERVER and auth['profile_sha256']==PROFILE and auth['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256']
         and auth['owner_sha256']==OWNER and auth['before_record_sha256'] is None and auth['unit_receipt'] is None, 'whole historical Auth role')
    need(auth['runtime_snapshot']==dict(path=str(PREP/'phase-before-003/RUNTIME4_METADATA_SELECTION_003.json'),sha256=args.runtime_sha256)
         and auth['context_selection']==dict(path=str(PREP/'phase-before-003/OPAQUE_CURRENT_CONTEXT_003.json'),sha256=args.context_sha256),'whole original pointer pins')
    created=moment_exact(auth['created_utc'],'PS');expires=moment_exact(auth['expires_utc'],'PS');published=moment_exact(result['captured_utc'],'Py')
    need(created<=published<=expires and expires<=OWNER_END_TICKS and 0<expires-created<=1800,'historical observer inside Auth expiry/owner')
    need(Path(args.terminal_path)==GUARD/'ROOT_WHOLE_BEFORE_PARENT_TERMINAL_006.json','whole parent terminal fixed')
    parent=canonical_record(read(Path(args.terminal_path),args.terminal_sha256,65536)[0],"PS")
    exact(parent,WHOLE_PARENT_KEYS)
    need(list(parent)==list(WHOLE_PARENT_KEYS),'PS source WholeParent30 property order')
    need(type(parent['schema_version']) is int and parent['schema_version']==1 and parent['phase']=='before'
         and type(parent['exit_code']) is int and parent['exit_code']==0 and parent['failure'] is None
         and parent['authorization_sha256']==args.authorization_sha256 and parent['supervisor_sha256']==WHOLE_BEFORE_PARENT
         and parent['observer_sha256']==OBSERVER and parent['profile_sha256']==PROFILE
         and parent['static_review_sha256']==BINDINGS['guard_harness_static_review_sha256'],'whole physical terminal role')
    for k in ('capture_drain_complete','direct_child_reaped','metadata_only','spent'):need(parent[k] is True,'whole parent positive flag')
    for k in ('timed_out','capture_overflow','observer_result_reconciled','whole_site_loaded_closure_guaranteed','target_tests_executed',
              'operational_authority_granted','native_authority_granted','descendant_cleanup_guaranteed','OS_Job_hard_memory_bound',
              'unconditional_physical_IO_deadline_guaranteed'):need(parent[k] is False,'whole parent negative flag')
    need(type(parent['expected_inventory_trees']) is int and parent['expected_inventory_trees']==2
         and type(parent['expected_runtime_file_guards']) is int and parent['expected_runtime_file_guards']==4
         and parent['whole_inventory_trees_observed'] is None and parent['runtime_file_guards_observed'] is None,'whole parent expected not accepted counts')
    need(moment_exact(parent['finished_utc'],'PS')>=published,'whole physical completion order')
    for k,filename in (('stdout_bytes','ROOT_WHOLE_BEFORE_PARENT_STDOUT_006.txt'),('stderr_bytes','ROOT_WHOLE_BEFORE_PARENT_STDERR_006.txt')):
        need(type(parent[k]) is int and 0<=parent[k]<=65536 and len(read(GUARD/filename,cap=65536)[0])==parent[k],'whole capture count')


def current_stream_file(path, row):
    # Own metadata reobservation of fixed emitted paths only; never runs observer or traverses a directory tree.
    chain=ancestors(path);pre=path.lstat();a=raw(pre)
    need(stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and not pre.st_file_attributes&1024
         and a==row['path_raw9'] and pre.st_size==row['bytes'],'whole emitted file current')
    hasher=hashlib.sha256();total=0
    with path.open('rb') as stream:
        b=raw(os.fstat(stream.fileno()));need(b==row['descriptor_raw9'],'whole descriptor')
        while True:
            chunk=stream.read(min(1048576,row['bytes']-total+1))
            if not chunk:break
            total+=len(chunk);need(total<=row['bytes'],'whole growth');hasher.update(chunk)
        need(raw(os.fstat(stream.fileno()))==b,'whole descriptor stable')
    need(raw(path.lstat())==a and ancestors(path)==chain and total==row['bytes'] and hasher.hexdigest()==row['sha256'],'whole bytes/meta stable')
    EVIDENCE.append(dict(path=str(path),bytes=total,sha256=hasher.hexdigest(),path_raw9=a,descriptor_raw9=b))


def runtime_check_after(runtime, profile):
    exact(runtime, ('schema_version', 'scope', 'captured_utc', 'entries', 'context_selection'))
    need(type(runtime['schema_version']) is int and runtime['schema_version'] == 1 and runtime['scope'] == SCOPE, 'runtime role')
    stamp(runtime['captured_utc'], 'Py', 600)
    need(type(runtime['entries']) is list and len(runtime['entries']) == 4, 'FOUR runtime files')
    for row, role in zip(runtime['entries'], profile['runtime4_roles']):
        need(row['path'] == role['path'] and row['sha256'] == role['sha256'] and row['bytes'] == role['size'], 'fixed runtime4 role')
        rowcheck(row, Path(role['path']), role['size'], True)
    context = pointer(runtime['context_selection'], PREP/'phase-after-003/OPAQUE_CURRENT_CONTEXT_003.json', 1048576)
    context_check(context, profile)


def capture_after(args,profile):
    auth=metadata_after_authorization(type('ReviewArguments',(),{**vars(args),'path':str(PREP/'ROOT_METADATA_AUTHORIZATION_AFTER_003.json'),'sha256':args.authorization_sha256})(),profile,False)
    need(Path(args.path)==PREP/'phase-after-003/METADATA_CAPTURE_003.json','fixed actual capture path')
    result=canonical_record(read(Path(args.path),args.sha256)[0])
    exact(result,('schema_version','phase','started_utc','captured_utc','context','runtime_selection','head','porcelain_normal',
                  'paired742_and_git_config_runtime_matched','bound_inputs','metadata_only','whole_inventory_trees_observed',
                  'guard_or_test_or_native_executed','operational_authority_granted'))
    need(type(result['schema_version']) is int and result['schema_version']==1 and result['phase']=='after'
         and result['paired742_and_git_config_runtime_matched'] is True and result['metadata_only'] is True
         and type(result['whole_inventory_trees_observed']) is int and result['whole_inventory_trees_observed']==0
         and result['guard_or_test_or_native_executed'] is False and result['operational_authority_granted'] is False, 'capture14 scope')
    stamp(result['captured_utc'],'Py',600);stamp(result['started_utc'],'Py')
    a=moment_exact(auth['created_utc'],'PS');start=moment_exact(result['started_utc'],'Py');end=moment_exact(result['captured_utc'],'Py')
    need(a<=start<=end<=a+600,'historical entry/publication inside original Auth TTL')
    run=PREP/'phase-after-003'
    intent=canonical_record(read(run/'started.json',cap=65536)[0])
