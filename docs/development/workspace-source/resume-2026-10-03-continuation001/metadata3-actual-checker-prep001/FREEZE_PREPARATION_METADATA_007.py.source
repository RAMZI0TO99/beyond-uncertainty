"""One-use owned source-metadata compositor. Never imports checker/target."""
import ast
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path('D:/Aenv/pro2/resume-2026-10-03-continuation001')
OWN = ROOT / 'metadata3-actual-checker-prep001'
M3 = ROOT / 'metadata3-producer-core-prep001'
GG = ROOT / 'consumer005-guard006-runtime-prep001'
PIPE = ROOT / 'root-guard006-pipeline-prep001'
SCOPE = 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
SELECTED = '02996f245e9ab6e0839e23ce9e9296c40c66bbfecc813a360bb37ce5c874ff8e'

def sha(data):
    return hashlib.sha256(data).hexdigest()

def write(name, value):
    data = (json.dumps(value, indent=2, ensure_ascii=True) + '\n').encode('ascii')
    with (OWN / name).open('xb') as stream:
        stream.write(data)
    assert (OWN / name).read_bytes() == data

source = (OWN / 'review-metadata3-actual006.TEMPLATE.py').read_bytes()
assert sha(source) == SELECTED and len(source) == 123091
tree = ast.parse(source.decode('utf-8'))
literals = {}
for node in tree.body:
    if isinstance(node, ast.Assign):
        try:
            value = ast.literal_eval(node.value)
        except (ValueError, TypeError):
            continue
        for target in node.targets:
            if isinstance(target, ast.Name):
                literals[target.id] = value

bindings = dict.fromkeys(('guard_profile_sha256','source_projection_sha256','raw_source_sha256','source_manifest_sha256','source_peer_sha256','guard_harness_static_review_sha256','preparer_static_review_sha256','coordination_peer_reply_sha256','coordination_root_response_sha256'))
def row(path):
    return {'path': path.as_posix(), 'sha256': None}

