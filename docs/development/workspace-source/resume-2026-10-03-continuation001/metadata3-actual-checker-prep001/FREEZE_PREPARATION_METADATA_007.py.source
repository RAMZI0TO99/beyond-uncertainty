for item in rows:
    current = (OWN / item['path']).read_bytes()
    assert sha(current) == item['sha256'] and len(current) == item['bytes']
manifest_data = (OWN / 'AUTHOR_FROZEN_SOURCE_MANIFEST_007.json').read_bytes()
print(json.dumps({'manifest_sha256':sha(manifest_data),'manifest_bytes':len(manifest_data),'payload_count':len(rows),'selected_checker_sha256':SELECTED,'actual_source_binding':None,'actual_results':None}, separators=(',',':')))
