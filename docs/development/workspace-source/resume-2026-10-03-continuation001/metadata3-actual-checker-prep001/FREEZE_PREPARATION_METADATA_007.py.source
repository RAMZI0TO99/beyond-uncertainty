    'source_author':'/root/actual_record_checker','scope':SCOPE,'created_utc':datetime.now(timezone.utc).isoformat(timespec='microseconds'),
    'payload_count':len(rows),'payloads':rows,'finite_flat_owned_payload_only':True,
