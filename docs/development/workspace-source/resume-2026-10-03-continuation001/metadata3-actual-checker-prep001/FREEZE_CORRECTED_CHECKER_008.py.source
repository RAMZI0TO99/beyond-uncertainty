'''
with (OWN/'HANDOFF_CORRECTED_008.md').open('x',encoding='utf8',newline='\n') as out:out.write(handoff)

rows=[]
for path in sorted(OWN.iterdir(),key=lambda path:path.name):
    assert path.is_file()
    first=path.read_bytes();second=path.read_bytes();third=path.read_bytes()
    assert first==second==third
    rows.append(dict(path=path.name,bytes=len(first),sha256=sha(first)))
manifest={'schema_version':1,'record_type':'metadata3_actual_checker_corrected008_author_frozen_source_manifest','source_author':'/root/actual_record_checker','scope':'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY','created_utc':datetime.now(timezone.utc).isoformat(timespec='microseconds'),'payload_count':len(rows),'payloads':rows,'finite_flat_owned_payload_only':True,'selected_checker':dict(path='review-metadata3-actual006-corrected008.TEMPLATE.py',bytes=len(source),sha256=SOURCE_SHA),'selected_planned_tests':dict(path='test_metadata3_actual_checker_preparation_002.py',bytes=len(tests),sha256=TEST_SHA,method_count=19,actual_results=None),'prior_source007_manifest_sha256':sha(old_manifest),'independent_source007_refusal_sha256':audit['independent_source007_refusal_sha256'],'different_corrected_source_review':None,'actual_source_binding':None,'actual_lease':None,'actual_ready':None,'actual_before':None,'actual_after':None,'actual_results':None,'runtime_acceptance':False,'operational_authority':False,'reviewed_definitions_imports_mains_tests_Git_FFI_PS_native_executed':False}
write('AUTHOR_FROZEN_SOURCE_MANIFEST_008.json',manifest)
for row in rows:
    data=(OWN/row['path']).read_bytes();assert sha(data)==row['sha256'] and len(data)==row['bytes']
data=(OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_008.json').read_bytes()
print(json.dumps({'manifest_sha256':sha(data),'manifest_bytes':len(data),'payload_count':len(rows),'selected_checker_sha256':SOURCE_SHA,'test_source_sha256':TEST_SHA,'planned_test_methods':19,'actual_results':None},separators=(',',':')))
