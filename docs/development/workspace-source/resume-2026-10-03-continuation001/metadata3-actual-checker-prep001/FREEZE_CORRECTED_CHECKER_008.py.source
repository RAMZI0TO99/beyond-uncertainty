"""One-use owned source freeze; never imports or executes reviewed helpers/tests."""
import ast
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
SOURCE_SHA='c097c756d8cf55b1ac98a68313f5e406455b9306af63bd48a6e1cb3add70d3c1'
TEST_SHA='ea0012b190e108edcfc1dece29ed480cd369a34f1ed044edacad415d808934db'
def sha(data):return hashlib.sha256(data).hexdigest()
def write(name,value):
    data=(json.dumps(value,indent=2,ensure_ascii=True)+'\n').encode('ascii')
    with (OWN/name).open('xb') as out:out.write(data)
    assert (OWN/name).read_bytes()==data

old_manifest=(OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_007.json').read_bytes()
assert sha(old_manifest)=='a27031ac594c0705ed3a595766acf6c7fdf4d22692339e7634ca848f13f15e23'
for row in json.loads(old_manifest)['payloads']:
    first=(OWN/row['path']).read_bytes();assert sha(first)==row['sha256'] and len(first)==row['bytes']
source=(OWN/'review-metadata3-actual006-corrected008.TEMPLATE.py').read_bytes()
tests=(OWN/'test_metadata3_actual_checker_preparation_002.py').read_bytes()
assert sha(source)==SOURCE_SHA and len(source)==137182 and sha(tests)==TEST_SHA and len(tests)==26002
source_tree=ast.parse(source);test_tree=ast.parse(tests)
old_test_tree=ast.parse((OWN/'test_metadata3_actual_checker_preparation_001.py').read_bytes())
def methods(tree):
    return {node.name:ast.dump(node,include_attributes=False) for cls in tree.body if isinstance(cls,ast.ClassDef) for node in cls.body if isinstance(node,ast.FunctionDef) and node.name.startswith('test_')}
old_methods=methods(old_test_tree);new_methods=methods(test_tree)
assert len(old_methods)==9 and len(new_methods)==19
assert all(new_methods.get(key)==value for key,value in old_methods.items())
functions={node.name:node for node in source_tree.body if isinstance(node,ast.FunctionDef)}
assert len(functions)==65
main_calls={name:min(node.lineno for node in ast.walk(functions['main']) if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id==name) for name in ('configure','preflight_ready','once')}
assert main_calls['configure']<main_calls['preflight_ready']<main_calls['once']
prior=ast.parse((OWN/'review-metadata3-actual006.TEMPLATE.py').read_bytes())
prior_read=next(node for node in prior.body if isinstance(node,ast.FunctionDef) and node.name=='read')
assert ast.dump(prior_read,include_attributes=False)==ast.dump(functions['read'],include_attributes=False)
