    'schema_version':1,'record_type':'metadata3_corrected008_author_static_preservation',
    'source_author':'/root/actual_record_checker','selected_source_sha256':SOURCE_SHA,
    'selected_test_sha256':TEST_SHA,'old_nine_test_method_ASTs_exact':True,
    'general_input_reader_AST_exact':True,'before_READY_call_order_AST_checked':True,
    'top_level_function_count':65,'planned_test_method_count':19,
    'checks_are_author_metadata_not_independent_approval':True,
    'source_builder_tool_chunk':'de683f','source_builder_exit_code':0,
    'independent_source007_refusal_sha256':'92937a787276a18e3d36b012d99febda84fcac5c5f8b2ca5db14dd7e14a419d3',
    'actual_results':None,'actual_binding':None,'actual_lease':None,'actual_ready':None,
    'reviewed_definitions_imports_mains_tests_Git_FFI_PS_native_executed':False}
write('AUTHOR_CORRECTED_STATIC_PRESERVATION_008.json',audit)

