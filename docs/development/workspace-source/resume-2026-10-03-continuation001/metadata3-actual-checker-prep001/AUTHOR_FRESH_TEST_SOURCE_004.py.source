"""Author Source-only test004; no selected loader/definition/compiler is called."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
helper=(OWN/'review-metadata3-actual006-corrected010.TEMPLATE.py').read_bytes()
helper_sha=hashlib.sha256(helper).hexdigest()
assert helper_sha=='9efa6deb54721a531159545ffa5e4e9bd90606f3dc12d7b0ab6cf5f4af51ee16'
old=(OWN/'test_metadata3_actual_checker_preparation_003.py').read_bytes()
assert hashlib.sha256(old).hexdigest()=='11babbb00b240059ce441b37e2b4bcbcd3167ff44f674dc3229578a63dd865db'
text=old.decode('utf8');newline='\r\n' if '\r\n' in text else '\n'
text=text.replace('review-metadata3-actual006-corrected009.TEMPLATE.py','review-metadata3-actual006-corrected010.TEMPLATE.py')
text=text.replace('isolated_metadata3_checker_source_003','isolated_metadata3_checker_source_004')
text=text.replace('import copy'+newline,'import copy'+newline+'import hashlib'+newline)
source_line=next(line for line in text.splitlines() if line.startswith('SOURCE=Path('))
config=json.loads((OWN/'ACTUAL_CHECKER_BINDING_010.TEMPLATE.json').read_bytes())
text=text.replace(source_line,source_line+newline+'SOURCE_SHA256='+repr(helper_sha)+newline+'FRESH_CONFIG_TEMPLATE='+repr(config))
needle='        spec=importlib.util.spec_from_file_location('
assert text.count(needle)==1
text=text.replace(needle,
    '        with SOURCE.open("rb") as stream:source_bytes=stream.read(262145)'+newline+
    '        if len(source_bytes)>262144 or hashlib.sha256(source_bytes).hexdigest()!=SOURCE_SHA256:'+newline+
    '            raise ValueError("selected fresh checker010 source hash/cap")'+newline+needle)
assert text.count('        spec.loader.exec_module(cls.checker)')==1
text=text.replace('        spec.loader.exec_module(cls.checker)',
    '        # Future separately authorized fixture loads only the verified bytes.'+newline+
    '        exec(compile(source_bytes,str(SOURCE),"exec",dont_inherit=True),vars(cls.checker))')
extra=(OWN/'NEW_FRESH_PATH_CONTROLS_004.txt').read_bytes().decode('utf8')
extra=extra.replace('\r\n','\n').replace('\n',newline)
marker="if __name__=='__main__':"
assert text.count(marker)==1
text=text.replace(marker,extra+newline*3+marker)
new=text.encode('utf8');newtree=ast.parse(new);oldtree=ast.parse(old)
tests=lambda tree:{node.name:ast.dump(node,include_attributes=False) for node in ast.walk(tree)
    if isinstance(node,ast.FunctionDef) and node.name.startswith('test_')}
oldtests=tests(oldtree);newtests=tests(newtree)
assert len(oldtests)==25 and len(newtests)==28
assert all(newtests[name]==dump for name,dump in oldtests.items())
added=sorted(set(newtests)-set(oldtests))
assert len(added)==3
path=OWN/'test_metadata3_actual_checker_preparation_004.py'
with path.open('xb') as stream:stream.write(new)
plan=dict(schema_version=1,record_type='checker010_fresh_path_causal_test_source_preparation',author='/root/actual_record_checker',
    source=dict(path=path.name,sha256=hashlib.sha256(new).hexdigest(),bytes=len(new)),
    checker=dict(path='review-metadata3-actual006-corrected010.TEMPLATE.py',sha256=helper_sha,bytes=len(helper)),
    loader_namespace='isolated_metadata3_checker_source_004',loader_pins_verified_bytes_before_future_compilation=True,
    actual_loader_definitions_compiler_called=False,old_test_method_count=25,old25_test_ASTs_exact=True,planned_test_method_count=28,
    new_methods=added,planned_controls=[
        dict(method=added[0],healthy='Complete typed configure Source fixture uses current010 self, peer003 and config002; all fixture Sources and lease stage are available.',
            negative='Only self path changes to spent009, or the same peer/config contents move solely to old aliases; fixed current request/refusal is asserted.',
            restored='Restore selected010 and current peer/config paths and require complete configure entry again.',
            scope='Synthetic mocked acquisition; no actual Root binding or source acceptance file is produced.'),
        dict(method=added[1],healthy='Complete decision current-source reread reaches provenance only after010 self, peer003, config002 and fixed ticket reopen.',
            negative='Only peer/config availability moves to the old aliases; assert exact missing fresh path and no provenance/publication entry.',
            restored='Restore both fresh records and reach the explicit prepublication stop again.',
            scope='Decision tail intentionally stops before any metadata Core, detail or result; all earlier phase gates are held healthy for this isolated reread control.'),
        dict(method=added[2],healthy='Complete trust002, pipeline007, peer002 and INIT002 Source fixture, including typed identity and reviewed argv closure.',
            negative='Only fixed source/peer/INIT path or new-file availability changes, then independently reviewer alias, bool PID and unknown argv substitution violate their own reachable guards.',
            restored='Restore each single mutation and require the same full trust/source/init/peer result.',
            scope='Mocked typed Source consistency only; synthetic PID/tool/nonce are explicitly fixture data, never a genuine Root launch claim.')],
    old009_actual25_scope='Root-reported accepted synthetic25 applies only to prior helper009/test003; no result is transferred to010/test004 and old parent/runner must not replay.',
    meaningful_causal_scope='Healthy-before/negative/restored path controls target changed fixed acquisition/identity/reopen routes; prior unrelated refusals are not counted as their proof.',
    new_runtime_acceptance=None,current_project_capture_or_unit_results=None,tests_executed=False,operational_authority=False)
with (OWN/'CHECKER010_FRESH_PATH_TEST_PLAN_004.json').open('x',encoding='ascii') as stream:json.dump(plan,stream,indent=2);stream.write('\n')
protocol=json.loads((OWN/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_009.json').read_bytes())
protocol['record_type']='metadata3_actual_checker_corrected010_source_protocol'
protocol['selected_checker']=dict(path='review-metadata3-actual006-corrected010.TEMPLATE.py',sha256=helper_sha,bytes=len(helper))
protocol['selected_source_peer_path']=str(OWN.parent/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_003.json')
protocol['selected_planned_tests']=dict(path=path.name,sha256=hashlib.sha256(new).hexdigest(),bytes=len(new),methods=sorted(newtests),
    planned_count=28,prior25_method_ASTs_exact=True,runtime_results=None)
protocol['fresh_source_successor']=json.loads((OWN/'CHECKER010_LITERAL_DELTA_AND_FRESH_ROLES_001.json').read_bytes())
protocol['selected_binding_template']='ACTUAL_CHECKER_BINDING_010.TEMPLATE.json'
protocol['actual_binding_path']=str(OWN/'ACTUAL_CHECKER_BINDING_002.json')
protocol['fresh_actual_nonce']=None
protocol['prior_source009_actual25_history_only']=True
protocol['different_full_source_review']=None
with (OWN/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_010.json').open('x',encoding='ascii') as stream:json.dump(protocol,stream,indent=2,allow_nan=False);stream.write('\n')
print(json.dumps(dict(test_path=str(path),test_sha256=hashlib.sha256(new).hexdigest(),test_bytes=len(new),planned_methods=len(newtests),old25_ASTs_exact=True,
    helper_definitions_tests_compiler_executed=False),separators=(',',':')))
