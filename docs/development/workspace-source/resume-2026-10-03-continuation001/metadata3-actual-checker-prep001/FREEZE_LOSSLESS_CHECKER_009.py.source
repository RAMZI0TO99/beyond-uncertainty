"""One-use owned Source freeze: reads/AST/inert metadata, never executes helpers/tests."""
import ast
import hashlib
import json
from datetime import datetime,timezone
from pathlib import Path

OWN=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
def digest(data):return hashlib.sha256(data).hexdigest()
def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')+b'\n'
def write(name,value):
    data=(json.dumps(value,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
    with (OWN/name).open('xb') as output:output.write(data)
    assert (OWN/name).read_bytes()==data
def funcs(tree):return {node.name:node for node in tree.body if isinstance(node,ast.FunctionDef)}
def methods(tree):return {node.name:ast.dump(node,include_attributes=False) for cls in tree.body if isinstance(cls,ast.ClassDef) for node in cls.body if isinstance(node,ast.FunctionDef) and node.name.startswith('test_')}

old_manifest=(OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_008.json').read_bytes()
assert digest(old_manifest)=='93f8754ed186873cba93960ce027558b86f70fbb2a9f9ee37a3c18fde7b5d4ee'
for row in json.loads(old_manifest)['payloads']:
    data=(OWN/row['path']).read_bytes();assert digest(data)==row['sha256'] and len(data)==row['bytes']
protocol=json.loads((OWN/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_009.json').read_bytes())
selected=protocol['selected_checker'];source=(OWN/selected['path']).read_bytes()
assert digest(source)==selected['sha256'] and len(source)==selected['bytes'] and len(source)<=262144
selected_tests=protocol['selected_planned_tests'];tests=(OWN/selected_tests['path']).read_bytes()
assert digest(tests)==selected_tests['sha256'] and len(tests)==selected_tests['bytes']
source_tree=ast.parse(source);test_tree=ast.parse(tests)
old_funcs=funcs(ast.parse((OWN/'review-metadata3-actual006-corrected008.TEMPLATE.py').read_bytes()));new_funcs=funcs(source_tree)
for name in ('read','typed_equal','exact_raw9','current_stream_file','final_reobserve','own_output_read','own_output_cap','once','whole_parent','whole_parent_after'):
    assert ast.dump(old_funcs[name],include_attributes=False)==ast.dump(new_funcs[name],include_attributes=False)
old_methods=methods(ast.parse((OWN/'test_metadata3_actual_checker_preparation_002.py').read_bytes()));new_methods=methods(test_tree)
assert len(old_methods)==19 and len(new_methods)==25 and all(new_methods[name]==value for name,value in old_methods.items())
calls={name:min(node.lineno for node in ast.walk(new_funcs['decision']) if isinstance(node,ast.Call) and isinstance(node.func,ast.Name) and node.func.id==name) for name in ('final_reobserve','compact_whole_observations','detail_publication_bytes','once')}
assert calls['final_reobserve']<calls['compact_whole_observations']<calls['detail_publication_bytes']<calls['once']
assert len(protocol['whole_observation_projection13']['keys'])==13 and protocol['detail15_keys']==json.loads((OWN/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_008.json').read_bytes())['detail15_keys']
audit=dict(schema_version=1,record_type='metadata3_lossless009_author_static_preservation',source_author='/root/actual_record_checker',
    selected_source_sha256=selected['sha256'],selected_test_sha256=selected_tests['sha256'],old19_test_method_ASTs_exact=True,
    full_current_whole_and_final_reader_ASTs_exact=True,general_input_reader_and_owned_output_reader_ASTs_exact=True,
    decision_AST_call_order=calls,detail15_core12_unchanged=True,top_level_function_count=len(new_funcs),planned_test_method_count=len(new_methods),
    author_checks_not_independent_acceptance=True,AST_and_inert_CodeType_only=True,actual_source_peer=None,actual_binding=None,actual_lease=None,actual_fit=None,actual_ready=None,actual_results=None,
    reviewed_definitions_imports_mains_tests_Git_FFI_PS_native_executed=False)
write('AUTHOR_LOSSLESS_STATIC_PRESERVATION_009.json',audit)

# Wire-size arithmetic only, using explicit all-f placeholder SHA strings in memory.
# This creates no actual result, pointer, binding, PASS or metadata fixture artifact.
contract=protocol['whole_observation_projection13'];guard=OWN.parent/'consumer005-guard006-runtime-prep001'
max_projection=dict(schema_version=1,record_type=contract['record_type'],scope=protocol['scope'],phase='before',
    whole_result=dict(path=str(guard/'whole-runtime-before/result.json'),sha256='f'*64),table_sources=[],roots=contract['roots'],
    path_rule=contract['path_rule'],row_rule=contract['row_rule'],
    counts=dict(unique_file_count=5390,omitted_observation_count=5390,retained_observation_count=4096,total_observation_count=9486,per_tree=dict(base=5368,scripts=22)),
    ordered_projected_observations_sha256='f'*64,maximum_detail_bytes=2097152,maximum_retained_observations=4096)
for role in contract['table_roles']:
    tree,pass_name=role.split('_')
    max_projection['table_sources'].append(dict(role=role,path=str(guard/'whole-runtime-before'/(tree+'-'+pass_name+'.json')),sha256='f'*64,bytes=4194304))
projection_bytes=len(canonical(max_projection))
budget=dict(schema_version=1,record_type='metadata3_lossless009_source_wire_budget',source_only_arithmetic=True,
    maximum_projection_encoding_bytes=projection_bytes,projection_phase='before',maximum_retained_observations=4096,maximum_full_detail_bytes=2097152,
    each_existing_whole_table_maximum_bytes=4194304,source_checker_existing_maximum_bytes=262144,selected_checker_bytes=len(source),
    removed_whole_original_row_count=5390,retained_rows_are_not_truncated=True,full_final_observation_count_stays_unchanged=True,
    wire_budget_uses_only_explicit_in_memory_placeholder_SHA_lengths=True,actual_projection_bytes=None,actual_detail_bytes=None,actual_retained_observations=None,actual_fit=None,
    complete_detail_dynamic_fit_requires_fresh_actual_data_and_prepublication_gate=True,caps_increased=False)
write('AUTHOR_PROJECTION_STATIC_BUDGET_009.json',budget)
handoff='''# Frozen009 Source handoff

Root authorized Source-only lossless projection13 and the fresh fixed successor canonical peer002. Accepted008/helper19/U006 and peer001 remain exact history. Selected009 source and planned25 test metadata are in `SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_009.json`; existing source cap262144, ordinary input8MiB and all role caps stay unchanged. The19 prior test method ASTs and full current/final whole readers remain exact. New tests are source preparation only, never results.

The original5390 complete current WHOLE rows and full final reread stay internal. Only identity-registered original observations from the completed two-tree proof are elided from publication; ordinary/runtime/source/ticket rows remain, including equal paths/facts. Closed `checks.whole_observation_projection` authenticates the actual WholeResult19 and four existing canonical streams, exact roots/path rules, raw9/file facts and5390 coverage/digest. None-phase roles omit nothing. Different U007 must independently authenticate and reconstruct every omitted row and apply the current same-API whole reader; aggregate checks cannot approve it.

The compact retained observation count1..4096 and encoded full Detail2097152 maximum are checked before any Detail/Core/whole acceptance output. Existing table caps4194304 and owned-output reader16MiB ceilings are unchanged. `AUTHOR_PROJECTION_STATIC_BUDGET_009.json` contains Source-only maximum projection wire arithmetic, never actual fit. Actual complete Detail byte/count fit remains null and must pass the fresh gate or refuse without PASS.

Author composition/freeze use owned Source reads, AST and inert CodeType only after the Root compute hold expires/releases; no helper definitions, imports, mains, tests, Git, PS, FFI or native execution. Those one-use author scripts become spent on completion. Prior manifests/payloads are rechecked before and after; this new manifest contains only finite flat owned files, not ancestor forests. Author checks do not replace a different complete009/007 Source audit.

New canonical009 peer fixed path is `../metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_002.json`. Its genuine Source SHA, actual source models/config, lease, trust, READY, tickets, phases and results all remain null. Root owns all producers and separate unit GO. Before actual phases: complete different009/U007 Source acceptance, externally selected literal source models and source-pool peer, genuine lease/trust and both READY preflights. Future isolated-helper fixture tests need explicit Root runtime GO after Source acceptance and create no real Whole PASS. Original600/90/510/450+after60/resource60 unchanged; no loaded-site/Job/OS/harddeadline/native/operational/science claim follows.
'''
with (OWN/'HANDOFF_FROZEN_LOSSLESS_009.md').open('x',encoding='utf8',newline='\n') as output:output.write(handoff)
rows=[]
for path in sorted(OWN.iterdir(),key=lambda path:path.name):
    assert path.is_file()
    a=path.read_bytes();b=path.read_bytes();c=path.read_bytes();assert a==b==c
    rows.append(dict(path=path.name,bytes=len(a),sha256=digest(a)))
manifest=dict(schema_version=1,record_type='metadata3_actual_checker_lossless009_author_frozen_source_manifest',source_author='/root/actual_record_checker',scope=protocol['scope'],
    created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),payload_count=len(rows),payloads=rows,finite_flat_owned_payload_only=True,
    selected_checker=selected,selected_planned_tests=dict(path=selected_tests['path'],bytes=len(tests),sha256=digest(tests),method_count=25,actual_results=None),
    prior_source008_manifest_sha256=digest(old_manifest),accepted008_peer_sha256='1b4eeb7636d76a30f9ae47108e4128d2a798bc9cfb3da11a980e2be89f10944c',
    different_corrected_source_review=None,actual_source_binding=None,actual_lease=None,actual_ready=None,actual_before=None,actual_after=None,actual_fit=None,actual_results=None,
    runtime_acceptance=False,operational_authority=False,reviewed_definitions_imports_mains_tests_Git_FFI_PS_native_executed=False)
write('AUTHOR_FROZEN_SOURCE_MANIFEST_009.json',manifest)
for row in rows:
    data=(OWN/row['path']).read_bytes();assert len(data)==row['bytes'] and digest(data)==row['sha256']
manifest_bytes=(OWN/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json').read_bytes()
print(json.dumps(dict(manifest_sha256=digest(manifest_bytes),manifest_bytes=len(manifest_bytes),payload_count=len(rows),selected_checker_sha256=selected['sha256'],selected_checker_bytes=len(source),planned_test_count=25,maximum_projection_encoding_bytes=projection_bytes,actual_results=None),separators=(',',':')))
