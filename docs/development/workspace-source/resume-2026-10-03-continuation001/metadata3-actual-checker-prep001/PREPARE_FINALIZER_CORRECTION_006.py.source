 error_type='KeyError',error_field='OWNER',cause='author source metadata literal map did not collect chained-name assignments',
 refusal_before_selected_checker_write=True,spent_helper=dict(path=source.name,sha256=hashlib.sha256(data).hexdigest()),
 distinct_correction=dict(path=out.name,sha256=hashlib.sha256(out.read_bytes()).hexdigest()),original_refused_helper_edited_or_replayed=False,
 checker_or_target_mains_or_tests_executed=False)
with (OUT/'OWN_FINALIZER005_REFUSAL_001.json').open('x',encoding='utf8') as stream:json.dump(record,stream,sort_keys=True,indent=2);stream.write('\n')
print(json.dumps(record))
