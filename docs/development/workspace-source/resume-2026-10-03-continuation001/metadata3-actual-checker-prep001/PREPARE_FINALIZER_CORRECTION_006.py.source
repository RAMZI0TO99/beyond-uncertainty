from pathlib import Path
OUT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
source=OUT/'FINALIZE_CHECKER_SOURCE_005.py';data=source.read_bytes();text=data.decode('utf8')
old=""" if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
  try:constants[node.targets[0].id]=ast.literal_eval(node.value)
  except (ValueError,TypeError):pass"""
new=""" if isinstance(node,ast.Assign) and all(isinstance(target,ast.Name) for target in node.targets):
  try:
   value=ast.literal_eval(node.value)
   for target in node.targets:constants[target.id]=value
  except (ValueError,TypeError):pass"""
assert text.count(old)==1;text=text.replace(old,new)
text=text.replace('source-before-final-rev003-selection004.bytes','source-before-final-rev003-selection005.bytes').replace('AUTHOR_SOURCE_METADATA_005.json','AUTHOR_SOURCE_METADATA_006.json')
out=OUT/'FINALIZE_CHECKER_SOURCE_006.py'
with out.open('x',encoding='utf8',newline='\n') as stream:stream.write(text)
