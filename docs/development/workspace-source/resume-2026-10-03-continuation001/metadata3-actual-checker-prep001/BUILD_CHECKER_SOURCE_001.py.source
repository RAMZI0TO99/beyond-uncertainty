"""Own source-text composition only. Never imports or executes checker/target code."""
import ast
import hashlib
import json
from pathlib import Path

PROJECT = Path('D:/Aenv/pro2')
OUT = PROJECT/'resume-2026-10-03-continuation001/metadata3-actual-checker-prep001'
OLD = PROJECT/'resume-2026-10-01-30h-001/guard005-root-metadata-prep002'
SOURCES = [
 (OLD/'independent-fast-metadata-review-prep002/independent-fast-metadata-review002.py','db8f141cebc1a9d25db617607f63880248d3149f148b93cfbb0e9a2689d3a5cb'),
 (OLD/'independent-fast-after-metadata-review-prep001/independent-fast-after-metadata-review002.py','6cabe10fbeeba4f5895ec14a35f18a547b3a2bf10bce4f8f3bbc4a0b586b5b07'),
]
OUT.mkdir(exist_ok=True)
preserved=[]
for i,(path,pin) in enumerate(SOURCES):
 data=path.read_bytes()
 assert hashlib.sha256(data).hexdigest()==pin and path.read_bytes()==data
 target=OUT/f'original-{i+1:02d}.source.bytes'
 with target.open('xb') as stream: stream.write(data)
 preserved.append(dict(path=str(path),sha256=pin,bytes=len(data),copy=target.name))

text=SOURCES[1][0].read_text(encoding='utf8')
tree=ast.parse(text)
lines=text.splitlines(keepends=True)
functions=[]
omitted={'fixed','main','after_main','source_closure'}
for node in tree.body:
 if isinstance(node,ast.FunctionDef) and node.name not in omitted:
  functions.append(''.join(lines[node.lineno-1:node.end_lineno])+'\n\n')
body=''.join(functions)
changes=[
 ('phase-before-005','phase-before-003'),('phase-after-005','phase-after-003'),
 ('AUTHENTICATED_742_PATH_SEQUENCE_005','AUTHENTICATED_742_PATH_SEQUENCE_003'),
 ('OPAQUE_CURRENT_CONTEXT_005','OPAQUE_CURRENT_CONTEXT_003'),('RUNTIME4_METADATA_SELECTION_005','RUNTIME4_METADATA_SELECTION_003'),
 ('METADATA_CAPTURE_005','METADATA_CAPTURE_003'),('ROOT_METADATA_AUTHORIZATION_BEFORE_005','ROOT_METADATA_AUTHORIZATION_BEFORE_003'),
 ('ROOT_METADATA_AUTHORIZATION_AFTER_005','ROOT_METADATA_AUTHORIZATION_AFTER_003'),
 ('ROOT_METADATA_PARENT_TERMINAL_BEFORE_005','ROOT_METADATA_PARENT_TERMINAL_BEFORE_003'),
 ('ROOT_METADATA_PARENT_TERMINAL_AFTER_005','ROOT_METADATA_PARENT_TERMINAL_AFTER_003'),
 ('ROOT_METADATA_PARENT_STDOUT_BEFORE_005','ROOT_METADATA_PARENT_STDOUT_BEFORE_003'),
 ('ROOT_METADATA_PARENT_STDERR_BEFORE_005','ROOT_METADATA_PARENT_STDERR_BEFORE_003'),
 ('ROOT_METADATA_PARENT_STDOUT_AFTER_005','ROOT_METADATA_PARENT_STDOUT_AFTER_003'),
 ('ROOT_METADATA_PARENT_STDERR_AFTER_005','ROOT_METADATA_PARENT_STDERR_AFTER_003'),
 ('capture-guard005-root-metadata.BOUND.py','capture-root-metadata003.BOUND.py'),
 ('INDEPENDENT_BOUND_METADATA_REVIEW_005','INDEPENDENT_BOUND_METADATA_REVIEW_003'),
 ('OWNER_WORK_WINDOW_30H_20261001_001','EXECUTION_LEASE_GG6_M3_001'),
 ('guard005','guard006'),('unit005','unit006'),('GUARD_RUNTIME_PROFILE_005','GUARD_RUNTIME_PROFILE_006'),
 ('SOURCE_PROJECTION_005','SOURCE_PROJECTION_006'),('ROOT_LAUNCH_TERMINAL_005','ROOT_LAUNCH_TERMINAL_006'),
 ('ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_005','ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_006'),
 ('ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_PROVENANCE_005','ROOT_DRIVER_SCOPED_FINISHED_RECEIPT_PROVENANCE_006'),
 ('ROOT_WHOLE_BEFORE_AUTHORIZATION_005','ROOT_WHOLE_BEFORE_AUTHORIZATION_006'),
 ('ROOT_WHOLE_AFTER_AUTHORIZATION_005','ROOT_WHOLE_AFTER_AUTHORIZATION_006'),
 ('ROOT_WHOLE_BEFORE_PARENT_TERMINAL_005','ROOT_WHOLE_BEFORE_PARENT_TERMINAL_006'),
 ('ROOT_WHOLE_AFTER_PARENT_TERMINAL_005','ROOT_WHOLE_AFTER_PARENT_TERMINAL_006'),
 ('ROOT_WHOLE_BEFORE_PARENT_STDOUT_005','ROOT_WHOLE_BEFORE_PARENT_STDOUT_006'),
 ('ROOT_WHOLE_BEFORE_PARENT_STDERR_005','ROOT_WHOLE_BEFORE_PARENT_STDERR_006'),
 ('ROOT_WHOLE_AFTER_PARENT_STDOUT_005','ROOT_WHOLE_AFTER_PARENT_STDOUT_006'),
 ('ROOT_WHOLE_AFTER_PARENT_STDERR_005','ROOT_WHOLE_AFTER_PARENT_STDERR_006'),
 ('SUPERVISE_ROOT_WHOLE_BEFORE_005.ps1','SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1'),
 ('SUPERVISE_ROOT_WHOLE_AFTER_005.ps1','SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1'),
 ('WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_005.ps1','WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1'),
 ("owner_end_utc='2026-10-02T22:36:15Z'","owner_end_utc=OWNER_END_TEXT"),
]
for old,new in changes: body=body.replace(old,new)
# Execution lease stamps are PS7; exact fractional ticks remain Decimal, never float.
body=body.replace('Decimal(int(OWNER_END.timestamp()))','OWNER_END_TICKS')
# Root whole transports are owned by the fresh pipeline leaf, not the M3 producer.
body=body.replace("PREP/'SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1'","PIPELINE/'SUPERVISE_ROOT_WHOLE_AFTER_006.BOUND.ps1'")
body=body.replace("GUARD/'SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1'","PIPELINE/'SUPERVISE_ROOT_WHOLE_BEFORE_006.BOUND.ps1'")
body=body.replace("PREP/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1'","PIPELINE/'WRITE_ROOT_WHOLE_AFTER_AUTHORIZATION_006.BOUND.ps1'")
body=body.replace("run-consumer-guard-unit005.py","run-consumer-guard-unit006.py").replace("consumer-guard-child-005.TEMPLATE.py","consumer-guard-child-006.TEMPLATE.py")
body=body.replace('ROOT_EXECUTION_ACK_GUARD_UNIT005','ROOT_EXECUTION_ACK_GUARD_UNIT006').replace('ROOT_LAUNCH_START_005','ROOT_LAUNCH_START_006')
body=body.replace('ROOT_FIRST_LAUNCH_005.BOUND.ps1','ROOT_FIRST_LAUNCH_006.BOUND.ps1').replace('ROOT_LAUNCH_STDOUT_005','ROOT_LAUNCH_STDOUT_006').replace('ROOT_LAUNCH_STDERR_005','ROOT_LAUNCH_STDERR_006')
body=body.replace('INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_005','INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006').replace('INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_005','INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_006')
body=body.replace("bound['reviewer'] in ('/root/keepawake_stage','/root/candidate_review','/root/window_docs','/root/native_frame_explorer')","bound['reviewer']==BOUND_REVIEWER")
body=body.replace("late['reviewer'] in ('/root/keepawake_stage','/root/candidate_review','/root/window_docs','/root/native_frame_explorer')","late['reviewer']==BOUND_REVIEWER")
body=body.replace("ids=collection['ordered_ids'];names=profile['prepared_method_names']\n    expected_ids=[CHILD_TEST_NAMESPACE+'.'+profile['test_class']+'.'+name for name in names]","ids=collection['ordered_ids'];expected_ids=profile['prepared_full_ids']")
body=body.replace('==14','==24').replace('== 14','== 24')
body=body.replace("    need(type(result['events']) is list", "    events,diagnostics=event_streams(result)\n    need(type(events) is list")
body=body.replace("result['events']",'events')
body=body.replace("exact(event,('event','parent_id','id','status'));", "exact(event,('event','parent_id','id','status','diagnostic'));need(event['diagnostic'] is None,'healthy subtest no diagnostic');")
body=body.replace("else:current_stream_file(Path(row['path']),row)","else:current_stream_file(Path(row['path']),row)")
header=(OUT/'CHECKER_HEADER_001.py.source').read_text('utf8')
constant_names=('AUTH_KEYS','WHOLE_AUTH_KEYS','WHOLE_RESULT_KEYS','WHOLE_PARENT_KEYS','METADATA_PARENT_KEYS','ROOT_ACK_KEYS','GUARD_BOUND_KEYS','GUARD_LATE_KEYS','COLLECTION_KEYS','UNIT_TERMINAL_KEYS','UNIT_START_KEYS','COPY_KEYS','DRIVER_KEYS','UNIT_RESULT_KEYS')
for node in tree.body:
 if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name) and node.targets[0].id in constant_names:
  value=ast.literal_eval(node.value)
  if node.targets[0].id=='UNIT_RESULT_KEYS': value=tuple(x for x in value if x!='events')+('event_manifest','diagnostic_manifest','event_count')
  header+='\n'+node.targets[0].id+'='+repr(value)+'\n'
tail=(OUT/'CHECKER_CONTROL_001.py.source').read_text('utf8')
assembled=header+'\n'+body+'\n'+tail
ast.parse(assembled)
output=OUT/'review-metadata3-actual006.TEMPLATE.py'
with output.open('x',encoding='utf8',newline='\n') as stream: stream.write(assembled)
record=dict(schema_version=1,record_type='metadata3_checker_source_composition',source_author='/root/actual_record_checker',originals=preserved,
 preserved_function_names=[n.name for n in tree.body if isinstance(n,ast.FunctionDef) and n.name not in omitted],
 omitted_function_names=sorted(omitted),explicit_source_text_replacements=changes,old_utilities_or_target_code_executed=False,
 output=dict(path=output.name,sha256=hashlib.sha256(output.read_bytes()).hexdigest(),bytes=output.stat().st_size),actual_runtime=None)
with (OUT/'SOURCE_COMPOSITION_001.json').open('x',encoding='utf8') as stream: json.dump(record,stream,sort_keys=True,indent=2);stream.write('\n')
print(json.dumps(record['output']))
