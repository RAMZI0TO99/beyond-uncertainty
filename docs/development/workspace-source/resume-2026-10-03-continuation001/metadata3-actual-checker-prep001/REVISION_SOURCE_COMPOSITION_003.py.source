"""Prepared source-text interface correction; execute only after Root window release.
Never executes new checker definitions, old utilities or any project target.
"""
import ast,hashlib,json
from pathlib import Path
OUT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-actual-checker-prep001')
path=OUT/'review-metadata3-actual006.TEMPLATE.py'
data=path.read_bytes();assert hashlib.sha256(data).hexdigest()=='9122e65a5f3e282159ee0d162685c14e7b4ceeecb87811456ab44836035cf057'
with (OUT/'source-before-selected-rev002-interface-correction002.bytes').open('xb') as stream:stream.write(data)
text=data.decode('utf8');text=text[:text.index('\ndef sha(value):')]+'\n'+(OUT/'CHECKER_CONTROL_001.py.source').read_text('utf8')
changes=(('GUARD_RUNTIME_PROFILE_006.json','GUARD_RUNTIME_PROFILE_006-rev002.json'),
 ('run-consumer-guard-unit006.py','run-consumer-guard-unit006-rev002.bound.py'),
 ('consumer-guard-child-006.TEMPLATE.py','consumer-guard-child-006-rev002.TEMPLATE.py'),
 ('observe-whole-runtime-006.py','observe-whole-runtime-006-rev002.BOUND.py'),
 ('ROOT_FIRST_LAUNCH_006.BOUND.ps1','ROOT_FIRST_LAUNCH_006-rev002.BOUND.ps1'))
for old,new in changes:text=text.replace(old,new)
insert="\nCAPSULE_PEER_SHA='007a4fa04849b2b497046609fcc7058abc4db19d933aa932fd61420394fce2e1'\nCAPSULE_PEER_PATH=WORK/'capsule-design-independent-review001/INDEPENDENT_COMPACT_CAPSULE_REVIEW_001.json'\n"
text=text.replace("CHILD_TEST_NAMESPACE='isolated_consumer_guard_unit006'", "CHILD_TEST_NAMESPACE='isolated_consumer_guard_unit006'"+insert)
tree=ast.parse(text);node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='actual_unit');lines=text.splitlines(keepends=True)
original=''.join(lines[node.lineno-1:node.end_lineno]);corrected=original.replace("BINDINGS['source_peer_sha256']",'CAPSULE_PEER_SHA')
assert original!=corrected
text=''.join(lines[:node.lineno-1])+corrected+'\n'+''.join(lines[node.end_lineno:])
anchor="    for key,path in INPUTS.items():read(path,BINDINGS[key])"
extra="""    capsule_peer=selected(CAPSULE_PEER_PATH,CAPSULE_PEER_SHA,131072)
    need(type(capsule_peer.get('reviewer')) is str and capsule_peer['reviewer']=='/root/capsule_design_review','different Source capsule peer selected separately from capsule bytes')
    need(literals(read(GUARD/'run-consumer-guard-unit006-rev002.bound.py',DRIVER,131072)[0])['SOURCE_CAPSULE_PEER_SHA256']==CAPSULE_PEER_SHA,'actual bound driver capsule-peer literal')
"""
assert text.count(anchor)==1;text=text.replace(anchor,extra+anchor)
ast.parse(text);path.write_text(text,encoding='utf8',newline='\n')
record=dict(schema_version=1,record_type='metadata3_checker_selected_source_interface_correction',source_author='/root/actual_record_checker',before_sha256=hashlib.sha256(data).hexdigest(),
 after_sha256=hashlib.sha256(path.read_bytes()).hexdigest(),bytes=path.stat().st_size,explicit_replacements=changes,
 additional_changes=['M3 current005 input manifest/capsule exact roles','capsule bytes SHA distinct from independently reviewed capsule peer SHA','source AST reconstruction current24 full IDs',
 'current peer mode exception preserved', 'current9 planned causal methods source-only'],checker_or_target_definitions_or_mains_executed=False,actual_runtime=None)
with (OUT/'SOURCE_COMPOSITION_003.json').open('x',encoding='utf8') as stream:json.dump(record,stream,sort_keys=True,indent=2);stream.write('\n')
print(json.dumps(record))
