def need(ok,message):
    if not ok: raise ValueError(message)

def digest(data):
    return hashlib.sha256(data).hexdigest()

def raw(info):
    return [info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns,
            info.st_mode,info.st_nlink,info.st_file_attributes,info.st_birthtime_ns]

def ancestors(path):
    result=[]
    for parent in reversed(path.parents):
        info=parent.lstat()
        need(stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode)
             and not info.st_file_attributes&1024,'plain Source ancestor')
        result.append([str(parent),info.st_dev,info.st_ino])
    return result

def observe(path,cap):
    chain=ancestors(path);before=path.lstat();a=raw(before)
    need(stat.S_ISREG(before.st_mode) and before.st_nlink==1
         and not before.st_file_attributes&1024 and 0<=before.st_size<=cap,'plain bounded Source file')
    with path.open('rb',buffering=0) as stream:
        b=raw(os.fstat(stream.fileno()))
        need(a[:4]+[a[5],a[6],a[7],a[8]]==b[:4]+[b[5],b[6],b[7],b[8]]
             and a[4]==a[8],'Source path/descriptor identity')
        data=stream.read(before.st_size+1)
        need(raw(os.fstat(stream.fileno()))==b,'Source descriptor stable')
    need(raw(path.lstat())==a and ancestors(path)==chain and len(data)==before.st_size,'Source readback stable')
    return data,dict(path=str(path),sha256=digest(data),bytes=len(data),path_raw9=a,descriptor_raw9=b,ancestors=chain)

def read(path,pin=None,cap=2097152):
    path=Path(path)
    need(path.is_absolute() and path.is_relative_to(WORK),'finite own Source root')
    need(type(cap) is int and 0<cap<=8388608,'bounded Source read cap')
    if str(path) in DATA:
        data=DATA[str(path)];row=EVIDENCE[str(path)]['observations'][0]
        need(len(data)<=cap and (pin is None or digest(data)==pin),'cached Source cap/pin')
        return data
    reads=[observe(path,cap) for _ in range(3)]
    need(all(pair==reads[0] for pair in reads),'three exact Source observations')
    data,row=reads[0]
    need(pin is None or digest(data)==pin,'externally selected Source SHA')
    target=OWN/'checker-config-draft010-inputs'/('%03d-'%(len(EVIDENCE)+1)+path.name)
    with target.open('xb') as stream:stream.write(data)
    need(target.read_bytes()==data,'owned copy exact')
    EVIDENCE[str(path)]=dict(maximum=cap,observations=[pair[1] for pair in reads],copy_path=str(target),copy_sha256=digest(data))
    DATA[str(path)]=data
    return data

def pairs(items):
    result={}
    for key,value in items:
        need(key not in result,'duplicate JSON key')
        result[key]=value
    return result

def forbidden(value):
    raise ValueError('floating/nonfinite JSON token: '+value)

def decode(data):
    need(not data.startswith(b'\xef\xbb\xbf'),'JSON BOM')
    return json.loads(data.decode('utf8',errors='strict'),object_pairs_hook=pairs,parse_float=forbidden,parse_constant=forbidden)

def record(path,pin=None,cap=2097152):
    return decode(read(path,pin,cap))

def same(actual,expected,label):
    need(type(actual) is type(expected),'typed Source difference: '+label)
    if type(actual) is dict:
        need(actual.keys()==expected.keys(),'closed Source keys: '+label)
        for key,value in expected.items():same(actual[key],value,label+'.'+key)
    elif type(actual) is list:
        need(len(actual)==len(expected),'Source list count: '+label)
        for index,value in enumerate(expected):same(actual[index],value,label+'[%d]'%index)
    else:need(actual==expected,'Source value difference: '+label)

def exact(value,keys,label):
    need(type(value) is dict and set(value)==set(keys),'closed schema: '+label)

def point(path,pin,cap=2097152):
    path=Path(path);read(path,pin,cap)
    return dict(path=str(path),sha256=pin)

def literals(data):
    tree=ast.parse(data.decode('utf8',errors='strict'))
    result={}
    for node in tree.body:
        if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name):
            name=node.targets[0].id
            try:value=ast.literal_eval(node.value)
            except (ValueError,TypeError):continue
            need(name not in result,'duplicate literal Source assignment')
            result[name]=value
    return result

def check(label):
    CHECKS.append(label)

def wire(value):
    return (json.dumps(value,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')

