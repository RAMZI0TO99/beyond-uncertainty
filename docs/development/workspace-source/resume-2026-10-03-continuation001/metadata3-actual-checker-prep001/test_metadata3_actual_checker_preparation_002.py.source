    def test_final_reread_keeps_authenticated_whole_and_narrow_runtime_policies(self):
        c=self.checker;pin='935016795f3e6908e75acbc2040a01e2e4cdb494a57c42f63a0d6eedb2372256'
        runtime=dict(path=str(c.PROJECT/'pro2/.venv/Scripts/python.exe'),sha256=pin,bytes=1,path_raw9=list(range(9)),descriptor_raw9=list(range(9)))
        whole=dict(path=str(c.WHOLE_ROOTS['base']/'fixture.exe'),sha256='4'*64,bytes=1,path_raw9=list(range(9)),descriptor_raw9=[1]*9)
        ordinary=dict(path=str(c.CHECKER/'fixture.txt'),sha256='5'*64,bytes=1,path_raw9=list(range(9)),descriptor_raw9=list(range(9)))
        calls=[];lookup={row['path']:row for row in (runtime,ordinary)}
        def reader(path,pin=None,cap=2097152,runtime=False):
            self.assertNotEqual(str(path),whole['path']);calls.append(('read',str(path),runtime));return b'x',lookup[str(path)]
        def stream(path,row):self.assertEqual(row,whole);calls.append(('whole',str(path)))
        profile=dict(runtime4_roles=[runtime])
        membership={(whole['path'],whole['sha256']):whole}
        with patch.object(c,'WHOLE_REOBSERVATIONS',membership),patch.object(c,'read',reader),patch.object(c,'current_stream_file',stream):
            def healthy():
                calls.clear();c.final_reobserve([runtime,whole,ordinary],profile)
                self.assertEqual(calls,[('read',runtime['path'],True),('whole',whole['path']),('read',ordinary['path'],False)])
            healthy()
            unselected=copy.deepcopy(runtime);unselected['path']=str(c.CHECKER/'unselected.exe');lookup[unselected['path']]=unselected
            calls.clear();c.final_reobserve([unselected],profile)
            self.assertEqual(calls,[('read',unselected['path'],False)])
            healthy()
            bad=copy.deepcopy(whole);bad['path_raw9'][0]=False
            with self.assertRaises(AssertionError):c.final_reobserve([bad],profile)
            healthy()

    def test_owned_detail16mib_roundtrip_does_not_relax_input8mib(self):
        import io
        from types import SimpleNamespace
        c=self.checker;path=c.PREP/'INDEPENDENT_ACTUAL_DETAIL_AUTH_BEFORE_006.json';wire=b'{"fixture":true}\n'
        info=SimpleNamespace(st_dev=1,st_ino=2,st_size=len(wire),st_mtime_ns=3,st_ctime_ns=4,st_birthtime_ns=4,st_mode=c.stat.S_IFREG|0o644,st_nlink=1,st_file_attributes=0)
        class MemoryFile(io.BytesIO):
            def fileno(self):return 7
        with patch.object(c,'ancestors',lambda path:[]),patch.object(c.Path,'lstat',lambda path:info),patch.object(c.Path,'open',lambda *args,**kwargs:MemoryFile(wire)),patch.object(c.os,'fstat',lambda fd:info):
            healthy=lambda:self.assertEqual(c.own_output_read(path,c.digest(wire),16777216),wire)
            healthy()
            for bad_path,bad_cap in ((path,8388608),(path,True),(c.CHECKER/'unselected.json',16777216)):
                self.recovered(healthy,lambda:c.own_output_read(bad_path,c.digest(wire),bad_cap))
            with self.assertRaisesRegex(ValueError,'invalid cap'):c.read(path,c.digest(wire),16777216)
            healthy()

    def test_python6_timestamp_requires_fraction_and_preserves_ps7_ticks(self):
        c=self.checker;healthy=lambda:c.stamp('2026-10-03T06:00:00.000000+00:00','Py')
        for bad in ('2026-10-03T06:00:00+00:00','2026-10-03T06:00:00.0000000+00:00','2026-10-03T06:00:00.00000+00:00'):
            self.recovered(healthy,lambda:c.stamp(bad,'Py'))
        c.stamp('2026-10-03T06:00:00.0000001+00:00','PS')


if __name__=='__main__':
    unittest.main()
