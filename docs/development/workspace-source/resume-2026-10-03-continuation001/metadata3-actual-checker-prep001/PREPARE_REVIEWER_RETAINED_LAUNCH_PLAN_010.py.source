        '--self-sha256','3c02e9898ed5fde8cf74f91ff780093ed66ca2a8807a1be2dfe1c9e8976d14e6',
        '--source-peer-sha256','4a7188b0f44de5ac2b454de0ba6bc0e4a07b1891fa24b23c88e119d0547d4137',
        '--binding-sha256',None,'--root-trust-sha256',None,'--execution-nonce',nonce,'--roles','all'],
    unresolved_argv_values={'--binding-sha256':'Externally Root-selected actual immutable config18 SHA after its genuine Source prerequisites.',
        '--root-trust-sha256':'Externally Root-selected genuine Root trust8 SHA after actual Root INIT/tool correlation.'},
    prerequisites=['Root-selected accepted corrected constructor002 plus genuine Root compact12.',
        'Genuine full external P16/Binder17 source prerequisite accepted before Root physical INIT.',
        'Root physical INIT/trust selected by Root from its own physical tool/cell evidence.',
        'Actual Source-only model assembly complete within existing caps; different genuine bound-pool20 accepted.',
        'Root publishes immutable helper config18 with this closed execution witness and selected actual Source records.',
        'Root explicitly supplies accepted config/trust SHA pins and releases actual reviewer retained-cell entry.'],
    runtime_owner_rule='Only actual reviewer /root/actual_record_checker launches its own future retained tool cell. Root externally correlates reported physical chunk/PID/nonce; no Root launch masquerades as this reviewer.',
    retained_behavior='One bounded retained process checks all closed before/after tickets; complete fixed/Root trust preflight before READY. Root owns separate capture and unit GO. No automatic unit launch.',
    one_use_nonce=True,source_only=True,nonce_generation_not_execution_proof=True,
    actual_tool_chunk=None,actual_PID=None,actual_binding_sha256=None,actual_Root_trust_sha256=None,actual_READY=None,actual_execution=None,
