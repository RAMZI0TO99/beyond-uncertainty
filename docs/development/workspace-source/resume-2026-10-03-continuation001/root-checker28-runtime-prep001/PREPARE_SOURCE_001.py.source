def need(v,m):
 if not v:raise ValueError(m)
def sha(v):return hashlib.sha256(v).hexdigest()
def wire(v):return (json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii')
def raw(s):return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def read(p):
 a=p.lstat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=2097152,'finite plain author input')
 with p.open('rb',buffering=0) as f:
  b=os.fstat(f.fileno());x,y=raw(a),raw(b);need(x[:4]+[x[8],x[5],x[6],x[7]]==y[:4]+[y[8],y[5],y[6],y[7]] and x[4]==x[8],'author cross identity');v=f.read(a.st_size+1);need(raw(b)==raw(os.fstat(f.fileno())),'author descriptor drift')
 need(raw(a)==raw(p.lstat()) and len(v)==a.st_size,'author path drift');return v,dict(path=str(p),bytes=len(v),sha256=sha(v),path_raw9=x,descriptor_raw9=y)
def put(name,v):
 p=PREP/name;need(not p.exists(),'own create-once '+name)
 with p.open('xb') as f:need(f.write(v)==len(v),'full own write')
 need(p.read_bytes()==v,'own readback')
def change(text,old,new,count=None):
 n=text.count(old);need(n>0 and (count is None or n==count),'source anchor '+repr(old));return text.replace(old,new)
def tests(tree):return {(c.name,n.name):n for c in tree.body if isinstance(c,ast.ClassDef) for n in c.body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}
def ah(n):return sha(ast.dump(n,include_attributes=False).encode('utf8'))
def ps_functions(text):
 import re
 lines=text.splitlines(keepends=True);result={}
 for i,line in enumerate(lines):
  match=re.match(r'^function ([A-Za-z0-9_-]+)',line)
  if match:
   end=i+1 if line.rstrip().endswith('}') else next(j+1 for j in range(i+1,len(lines)) if lines[j].rstrip()=='}')
   result[match.group(1)]=''.join(lines[i:end])
 return result

