 foreach($key in @($si.EnvironmentVariables.Keys)){if($key -match "^(GIT_|PYTHON)"){[void]$si.EnvironmentVariables.Remove($key)}}
 foreach($key in @('OMP_NUM_THREADS','MKL_NUM_THREADS','OPENBLAS_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS')){$si.EnvironmentVariables[$key]='1'}
 $si.Arguments=(@('-I','-S','-B','-X','utf8',$Runner,'--expected-self-sha256',$ExpectedRunnerSha256,'--expected-parent-sha256',$ExpectedSelfSha256,'--expected-test-sha256',$ExpectedTestSha256,'--expected-helper-sha256',$ExpectedHelperSha256,'--expected-helper-source-peer-sha256',$ExpectedHelperSourcePeerSha256,'--expected-projection-sha256',$ExpectedProjectionSha256,'--expected-root-go-sha256',$ExpectedRootGoSha256)-join ' ')
