 foreach($leaf in @('ROOT_PARENT_STARTED_001.json','ROOT_PARENT_TERMINAL_001.json','ROOT_PARENT_STDOUT_001.bin','ROOT_PARENT_STDERR_001.bin')){Absent (Join-Path $Prep $leaf);Absent ((Join-Path $Prep $leaf)+'.staging')};Absent (Join-Path $Work 'root-checker28-runtime001')
 $os=Get-CimInstance -ClassName Win32_OperatingSystem;$disk=Get-PSDrive -Name D;$ram=[long]$os.FreePhysicalMemory*1024;$free=[long]$disk.Free;$resourceUtc=[DateTimeOffset]::UtcNow.ToString('o')
