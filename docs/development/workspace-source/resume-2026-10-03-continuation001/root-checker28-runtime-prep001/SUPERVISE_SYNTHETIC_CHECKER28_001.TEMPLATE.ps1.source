 $hp=Json (Read-Pinned $HelperPeer $ExpectedHelperSourcePeerSha256 65536);Exact $hp @('schema_version','record_type','created_utc','reviewer','source_author','scope','verdict','checker_template_sha256','source_manifest_sha256','full_source_details_sha256','target_execution','actual_binding','tests_executed','runtime_acceptance','operational_authority')
