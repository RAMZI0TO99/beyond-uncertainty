function Need([bool]$v,[string]$m){if(-not $v){throw $m}}
function Hash([byte[]]$v){$h=[Security.Cryptography.SHA256]::Create();try{return [BitConverter]::ToString($h.ComputeHash($v)).Replace('-','').ToLowerInvariant()}finally{$h.Dispose()}}
function Read-Pinned([string]$p,[string]$pin,[long]$cap){
 Need ($pin -cmatch '\A[0-9a-f]{64}\z') 'Exact external SHA';$a=Get-Item -LiteralPath $p -Force
 Need (-not $a.PSIsContainer -and -not ($a.Attributes -band [IO.FileAttributes]::ReparsePoint) -and $a.Length -le $cap) 'Plain capped native input'
 $s=[IO.File]::Open($p,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read);$m=[IO.MemoryStream]::new()
 try{Need ($s.Length -eq $a.Length -and $s.Length -le $cap) 'Opened cap';$buf=[byte[]]::new(4096);do{$n=$s.Read($buf,0,4096);Need ($m.Length+$n -le $cap) 'Physical input cap';$m.Write($buf,0,$n)}while($n -gt 0);$v=$m.ToArray()}finally{$s.Dispose();$m.Dispose()}
 $b=Get-Item -LiteralPath $p -Force;Need ($a.Length -eq $b.Length -and $a.Length -eq $v.Length -and $a.LastWriteTimeUtc.Ticks -eq $b.LastWriteTimeUtc.Ticks -and $a.CreationTimeUtc.Ticks -eq $b.CreationTimeUtc.Ticks -and $a.Attributes -eq $b.Attributes -and (Hash $v) -ceq $pin) 'Native input preservation'
 return ,$v
}
function Json([byte[]]$v){
 $text=[Text.UTF8Encoding]::new($false,$true).GetString($v);Need (-not $text.StartsWith([string][char]0xfeff,[StringComparison]::Ordinal)) 'No BOM'
 $pattern='"(?:\\["\\/bfnrt]|\\u[0-9A-Fa-f]{4}|[^"\\\x00-\x1f])*"|-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|true|false|null|[{}\[\],:]'
 $tokens=[regex]::Matches($text,$pattern);$stack=[Collections.Generic.Stack[Collections.Generic.HashSet[string]]]::new();$pos=0
 foreach($t in $tokens){Need ($text.Substring($pos,$t.Index-$pos) -cmatch '\A\s*\z') 'JSON lexical gap';$pos=$t.Index+$t.Length
  if($t.Value -ceq '{'){$stack.Push([Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal));Need ($stack.Count -le 40) 'JSON depth'}
  elseif($t.Value -ceq '}'){Need ($stack.Count -gt 0) 'JSON stack';[void]$stack.Pop()}
  elseif($t.Value.StartsWith('"') -and $text.Substring($pos) -cmatch '\A\s*:'){$k=(('{"k":'+$t.Value+'}')|ConvertFrom-Json).k;Need ($stack.Count -gt 0 -and $stack.Peek().Add($k)) 'JSON duplicate key'}
  elseif($t.Value -cmatch '\A-?[0-9]'){Need ($t.Value -cnotmatch '[.eE]') 'JSON float refused'}
 };Need ($stack.Count -eq 0 -and $text.Substring($pos) -cmatch '\A\s*\z') 'JSON closed lexical body';return ($text|ConvertFrom-Json)
}
function Exact($v,[string[]]$keys){Need ($v -is [Management.Automation.PSCustomObject] -and (($v.PSObject.Properties.Name|Sort-Object)-join ',') -ceq (($keys|Sort-Object)-join ',')) 'Closed record keys'}
function PS7([string]$v){Need ($v -cmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{7}\+00:00\z') 'Genuine PS7';$d=[DateTimeOffset]::Parse($v,[Globalization.CultureInfo]::InvariantCulture);Need ($d.ToString('o') -ceq $v) 'Canonical PS7';return $d}
function Absent([string]$p){Need (-not [IO.File]::Exists($p) -and -not [IO.Directory]::Exists($p)) 'One-use output already exists'}
function Publish([string]$p,[byte[]]$v){Need ($v.Length -le 65536) 'Own output cap';Absent $p;$tmp=$p+'.staging';Absent $tmp;$s=[IO.File]::Open($tmp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None);try{$s.Write($v,0,$v.Length);$s.Flush($true)}finally{$s.Dispose()};[void](Read-Pinned $tmp (Hash $v) 65536);[IO.File]::Move($tmp,$p);[void](Read-Pinned $p (Hash $v) 65536)}
function Wire($v){return [Text.UTF8Encoding]::new($false).GetBytes(($v|ConvertTo-Json -Compress -Depth 20)+"`n")}
