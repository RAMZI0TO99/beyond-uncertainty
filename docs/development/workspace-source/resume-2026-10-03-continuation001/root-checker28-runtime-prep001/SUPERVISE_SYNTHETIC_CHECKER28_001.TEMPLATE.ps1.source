 Need ($hp.schema_version -is [int] -and $hp.schema_version -eq 1 -and $hp.record_type -ceq 'independent_metadata3_checker_source_review' -and $hp.reviewer -ceq '/root' -and $hp.source_author -ceq '/root/actual_record_checker' -and $hp.scope -ceq 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY' -and $hp.verdict -ceq 'PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY' -and $hp.checker_template_sha256 -ceq $ExpectedHelperSha256 -and $hp.source_manifest_sha256 -ceq $SourceManifestSha -and $hp.full_source_details_sha256 -ceq $FullPeerSha -and $null -eq $hp.actual_binding -and $hp.target_execution -is [bool] -and -not $hp.target_execution -and $hp.tests_executed -is [bool] -and -not $hp.tests_executed -and $hp.runtime_acceptance -is [bool] -and -not $hp.runtime_acceptance -and $hp.operational_authority -is [bool] -and -not $hp.operational_authority) 'Selected009 helper Source-only proof'
