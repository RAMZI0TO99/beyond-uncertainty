import os, json, hashlib, datetime, stat
from pathlib import Path
W=Path(r"D:\Aenv\pro2\resume-2026-10-03-continuation001")
P=W/"root-checker28-runtime-prep001"
def h(b): return hashlib.sha256(b).hexdigest()
def raw(s): return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,s.st_file_attributes,s.st_birthtime_ns]
def observe(p):
    a=p.lstat(); assert stat.S_ISREG(a.st_mode) and not(a.st_file_attributes&1024)
    with p.open("rb") as f:
        d=f.read(262145); fs=os.fstat(f.fileno())
    b=p.lstat(); assert len(d)<=262144 and raw(a)==raw(b)
    # Same API raw9 roundtrip; fstat API8 excludes known path/fstat ctime difference.
    assert [fs.st_dev,fs.st_ino,fs.st_size,fs.st_mtime_ns,fs.st_mode,fs.st_nlink,fs.st_file_attributes,fs.st_birthtime_ns]==[a.st_dev,a.st_ino,a.st_size,a.st_mtime_ns,a.st_mode,a.st_nlink,a.st_file_attributes,a.st_birthtime_ns]
    return {"path":str(p),"sha256":h(d),"bytes":len(d),"raw9_before":raw(a),"raw9_after":raw(b)},d
rows={}
for name in ("SUPERVISE_SYNTHETIC_CHECKER28_001.TEMPLATE.ps1","RUN_SYNTHETIC_CHECKER28_001.TEMPLATE.py","ROOT_SYNTHETIC_CHECKER28_GO_001.json","PRO3_CHECKER28_INTERVAL_ACK_001.json","ROOT_PARENT_TERMINAL_001.json","ROOT_PARENT_STDOUT_001.bin","ROOT_PARENT_STDERR_001.bin","ROOT_GO_OBSERVER_REFUSAL_001.json"):
    rows[name],data=observe(P/name)
    if name.endswith(".json"): rows[name]["record"]=json.loads(data)
parent=(P/"SUPERVISE_SYNTHETIC_CHECKER28_001.TEMPLATE.ps1").read_bytes().decode("utf-8-sig")
lines=parent.splitlines()
assert "function PS7" in lines[55] and "Genuine PS7" in lines[55]
assert "$created=PS7 $go.created_utc;$expires=PS7 $go.expires_utc" in lines[85]
assert "$child.Start()" in lines[96]
go=rows["ROOT_SYNTHETIC_CHECKER28_GO_001.json"]["record"]
terminal=rows["ROOT_PARENT_TERMINAL_001.json"]["record"]
assert h(parent.encode("utf-8"))=="e733a2551f6c0b524c173a121733b819fd327d84eebf160f3ef3a83fbd07c5fa"
assert terminal["failure"]=="Genuine PS7" and terminal["exit_code"] is None
assert go["created_utc"]=="2026-10-03T15:48:48.317704+00:00"
assert go["expires_utc"]=="2026-10-03T15:55:00.000000+00:00"
assert rows["ROOT_PARENT_STDOUT_001.bin"]["bytes"]==0 and rows["ROOT_PARENT_STDERR_001.bin"]["bytes"]==0
absent=(P/"ROOT_PARENT_STARTED_001.json",W/"root-checker28-runtime001")
for p in absent: assert not os.path.lexists(p)
tool={"chunk_id":"ee39ea","wall_time_seconds":"1.0891236","exit_code":1,"output":"","session_id":None}
result={"schema_version":1,"record_type":"root_synthetic_checker28_actual_parent001_prechild_refusal","author":"/root","scope":"SYNTHETIC_METADATA3_CHECKER28_STDLIB_REGRESSIONS_ONLY","recorded_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"decision":"PRESERVE_SPENT_PARENT001_GO001_ACK001_FRESH_SOURCE_SUCCESSOR_REQUIRED","actual_root_physical_tool":tool,"root_clock_before_utc":"2026-10-03T15:49:51Z","root_clock_after_utc":"2026-10-03T15:49:53Z","conservative_clock_bracket_upper_seconds":3,"physical_limit_seconds":60,"native_terminal_scope":"Parent preflight failed before resource sampling/start record/child Start; terminal child cleanup fields false reflect nonentry, not completed child cleanup proof.","failure_attribution":"Root GO writer supplied six fractional digits; unchanged parent requires genuine native DateTimeOffset roundtrip seven digits. PS7 here is timestamp domain, not PowerShell version.","source_guard_lines":[{"line":56,"text":lines[55]},{"line":86,"text":lines[85]},{"line":97,"text":lines[96]}],"observed_preserved_files":list(rows.values()),"named_path_absences":[str(p) for p in absent],"python_test_job_started":False,"synthetic_tests_run":False,"helper_execution":False,"current_runtime_PASS":False,"whole_host_quiet_or_global_process_scan":False,"operational_authority":False,"source_guards_caps_floors_unchanged":True,"one_use_objects_spent":["parent001","GO001","ACK001"],"replay_retimestamp_extension_permitted":False,"root_pro3_explicit_early_release":"Root sent explicit early release after ee39ea terminal had been read; Pub HOLD separately explicitly released at 16:01 UTC. Neither release supplies new execution authority.","required_successor":"Fresh namespace002 Source with different full source peer, fresh Pro3 ACK, and genuine Root GO created/expires native seven-digit timestamps before a new physical attempt."}
dest=P/"ROOT_ACTUAL_CHECKER28_PRECHILD_REFUSAL_001.json"
wire=(json.dumps(result,sort_keys=True,indent=2,allow_nan=False)+"\n").encode()
with dest.open("xb") as f:f.write(wire)
r,b=observe(dest);assert b==wire
print(json.dumps({"path":str(dest),"sha256":r["sha256"],"bytes":r["bytes"],"decision":result["decision"],"tests_run":False}))

