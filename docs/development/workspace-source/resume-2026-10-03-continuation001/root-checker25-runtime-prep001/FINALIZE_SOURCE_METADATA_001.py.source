"""Final author metadata/readback only; no selected source execution."""
import ast
import hashlib
import json
import os
import stat
from datetime import datetime, timezone
from pathlib import Path

WORK=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001')
PREP=WORK/'root-checker25-runtime-prep001'
AUTHOR='/root/bootstrap_stage'
SCOPE='SYNTHETIC_METADATA3_CHECKER25_STDLIB_REGRESSIONS_ONLY'
RUNNER=PREP/'RUN_SYNTHETIC_CHECKER25_001.TEMPLATE.py'
PARENT=PREP/'SUPERVISE_SYNTHETIC_CHECKER25_001.TEMPLATE.ps1'
def need(value,message):
    if not value:raise ValueError(message)
def sha(data):return hashlib.sha256(data).hexdigest()
def wire(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode('ascii')
def put(name,data):
    with (PREP/name).open('xb') as stream:need(stream.write(data)==len(data),'full own metadata write')
    need((PREP/name).read_bytes()==data,'own metadata readback')
def raw(info):return [getattr(info,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def observe(path):
    before=path.lstat();need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and not before.st_file_attributes&1024 and 0<=before.st_size<=2097152,'finite plain source file')
    with path.open('rb',buffering=0) as stream:
        opened=os.fstat(stream.fileno());a,b=raw(before),raw(opened)
        need(a[:4]+[a[8],a[5],a[6],a[7]]==b[:4]+[b[8],b[5],b[6],b[7]] and a[4]==a[8],'source cross API identity')
        data=stream.read(before.st_size+1);need(raw(opened)==raw(os.fstat(stream.fileno())),'descriptor same API source identity')
    need(raw(before)==raw(path.lstat()) and len(data)==before.st_size,'path same API source identity')
    return data,dict(bytes=len(data),sha256=sha(data),path_raw9=a,descriptor_raw9=b)

def finalize():
    need(Path(__file__).absolute()==PREP/'FINALIZE_SOURCE_METADATA_001.py','owned metadata path')
    runner=RUNNER.read_bytes();parent=PARENT.read_bytes()
    need(sha(runner)=='0d232235a9b72e1be9eb3167fd20c658e92674736c1fa6274c989fa618fc5987','selected final runner')
    need(sha(parent)=='793cc0589f5cafbd93676056555cdbbbb4156ad145d07e0f6c5c625c140e4051','selected final parent')
    parsed=ast.parse(runner)
    need('len(set(expected))==25' in runner.decode() and not any(type(n.value) is int and n.value==19 for n in ast.walk(parsed) if isinstance(n,ast.Constant)),'all direct count checks25')
    projection=json.loads((PREP/'CHECKER25_DISCOVERY_PROJECTION_001.json').read_bytes())
    plans=json.loads((PREP/'CHECKER25_TEST_PLAN_001.json').read_bytes())
    contract=json.loads((PREP/'SOURCE_CONTRACT_001.json').read_bytes())
    need(len(projection['methods'])==len(projection['ordered_ids'])==len(set(projection['ordered_ids']))==25,'exact unique25 IDs')
    need(projection['ordered_ids']==sorted(projection['ordered_ids']),'unittest lexical ordering plan')
    need(plans['old19_AST_exact'] is True and len(plans['new_method_names'])==6 and plans['declared_subtest_sites']==6,'25 source plan counts')
    need(contract['runner']['sha256']==sha(runner) and contract['parent']['sha256']==sha(parent),'source contract actual identities')
    actual_roles=[PREP/'ROOT_SYNTHETIC_CHECKER25_GO_001.json',PREP/'INDEPENDENT_CHECKER25_RUNNER_SOURCE_REVIEW_001.json',
                 *[PREP/name for name in contract['parent_outputs']],WORK/'root-checker25-runtime001']
    need(all(not path.exists() for path in actual_roles),'all new actual roles absent')
    selected_sources=[RUNNER,PREP/'PREPARE_SOURCE_001.py',PREP/'PREPARE_SOURCE_002.py',Path(__file__)]
    python_metadata=[]
    for path in selected_sources:
        data,observation=observe(path);tree=ast.parse(data)
        python_metadata.append(dict(path=path.name,sha256=observation['sha256'],bytes=len(data),
            top_level_functions=[node.name for node in tree.body if isinstance(node,ast.FunctionDef)],
            top_level_classes=[node.name for node in tree.body if isinstance(node,ast.ClassDef)],
            syntax='AST_PARSE_ONLY',selected_definitions_executed=False))
    static=dict(schema_version=1,record_type='author_checker25_static_source_metadata',source_author=AUTHOR,scope=SCOPE,
        created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),python_sources=python_metadata,
        PS_parser=dict(path=PARENT.name,sha256=sha(parent),bytes=len(parent),errors=0,functions=9,tool_chunk='474b7b',source_executed=False),
        all19_test_method_ASTs_exact=True,planned_unique_direct_methods=25,new_lossless_controls=6,declared_subtest_sites=6,
        actual_tests=None,actual_subtests=None,actual_GO=None,actual_Pro3_ACK=None,
        future_roles_absent=[str(path) for path in actual_roles],independent_source_acceptance=False,
        own_composer_refusal_preserved=True,prefreeze_uniqueness_count_correction_preserved=True,
        selected_target_compiled=False,selected_definitions_executed=False,tests_executed=False,
        Git_executed=False,FFI_executed=False,parent_launched=False,operational_authority=False)
    put('AUTHOR_STATIC_SOURCE_METADATA_001.json',wire(static))
    recipe=dict(schema_version=1,record_type='checker25_future_root_launch_recipe',source_author=AUTHOR,scope=SCOPE,
        status='SOURCE_ONLY_UNBOUND_UNRUN',selected_runner=contract['runner'],selected_parent=contract['parent'],
        selected_projection=contract['discovery_projection'],
        parent_parameters=contract['parent_cli'],runner_parameters=contract['runner_cli'],
        fixed_child_executable=str(WORK.parent/'runtimes/week8-python313-frozen-001/python.exe'),
        fixed_child_sha256='5341746f92483a93e44c313de830f2fba2956f0759094404a16b2fed06c9a2ed',
        fixed_child_flags=['-I','-S','-B','-X','utf8'],one_thread_environment=True,stdin_closed_empty=True,
        ROOT_owning_physical_envelope_required=True,physical_limit_seconds=60,parent_child_cutoff_seconds=52,parent_cleanup_cutoff_seconds=57,
        noNonInteractive=True,OS_Job_or_descendant_proof=False,ram_floor_bytes=1073741824,disk_floor_bytes=10737418240,
        phase_order=['different full Source reviewer selects this finite packet and issues closed12 receipt',
                    'ROOT authenticates fresh genuine Pro3 scope ACK externally; no old19/expired Pro3 window reuse',
                    'ROOT selects all eight external CLI SHA values and creates genuine fresh closed15 GO',
                    'ROOT starts fixed source parent with retained physical owning tool, hidden and noNonInteractive',
                    'parent preflight checks Source/owner/GO/resource and launches isolated base child once',
                    'different actual reviewer correlates physical60, reaping/drain/full streams and every25 direct/subtest result before scoped acceptance'],
        actual_source_peer=None,actual_Pro3_scope_ACK=None,actual_GO=None,actual_cli_SHA_values=None,actual_physical_parent=None,actual_acceptance=None,
        prohibition='No entry authorized by this recipe. Old19 is spent. No actual metadata/current24/native/science/project test execution or scope expansion.')
    put('ROOT_LAUNCH_RECIPE_001.json',wire(recipe))
    handoff='''# Checker25 fresh synthetic Source preparation

Author: `/root/bootstrap_stage`. This package is frozen author source only, with a different full source review and genuine future ROOT/Pro3 admission still required. No test, loader, selected checker definition, helper main or parent has run. The fresh private output is `WORK/root-checker25-runtime001`; all actual GO/source-peer/parent/result roles are absent.

The selected checker009 is `3c02e989…` (146200 bytes) and test003 is `11babbb0…` (34563 bytes), authenticated by genuine ROOT compact Source002 `4a7188b0…`, full different review `556bd1a5…` and selected55-payload manifest `8b296a86…`. Runtime source guards freshly hash/read all55 source packet payloads before and after the future suite. The author preserved68 independent original/copy pairs, including the old19 accepted Source002 reference. Old19 execution/acceptance is historical and spent.

The exact25 sorted IDs and full method AST hashes come from source AST only. All19 original method ASTs remain exact, and six new lossless methods cover synthetic5390 reconstruction, origin retention, table pointer/type/path/order/alias drift, nonwhole4096 and detail2MiB boundaries with healthy/refusal/restoration controls. Six declared `subTest` sites and their loop ASTs are recorded as plans. Actual subtest counts remain None. Synthetic fixtures and mocks establish no genuine Root metadata/whole/runtime/site/current24 evidence.

The new runner retains every reference recorder/reader function and class AST except its scoped main. The parent retains all nine accepted PowerShell function texts, including Ordinal BOM rejection. It uses the fixed base Python `-I -S -B -X utf8`, closed stdin, cleared inherited GIT_/PYTHON variables, one-thread environment, fresh1GiB RAM/10GiB D floors and resource age60 through spawn. Pipes are capped64KiB each. Source thresholds52 child and57 reap/drain from original parent entry reserve the complete physical60 ROOT envelope. ROOT must observe physical completion separately; provider/kernel/I/O response, descendants, OS Job and hard memory are not proved.

The future source peer uses the closed12 contract in SOURCE_CONTRACT_001.json, author exactly `/root/bootstrap_stage`, reviewer `/root`, `/root/capsule_design_review`, `/root/owner_docs_review` or `/root/binder_correction_audit`, and verdict `PASS_STATIC_SYNTHETIC_CHECKER25_RUNNER_ONLY`. ROOT GO retains the accepted closed15 layout with fresh25 scope/decision/source hashes. Genuine Pro3 scope ACK remains an external ROOT admission prerequisite correlated in its physical witness. This parent does not invent or authenticate a Pro3 producer schema. No source/result/GO hash cycle is introduced; source peer and GO are external later inputs.

Own metadata composer001 stopped before publishing runner/parent because a cosmetic error label broke its exact nine-function assertion. Its refusal/source and partial input copies remain preserved; metadata finalizer002 restored the label. A separate author static reread caught the inherited uniqueness check19 after total25 and corrected only that literal before final freeze, preserving the full draft runner/contract/audit. These are author preparation findings, never selected-target failures or runtime acceptance. Do not replay either composer.

SOURCE_MANIFEST_001.json pins this finite author packet. AUTHOR_STATIC_SOURCE_METADATA_001.json records Python AST parsing and PS parser-only zero errors. SOURCE_CHANGE_AUDIT_001.json and BEFORE_PROVENANCE_001.json retain exact source/history evidence. A different full source audit must inspect these actual bytes before any future one-use launch. All approvals, GOs, test counts, physical witnesses and acceptance remain absent/None.
'''
    put('HANDOFF.md',handoff.encode('utf8'))
    provenance=json.loads((PREP/'BEFORE_PROVENANCE_001.json').read_bytes())
    need(len(provenance['pairs'])==68,'exact68 before pairs')
    final_pairs=[]
    for entry in provenance['pairs']:
        original=Path(entry['original']);copy=PREP/entry['copy']
        left,left_meta=observe(original);right,right_meta=observe(copy)
        need(left==right and left_meta=={key:entry['initial'][key] for key in ('bytes','sha256','path_raw9','descriptor_raw9')},'original third observation stable')
        need(right_meta=={key:entry['copy_observation'][key] for key in ('bytes','sha256','path_raw9','descriptor_raw9')},'copy third observation stable')
        final_pairs.append(dict(original=str(original),copy=entry['copy'],sha256=sha(left),bytes=len(left),original_final=left_meta,copy_final=right_meta))
    put('FINAL_INPUT_OBSERVATIONS_001.json',wire(dict(schema_version=1,source_author=AUTHOR,pairs=final_pairs,
        triple_source_and_copy_observations_stable=True,selected_target_execution=False)))
    files=[];snapshots={}
    for path in sorted(PREP.rglob('*')):
        if path.is_file():
            need(path.name!='SOURCE_MANIFEST_001.json','manifest absent before freeze')
            data,meta=observe(path);relative=path.relative_to(PREP).as_posix();snapshots[relative]=(data,meta)
            files.append(dict(path=relative,bytes=len(data),sha256=sha(data)))
    manifest=dict(schema_version=1,record_type='checker25_author_frozen_source_manifest',source_author=AUTHOR,
        scope=SCOPE,created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),status='SOURCE_ONLY_DIFFERENT_REVIEW_PENDING',
        payload_count=len(files),payloads=files,preserved_original_copy_pairs=68,planned_methods=25,inherited_test_ASTs_exact=19,
        added_lossless_methods=6,declared_subtest_sites=6,actual_GO=None,actual_tests=None,actual_runtime=None,operational_authority=False)
    manifest_data=wire(manifest);put('SOURCE_MANIFEST_001.json',manifest_data)
    need(len(list(PREP.rglob('*')))>=len(files)+1,'finite packet observation')
    post=[]
    for row in files:
        data,meta=observe(PREP/row['path']);need((data,meta)==snapshots[row['path']],'all frozen packet bytes unchanged')
        post.append(dict(path=row['path'],bytes=len(data),sha256=sha(data)))
    need((PREP/'SOURCE_MANIFEST_001.json').read_bytes()==manifest_data,'manifest final readback')
    print(json.dumps(dict(status='AUTHOR_FROZEN_SOURCE_ONLY',payload_count=len(files),total_declared=len(files)+1,
        preserved_pairs=68,runner_sha256=sha(runner),parent_sha256=sha(parent),manifest_sha256=sha(manifest_data),
        manifest_bytes=len(manifest_data),contract_sha256=sha((PREP/'SOURCE_CONTRACT_001.json').read_bytes()),
        handoff_sha256=sha((PREP/'HANDOFF.md').read_bytes()),actual_tests=None)))

if __name__=='__main__':finalize()
