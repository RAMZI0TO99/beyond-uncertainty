        'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json': str(PEER.relative_to(WORK)).replace('\\', '/'),
        'metadata3-checker-independent-review001\\INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json': str(PEER.relative_to(WORK)),
        'metadata3-checker19-runtime-audit-prep001/CHECKER19_DISCOVERY_PROJECTION_002.json': 'root-checker25-runtime-prep001/CHECKER25_DISCOVERY_PROJECTION_001.json',
        'metadata3-checker19-runtime-audit-prep001\\CHECKER19_DISCOVERY_PROJECTION_002.json': 'root-checker25-runtime-prep001\\CHECKER25_DISCOVERY_PROJECTION_001.json',
        'metadata3-checker19-runtime-audit-prep001\\INDEPENDENT_CHECKER19_RUNNER_SOURCE_REVIEW_002.json': 'root-checker25-runtime-prep001\\INDEPENDENT_CHECKER25_RUNNER_SOURCE_REVIEW_001.json',
        'ea0012b190e108edcfc1dece29ed480cd369a34f1ed044edacad415d808934db': PINS[TEST][0],
        'c097c756d8cf55b1ac98a68313f5e406455b9306af63bd48a6e1cb3add70d3c1': PINS[HELPER][0],
        '1b4eeb7636d76a30f9ae47108e4128d2a798bc9cfb3da11a980e2be89f10944c': PINS[PEER][0],
        'aca7d58559403d5b4db5fffd791bfd59d12e85b230aefe09f678a18ed9c3bbb8': digest(projection_data),
        '26002': '34563', '137182': '146200',
        'ROOT_PARENT_STARTED_002': 'ROOT_PARENT_STARTED_001',
        'ROOT_PARENT_TERMINAL_002': 'ROOT_PARENT_TERMINAL_001',
        'ROOT_PARENT_STDOUT_002': 'ROOT_PARENT_STDOUT_001',
        'ROOT_PARENT_STDERR_002': 'ROOT_PARENT_STDERR_001',
    }
    applied = []
    for old, new in replacements.items():
        counts = dict(runner=runner.count(old), parent=parent.count(old))
        need(sum(counts.values()) > 0, 'missing declared combined anchor ' + old)
        runner, parent = runner.replace(old, new), parent.replace(old, new)
        applied.append(dict(old=old, new=new, occurrences=counts))
    for old, new in {'isolated_metadata3_checker_tests_002': MODULE,
        "reviewer='/root/owner_docs_review'": "reviewer='/root'",
        "len(expected)==19": "len(expected)==25", 'exact19 projection': 'exact25 projection',
        'actual runtime19 discovery exact': 'actual runtime25 discovery exact',
        'result.testsRun==19': 'result.testsRun==25', 'SYNTHETIC19_RESULT_PUBLISHED': 'SYNTHETIC25_RESULT_PUBLISHED',
        "('schema_version','record_type','reviewer','scope','module_name','test','helper','ordered_ids','methods','ordered_ids_sha256')": "('schema_version','record_type','source_author','scope','module_name','test','helper','ordered_ids','methods','ordered_ids_sha256')",
        "record_type='independent_synthetic_checker19_discovery_projection',reviewer='/root/capsule_design_review'": "record_type='author_synthetic_checker25_discovery_projection',source_author='/root/bootstrap_stage'",
    }.items():
        runner = replace(runner, old, new)
    parent = replace(parent, 'independent_checker19_runner_source_review', 'independent_checker25_runner_source_review')
    parent = replace(parent, "'/root/root_pipeline_binder'", "'/root/bootstrap_stage'")
    parent = replace(parent, "'PASS_STATIC_SYNTHETIC_CHECKER19_RUNNER_ONLY'", "'PASS_STATIC_SYNTHETIC_CHECKER25_RUNNER_ONLY'")
    parent = replace(parent, "$rp.reviewer -ceq '/root/capsule_design_review'", "($rp.reviewer -ceq '/root' -or $rp.reviewer -ceq '/root/capsule_design_review')")
    parent = replace(parent, '# UNRUN source. Root alone selects a genuine once-only synthetic GO and source peers.',
                     '# Author /root/bootstrap_stage. UNRUN source; ROOT alone selects genuine GO and a different source peer.')
    runner = replace(runner, '"""UNRUN fixed synthetic stdlib tests, no real metadata or project targets."""',
        '"""Author /root/bootstrap_stage: UNRUN synthetic25, no actual metadata or project target."""')

    runner = replace(runner, "MASTER_SHA=", "FULL_PEER=WORK/'metadata3-checker009-independent-review001/INDEPENDENT_METADATA3_CHECKER009_SOURCE_DETAILS_001.json'\nSOURCE_MANIFEST=META/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json'\nFULL_PEER_SHA='" + PINS[FULL][0] + "'\nSOURCE_MANIFEST_SHA='" + PINS[PACKET][0] + "'\nMASTER_SHA=")
    runner = replace(runner, "(GO,a.expected_root_go_sha256,65536),", "(GO,a.expected_root_go_sha256,65536),(FULL_PEER,FULL_PEER_SHA,192565),(SOURCE_MANIFEST,SOURCE_MANIFEST_SHA,10908),")
    runner = replace(runner, "source={};proof=[]", "packet=decode(read(SOURCE_MANIFEST,SOURCE_MANIFEST_SHA,10908)[0]);need(type(packet['payload_count']) is int and packet['payload_count']==55 and type(packet['payloads']) is list and len(packet['payloads'])==55,'finite accepted source packet')\n names=set()\n for entry in packet['payloads']:\n  exact(entry,('path','bytes','sha256'));name=entry['path'];need(type(name) is str and re.fullmatch(r'[A-Za-z0-9_.-]{1,160}',name) and name not in names and type(entry['bytes']) is int and 0<=entry['bytes']<=2097152 and type(entry['sha256']) is str and re.fullmatch('[0-9a-f]{64}',entry['sha256']),'finite source packet row');names.add(name);fixed.append((META/name,entry['sha256'],entry['bytes']))\n fixed=list(dict.fromkeys(fixed));source={};proof=[]")
    runner = replace(runner, 'checker_template_sha256=HELPER_SHA,target_execution=False', 'checker_template_sha256=HELPER_SHA,source_manifest_sha256=SOURCE_MANIFEST_SHA,full_source_details_sha256=FULL_PEER_SHA,target_execution=False')
    parent = replace(parent, "$MasterSha=", "$FullPeer=Join-Path $Work 'metadata3-checker009-independent-review001\\INDEPENDENT_METADATA3_CHECKER009_SOURCE_DETAILS_001.json'\n$FullPeerSha='" + PINS[FULL][0] + "'\n$SourceManifest=Join-Path $Work 'metadata3-actual-checker-prep001\\AUTHOR_FROZEN_SOURCE_MANIFEST_009.json'\n$SourceManifestSha='" + PINS[PACKET][0] + "'\n$MasterSha=")
    parent = replace(parent, "@($Projection,$ExpectedProjectionSha256,65536))", "@($Projection,$ExpectedProjectionSha256,65536),@($FullPeer,$FullPeerSha,192565),@($SourceManifest,$SourceManifestSha,10908))")
    parent = replace(parent, " foreach($row in $sources){[void](Read-Pinned $row[0] $row[1] $row[2])};foreach($row in $runtime)", " $packet=Json (Read-Pinned $SourceManifest $SourceManifestSha 10908);Need ($packet.payload_count -is [int] -and $packet.payload_count -eq 55 -and @($packet.payloads).Count -eq 55) 'Exact55 accepted source packet';$names=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)\n foreach($entry in $packet.payloads){Exact $entry @('path','bytes','sha256');Need ($entry.path -is [string] -and $entry.path -cmatch '\\A[A-Za-z0-9_.-]{1,160}\\z' -and $names.Add($entry.path) -and $entry.bytes -is [int] -and $entry.bytes -ge 0 -and $entry.bytes -le 2097152 -and $entry.sha256 -is [string] -and $entry.sha256 -cmatch '\\A[0-9a-f]{64}\\z') 'Finite source packet row';$sources+=,@((Join-Path (Join-Path $Work 'metadata3-actual-checker-prep001') $entry.path),$entry.sha256,$entry.bytes)}\n foreach($row in $sources){[void](Read-Pinned $row[0] $row[1] $row[2])};foreach($row in $runtime)", minimum=1)
    # The replacement above is restricted to the first source-check boundary:
    # post-check must observe the already captured finite source list, not rebuild it.
    inserted = parent.index(" $packet=Json")
    next_insert = parent.find(" $packet=Json", inserted + 1)
    if next_insert >= 0:
        end = parent.index(" foreach($row in $sources)", next_insert)
        parent = parent[:next_insert] + parent[end:]
    peer_guard = " $hp=Json (Read-Pinned $HelperPeer $ExpectedHelperSourcePeerSha256 65536);Exact $hp @('schema_version','record_type','created_utc','reviewer','source_author','scope','verdict','checker_template_sha256','source_manifest_sha256','full_source_details_sha256','target_execution','actual_binding','tests_executed','runtime_acceptance','operational_authority')\n foreach($key in @('record_type','created_utc','reviewer','source_author','scope','verdict','checker_template_sha256','source_manifest_sha256','full_source_details_sha256')){Need ($hp.$key -is [string]) 'Helper peer text type'}\n Need ($hp.schema_version -is [int] -and $hp.schema_version -eq 1 -and $hp.record_type -ceq 'independent_metadata3_checker_source_review' -and $hp.reviewer -ceq '/root' -and $hp.source_author -ceq '/root/actual_record_checker' -and $hp.scope -ceq 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY' -and $hp.verdict -ceq 'PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY' -and $hp.checker_template_sha256 -ceq $ExpectedHelperSha256 -and $hp.source_manifest_sha256 -ceq $SourceManifestSha -and $hp.full_source_details_sha256 -ceq $FullPeerSha -and $null -eq $hp.actual_binding -and $hp.target_execution -is [bool] -and -not $hp.target_execution -and $hp.tests_executed -is [bool] -and -not $hp.tests_executed -and $hp.runtime_acceptance -is [bool] -and -not $hp.runtime_acceptance -and $hp.operational_authority -is [bool] -and -not $hp.operational_authority) 'Selected009 helper Source-only proof'\n"
    parent = replace(parent, ' $rp=Json', peer_guard + ' $rp=Json')
    parent = replace(parent, " Need ($rp.schema_version", " foreach($key in @('record_type','created_utc','reviewer','source_author','scope','verdict','runner_source_sha256','parent_source_sha256','source_manifest_sha256')){Need ($rp.$key -is [string]) 'Runner peer text type'}\n Need ($rp.source_manifest_sha256 -cmatch '\\A[0-9a-f]{64}\\z') 'Runner peer manifest SHA'\n Need ($rp.schema_version")
    parent = replace(parent, " Need ($go.schema_version", " foreach($key in @('record_type','author','scope','created_utc','expires_utc','owner_master_sha256','owner_review_sha256','parent_source_sha256','runner_source_sha256','test_source_sha256','helper_source_sha256','helper_source_peer_sha256','discovery_projection_sha256','decision')){Need ($go.$key -is [string]) 'Root GO text type'}\n Need ($go.schema_version")
    parent = replace(parent, '$si.RedirectStandardOutput=$true;$si.RedirectStandardError=$true', '$si.RedirectStandardOutput=$true;$si.RedirectStandardError=$true;$si.RedirectStandardInput=$true\n foreach($key in @($si.EnvironmentVariables.Keys)){if($key -match "^(GIT_|PYTHON)"){[void]$si.EnvironmentVariables.Remove($key)}}\n foreach($key in @(\'OMP_NUM_THREADS\',\'MKL_NUM_THREADS\',\'OPENBLAS_NUM_THREADS\',\'NUMEXPR_NUM_THREADS\',\'VECLIB_MAXIMUM_THREADS\')){$si.EnvironmentVariables[$key]=\'1\'}')
    parent = replace(parent, " 'Owned runner start';$launched=$true", " 'Owned runner start';$launched=$true;$child.StandardInput.Close()")
    need('StringComparison]::Ordinal' in parent and 'NonInteractive' not in parent, 'Ordinal BOM and no NonInteractive')
    need('root_pipeline_binder' not in runner + parent and 'checker19' not in runner + parent, 'genuine new scope author/names')
    new_runner_tree = ast.parse(runner)
    old_runner_tree = ast.parse(captured[REF / 'RUN_SYNTHETIC_CHECKER19_001.TEMPLATE.py'])
    old_defs, new_defs = selected_definitions(old_runner_tree), selected_definitions(new_runner_tree)
    need(set(old_defs) == set(new_defs) and all(old_defs[name] == new_defs[name] for name in old_defs if name != 'main'), 'all recorder/reader function ASTs retained')
    old_ps, new_ps = ps_functions(captured[REF / 'SUPERVISE_SYNTHETIC_CHECKER19_002.TEMPLATE.ps1'].decode('utf8')), ps_functions(parent)
    need(old_ps == new_ps and len(new_ps) == 9, 'all nine accepted parent functions retained')
    runner_path = PREP / 'RUN_SYNTHETIC_CHECKER25_001.TEMPLATE.py'
    parent_path = PREP / 'SUPERVISE_SYNTHETIC_CHECKER25_001.TEMPLATE.ps1'
    put(runner_path, runner.encode('utf8'))
    put(parent_path, parent.encode('utf8'))
