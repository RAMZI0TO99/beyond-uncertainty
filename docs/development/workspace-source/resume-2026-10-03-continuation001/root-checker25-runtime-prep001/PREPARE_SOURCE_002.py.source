def digest(data):
    return hashlib.sha256(data).hexdigest()

def wire(value):
    return (json.dumps(value, ensure_ascii=True, sort_keys=True, indent=2) + '\n').encode('ascii')

def need(value, message):
    if not value:
        raise ValueError(message)

def raw(info):
    return [getattr(info, field) for field in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def observe(path):
    before = path.lstat()
    need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and not before.st_file_attributes & 1024 and 0 <= before.st_size <= 2097152, 'plain bounded author input')
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        left, right = raw(before), raw(opened)
        need(left[:4] + [left[8], left[5], left[6], left[7]] == right[:4] + [right[8], right[5], right[6], right[7]] and left[4] == left[8], 'author cross API metadata')
        data = stream.read(before.st_size + 1)
        need(raw(opened) == raw(os.fstat(stream.fileno())), 'author same API descriptor drift')
    need(raw(before) == raw(path.lstat()) and len(data) == before.st_size, 'author same API path drift')
    return data, dict(path=str(path), bytes=len(data), sha256=digest(data), path_raw9=left, descriptor_raw9=right)

def put(path, data):
    if path.exists():
        need(path.read_bytes() == data, 'exact retained own output ' + str(path))
        return
    with path.open('xb') as stream:
        need(stream.write(data) == len(data), 'full author write')
    need(path.read_bytes() == data, 'author output readback')

def replace(text, old, new, minimum=1):
    count = text.count(old)
    need(count >= minimum, 'missing source anchor ' + repr(old))
    return text.replace(old, new)

def methods(tree):
    return {(cls.name, node.name): node for cls in tree.body if isinstance(cls, ast.ClassDef)
            for node in cls.body if isinstance(node, ast.FunctionDef) and node.name.startswith('test_')}

def ast_hash(node):
    return digest(ast.dump(node, include_attributes=False).encode('utf8'))

def selected_definitions(tree):
    return {node.name: ast_hash(node) for node in tree.body if isinstance(node, (ast.FunctionDef, ast.ClassDef))}

def ps_functions(text):
    # Source metadata only. The independently reviewed PowerShell parser remains
    # the authoritative syntax check; this extraction proves retained text.
    import re
    lines = text.splitlines(keepends=True)
    starts = [index for index, line in enumerate(lines) if re.match(r'^function [A-Za-z0-9_-]+', line)]
    result = {}
    for index in starts:
        name = re.match(r'^function ([A-Za-z0-9_-]+)', lines[index]).group(1)
        if lines[index].rstrip().endswith('}'):
            end = index + 1
        else:
            end = next(row + 1 for row in range(index + 1, len(lines)) if lines[row].rstrip() == '}')
        result[name] = ''.join(lines[index:end])
    return result

def prepare():
    need(Path(__file__).absolute() == PREP / 'PREPARE_SOURCE_002.py', 'owned metadata source path')
    packet_data, packet_observation = observe(PACKET)
    need((digest(packet_data), len(packet_data)) == PINS[PACKET], 'selected packet pin')
    packet = json.loads(packet_data)
    need(packet['payload_count'] == len(packet['payloads']) == 55, 'exact55 selected packet')
    inputs = [PACKET, PEER, FULL, *[META / row['path'] for row in packet['payloads']],
              REF / 'RUN_SYNTHETIC_CHECKER19_001.TEMPLATE.py', REF / 'SUPERVISE_SYNTHETIC_CHECKER19_002.TEMPLATE.ps1',
              REF / 'SOURCE_CONTRACT_002.json', REF / 'SOURCE_MANIFEST_002.json',
              REF / 'ROOT_SYNTHETIC_CHECKER19_ACCEPTANCE_002.json',
              WORK / 'metadata3-checker19-runtime-audit-prep001/INDEPENDENT_CHECKER19_RUNNER_SOURCE_REVIEW_002.json',
              WORK / 'metadata3-checker19-runtime-audit-prep001/INDEPENDENT_CHECKER19_RUNNER_SOURCE_DETAILS_002.json',
              WORK / 'metadata3-checker19-runtime-audit-prep001/CHECKER19_DISCOVERY_PROJECTION_002.json',
              WORK / 'OWNER_CONTINUATION_20261003_001.json',
              WORK / 'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json']
    inputs = list(dict.fromkeys(inputs))
    need(all(path.is_relative_to(WORK) for path in inputs), 'finite WORK input scope')
    payload_pins = {META / row['path']: (row['sha256'], row['bytes']) for row in packet['payloads']}
    need((PREP / 'before').is_dir(), 'retained preservation namespace')
    captured, pairs = {}, []
    for ordinal, path in enumerate(inputs):
        data, initial = observe(path)
        pin = PINS.get(path, payload_pins.get(path))
        if pin is not None:
            need((digest(data), len(data)) == pin, 'frozen input pin ' + str(path))
        copy_path = PREP / 'before' / ('%03d-' % ordinal + path.name + '.bytes')
        put(copy_path, data)
        copy_data, copy_observation = observe(copy_path)
        need(copy_data == data and copy_observation['path_raw9'][:2] != initial['path_raw9'][:2], 'independent exact before copy')
        captured[path] = data
        pairs.append(dict(original=str(path), copy=str(copy_path.relative_to(PREP)), initial=initial, copy_observation=copy_observation))
    put(PREP / 'BEFORE_PROVENANCE_001.json', wire(dict(schema_version=1, source_author=AUTHOR,
        record_type='checker25_finite_input_preservation', pairs=pairs, old19_receipts_are_spent_history=True)))

    old_tree = ast.parse(captured[META / 'test_metadata3_actual_checker_preparation_002.py'])
    new_tree = ast.parse(captured[TEST])
    old_methods, new_methods = methods(old_tree), methods(new_tree)
    need(len(old_methods) == 19 and len(new_methods) == 25 and all(ast_hash(node) == ast_hash(new_methods[key]) for key, node in old_methods.items()), 'all19 method ASTs exact')
    added = sorted(set(new_methods) - set(old_methods))
    need(len(added) == 6, 'exact six new method names')
    rows = [dict(id=MODULE + '.' + cls + '.' + name, name=name, body_ast_sha256=ast_hash(node), source_line=node.lineno)
            for (cls, name), node in new_methods.items()]
    rows.sort(key=lambda row: row['id'])
    ordered_ids = [row['id'] for row in rows]
    projection = dict(schema_version=1, record_type='author_synthetic_checker25_discovery_projection',
        source_author=AUTHOR, scope=SCOPE, module_name=MODULE,
        test=dict(path=str(TEST), sha256=PINS[TEST][0], bytes=PINS[TEST][1]),
        helper=dict(path=str(HELPER), sha256=PINS[HELPER][0], bytes=PINS[HELPER][1]),
        ordered_ids=ordered_ids, methods=rows,
        ordered_ids_sha256=digest(('\n'.join(ordered_ids) + '\n').encode('utf8')))
    projection_data = wire(projection)
    projection_path = PREP / 'CHECKER25_DISCOVERY_PROJECTION_001.json'
    put(projection_path, projection_data)
    plans = []
    for (cls, name), node in sorted(new_methods.items()):
        sites = [dict(source_line=call.lineno, call_ast=ast.dump(call, include_attributes=False),
                      keyword_names=[kw.arg for kw in call.keywords]) for call in ast.walk(node)
                 if isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute) and call.func.attr == 'subTest']
        loops = [dict(source_line=loop.lineno, iterable_ast=ast.dump(loop.iter, include_attributes=False),
                      subtest_site_lines=[call.lineno for call in ast.walk(loop) if isinstance(call, ast.Call)
                          and isinstance(call.func, ast.Attribute) and call.func.attr == 'subTest'])
                 for loop in ast.walk(node) if isinstance(loop, (ast.For, ast.AsyncFor))]
        plans.append(dict(id=MODULE + '.' + cls + '.' + name, body_ast_sha256=ast_hash(node),
            inherited19=(cls, name) in old_methods, subtest_sites=sites, loop_plans=loops,
            recovered_call_sites=[call.lineno for call in ast.walk(node) if isinstance(call, ast.Call)
                and isinstance(call.func, ast.Attribute) and call.func.attr == 'recovered']))
    put(PREP / 'CHECKER25_TEST_PLAN_001.json', wire(dict(schema_version=1, source_author=AUTHOR, scope=SCOPE,
        old19_AST_exact=True, new_method_names=[name for cls, name in added], planned_direct_methods=25,
        declared_subtest_sites=sum(len(row['subtest_sites']) for row in plans), methods=plans,
        actual_test_count=None, actual_subtest_count=None,
        limitation='Sites and loop ASTs are source plans, not executed counts. Six new helpers use synthetic5390 table facts and mocks; no real whole inventory, actual metadata or current24 acceptance.')))

    runner = captured[REF / 'RUN_SYNTHETIC_CHECKER19_001.TEMPLATE.py'].decode('utf8')
    parent = captured[REF / 'SUPERVISE_SYNTHETIC_CHECKER19_002.TEMPLATE.ps1'].decode('utf8')
    replacements = {
        'root-checker19-runtime-prep002': 'root-checker25-runtime-prep001',
        'root-checker19-runtime002': 'root-checker25-runtime001',
        'RUN_SYNTHETIC_CHECKER19_001': 'RUN_SYNTHETIC_CHECKER25_001',
        'SUPERVISE_SYNTHETIC_CHECKER19_002': 'SUPERVISE_SYNTHETIC_CHECKER25_001',
        'ROOT_SYNTHETIC_CHECKER19_GO_001': 'ROOT_SYNTHETIC_CHECKER25_GO_001',
        'SYNTHETIC_METADATA3_CHECKER19': 'SYNTHETIC_METADATA3_CHECKER25',
        'root_synthetic_checker19': 'root_synthetic_checker25',
