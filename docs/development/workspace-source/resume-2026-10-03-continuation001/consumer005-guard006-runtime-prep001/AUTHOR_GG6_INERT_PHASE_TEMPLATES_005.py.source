"""Source-only current6 phase ABI derivation; no target definitions or phases run."""
import ast
import datetime
import hashlib
import json
import re
from pathlib import Path

OUT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/consumer005-guard006-runtime-prep001')

def sha(data):return hashlib.sha256(data).hexdigest()
def enc(value):return (json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def once(name,data):
    with (OUT/name).open('xb') as stream:stream.write(data)

def main():
    manifests=[];preserved=[]
    for name,key in [('FINAL_AUTHOR_SOURCE_MANIFEST_006.json','files'),('FINAL_AUTHOR_SOURCE_MANIFEST_007.json','selected_files')]:
        data=(OUT/name).read_bytes();value=json.loads(data);manifests.append({'path':name,'sha256':sha(data)})
        for row in value[key]:
            body=(OUT/row['path']).read_bytes();assert len(body)==row['bytes'] and sha(body)==row['sha256'];preserved.append(row)
    driver=(OUT/'run-consumer-guard-unit006-rev002.TEMPLATE.py').read_bytes()
    assigns={t.id:ast.literal_eval(n.value) for n in ast.parse(driver).body if isinstance(n,ast.Assign) for t in n.targets if isinstance(t,ast.Name) and t.id in ('ROOT_ACK_KEYS','BOUND_KEYS','SCOPE','AUTHOR')}
    launcher=(OUT/'ROOT_FIRST_LAUNCH_006-rev002.TEMPLATE.ps1').read_bytes()
    match=re.search(r'\$LateKeys\s*=\s*@\((.*?)\)',launcher.decode(),re.S);assert match
    late=re.findall(r"'([^']+)'",match.group(1));assert len(late)==14 and len(set(late))==14
    assert len(assigns['ROOT_ACK_KEYS'])==22 and len(assigns['BOUND_KEYS'])==22
    rows={}
    for role,filename,keys in [('ack','ROOT_EXECUTION_ACK_GUARD_UNIT006.TEMPLATE.json',assigns['ROOT_ACK_KEYS']),('bound','INDEPENDENT_GUARD_RUNTIME_BOUND_REVIEW_006.TEMPLATE.json',assigns['BOUND_KEYS']),('late','INDEPENDENT_GUARD_ROOT_LAUNCH_LATE_REVIEW_006.TEMPLATE.json',late)]:
        value={key:None for key in keys}
        value.update(schema_version=1,scope=assigns['SCOPE'])
        if role=='ack':
            value.update(record_type='consumer_guard_unit006_first_run_ack',author='/root',executor='/root',max_collection_seconds=60,max_test_seconds=300)
        elif role=='bound':
            value.update(record_type='consumer_guard_unit006_bound_review',author=assigns['AUTHOR'],max_collection_seconds=60,max_test_seconds=300)
        else:
            value.update(record_type='consumer_guard_unit006_root_launch_late_review',author=assigns['AUTHOR'],target_execution=False)
        assert set(value)==set(keys)
        assert all(value[key] is None for key in keys if key.endswith('_sha256') or key in ('created_utc','expires_utc','verdict','reviewer'))
        once(filename,enc(value));rows[role]={'path':filename,'sha256':sha(enc(value)),'bytes':len(enc(value)),'keys':list(keys)}
    for row in preserved:
        body=(OUT/row['path']).read_bytes();assert len(body)==row['bytes'] and sha(body)==row['sha256']
    once('HANDOFF_GG6_SOURCE_ADDENDUM008.md',b'GG6 source addendum008 supplies only three fresh inert current6 phase templates.\n\nACK22 and BOUND22 are derived from the selected current6 Python AST literals. LATE14 is derived from the selected current6 RootPS literal field set. No old GG5 JSON template is copied or treated as authority. All actual pins, times, decisions, reviewer and verdict remain null. Fixed source scope, record types, author identity and budgets are declarations only; no actual ACK or PASS exists. Root alone owns genuine actual ACK production and GO. First34 and rev00215 payloads remain exact.\n\nThe selected source peer must independently authenticate this addendum with manifest007. These are SOURCE UNBOUND templates, not phase records, replayable receipts, runtime acceptance or operational authorization.\n')
    own=(OUT/'AUTHOR_GG6_INERT_PHASE_TEMPLATES_005.py').read_bytes()
    handoff=(OUT/'HANDOFF_GG6_SOURCE_ADDENDUM008.md').read_bytes()
    result={'schema_version':1,'record_type':'gg6_source_phase_template_addendum008','author':'/root/capsule_design_review','created_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),'status':'SOURCE_UNBOUND_DIFFERENT_REVIEW_PENDING_NO_ACTUAL_PASS','parent_manifests':manifests,'effective_active_map_additions':{role:row['path'] for role,row in rows.items()},'new_phase_templates':rows,'derivation_sources':{'driver_sha256':sha(driver),'root_launcher_sha256':sha(launcher)},'preserved_source_rows':preserved,'source_compositor':{'path':'AUTHOR_GG6_INERT_PHASE_TEMPLATES_005.py','sha256':sha(own),'bytes':len(own)},'handoff':{'path':'HANDOFF_GG6_SOURCE_ADDENDUM008.md','sha256':sha(handoff),'bytes':len(handoff)},'actual_ack':None,'actual_bound':None,'actual_late':None,'actual_lease':None,'actual_bindings':None,'actual_tests':None,'target_definitions_executed':False,'runtime_acceptance':False,'operational_authority':False}
    once('AUTHOR_SOURCE_ADDENDUM_008.json',enc(result))
    print(json.dumps({'addendum_sha256':sha(enc(result)),'new_templates':rows,'preserved_rows':len(preserved),'target_definitions_executed':False}))

if __name__=='__main__':main()
