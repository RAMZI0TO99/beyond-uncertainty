''' +t[at:]
    t=t.replace('result["events"]','events')
    t=t.replace('    before_evidence=evidence_snapshot(evidence)','    evidence.extend([(OWNER_MASTER_PATH,OWNER_MASTER_SHA256,16384),(OWNER_REVIEW_PATH,OWNER_REVIEW_SHA256,65536),(OWNER_PATH,OWNER_SHA256,65536)])\n    before_evidence=evidence_snapshot(evidence)')
    t=t.replace('"test_sha256", "owner_sha256", "runtime_manifest_sha256"','"test_sha256", "owner_master_sha256", "runtime_manifest_sha256"')
    t=t.replace('static["owner_sha256"] == OWNER_SHA256','static["owner_master_sha256"] == OWNER_MASTER_SHA256')
    t=t.replace('"owner_sha256", "tests_executed"','"owner_master_sha256", "tests_executed"')
    # Failure evidence is complete within its finite role cap; never slice messages.
    t=t.replace('        once(RUNS/"refused.json",encoded({', '''        diagnostic_bytes = str(error).encode("utf-8")
        diagnostic_pointer = None
        if len(diagnostic_bytes) <= MAX_CAPTURE:
            once(RUNS/"driver-refusal-diagnostic.txt", diagnostic_bytes, MAX_CAPTURE)
            diagnostic_pointer = {"path":"driver-refusal-diagnostic.txt","bytes":len(diagnostic_bytes),"sha256":digest(diagnostic_bytes)}
        once(RUNS/"refused.json",encoded({''')
    t=t.replace('"message":str(error)[:4096],','"diagnostic":diagnostic_pointer,"diagnostic_complete":diagnostic_pointer is not None,\n             "diagnostic_oversize_refused":len(diagnostic_bytes)>MAX_CAPTURE,')
    t=t.replace('\ndef driver_main():',STREAM_SOURCE+'\ndef driver_main():')
    # Refresh resource and both original90 gates after all preflight reads, immediately before Popen.
    t=t.replace('        child=subprocess.Popen(','''        require(all(0 <= (datetime.now(timezone.utc)-timestamp(value["captured_utc"])).total_seconds() <= 90
                    for value in (runtime_record,original_context)), "both original90 throughspawn")
        require(0 <= (datetime.now(timezone.utc)-timestamp(resource["captured_utc"])).total_seconds() <= 60,
                "resource60 throughspawn")
        child=subprocess.Popen(''')
    return t

def author_observer():
    t=base_source('observe-whole-runtime-005.TEMPLATE.py')
    t=t.replace('    runtime_entry()','    runtime_entry(args.lease_sha256)\n    global OWNER_SHA256\n    OWNER_SHA256 = args.lease_sha256')
    t=t.replace('    args = parser.parse_args()','    parser.add_argument("--lease-sha256", required=True)\n    args = parser.parse_args()')
    return t

def author_ps():
    t=(GG5/'ROOT_FIRST_LAUNCH_005.TEMPLATE.ps1').read_text(encoding='utf-8')
    t=t.replace('resume-2026-10-01-30h-001','resume-2026-10-03-continuation001').replace('consumer-guard-test-runtime005','consumer005-guard006-runtime-prep001').replace('cg14-005','cg24-006').replace('unit005','unit006').replace('UNIT005','UNIT006').replace('GUARD005','GUARD006').replace('_005','_006').replace('-005','-006')
    t=t.replace("$SourcePeer = Join-Path $Prep 'inputs\\ACTUAL_SOURCE_PEER_003.json'", "$SourcePeer = 'D:\\Aenv\\pro2\\resume-2026-10-03-continuation001\\capsule-design-independent-review001\\INDEPENDENT_COMPACT_CAPSULE_REVIEW_001.json'")
    t=t.replace("@('/root/candidate_review','/root/keepawake_stage','/root/window_docs')", "@('/root/pubnative_review','/root/actual_record_checker','/root/owner_docs_review','/root')")
    t=t.replace("$LateRecord.author -cne '/root/raw_policy_worker'", "$LateRecord.author -cne '/root/capsule_design_review'")
    t=t.replace("$OwnerEnd = [DateTimeOffset]::Parse('2026-10-02T22:36:15Z')",'''$LeasePath = 'D:\\Aenv\\pro2\\resume-2026-10-03-continuation001\\EXECUTION_LEASE_GG6_M3_001.json'
$Lease = [Text.Encoding]::UTF8.GetString((Read-Plain $LeasePath $AckRecord.owner_sha256 65536)) | ConvertFrom-Json
if ($Lease.record_type -cne 'root_local_private_execution_lease' -or $Lease.author -cne '/root' -or
    $Lease.scope -cne $AckRecord.scope -or $Lease.lease_is_owner_deadline -isnot [bool] -or $Lease.lease_is_owner_deadline -or
    $Lease.operational_authority -isnot [bool] -or $Lease.operational_authority) { throw 'Bounded execution lease role' }
$OwnerEnd = [DateTimeOffset]::Parse($Lease.lease_end_utc)''')
    # External detailed canonical role review remains mandatory; add intrinsic original freshness at final PS preflight.
    before='$Started = [DateTimeOffset]::UtcNow'
    t=t.replace(before,'''$RuntimePointer=$AckRecord.runtime_snapshot
$Runtime=[Text.Encoding]::UTF8.GetString((Read-Plain $RuntimePointer.path $RuntimePointer.sha256 65536)) | ConvertFrom-Json
$ContextPointer=$Runtime.context_selection
$Context=[Text.Encoding]::UTF8.GetString((Read-Plain $ContextPointer.path $ContextPointer.sha256 1048576)) | ConvertFrom-Json
foreach ($original in @($Runtime,$Context)) {
    $age=([DateTimeOffset]::UtcNow-[DateTimeOffset]::Parse($original.captured_utc)).TotalSeconds
    if ($age -lt 0 -or $age -gt 90) { throw 'Both original context/runtime require90 second final GO gate' }
}
''' +before)
    return t

def shape(v):
    if type(v) is dict:return dict(kind='exact_builtin_dict',closed_keys=sorted(v),fields={k:shape(x) for k,x in v.items()})
    if type(v) is list:return dict(kind='exact_builtin_list',length=len(v),items=[shape(x) for x in v])
    if type(v) is str:return dict(kind='exact_builtin_str',value=v,maximum_UTF8_bytes=len(v.encode('utf-8')))
    if type(v) is bool:return dict(kind='exact_builtin_bool',value=v)
    if type(v) is int:return dict(kind='exact_builtin_int_not_bool',value=v)
    if v is None:return dict(kind='None',value=None)
    raise TypeError(type(v))

def main():
    selected=[]
    def copy(original,relative):
        b=original.read_bytes();once(OUT/relative,b);selected.append((original,OUT/relative));return dict(path=relative,bytes=len(b),sha256=sha(b))
    binding=json.loads((SOURCE/'SOURCE_GUARD_TEST_BINDINGS_005.json').read_bytes())
    test=copy(SOURCE/'test_raw_consumer_guards_005.TEMPLATE.py','test_raw_consumer_guards_005.TEMPLATE.py')
    copy(SOURCE/'SOURCE_GUARD_TEST_BINDINGS_005.json','SOURCE_GUARD_TEST_BINDINGS_005.json')
    raw=copy(SOURCE/'inputs/raw004-source.bytes','inputs/raw004-source.bytes')
    for row in binding['consumers'].values():copy(SOURCE/row['path'],row['path'])
    manifest=copy(SOURCE/'STAGED_MANIFEST_005.json','inputs/SOURCE_STAGED_MANIFEST_005.json')
    capsule=copy(CAP/'COMPACT_STATIC_SOURCE_CAPSULE_001.json','inputs/ACTUAL_SOURCE_CAPSULE_005.json')
    schema=copy(CAP/'COMPACT_CAPSULE_CLOSED_SCHEMA_001.json','inputs/COMPACT_CAPSULE_CLOSED_SCHEMA_001.json')
    derivation=copy(CAP/'CAPSULE_DERIVATION_MAP_001.json','inputs/CAPSULE_DERIVATION_MAP_001.json')
    originals=[GG5/'consumer-guard-child-005.TEMPLATE.py',GG5/'run-consumer-guard-unit005.TEMPLATE.py',GG5/'observe-whole-runtime-005.TEMPLATE.py',GG5/'ROOT_FIRST_LAUNCH_005.TEMPLATE.ps1',GG5/'GUARD_RUNTIME_PROFILE_005.json']
    for i,p in enumerate(originals):copy(p,'before/'+str(i).zfill(2)+'.bytes')
    def meta(p):
        b=p.read_bytes();s=p.lstat()
        with p.open('rb') as f:ds=os.fstat(f.fileno())
        raw=lambda n:[n.st_dev,n.st_ino,n.st_size,n.st_mtime_ns,n.st_ctime_ns,n.st_mode,n.st_nlink,n.st_file_attributes,n.st_birthtime_ns]
        return dict(bytes=len(b),sha256=sha(b),path_raw9=raw(s),descriptor_raw9=raw(ds))
    entries=[dict(original_path=str(a),copy_path=str(b.relative_to(OUT)).replace('\\','/'),runtime_source_reobserve_required=True,sha256=sha(a.read_bytes()),bytes=len(a.read_bytes()),original_metadata=meta(a),copy_metadata=meta(b)) for a,b in selected if not b.is_relative_to(OUT/'before')]
    projection=dict(schema_version=1,record_type='consumer006_finite_authenticated_leaf_projection',entries=entries,ancestor_trees_copied=False,unknown_file_absence_claimed=False,target_execution=False)
    once(OUT/'SOURCE_INPUTS_PROJECTION_006.json',enc(projection));projection_pin=sha(enc(projection))
    child=author_child();observer=author_observer();ps=author_ps()
    for name,text in [('consumer-guard-child-006.TEMPLATE.py',child),('observe-whole-runtime-006.TEMPLATE.py',observer),('ROOT_FIRST_LAUNCH_006.TEMPLATE.ps1',ps)]:once(OUT/name,text.encode('utf-8'))
    p=json.loads((GG5/'GUARD_RUNTIME_PROFILE_005.json').read_bytes())
    for key in ['prepared_method_names','preserved_actual_source003_peer','raw_policy_facts','raw_policy_facts_core','source003_peer_core','source003_peer_review','test_class','owner_end_utc','owner_sha256']:p.pop(key,None)
    p['scope']='COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY';p['record_type']='consumer_guard_unit006_runtime_profile'
    p['test']=test;p['raw_source_sha256']=raw['sha256'];p['source_manifest_sha256']=manifest['sha256'];p['consumer_source_bindings']=binding['consumers']
    p['source_projection']=dict(path='SOURCE_INPUTS_PROJECTION_006.json',sha256=projection_pin);p['source_projection_sha256']=projection_pin
    p['source_capsule']=capsule;p['capsule_schema']=schema;p['capsule_derivation']=derivation
    p['owner_master_sha256']=sha((WORK/'OWNER_CONTINUATION_20261003_001.json').read_bytes());p['owner_source_peer_sha256']=sha((WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json').read_bytes());p['execution_lease']=None;p['lease_is_owner_deadline']=False
    tree=ast.parse((SOURCE/test['path']).read_bytes());classes=[n for n in tree.body if isinstance(n,ast.ClassDef)]
    p['test_classes']=[n.name for n in classes];p['prepared_class_method_names']={n.name:sorted(m.name for m in n.body if isinstance(m,ast.FunctionDef) and m.name.startswith('test_')) for n in classes}
    assert [len(p['prepared_class_method_names'][n]) for n in p['test_classes']]==[19,5]
    p['prepared_full_ids']=['isolated_consumer_guard_unit006.'+n+'.'+m for n in p['test_classes'] for m in p['prepared_class_method_names'][n]]
    p['context_profile']['configuration_parents']=[str(ROOT.anchor),str(ROOT.parent),str(ROOT),str(WORK),str(OUT)]
    p['source_and_harness_authors_excluded_from_review']=['/root/candidate_review','/root/capsule_design_review']
    p['independent_reviewer_canonical_finite_set']=['/root/pubnative_review','/root/actual_record_checker','/root/owner_docs_review','/root']
    p['output_caps'].update(event_row_including_LF=1024,event_chunk=131072,event_diagnostic_combined_chunks=32,event_diagnostic_combined_bytes=4194304,diagnostic_complete_no_truncation=True)
    p['acyclic_binding_order']=['Source005/capsule/different capsule peer -> child/observer/RootPS templates -> profile -> driver template -> different static20 owner master -> fresh finitelease+actual source bindings+context/runtime/whole -> Root ACK22 -> different BOUND22 -> RootPS3 binding -> different LATE14 -> separate fresh Root GO']
    for key,name in [('child','consumer-guard-child-006.TEMPLATE.py'),('whole_observer','observe-whole-runtime-006.TEMPLATE.py'),('root_supervisor','ROOT_FIRST_LAUNCH_006.TEMPLATE.ps1')]:
        b=(OUT/name).read_bytes();p[key]=dict(path=name,bytes=len(b),sha256=sha(b))
    once(OUT/'GUARD_RUNTIME_PROFILE_006.json',enc(p));profile_pin=sha(enc(p))
    driver=author_driver();driver=re.sub(r'^PROFILE_SHA256 = .*$', 'PROFILE_SHA256 = '+repr(profile_pin),driver,flags=re.M)
    once(OUT/'run-consumer-guard-unit006.TEMPLATE.py',driver.encode('utf-8'))
    checks=[]
    for name in ['consumer-guard-child-006.TEMPLATE.py','run-consumer-guard-unit006.TEMPLATE.py','observe-whole-runtime-006.TEMPLATE.py']:
        b=(OUT/name).read_bytes();assert len(b)<=65536
        node=ast.parse(b);code=compile(node,str(OUT/name),'exec',dont_inherit=True,optimize=0)
        checks.append(dict(path=name,bytes=len(b),sha256=sha(b),top_functions=sum(isinstance(n,ast.FunctionDef) for n in node.body),top_classes=sum(isinstance(n,ast.ClassDef) for n in node.body),inert_code_flags=code.co_flags,executed=False))
    assert (OUT/test['path']).read_bytes()==(SOURCE/test['path']).read_bytes()
    # These templates must remain unbound; grammar/source peers, actual lease, context, timings and results are absent selections.
    facts=dict(schema_version=1,record_type='consumer006_author_source_preparation_checks',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),source_checks=checks,test_AST_bodies_byte_exact=True,potential_full_ids=p['prepared_full_ids'],actual_collection=None,actual_result=None,actual_lease=None,source_peer=None,phase_source_bindings=None,events_or_diagnostics_executed=False,code_metadata_inert_only=True,limits_not_hard_Job_or_OS_sandbox_proof=True)
    once(OUT/'AUTHOR_CODE_AND_DISCOVERY_METADATA_006.json',enc(facts))
    once(OUT/'HANDOFF_006.md',b'# Current Consumer005 copied GG6 preparation\n\nAUTHOR SOURCE PREPARATION ONLY. Different full source audit pending. No target definitions, tests, observer, Root launcher, binder, lease or actual decision ran. Exact source24 tests and leaf sources are copied unchanged; two direct sibling classes19+5 are statically derived, actual IDs/results remain None.\n\nClosed capsule/schema/derivation reader preserves the external full peer anchor; no old Source003 schema union or 2MiB reader widening. Static20 owner_master_sha256 is distinct from actual ACK/BOUND22 owner_sha256 finite lease. Root launcher has exactly three deferred bindings after BOUND22; LATE14 and separate fresh Root GO follow.\n\nEvent rows<=1024 including LF, <=4096 rows, <=32 combined event/diagnostic chunks<=131072 each and combined4MiB. Full failure tracebacks link exact diagnostic bytes/hash/offset; oversize evidence refuses, never silently truncates. Result/collection262144, physical stdout/stderr131072, transcript262144 remain.\n\nCurrent742/Git7/config55, runtime4 and two inventory roots remain fresh actual proof obligations. Original90 context/runtime,600 lifetime, resource60 throughspawn, Root450+after60 and direct retained child cleanup limits remain; no Job, loaded-site, whole descendant or native proof. Ongoing owner master plus reviewed bounded phase lease is required; no fabricated owner deadline or spent artifact renewal.\n')
    payload=[x for x in OUT.rglob('*') if x.is_file()]
    rows=[dict(path=str(x.relative_to(OUT)).replace('\\','/'),bytes=len(x.read_bytes()),sha256=sha(x.read_bytes())) for x in sorted(payload)]
    once(OUT/'AUTHOR_SOURCE_MANIFEST_006.json',enc(dict(schema_version=1,author='/root/capsule_design_review',files=rows,status='SOURCE_PREPARATION_DIFFERENT_REVIEW_PENDING',actuals=None,scope=p['scope'])))
    print(json.dumps(dict(profile_sha256=profile_pin,leaf_sources=checks,test_methods=24,payload_files=len(rows),target_execution=False)))
if __name__=='__main__':main()
