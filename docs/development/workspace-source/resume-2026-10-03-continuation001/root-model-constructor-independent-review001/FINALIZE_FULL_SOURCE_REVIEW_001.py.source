(OWN/'counterparty-copies').mkdir(exist_ok=False)
extras=[];extra_data={}
for index,(path,pin,size) in enumerate(extra_specs):
    data,a=read(path,pin,size);again,b=read(path,pin,size);third,c=read(path,pin,size);assert data==again==third and a==b==c
    copy_path=OWN/'counterparty-copies'/('%02d.bytes'%index)
    with copy_path.open('xb') as stream:stream.write(data)
    copies=[]
    for _ in range(3):
        copied,facts=read(copy_path,pin,size);assert copied==data;copies.append(facts)
    assert copies[0]==copies[1]==copies[2]
    extras.append(dict(path=str(path),sha256=pin,bytes=size,three_observations=[a,b,c],copy_path=str(copy_path),copy_observations=copies))
    extra_data[path.name]=data
template_path=META/'capture-root-metadata003-corrected005.TEMPLATE.py'
template_item=next(item for item in collection['observations'] if item['path']==str(template_path))
template=(Path(template_item['copy_path'])).read_bytes();assert sha(template)==template_item['sha256']
binding=decode(extra_data['ACTUAL_SOURCE_BINDING_003.json']);lease=decode(extra_data['EXECUTION_LEASE_GG6_M3_001.json'])
expected=dict(binding['role_selections'],BINDINGS=binding['bindings'],OWNER_SHA=extra_specs[3][1],OWNER_END=lease['lease_end_utc'])
template_text,template_tree,original=spans(template,expected)
actual_text,actual_tree,actual=spans(extra_data['capture-root-metadata003.BOUND.py'],expected)
assert all(typed_same(actual[name][2],value) for name,value in expected.items())
back=actual_text
for name,(start,end,value) in sorted(actual.items(),key=lambda row:row[1][0],reverse=True):
    old_start,old_end,_=original[name];back=back[:start]+template_text[old_start:old_end]+back[end:]
assert back.encode('utf8')==template
kinds=(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)
assert [ast.dump(node,include_attributes=False) for node in template_tree.body if isinstance(node,kinds)]==[ast.dump(node,include_attributes=False) for node in actual_tree.body if isinstance(node,kinds)]
mapping=actual['BINDINGS'][2];compact='{'+','.join(ascii(key)+':'+ascii(mapping[key]) for key in sorted(mapping))+'}'
actual_start,actual_end,_=actual['BINDINGS'];assert actual_text[actual_start:actual_end]!=compact
assert actual['UNIT_TERMINAL_RELATIVE'][2]=='ROOT_LAUNCH_TERMINAL_006.json'
witness=dict(source_data_AST_only=True,actual_M3_source_sha256=extra_specs[1][1],actual_M3_binding_sha256=extra_specs[2][1],lease_sha256=extra_specs[3][1],
    six_actual_literal_values_typed_equal=True,actual_six_span_byte_reversal_exact=True,all_function_class_ASTs_equal=True,
    actual_BINDINGS_spelling_differs_from_constructor_compact=True,genuine_unit_relative='ROOT_LAUNCH_TERMINAL_006.json',
    WORK_join_differs_from_GUARD_join=True,no_constructor_helper_definitions_or_calls=True,Root_physical_producer_attestation_claimed=False)
for item in extras:
