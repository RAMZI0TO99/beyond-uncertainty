"""Owned immutable review publication; metadata/AST only, no reviewed calls."""
import ast
import hashlib
import json
import os
import stat
import sys
from datetime import datetime,timezone
from pathlib import Path

ROOT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001')
OWN=ROOT/'root-model-constructor-independent-review001'
META=ROOT/'metadata3-producer-core-prep001'
def sha(data):return hashlib.sha256(data).hexdigest()
def raw(info):return [getattr(info,key) for key in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def parents(path):
    result=[]
    for parent in reversed(path.parents):
        value=parent.lstat();assert stat.S_ISDIR(value.st_mode) and not value.st_file_attributes&1024
        result.append([str(parent),value.st_dev,value.st_ino])
    return result
def read(path,expected,size=None):
    chain=parents(path);a=raw(path.lstat());assert all(type(value) is int for value in a) and stat.S_ISREG(a[5]) and a[6]==1 and not a[7]&1024 and 0<=a[2]<=8388608
    with path.open('rb') as stream:
        b=raw(os.fstat(stream.fileno()));assert a[:4]+a[5:]==b[:4]+b[5:]
        data=stream.read(8388609);assert len(data)<=8388608 and raw(os.fstat(stream.fileno()))==b
    assert raw(path.lstat())==a and parents(path)==chain and len(data)==a[2] and sha(data)==expected
    if size is not None:assert len(data)==size
    data.decode('utf8',errors='strict')
    return data,dict(path=str(path),sha256=expected,bytes=len(data),path_raw9=a,descriptor_raw9=b,ancestors=chain)
def decode(data):return json.loads(data.decode('utf8'))
def write(name,value):
    data=(json.dumps(value,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
    with (OWN/name).open('xb') as stream:stream.write(data)
    assert (OWN/name).read_bytes()==data
    return dict(path=str(OWN/name),sha256=sha(data),bytes=len(data))
def typed_same(a,b):
    if type(a) is not type(b):return False
    if type(a) is dict:return set(a)==set(b) and all(typed_same(a[key],b[key]) for key in a)
    if type(a) is list:return len(a)==len(b) and all(typed_same(left,right) for left,right in zip(a,b))
    return a==b
def spans(data,names):
    text=data.decode('utf8');tree=ast.parse(text);lines=text.splitlines(keepends=True);result={}
    for node in tree.body:
        if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name) and node.targets[0].id in names:
            assert node.targets[0].id not in result
            result[node.targets[0].id]=(sum(map(len,lines[:node.value.lineno-1]))+node.value.col_offset,
                sum(map(len,lines[:node.value.end_lineno-1]))+node.value.end_col_offset,ast.literal_eval(node.value))
    assert set(result)==set(names)
    return text,tree,result

assert sys.version_info[:2]==(3,13) and sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode and sys.flags.utf8_mode
