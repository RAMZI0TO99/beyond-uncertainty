assert sha(collection_data)=='08ac28298911c2aeaff97732da95904f038df8ebd9b6367ee90d956f7a65f374'
collection=decode(collection_data);assert len(collection['observations'])==108
findings=decode((OWN/'FULL_REVIEW_FINDINGS_001.json').read_bytes());assert len(findings['findings'])==4 and findings['blocking_group_count']==4
