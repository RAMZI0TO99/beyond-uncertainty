"""Independent finite metadata observer; never executes reviewed definitions."""
import ast,hashlib,json,os,stat
from pathlib import Path
from datetime import datetime,timezone
W=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001'); S=W/'metadata3-actual-checker-prep001'; O=W/'metadata3-checker009-independent-review001'
def sha(b):return hashlib.sha256(b).hexdigest()
def raw(s):return [getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def observe(p):
 s=p.lstat();assert stat.S_ISREG(s.st_mode) and s.st_nlink==1 and not s.st_file_attributes&1024 and s.st_size<=8388608
 with p.open('rb',buffering=0) as f:a=os.fstat(f.fileno());b=f.read(s.st_size+1);z=os.fstat(f.fileno())
 assert raw(s)==raw(p.lstat()) and raw(a)==raw(z) and len(b)==s.st_size
 assert [raw(s)[i] for i in (0,1,2,3,5,6,7,8)]==[raw(a)[i] for i in (0,1,2,3,5,6,7,8)]
 return b,dict(path=str(p),sha256=sha(b),bytes=len(b),path_raw9=raw(s),descriptor_raw9=raw(a))
def functions(b):return {n.name:ast.dump(n,include_attributes=False) for n in ast.parse(b).body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def methods(b):return {n.name:ast.dump(n,include_attributes=False) for n in ast.walk(ast.parse(b)) if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}
mb,mrow=observe(S/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json');m=json.loads(mb);assert m['payload_count']==len(m['payloads'])==55
items=[(S/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json',sha(mb))]+[(S/r['path'],r['sha256']) for r in m['payloads']]
items += [(W/'metadata3-checker-independent-review001'/'INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json','1b4eeb7636d76a30f9ae47108e4128d2a798bc9cfb3da11a980e2be89f10944c'),(W/'metadata3-checker-independent-review001'/'INDEPENDENT_METADATA3_CHECKER_SOURCE_DETAILS_002.json','d4faaf6ae5143c3d9e3c3fa74489b150ccf862b5eaccec414b78bc8a4b144837')]
O.mkdir(exist_ok=False);rows=[];content={}
for i,(p,pin) in enumerate(items):
 b,a=observe(p);b2,a2=observe(p);assert b==b2 and a==a2 and sha(b)==pin
 cp=O/(str(i).zfill(3)+'-'+p.name+'.bytes');cp.write_bytes(b);cb,cr=observe(cp);assert cb==b and cr['path_raw9'][:2]!=a['path_raw9'][:2]
 content[p.name]=b;rows.append(dict(first=a,second=a2,copy=cr))
old=functions(content['review-metadata3-actual006-corrected008.TEMPLATE.py']);new=functions(content['review-metadata3-actual006-corrected009.TEMPLATE.py'])
changed=[k for k in old if old[k]!=new[k]];added=[k for k in new if k not in old]
assert len(old)==65 and len(new)==69 and set(changed)=={'whole_before_result','whole_after_result','configure','preflight_ready','decision'}
assert set(added)=={'reconstruct_whole_projection_rows','register_whole_projection','compact_whole_observations','detail_publication_bytes'}
omt=methods(content['test_metadata3_actual_checker_preparation_002.py']);nmt=methods(content['test_metadata3_actual_checker_preparation_003.py']);assert len(omt)==19 and len(nmt)==25 and all(nmt[k]==v for k,v in omt.items())
helper=content['review-metadata3-actual006-corrected009.TEMPLATE.py'];tree=ast.parse(helper)
constants={n.targets[0].id:ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('PROJECTION_KEYS','CORE_KEYS')};assert len(constants['PROJECTION_KEYS'])==13 and len(constants['CORE_KEYS'])==12
peer=json.loads(content['INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_001.json']);assert peer['verdict']=='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY' and peer['checker_template_sha256']==sha(content['review-metadata3-actual006-corrected008.TEMPLATE.py']) and peer['full_source_review_sha256'] if 'full_source_review_sha256' in peer else True
for row in rows:
 b,post=observe(Path(row['first']['path']));assert post==row['first'];row['post']=post
checks=[
 ('SOURCE_CLOSURE','All55 finite selected payload bytes independently read, hashed, copied, paired and post-observed. Prior008 genuine compact/full review bytes cryptopinned, 60 existing function ASTs exact; five changed functions and four added functions inspected in full. No claimed new independent runtime acceptance.'),
 ('WHOLE_INTERNAL','Existing current_stream_file and final_reobserve ASTs exact; before/after whole traversals retain complete current file/directory/table validation before registration. final_reobserve receives original unfiltered list before compact publication. It preserves strict same-API path and descriptor raw9; runtime EXE policy remains narrow inherited008.'),
 ('LOSSLESS_RECONSTRUCTION','Four role-ordered fixed4MiB table pointers must match authenticated canonical first/second bytes. Complete table schema, pinned identity, root raw9, confined ordinal no-alias rows, typed file/raw9 metadata, directory coverage and reconstructed tree digest enforced. Base5368 plus Scripts22 yield exact5390 file rows, canonical array SHA.'),
 ('IDENTITY_ONLY_REMOVAL','Registration validates5390 distinct EVIDENCE object identities and full typed reconstruction equality. Only identities from registered complete whole traversal removed. Equal-but-distinct ordinary/runtime observations retained. Registered original facts digest rechecked after final reread; missing membership refused.'),
 ('CLOSED_PROJECTION13','Exact13 top-level keys generated from internal state, fixed roots/rules/caps, result input path/SHA and four pointers. Whole counts5390/5368+22; nonwhole zero omitted/no tables/null result. Source output structure, not caller-provided count/PASS.'),
 ('PUBLICATION_BOUNDS','Full encoded Detail <=2097152 and retained observations1..4096 before any once publication. Narrow own-output readback16MiB ceiling unchanged; does not authorize Detail >2MiB. Core12 unchanged cryptobinds exact detail bytes.'),
 ('ENTRY_AND_ROLES','New configure requires distinct Source002 peer with reviewer Root or owner_docs_review; canonical source author actual_record_checker and fixed009 helper. Config18/source closure/trust/phase20/bound9/READY preflight inherited008 except resetting new state. No Root producer attestation inferred from reviewer labels.'),
 ('TEST_CAUSALITY','All19 old test method ASTs exact. Six new methods cover synthetic5390 lossless facts/equal different origins, wrong/missing/duplicate pointers, bool/hash/path/order/alias/pair drift, missing origins/registered mutation, nonwhole4096 and exact2MiB boundary with healthy/refusal/restoration. Synthetic fixture patches WHOLE_EXPECTED and cannot establish real whole proof or actual byte fit.'),
 ('HISTORY_AND_ACTUAL_LIMITS','Accepted008 peer/history preserved. Generic U007 independent source acceptance, actual bound source pool, coordination, physical launch, actual fit/metadata and unit GO remain separate. Source009 synthetic25 and actual phases unrun at this source audit. No Job/descendant/loaded-site/operational/scientific/public authority.')]
report=dict(schema_version=1,record_type='independent_metadata3_checker009_complete_finite_source_review',reviewer='/root/binder_correction_audit',source_author='/root/actual_record_checker',created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),scope=m['scope'],verdict='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY',checker_template_sha256=sha(helper),source_manifest_sha256=sha(mb),finite_inputs=rows,input_count=len(rows),selected_payload_count=55,copy_count=len(rows),observations_per_input=3,functions_total=69,functions_changed=changed,functions_added=added,unchanged_function_count=60,planned_test_method_count=25,old19_test_method_ASTs_exact=True,checks=[dict(id=k,finding=v) for k,v in checks],source_issues=[],actual_binding=None,actual_fit=None,tests_executed=False,target_execution=False,runtime_acceptance=False,operational_authority=False,review_method='Independent finite full-source closure plus exact inherited008 function ASTs and genuine prior full source receipt; all changed functions/new helpers/new causal test bodies manually inspected. No reviewed defs/imports/main calls.')
p=O/'INDEPENDENT_METADATA3_CHECKER009_SOURCE_DETAILS_001.json';p.write_text(json.dumps(report,indent=2,sort_keys=True)+'\n',encoding='utf8');b,r=observe(p);print(json.dumps(r))
