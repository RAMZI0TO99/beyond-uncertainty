"""Source-only final role rebase. Does not import or execute selected sources.

Run only after Root selects the complete final GG6rev003 source map. All prior
003/004 artifacts stay exact history; actual BOUND runtime filenames stay003.
"""
import ast
import hashlib
import json
from pathlib import Path

ROOT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-producer-core-prep001')
ACTIVE=(
    'capture-root-metadata003-corrected005.TEMPLATE.py',
    'BIND_SOURCE_AND_PHASES_003-corrected005.TEMPLATE.py',
    'WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_003.TEMPLATE.ps1',
    'SUPERVISE_ROOT_METADATA_BEFORE_003-corrected004.TEMPLATE.ps1',
    'WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_003.TEMPLATE.ps1',
    'SUPERVISE_ROOT_METADATA_AFTER_003-corrected004.TEMPLATE.ps1')

def once(name,data):
    with (ROOT/name).open('xb') as stream: stream.write(data)

if __name__=='__main__':
    capture=(ROOT/'capture-root-metadata003-corrected004.TEMPLATE.py').read_bytes()
    if capture.count(b'GUARD_RUNTIME_PROFILE_006-rev002.json')!=1: raise ValueError('Exact selected profile source role')
    capture=capture.replace(b'GUARD_RUNTIME_PROFILE_006-rev002.json',b'GUARD_RUNTIME_PROFILE_006-rev003.json')
    binder=(ROOT/'BIND_SOURCE_AND_PHASES_003-corrected004.TEMPLATE.py').read_bytes()
    for old,new in (
        (b'capture-root-metadata003-corrected004.TEMPLATE.py',b'capture-root-metadata003-corrected005.TEMPLATE.py'),
        (b'BIND_SOURCE_AND_PHASES_003-corrected004.TEMPLATE.py',b'BIND_SOURCE_AND_PHASES_003-corrected005.TEMPLATE.py'),
        (b'STAGED_MANIFEST_004.json',b'STAGED_MANIFEST_005.json'),
    ):
        if binder.count(old)!=2 and old!=b'STAGED_MANIFEST_004.json': raise ValueError('Exact source pointer rebase multiplicity')
        if old==b'STAGED_MANIFEST_004.json' and binder.count(old)!=1: raise ValueError('Exact immutable manifest selection')
        binder=binder.replace(old,new)
    ast.parse(capture);ast.parse(binder)
    once(ACTIVE[0],capture);once(ACTIVE[1],binder)
    contract=json.loads((ROOT/'SOURCE_SCHEMA_AND_REVIEW_CONTRACT_004.json').read_bytes())
    contract['selected_sources']=list(ACTIVE)
    contract['selected_manifest']='STAGED_MANIFEST_005.json'
    contract['selected_guard_profile']='GUARD_RUNTIME_PROFILE_006-rev003.json'
    once('SOURCE_SCHEMA_AND_REVIEW_CONTRACT_005.json',(json.dumps(contract,sort_keys=True,indent=2)+'\n').encode())
    print(json.dumps(dict(active_sources=list(ACTIVE),capture_sha256=hashlib.sha256(capture).hexdigest(),binder_sha256=hashlib.sha256(binder).hexdigest(),target_or_binding_execution=False)))
