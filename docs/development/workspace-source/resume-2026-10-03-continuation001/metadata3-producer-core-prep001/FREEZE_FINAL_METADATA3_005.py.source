"""Source-only finite final inventory and AST checks; selected definitions unrun."""
import ast
import hashlib
import json
from datetime import datetime,timezone
from pathlib import Path
ROOT=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001/metadata3-producer-core-prep001')
def sha(data):return hashlib.sha256(data).hexdigest()
def once(name,obj):
    data=(json.dumps(obj,sort_keys=True,indent=2)+'\n').encode()
    with (ROOT/name).open('xb') as stream:stream.write(data)
    return data
prior_bytes=(ROOT/'STAGED_MANIFEST_004.json').read_bytes()
prior=json.loads(prior_bytes)
for row in prior['payloads']+prior['preserved_first_payloads']:
    a=(ROOT/row['path']).read_bytes();b=(ROOT/row['path']).read_bytes()
    if a!=b or len(a)!=row['bytes'] or sha(a)!=row['sha256']:raise ValueError('Historical003/004 payload drift')
active=('capture-root-metadata003-corrected005.TEMPLATE.py','BIND_SOURCE_AND_PHASES_003-corrected005.TEMPLATE.py',
    'WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_003.TEMPLATE.ps1','SUPERVISE_ROOT_METADATA_BEFORE_003-corrected004.TEMPLATE.ps1',
    'WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_003.TEMPLATE.ps1','SUPERVISE_ROOT_METADATA_AFTER_003-corrected004.TEMPLATE.ps1')
functions=lambda data:{node.name:ast.dump(node,include_attributes=False) for node in ast.parse(data).body if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))}
before=functions((ROOT/'capture-root-metadata003-corrected004.TEMPLATE.py').read_bytes())
after=functions((ROOT/active[0]).read_bytes())
if len(before)!=20 or len(after)!=20 or not all(before[name]==after[name] for name in before if name!='main'):raise ValueError('Final capture19 non-main ASTs')
ast.parse((ROOT/active[1]).read_bytes())
once('AUTHOR_FINAL_AST_PRESERVATION_005.json',dict(schema_version=1,capture_functions=20,unchanged_non_main_functions=19,
    final_delta='selected final GG6rev003 profile and exact final source/manifest reader pointers',binder_AST_parsed=True,
    target_definitions_or_compile_executed=False,actual_bindings=None,actual_results=None))
names=active+('PREPARE_METADATA3_FINAL_SELECTION_005.py','SOURCE_SCHEMA_AND_REVIEW_CONTRACT_005.json',
    'AUTHOR_CORRECTED_POWERSHELL_SYNTAX_004.json','AUTHOR_FINAL_AST_PRESERVATION_005.json','HANDOFF_FINAL_005.md','FREEZE_FINAL_METADATA3_005.py')
rows=[]
for name in names:
    a=(ROOT/name).read_bytes();b=(ROOT/name).read_bytes()
    if a!=b:raise ValueError('Final selected source drift')
    rows.append(dict(path=name,bytes=len(a),sha256=sha(a),two_read_match=True))
data=once('STAGED_MANIFEST_005.json',dict(schema_version=1,record_type='metadata3_final_source_preparation_manifest',
    source_author='/root/renewal_runtime_inventory',created_utc=datetime.now(timezone.utc).isoformat(timespec='microseconds'),
    payload_count=len(rows),payloads=rows,active_source_count=6,selected_source_paths=list(active),
    preserved_previous_manifest=dict(path='STAGED_MANIFEST_004.json',sha256=sha(prior_bytes),bytes=len(prior_bytes)),
    preserved_previous_payload_count=len(prior['payloads']),preserved_previous_payloads=prior['payloads'],
    original003_history_checked=True,selected_guard_profile='GUARD_RUNTIME_PROFILE_006-rev003.json',
    selected_guard_profile_sha256='70d4d658ff993181eb4056bdd276763cc8ff6a12b7281637e9332a00fb2fa030',
    selected_guard_manifest009_sha256='78320743b0076e5a8cc5056a6f003202a4dcdb19f3bc59a3cbf5da8924bbdba9',
    source_peer_expected_path=str(ROOT.parent/'m3-source-independent-review001/INDEPENDENT_M3_SOURCE_REVIEW_002.json'),
    runtime_bound_paths_unchanged=True,actual_bindings=None,actual_lease=None,actual_authorization=None,actual_capture=None,
    target_or_phase_or_binding_execution=False,source_approval_issued=False))
print(json.dumps(dict(manifest_sha256=sha(data),payload_count=len(rows),active_source_rows=[dict(path=str(ROOT/r['path']),bytes=r['bytes'],sha256=r['sha256']) for r in rows[:6]]),indent=2))
