    for row in manifest['payloads']:
        exact(row,('path','bytes','sha256'));assert not Path(row['path']).is_absolute()and '..'not in Path(row['path']).parts;rows.append((PREP/row['path'],row['sha256'],row['bytes']))
    for row in packet['payloads']:
        exact(row,('path','bytes','sha256'));assert re.fullmatch('[A-Za-z0-9_.-]{1,160}',row['path']);rows.append((META/row['path'],row['sha256'],row['bytes']))
    registry={}
    for path,pin,size in rows:
        if size is None:size=path.lstat().st_size
