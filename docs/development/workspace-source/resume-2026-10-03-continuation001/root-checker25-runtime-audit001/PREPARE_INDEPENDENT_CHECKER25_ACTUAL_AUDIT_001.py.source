    methods.sort(key=lambda x:x['id']);assert len(methods)==25 and methods==projection['methods']and [r['id']for r in methods]==projection['ordered_ids']
    old_nodes={node.name:node for cls in ast.parse(bodies[META/'test_metadata3_actual_checker_preparation_002.py']).body if isinstance(cls,ast.ClassDef)for node in cls.body if isinstance(node,ast.FunctionDef)and node.name.startswith('test_')}
    assert len(old_nodes)==19 and all(ast.dump(node,include_attributes=False)==ast.dump(method_nodes[name],include_attributes=False)for name,node in old_nodes.items())
    sites=[dict(method=name,source_line=node.lineno,AST_sha256=sha(ast.dump(node,include_attributes=False).encode()))for name,method in method_nodes.items()for node in ast.walk(method)if isinstance(node,ast.Call)and isinstance(node.func,ast.Attribute)and node.func.attr=='subTest'];assert len(sites)==6
    independent_projection=dict(schema_version=1,record_type='independent_checker25_discovery_projection',reviewer='/root/capsule_design_review',scope=SCOPE,module_name=module,test_sha256=PINS['test'],helper_sha256=PINS['helper'],ordered_ids=[r['id']for r in methods],methods=methods,ordered_ids_sha256=sha(('\n'.join(r['id']for r in methods)+'\n').encode()))
    once('INDEPENDENT_CHECKER25_DISCOVERY_PROJECTION_001.json',encoded(independent_projection))
