def sha(v):return hashlib.sha256(v).hexdigest()
def encoded(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
def now():return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds')
def exact(v,keys):assert type(v)is dict and set(v)==set(keys)
def decode(body):
    def pairs(rows):
        out={}
        for key,value in rows:assert key not in out;out[key]=value
        return out
    def bad(value):raise ValueError('float/nonfinite Source data')
    assert not body.startswith(b'\xef\xbb\xbf')
    return json.loads(body.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def raw(s):return [getattr(s,k)for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
def chain(p):
    rows=[]
    for q in reversed(p.parents):
        s=q.lstat();assert stat.S_ISDIR(s.st_mode)and not stat.S_ISLNK(s.st_mode)and not s.st_file_attributes&1024;rows.append([str(q),s.st_dev,s.st_ino])
    return rows
def read(path,pin,size):
    assert type(size)is int and 0<=size<=8388608 and re.fullmatch('[0-9a-f]{64}',pin)
    ancestry=chain(path);a=path.lstat();x=raw(a);assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and not a.st_file_attributes&1024 and a.st_size==size
    with path.open('rb')as f:
        b=os.fstat(f.fileno());y=raw(b);assert x[:4]+[x[8],x[6],x[7]]==y[:4]+[y[8],y[6],y[7]]and x[4]==x[8]
        if (path,pin,size)in RUNTIME and path.suffix=='.exe':assert x[5]&0o111==0o111 and y[5]&0o111==0 and x[5]&~0o111==y[5]
        else:assert x[5]==y[5]
        data=f.read(size+1);assert raw(os.fstat(f.fileno()))==y
    assert len(data)==size and sha(data)==pin and raw(path.lstat())==x and chain(path)==ancestry
    return data,dict(path=str(path),bytes=size,sha256=pin,path_raw9=x,descriptor_raw9=y,ancestors=ancestry)
def once(name,body):
    path=OUT/name;path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb')as f:assert f.write(body)==len(body)
