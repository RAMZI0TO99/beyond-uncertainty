        registry[path]=(pin,size)
    assert len(registry)<=200
    observed=[];bodies={}
    for index,(path,(pin,size))in enumerate(sorted(registry.items(),key=lambda x:str(x[0]))):
        passes=[read(path,pin,size)for _ in range(3)];assert passes[0]==passes[1]==passes[2]
        copy='source-preparation001/'+str(index).zfill(3)+'.bytes';once(copy,passes[0][0]);copy_body,copy_meta=read(OUT/copy,pin,size);assert copy_body==passes[0][0]and copy_meta['path_raw9'][:2]!=passes[0][1]['path_raw9'][:2]
        observed.append(dict(path=str(path),sha256=pin,bytes=size,passes=[r[1]for r in passes],copy_path=copy,copy_observation=copy_meta));bodies[path]=passes[0][0]
    peer=decode(bodies[PREP/'INDEPENDENT_CHECKER25_RUNNER_SOURCE_REVIEW_001.json']);exact(peer,contract['source_peer_keys'])
    assert peer['reviewer']=='/root/binder_correction_audit'and peer['source_author']=='/root/bootstrap_stage'and peer['verdict']=='PASS_STATIC_SYNTHETIC_CHECKER25_RUNNER_ONLY'and peer['runner_source_sha256']==PINS['runner']and peer['parent_source_sha256']==PINS['parent']and peer['source_manifest_sha256']==PINS['manifest']and peer['actual_runtime']is None and peer['target_execution']is False
    full=decode(bodies[WORK/'root-checker25-independent-review001/INDEPENDENT_CHECKER25_RUNNER_SOURCE_DETAILS_001.json']);assert full['copied_input_count']==161 and full['actual_runtime']is None
    projection=decode(bodies[PREP/'CHECKER25_DISCOVERY_PROJECTION_001.json']);module=projection['module_name']
