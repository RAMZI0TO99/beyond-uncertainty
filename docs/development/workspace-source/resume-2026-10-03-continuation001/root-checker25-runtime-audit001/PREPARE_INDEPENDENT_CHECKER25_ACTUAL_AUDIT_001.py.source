    fixed=[(PREP/'RUN_SYNTHETIC_CHECKER25_001.TEMPLATE.py',PINS['runner'],65536),(PREP/'SUPERVISE_SYNTHETIC_CHECKER25_001.TEMPLATE.ps1',PINS['parent'],65536),(META/'test_metadata3_actual_checker_preparation_003.py',PINS['test'],34563),(META/'review-metadata3-actual006-corrected009.TEMPLATE.py',PINS['helper'],146200),(WORK/'metadata3-checker-independent-review001/INDEPENDENT_METADATA3_CHECKER_SOURCE_REVIEW_002.json',PINS['helper_peer'],65536),(PREP/'CHECKER25_DISCOVERY_PROJECTION_001.json',PINS['projection'],65536),(PREP/'ROOT_SYNTHETIC_CHECKER25_GO_001.json',None,65536),(WORK/'metadata3-checker009-independent-review001/INDEPENDENT_METADATA3_CHECKER009_SOURCE_DETAILS_001.json',PINS['helper_full_peer'],192565),(META/'AUTHOR_FROZEN_SOURCE_MANIFEST_009.json',PINS['helper_manifest'],10908),(WORK/'OWNER_CONTINUATION_20261003_001.json','de8f80d656211873477d2ada0c03eb62fd16a64a361def9d9bbad58a0323f583',65536),(WORK/'owner-docs-independent-review001/INDEPENDENT_OWNER_CONTINUATION_REVIEW_001.json','56a702c2883b8a7c66095c2f1501fcb8e755da7198552b026dcb85cdccb453d0',65536),*RUNTIME,*[(META/r['path'],r['sha256'],r['bytes'])for r in packet['payloads']]]
