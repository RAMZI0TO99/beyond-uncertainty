import ast,datetime,hashlib,json,os,stat
from pathlib import Path
BASE=Path('D:/Aenv/pro2/resume-2026-10-03-continuation001');ROOT=BASE/'root-guard006-pipeline-prep001';MODEL=BASE/'root-guard006-model-prep001';OUT=BASE/'guard006-actual-bound-pool-independent001';UTILITY=BASE/'guard006-bound-late-checker-prep001'
