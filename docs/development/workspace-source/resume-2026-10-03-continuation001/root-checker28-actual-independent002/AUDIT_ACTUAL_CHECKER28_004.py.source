def need(v,m):
    if not v: raise ValueError(m)
def sha(v): return hashlib.sha256(v).hexdigest()
def raw(s):
    v=[getattr(s,k) for k in ('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')]
    need(all(type(x) is int for x in v),'Windows raw9');return v
def ancestors(p):
    v=[]
    for q in reversed(p.parents):
        s=q.lstat();need(stat.S_ISDIR(s.st_mode) and not s.st_file_attributes&1024,'plain ancestor');v.append([str(q),s.st_dev,s.st_ino])
    return sha(json.dumps(v).encode())
def observe(p,pin=None,size=None):
    p=p.absolute();need(p.is_relative_to(ROOT) or str(p) in EXTERNAL_PINS,'workspace or explicitly selected external record only');parent=ancestors(p);a=p.lstat();x=raw(a)
    need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and not a.st_file_attributes&1024 and 0<=a.st_size<=8388608,'finite plain file cap')
    with p.open('rb',buffering=0) as f:
        y=raw(os.fstat(f.fileno()));need(all(x[i]==y[i] for i in (0,1,2,3,6,7,8)),'cross identity excluding independent ctime')
        if str(p) in RUNTIME_EXES:
            need(x[5]&0o111==0o111 and y[5]&0o111==0 and x[5]&~0o111==y[5] and pin==RUNTIME_EXES[str(p)],'exact three-EXE mode projection')
        else:need(x[5]==y[5],'ordinary mode exact')
        v=f.read(a.st_size+1);need(raw(os.fstat(f.fileno()))==y,'same handle raw9')
    need(raw(p.lstat())==x and ancestors(p)==parent and len(v)==a.st_size,'same path raw9')
    need((pin is None or sha(v)==pin) and (size is None or len(v)==size),'pin bytes');need(p.read_bytes()==v and raw(p.lstat())==x,'different API bytes')
    return v,dict(path=str(p),sha256=sha(v),bytes=len(v),path_raw9=x,descriptor_raw9=y,parent_identity_sha256=parent)
def pairs(rows):
    d={}
    for k,v in rows:need(k not in d,'duplicate JSON key');d[k]=v
    return d
def forbidden(v):raise ValueError('JSON nonfinite')
def decode(v,source=False,path=''):
    need(not v.startswith(b'\xef\xbb\xbf'),'BOM');obj=json.loads(v.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=Decimal,parse_constant=forbidden)
    def walk(x,keys=()):
        if type(x) is Decimal:
            need(not source and x.is_finite(),'noFloat Source JSON; documentary finite Decimal only');DECIMALS.append(dict(path=path,key_path=list(keys),exact_decimal=str(x),documentary_only=True))
        elif type(x) is dict:
            for k,y in x.items():walk(y,keys+(k,))
        elif type(x) is list:
            for i,y in enumerate(x):walk(y,keys+(i,))
    walk(obj);return obj
def add(p,pin=None,size=None):
    p=p.absolute();key=str(p)
    if key in DATA:
        need(pin is None or sha(DATA[key])==pin,'consistent pin');need(size is None or len(DATA[key])==size,'consistent size');return DATA[key]
    v,row=observe(p,pin,size);DATA[key]=v;FIRST[key]=row;return v
def dump(n):return ast.dump(n,include_attributes=False)
def methods(tree):return {(c.name,n.name):n for c in tree.body if isinstance(c,ast.ClassDef) for n in c.body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}
def psfunctions(text):
    lines=text.splitlines(keepends=True);out={}
    for i,line in enumerate(lines):
        m=re.match(r'^function ([A-Za-z0-9_-]+)',line)
        if m:
            j=i+1 if line.rstrip().endswith('}') else next(k+1 for k in range(i+1,len(lines)) if lines[k].rstrip()=='}');out[m.group(1)]=''.join(lines[i:j])
    return out

