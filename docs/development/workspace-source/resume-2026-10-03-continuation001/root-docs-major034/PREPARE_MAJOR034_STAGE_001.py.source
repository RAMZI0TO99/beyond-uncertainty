        ('actual different audit PENDING/unselected', 'different actual FAILED evidence auditb514 completed/Root selection3d4e attributed'),
        ('different actual audit remains PENDING/unselected', 'different FAILED evidence auditb514 is completed/Rootselected3d4e with attributed scope'),
        ('different actual audit PENDING/unselected', 'different FAILED evidence auditb514 completed/Root selection3d4e attributed'),
        ('actual different TYPE audit PENDING/unselected', 'different FAILED evidence auditb514 completed/Root selection3d4e attributed')]:
        text = text.replace(old, current)
    if 'Checker010' in text:
        text += ('\nDifferent complete U010 Source846d3730/full8f721aa9/post1e48dc52 accepts preparation with poolUNREADY; seven causal plans remain UNRUN. '
                 'Different complete Checker010 Source1f3b0ed4/fulla0c7285f/post409435e5 and genuine Root compact0036d981aa8 accept static Source only; all28 planned methods remain UNRUN.\n')
    section_data = text.encode('utf-8')
    section_path = OWN / 'selected-sections' / f'section-{index}.md'
    once(section_path, section_data)
    selected_sections.append((ROOT / relative, section_data))
    old = baseline[relative]
    direction = 'suffix' if index < 3 else 'prefix'
    new = section_data + history_note + old if direction == 'suffix' else old + b'\n\n' + section_data
    need(new.endswith(old) if direction == 'suffix' else new.startswith(old), 'whole033 byte preservation')
    before_path, candidate_path = OWN / 'before' / relative, OWN / 'candidates' / relative
    once(before_path, old)
    once(candidate_path, new)
    candidate_rows.append(dict(destination=relative,before=pointer(before_path,old),candidate=pointer(candidate_path,new),preservation=direction))

links = []
for origin, data in [(ROOT / CHECKPOINT,checkpoint_data), *selected_sections]:
    for target in re.findall(r'\]\(([^)]+)\)', data.decode('utf-8')):
        need(not re.match(r'^[a-zA-Z][a-zA-Z0-9+.-]*:',target), 'local documentation links only')
        resolved = (origin.parent / target).resolve()
        need(resolved.is_relative_to(ROOT) and (resolved == ROOT / CHECKPOINT or resolved.is_file()), 'new selected local link exists')
        links.append(dict(origin=origin.relative_to(ROOT).as_posix(),target=target,resolved_path=resolved.relative_to(ROOT).as_posix()))
need(len(links) <= 200, 'selected link bound')

inputs = []
for path, row in zip(paths,observations,strict=True):
    data = content[str(path)]
    copy_path = OWN / 'stage-evidence' / path.relative_to(ROOT)
    once(copy_path,data)
    copy_data, copy_record = observe(copy_path)
    need(copy_data == data,'exact owned Source evidence copy')
    row['owned_copy_path'] = str(copy_path)
    row['owned_copy_observation'] = copy_record
    inputs.append(dict(original=pointer(path,data),copy=pointer(copy_path,data)))
need(len(inputs) <= 100,'selected source input pair limit')

named_roles = [
 WORK/'root-guard006-pipeline-prep001/RUN_ROOT_METADATA_PIPELINE_007.BOUND.ps1',
 WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_BINDING_002.json',
 WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_SOURCE_BINDING_PROVENANCE_002.json',
 WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_INIT_TRACE_002.json',
 WORK/'root-guard006-pipeline-prep001/ROOT_PIPELINE_TRUST_SELECTION_002.json',
 WORK/'root-guard006-pipeline-prep001/ROOT_METADATA_PIPELINE_GO_002.json',
 WORK/'root-pipeline-independent-review001/SOURCE_REVIEW_ROOT_PIPELINE_002.json',
 WORK/'metadata3-actual-checker-prep001/ACTUAL_CHECKER_BINDING_002.json',
 WORK/'metadata3-actual-checker-prep001/CHECKER_READY_ALL_006.json',
 WORK/'metadata3-actual-checker-prep001/CHECKER_READY_BEFORE_006.json',
 WORK/'metadata3-actual-checker-prep001/CHECKER_READY_AFTER_006.json',
 WORK/'guard006-bound-late-checker-prep001/BOUND_LATE_CHECKER_READY_006.json',
]
absence_rows = []
for path in named_roles:
    need(not path.exists(),'fresh named actual role unexpectedly present: '+str(path))
    absence_rows.append(dict(path=str(path),observed_absent=True,kind='named filesystem role only; no process/quiet claim'))
for row in observations:
    path = Path(row['original_path'])
    data, post = observe(path)
    need(post == row['observations'][0] and data == content[str(path)],'whole selected Source post-read drift')
    copy_data, copy_post = observe(Path(row['owned_copy_path']))
    need(copy_data == data and copy_post == row['owned_copy_observation'],'owned copy post-read drift')
    row['post_read'],row['owned_copy_post_read'] = post,copy_post
for relative in PRIMARY:
    need(observe(ROOT/relative)[0] == baseline[relative],'primary changed during Source staging')

audit = dict(schema_version=1,record_type='major034_author_source_stage_audit',source_author=AUTHOR,prepared_utc=STAMP,
    scope='LOCAL_PRIVATE_MAJOR034_DOCUMENTATION_ONLY',finite_input_count=len(inputs),selected_link_count=len(links),
    observations=observations,named_role_absences=absence_rows,whole_five_primary033_bytes_preserved=True,
    unchanged_publisher_logic_exact_byte_reversal=True,publisher_function_count=len(old_functions),changed_function_ASTs=changed,
    Source_only_changed_identity_literals=declared,all_checks_are_own_metadata_AST_and_data_only=True,
    future_publisher_main_or_import_or_compile_or_definitions_executed=False,
    selected_checker28_tests_executed=False,publication_performed=False,target_execution=False,operational_authority=False,
    actual_034_Source_review=None,actual_034_creation_review=None,actual_models_or_fit_or_capture=None,
    pro3_failed_execution_evidence_audit_selected='b514dc3a2ca2f2a1ac521372a072369ce2c31a8e1a1fbbb0f4d4440a38b2c153',
    pro3_TYPE_pass=False,pro3_cleanup_scope_attributed_only=True,
    inherited_historical_links='Whole historical bytes retained; prior033 creation review remains separate evidence. Only newly selected links are enumerated.',
    failed_read_only_discovery='Initial top-level SESSION.md and guessed architecture namespace were absent; corrected canonical paths read, no primary changes or Source-helper entry.')
audit_path = OWN / 'AUTHOR_MAJOR034_STAGE_AUDIT_001.json'
once(audit_path,encoded(audit))
manifest = dict(schema_version=1,record_type='major034_documentation_stage',author=AUTHOR,prepared_utc=STAMP,
    checkpoint=pointer(checkpoint_candidate,checkpoint_data),primaries=candidate_rows,inputs=inputs,links=links,
    source_only=True,publication_performed=False,target_execution=False,operational_authority=False)
manifest_path = OWN / 'STAGED_DOCUMENTATION_MANIFEST_034_001.json'
manifest_data = encoded(manifest)
need(len(manifest_data) <= 2097152,'unchanged manifest cap')
for row in observations:
    data, final = observe(Path(row['original_path']))
    need(final == row['observations'][0] and data == content[row['original_path']],'final Source prefreeze observation')
for relative in PRIMARY:
    need(observe(ROOT/relative)[0] == baseline[relative],'current033 primary final stability')
once(manifest_path,manifest_data)
print(json.dumps(dict(manifest_path=str(manifest_path),manifest_sha256=sha(manifest_data),manifest_bytes=len(manifest_data),
    publisher_path=str(publisher_path),publisher_sha256=sha(publisher_data),publisher_bytes=len(publisher_data),
    author_audit_sha256=sha(audit_path.read_bytes()),author_audit_bytes=audit_path.stat().st_size,
    finite_input_pairs=len(inputs),selected_links=len(links),checkpoint_bytes=len(checkpoint_data),
    publisher_function_count=len(old_functions),publisher_changed_functions=changed,
    publication_performed=False,selected_execution=False),separators=(',',':')))
