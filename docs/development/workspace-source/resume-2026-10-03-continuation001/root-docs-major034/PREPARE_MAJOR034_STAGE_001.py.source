def need(value, message):
    if not value:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def raw(info):
    return [getattr(info, name) for name in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns',
            'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')]

def chain(path):
    result = []
    for item in [*reversed(path.parents), path]:
        info = item.lstat()
        need(stat.S_ISDIR(info.st_mode) and not info.st_file_attributes & 1024, 'plain directory')
        result.append([str(item), info.st_dev, info.st_ino])
    return result

def observe(path):
    ancestry = chain(path.parent)
    before = path.lstat()
    need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and
         not before.st_file_attributes & 1024 and before.st_size <= MAX_FILE, 'plain bounded input')
    with path.open('rb', buffering=0) as stream:
        opened = os.fstat(stream.fileno())
        pr, dr = raw(before), raw(opened)
        need(pr[:4] + pr[5:] == dr[:4] + dr[5:] and pr[4] == pr[8], 'ordinary crossAPI8/birth')
        data = stream.read(before.st_size + 1)
        need(dr == raw(os.fstat(stream.fileno())), 'descriptor raw9 stability')
    need(pr == raw(path.lstat()) and chain(path.parent) == ancestry and
         len(data) == before.st_size and len(data) <= MAX_FILE, 'path/raw9/bytes stability')
    return data, dict(path=str(path), bytes=len(data), sha256=sha(data),
                      path_raw9=pr, descriptor_raw9=dr)

def encoded(value):
    return (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True, allow_nan=False) + '\n').encode('ascii')

def decode(data, physical=False):
    def pairs(rows):
        result = {}
        for key, value in rows:
            need(key not in result, 'duplicate Source JSON key')
            result[key] = value
        return result
    def bad(value):
        raise ValueError('nonfinite or ordinary Source float refused')
    need(not data.startswith(b'\xef\xbb\xbf'), 'JSON BOM')
    return json.loads(data.decode('utf-8'), object_pairs_hook=pairs,
                      parse_float=Decimal if physical else bad, parse_constant=bad)

def once(path, data):
    need(path.is_relative_to(OWN) and not path.exists() and type(data) is bytes and
         len(data) <= MAX_FILE, 'own create-only Source write')
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        need(stream.write(data) == len(data), 'complete Source write')
    reread, _ = observe(path)
    need(reread == data, 'Source write readback')

def pointer(path, data):
    return dict(path=path.relative_to(ROOT).as_posix(), bytes=len(data), sha256=sha(data))

