def sha(b):return hashlib.sha256(b).hexdigest()
def raw(s):return [s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns,s.st_ctime_ns,s.st_mode,s.st_nlink,s.st_file_attributes,s.st_birthtime_ns]
def read(p,pin=None):
 for q in p.parents:
  s=q.lstat();assert stat.S_ISDIR(s.st_mode) and not s.st_file_attributes&1024
 a=p.lstat();assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size<=8388608 and not a.st_file_attributes&1024
 with p.open('rb') as f:
  x=os.fstat(f.fileno());b=f.read(a.st_size+1);y=os.fstat(f.fileno())
 z=p.lstat();assert raw(a)==raw(z) and raw(x)==raw(y) and len(b)==a.st_size
 assert [raw(a)[i] for i in (0,1,2,3,5,6,7,8)]==[raw(x)[i] for i in (0,1,2,3,5,6,7,8)]
 if pin:assert sha(b)==pin
 return b,dict(path=p.relative_to(ROOT).as_posix(),bytes=len(b),sha256=sha(b),path_raw9=raw(a),descriptor_raw9=raw(x))
def once(p,b):
 p.parent.mkdir(parents=True,exist_ok=True);assert not p.exists()
 with p.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
 assert read(p,sha(b))[0]==b
def row(p,b):return dict(path=p.relative_to(ROOT).as_posix(),bytes=len(b),sha256=sha(b))
def wire(d):return (json.dumps(d,sort_keys=True,indent=2)+'\n').encode('ascii')
def link(origin,label,target):return '['+label+']('+posixpath.relpath(target,posixpath.dirname(origin) or '.')+')'
def L(origin,label,leaf):return link(origin,label,REL+'/'+leaf)
def section_end():return '\n\n---\n\nEarlier primary bytes below remain exact history; their pending statements describe the earlier selection.\n\n'

