[CmdletBinding()]
param(
    [Parameter(Mandatory=$true)][string]$Facts,
    [Parameter(Mandatory=$true)][string]$ExpectedFactsSha256,
    [Parameter(Mandatory=$true)][string]$ExpectedSelfSha256,
    [Parameter(Mandatory=$true)][string]$ExpectedRootThread,
    [Parameter(Mandatory=$true)][string]$ClockEntryDecision,
    [Parameter(Mandatory=$true)][string]$ExpectedClockEntryDecisionSha256,
    [Parameter(Mandatory=$true)][string]$ClockEntryReview,
    [Parameter(Mandatory=$true)][string]$ExpectedClockEntryReviewSha256,
    [Parameter(Mandatory=$true)][string]$ClockEntryRootAdoption,
    [Parameter(Mandatory=$true)][string]$ExpectedClockEntryRootAdoptionSha256
)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$ExpectedEntry = 'D:\Aenv\pro2\WORK\resume-20261015-001\native_owner_implementation_004\i1\author_prospective_lease_current_owner_native_002.ps1'
$Tool = 'D:\Aenv\pro2\WORK\resume-20261015-001\native_owner_implementation_004\i1\prospective_lease_current_owner_metadata_tools_002.py'
$GeneralHost = 'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe'
$ExpectedNativeImage = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
$ExpectedNativeImageSha256 = '7600ffe12da441fe89d035b13801e8e91d064bc544a27b19a5cf49f6ab8b18f5'
if ([IO.Path]::GetFullPath($PSCommandPath) -cne $ExpectedEntry) { throw 'Exact reviewed Native7 entry path required' }
$PreflightLines = @(& $GeneralHost -I -S -B $Tool --mode preflight --facts $Facts --expected-facts-sha256 $ExpectedFactsSha256 --expected-self-sha256 $ExpectedSelfSha256 --expected-root-thread $ExpectedRootThread --clock-entry-decision $ClockEntryDecision --expected-clock-entry-decision-sha256 $ExpectedClockEntryDecisionSha256 --clock-entry-review $ClockEntryReview --expected-clock-entry-review-sha256 $ExpectedClockEntryReviewSha256 --clock-entry-Root-adoption $ClockEntryRootAdoption --expected-clock-entry-Root-adoption-sha256 $ExpectedClockEntryRootAdoptionSha256)
if ($LASTEXITCODE -ne 0) { throw 'Reviewed current-owner metadata preflight refused before native time or writes' }
$Preflight = ($PreflightLines -join "`n") | ConvertFrom-Json
if ($Preflight.no_writes -ne $true -or $Preflight.target_execution -ne $false -or $Preflight.operational_authority -ne $false) { throw 'Exact no-write Source preflight required' }
$ActualNativeImage = [Diagnostics.Process]::GetCurrentProcess().MainModule.FileName
if ($ActualNativeImage -ine $ExpectedNativeImage) { throw 'Exact original native timestamp image path required' }
if ((Get-FileHash -LiteralPath $ActualNativeImage -Algorithm SHA256).Hash.ToLowerInvariant() -cne $ExpectedNativeImageSha256) { throw 'Exact original native timestamp image SHA required' }
$Duration = [long]$Preflight.selected_duration_seconds
if ($Duration -le 0 -or $Duration -gt 43200) { throw 'Original43200-second maximum required' }
$NativeCreated = [DateTimeOffset]::UtcNow
$NativeEnd = $NativeCreated.AddTicks($Duration * [long]10000000)
$Format = 'o'
$Invariant = [Globalization.CultureInfo]::InvariantCulture
$CreatedUtc = $NativeCreated.ToString($Format,$Invariant)
$EndUtc = $NativeEnd.ToString($Format,$Invariant)
& $GeneralHost -I -S -B $Tool --mode author --facts $Facts --expected-facts-sha256 $ExpectedFactsSha256 --expected-self-sha256 $ExpectedSelfSha256 --expected-root-thread $ExpectedRootThread --clock-entry-decision $ClockEntryDecision --expected-clock-entry-decision-sha256 $ExpectedClockEntryDecisionSha256 --clock-entry-review $ClockEntryReview --expected-clock-entry-review-sha256 $ExpectedClockEntryReviewSha256 --clock-entry-Root-adoption $ClockEntryRootAdoption --expected-clock-entry-Root-adoption-sha256 $ExpectedClockEntryRootAdoptionSha256 --native-created-utc $CreatedUtc --native-end-utc $EndUtc
if ($LASTEXITCODE -ne 0) { throw 'Actual Source-only lease candidate author refused; preserve every output' }
