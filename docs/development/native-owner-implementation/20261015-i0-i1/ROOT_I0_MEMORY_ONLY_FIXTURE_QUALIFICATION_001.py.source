"""Root's finite new-I0 fixture launcher; no I1 or original helper entry."""
import datetime
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(r"D:\Aenv\pro2\WORK\resume-20261015-001\native_owner_implementation_004")
PYTHON = r"C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe"
CAP = 2097152
EXPECTED = {
    "validate_current_owner_support_002.py": "507686ebfef92ed7a85e670049cf0db6526cb336029dd2ce3374fc6191f55e83",
    "CURRENT_OWNER_SUPPORT_VALIDATOR_INERT_API_001.json": "6b6d4c7a10c77f9449c05b14a33ddae25a85bd83290f3c744fadaf10a3835317",
    "test_current_owner_support_validator_pure_001.py": "eae400a8ee3a70d919a8abd66c500c5fe83ce38b731b388740392ffe1dee6526",
}


def utc():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def read(path):
    path = pathlib.Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        raw = handle.read(CAP + 1)
    assert len(raw) <= CAP
    return raw


def pin(path):
    raw = read(path)
    return {"path": str(path), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}


def pinned(fact):
    raw = read(fact["path"])
    assert len(raw) == fact["bytes"] and hashlib.sha256(raw).hexdigest() == fact["sha256"]
    return raw


def main():
    assert len(sys.argv) == 2
    adoption_path = ROOT / "ROOT_I0_INDEPENDENT_SOURCE_REVIEW_ADOPTION_001.json"
    adoption_pin = pin(adoption_path)
    assert adoption_pin["sha256"] == sys.argv[1]
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root"
    assert adoption["verdict"] == "ACCEPT_I0_SOURCE_AND_MEMORY_ONLY_FIXTURE_LAUNCH"
    assert adoption["I1_or_original_entry_authorized"] is False
    assert adoption["new_I0_pure_fixture_launch_authorized"] is True
    review = json.loads(pinned(adoption["different_Source_review"]))
    assert review["checks_failed"] == 0 and type(review["checks_failed"]) is int
    assert review["reviewer"] not in ("/root", "/root/checker_frontier")
    assert not review["reviewer"].startswith("/root/checker_frontier/")
    pinned(review["full_proof"])
    scope_path = ROOT / "ROOT_CURRENT_I0_I1_STATIC_IMPLEMENTATION_AND_PURE_FIXTURE_SCOPE_001.json"
    scope_pin = pin(scope_path)
    assert scope_pin["sha256"] == "c1f041009a2888bf61b194706b9ac5b8ba1b932ea5d48e1e59f36897a8f0654c"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    inputs = []
    for name, expected_hash in EXPECTED.items():
        actual = pin(ROOT / "i0" / name)
        assert actual["sha256"] == expected_hash
        assert actual in adoption["actual_subjects"]
        inputs.append(actual)
    launcher_pin = pin(pathlib.Path(__file__))
    assert launcher_pin == adoption["fixture_launcher"]
    output_path = ROOT / "ROOT_I0_ACTUAL_MEMORY_ONLY_FIXTURE_QUALIFICATION_001.json"
    assert not output_path.exists()
    test_path = str(ROOT / "i0/test_current_owner_support_validator_pure_001.py")
    command = "import sys,runpy;sys.path.insert(0," + repr(str(ROOT / "i0")) + ");sys.argv=[" + repr(test_path) + ",'-v'];runpy.run_path(sys.argv[0],run_name='__main__')"
    argv = [PYTHON, "-I", "-S", "-B", "-c", command]
    started = utc()
    child = subprocess.Popen(argv, cwd=ROOT / "i0", stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
    timed_out = False
    try:
        stdout, stderr = child.communicate(timeout=45)
    except subprocess.TimeoutExpired:
        timed_out = True
        child.kill()
        stdout, stderr = child.communicate(timeout=10)
    completed = utc()
    assert len(stdout) <= CAP and len(stderr) <= CAP
    test_summary = re.search(rb"\nRan ([0-9]+) tests? in [0-9.]+s\r?\n", stderr)
    actual_test_method_count = int(test_summary.group(1)) if test_summary else None
    passed = child.returncode == 0 and not timed_out and actual_test_method_count == 17 and stderr.rstrip().endswith(b"OK")
    assert all(pin(ROOT / "i0" / name)["sha256"] == digest for name, digest in EXPECTED.items())
    outcome = {
        "schema_version": 1, "record_type": "Root_actual_new_I0_memory_only_synthetic_predicate_qualification",
        "author": "/root", "created_utc": utc(), "scope": scope_pin,
        "independent_Source_review_adoption": adoption_pin, "fixture_launcher": launcher_pin,
        "actual_subjects": inputs, "argv": argv, "cwd": str(ROOT / "i0"),
        "owned_child_PID": child.pid, "started_utc": started, "completed_utc": completed,
        "exit_code": child.returncode, "timed_out": timed_out,
        "actual_test_method_count": actual_test_method_count,
        "expected_test_method_count": 17,
        "stdout": stdout.decode("utf-8"), "stderr": stderr.decode("utf-8"),
        "stdout_bytes": len(stdout), "stderr_bytes": len(stderr),
        "stdout_sha256": hashlib.sha256(stdout).hexdigest(), "stderr_sha256": hashlib.sha256(stderr).hexdigest(),
        "all_input_bytes_unchanged_after_run": True,
        "fixture_only": True, "fictional_records_exist_only_inside_test_memory": True,
        "actual_owner_grant_lease_or_family_created": False, "I1_executed": False,
        "original_helpers_tests_or_targets_executed": False, "Native_Parser_executed": False,
        "operational_authority": False, "scientific_authority": False,
        "verdict": "PASS_NEW_I0_MEMORY_ONLY_FIXTURES" if passed else "REFUSED_NEW_I0_MEMORY_ONLY_FIXTURES",
    }
    raw = (json.dumps(outcome, sort_keys=True, indent=2, allow_nan=False) + "\n").encode("utf-8")
    assert len(raw) <= CAP
    with output_path.open("xb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())
    print(json.dumps(pin(output_path)))


if __name__ == "__main__":
    main()
