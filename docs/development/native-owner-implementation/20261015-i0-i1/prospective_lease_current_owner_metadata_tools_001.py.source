def read_native_timestamp_image():
    global _NATIVE_IMAGE_OBSERVATION
    pin = fact3(NATIVE_IMAGE)
    path = absolute(pin['path'])
    need(path == Path('C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe')
         and type(NATIVE_IMAGE_LINKS) is int and NATIVE_IMAGE_LINKS == 2,
         'sole exact pinned original Windows native timestamp image with actual two-link identity')
    ordinary_chain(path)
    before_info = path.lstat()
    before = raw9(before_info)
    need(stat.S_ISREG(before_info.st_mode) and before[6] == NATIVE_IMAGE_LINKS
         and before[2] == pin['bytes'] and 0 < pin['bytes'] <= SOURCE_CAP,
         'actual fixed native image type/link count/length within original ordinary Source cap')
    identity = (0, 1, 2, 3, 6, 7, 8)
    with path.open('rb') as handle:
        descriptor_info = os.fstat(handle.fileno())
        descriptor = raw9(descriptor_info)
        need(stat.S_ISREG(descriptor_info.st_mode) and descriptor[6] == NATIVE_IMAGE_LINKS
             and not (getattr(descriptor_info, 'st_file_attributes', 0) & 0x400)
             and all(before[index] == descriptor[index] for index in identity)
             and stat.S_IFMT(before_info.st_mode) == stat.S_IFMT(descriptor_info.st_mode),
             'fixed native image retained handle shared-seven/type identity; each full API remains separate')
        first = handle.read(SOURCE_CAP+1)
        handle.seek(0)
        second = handle.read(SOURCE_CAP+1)
        need(raw9(os.fstat(handle.fileno())) == descriptor,
             'complete fixed native image descriptor9 independently stable')
    need(first == second and raw9(path.lstat()) == before and len(first) == pin['bytes']
         and sha(first) == pin['sha256'], 'complete pinned native image path9/paired bytes/hash stable')
    observation = dict(Source=pin, path9=before, descriptor9=descriptor, cap=SOURCE_CAP,
        actual_link_count=NATIVE_IMAGE_LINKS, shared_identity_indexes=list(identity),
        ordinary_Source_single_link_reader_unchanged=True)
    if _NATIVE_IMAGE_OBSERVATION is not None:
        need(observation == _NATIVE_IMAGE_OBSERVATION,
             'complete original native image byte/PATH9/descriptor9 observation retained across all stages')
    _NATIVE_IMAGE_OBSERVATION = observation
    return first


def strict_source_decode(body):
    def reject(token):
        raise ValueError('non-integer Source JSON numeric token forbidden: '+token)
    return json.loads(body.decode('utf-8', errors='strict'), object_pairs_hook=pairs,
                      parse_float=reject, parse_constant=reject)


def tracked_pin(pin, *, cap=SOURCE_CAP):
    need(type(pin) is dict and set(pin) == {'path', 'sha256', 'bytes'}, 'closed typed actual fact3 Source pin')
    pin = fact3(pin)
    need(type(cap) is int and 0 < cap <= SOURCE_CAP, 'ordinary Source/proof cap remains at most2MiB')
    previous = dict(OBSERVATIONS[pin['path']]) if pin['path'] in OBSERVATIONS else None
    body = read_pin(pin, cap=cap)
    if previous is not None:
        current = OBSERVATIONS[pin['path']]
        need(current['path9'] == previous['path9'] and current['descriptor9'] == previous['descriptor9'],
             'both complete metadata APIs unchanged across every repeated input read')
    return body


def source_review(pin, subject, physical_author, *, verdict=None):
    subject = fact3(subject)
    tracked_pin(subject)
    proof = strict_source_decode(tracked_pin(pin))
    reviewer = proof.get('reviewer')
    need(type(reviewer) is str and reviewer.startswith('/root/') and reviewer != physical_author
         and (physical_author == '/root' or not reviewer.startswith(physical_author+'/'))
         and type(proof.get('checks_failed')) is int and proof['checks_failed'] == 0
         and proof.get('target_execution') is False and type(proof.get('verdict')) is str
         and proof['verdict'].startswith('PASS_') and _contains_pin(proof, subject),
         'genuine different Source reviewer; exact Root excluded without excluding every Root descendant')
    if verdict is not None:
        need(proof['verdict'] == verdict, 'exact assigned review scope')
    need(proof.get('operational_authority') is False, 'review conveys no operational entry authority')
    full = strict_source_decode(tracked_pin(fact3(proof.get('full_proof'))))
    checks = full.get('checks')
    need(type(checks) is list and len(checks) > 0
         and all(type(c) is dict and type(c.get('name')) is str and c.get('passed') is True for c in checks)
         and type(full.get('checks_failed')) is int and full['checks_failed'] == 0
         and full.get('reviewer') == reviewer and full.get('target_execution') is False
         and full.get('operational_authority') is False and full.get('verdict') == proof['verdict']
         and _contains_pin(full, subject), 'actual bounded hash-verified full Source proof and all named checks')
    birth = OBSERVATIONS[subject['path']]['path9'][8]
    need(type(birth) is int and birth > 0 and birth // 100 <= moment(proof['created_utc']) <= current_ticks()
         and moment(full['created_utc']) == moment(proof['created_utc']),
         'physical Source birth before genuine capsule/full-proof review')
    return proof


def root_adoption(pin, subject, review_pin):
    value = strict_source_decode(tracked_pin(pin))
    need(value['author'] == '/root' and type(value['verdict']) is str
         and value['verdict'].startswith('ACCEPT_') and _contains_pin(value, fact3(subject))
         and _contains_pin(value, fact3(review_pin)) and value['target_execution'] is False
         and value['operational_authority'] is False,
         'genuine Root adoption of actual subject and actual different Source review')
    proof = strict_source_decode(tracked_pin(review_pin))
    need(moment(proof['created_utc']) <= moment(value['created_utc']) <= current_ticks(),
         'different review precedes actual Root adoption')
    return value


def _validated_design_support(facts):
    support = facts['design_support']
    need(type(support) is dict and set(support) == DESIGN_KEYS,
         'explicit closed8 v2 design/I0/provenance support; no historical authority cast')
    need(support['design'] == DESIGN and support['design_Source_review'] == DESIGN_SOURCE_REVIEW
         and support['design_Root_adoption'] == DESIGN_ROOT_ADOPTION
         and support['I0_Source'] == I0_SOURCE and support['I0_API'] == I0_API
         and support['historical_feasibility_support'] == DESIGN_SUPPORT_ACTUAL,
         'actual current design/I0 Source/API, historical feasibility6 distinctly retained')
    source_review(DESIGN_SOURCE_REVIEW, DESIGN, '/root')
    current_adopt = root_adoption(DESIGN_ROOT_ADOPTION, DESIGN, DESIGN_SOURCE_REVIEW)
    need(current_adopt.get('implementation_scope_or_purpose_admission_granted') is False,
         'accepted design grants no native clock purpose')
    for old_pin in DESIGN_SUPPORT_ACTUAL.values():
        tracked_pin(old_pin)
    source_review(support['I0_Source_review'], I0_SOURCE, I0_PHYSICAL_SOURCE_EDITOR)
    i0_adopt = root_adoption(support['I0_Root_adoption'], I0_SOURCE, support['I0_Source_review'])
    i0_proof = strict_source_decode(tracked_pin(support['I0_Source_review']))
    need(_contains_pin(i0_proof, I0_API) and _contains_pin(i0_adopt, I0_API),
         'actual I0 API/Source covered by different full Source review and Root adoption')
    source_bytes = tracked_pin(I0_SOURCE)
    tracked_pin(I0_API)
    return support, source_bytes


def _load_reviewed_i0(facts):
    global _I0_MODULE
    support, source_bytes = _validated_design_support(facts)
    if _I0_MODULE is None:
        # Future invocation only: actual Source is paired-read and proof/adoption checked first.
        import types
        module_name = '_reviewed_current_owner_support_'+I0_SOURCE['sha256']
        need(module_name not in sys.modules, 'fresh exact reviewed I0 module identity')
        module = types.ModuleType(module_name)
        module.__file__ = I0_SOURCE['path']
        sys.modules[module_name] = module
        try:
            exec(compile(source_bytes, I0_SOURCE['path'], 'exec'), module.__dict__)
        except BaseException:
            sys.modules.pop(module_name, None)
            raise
        _I0_MODULE = module
    return support, _I0_MODULE


def current_owner_gate(facts):
    global _CURRENT_CONTEXT
    need(type(_EXPECTED_ROOT_THREAD) is str and re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', _EXPECTED_ROOT_THREAD),
         'actual caller-authenticated Root thread explicitly supplied, never defaulted from history')
    support, module = _load_reviewed_i0(facts)
    pins = facts['current_owner_support']
    need(type(pins) is dict and set(pins) == CURRENT_OWNER_SUPPORT_KEYS,
         'closed3 owner-v2 support; no Source02495 or design-scope substitution')
    context = module.validate_current_owner_support(support=pins, read_record=tracked_pin,
        expected_root_thread=_EXPECTED_ROOT_THREAD, source_editor=BINDING_SOURCE_EDITOR, now_utc=utc())
    need(context.root_thread == _EXPECTED_ROOT_THREAD and context.metadata_only is True
         and context.operational_authority is False and context.scientific_authority is False
         and context.Parser_requires_separate_purpose_admission is True,
         'I0 authenticates context only; PASS cannot grant timestamp or Parser invocation')
    _CURRENT_CONTEXT = context
    return {key: fact3(pins[key]) for key in CURRENT_OWNER_SUPPORT_KEYS}, context


def _clock_resources():
    # Future separately granted entry only. No native access occurs at import time.
    import ctypes
    import shutil
    class MEMORYSTATUSEX(ctypes.Structure):
        _fields_ = [('dwLength',ctypes.c_ulong),('dwMemoryLoad',ctypes.c_ulong),
            ('ullTotalPhys',ctypes.c_ulonglong),('ullAvailPhys',ctypes.c_ulonglong),
            ('ullTotalPageFile',ctypes.c_ulonglong),('ullAvailPageFile',ctypes.c_ulonglong),
            ('ullTotalVirtual',ctypes.c_ulonglong),('ullAvailVirtual',ctypes.c_ulonglong),
            ('ullAvailExtendedVirtual',ctypes.c_ulonglong)]
    begin = current_ticks()
    state = MEMORYSTATUSEX()
    state.dwLength = ctypes.sizeof(state)
    need(ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(state)) != 0, 'actual available RAM observation')
    free = shutil.disk_usage(str(ROOT)).free
    end = current_ticks()
    need(0 <= end-begin <= RESERVE_TICKS and state.ullAvailPhys >= 1073741824 and free >= 10737418240,
         'fresh resource60 observation and unchanged RAM1GiB/disk10GiB floors')
    return dict(observed_utc=utc(), available_RAM_bytes=int(state.ullAvailPhys), free_disk_bytes=free)


def clock_entry_guard(facts, support):
    need(type(_CLOCK_ENTRY_PINS) is dict and set(_CLOCK_ENTRY_PINS) == {'decision','different_review','Root_adoption'},
         'separate real clock-entry decision/full Source review/Root adoption required, never I0 PASS')
    entry_pin = fact3(_CLOCK_ENTRY_PINS['decision'])
    entry = strict_source_decode(tracked_pin(entry_pin))
    context = _CURRENT_CONTEXT
    need(type(entry) is dict and set(entry) == CLOCK_ENTRY_KEYS and type(entry['schema_version']) is int
         and entry['schema_version'] == 2 and entry['record_type'] == CLOCK_ENTRY_RECORD_TYPE
         and entry['author'] == '/root' and entry['Root_thread'] == _EXPECTED_ROOT_THREAD == context.root_thread
         and entry['decision'] == CLOCK_ENTRY_DECISION, 'genuine explicit version2 Root clock-entry purpose')
    expected_kind = 'AUTHOR_NATIVE7_PAIR' if _I1_MODE in ('preflight','author') else 'PUBLISH_REVIEWED_NATIVE7_PAIR'
    need(entry['entry_kind'] == expected_kind and entry['current_owner_support'] == facts['current_owner_support']
         and entry['Root_facts'] == _FACTS_PIN and entry['issuance_decision'] == facts['issuance_decision']
         and entry['tool_source'] == facts['tool_source'] and entry['tool_API'] == fact(API_PATH, read(API_PATH))
         and entry['native_timestamp_entry'] == support['native_timestamp_entry']
         and entry['native_timestamp_image'] == NATIVE_IMAGE and entry['owner_instruction'] == context.instruction_pin.to_dict(),
         'exact actual facts/issuance/Source/API/entry/image/instruction and mode crossjoin')
    for key in ('target_execution','operational_authority','scientific_authority','original_functions_or_fixtures_called','whole_host_quiet'):
        need(entry[key] is False, 'clock purpose grants no other entry: '+key)
    for key, expected in (('resource_age_seconds',60),('minimum_available_RAM_bytes',1073741824),
                           ('minimum_free_disk_bytes',10737418240),('publication_reserve_seconds',60)):
        need(type(entry[key]) is int and entry[key] == expected, 'original resource/reserve exact integer: '+key)
    review = source_review(_CLOCK_ENTRY_PINS['different_review'], entry_pin, '/root')
    adopt = root_adoption(_CLOCK_ENTRY_PINS['Root_adoption'], entry_pin, _CLOCK_ENTRY_PINS['different_review'])
    now = current_ticks()
    start, end = moment(entry['interval_start']), moment(entry['interval_end'])
    need(context.interval_start_ticks <= start <= moment(entry['created_utc']) <= moment(review['created_utc'])
         <= moment(adopt['created_utc']) <= now and now+RESERVE_TICKS < end <= context.interval_end_ticks,
         'actual Root clock purpose/review/adoption chronology and strict Source60 reserve')
    need(moment(facts['created_utc']) <= moment(entry['created_utc'])
         and all(_contains_pin(review, fact3(p)) and _contains_pin(adopt, fact3(p)) for p in
             (_FACTS_PIN, facts['issuance_decision'], facts['tool_source'], entry['tool_API'],
              support['native_timestamp_entry'], context.scope_pin.to_dict(),context.review_pin.to_dict(),context.adoption_pin.to_dict())),
         'different full clock review and Root adoption explicitly cover actual fixed inputs')
    _clock_resources()
    return entry


def decision_and_support(facts):
    global _CURRENT_SUPPORT
    self_pin = fact3(facts['tool_source'])
    need(absolute(self_pin['path']) == SELF and self_pin['sha256'] == _EXPECTED_SELF,
         'exact reviewed current-owner tool Source, no predecessor execution')
    tracked_pin(self_pin)
    tool_review = source_review(facts['tool_review'], self_pin, BINDING_SOURCE_EDITOR)
    tool_adopt = root_adoption(facts['tool_Root_adoption'], self_pin, facts['tool_review'])
    API_pin = fact(API_PATH, read(API_PATH))
    API = strict_source_decode(tracked_pin(API_pin))
    need(API['tool_source'] == self_pin and API['actual_binding_Source_editor'] == BINDING_SOURCE_EDITOR
         and API['I0_Source'] == I0_SOURCE and API['I0_API'] == I0_API
         and API['record_type'] == 'Root_owner_v2_prospective_lease_inert_API'
         and type(API['schema_version']) is int and API['schema_version'] == 2
         and _contains_pin(tool_review, API_pin) and _contains_pin(tool_adopt, API_pin),
         'actual I1 Source/API different full Source review and Root adoption before I0 load')
    pins, context = current_owner_gate(facts)
    design_support = facts['design_support']
    design_adopt = strict_source_decode(tracked_pin(DESIGN_ROOT_ADOPTION))
    need(fact3(facts['owner_master']) == OWNER and fact3(facts['owner_review']) == OWNER_REVIEW
         and type(facts['historical_leases']) is list and facts['historical_leases'] == OLD_LEASES,
         'ongoing actual owner/review and exact all four immutable historical leases')
    owner = strict_source_decode(tracked_pin(OWNER))
    owner_review = strict_source_decode(tracked_pin(OWNER_REVIEW))
    old = [strict_source_decode(tracked_pin(pin, cap=LEASE_CAP)) for pin in OLD_LEASES]
    need(owner['work_end_utc'] is None and owner['fixed_deadline_invented'] is False
         and owner['phase_lease_policy'] == 'A future execution may select a reviewed bounded phase deadline under this ongoing authority; it is an execution lease, not a fabricated owner end or renewal of a spent artifact'
         and owner_review['verdict'] == 'PASS_OWNER_DIRECTIVE_AND_LINEAGE_SOURCE_ONLY'
         and owner_review['source_owner_sha256'] == OWNER['sha256'] and owner_review['owner_end_utc'] is None
         and owner_review['old_artifacts_renewed'] is False,
         'continuing owner has no invented fixed end and grants no old lease renewal')
    decision = strict_source_decode(tracked_pin(facts['issuance_decision']))
    need(type(decision) is dict and set(decision) == DECISION_KEYS and type(decision['schema_version']) is int
         and decision['schema_version'] == 2 and decision['author'] == '/root' and decision['Root_thread'] == _EXPECTED_ROOT_THREAD == context.root_thread
         and decision['record_type'] == 'Root_owner_v2_prospective_lease_issuance_decision'
         and decision['decision'] == 'SELECT_NEW_PROSPECTIVE_CLOSED12_LEASE_SOURCE_ONLY', 'genuine separate Root issuance decision')
    need(decision['current_owner_scope'] == pins['current_owner_scope'] and decision['design'] == DESIGN
         and decision['owner_master'] == OWNER and decision['owner_review'] == OWNER_REVIEW
         and decision['predecessor_lease'] == OLD_LEASES[-1], 'actual issuance design/owner/predecessor pins')
    need(decision['lease_is_owner_deadline'] is False and decision['operational_authority'] is False
         and decision['target_execution'] is False and decision['old_leases_extended'] is False
         and decision['source_family_selected'] is False, 'lease Source decision issues no target, owner deadline, renewal or Source family')
    selected = absolute(decision['future_canonical_path'])
    ordinal = decision['selected_ordinal']
    duration = decision['selected_duration_seconds']
    need(type(ordinal) is int and 11 <= ordinal <= 999 and selected.parent == BASE
         and selected.name == 'EXECUTION_LEASE_GG6_M3_'+str(ordinal).zfill(3)+'.json'
         and all(selected != Path(pin['path']) for pin in OLD_LEASES), 'Root alone selects a unique later canonical lease identity')
    need(type(duration) is int and 0 < duration <= 43200, 'original positive bounded duration and maximum43200 retained')
    scope_adoption = strict_source_decode(tracked_pin(pins['current_owner_scope_Root_adoption']))
    need(max(moment(scope_adoption['created_utc']), moment(design_adopt['created_utc']),
             moment(tool_adopt['created_utc']),moment(strict_source_decode(tracked_pin(design_support['I0_Root_adoption']))['created_utc']))
         <= moment(decision['created_utc']) <= moment(facts['created_utc']) <= current_ticks(),
         'actual Root issuance follows current owner context and actual Source adoptions')
    entry = fact3(decision['native_timestamp_entry'])
    need(absolute(entry['path']) == NATIVE_ENTRY, 'exact reviewed native PS7 timestamp entry, not Python padding')
    tracked_pin(entry)
    tool_review = strict_source_decode(tracked_pin(facts['tool_review']))
    need(_contains_pin(tool_review, entry), 'genuine different review covers actual native timestamp entry bytes')
    need(all(moment(value['lease_end_utc']) < current_ticks() for value in old),
         'historical expired007/008/009/010 remain unchanged; no extension or replay')
    need(type(old[-1]) is dict and set(old[-1]) == LEASE12, 'actual predecessor closed12 schema retained')
    result = dict(current_owner_scope=pins['current_owner_scope'], decision=decision, predecessor=old[-1],
                  canonical_path=selected, duration_seconds=duration, native_timestamp_entry=entry)
    _CURRENT_SUPPORT = result
    clock_entry_guard(facts, result)
    read_native_timestamp_image()
    return result


def load_facts(path, expected):
    global _FACTS_PIN
    path = absolute(path)
    need(path.parent == OWNED and path.name in ('ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_AUTHOR_FACTS_001.json',
         'ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json'), 'exact new Root-owned version2 facts routes')
    _FACTS_PIN = fact(path, read(path, expected, SOURCE_CAP))
    value = strict_source_decode(tracked_pin(_FACTS_PIN))
    need(type(value) is dict and set(value) == FACT_KEYS and len(value) == 14 and type(value['schema_version']) is int
         and value['schema_version'] == 2 and value['author'] == '/root'
         and value['record_type'] == 'Root_owner_v2_prospective_lease_metadata_facts', 'closed14 real version2 Root facts ABI')
    need(moment(value['created_utc']) <= current_ticks(), 'actual facts are not future observations')
    return value


def current_source_guard(facts):
    tracked_pin(_FACTS_PIN)
    pins, context = current_owner_gate(facts)
    need(_CURRENT_SUPPORT is not None and _CURRENT_SUPPORT['current_owner_scope'] == pins['current_owner_scope'],
         'same authenticated actual owner context on every repeated guard')
    clock_entry_guard(facts, _CURRENT_SUPPORT)
    read_native_timestamp_image()
    postread()


def write_root_once(path, body, cap, facts, allowed):
    need(os.name == 'nt', 'native Windows no-overwrite rename semantics')
    path = absolute(path)
    need(path in allowed and type(body) is bytes and type(cap) is int and 0 < cap <= SOURCE_CAP
         and len(body) <= cap, 'only the exact finite Root-selected output bytes within unchanged caps')
    ordinary_chain(path.parent)
    absent_output(path)
    current_source_guard(facts)
    staging = Path(str(path)+'.staging')
    with staging.open('xb') as handle:
        need(handle.write(body) == len(body), 'whole exclusive Source staging write')
        handle.flush()
        os.fsync(handle.fileno())
    need(read(staging, sha(body), cap) == body, 'complete retained staging readback')
    current_source_guard(facts)
    ordinary_chain(path.parent)
    need(not os.path.lexists(path), 'canonical still fresh immediately before Windows rename')
    os.rename(staging, path)
    need(not os.path.lexists(staging), 'no retained staging alias after exact rename')
    prior = dict(OBSERVATIONS.pop(str(staging)))
    need(read(path, sha(body), cap) == body, 'complete Root-created whole-byte readback')
    current = dict(OBSERVATIONS[str(path)])
    need(all(prior['path9'][i] == current['path9'][i] for i in (0,1,2,3,5,6,7,8))
         and all(prior['descriptor9'][i] == current['descriptor9'][i] for i in (0,1,2,3,5,6,7,8)),
         'actual moved identity and both APIs retain all non-rename fields; ctime remains disclosed')
    current_source_guard(facts)
    return fact(path, body), dict(staging=prior, canonical=current)


def candidate_body(support, created_utc, end_utc, *, require_fresh_native_clock=False):
    created, end = moment(created_utc, 7), moment(end_utc, 7)
    now = current_ticks()
    need(moment(support['decision']['created_utc']) <= created <= now
         and end-created == support['duration_seconds']*10000000
         and now+1200*10000000 < end, 'real fresh native PS7 pair and unchanged original1200 admission reserve')
    if require_fresh_native_clock:
        need(0 <= now-created <= RESERVE_TICKS, 'native PS7 time sampled at this actual author invocation')
    value = dict(support['predecessor'])
    value['created_utc'], value['lease_end_utc'] = created_utc, end_utc
    need(set(value) == LEASE12 and type(value['maximum_lease_seconds']) is int and value['maximum_lease_seconds'] == 43200
         and value['lease_is_owner_deadline'] is False and value['operational_authority'] is False
         and value['scope'] == 'COPIED_CONSUMER_GUARD_UNIT006_STDLIB_ONLY_NO_OPERATIONAL_AUTHORITY'
         and value['owner_master_sha256'] == OWNER['sha256'] and value['owner_review_sha256'] == OWNER_REVIEW['sha256']
         and all(value[key] == support['predecessor'][key] for key in LEASE12-{'created_utc','lease_end_utc'}),
         'exact whole original closed12 lease, all ten protected owner/decision/scope/authority leaves retained')
    return wire(value), value


def author_candidate(facts, support, created_utc, end_utc):
    need(facts['candidate_support'] is None, 'no guessed review or canonical publication of a future candidate')
    candidate_path = OWNED/'lease_drafts'/support['canonical_path'].name
    body, value = candidate_body(support, created_utc, end_utc, require_fresh_native_clock=True)
    allowed = frozenset((candidate_path, AUTHOR_RECEIPT))
    for path in allowed | frozenset((support['canonical_path'], PUBLICATION_RECEIPT)):
        absent_output(path)
    postread()
    if not os.path.lexists(candidate_path.parent):
        need(candidate_path.parent == OWNED/'lease_drafts', 'sole confined candidate metadata directory')
        current_source_guard(facts)
        candidate_path.parent.mkdir()
        current_source_guard(facts)
    pin, metadata = write_root_once(candidate_path, body, LEASE_CAP, facts, allowed)
    receipt = dict(schema_version=2, record_type='Root_owner_v2_prospective_lease_candidate_author_receipt',
        author='/root', physical_Source_editor='/root', metadata_tool_Source_author=METADATA_AUTHOR, created_utc=utc(),
        current_owner_scope=support['current_owner_scope'], Root_facts=_FACTS_PIN, issuance_decision=facts['issuance_decision'],
        native_timestamp_entry=support['native_timestamp_entry'], native_timestamp_image=NATIVE_IMAGE,
        native_image_metadata=_NATIVE_IMAGE_OBSERVATION, native_created_utc=value['created_utc'],
        native_end_utc=value['lease_end_utc'], selected_duration_seconds=support['duration_seconds'],
        future_canonical_path=str(support['canonical_path']), candidate=pin, predecessor_lease=OLD_LEASES[-1],
        immutable_historical_leases=OLD_LEASES, owner_master=OWNER, owner_review=OWNER_REVIEW, actual_creation_metadata=metadata,
        canonical_publication=False, different_candidate_Source_review_pending=True, operational_authority=False,
        lease_is_owner_deadline=False, target_execution=False, source_family_selected=False, old_leases_extended=False,
        original_functions_or_fixtures_called=False, publication_reserve_seconds=60, source_cap=LEASE_CAP)
    need(set(receipt) == CANDIDATE_RECEIPT_KEYS and len(receipt) == 32, 'closed exact version2 metadata envelope')
    receipt_pin, receipt_metadata = write_root_once(AUTHOR_RECEIPT, wire(receipt), SOURCE_CAP, facts, allowed)
    return dict(candidate=pin, author_receipt=receipt_pin, candidate_metadata=metadata,
                receipt_metadata=receipt_metadata, canonical_publication=False, target_execution=False, operational_authority=False)


def publish_candidate(facts, support):
    candidate = facts['candidate_support']
    need(type(candidate) is dict and set(candidate) == CANDIDATE_KEYS, 'four real candidate review/publication prerequisites')
    expected_path = OWNED/'lease_drafts'/support['canonical_path'].name
    pin = fact3(candidate['candidate'])
    need(absolute(pin['path']) == expected_path, 'exact genuinely authored selected lease draft')
    body = tracked_pin(pin, cap=LEASE_CAP)
    value = strict_source_decode(body)
    actual_body, _ = candidate_body(support, value['created_utc'], value['lease_end_utc'])
    need(body == actual_body, 'whole original canonical lease wire and all protected leaves exactly reconstructed')
    receipt = strict_source_decode(tracked_pin(candidate['author_receipt']))
    need(type(receipt) is dict and set(receipt) == CANDIDATE_RECEIPT_KEYS and len(receipt) == 32
         and type(receipt['schema_version']) is int and receipt['schema_version'] == 2
         and receipt['record_type'] == 'Root_owner_v2_prospective_lease_candidate_author_receipt'
         and receipt['metadata_tool_Source_author'] == METADATA_AUTHOR
         and absolute(fact3(candidate['author_receipt'])['path']) == AUTHOR_RECEIPT
         and receipt['author'] == receipt['physical_Source_editor'] == '/root'
         and receipt['candidate'] == pin and receipt['issuance_decision'] == facts['issuance_decision']
         and receipt['current_owner_scope'] == support['current_owner_scope'] and receipt['canonical_publication'] is False
         and receipt['target_execution'] is False and receipt['operational_authority'] is False,
         'real Root author receipt and fixed candidate/source/decision provenance')
    proof = source_review(candidate['different_review'], pin, '/root')
    need(_contains_pin(proof, fact3(candidate['author_receipt']))
         and proof['operational_authority'] is False, 'different lease review binds actual candidate and actual author receipt')
    root_adoption(candidate['Root_adoption'], pin, candidate['different_review'])
    allowed = frozenset((support['canonical_path'], PUBLICATION_RECEIPT))
    for path in allowed:
        absent_output(path)
    postread()
    canonical, metadata = write_root_once(support['canonical_path'], body, LEASE_CAP, facts, allowed)
    record = dict(schema_version=2, record_type='Root_owner_v2_prospective_lease_original_publication',
        author='/root', physical_Source_editor='/root', metadata_tool_Source_author=METADATA_AUTHOR, created_utc=utc(),
        current_owner_scope=support['current_owner_scope'], Root_facts=_FACTS_PIN, issuance_decision=facts['issuance_decision'],
        candidate=pin, candidate_author_receipt=fact3(candidate['author_receipt']),
        different_lease_Source_review=fact3(candidate['different_review']), candidate_Root_adoption=fact3(candidate['Root_adoption']),
        canonical=canonical, original_closed12_schema_preserved=True, complete_candidate_bytes_exact=True,
        original_owner_and_timestamp_contracts_preserved=True, predecessor_lease=OLD_LEASES[-1],
        immutable_historical_leases=OLD_LEASES, continuing_owner=OWNER, owner_review=OWNER_REVIEW,
        selected_duration_seconds=support['duration_seconds'], actual_publication_metadata=metadata,
        native_timestamp_image=NATIVE_IMAGE, native_image_metadata=_NATIVE_IMAGE_OBSERVATION,
        operational_authority=False, lease_is_owner_deadline=False, target_execution=False,
        source_family_selected=False, actual_entry006=False, original_fixture_or_case_grant=False,
        old_leases_extended=False, host_quiet=False, actor_Job_or_science_authority=False,
        publication_reserve_seconds=60, verdict='ROOT_EXACT_REVIEWED_NEW_CLOSED12_LEASE_SOURCE_PUBLICATION_ONLY')
    need(set(record) == PUBLICATION_KEYS and len(record) == 36, 'closed exact version2 metadata envelope')
    receipt_pin, receipt_metadata = write_root_once(PUBLICATION_RECEIPT, wire(record), SOURCE_CAP, facts, allowed)
    return dict(canonical=canonical, publication_receipt=receipt_pin, canonical_metadata=metadata,
                receipt_metadata=receipt_metadata, target_execution=False, operational_authority=False)


def main():
    global _EXPECTED_SELF, _EXPECTED_ROOT_THREAD, _CLOCK_ENTRY_PINS, _I1_MODE
    parser = argparse.ArgumentParser(allow_abbrev=False)
    parser.add_argument('--mode', choices=('preflight', 'author', 'publish'), required=True)
    parser.add_argument('--facts', type=Path, required=True)
    parser.add_argument('--expected-facts-sha256', required=True)
    parser.add_argument('--expected-self-sha256', required=True)
    parser.add_argument('--expected-root-thread', required=True)
    parser.add_argument('--clock-entry-decision', type=Path, required=True)
    parser.add_argument('--expected-clock-entry-decision-sha256', required=True)
    parser.add_argument('--clock-entry-review', type=Path, required=True)
    parser.add_argument('--expected-clock-entry-review-sha256', required=True)
    parser.add_argument('--clock-entry-Root-adoption', type=Path, required=True)
    parser.add_argument('--expected-clock-entry-Root-adoption-sha256', required=True)
    parser.add_argument('--native-created-utc')
    parser.add_argument('--native-end-utc')
    args = parser.parse_args()
    need(os.name == 'nt' and Path(__file__).absolute() == SELF and sys.flags.isolated == 1
         and sys.flags.no_site == 1 and sys.dont_write_bytecode and Path(sys.executable) == GENERAL_HOST,
         'exact reviewed own metadata tool under isolated general host; never frozen interpreter')
    _EXPECTED_SELF = args.expected_self_sha256
    _EXPECTED_ROOT_THREAD = args.expected_root_thread
    _I1_MODE = args.mode
    _CLOCK_ENTRY_PINS = {
        'decision': fact(args.clock_entry_decision, read(args.clock_entry_decision, args.expected_clock_entry_decision_sha256, SOURCE_CAP)),
        'different_review': fact(args.clock_entry_review, read(args.clock_entry_review, args.expected_clock_entry_review_sha256, SOURCE_CAP)),
        'Root_adoption': fact(args.clock_entry_Root_adoption, read(args.clock_entry_Root_adoption, args.expected_clock_entry_Root_adoption_sha256, SOURCE_CAP))}

    facts = load_facts(args.facts, args.expected_facts_sha256)
    support = decision_and_support(facts)
    current_source_guard(facts)
    if args.mode == 'preflight':
        need(facts['candidate_support'] is None and args.native_created_utc is None and args.native_end_utc is None,
             'native timestamp preflight performs no output or lease selection')
        result = dict(selected_duration_seconds=support['duration_seconds'], future_canonical_path=str(support['canonical_path']),
                      current_owner_scope=support['current_owner_scope'], no_writes=True, target_execution=False, operational_authority=False)
    elif args.mode == 'author':
        need(type(args.native_created_utc) is str and type(args.native_end_utc) is str,
             'actual native PS7 UTC pair supplied after successful reviewed metadata preflight')
        result = author_candidate(facts, support, args.native_created_utc, args.native_end_utc)
    else:
        need(args.native_created_utc is None and args.native_end_utc is None, 'publication preserves exact genuine earlier timestamps')
        result = publish_candidate(facts, support)
    print(json.dumps(result, sort_keys=True))


if __name__ == '__main__':
    main()
