"""Prepare finite reviewed implementation evidence and navigation candidates."""
import datetime
import hashlib
import json
import os
import pathlib

R = pathlib.Path(r"D:\Aenv\pro2")
O = R / "WORK/resume-20261015-001/native_owner_implementation_004"
G = R / "github-portable-20261012-001"
C = O / "managed_preparation_001/candidates_001"
REL = "docs/development/native-owner-implementation/20261015-i0-i1/"
CAP = 2097152


def raw(path):
    path = pathlib.Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = pathlib.Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_path = O / "ROOT_I0_I1_IMPLEMENTATION_AND_SAVED_FIXTURE_REVIEW_ADOPTION_001.json"
    adoption_pin = fact(adoption_path)
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I0_I1_SOURCE_AND_SAVED_I0_FIXTURE_RESULTS"
    result_pin = adoption["I0_actual_fixture_result"]
    result = json.loads(pinned(result_pin))
    assert result["verdict"] == "PASS_NEW_I0_MEMORY_ONLY_FIXTURES" and result["actual_test_method_count"] == 17
    assert result["I1_executed"] is False and result["original_helpers_tests_or_targets_executed"] is False
    scope_pin = fact(O / "ROOT_CURRENT_I0_I1_STATIC_IMPLEMENTATION_AND_PURE_FIXTURE_SCOPE_001.json")
    assert scope_pin["sha256"] == "c1f041009a2888bf61b194706b9ac5b8ba1b932ea5d48e1e59f36897a8f0654c"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    old_scope_path = R / "WORK/resume-20261015-001/native_admission_design_003/managed_preparation_001/candidates_001/EXACT_MANAGED_NATIVE_DESIGN_PUBLICATION_SCOPE_001.json"
    old_scope_pin = fact(old_scope_path)
    assert old_scope_pin["sha256"] == "00222204c1f3ee14923866180c996a3c2f02affba3e0eec5ff11959497c2f56a"
    old = json.loads(pinned(old_scope_pin))
    rows = []
    evidence = []
    names = set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = pathlib.Path(pin["path"])
        assert path.resolve().is_relative_to(O.resolve())
        name = path.name + (".source" if path.suffix in (".py", ".ps1") else "")
        assert pathlib.Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": path.suffix in (".py", ".ps1")})
    index = {"schema_version": 1, "record_type": "I0_I1_exact_Source_review_and_new_I0_fixture_evidence_index",
             "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
             "actual_evidence_copy_count": len(evidence), "files": evidence,
             "new_I0_fixture_methods_passed": 17, "I1_native_Parser_original_or_scientific_execution": False,
             "current_dated_Source_inventory": {"present": 36, "pending": 9},
             "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}}
    add(REL + "evidence-index.json", index)
    report = """# Current owner support and lease Source implementation

Root accepted the new I0 owner-support validator and I1 prospective-lease Source port on October 15, 2026 after actual independent Source review and [Root adoption](ROOT_I0_I1_IMPLEMENTATION_AND_SAVED_FIXTURE_REVIEW_ADOPTION_001.json).

**The new I0 validator passed all 17 in-memory test methods.** The [actual saved result](ROOT_I0_ACTUAL_MEMORY_ONLY_FIXTURE_QUALIFICATION_001.json) retains isolated Python argv, owned child PID, timestamps, exit status and complete output. A different reviewer checked the saved outcome after an earlier Source review and Root adoption allowed this finite run. Fictional owner records exist only inside test memory. This qualifies the newly authored pure predicates; it creates no real owner grant, lease or selected family.

I0 validates exact support3/owner-scope28, strict types and JSON, whole-record pins, full Source proof coverage, Root/thread/editor bindings, exact UTC6/UTC7 integer ticks, chronology and the strict 60-second reserve. Its returned context is detached and immutable. The callback must be the caller's reviewed paired/pinned reader. Human origin, real review performance, physical metadata and spent-identity history remain separate caller evidence obligations.

**I1 is authored and Source-reviewed; I1 and its PowerShell entry remain unrun.** It uses the finalized I0 Source/API through pinned internal loading, explicit Root thread and new versioned context records. A distinct reviewed Root clock-entry decision must precede any native timestamp image read. I0 validation alone cannot grant that operation. The complete predecessor inverse and function inventory retain the original file/descriptor identity, timestamp, duration, candidate/publication and cap guards. Earlier unrun drafts and author stops remain dated history.

The independent review rejected draft002 because its new clock-purpose guard compared FILETIME1601 context ticks with Unix1970 producer ticks. Successor003 applies an exact integer epoch bridge in the new guard. The original timestamp parser and native producer remain unchanged; the rejected draft and saved refusal are retained.

No native clock, Native8, Parser, original helper/test/fixture, C8, actual6, runtime, recovery or scientific work ran. No new lease, family, purpose, grant or actual native result was issued. The old Source selection remains **36/45, nine pending**; frozen STEP080 remains **35/45, ten pending**. All 75 spent identities and original caps/reserves remain preserved. These new helpers do not automatically complete the historical 45-role family.

The next task is a separately scoped **I2 coherent-family Source context port**, followed by I3 Native8 and I4 Parser context ports. A future family needs genuinely new phase Sources beyond ordinal018, authentic current authority and all original guards before native or Parser entry. This implementation supplies no such entry permission.

The [evidence index](evidence-index.json) records exact Source/API/inverse/review/result copies. Python and PowerShell are retained as inert `.source` files with dated absolute-path provenance. This directory adds development evidence; it does not rebuild or overlay the STEP080 archive. All three navigation prepends retain the complete previous bytes. Later Git history and external Root receipts record publication.
"""
    add(REL + "I0_I1_IMPLEMENTATION.md", report.encode())
    prefix = ("**October15 I0/I1 implementation accepted.** The [owner-support and lease Source report](" + REL + "I0_I1_IMPLEMENTATION.md) records the new I0 validator's **17 passing memory-only test methods** and independently reviewed I1 Source. I1/native/Parser/original/runtime/scientific entry remains unrun; no real owner grant, lease or new family was issued. Next: separately scope I2 coherent-family Source context. The dated Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        prior_bytes = pinned(predecessor)
        saved = save(O / "managed_preparation_001/predecessors_001" / name, prior_bytes)
        source = save(C / name, prefix + prior_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {"schema_version": 1, "record_type": "Root_exact_finite_I0_I1_implementation_managed_publication_scope",
                         "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                         "base_HEAD": "e87519f2f75342b56aef16e0f0b28d379ca3c7de",
                         "managed_file_count": len(rows), "files": rows,
                         "Root_implementation_adoption": adoption_pin, "I0_actual_fixture_result": result_pin,
                         "preexisting608_byte_baseline": old["preexisting608_byte_baseline"],
                         "all_frozen_STEP080_sentinels": old["all_frozen_STEP080_sentinels"],
                         "current36_Source_baseline": old["current36_Source_baseline"],
                         "target_execution": False, "original_tests_executed": False,
                         "new_I0_memory_only_tests_executed": True, "I1_executed": False}
    print(json.dumps(save(C / "EXACT_MANAGED_I0_I1_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
