"""Pure owner-v2 metadata support validation; no I/O or grant is performed.

The caller supplies a reviewed paired/pinned reader, its actually bound Root
thread, the physical non-Root Source editor, and an honest current UTC clock.
JSON declarations do not establish human origin or real review performance.
Those provenance facts remain the caller's separate evidence obligations.
"""

from dataclasses import dataclass, field
from datetime import date
import hashlib
import json
import re


METADATA_CAP_BYTES = 2_097_152
TICKS_PER_SECOND = 10_000_000
PUBLICATION_RESERVE_TICKS = 60 * TICKS_PER_SECOND
_EPOCH_ORDINAL = date(1601, 1, 1).toordinal()
_UTC = re.compile(r"([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})\.([0-9]{6,7})(Z|\+00:00)\Z")
_ACTOR = re.compile(r"/root(?:/[A-Za-z0-9_-]+)+\Z")
_PIN_KEYS = frozenset({"path", "bytes", "sha256"})
_SUPPORT_KEYS = frozenset({"current_owner_scope", "different_current_owner_scope_Source_review", "current_owner_scope_Root_adoption"})
_SCOPE_KEYS = frozenset({
    "schema_version", "record_type", "author", "Root_thread", "created_utc",
    "owner_instruction_record", "owner_policy_record", "operation_scope",
    "scope_stage", "interval_start", "interval_end",
    "maximum_local_agents_including_Root",
    "historical_shared_maximum_including_both_roots_and_overlap",
    "reserved_overlap_slots", "publication_reserve_seconds",
    "lease_admission_reserve_seconds", "resource_age_seconds",
    "minimum_available_RAM_bytes", "minimum_free_disk_bytes",
    "read_only_native_metadata_authority", "Parser_requires_separate_purpose_admission",
    "target_execution", "operational_authority", "scientific_authority",
    "Pro3_coordination_required", "whole_host_quiet", "old_leases_extended",
    "notify_owner_if_actual_resource_pause_needed",
})
_WITNESS_KEYS = frozenset({
    "schema_version", "record_type", "author", "Root_thread", "created_utc",
    "human_message_observed_utc", "human_message_reference", "exact_text", "attribution",
})
_REVIEW_KEYS = frozenset({
    "schema_version", "record_type", "reviewer", "source_author", "created_utc",
    "verdict", "subjects", "checks_failed", "target_execution",
    "operational_authority", "native_Parser_executed", "full_proof", "scope",
})
_ADOPTION_KEYS = frozenset({
    "schema_version", "record_type", "author", "created_utc", "verdict",
    "subjects", "different_review", "target_execution", "operational_authority",
})
_PROOF_KEYS = frozenset({
    "schema_version", "record_type", "reviewer", "source_author", "created_utc",
    "verdict", "subjects", "scope", "checks", "checks_failed",
    "target_execution", "operational_authority", "native_Parser_executed",
    "subject_reviews", "owner_provenance_boundary",
})
_PASS = "PASS_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY"
_PROVENANCE_BOUNDARY = "ROOT_RETAINED_WITNESSES_REQUIRE_CALLER_PROVENANCE_VERIFICATION"
_REQUIRED_CHECKS = frozenset({
    "owner_scope_whole_bytes_and_closed28",
    "instruction_retained_witness_binding_and_provenance",
    "policy_retained_witness_binding_and_provenance",
    "scope_resource_time_and_authority_bounds",
})


@dataclass(frozen=True, slots=True)
class Pin:
    path: str
    bytes: int
    sha256: str

    def to_dict(self):
        """Return a fresh builtin fact3; no caller-owned object is retained."""
        return {"path": self.path, "bytes": self.bytes, "sha256": self.sha256}


@dataclass(frozen=True, slots=True)
class OwnerMetadataContext:
    root_thread: str
    scope_pin: Pin
    review_pin: Pin
    adoption_pin: Pin
    instruction_pin: Pin
    policy_pin: Pin
    full_proof_pin: Pin
    created_utc: str
    interval_start: str
    interval_end: str
    created_ticks: int
    interval_start_ticks: int
    interval_end_ticks: int
    validated_now_ticks: int
    metadata_only: bool = field(default=True, init=False)
    operational_authority: bool = field(default=False, init=False)
    scientific_authority: bool = field(default=False, init=False)
    Parser_requires_separate_purpose_admission: bool = field(default=True, init=False)
    human_origin_authenticated_by_this_pure_validator: bool = field(default=False, init=False)

    def support_dict(self):
        return {
            "current_owner_scope": self.scope_pin.to_dict(),
            "different_current_owner_scope_Source_review": self.review_pin.to_dict(),
            "current_owner_scope_Root_adoption": self.adoption_pin.to_dict(),
        }


def _closed(value, keys, label):
    if type(value) is not dict or any(type(k) is not str for k in value) or set(value) != keys:
        raise ValueError(label + " must have exactly the declared builtin-dict fields")
    return value


def _text(value, label, maximum=4096):
    if type(value) is not str or not value or any(ord(c) < 32 for c in value):
        raise ValueError(label + " must be nonempty plain text without control characters")
    try:
        size = len(value.encode("utf-8"))
    except UnicodeError as exc:
        raise ValueError(label + " must be valid UTF-8 text") from exc
    if size > maximum:
        raise ValueError(label + " exceeds its declared text cap")
    return value


def _exact(actual, required, label):
    if type(actual) is not type(required) or actual != required:
        raise ValueError(label + " has the wrong exact type or value")


def _pin(value, label):
    _closed(value, _PIN_KEYS, label)
    path = _text(value["path"], label + ".path")
    size = value["bytes"]
    digest = value["sha256"]
    if type(size) is not int or not 0 < size <= METADATA_CAP_BYTES:
        raise ValueError(label + ".bytes must be a positive integer within 2 MiB")
    if type(digest) is not str or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        raise ValueError(label + ".sha256 must be lowercase SHA256")
    return Pin(path, size, digest)


def _ticks(value, label):
    """Exact UTC6/UTC7 to 100 ns FILETIME ticks, without float/truncation."""
    if type(value) is not str:
        raise ValueError(label + " must be a UTC6 or UTC7 string")
    match = _UTC.fullmatch(value)
    if match is None:
        raise ValueError(label + " must use exact UTC6/UTC7 with Z or +00:00")
    year, month, day, hour, minute, second = (int(v) for v in match.groups()[:6])
    if year < 1601 or hour > 23 or minute > 59 or second > 59:
        raise ValueError(label + " is outside the exact supported UTC range")
    try:
        ordinal = date(year, month, day).toordinal()
    except ValueError as exc:
        raise ValueError(label + " is not a valid UTC calendar date") from exc
    seconds = (ordinal - _EPOCH_ORDINAL) * 86400 + hour * 3600 + minute * 60 + second
    return seconds * TICKS_PER_SECOND + int(match.group(7).ljust(7, "0"))


def _nonroot_actor(value, label):
    if type(value) is not str or _ACTOR.fullmatch(value) is None:
        raise ValueError(label + " must identify an actual non-Root agent subtree")
    return value


def _reader(read_record):
    if not callable(read_record):
        raise ValueError("read_record must be the caller's reviewed internal paired/pinned reader")
    held = {}

    def read(pin, label):
        if pin.path in held:
            raise ValueError("Distinct records must not replay or alias a held path")
        held[pin.path] = pin
        try:
            raw = read_record(pin.to_dict())
        except Exception as exc:
            raise ValueError(label + " was refused by the caller's record reader") from exc
        if type(raw) is not bytes or len(raw) != pin.bytes or len(raw) > METADATA_CAP_BYTES:
            raise ValueError(label + " reader must return exact bounded builtin bytes")
        if hashlib.sha256(raw).hexdigest() != pin.sha256:
            raise ValueError(label + " whole-byte digest mismatch")

        def unique_pairs(items):
            result = {}
            for key, value in items:
                if key in result:
                    raise ValueError(label + " has a duplicate JSON key")
                result[key] = value
            return result

        def reject_number(_value):
            raise ValueError(label + " forbids floats, NaN and Infinity")

        try:
            value = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_pairs,
                               parse_float=reject_number, parse_constant=reject_number)
        except (ValueError, UnicodeError, RecursionError) as exc:
            raise ValueError(label + " is not strict float-free unique-key UTF-8 JSON") from exc
        if type(value) is not dict:
            raise ValueError(label + " must be a JSON object")
        return value

    return read


def _subject_list(value, required, label):
    if type(value) is not list or len(value) != len(required):
        raise ValueError(label + " must cover exactly scope, instruction and policy")
    actual = tuple(_pin(v, label) for v in value)
    if actual != required:
        raise ValueError(label + " is cross-scope, reordered or incomplete")


def _witness(record, kind, root_thread, scope_created):
    _closed(record, _WITNESS_KEYS, kind)
    _exact(record["schema_version"], 2, kind + ".schema_version")
    _exact(record["record_type"], "Root_retained_owner_" + kind + "_witness_v2", kind + ".record_type")
    _exact(record["author"], "/root", kind + ".author")
    _exact(record["Root_thread"], root_thread, kind + ".Root_thread")
    _exact(record["attribution"], "DIRECT_USER_MESSAGE_RETAINED_BY_ROOT", kind + ".attribution")
    _text(record["human_message_reference"], kind + ".human_message_reference")
    _text(record["exact_text"], kind + ".exact_text", 65536)
    observed = _ticks(record["human_message_observed_utc"], kind + ".human_message_observed_utc")
    created = _ticks(record["created_utc"], kind + ".created_utc")
    if not observed <= created <= scope_created:
        raise ValueError(kind + " retained-witness chronology is invalid")


def validate_current_owner_support(*, support, read_record, expected_root_thread, source_editor, now_utc):
    """Validate exact support3 and return detached metadata-only context.

    read_record receives a fresh fact3 dictionary and must return actual exact
    raw bytes through the caller's reviewed paired/pinned reader. This is not
    an extension-hook/CLI trust boundary. Callers must bind real thread/editor,
    actual clock, authentic record births/review, human provenance and any
    spent-identity ledger independently. This pure function has no replay
    database, filesystem/native observations, clock source or target actions.
    """
    _closed(support, _SUPPORT_KEYS, "support3")
    root_thread = _text(expected_root_thread, "expected_root_thread", 512)
    editor = _nonroot_actor(source_editor, "source_editor")
    now = _ticks(now_utc, "now_utc")
    scope_pin = _pin(support["current_owner_scope"], "support.scope")
    review_pin = _pin(support["different_current_owner_scope_Source_review"], "support.review")
    adoption_pin = _pin(support["current_owner_scope_Root_adoption"], "support.adoption")
    read = _reader(read_record)
    scope = read(scope_pin, "owner scope")
    _closed(scope, _SCOPE_KEYS, "owner scope28")
    fixed = {
        "schema_version": 2,
        "record_type": "Root_owner_v2_native_metadata_Source_preparation_scope",
        "author": "/root", "Root_thread": root_thread,
        "operation_scope": "EXACT8_NATIVE_SOURCE_METADATA_AND_SEPARATELY_ADMITTED_PARSER4_ONLY",
        "scope_stage": "SEPARATELY_GRANTED_METADATA_PREPARATION",
        "maximum_local_agents_including_Root": 3,
        "historical_shared_maximum_including_both_roots_and_overlap": 5,
        "reserved_overlap_slots": 2, "publication_reserve_seconds": 60,
        "lease_admission_reserve_seconds": 1200, "resource_age_seconds": 60,
        "minimum_available_RAM_bytes": 1073741824,
        "minimum_free_disk_bytes": 10737418240,
        "read_only_native_metadata_authority": True,
        "Parser_requires_separate_purpose_admission": True,
        "target_execution": False, "operational_authority": False,
        "scientific_authority": False, "Pro3_coordination_required": False,
        "whole_host_quiet": False, "old_leases_extended": False,
        "notify_owner_if_actual_resource_pause_needed": True,
    }
    for key, required in fixed.items():
        _exact(scope[key], required, "scope." + key)
    created = _ticks(scope["created_utc"], "scope.created_utc")
    start = _ticks(scope["interval_start"], "scope.interval_start")
    end = _ticks(scope["interval_end"], "scope.interval_end")
    if not start <= created <= now or not end - now > PUBLICATION_RESERVE_TICKS:
        raise ValueError("Scope requires current finite interval and strictly more than Source60 remaining")
    instruction_pin = _pin(scope["owner_instruction_record"], "scope.instruction")
    policy_pin = _pin(scope["owner_policy_record"], "scope.policy")
    instruction = read(instruction_pin, "retained instruction")
    policy = read(policy_pin, "retained policy")
    _witness(instruction, "instruction", root_thread, created)
    _witness(policy, "resource_policy", root_thread, created)
    subjects = (scope_pin, instruction_pin, policy_pin)
    review = read(review_pin, "different Source review")
    _closed(review, _REVIEW_KEYS, "different Source review13")
    for key, required in {
        "schema_version": 2, "record_type": "independent_Root_owner_v2_metadata_scope_Source_review",
        "source_author": "/root", "verdict": _PASS, "checks_failed": 0,
        "target_execution": False, "operational_authority": False, "native_Parser_executed": False,
    }.items():
        _exact(review[key], required, "review." + key)
    reviewer = _nonroot_actor(review["reviewer"], "review.reviewer")
    if reviewer == editor or reviewer.startswith(editor + "/"):
        raise ValueError("Source reviewer cannot be the actual physical Source editor or its subtree")
    _subject_list(review["subjects"], subjects, "review.subjects")
    if _pin(review["scope"], "review.scope") != scope_pin:
        raise ValueError("Source review does not bind exact scope pin")
    reviewed = _ticks(review["created_utc"], "review.created_utc")
    proof_pin = _pin(review["full_proof"], "review.full_proof")
    proof = read(proof_pin, "actual full Source proof")
    _closed(proof, _PROOF_KEYS, "full Source proof15")
    for key, required in {
        "schema_version": 2, "record_type": "independent_Root_owner_v2_metadata_scope_full_Source_proof",
        "reviewer": reviewer, "source_author": "/root", "verdict": _PASS,
        "checks_failed": 0, "target_execution": False, "operational_authority": False,
        "native_Parser_executed": False, "owner_provenance_boundary": _PROVENANCE_BOUNDARY,
    }.items():
        _exact(proof[key], required, "proof." + key)
    _subject_list(proof["subjects"], subjects, "proof.subjects")
    if _pin(proof["scope"], "proof.scope") != scope_pin:
        raise ValueError("Full proof does not bind exact scope")
    rows = proof["checks"]
    if type(rows) is not list or not 4 <= len(rows) <= 10000:
        raise ValueError("Full proof requires actual bounded named static checks")
    names = set()
    for row in rows:
        _closed(row, frozenset({"name", "passed"}), "proof.check")
        name = _text(row["name"], "proof.check.name")
        _exact(row["passed"], True, "proof.check.passed")
        if name in names:
            raise ValueError("Full proof repeats a named check")
        names.add(name)
    if not _REQUIRED_CHECKS <= names:
        raise ValueError("Full proof omits required scope/instruction/policy/bounds checks")
    coverage = proof["subject_reviews"]
    if type(coverage) is not list or len(coverage) != 3:
        raise ValueError("Full proof omits exact three whole-subject review rows")
    for row, pin, kind in zip(coverage, subjects, ("OWNER_SCOPE", "RETAINED_INSTRUCTION", "RETAINED_POLICY")):
        _closed(row, frozenset({"subject", "subject_kind", "whole_bytes_reviewed", "provenance_reviewed"}), "proof.subject_review")
        if _pin(row["subject"], "proof.subject_review.subject") != pin:
            raise ValueError("Full proof subject review is cross-scope or incomplete")
        _exact(row["subject_kind"], kind, "proof.subject_review.kind")
        _exact(row["whole_bytes_reviewed"], True, "proof.subject_review.whole_bytes_reviewed")
        _exact(row["provenance_reviewed"], True, "proof.subject_review.provenance_reviewed")
    proof_created = _ticks(proof["created_utc"], "proof.created_utc")
    adoption = read(adoption_pin, "Root Source adoption")
    _closed(adoption, _ADOPTION_KEYS, "Root Source adoption9")
    for key, required in {
        "schema_version": 2, "record_type": "Root_owner_v2_metadata_scope_Source_review_adoption",
        "author": "/root", "verdict": "ACCEPT_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY",
        "target_execution": False, "operational_authority": False,
    }.items():
        _exact(adoption[key], required, "adoption." + key)
    _subject_list(adoption["subjects"], subjects, "adoption.subjects")
    if _pin(adoption["different_review"], "adoption.different_review") != review_pin:
        raise ValueError("Root adoption does not bind the actual different review")
    adopted = _ticks(adoption["created_utc"], "adoption.created_utc")
    if not created <= proof_created <= reviewed <= adopted <= now:
        raise ValueError("Scope/full-proof/review/Root-adoption/current-clock chronology is invalid")
    return OwnerMetadataContext(
        root_thread, scope_pin, review_pin, adoption_pin, instruction_pin, policy_pin,
        proof_pin, scope["created_utc"], scope["interval_start"], scope["interval_end"],
        created, start, end, now,
    )
