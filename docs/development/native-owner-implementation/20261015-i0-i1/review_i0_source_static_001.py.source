def check(name, passed, evidence):
    rows.append({"name": name, "passed": bool(passed), "evidence": evidence})
    if not passed:
        raise ValueError(name)

def read(path, expected=None):
    raw = path.read_bytes()
    pin = {"path": str(path), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}
    inputs.append(pin)
    check("Whole bounded input " + path.name, 0 < len(raw) <= 2097152,
          "Actual reviewer read complete raw bytes; SHA256 above")
    if expected:
        check("Exact declared pin " + path.name, (len(raw), pin["sha256"]) == expected, pin)
    return raw

def unique(items):
    result = {}
    for k, v in items:
        if k in result:
            raise ValueError("Duplicate review input JSON key")
        result[k] = v
    return result

def reject(_):
    raise ValueError("Noninteger JSON number")

def doc(path, expected=None):
    raw = read(path, expected)
    return json.loads(raw.decode("utf-8"), object_pairs_hook=unique, parse_float=reject, parse_constant=reject)

