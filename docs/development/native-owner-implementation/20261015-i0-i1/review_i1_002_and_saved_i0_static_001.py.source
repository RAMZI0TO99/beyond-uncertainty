inputs, checks = [], []
def check(name, passed, evidence):
    checks.append({"name": name, "passed": bool(passed), "evidence": evidence})
def read(path, expected=None):
    raw = path.read_bytes()
    pin = {"path": str(path), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}
    inputs.append(pin)
    check("Complete bounded input " + path.name, 0 < len(raw) <= 2097152, pin)
    if expected:
        check("Exact declared input pin " + path.name, (len(raw), pin["sha256"]) == expected, pin)
    return raw
def unique(rows):
    obj = {}
    for k,v in rows:
        if k in obj:
            raise ValueError("Duplicate input JSON key")
        obj[k]=v
    return obj
def reject(_):
    raise ValueError("Noninteger JSON number")
def doc(path, expected=None):
    return json.loads(read(path, expected).decode("utf-8"), object_pairs_hook=unique, parse_float=reject, parse_constant=reject)
def fact(path):
    return next(p for p in inputs if p["path"] == str(path))
def source_funcs(raw):
    tree=ast.parse(raw)
    text=raw.decode("utf-8")
    return tree, {n.name: (ast.get_source_segment(text,n)+"\n").encode() for n in tree.body if isinstance(n,ast.FunctionDef)}

