"""UNRUN test Source: synthetic objects exist only in testcase memory.

These fictional Root declarations are not genuine grants, saved evidence or
authority JSON. Execute only after the actual I0 Source review/Root adoption.
No I1, project helper, filesystem reader, native call or Parser is imported.
"""

import copy
from dataclasses import FrozenInstanceError
import hashlib
import json
import unittest

from validate_current_owner_support_002 import OwnerMetadataContext, validate_current_owner_support


def _synthetic_case(edit=None, raw_edit=None):
    """Build one wholly fictional acyclic six-record graph in memory."""
    memory = {}
    thread = "SYNTHETIC_TEST_ROOT_THREAD_NOT_A_REAL_CHAT"
    editor = "/root/synthetic_source_editor"
    reviewer = "/root/synthetic_independent_reviewer"
    now = "2026-10-15T11:00:00.0000000Z"

    def store(stage, record):
        if edit is not None:
            edit(stage, record)
        raw = json.dumps(record, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("utf-8")
        if raw_edit is not None:
            raw = raw_edit(stage, raw)
        path = "D:\\SYNTHETIC_ONLY_NO_REAL_AUTHORITY\\i0\\" + stage + ".json"
        memory[path] = raw
        return {"path": path, "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}

    def witness(kind, text):
        return {
            "schema_version": 2, "record_type": "Root_retained_owner_" + kind + "_witness_v2",
            "author": "/root", "Root_thread": thread,
            "created_utc": "2026-10-15T09:59:00.0000000Z",
            "human_message_observed_utc": "2026-10-15T09:58:00.0000000Z",
            "human_message_reference": "FICTIONAL_TEST_MESSAGE_NEVER_AN_ACTUAL_RECEIPT",
            "exact_text": text, "attribution": "DIRECT_USER_MESSAGE_RETAINED_BY_ROOT",
        }

    instruction = store("instruction", witness("instruction", "SYNTHETIC TEST ONLY: metadata scope fixture."))
    policy = store("policy", witness("resource_policy", "SYNTHETIC TEST ONLY: pause/resource policy fixture."))
    scope = store("scope", {
        "schema_version": 2, "record_type": "Root_owner_v2_native_metadata_Source_preparation_scope",
        "author": "/root", "Root_thread": thread, "created_utc": "2026-10-15T10:00:00.0000000Z",
        "owner_instruction_record": instruction, "owner_policy_record": policy,
        "operation_scope": "EXACT8_NATIVE_SOURCE_METADATA_AND_SEPARATELY_ADMITTED_PARSER4_ONLY",
        "scope_stage": "SEPARATELY_GRANTED_METADATA_PREPARATION",
        "interval_start": "2026-10-15T10:00:00.0000000Z", "interval_end": "2026-10-15T12:00:00.0000000Z",
        "maximum_local_agents_including_Root": 3,
        "historical_shared_maximum_including_both_roots_and_overlap": 5,
        "reserved_overlap_slots": 2, "publication_reserve_seconds": 60,
        "lease_admission_reserve_seconds": 1200, "resource_age_seconds": 60,
        "minimum_available_RAM_bytes": 1073741824, "minimum_free_disk_bytes": 10737418240,
        "read_only_native_metadata_authority": True, "Parser_requires_separate_purpose_admission": True,
        "target_execution": False, "operational_authority": False, "scientific_authority": False,
        "Pro3_coordination_required": False, "whole_host_quiet": False, "old_leases_extended": False,
        "notify_owner_if_actual_resource_pause_needed": True,
    })
    subjects = [scope, instruction, policy]
    proof = store("proof", {
        "schema_version": 2, "record_type": "independent_Root_owner_v2_metadata_scope_full_Source_proof",
        "reviewer": reviewer, "source_author": "/root", "created_utc": "2026-10-15T10:01:00.0000000Z",
        "verdict": "PASS_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY", "subjects": copy.deepcopy(subjects),
        "scope": copy.deepcopy(scope),
        "checks": [{"name": n, "passed": True} for n in [
            "owner_scope_whole_bytes_and_closed28", "instruction_retained_witness_binding_and_provenance",
            "policy_retained_witness_binding_and_provenance", "scope_resource_time_and_authority_bounds",
        ]],
        "checks_failed": 0, "target_execution": False, "operational_authority": False,
        "native_Parser_executed": False,
        "subject_reviews": [{"subject": copy.deepcopy(pin), "subject_kind": kind,
                             "whole_bytes_reviewed": True, "provenance_reviewed": True}
                            for pin, kind in zip(subjects, ["OWNER_SCOPE", "RETAINED_INSTRUCTION", "RETAINED_POLICY"])],
        "owner_provenance_boundary": "ROOT_RETAINED_WITNESSES_REQUIRE_CALLER_PROVENANCE_VERIFICATION",
    })
    review = store("review", {
        "schema_version": 2, "record_type": "independent_Root_owner_v2_metadata_scope_Source_review",
        "reviewer": reviewer, "source_author": "/root", "created_utc": "2026-10-15T10:02:00.0000000Z",
        "verdict": "PASS_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY", "subjects": copy.deepcopy(subjects),
        "checks_failed": 0, "target_execution": False, "operational_authority": False,
        "native_Parser_executed": False, "full_proof": proof, "scope": copy.deepcopy(scope),
    })
    adoption = store("adoption", {
        "schema_version": 2, "record_type": "Root_owner_v2_metadata_scope_Source_review_adoption",
        "author": "/root", "created_utc": "2026-10-15T10:03:00.0000000Z",
        "verdict": "ACCEPT_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY", "subjects": copy.deepcopy(subjects),
        "different_review": review, "target_execution": False, "operational_authority": False,
    })
    return {
        "support": {"current_owner_scope": scope, "different_current_owner_scope_Source_review": review,
                    "current_owner_scope_Root_adoption": adoption},
        "memory": memory, "thread": thread, "editor": editor, "now": now,
    }


class PureOwnerValidatorTests(unittest.TestCase):
    def validate(self, case, **overrides):
        args = {"support": case["support"], "read_record": lambda pin: case["memory"][pin["path"]],
                "expected_root_thread": case["thread"], "source_editor": case["editor"], "now_utc": case["now"]}
        args.update(overrides)
        return validate_current_owner_support(**args)

    def reject_edit(self, stage, key, value):
        def edit(name, record):
            if name == stage:
                record[key] = copy.deepcopy(value)
        with self.assertRaises(ValueError):
            self.validate(_synthetic_case(edit))

    def test_valid_detached_metadata_context_has_no_escalation(self):
        case = _synthetic_case()
        before = copy.deepcopy(case["support"])
        context = self.validate(case)
        self.assertIsInstance(context, OwnerMetadataContext)
        self.assertEqual(context.root_thread, case["thread"])
        self.assertEqual(context.support_dict(), before)
        self.assertTrue(context.metadata_only)
        self.assertTrue(context.Parser_requires_separate_purpose_admission)
        self.assertFalse(context.operational_authority)
        self.assertFalse(context.scientific_authority)
        self.assertFalse(context.human_origin_authenticated_by_this_pure_validator)
        self.assertEqual(case["support"], before)
        detached = context.scope_pin.to_dict()
        detached["path"] = "detached mutation"
        self.assertEqual(context.support_dict(), before)
        with self.assertRaises(FrozenInstanceError):
            context.root_thread = "changed"

    def test_reads_and_hashes_actual_full_proof_not_only_capsule_name(self):
        case = _synthetic_case()
        seen = []
        def reader(pin):
            seen.append(pin["path"])
            raw = case["memory"][pin["path"]]
            pin.clear()
            return raw
        self.validate(case, read_record=reader)
        self.assertEqual(len(seen), 6)
        self.assertEqual(set(seen), set(case["memory"]))
        self.assertTrue(any(p.endswith("proof.json") for p in seen))

    def test_strict_support_and_fact3_types(self):
        for bad in [None, [], True, {"extra": []}, {1: []}]:
            with self.subTest(bad=repr(bad)), self.assertRaises(ValueError):
                self.validate(_synthetic_case(), support=bad)
        for key, value in [("bytes", True), ("bytes", 0), ("bytes", 2097153), ("path", []),
                           ("sha256", "A" * 64), ("sha256", {}), ("extra", 1)]:
            case = _synthetic_case()
            case["support"]["current_owner_scope"][key] = value
            with self.subTest(key=key, value=repr(value)), self.assertRaises(ValueError):
                self.validate(case)

    def test_unknown_missing_or_old_scope_records_refuse(self):
        self.reject_edit("scope", "extra", False)
        self.reject_edit("scope", "record_type", "Root_current_owner_I0_I1_Source_implementation_and_pure_predicate_qualification_scope")
        self.reject_edit("scope", "scope_stage", "STATIC_IMPLEMENTATION_ONLY")
        self.reject_edit("scope", "schema_version", 1)
        self.reject_edit("scope", "schema_version", True)
        def missing(stage, record):
            if stage == "scope":
                del record["owner_policy_record"]
        with self.assertRaises(ValueError):
            self.validate(_synthetic_case(missing))

    def test_original_fixed_bounds_and_boolean_types_remain_exact(self):
        mutations = {
            "maximum_local_agents_including_Root": True, "historical_shared_maximum_including_both_roots_and_overlap": 4,
            "reserved_overlap_slots": 1, "publication_reserve_seconds": 59, "lease_admission_reserve_seconds": 1199,
            "resource_age_seconds": 61, "minimum_available_RAM_bytes": 1073741823,
            "minimum_free_disk_bytes": 10737418239, "read_only_native_metadata_authority": False,
            "read_only_native_metadata_authority_OTHER": None, "Parser_requires_separate_purpose_admission": False,
            "target_execution": True, "operational_authority": True, "scientific_authority": True,
            "Pro3_coordination_required": True, "whole_host_quiet": True, "old_leases_extended": True,
            "notify_owner_if_actual_resource_pause_needed": False,
        }
        for key, value in mutations.items():
            with self.subTest(key=key):
                self.reject_edit("scope", key, value)

    def test_UTC6_UTC7_exact_tick_and_strict_Source60_boundary(self):
        case = _synthetic_case()
        a = self.validate(case, now_utc="2026-10-15T11:00:00.000000+00:00")
        b = self.validate(case, now_utc="2026-10-15T11:00:00.0000001Z")
        self.assertEqual(b.validated_now_ticks - a.validated_now_ticks, 1)
        self.validate(case, now_utc="2026-10-15T11:58:59.9999999Z")
        for now in ["2026-10-15T11:59:00.0000000Z", "2026-10-15T12:00:00.0000000Z",
                    "2026-10-15T09:59:59.9999999Z"]:
            with self.subTest(now=now), self.assertRaises(ValueError):
                self.validate(case, now_utc=now)

    def test_bad_UTC_types_precision_calendar_offsets_refuse(self):
        for now in [True, 1, [], "2026-10-15T11:00:00.00000Z", "2026-10-15T11:00:00.00000001Z",
                    "2026-10-15T11:00:00.000000+03:00", "2026-02-30T11:00:00.000000Z",
                    "2026-10-15T11:00:60.000000Z", "1600-10-15T11:00:00.000000Z"]:
            with self.subTest(now=repr(now)), self.assertRaises(ValueError):
                self.validate(_synthetic_case(), now_utc=now)

    def test_wrong_thread_and_editor_identity_refuse(self):
        for thread in ["OTHER_SYNTHETIC_ROOT", None, [], True]:
            with self.subTest(thread=repr(thread)), self.assertRaises(ValueError):
                self.validate(_synthetic_case(), expected_root_thread=thread)
        for editor in ["/root", "", [], "/root/editor/../other", "/root//editor"]:
            with self.subTest(editor=repr(editor)), self.assertRaises(ValueError):
                self.validate(_synthetic_case(), source_editor=editor)

    def test_reviewer_Root_and_actual_source_editor_subtree_refuse(self):
        for reviewer in ["/root", "/root/synthetic_source_editor", "/root/synthetic_source_editor/child"]:
            self.reject_edit("review", "reviewer", reviewer)
        self.validate(_synthetic_case())

    def test_retained_witness_thread_attribution_chronology_and_exact_text(self):
        self.reject_edit("instruction", "Root_thread", "OLD_REPLAY_THREAD")
        self.reject_edit("policy", "author", "/root/fabricated_peer")
        self.reject_edit("instruction", "attribution", "INFERRED_FROM_JSON")
        self.reject_edit("instruction", "human_message_observed_utc", "2026-10-15T10:00:00.000000Z")
        self.reject_edit("policy", "created_utc", "2026-10-15T10:01:00.000000Z")
        self.reject_edit("instruction", "exact_text", None)
        def multiline(stage, record):
            if stage == "instruction":
                record["exact_text"] = "SYNTHETIC exact line one\nSYNTHETIC exact line two"
        self.validate(_synthetic_case(multiline))

    def test_full_proof_required_fields_coverage_and_typed_zero(self):
        for key, value in [("schema_version", 1), ("checks_failed", False), ("checks_failed", 1),
                           ("native_Parser_executed", True), ("source_author", "/root/peer"),
                           ("subject_reviews", []), ("extra", 0)]:
            self.reject_edit("proof", key, value)
        for mutation in ["scope", "coverage", "check_false", "check_int", "check_duplicate", "check_missing"]:
            def edit(stage, record):
                if stage != "proof":
                    return
                if mutation == "scope":
                    record["scope"]["sha256"] = "0" * 64
                elif mutation == "coverage":
                    record["subject_reviews"][1]["whole_bytes_reviewed"] = False
                elif mutation == "check_false":
                    record["checks"][0]["passed"] = False
                elif mutation == "check_int":
                    record["checks"][0]["passed"] = 1
                elif mutation == "check_duplicate":
                    record["checks"].append(copy.deepcopy(record["checks"][0]))
                else:
                    record["checks"][0]["name"] = "unrelated_check"
            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
                self.validate(_synthetic_case(edit))

    def test_old_capsule_types_crossscope_subjects_and_bad_proof_pin_refuse(self):
        for key, value in [("record_type", "independent_Source024_review"), ("checks_failed", False),
                           ("native_Parser_executed", True), ("full_proof", []), ("extra", None)]:
            self.reject_edit("review", key, value)
        def crossscope(stage, record):
            if stage == "review":
                record["subjects"][0]["sha256"] = "0" * 64
        with self.assertRaises(ValueError):
            self.validate(_synthetic_case(crossscope))

    def test_actual_proof_bytes_must_match_whole_saved_pin(self):
        case = _synthetic_case()
        path = next(p for p in case["memory"] if p.endswith("proof.json"))
        case["memory"][path] += b" "
        with self.assertRaises(ValueError):
            self.validate(case)
        case = _synthetic_case()
        case["memory"][path] = case["memory"][path].replace(b"whole_bytes_reviewed", b"whole_bytes_revieweD", 1)
        with self.assertRaises(ValueError):
            self.validate(case)

    def test_duplicate_keys_floats_NaN_and_invalid_UTF8_refuse_even_with_correct_pin(self):
        for payload in [b'{"x":1,"x":2}', b'{"x":1.0}', b'{"x":NaN}', b'{"x":Infinity}', b'\xff', b'[]']:
            def raw_edit(stage, raw):
                return payload if stage == "scope" else raw
            with self.subTest(payload=payload), self.assertRaises(ValueError):
                self.validate(_synthetic_case(raw_edit=raw_edit))

    def test_scope_review_proof_adoption_chronology_is_bound(self):
        self.reject_edit("scope", "created_utc", "2026-10-15T10:02:30.000000Z")
        self.reject_edit("proof", "created_utc", "2026-10-15T10:02:30.000000Z")
        self.reject_edit("review", "created_utc", "2026-10-15T10:03:30.000000Z")
        self.reject_edit("adoption", "created_utc", "2026-10-15T11:00:00.0000001Z")
        self.reject_edit("adoption", "author", "/root/notRoot")
        self.reject_edit("adoption", "operational_authority", True)

    def test_replayed_same_path_or_different_review_adoption_refuse(self):
        case = _synthetic_case()
        case["support"]["current_owner_scope_Root_adoption"] = copy.deepcopy(case["support"]["current_owner_scope"])
        with self.assertRaises(ValueError):
            self.validate(case)
        def replay(stage, record):
            if stage == "adoption":
                record["different_review"]["sha256"] = "0" * 64
        with self.assertRaises(ValueError):
            self.validate(_synthetic_case(replay))

    def test_reader_errors_wrong_return_types_and_no_callback_refuse_as_ValueError(self):
        for reader in [None, lambda pin: True, lambda pin: bytearray(b"{}"), lambda pin: b"{}"]:
            with self.subTest(reader=repr(reader)), self.assertRaises(ValueError):
                self.validate(_synthetic_case(), read_record=reader)
        def refused(pin):
            raise TypeError("SYNTHETIC callback refusal")
        with self.assertRaises(ValueError):
            self.validate(_synthetic_case(), read_record=refused)


if __name__ == "__main__":
    unittest.main()
