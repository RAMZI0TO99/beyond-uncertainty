doc_paths=['HANDOFF.md','CONTINUE.md','AGENTS.md','README.md','PROJECT_STATE.md','docs/PROJECT_GAPS.md','docs/where are we/01-project-status.md','docs/where are we/02-progress-and-lessons.md']
preservation=[]
for rel in doc_paths:
    old=read(REPO/rel)
    relative=os.path.relpath(REPO/BASE/'CURRENT_CHECKPOINT.md',(REPO/rel).parent).replace('\\','/')
    prefix=f'''**Current documentation and handoff - October 28, 2026.** Read the [current checkpoint]({relative}) before the complete dated history below. I11 has664 and I12 has1,089 accepted synthetic metadata cases; the I13 group has32 complete (20 PASS/12 E_NODE_BUDGET), with904 unestablished and11 compact-ABI blockers. Retention exporter/API/supervisor and capture protocol/request have Source/design acceptance only; capture remains held.

Bootstrap004 is **FAILED_UNRELEASED_CONSUMED**. Its saved failure evidence is accepted; the operation and native preparation request are not. Source005 completion is peer-reported, not Root-qualified or launch-ready; Source015 was never adopted. Next: fresh Source-only review scope, reviewed metadata-reader correction, Source005 review and a process-custody/cleanup contract before any distinct successor or later exact admission. Never replay004. All capture, actual-family, Native8, Parser, runtime and science gates remain held. This documentation/Git publication does not create STEP081 or renew any expired scope. All complete earlier bytes follow unchanged.

---

'''.encode()
    if rel=='HANDOFF.md':
        prefix += f'''The working evidence root is `D:\\Aenv\\pro2`; the managed checkout is `D:\\Aenv\\pro2\\github-portable-20261012-001`. The portable [current navigator](CONTINUE_CURRENT_20261028.json) and [evidence index]({BASE}/evidence-index.json) supersede the dated next-step text below. Preserve historical embedded paths and resolve them through the indexes. The ignored `.continuation/` workspace is local; a clone receives indexed evidence copies, not local runtime bindings. Git history records the actual publication commit. No new project target/test/native/capture/science execution was performed for this checkpoint.

---

'''.encode()
    new=prefix+old
    write(CAND/rel,new)
    preservation.append({'path':rel,'before':pin(old),'prefix_bytes':len(prefix),'after':pin(new),'old_bytes_preserved_as_complete_suffix':True})
overlay=json.loads(read(REPO/'continuation/canonical-source-overlays.json'))
row=overlay['overlays'][0]
oldstate=read(REPO/'PROJECT_STATE.md');newstate=read(CAND/'PROJECT_STATE.md')
assert pin(oldstate[row['prefix_bytes']:])=={'bytes':row['frozen_bytes'],'sha256':row['frozen_sha256']}
row['prefix_bytes']+=len(newstate)-len(oldstate)
row['current_bytes']=len(newstate);row['current_sha256']=pin(newstate)['sha256']
assert pin(newstate[row['prefix_bytes']:])=={'bytes':row['frozen_bytes'],'sha256':row['frozen_sha256']}
write(CAND/'continuation/canonical-source-overlays.json',js(overlay))
write(CAND/BASE/'publication-scope.json',js(scope))
write(CAND/BASE/'document-preservation.json',js({'files':preservation,'frozen_PROJECT_STATE_suffix_unchanged':True,'new_STEP081':False}))
write(CAND/BASE/'prepare_checkpoint.py.source',read(Path(__file__)))
files=[{'path':str(p.relative_to(CAND)).replace('\\','/'),**pin(read(p))} for p in sorted(CAND.rglob('*')) if p.is_file()]
write(OUT/'CANDIDATE.json',js({'record_type':'reviewable_documentation_candidate','files':files,'source_evidence_records':len(rows),'source_logical_bytes':sum(x['bytes'] for x in rows),'prior_changes':409,'subject_execution':False}))
print(json.dumps({'candidate_files':len(files),'source_evidence_records':len(rows),'logical_bytes':sum(x['bytes'] for x in rows),'end_utc':scope['end_utc']}))
