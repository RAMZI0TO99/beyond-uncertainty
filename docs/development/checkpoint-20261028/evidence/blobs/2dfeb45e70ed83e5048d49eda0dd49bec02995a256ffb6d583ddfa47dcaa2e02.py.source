"""Prepare a pin-only Root control author for the separately reviewed corrective Source set."""
import ast,base64,hashlib,json,re
from pathlib import Path
R=Path(__file__).parent;p=R/'author_I13_compact_SourceSet4_Root_controls_002.py';raw=p.read_bytes();assert hashlib.sha256(raw).hexdigest()=='abb5026c934ba1997df2aabd4b1aedbbcbdf9a4f174d72e8c0546103a7ea4071';s=raw.decode('utf8')
mapping={
 'current_owner_M3_peer_held_composition_004.py':'current_owner_M3_peer_held_composition_005.py',
 'current_owner_M3_peer_held_composition_005.py':'current_owner_M3_peer_held_composition_006.py',
 'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json':'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_005.json',
 'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_005.json':'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_006.json',
 'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_004.json':'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_005.json',
 'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_005.json':'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_006.json',
 'ROOT_I13_ONCE_MEMORY_SUPERVISOR_009.py':'ROOT_I13_ONCE_MEMORY_SUPERVISOR_010.py',
 'ROOT_I13_ONCE_MEMORY_SUPERVISOR_010.py':'ROOT_I13_ONCE_MEMORY_SUPERVISOR_011.py',
 'ROOT_I13_SOURCESET4_ROOT_COMPOSITION005_PLAN005_SUPERVISOR010_SOURCE_AUTHOR_RECEIPT_001.json':'ROOT_I13_SOURCESET5_ROOT_COMPOSITION006_PLAN006_SUPERVISOR011_SOURCE_AUTHOR_RECEIPT_001.json',
}
for a in mapping:assert a in s,a
s=re.sub('|'.join(re.escape(k)for k in sorted(mapping,key=len,reverse=True)),lambda m:mapping[m.group()],s)
s=s.replace('SourceSet4','SourceSet5').replace('SourceSet4','SourceSet5').replace('Root_I13_compact_SourceSet4','Root_I13_corrective_SourceSet5').replace('schema_version=5,compact_descriptor_protocol_adoption','schema_version=6,compact_descriptor_protocol_adoption').replace('schema_version=3,current_kernel_and_API_inputs','schema_version=4,current_kernel_and_API_inputs')
ast.parse(s);new=s.encode('utf8');q=R/'author_I13_corrective_SourceSet5_Root_controls_001.py'
with q.open('xb')as h:h.write(new)
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,record_type='Root_I13_corrective_SourceSet5_Root_control_author_Source_receipt',author='/root',predecessor=pin(p,raw),successor=pin(q,new),complete_predecessor_bytes_base64=base64.b64encode(raw).decode('ascii'),change='Use immediate inert Rootcontrols005/Plan005/Sup010 as exact predecessors and allocate unused composition006/API006/Plan006/Sup011. Same fixed domains, preflight eleven frozen assets, whole predecessor buffers/inverses, unchanged function ASTs, original936 names, all caps and holds. No author invoked.',successor_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
o=R/'ROOT_I13_SOURCESET5_ROOT_CONTROL_AUTHOR_SOURCE_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii')
with o.open('xb')as h:h.write(b)
print(json.dumps(dict(Source=pin(q,new),receipt=pin(o,b),author_invoked=False)))
