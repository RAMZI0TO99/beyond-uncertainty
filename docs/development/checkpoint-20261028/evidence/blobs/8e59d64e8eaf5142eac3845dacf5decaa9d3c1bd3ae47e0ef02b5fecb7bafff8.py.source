def deltas(a,b,path=''):
 if type(a)is not type(b):return[dict(change='replaced',path=path)]
 if type(a)is dict:
  out=[]
  for name in sorted(set(a)|set(b)):
   p=path+'/'+name
   if name not in a:out.append(dict(change='added',path=p))
   elif name not in b:out.append(dict(change='removed',path=p))
   else:out.extend(deltas(a[name],b[name],p))
  return out
 if type(a)is list:
  out=[]
  for i in range(max(len(a),len(b))):
   p=path+'/'+str(i)
   if i>=len(a):out.append(dict(change='added',path=p))
   elif i>=len(b):out.append(dict(change='removed',path=p))
   else:out.extend(deltas(a[i],b[i],p))
  return out
 return[]if a==b else[dict(change='replaced',path=path)]
