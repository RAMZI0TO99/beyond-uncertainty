def need(v,m):
    if not v:raise ValueError(m)
def ck(name,passed,evidence=None):
    need(type(passed) is bool,'Boolean check');checks.append(dict(name=name,passed=passed,evidence=evidence))
def raw(p):
    p=Path(p)
    for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'nonreparse lineage')
    a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded regular singlelink')
    with p.open('rb') as h:
        b=os.fstat(h.fileno());data=h.read(2097153);c=os.fstat(h.fileno())
    d=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
    need(k(a)==k(b)==k(c)==k(d) and len(data)==a.st_size,'stable samebuffer');return data
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def get(p,n=None,sha=None):
    p=Path(p);b=raw(p);fp=fact(p,b);need(n is None or n==fp['bytes'],'announced bytes');need(sha is None or sha==fp['sha256'],'announced SHA');buffers[str(p)]=b;return b,fp
def pairs(xs):
    v={}
    for k,x in xs:need(k not in v,'duplicate JSON key');v[k]=x
    return v
def bad(x):raise ValueError('float/nonfinite JSON')
def shape(v):
    todo=[(v,0)];nodes=depth=0
    while todo:
        x,d=todo.pop();nodes+=1;depth=max(depth,d);need(nodes<=50000 and d<=48,'fullkey nodes/depth');need(x is None or type(x) in (str,int,bool,dict,list),'builtin JSON')
        if type(x) is str:need(not any(55296<=ord(c)<=57343 for c in x),'surrogates')
        elif type(x) is list:todo.extend((e,d+1) for e in x)
        elif type(x) is dict:
            for k,e in x.items():need(type(k) is str,'string key');todo.extend(((k,d+1),(e,d+1)))
    return dict(nodes_including_keys=nodes,maximum_depth=depth)
def doc(p,n=None,sha=None):
    b,fp=get(p,n,sha);v=json.loads(b.decode('utf-8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad);shape(v);return v,fp

