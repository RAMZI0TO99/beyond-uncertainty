FIXED = {'exporter_Source': {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261027-002\\retention_exporter_001\\exercise_M3_guard_and_publisher_metadata_memory_016.py', 'bytes': 598122, 'sha256': 'd4ab7104da4f9bcfb473742d47a6f0eae0279cd3c046d2946ff13246e67310d7'}, 'Source_inputs': {'catalogue': {'bytes': 139618, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\m3_protocol_audit_001\\I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_008.json', 'sha256': 'c02cd1387cb66bbb50c4f11996a3bb72acc90f6ea35caf09e830a93b60d70cbe'}, 'fixture_basis': {'bytes': 537177, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\exercise_M3_guard_and_publisher_metadata_memory_014.py', 'sha256': '0fc108b3c357d8d75b94c03948292e6cdc38711cbab253667448b859d58100aa'}, 'm3_API': {'bytes': 3020, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_011.json', 'sha256': '6dcd9a8b90f9842e336c7de631b1ae2c546ac63152daf38fd45e42df2a986809'}, 'm3_Source': {'bytes': 64586, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_M3_guard_contract_metadata_011.py', 'sha256': 'bc86c0885d0dbee71c2cd4832831ce338a4910fd29922a44f25390d1fb881692'}, 'peer_API': {'bytes': 1748, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_011.json', 'sha256': '8f93bb19a32d613e933c1594f2823380e8fbd02d2ee9e241183703710fe32a0a'}, 'peer_Source': {'bytes': 63531, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_selected_peer_author_packet_metadata_011.py', 'sha256': 'e51ea4010c297689df737ab2f4cbdcb063999975294f73cc78a5bd525c9e11c3'}, 'protocol': {'bytes': 67530, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\m3_protocol_audit_001\\input_node_readset_ledger_protocol_proposal_001\\I13_PROPOSED_FIXED_M3_INPUT_NODE_AND_SOURCE_READSET_LEDGER_PROTOCOL_002.json', 'sha256': '3f5956127c9a6e56dfced9209fbf6f28c013526147a2191f4904429c85c2f898'}, 'publisher_API': {'bytes': 4291, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_006.json', 'sha256': 'd7031a4a5a9ea417a92ce5899923f3172508ee31bcb007147479dab8cd4dd65f'}, 'publisher_Source': {'bytes': 65474, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_selected_role_publisher_metadata_006.py', 'sha256': '7be450cf7233642a9f508f18e168e4262044c763e7b91ffa257ccf6933d948dd'}}, 'selection_plan': {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261027-001\\retention_selection_plan_001\\ROOT_I13_RAW_RETENTION_SIX_GRAPH_WHOLE_RECORD_SELECTION_PLAN_001.json', 'bytes': 452561, 'sha256': '97fdb498e51580f3eb8bc30ad291d72d5b67fb254f3840128f0ee19e9dbd91e5'}, 'errors': ['E_RETENTION_SELECTION_PIN', 'E_RETENTION_SELECTION_SCHEMA', 'E_RETENTION_SOURCE_BINDING', 'E_RETENTION_CAPTURE_ID', 'E_RETENTION_PARTITION', 'E_RETENTION_GRAPH_NAMESPACE', 'E_RETENTION_RECORD', 'E_RETENTION_ROSTER', 'E_RETENTION_DIGEST', 'E_RETENTION_MEMBER_TOO_LARGE', 'E_RETENTION_RAW_CAP', 'E_RETENTION_OUTPUT_CAP', 'E_RETENTION_JSON', 'E_RETENTION_BASE64', 'E_RETENTION_GLOBAL_SEAL', 'E_RETENTION_UNMODELED_BUILD', 'E_RETENTION_CONSUMED', 'E_RETENTION_AUTHORITY', 'E_RETENTION_CUSTODY', 'E_RETENTION_INCOMPLETE']}
CAP = 2097152


class HeldRetentionChildError(ValueError):
    def __init__(self,code):
        self.code=code if type(code) is str and code in FIXED['errors'] else 'E_RETENTION_CUSTODY'
        super().__init__(self.code)


def _activation_required():
    raise HeldRetentionChildError('E_RETENTION_AUTHORITY')


def main():
    raise HeldRetentionChildError('E_RETENTION_AUTHORITY')


def _need(ok, code='E_RETENTION_SOURCE_BINDING'):
    if not ok:
        raise HeldRetentionChildError(code)


def _wire(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,
                       allow_nan=False)+'\n').encode('utf8')


def _nodes(value,depth=0):
    _need(depth<=48,'E_RETENTION_JSON')
    if type(value) is dict:
        _need(all(type(k) is str for k in value),'E_RETENTION_JSON')
        n=1+len(value)
        for k,v in value.items():
            k.encode('utf8','strict');n+=_nodes(v,depth+1)
            _need(n<=50000,'E_RETENTION_JSON')
        return n
    if type(value) is list:
        n=1
        for v in value:
            n+=_nodes(v,depth+1);_need(n<=50000,'E_RETENTION_JSON')
        return n
    _need(type(value) in (str,int,bool,type(None)),'E_RETENTION_JSON')
    if type(value) is str:value.encode('utf8','strict')
    return 1


def _decode(raw):
    _need(type(raw) is bytes and 0<len(raw)<=CAP,'E_RETENTION_JSON')
    def pairs(rows):
        d={}
        for k,v in rows:_need(k not in d,'E_RETENTION_JSON');d[k]=v
        return d
    def bad(v):raise HeldRetentionChildError('E_RETENTION_JSON')
    try:
        value=json.loads(raw.decode('utf8','strict'),object_pairs_hook=pairs,
                         parse_float=bad,parse_constant=bad)
        _nodes(value);_need(_wire(value)==raw,'E_RETENTION_JSON')
        return value
    except HeldRetentionChildError:
        raise
    except (ValueError,UnicodeError,RecursionError):
        raise HeldRetentionChildError('E_RETENTION_JSON') from None


def _bytes(text,pin):
    _need(type(text) is str and len(text)==4*((pin['bytes']+2)//3),'E_RETENTION_BASE64')
    raw=base64.b64decode(text.encode('ascii','strict'),validate=True)
    _need(base64.b64encode(raw).decode('ascii')==text and len(raw)==pin['bytes'] and
          hashlib.sha256(raw).hexdigest()==pin['sha256'],'E_RETENTION_DIGEST')
    return raw


def _read_input(path,sha):
    _activation_required()
    _need(type(path) is str and type(sha) is str and re.fullmatch('[0-9a-f]{64}',sha))
    p=Path(path);root=Path(r'D:\Aenv\pro2\WORK\resume-20261027-002\owned_raw_retention_runs')
    _need(p.is_absolute() and p.is_relative_to(root) and '..' not in p.parts)
    for q in (p,*p.parents):
        s=q.lstat();_need(not q.is_symlink() and not getattr(s,'st_file_attributes',0)&1024)
    before=p.stat();_need(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and before.st_size<=CAP)
    with p.open('rb') as h:
        fd0=os.fstat(h.fileno());raw=h.read(CAP+1);fd1=os.fstat(h.fileno())
    after=p.stat();key=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns)
    _need(key(before)==key(fd0)==key(fd1)==key(after) and len(raw)==before.st_size and
          hashlib.sha256(raw).hexdigest()==sha)
    return raw


def _execute_packed(raw):
    _activation_required()
    value=_decode(raw)
    keys={'schema_version','fixture','fixture_pin','Source_inputs','sources','catalogue',
          'selection','capture_id','partition_id'}
    _need(type(value) is dict and set(value)==keys and type(value['schema_version']) is int and
          value['schema_version']==1 and value['fixture_pin']==FIXED['exporter_Source'] and
          value['Source_inputs']==FIXED['Source_inputs'])
    source_bytes=_bytes(value['fixture'],FIXED['exporter_Source'])
    selection=_bytes(value['selection'],FIXED['selection_plan'])
    catalogue=_bytes(value['catalogue'],FIXED['Source_inputs']['catalogue'])
    names={k for k in FIXED['Source_inputs'] if k.endswith('_Source') or k.endswith('_API')}
    _need(type(value['sources']) is dict and set(value['sources'])==names)
    carriers={}
    for name in ('m3','publisher','peer'):
        carrier=types.ModuleType('_i13_retention_data_'+name)
        for suffix,prefix in (('Source','__source'),('API','__API')):
            pin=FIXED['Source_inputs'][name+'_'+suffix]
            carrier.__dict__[prefix+'_pin__']=dict(pin)
            carrier.__dict__[prefix+'_bytes__']=_bytes(value['sources'][name+'_'+suffix],pin)
        carriers[name]=carrier
    fixture=types.ModuleType('_i13_raw_retention_fixture')
    fixture.__file__=FIXED['exporter_Source']['path']
    # The sole compiled subject is the new complete data-only fixture. Old M3,
    # peer and publisher kernel bytes are carrier data and NEVER compiled.
    exec(compile(source_bytes,FIXED['exporter_Source']['path'],'exec'),fixture.__dict__)
    entry=fixture.__dict__.get('retain_I13_M3_input_record_partition')
    _need(type(entry) is types.FunctionType)
    result=entry(m3=carriers['m3'],publisher=carriers['publisher'],peer=carriers['peer'],
        catalogue_bytes=catalogue,selection_bytes=selection,
        partition_id=value['partition_id'],capture_id=value['capture_id'])
    _need(type(result) is bytes and 0<len(result)<=CAP,'E_RETENTION_OUTPUT_CAP')
    return result


def _dormant_main():
    _activation_required()
    try:
        _need(len(sys.argv)==3)
        result=_execute_packed(_read_input(sys.argv[1],sys.argv[2]))
        _need(sys.stdout.buffer.write(result)==len(result),'E_RETENTION_CUSTODY')
        sys.stdout.buffer.flush()
    except BaseException as exc:
        code=getattr(exc,'code','E_RETENTION_CUSTODY')
        if type(code) is not str or code not in FIXED['errors']:
            code='E_RETENTION_CUSTODY'
        message=_wire(dict(error_code=code,exception_type=type(exc).__name__[:128]))
        _need(len(message)<=512,'E_RETENTION_OUTPUT_CAP')
        sys.stderr.buffer.write(message);sys.stderr.buffer.flush()
        raise SystemExit(1) from None


if __name__=='__main__':
    main()
