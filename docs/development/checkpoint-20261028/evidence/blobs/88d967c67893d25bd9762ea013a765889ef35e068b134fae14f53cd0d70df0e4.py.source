"""Create bounded inert metadata Source bundles after exact Root Source adoption.

Actual Source editor of successor: /root. Ordinary IO guard functions carried unchanged from /root/project_architecture. No member is imported, parsed,
compiled, called, restored or deleted. Complete historical bytes remain opaque.
Partial outputs remain on refusal; this helper never rolls back or overwrites.
"""
import base64
import datetime as dt
import hashlib
import json
import os
import re
from pathlib import Path
import sys

ROOT=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
SUBJECTS=ROOT/'m3_peer_contracts_016'
PUB=ROOT/'publication_001'
OUT=ROOT
INDEX=OUT/'I13_OWNED_RUN_METADATA_BUNDLE_INDEX_001.json'
CAP=2097152
SCOPE={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json', 'bytes': 8839, 'sha256': '726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'}
SCOPE_ADOPTION={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_I13_CURRENT_SOURCE_SCOPE003_DIFFERENT_REVIEW_ADOPTION_001.json', 'bytes': 1418, 'sha256': '120196cc8a9fdbe03411cbde669a7bd94e681bc1cd155a3bc71d8d5a90618571'}

def need(value,why):
    if not value:raise ValueError(why)

def wire(value):
    return(json.dumps(value,sort_keys=True,ensure_ascii=True,separators=(',',':'),allow_nan=False)+'\n').encode('ascii')

def pairs(items):
    value={}
    for key,child in items:
        need(key not in value,'duplicate metadata key')
        value[key]=child
    return value

def bad(value):raise ValueError('float or nonfinite metadata number')

def decode(raw):
    need(type(raw)is bytes and len(raw)<=CAP,'bounded builtin metadata bytes')
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def body(path):
    need(path.is_absolute(),'absolute metadata path')
    for p in(path,*path.parents):
        q=p.lstat()
        need(not p.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
    before=path.stat()
    need(path.is_file()and before.st_nlink==1 and 0<=before.st_size<=CAP,'bounded ordinary Source/data')
    with path.open('rb')as f:
        raw=f.read(CAP+1);f.seek(0);again=f.read(CAP+1)
    after=path.stat()
    need(raw==again and len(raw)==before.st_size==after.st_size and all(getattr(before,k,None)==getattr(after,k,None)for k in('st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes')),'stable whole bytes')
    return raw

def pin(path,raw=None):
    if raw is None:raw=body(path)
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def fact(value):
    need(type(value)is dict and set(value)=={'path','bytes','sha256'}and all(type(k)is str for k in value),'closed fact3')
    need(type(value['path'])is str and type(value['bytes'])is int and 0<=value['bytes']<=CAP and type(value['sha256'])is str and len(value['sha256'])==64 and all(c in'0123456789abcdef'for c in value['sha256']),'typed bounded fact3')
    need(Path(value['path']).is_absolute()and not any(ord(c)<32 for c in value['path']),'absolute ordinary path string')
    return value

def exact(subject):
    fact(subject);path=Path(subject['path']);raw=body(path)
    need(pin(path,raw)==subject,'exact pinned whole bytes')
    return raw

def occurs(value,subject):
    if type(value)is dict:
        if set(value)=={'path','bytes','sha256'}and wire(value)==wire(subject):return True
        return any(occurs(child,subject)for child in value.values())
    return type(value)is list and any(occurs(child,subject)for child in value)

def adoption(value,subject):
    need(type(value)is dict and value.get('author')=='/root'and type(value.get('verdict'))is str and value['verdict'].startswith('ACCEPT_')and value.get('target_execution')is False and value.get('operational_authority')is False and value.get('scientific_authority')is False and occurs(value,subject),'exact Root Source adoption')

def fresh():
    raw=exact(SCOPE);scope=decode(raw);adopted=decode(exact(SCOPE_ADOPTION));adoption(adopted,SCOPE)
    now=dt.datetime.now(dt.timezone.utc)
    need(scope['author']=='/root'and scope['target_execution']is False and scope['operational_authority']is False and scope['new_operational_execution_lease_issued']is False,'Source-only scheduling')
    need(dt.datetime.fromisoformat(scope['interval_start'])<=now and(dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60,'strict original60 Source reserve')
    return pin(Path(SCOPE['path']),raw)

def save(path,raw):
    need(path.is_relative_to(OUT)and type(raw)is bytes and len(raw)<=CAP and not os.path.lexists(path),'fresh contained bounded metadata output')
    for parent in path.parents:
        if os.path.lexists(parent):
            q=parent.lstat();need(parent.is_dir()and not parent.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary existing parent')
    fresh();path.parent.mkdir(parents=True,exist_ok=True)
    for parent in path.parents:
        q=parent.lstat();need(parent.is_dir()and not parent.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary output lineage')
    need(not os.path.lexists(path),'still absent output')
    fresh()
    with path.open('xb')as f:
        need(f.write(raw)==len(raw),'complete metadata write');f.flush();os.fsync(f.fileno())
    need(body(path)==raw,'whole output readback')
    return pin(path,raw)


def eligible(path):
    need(path.is_absolute() and '..' not in path.parts and path.resolve()==path, 'canonical original metadata path')
    if path.parent==SUBJECTS:
        return bool(re.fullmatch(r'ROOT_I13_(?:ONCE_SYNTHETIC_MEMORY_SCOPE_\d{3}|FRESH_ONCE_PRELAUNCH_METADATA_\d{3}|ONCE\d{3}_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001)\.json',path.name))
    return path.parent.parent==SUBJECTS/'owned_memory_runs' and bool(re.fullmatch(r'attempt\d{3}',path.parent.name)) and path.name in {
        'SCOPE_CLAIM_001.json','CHILD_ENTRY_001.json','CHILD_RESULT_001.json','CHILD_STDOUT_001.txt','CHILD_STDERR_001.txt','SUPERVISOR_RESULT_001.json','PARENT_TOOL_STDOUT_RETAINED_001.txt','ROOT_ACTUAL_PARENT_EXEC_TOOL_RETURN_001.json'}


def select(ordinal):
    need(type(ordinal)is str and re.fullmatch(r'\d{3}',ordinal),'exact new selection ordinal')
    scope=fresh();scopes=sorted(SUBJECTS.glob('ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_*.json'))
    need(bool(scopes),'nonempty consumed-scope inventory');runs=[];missing=[];allowed={};retained={};names=('claim','child_entry','child_result','stdout','stderr','supervisor_result')
    leaves=('SCOPE_CLAIM_001.json','CHILD_ENTRY_001.json','CHILD_RESULT_001.json','CHILD_STDOUT_001.txt','CHILD_STDERR_001.txt','SUPERVISOR_RESULT_001.json')
    for path in scopes:
        need(re.fullmatch(r'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_\d{3}\.json',path.name),'canonical scope ordinal')
        number=int(path.stem.rsplit('_',1)[1]);raw=body(path);sc=decode(raw);sp=pin(path,raw)
        need(sc['author']=='/root'and sc['record_type']=='Root_I13_once_owned_synthetic_memory_scope'and type(sc['maximum_suite_invocations'])is int and sc['maximum_suite_invocations']==1,'recorded one-use own synthetic scope')
        need(all(sc[k]is False for k in('target_execution','operational_authority','scientific_authority','actual_family_publication')),'held recorded authorities')
        owned=SUBJECTS/('owned_memory_runs/attempt%03d'%number);expected={key:str(owned/leaf)for key,leaf in zip(names,leaves)}
        need(type(sc['outputs'])is dict and sc['outputs']==expected,'exact consumed ordinal and six output namespace')
        cp=owned/leaves[0];cr=body(cp);claim=decode(cr);claim_pin=pin(cp,cr)
        need(claim['record_type']=='I13_once_scope_claim'and claim['scope']==sp and claim['supervisor']==sc['supervisor']and type(claim['suite_invocations_maximum'])is int and claim['suite_invocations_maximum']==1 and type(claim['parent_pid'])is int and claim['parent_pid']>0,'exact claimed scope/supervisor identity')
        rp=owned/leaves[-1];rr=body(rp);result=decode(rr);result_pin=pin(rp,rr)
        need(result['scope']==sp and result['claim']==claim_pin and result['reaped']is True and result['streams_drained']is True and result['custody_error']is None,'same claimed result closed custody')
        eof=result['actual_stream_EOF'];errors=result['stream_pump_errors']
        need(type(eof)is dict and set(eof)=={'stdout','stderr'}and all(type(v)is bool and v is True for v in eof.values()),'both exact literal EOF truths')
        need(type(errors)is dict and set(errors)=={'stdout','stderr'}and all(v is None for v in errors.values()),'both stream errors absent')
        need(all(result[k]is False for k in('target_execution','operational_authority','scientific_authority','actual_family_publication')),'no result authority inference')
        pre=SUBJECTS/('ROOT_I13_FRESH_ONCE_PRELAUNCH_METADATA_%03d.json'%number);pre_raw=body(pre);need(pin(pre,pre_raw)==sc['prelaunch'],'exact consumed prelaunch identity')
        witness=SUBJECTS/('ROOT_I13_ONCE%03d_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json'%number);wraw=body(witness);w=decode(wraw)
        need(w['scope']==sp and w['supervisor_result']==result_pin and w['supervisor']==sc['supervisor'],'exact retained parent witness joins')
        expected_present=[path,pre,witness]
        validated={str(p).casefold():b for p,b in ((path,raw),(cp,cr),(rp,rr),(pre,pre_raw),(witness,wraw))}
        for key,text in expected.items():
            p=Path(text)
            if os.path.lexists(p):
                key=str(p).casefold()
                if key not in validated:validated[key]=body(p)
                else:need(body(p)==validated[key],'validated output bytes remain exact')
                expected_present.append(p)
            else:
                need(key=='child_result'and result['child_result_absent']is True,'only honestly absent child result remains missing')
                missing.append(dict(scope=sp,not_created_output=key,path=text))
        need(type(result['child_result_absent'])is bool and result['child_result_absent']is(not os.path.lexists(owned/'CHILD_RESULT_001.json')),'actual child-result presence agrees')
        for leaf in('PARENT_TOOL_STDOUT_RETAINED_001.txt','ROOT_ACTUAL_PARENT_EXEC_TOOL_RETURN_001.json'):
            p=owned/leaf
            if os.path.lexists(p):validated[str(p).casefold()]=body(p);expected_present.append(p)
        need(any(p.name=='PARENT_TOOL_STDOUT_RETAINED_001.txt'for p in expected_present),'actual retained parent console')
        for p in expected_present:
            need(eligible(p),'fixed allowed metadata domain');key=str(p).casefold();need(key not in allowed,'each exact original once');allowed[key]=p;retained[key]=validated[key]
        runs.append(dict(consumed_scope=sp,supervisor_result=result_pin,claim=claim_pin,recorded_refusal=result['refusal'],recorded_child_result_absent=result['child_result_absent'],root_result_qualification_inferred=False))
    actual=[]
    for p in SUBJECTS.rglob('*'):
        if eligible(p)and os.path.lexists(p):body(p);actual.append(p)
    need({str(p).casefold()for p in actual}==set(allowed),'all eligible physical files belong to exact consumed closures; no orphans')
    for key,p in allowed.items():need(body(p)==retained[key],'all selected members retain the exact validated buffers')
    members=[pin(allowed[key],retained[key])for key in sorted(allowed)]
    need(1<=len(members)<=512 and sum(p['bytes']for p in members)<=67108864,'unchanged original per-file/count/payload bounds')
    value=dict(schema_version=1,record_type='Root_I13_exact_consumed_owned_run_metadata_bundle_selection',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),Source_scope=scope,Source_scope_Root_adoption=SCOPE_ADOPTION,members=members,member_count=len(members),original_member_bytes=sum(p['bytes']for p in members),consumed_runs=runs,absent_outputs_remain_absent=missing,maximum_metadata_file_bytes=CAP,maximum_actual_copy_rows=512,maximum_actual_copy_payload_bytes=67108864,selection='Exact same-buffer consumed scope/claim/prelaunch/result/witness and original output closure; every eligible physical file must match a consumed ordinal. Missing child results stay absent. No case or physical-host acceptance.',encoding='Whole opaque canonical Base64 only after separate exact selection review/Root adoption and helper Source review/Root adoption; actual reconstruction/candidate/creation independently reviewed separately.',original_files_modified=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
    for key,p in allowed.items():need(body(p)==retained[key],'final selected member reread equals its validated original')
    out=ROOT/('I13_EXACT_OWNED_RUN_METADATA_BUNDLE_PLAN_'+ordinal+'.json');result=save(out,wire(value));fresh()
    print(json.dumps(dict(plan=result,members=len(members),consumed_scopes=len(scopes),bundles_created=False)))

if __name__=='__main__':
    need(len(sys.argv)==2,'one exact fresh selection ordinal');select(sys.argv[1])
