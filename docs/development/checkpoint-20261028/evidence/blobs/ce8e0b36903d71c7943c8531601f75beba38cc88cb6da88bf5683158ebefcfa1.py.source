"""Prepare exact metadata helper packaging plan only; no bundle or target calls."""
import datetime as dt, hashlib, json, os, stat
from pathlib import Path
R=Path(__file__).parent; C=R/'m3_peer_contracts_016'; T=C/'i13'; PUB=R/'publication_001'
def raw(p):
 for a in (p,*p.parents):
  s=a.lstat(); assert not a.is_symlink() and not getattr(s,'st_file_attributes',0)&1024
 a=p.stat(); assert stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size<=2097152
 b=p.read_bytes(); z=p.stat(); assert p.read_bytes()==b and a.st_size==z.st_size==len(b)
 assert all(getattr(a,k)==getattr(z,k) for k in ('st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_nlink'))
 return b
def pin(p):
 b=raw(p); return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'; sv=json.loads(raw(scope)); now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sv['interval_start'])<=now and (dt.datetime.fromisoformat(sv['interval_end'])-now).total_seconds()>60
members=[pin(p) for p in sorted(R.rglob('*.py')) if not p.is_relative_to(C) and not p.is_relative_to(PUB)]
assert members and len({m['path'].casefold() for m in members})==len(members)
v=dict(schema_version=1,record_type='Root_I13_exact_whole_metadata_helper_Source_bundle_selection_plan',author='/root',created_utc=now.isoformat(),Source_scope=pin(scope),Source_scope_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE002_DIFFERENT_REVIEW_ADOPTION_001.json'),members=members,member_count=len(members),member_bytes=sum(m['bytes'] for m in members),
 selection='Exact listed .py metadata author/review helpers outside complete m3_peer_contracts_016 and publication_001 directories. All target/kernel/fixture/process supervisor Sources stay direct inert copies. New helpers absent from this frozen list stay direct copies.',
 encoding='UTF8 JSON objects with exact original fact3 and RFC4648 Base64 of every complete byte; decode(validate=True), original byte length and SHA256, exclusive original Source membership, no executable loader or restored file writes. Complete original Sources remain physically untouched.',
 bundle_layout='Greedy original-path sorted members into complete JSON bundles each <=2097152 serialized bytes, no member split; all rows appear exactly once. Only these exact member Source files may be omitted from direct copy; bundle JSON itself stays a direct exact copy. Index maps every original fact3 to bundle copy fact3 and member ordinal.',
 exact_original_Source_bytes_reconstructable=True,maximum_metadata_file_bytes=2097152,maximum_actual_copy_rows=512,maximum_actual_copy_payload_bytes=67108864,
 inventory_policy='All other original files remain direct exact copies under inherited suffix-only filename transform. No original JSON/TXT evidence omission, deletion or normalization. If bounded final inventory fails, refuse; this plan grants no cap waiver.',
 required_separate_steps=['Genuine different Source review and Root plan adoption','New archive helper exact Source review and Root adoption','Actual bundles byte reconstruction review','Exact final candidate different review and Root adoption','Actual managed creation different saved review and Root adoption'],
 target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,execution_lease_issued=False,old_files_modified=False)
p=R/'I13_EXACT_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json'
b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode(); assert len(b)<=2097152 and not os.path.lexists(p)
with p.open('xb') as h: h.write(b)
print(json.dumps(dict(plan=pin(p),members=len(members),source_bytes=v['member_bytes'],bundle_created=False)))
