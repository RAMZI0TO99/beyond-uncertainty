ck('assembler_metadata_only_no_exec_or_function_call_of_subjects',not any(isinstance(n,ast.Call)and isinstance(n.func,ast.Name)and n.func.id in ('exec','eval','compile')for n in ast.walk(at))and not any(isinstance(n,ast.Call)and isinstance(n.func,ast.Attribute)and n.func.attr.startswith(('snapshot_I13','validate_','run_diagnostic'))for n in ast.walk(at)),'Assembler reads Source/AST/text and writes new inert Source/role-plan/freeze only; not invoked by reviewer.')
