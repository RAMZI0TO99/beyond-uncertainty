ck('phase_semantics_Source_ids_and_first_crossing_recomputed',any(isinstance(n,ast.Assign)and any(isinstance(t,ast.Subscript)for t in n.targets)for n in ast.walk(phase_loop)),'REFUSE: per-phase loop only shape/type checks and optional check_fact; no ordered charge/cumulative accumulator, cache-miss roster/Source-site/phase-enum membership or first-crossing recomputation. Correct headline sums can coexist with arbitrary phase rows/crossing.')
ck('existing_scope_prelaunch_selection_join_checked',"pre.get('role_group_id') == v['role_group_id']"in template or "pre['role_group_id']==v['role_group_id']"in template,'REFUSE: prelaunch Source/adoption/resources/release join is checked but selected role group is not joined.')
save_src=src(admission,id_['save'])
ck('admission_every_metadata_write_checks_current_Source_reserve','reserve('in save_src,'REFUSE: save() checks absent/cap but no current Source reserve. Earlier now/end test and later<30 assertion cannot prevent an expired-reserve prelaunch write after a delay; recheck immediately before owned-directory allocation and both metadata writes.')
