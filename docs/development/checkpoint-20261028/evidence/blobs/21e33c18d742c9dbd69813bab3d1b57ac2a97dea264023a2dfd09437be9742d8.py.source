ck('latest_peer_release_maxgrant_and_native_resources_checked',"max(int(p.stem.rsplit('_',1)[1]) for p in grants)==grant"in admission and "peer['reported_full_compute_custody_released'] is peer['grant_consumed_closed'] is True"in admission and 'GlobalMemoryStatusEx'in admission and 'm.available_phys>=1073741824 and disk>=10737418240'in admission,'Reported peer release only; no result/whole-host absence acceptance.')
