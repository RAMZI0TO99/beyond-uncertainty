ck('typed_refusal_is_nonzero_not_success',"record_type='I13_owned_data_only_input_snapshot_typed_refusal'"in template and "except MemoryError:\n        raise"in template and "event='INPUT_SNAPSHOT_REFUSED'"in template,'MemoryError propagates, ordinary ValueError retained bounded and returns1.')
