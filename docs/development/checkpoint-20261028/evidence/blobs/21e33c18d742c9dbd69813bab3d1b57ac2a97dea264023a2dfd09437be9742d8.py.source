ck('record_roster_distinct_hash_and_sum_verified',"sum(x['bytes'] for x in pins)==g['total_record_bytes']"in template and "hashlib.sha256(roster).hexdigest()==g['record_set_LF_fact3_sha256']"in template,'All original ordinals retained; no raw bodies serialized by controller.')
ck('headline_eager_separate_cache_and_result_double_charge_correct',"eager=1+11*g['record_count']"in template and "route['child_result_nodes']==route['parent_child_result_decode_nodes']"in template and "route['planned_conservative_total']==parent+child"in template,'Headline costs use complete record roster and separate parent/child caches.')
vl=ast.unparse(td['validate_ledger']);cu=ast.unparse(td['check_use'])
