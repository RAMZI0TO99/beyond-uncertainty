ck('child_calls_fixed_export_once_and_no_run_or_validators',template.count('fixture.snapshot_I13_M3_input_node_ledger(')==1 and all(s not in template for s in ('fixture.run(','fixture.run_diagnostic(','encode_I13_contract_record(','validate_M3_complete_stage_output_metadata(')),'Future snapshot itself remains separately reviewed Source; no actual calls here.')
