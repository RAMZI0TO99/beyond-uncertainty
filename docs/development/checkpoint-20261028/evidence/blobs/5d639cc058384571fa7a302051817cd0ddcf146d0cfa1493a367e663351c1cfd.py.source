import ast,json
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003\m3_peer_contracts_016\i13')
def defs(tree):
 return {('class.'+n.name if isinstance(n,ast.ClassDef) else n.name):n for n in tree.body if isinstance(n,(ast.ClassDef,ast.FunctionDef))}
for old,new in [('validate_M3_guard_contract_metadata_003.py','validate_M3_guard_contract_metadata_006.py'),('validate_selected_peer_author_packet_metadata_007.py','validate_selected_peer_author_packet_metadata_008.py')]:
 a=ast.parse((P/old).read_text(encoding='utf-8')); b=ast.parse((P/new).read_text(encoding='utf-8')); ad=defs(a); bd=defs(b)
 print('PAIR',old,new)
 for name,node in bd.items():
  if name not in ad or ast.dump(node,include_attributes=False)!=ast.dump(ad[name],include_attributes=False):
   if isinstance(node,ast.ClassDef) and name in ad:
    oldmethods={n.name:n for n in ad[name].body if isinstance(n,ast.FunctionDef)}
    for item in node.body:
     if isinstance(item,ast.FunctionDef) and (item.name not in oldmethods or ast.dump(item,include_attributes=False)!=ast.dump(oldmethods[item.name],include_attributes=False)):
      print('CHANGED',name+'.'+item.name,item.lineno,item.end_lineno);print(ast.unparse(item))
   else:print('CHANGED',name,node.lineno,node.end_lineno);print(ast.unparse(node))
 print('ASSIGNMENTS')
 for n in b.body:
  if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and ('ACTOR' in t.id or 'EDGES' in t.id) for t in n.targets): print(ast.unparse(n))
for fn in ['I13_M3_GUARD_KERNEL_SOURCE004_BOUNDED_REPAIR_AND_WHOLE_INVERSE_RECEIPT_001.json','I13_M3_GUARD_KERNEL_SOURCE005_REVIEW_AUTHOR_BOUNDARY_AND_WHOLE_INVERSE_RECEIPT_001.json','I13_M3_GUARD_KERNEL_SOURCE006_EARLY_OPERATIVE_BODY_ACTORS_AND_WHOLE_INVERSE_RECEIPT_001.json','I13_PEER_CANONICAL_AUTHOR_SOURCE_AUTHOR_RECEIPT_008.json']:
 v=json.loads((P/fn).read_text(encoding='utf-8'));print('RECEIPT_KEYS',fn,json.dumps({k:(type(x).__name__,len(x) if isinstance(x,(str,list,dict)) else x) for k,x in v.items()}))
