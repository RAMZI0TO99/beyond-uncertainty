"""Independent whole Source015 metadata review; reviewed code is never executed."""
import ast
import base64
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path

HERE = Path(__file__).parent
ROOT = HERE.parent
R5 = ROOT.parent
OLD = R5 / 'Source014_coexistence_001'
REVIEWER = '/root/coexistence014_final_review'
AUTHOR = '/root/failure_disposition_final_review'
CAP = 2097152
END = dt.datetime(2026, 10, 28, 10, 30, tzinfo=dt.timezone.utc)
CHECKS = []
FINDINGS = []

def require(value, reason):
    if not value:
        raise ValueError(reason)

def current():
    now = dt.datetime.now(dt.timezone.utc)
    require(now.date() == dt.date(2026, 10, 28) and now < END - dt.timedelta(seconds=60), 'finite current review and strict60 reserve')
    return now

def shape(value):
    stack, count, deepest = [(value, 0)], 0, 0
    while stack:
        item, depth = stack.pop()
        count += 1
        deepest = max(deepest, depth)
        require(count <= 50000 and depth <= 48, 'bounded metadata node/depth')
        require(item is None or type(item) in (str, int, bool, list, dict), 'float-free builtins')
        if type(item) is str:
            require(not any(55296 <= ord(c) <= 57343 for c in item), 'no surrogate strings')
        elif type(item) is list:
            stack.extend((x, depth + 1) for x in item)
        elif type(item) is dict:
            require(all(type(k) is str for k in item), 'string keys')
            for key, val in item.items():
                stack.extend(((key, depth + 1), (val, depth + 1)))
    return {'nodes': count, 'max_depth': deepest}

def pairs(items):
    answer = {}
    for key, value in items:
        require(key not in answer, 'duplicate JSON key')
        answer[key] = value
    return answer

def reject_number(token):
    raise ValueError('fractional/nonfinite own metadata token: ' + token)

def strict(data):
    require(type(data) is bytes and len(data) <= CAP, 'bounded strict JSON buffer')
    value = json.loads(data.decode('utf-8'), object_pairs_hook=pairs, parse_float=reject_number, parse_constant=reject_number)
    shape(value)
    return value

def read(path):
    path = Path(path)
    require(path.is_absolute() and path.is_relative_to(R5), 'fixed Root metadata workspace')
    for part in (path, *path.parents):
        info = part.lstat()
        require(not stat.S_ISLNK(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 1024, 'direct nonreparse lineage')
    first = path.stat()
    require(stat.S_ISREG(first.st_mode) and first.st_nlink == 1 and 0 <= first.st_size <= CAP, 'bounded ordinary singlelink file')
    with path.open('rb') as handle:
        opened = os.fstat(handle.fileno())
        data = handle.read(CAP + 1)
        last = os.fstat(handle.fileno())
    after = path.stat()
    key = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns, x.st_ctime_ns, getattr(x, 'st_file_attributes', 0))
    require(key(first) == key(opened) == key(last) == key(after) and len(data) == first.st_size, 'whole stable metadata buffer')
    return data

def pin(path, data=None):
    if data is None:
        data = read(path)
    return {'path': str(path), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}

def checked(name, result, evidence=None):
    require(type(name) is str and name and all(x['name'] != name for x in CHECKS), 'unique positive check name')
    require(type(result) is bool, 'actual boolean check result')
    row = {'name': name, 'passed': result}
    if evidence is not None:
        shape(evidence)
        row['evidence'] = evidence
    CHECKS.append(row)
    if not result:
        FINDINGS.append({'check': name, 'evidence': evidence})

def load(label, path, size, sha, json_document=True):
    data = read(path)
    f3 = pin(path, data)
    checked(label + '.exact_F3', f3['bytes'] == size and f3['sha256'] == sha, f3)
    value = strict(data) if json_document else data.decode('utf-8')
    checked(label + '.whole_stable_singlelink_nonreparse_bounded_read', True, shape(value) if json_document else {'bytes': len(data)})
    return value, f3, data

def save(name, value):
    require(Path(name).name == name and HERE.parent == ROOT and HERE.name == 'different_review_001', 'only fixed own new output')
    shape(value)
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    require(len(data) <= CAP, 'own2MiB output cap')
    current()
    path = HERE / name
    with path.open('xb') as handle:
        require(handle.write(data) == len(data), 'whole exclusive CreateNew')
        handle.flush()
        os.fsync(handle.fileno())
    require(read(path) == data and strict(read(path)) == value, 'whole flushed strict readback')
    return pin(path, data)

