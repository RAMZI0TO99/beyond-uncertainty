 'raw.nonreparse_lineage': "not stat.S_ISLNK(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 1024",
 'raw.regular_singlelink_cap': 'stat.S_ISREG(first.st_mode) and first.st_nlink == 1 and 0 <= first.st_size <= CAP',
 'raw.whole_four_sample_stability': 'key(first) == key(opened) == key(last) == key(after) and len(data) == first.st_size',
 'raw.ctime_and_file_attributes_in_stability': "x.st_mtime_ns, x.st_ctime_ns, getattr(x, 'st_file_attributes', 0)",
 'JSON.duplicate_rejection': "need(key not in out, 'duplicate JSON key')",
 'JSON.fractional_nonfinite_rejection': 'parse_float=bad_number, parse_constant=bad_number',
 'JSON.node_and_depth_caps': "need(count <= 50000 and depth <= 48, 'metadata node/depth caps')",
 'JSON.float_free_builtin_types': 'type(obj) in (str, int, bool, list, dict)',
 'JSON.surrogate_rejection': 'not any(55296 <= ord(c) <= 57343 for c in obj)',
 'fresh.strict_date': 'now.date() == dt.date(2026, 10, 28)',
 'fresh.strict_reserve': 'now < dt.datetime.fromisoformat(END) - dt.timedelta(seconds=60)',
 'fresh.actual_start': "need(dt.datetime.fromisoformat(start) <= now, 'new interval start reached')",
 'save.fixed_filename': 'Path(name).name == name',
 'save.byte_cap': "need(len(data) <= CAP, 'own output byte cap')",
 'save.current_interval_start': "fresh(value.get('interval_start'))",
 'save.CreateNew': "with path.open('xb') as handle:",
 'save.whole_write': "need(handle.write(data) == len(data), 'whole exclusive CreateNew')",
 'save.flush_fsync': 'handle.flush()\n        os.fsync(handle.fileno())',
 'save.whole_strict_readback': "raw(path) == data and document(path)[0] == value",
 'mode.explicit': "len(sys.argv) >= 2 and sys.argv[1] in ('prepare', 'adopt')",
 'prepare.exact_args': "need(len(sys.argv) == 2, 'prepare no other arguments')",
 'prepare.whole_predecessor_inverse': "base64.b64encode(raw(pin['path'])).decode('ascii')",
 'adopt.exact_args': "len(sys.argv) == 4, 'Root alone adopt requires exact different-review capsule path and SHA256'",
 'adopt.capsule_workspace': 'capsule_path.is_absolute() and capsule_path.is_relative_to(R5)',
 'adopt.exact_capsule_SHA': "capsule_pin['sha256'] == sys.argv[3]",
 'adopt.proof_workspace': 'proof_path.is_absolute() and proof_path.is_relative_to(R5)',
 'adopt.exact_proof_F3': "document(proof_path, capsule['full_proof'])",
 'adopt.same_different_reviewer': "capsule['reviewer'] == proof['reviewer'] and type(capsule['reviewer']) is str and capsule['reviewer'] not in (AUTHOR, '/root')",
 'adopt.same_PASS_verdict': "capsule['verdict'] == proof['verdict'] and capsule['verdict'].startswith('PASS_')",
 'adopt.same_empty_findings': "capsule['remaining_actionable_findings'] == proof['remaining_actionable_findings'] == []",
 'adopt.positive_named_bool_checks': "x.get('passed') is True for x in checks",
 'adopt.unique_check_names': "len({x['name'] for x in checks}) == len(checks)",
 'adopt.exact_pass_count': "type(reviewed['checks_passed']) is int and reviewed['checks_passed'] == len(checks)",
 'adopt.exact_zero_failure_count': "type(reviewed['checks_failed']) is int and reviewed['checks_failed'] == 0",
 'adopt.entire_expected_scope': "scope == make_scope(scope['created_utc'], inverse_pin)",
 'adopt.actual_scope_start': "fresh(scope['interval_start'])",
 'adopt.two_predecessor_files': "len(inverse['items']) == 2",
 'adopt.whole_original_inverse_bytes': "base64.b64decode(item['base64'], validate=True) == raw(pin['path'])",
 'adopt.exact_ordered_roster': 'artifacts = [scope_pin, self_pin, inverse_pin]',
 'adopt.scope_and_candidate_F3': "capsule['scope'] == proof['scope'] == capsule['candidate'] == proof['candidate'] == scope_pin",
 'adopt.same_exact_review_roster': "capsule['reviewed_artifacts'] == proof['reviewed_artifacts'] == artifacts",
 'adopt.fresh_exact_artifacts': "fact(Path(pin['path'])) == pin",
 'adopt.all_false_operational_holds': 'type(scope[key]) is bool and scope[key] is False',
 'adopt.fixed_output': 'adoption = save(ADOPTION_NAME, dict(',
}
for name, fragment in requirements.items():
    checked('Source.guard.' + name, fragment in source, fragment)
checked('Source.fixed_new_END_and_physical_author', "END = '2026-10-28T10:30:00+00:00'" in source and "AUTHOR = '/root/failure_disposition_final_review'" in source)
checked('Source.prepare_and_adopt_separate_exit_paths', "sys.exit(0)\n\nneed(len(sys.argv) == 4" in source)
checked('Source.review_gates_precede_adoption_write', source.index('capsule, capsule_pin = document(capsule_path)') < source.index('adoption = save(ADOPTION_NAME') and source.index('for key in HOLDS:') < source.index('adoption = save(ADOPTION_NAME'))
checked('Source.no_subject_import_native_API_process_kill_or_target_call', all(token not in source for token in ('Popen(', 'CreateProcess', 'Add-Type', 'ParseFile(', 'Get-CimInstance', 'Get-Process', 'kill(', 'os.system(', 'os.popen(')))
checked('Source.no_readiness_promotion_in_Root_decision', 'False004 custody/release remain a hard prelaunch hold even beyond ordinary future grants; separately reviewed custody-resolution contract/distinct successor would be needed.' in source)

artifacts = [scope_pin, source_pin, inverse_pin]
for index, fact in enumerate(artifacts):
    checked('final_refresh.reviewed_artifact_' + str(index), pin(Path(fact['path'])) == fact, fact)
for label, fact in [('scope014', old_pin), ('adoption014', old_adoption_pin), ('scope013', context13_pin), ('adoption013', adoption13_pin), ('dated_failure', failure_pin), ('older_inverse', old_inverse_pin), ('prior_review_proof', prior_proof_pin)]:
    checked('final_refresh.context_' + label, pin(Path(fact['path'])) == fact, fact)
checked('final_review.actual_start_strict_reserve', start <= current() < END - dt.timedelta(seconds=60))
passed = sum(1 for item in CHECKS if item['passed'])
failed = len(CHECKS) - passed
require(passed > 0, 'positive proof count')
verdict = 'PASS_WHOLE_SOURCE015_NEW_FINITE_SOURCE_ONLY_METADATA' if not FINDINGS else 'FAIL_SOURCE015_METADATA_ACTIONABLE_FINDINGS'
common = dict(reviewer=REVIEWER, physical_Source_author=AUTHOR, intended_Root_adopter='/root', verdict=verdict,
    scope=scope_pin, candidate=scope_pin, reviewed_artifacts=artifacts, checks_passed=passed, checks_failed=failed,
    remaining_actionable_findings=FINDINGS, started_utc=began, completed_utc=current().isoformat(),
    interval_end=scope['interval_end'], publication_reserve_seconds=60, metadata_cap_bytes=CAP, metadata_depth=48, metadata_nodes=50000,
    review_scope='Whole exact Source015 candidate, metadata author/adopter Source text and AST, whole Source014 scope/adoption inverse and exact dated saved metadata context only.',
    authority='Standing direct human bounded Source phase already independently verified by this reviewer for Source014; new finite Source015 scheduling still requires actual separate Root adoption.',
    Root_decision_made=False, Source_only_coexistence_adopted=False, subject_or_author_or_adopter_invoked=False,
    Subject_Source005_read_or_qualified=False, live_process_native_resource_or_pause_query_performed=False,
    target_Python_test_Job_capture_Git_runtime_or_science_performed=False, operational_authority=False,
    failed004_result_or_custody_accepted=False, native_request_advanced=False)
proof = dict(record_type='Independent_Source015_new_finite_coexistence_metadata_full_proof', schema_version=1, **common,
    checks=CHECKS, reviewer_helper_Source=pin(Path(__file__)),
    exact_context_artifacts=[old_pin, old_adoption_pin, context13_pin, adoption13_pin, failure_pin, old_inverse_pin, prior_proof_pin],
    provenance_attribution='This reviewer independently read exact human message and preceding final handoff during Source014 review; this review retains that genuine proof. No fresh user instruction or new verification by Source015 physical author is claimed.',
    limitations=['No Root decision or operative permission is made by this review.',
      'Source005 reports remain unqualified and no Source005 file or native Parser was read/invoked here.',
      'Source01409:30/strict09:29 and Source01310:00 ends and whole prior bytes remain unchanged.',
      'Failed004 remains FAILED_UNRELEASED_CONSUMED, unclosed/unreleased. Hard prelaunch custody hold survives ordinary future grants; separate custody-resolution contract and distinct successor are necessary.',
      'Root3/peer2 serialized author OR reviewer/shared5, strict60 reserve and all original guards/caps/budgets remain.'])
proof_pin = save('INDEPENDENT_SOURCE015_NEW_FINITE_COEXISTENCE_METADATA_FULL_PROOF_001.json', proof)
capsule = dict(record_type='Independent_Source015_new_finite_coexistence_metadata_capsule', schema_version=1, **common,
    full_proof=proof_pin, reviewer_helper_Source=pin(Path(__file__)),
    summary='Whole exact Source015 metadata and ordered scope/helper/inverse roster pass independent static review. New finite Source-only review/fix scheduling still needs Root adoption. Old ends, operational holds, custody hard hold and all guards remain unchanged.')
capsule_pin = save('INDEPENDENT_SOURCE015_NEW_FINITE_COEXISTENCE_METADATA_CAPSULE_001.json', capsule)
require(strict(read(Path(capsule_pin['path'])))['full_proof'] == pin(Path(proof_pin['path'])), 'final fullproof capsule binding')
print(json.dumps(dict(reviewer=REVIEWER, verdict=verdict, full_proof=proof_pin, capsule=capsule_pin,
    checks_passed=passed, checks_failed=failed, remaining_actionable_findings=FINDINGS,
    reviewer_helper_Source=pin(Path(__file__)), completed_utc=current().isoformat()), sort_keys=True))
