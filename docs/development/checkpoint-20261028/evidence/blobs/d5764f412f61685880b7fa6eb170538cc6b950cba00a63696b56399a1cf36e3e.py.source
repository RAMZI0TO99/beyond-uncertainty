def pin(path, raw=None):
    raw = path.read_bytes() if raw is None else raw
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def write_new(path, raw):
    assert not path.exists(), path
    with path.open('xb') as f:
        f.write(raw)
    assert path.read_bytes() == raw

old = OLD.read_bytes()
assert len(old) == 56967 and hashlib.sha256(old).hexdigest() == '895128139effcfc5c21acb94e193bcd6766d364da97a9c0db1f0a2756dee541e'
assert pin(REFUSAL)['sha256'] == '409681719b2e99d0ddb3d732baa43a0388132d5cdd4de2201bdb6daef3b11e08'
assert pin(REFUSAL_FULL)['sha256'] == 'b87712b4b6bd1a19b6869b7c31439c4dc0444c164f2989b299895b2003ac88ae'
assert pin(SCOPE)['sha256'] == '6ae2f44312aa0ffd37bf8bf8cc95372fc700c09698ae85ab700174ecf4874207'
text = old.decode('utf-8')
deltas = []

def replace_region(qualname, replacement):
    global text
    tree = ast.parse(text)
    parts = qualname.split('.')
    node = next(n for n in tree.body if isinstance(n, (ast.ClassDef, ast.FunctionDef)) and n.name == parts[0])
    if len(parts) == 2:
        node = next(n for n in node.body if isinstance(n, ast.FunctionDef) and n.name == parts[1])
    lines = text.splitlines(keepends=True)
    before = ''.join(lines[node.lineno-1:node.end_lineno])
    assert text.count(before) == 1
    text = text.replace(before, replacement.rstrip()+'\n', 1)
    deltas.append(dict(region=qualname, before_utf8_base64=base64.b64encode(before.encode()).decode(), after_utf8_base64=base64.b64encode((replacement.rstrip()+'\n').encode()).decode()))

replace_region('_tree', r'''def _tree(value, counter, depth=0, lf_record=False, pointer=(), i11_record=False):
    _need(depth <= 48, 'E_DEPTH')
    counter[0] += 1
    _need(counter[0] <= 50000, 'E_NODES')
    if value is None or type(value) in (bool, int):return
    if type(value) is str:
        _need(not any(0xD800 <= ord(c) <= 0xDFFF for c in value), 'E_VALUE')
        controls={ord(c) for c in value if ord(c)<32}
        if controls and not(i11_record and pointer and pointer[0]=='literal_case_catalogue'):
            _need(lf_record and pointer==LF_POINTER and controls=={10} and len(value.encode('utf8'))==367 and value.count('\n')==10 and hashlib.sha256(value.encode('utf8')).hexdigest()==LF_LEAF_SHA256, 'E_VALUE')
        return
    if type(value) is list:
        for i,child in enumerate(value):_tree(child,counter,depth+1,lf_record,pointer+(i,),i11_record)
        return
    if type(value) is dict:
        for key,child in value.items():
            _need(type(key) is str, 'E_VALUE')
            _tree(key,counter,depth+1,lf_record,pointer+('#key',key),i11_record)
            _tree(child,counter,depth+1,lf_record,pointer+(key,),i11_record)
        return
    raise I13MetadataError('E_VALUE')''')
replace_region('_decode', '''def _decode(raw, counter, byte_code='E_METADATA_CAP', lf_record=False, i11_record=False):
    _need(type(raw) is bytes and 0 < len(raw) <= CAP, byte_code)
    try:
        value = json.loads(raw.decode('utf8'),object_pairs_hook=_pairs,parse_float=_bad_number,parse_constant=_bad_number)
    except I13MetadataError:
        raise
    except (ValueError, UnicodeError, RecursionError):
        raise I13MetadataError('E_JSON') from None
    _tree(value, counter, lf_record=lf_record, i11_record=i11_record)
    return value''')
replace_region('_Store.record', '''    def record(self, pin, schema=None):
        raw = self.raw(pin)
        key = pin['path']
        if key not in self.cache:
            self.cache[key] = _decode(raw,self.counter,lf_record=_same(pin,LF_RECORD_PIN),i11_record=_same(pin,I11_FIXED_API_PIN))
        value = self.cache[key]
        _need(type(value) is dict, 'E_SCHEMA')
        return value''')
replace_region('_Graph._proof_author_slots', '''    def _author_slots(self,value,context='proof',pin=None,parts=()):
        if type(value)is dict:
            for key,child in value.items():
                if not parts and pin is not None and _same(pin,I11_FIXED_API_PIN)and key=='literal_case_catalogue':continue
                if key in ('reviewer','reviewer_agent'):continue
                if key in I13_OPERATIVE_ACTOR_KEYS or(key=='author'and context=='operative'):
                    self.excluded.add(_actor(child).casefold())
                elif key in ('actual_content_authors','actual_content_authors_additional'):
                    _need(type(child)is list and len(child)<=512,'E_ACTOR')
                    for actor in child:self.excluded.add(_actor(actor).casefold())
                else:
                    next_context='operative'if context=='operative'or key in I13_OPERATIVE_AUTHOR_CONTEXTS else'proof'
                    self._author_slots(child,next_context,pin,parts+(key,))
        elif type(value)is list:
            for i,child in enumerate(value):self._author_slots(child,context,pin,parts+(i,))
    def _proof_author_slots(self,extra=(),apis=()):
        # Each root has an explicit consuming ABI. Proof-root author and reviewer
        # attribution is not content authorship; operative Source/API slots are.
        pending=[(p,'proof')for p in extra]+[(p,'operative')for p in apis]
        for name,support,schema in self.codes:
            pending.extend(((support['API'],'operative'),(support['different_review'],'proof'),(support['Root_adoption'],'proof')))
        for support_key in ('selection_support','canonical_support','reconciliation_support','content_support','proposal_support'):
            if support_key in self.p:
                support=self.p[support_key]
                pending.extend(((support['different_review'],'proof'),(support['Root_adoption'],'proof')))
        seen=set()
        for pin,context in pending:
            key=(_pin(pin)['path'],context)
            if key in seen:continue
            seen.add(key);v=self.s.record(pin)
            self._author_slots(v,context,pin)
            if context=='proof'and 'full_proof'in v:
                full_pin=_pin(v['full_proof']);full=self.s.record(full_pin)
                self._author_slots(full,'proof',full_pin)''')
replace_region('_Graph.add_actors', '''    def add_actors(self,*records):
        for value in records:self._author_slots(value,'operative')''')
replace_region('_Graph.review', '''    def review(self,pin,subjects,code=False):
        for subject in subjects:self.s.raw(subject)
        capsule=self.s.record(pin);_noauth(capsule)
        full_pin=_pin(capsule.get('full_proof'));full=self.s.record(full_pin);_noauth(full)
        required=('schema_version','record_type','reviewer','created_utc','subjects','checks_passed','checks_failed','native_Parser_executed','target_execution','operational_authority','verdict')
        for value in (capsule,full):
            _need(all(key in value for key in required),'E_REVIEW')
            _need(type(value['schema_version'])is int and value['schema_version']>0 and type(value['record_type'])is str and bool(value['record_type']),'E_REVIEW')
            _need(value['native_Parser_executed']is False,'E_AUTHORITY')
            _i13_utc6(value['created_utc']);declared=_pin_list(value['subjects'],True)
            for subject in declared:self.s.raw(subject)
            _need(all(any(_same(p,subject)for p in declared)for subject in subjects),'E_REVIEW_COVERAGE')
        who=_actor(capsule['reviewer'],True);key=who.casefold()
        _need(all(key!=a and (a=='/root' or not key.startswith(a+'/')) for a in self.excluded),'E_REVIEWER')
        verdict=capsule['verdict']
        _need(type(verdict)is str and verdict.startswith('PASS_')and(not code or 'SOURCE'in verdict.upper())and type(capsule['checks_failed'])is int and capsule['checks_failed']==0,'E_REVIEW')
        _need(full['reviewer']==who and full['verdict']==verdict and type(full['checks_failed'])is int and full['checks_failed']==0,'E_REVIEW')
        checks=full.get('checks');_need(type(checks)is list and 0<len(checks)<=10000,'E_REVIEW')
        names=[]
        for check in checks:
            _closed(check,('name','passed','evidence'),'E_REVIEW')
            _need(type(check['name'])is str and 0<len(check['name'])<=512 and check['passed']is True,'E_REVIEW')
            names.append(check['name'])
        _need(len(names)==len(set(names))and type(capsule['checks_passed'])is int and type(full['checks_passed'])is int and capsule['checks_passed']==full['checks_passed']==len(checks)>0,'E_REVIEW')
        ft,ct=_i13_utc6(full['created_utc']),_i13_utc6(capsule['created_utc'])
        _need(ft<=ct<=self.now,'E_CHRONOLOGY')
        return dict(capsule=capsule,full=full,full_pin=full_pin,full_time=ft,capsule_time=ct)''')
