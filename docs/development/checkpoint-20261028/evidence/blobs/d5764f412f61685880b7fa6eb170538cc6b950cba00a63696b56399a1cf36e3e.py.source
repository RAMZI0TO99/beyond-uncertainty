assert ast.dump(next(n for n in before_peer.body if isinstance(n,ast.FunctionDef)and n.name=='source_pins'),include_attributes=False)==ast.dump(next(n for n in after_peer.body if isinstance(n,ast.FunctionDef)and n.name=='source_pins'),include_attributes=False)
