        value=self.s.record(pin);_noauth(value)
        required=('schema_version','record_type','author','created_utc','subjects','different_review','full_proof','native_Parser_executed','target_execution','operational_authority','verdict')
        _need(all(key in value for key in required),'E_ADOPTION')
        _need(type(value['schema_version'])is int and value['schema_version']>0 and type(value['record_type'])is str and bool(value['record_type'])and value['author']=='/root'and type(value['verdict'])is str and value['verdict'].startswith('ACCEPT_'),'E_ADOPTION')
