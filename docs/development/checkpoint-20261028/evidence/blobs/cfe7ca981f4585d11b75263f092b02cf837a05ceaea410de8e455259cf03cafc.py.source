def ck(name,ok,evidence):
    assert name not in {r['name']for r in checks}
    checks.append(dict(name=name,passed=bool(ok),evidence=evidence))
def pairs(rows):
    d={}
    for k,v in rows:
        if k in d:raise ValueError('duplicate JSON key')
        d[k]=v
    return d
def bad(token):raise ValueError('noninteger JSON token '+token)
def dec(raw):return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def fp(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),raw
def read(name,path,expected=None,JSON=False):
    path=Path(path);st=path.lstat()
    ck(name+'_ordinary_absolute',path.is_absolute()and stat.S_ISREG(st.st_mode)and not(st.st_file_attributes&1024),str(path))
    fact,raw=fp(path)
    ck(name+'_exact_pin',expected is None or fact==expected,fact)
    ck(name+'_within_original_file_cap',len(raw)<=2097152,[fact,2097152])
    if str(path)not in seen:seen[str(path)]=fact;subjects.append(fact)
    if JSON:
        value=dec(raw);ck(name+'_strict_JSON',type(value)is dict,fact);return value,fact,raw
    return raw,fact
def exact(name,a,b):ck(name,a==b,[a,b])
def fact_expected(path,size,sha):return dict(path=str(path),bytes=size,sha256=sha)

