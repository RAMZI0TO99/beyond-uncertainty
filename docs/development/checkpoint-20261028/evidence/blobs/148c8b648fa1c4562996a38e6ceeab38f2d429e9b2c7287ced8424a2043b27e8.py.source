def write(name, value):
    reserve()
    raw = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True, allow_nan=False)+'\n').encode('ascii')
    assert len(raw) <= CAP
    path = O/name
    with path.open('xb') as handle:
        assert handle.write(raw) == len(raw)
    assert path.read_bytes() == raw
    return dict(path=str(path), bytes=len(raw), sha256=sha(raw))

fullpin = write('INDEPENDENT_PRO3_AGGREGATE_ALLOCATION002_SOURCE_INPUT_FULL_PROOF_001.json', full)
