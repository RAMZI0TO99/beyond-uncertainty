O = R / 'pro3_aggregate_allocation_review_002'
END = dt.datetime.fromisoformat('2026-10-25T21:55:00+00:00')
CAP = 2097152
checks = []
subjects = {}
parsed_paths = set()
large_streamed = {}

def reserve():
    assert (END - dt.datetime.now(dt.timezone.utc)).total_seconds() > 60

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def ck(name, passed, evidence):
    assert type(passed) is bool
    checks.append(dict(name=name, passed=passed, evidence=evidence))
    assert passed, name

def key(info):
    return tuple(getattr(info, name, None) for name in
                 ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_nlink', 'st_file_attributes'))

def lineage(path):
    values = []
    for node in (path, *path.parents):
        info = node.lstat()
        assert not node.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024
        if node != path:
            assert stat.S_ISDIR(info.st_mode)
            values.append((str(node), info.st_dev, info.st_ino, info.st_ctime_ns, getattr(info, 'st_file_attributes', 0)))
    return values

def stream(spec, maximum=8388608):
    path = Path(spec['path'])
    assert path.is_absolute() and path.resolve(strict=True) == path
    ancestors = lineage(path)
    before = path.stat()
    assert stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 <= before.st_size <= maximum
    digest = hashlib.sha256()
    size = 0
    with path.open('rb') as handle:
        opened = os.fstat(handle.fileno())
        while True:
            block = handle.read(65536)
            if not block:
                break
            size += len(block)
            assert size <= maximum
            digest.update(block)
        finished = os.fstat(handle.fileno())
    after = path.stat()
    assert key(before) == key(after) and key(opened) == key(finished)
    assert (opened.st_dev, opened.st_ino, opened.st_size) == (before.st_dev, before.st_ino, size)
    assert lineage(path) == ancestors
    pin = dict(path=str(path), bytes=size, sha256=digest.hexdigest())
    assert pin['sha256'] == spec['sha256'] and ('bytes' not in spec or pin['bytes'] == spec['bytes'])
    if str(path) in subjects:
        assert subjects[str(path)] == pin
    subjects[str(path)] = pin
    if size > CAP:
        large_streamed[str(path)] = pin
    return pin

def pairs(rows):
    value = {}
    for name, member in rows:
        assert name not in value
        value[name] = member
    return value

def small(spec):
    pin = stream(spec, CAP)
    raw = Path(pin['path']).read_bytes()
    assert len(raw) == pin['bytes'] and sha(raw) == pin['sha256']
    return raw

def js(spec):
    raw = small(spec)
    parsed_paths.add(spec['path'])
    return json.loads(raw.decode('utf8'), object_pairs_hook=pairs, parse_float=decimal.Decimal,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))

def at(name, size, digest):
    return dict(path=str(A/name), bytes=size, sha256=digest)

def fixed(path, size, digest):
    return dict(path=str(path), bytes=size, sha256=digest)

def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode('utf8')

