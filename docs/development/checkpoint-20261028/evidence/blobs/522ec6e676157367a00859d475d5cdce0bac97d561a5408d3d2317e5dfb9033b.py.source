v=dict(schema_version=1,record_type='Root_I13_SourceSet5_control_author002_metadata_label_repair_receipt',author='/root',predecessor=pin(p,raw),successor=pin(q,new),complete_predecessor_bytes_base64=base64.b64encode(raw).decode('ascii'),change='Correct only generated receipt record_type suffix to actual composition006/Plan006/Sup011 and remove inherited current-label SourceSet4 uninvoked flag before adding the truthful SourceSet5 flag. All author functions/guards/actual product paths unchanged.',successor_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
o=R/'ROOT_I13_SOURCESET5_ROOT_AUTHOR002_LABEL_REPAIR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii')
with o.open('xb')as h:h.write(b)
print(json.dumps(dict(Source=pin(q,new),receipt=pin(o,b),author_invoked=False)))
