a='Root_I13_compact_SourceSet5_composition005_plan005_supervisor010_inert_Source_author_receipt';b='Root_I13_corrective_SourceSet5_composition006_plan006_supervisor011_inert_Source_author_receipt';assert s.count(a)==1;s=s.replace(a,b)
a="plan.pop('all_new_and_old_helpers_builders_fixtures_targets_unrun_by_author',None)";assert s.count(a)==1;s=s.replace(a,a+";plan.pop('new_SourceSet4_targets_uninvoked_by_author',None)")
