  elif type(x) is list:todo.extend((v,d+1) for v in x)
  elif type(x) is dict:
   need(all(type(k) is str for k in x),'builtin keys')
   for k,v in x.items():todo.extend(((k,d+1),(v,d+1)))
 return count
