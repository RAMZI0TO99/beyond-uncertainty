import base64, datetime as dt, hashlib, json, math, os, stat, sys
from pathlib import Path
R=Path(__file__).parent
O=R.parent/'resume-20261025-003'
CAP=2097152

def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):
  s=q.lstat();need(not q.is_symlink() and not getattr(s,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=CAP,'regular singlelink2MiB metadata')
 with p.open('rb') as h:
  d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();fields=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(fields(a)==fields(d)==fields(e)==fields(z) and len(b)==a.st_size<=CAP,'samehandle stable bounded bytes');return b

def fact(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def doc(path,expected=None):
 b=raw(path);p=fact(path,b)
 if expected:need(p==expected,'exact complete metadata pin')
 def pairs(rows):
  d={}
  for k,v in rows:need(k not in d,'duplicate JSONkey');d[k]=v
  return d
 def finite(s):
  v=float(s);need(math.isfinite(v),'finiteJSON');return v
 def reject(s):raise ValueError('nonfinite JSONconstant')
 return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=reject),p

def bounded_tree(v,depth=1):
 if type(v) is dict:
  xs=[bounded_tree(x,depth+1) for x in v.values()];return 1+len(v)+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 if type(v) is list:
  xs=[bounded_tree(x,depth+1) for x in v];return 1+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 return 1,depth

def write(name,v):
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
 nodes,depth=bounded_tree(v);need(len(b)<=CAP and nodes<=50000 and depth<=48,'unchanged own metadata caps')
 now=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(s['interval_start'])<=now and (dt.datetime.fromisoformat(s['interval_end'])-now).total_seconds()>60,'strict60reserve at each final exclusive write')
 p=R/name
 with p.open('xb') as h:need(h.write(b)==len(b),'complete exclusiveWrite');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'whole metadata readback');return fact(p,b)

