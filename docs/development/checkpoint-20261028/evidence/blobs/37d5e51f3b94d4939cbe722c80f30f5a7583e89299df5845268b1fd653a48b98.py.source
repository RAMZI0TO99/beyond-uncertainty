ROOT=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
OUT=ROOT/'Source_scope002_different_review_001'
OLD=ROOT/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'
