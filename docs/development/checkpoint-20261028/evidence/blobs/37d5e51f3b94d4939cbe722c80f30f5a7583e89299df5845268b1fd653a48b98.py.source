checks=[]

def check(name, passed, evidence):
    assert type(name)is str and name not in {x['name']for x in checks}
    checks.append(dict(name=name,passed=bool(passed),evidence=evidence))

def wire(v):
    return json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode('ascii')

def pin(path):
    b=path.read_bytes()
    return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def pairs(values):
    out={}
    for k,v in values:
        if k in out:raise ValueError('duplicate JSON key')
        out[k]=v
    return out

def bad(value):
    raise ValueError('non-finite or float JSON number forbidden')

def read(path):
    b=path.read_bytes()
    if len(b)>2097152:raise ValueError('metadata bytes cap')
    return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_constant=bad,parse_float=bad)

def utc(value):
    result=datetime.datetime.fromisoformat(value)
    assert result.utcoffset()==datetime.timedelta(0)
    assert result.isoformat(timespec='microseconds')==value
    return result

old,new=read(OLD),read(NEW)
old_pin,new_pin=pin(OLD),pin(NEW)
