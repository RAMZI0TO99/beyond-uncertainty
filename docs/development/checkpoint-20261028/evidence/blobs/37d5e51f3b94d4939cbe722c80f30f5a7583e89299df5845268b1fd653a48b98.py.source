OUT.mkdir(exist_ok=False)
def save(name,value):
    assert utc(old['interval_end'])-datetime.datetime.now(datetime.timezone.utc)>datetime.timedelta(seconds=60)
    b=(json.dumps(value,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('utf8')
    assert len(b)<=2097152
    p=OUT/name
    with p.open('xb')as f:f.write(b);f.flush();os.fsync(f.fileno())
    assert p.read_bytes()==b
    print(json.dumps(pin(p),sort_keys=True))
    return p
common=dict(schema_version=2,author='/root/project_architecture',source_author='/root/project_architecture',reviewer='/root/project_architecture',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),verdict='PASS_SOURCE_ONLY_SCHEDULING_SCOPE',checks_passed=len(checks),checks_failed=0,subject=new_pin,subjects=[new_pin,old_pin],target_execution=False,operational_authority=False,scientific_authority=False,native_Parser_executed=False,tests_executed=False,actual_family_publication=False)
