"""Own bounded stdlib Source authoring. Does not import or call any target."""
from pathlib import Path
import ast
import base64
import datetime
import difflib
import hashlib
import json
import os

R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
C=R/'m3_peer_contracts_016'
T=C/'i13'
A=C/'m3_protocol_audit_001'
CAP=2097152

def wire(v):
    return (json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('ascii')

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def pin(path,raw=None):
    path=Path(path);raw=path.read_bytes() if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=sha(raw))

def decode(raw):
    def pairs(rows):
        d={}
        for k,v in rows:
            assert k not in d
            d[k]=v
        return d
    def bad(v):
        raise ValueError(v)
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def fresh():
    scope=decode((R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json').read_bytes())
    assert pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json')['sha256']=='726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'
    now=datetime.datetime.now(datetime.timezone.utc)
    assert (datetime.datetime.fromisoformat('2026-10-25T18:03:03.861408+00:00')-now).total_seconds()>60
    return now.isoformat(timespec='microseconds')

def save(path,raw,cap=CAP):
    path=Path(path)
    assert path.is_relative_to(C) and type(raw)is bytes and 0<len(raw)<=cap
    assert not os.path.lexists(path)
    fresh()
    with path.open('xb') as f:
        assert f.write(raw)==len(raw)
        f.flush();os.fsync(f.fileno())
    assert path.read_bytes()==raw
    return pin(path,raw)

def dump(node):
    return ast.dump(node,include_attributes=False)

def ast_sha(raw):
    return sha(dump(ast.parse(raw.decode('utf8'))).encode('utf8'))

def regions(raw):
    out={}
    def walk(rows,prefix=''):
        for row in rows:
            if isinstance(row,(ast.ClassDef,ast.FunctionDef)):
                out[prefix+row.name]=sha(dump(row).encode('utf8'))
                if isinstance(row,ast.ClassDef):walk(row.body,prefix+row.name+'.')
    walk(ast.parse(raw.decode('utf8')).body)
    return out

def literal(raw,name):
    rows=[x.value for x in ast.parse(raw.decode('utf8')).body if isinstance(x,ast.Assign) and any(isinstance(t,ast.Name)and t.id==name for t in x.targets)]
    assert len(rows)==1
    return ast.literal_eval(rows[0])

def assignment(text,name,value):
    rows=[x for x in ast.parse(text).body if isinstance(x,ast.Assign)and any(isinstance(t,ast.Name)and t.id==name for t in x.targets)]
    assert len(rows)==1
    row=rows[0];lines=text.splitlines(keepends=True)
    lines[row.lineno-1:row.end_lineno]=[name+'='+repr(value)+'\n']
    return ''.join(lines)

def once(text,before,after):
    assert text.count(before)==1,(before,text.count(before))
    return text.replace(before,after,1)

def inverse(before,after):
    old,new=before.splitlines(keepends=True),after.splitlines(keepends=True)
    offsets=[0]
    for line in new:offsets.append(offsets[-1]+len(line))
    result=[]
    for tag,a0,a1,b0,b1 in difflib.SequenceMatcher(None,new,old,autojunk=False).get_opcodes():
        if tag!='equal':
            fragment=b''.join(new[a0:a1])
            result.append(dict(after_start=offsets[a0],after_end=offsets[a1],after_fragment_sha256=sha(fragment),predecessor_fragment_base64=base64.b64encode(b''.join(old[b0:b1])).decode('ascii')))
    recovered=after
    for row in reversed(result):
        lo,hi=row['after_start'],row['after_end']
        assert sha(recovered[lo:hi])==row['after_fragment_sha256']
        recovered=recovered[:lo]+base64.b64decode(row['predecessor_fragment_base64'],validate=True)+recovered[hi:]
    assert recovered==before
    return result

records=[]
products={}
baseline={}
