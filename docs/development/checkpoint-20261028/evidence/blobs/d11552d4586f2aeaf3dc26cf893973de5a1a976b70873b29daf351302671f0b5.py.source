for p in old['products'].values():
    assert pin(p['path'])==p,p
    baseline[p['path']]=p

def record_product(before_path,after_path,raw,cap=CAP,allowed_regions=None):
    before_path=Path(before_path);before=before_path.read_bytes()
    data=dict(before=pin(before_path,before),after=pin(after_path,raw),exact_new_to_predecessor_fragment_inverse=inverse(before,raw))
    if before_path.suffix=='.py':
        compile(raw,str(after_path),'exec',dont_inherit=True)
        b,a=regions(before),regions(raw)
        changed=sorted(k for k in b.keys()|a.keys() if b.get(k)!=a.get(k))
        if allowed_regions is not None:assert set(changed)==set(allowed_regions),(str(before_path),changed)
        data.update(before_whole_UTF8_AST_sha256=ast_sha(before),after_whole_UTF8_AST_sha256=ast_sha(raw),changed_definition_regions=changed,all_other_function_class_AST_exact=True,before_definition_regions=b,after_definition_regions=a)
    sp=save(after_path,raw,cap)
    assert sp==data['after']
    records.append(data)
    return sp

