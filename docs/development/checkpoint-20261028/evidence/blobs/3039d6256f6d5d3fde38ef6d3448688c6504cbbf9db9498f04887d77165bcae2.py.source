        add('original_Source_inputs.' + role, pathlib.Path(f['path']), 'Inert bytes/data projections; never kernel compilation.')
    for rel, role in [
        ('input_snapshot_fixture015_different_Source_review_001/INDEPENDENT_I13_FIXTURE015_INPUT_NODE_READSET_SOURCE_CAPSULE_001.json', 'genuine_fixture015_316_review'),
        ('input_node_readset_ledger_protocol_different_Source_review_001/INDEPENDENT_I13_INPUT_NODE_READSET_LEDGER_PROTOCOL002_SOURCE_CAPSULE_001.json', 'genuine_ledger_protocol002_254_review'),
        ('causal_receipt_identity_protocol_different_review_001/INDEPENDENT_I13_CAUSAL_PARTIAL_PROTOCOL002_INTEGRITY_CAPSULE_001.json', 'genuine_causal002_109_integrity'),
        ('causal_receipt_identity_protocol_different_review_001/INDEPENDENT_I13_CAUSAL_PARTIAL_PROTOCOL001_INTEGRITY_REFUSAL_CAPSULE_001.json', 'prior001_causal_rank_bootstrap_refusal'),
        ('newcompactABI_assessment_001/INDEPENDENT_I13_COMPACT_ABI_NOT_READY_ASSESSMENT002_INTEGRITY_CAPSULE_001.json', 'genuine_NOT_READY_assessment002_64_integrity'),
        ('newcompactABI_assessment_001/INDEPENDENT_I13_COMPACT_ABI_NOT_READY_ASSESSMENT001_INTEGRITY_REFUSAL_CAPSULE_001.json', 'prior001_NOT_READY_selected_slot_refusal')]:
        p = O / rel
        add(role, p, 'Prior review/refusal preserved; no acceptance enlarged.')
        q = doc(p)
