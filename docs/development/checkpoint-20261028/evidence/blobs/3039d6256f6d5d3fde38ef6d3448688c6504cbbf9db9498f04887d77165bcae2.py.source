        add(role + '.full', pathlib.Path(q['full_proof']['path']), 'Complete existing proof, no rerun.')
    for p, role in [
        (C / 'ROOT_I13_INPUT_SNAPSHOT_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_001.json', 'old_snapshot_Source_adoption'),
        (O / 'ROOT_I13_FIXED_INPUT_NODE_LEDGER_PROTOCOL002_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json', 'ledger_protocol002_adoption'),
        (O / 'ROOT_I13_CAUSAL_RECEIPT_IDENTITY_PARTIAL_DESIGN002_INTEGRITY_ADOPTION_001.json', 'causal002_partial_integrity_only_adoption')]:
        add(role, p, 'Dated exact adoption with no new acquisition authority.')
    cd = A / 'causal_receipt_identity_protocol_design_001'
    for name in ['I13_PROPOSED_PORTABLE_EVENT_WHOLE_PIN_IDENTITIES_AND_ACYCLIC_ROSTERS_PARTIAL_PROTOCOL_002.json', 'I13_CAUSAL_EVENT_IDENTITY_EXACT_ROOT_GRAMMAR_PROPOSAL_002.json', 'I13_CAUSAL_EVENT_IDENTITY_PARTIAL_PROTOCOL002_IMMUTABLE_AUTHOR_FREEZE_001.json', 'I13_CAUSAL_IDENTITY_PROTOCOL002_COMPLETE_THREE001_PREDECESSOR_INVERSE_001.json', 'I13_PROPOSED_PORTABLE_EVENT_WHOLE_PIN_IDENTITIES_AND_ACYCLIC_ROSTERS_PARTIAL_PROTOCOL_001.json', 'I13_CAUSAL_EVENT_IDENTITY_EXACT_ROOT_GRAMMAR_PROPOSAL_001.json', 'I13_CAUSAL_EVENT_IDENTITY_PARTIAL_PROTOCOL001_IMMUTABLE_AUTHOR_FREEZE_001.json']:
        add('causal_history.' + name, cd / name, 'All11 NOT_READY cells survive; old bytes retained.')
    nd = A / 'compact_external_parent_contract_design_assessment_001'
    for name in ['I13_COMPACT_EXTERNAL_PARENT_AND_INDEXED_RECEIPT_ABI_NOT_READY_DESIGN_ASSESSMENT_PROPOSAL_002.json','I13_COMPACT_EXTERNAL_PARENT_AND_INDEXED_RECEIPT_ABI_NOT_READY_DESIGN_ASSESSMENT_PROPOSAL_001.json','I13_NOT_READY_DESIGN_ASSESSMENT002_SELECTED_SLOT_CLARIFICATION_COMPLETE001_INVERSE_FREEZE_001.json']:
        add('NOT_READY_history.'+name,nd/name,'Corrected assessment and complete prior001 history, no closed new ABI or fit claim.')
    for i in range(1, 4):
        p = C / 'owned_input_snapshot_runs' / ('attempt%03d' % i) / 'CHILD_RESULT_001.json'
        add('saved_consumed_snapshot%03d' % i, p, 'Exact ledger.graphs roster/size evidence, not raw-body availability or target trace.')
        add('saved_snapshot_Root_adoption%03d' % i, C / ('ROOT_I13_INPUT_SNAPSHOT%03d_DIFFERENT_SAVED_RESULT_ADOPTION_001.json' % i), 'Prior operation consumed; never replayed.')
    add('Root_new_exact_selection_plan', planpath, 'Metadata-only deterministic roster/partition plan, not capture.')
    for name in ['ROOT_I13_RAW_RETENTION_SELECTION_PLAN_STATIC_ARITHMETIC_PROOF_001.json','ROOT_I13_RAW_RETENTION_SELECTION_PLAN_AUTHOR_FREEZE_001.json','ROOT_I13_PARTITION_DERIVER002_COMPLETE001_INVERSE_AND_REFUSAL_001.json']:
        add('Root_selection_plan_history.'+name,planpath.parent/name,'Root metadata plan author evidence and retained first-deriver static refusal; not an acquisition or genuine different review.')
    # Duplicate roles may cite the same whole subject; keep one complete pin with all roles.
    unique = {}
    for row in basis:
        f = row['subject']
        if f['path'] in unique:
            need(unique[f['path']]['subject'] == f, 'basis pin conflict')
            unique[f['path']]['roles'].append(row['role'])
        else:
            unique[f['path']] = dict(subject=f, roles=[row['role']], use=row['use'])
    bp = save('I13_RAW_INPUT_RETENTION_COMPLETE_BASIS_AND_PRIOR_HISTORIES_001.json', dict(schema_version=1, record_type='I13_raw_retention_contract_exact_basis', author='/root/project_architecture', created_utc=fresh(), subjects=list(unique.values()), original_Source_inputs=freeze['Source_inputs'], both_prior001_refusal_histories_preserved=True, old_files_changed=False, target_execution=False, operational_authority=False, scientific_authority=False))
    text = raw(fixture).decode('utf8')
    tree = ast.parse(text)
    allowed = {'_ow_wire','_ow_json','_ow_time','_ow_ns','_ow_pin','_ow_pins','_ow_replace','_ow_descriptor','_ow_descriptor_keys','_fixed','_new_base','_fixture_make','_fp','_ld_need','_ld_fact','_ld_carrier'}
    regions = []
    def region(n, name):
        b = ''.join(text.splitlines(keepends=True)[n.lineno-1:n.end_lineno]).encode('utf8')
        calls = sorted({ast.unparse(x.func) for x in ast.walk(n) if isinstance(x, ast.Call)})
        regions.append(dict(symbol=name, line=n.lineno, end_line=n.end_lineno, UTF8_sha256=hashlib.sha256(b).hexdigest(), AST_sha256=hashlib.sha256(ast.dump(n, include_attributes=False).encode()).hexdigest(), call_expressions=calls))
    for n in tree.body:
        if isinstance(n, ast.FunctionDef) and n.name in allowed:
            region(n, n.name)
        elif isinstance(n, ast.ClassDef) and n.name in ('_Outer','_M3Build'):
            for m in n.body:
                if isinstance(m, ast.FunctionDef):
                    region(m, n.name + '.' + m.name)
    need(allowed <= {x['symbol'] for x in regions}, 'all helper regions')
    closure = dict(schema_version=1, record_type='I13_raw_retention_static_builder_call_boundary', author='/root/project_architecture', created_utc=fresh(), Source=fp, regions=regions,
        fixed_entry_spec="dict(stage=_LD_ROLES[role],selected_role=role,route='canonical'); no guard/phase_bound/peer/negative branch",
        transitive_boundary=['A NEW additive fixture successor must preserve the complete015 byte prefix, old definitions/top-level AST/936 rows/runners/seals, and append only a reviewed retention export/helpers. Old015 module and public exports are not imported/called.', '_ld_carrier reads exact ModuleType.__dict__ raw Source/API bytes+fact3, verifies fixed closed9 pins, and makes fresh data-only projections; never copy module functions/error classes/__getattr__/callbacks.', '_fixture_make uses _M3Build/_Outer local preserved builder code and scalar/data attributes only. _Outer.code reads raw Source/API bytes and API.author, never a kernel export.', '_M3Build.finish and _Outer.envelope detach built-in-only graphs. Preserve every FIXED/current Source/API/body/label; no graph rewrite, record omission, proof coalescing or new compression.', 'Future export selects existing whole row.body bytes after validating all records/pins/roster. It does not call old snapshot, _LDPlan, run*, _diagnostic_one, _fixture_edit, any encode/constructor/validator/peer/I0-I12/actual entry.', 'Expected strict type/value seals are FIXED,CASE_CATALOGUE,_LD_INPUTS,_LD_ROLES,_LD_SITE_IDS,_LD_META_EDGES,_LD_LEASE_EDGES,_LD_PROOF_EDGES plus all new fixed plan/schema constants. Seal before/after every graph and finally. No incoming carrier/held flag mutation.'],
        existing_snapshot_not_reused=dict(symbol='snapshot_I13_M3_input_node_ledger',line=1100,end_line=1132,reason='Old consumed operation returns count/readset only; NEW exporter will not call it.'),
        raw_point=dict(symbol='_fixture_make',line=499,end_line=508,records='bundle.records[*] closed {pin,body}; body exact builtin bytes'),
        roster_point=dict(symbol='snapshot_I13_M3_input_node_ledger',line=1120,end_line=1126,location='saved CHILD_RESULT.ledger.graphs[*].record_ledger'),
        counter_and_qualification='No target is compiled/called; no result54 or original50000 semantic counter is changed/evaluated. Transport JSON counting does not establish original semantic fit.',
        closure_status='EXACT_EXISTING_SOURCE_BOUNDARY_ONLY; FUTURE_EXPORT_SOURCE_AND_FULL_TRANSITIVE_CLOSURE_UNISSUED', target_execution=False, operational_authority=False, scientific_authority=False)
    clp = save('I13_RAW_INPUT_RETENTION_STATIC_BUILDER_AND_NO_TARGET_CALL_CLOSURE_001.json', closure)
    fields = {
      'schema_version':'builtin int exactly1', 'record_type':'I13_raw_input_retention_partition_transport_v1', 'operation':'DATA_ONLY_RAW_RECORD_RETENTION_V1', 'capture_id':'builtin str canonical lowercase UUID, exact future scope/claim label; never authority',
      'contract':'exact fixed whole contract fact3', 'schema':'exact fixed whole schema fact3', 'selection_plan':'exact Root plan fact3', 'partition_id':'exact selected fixed plan identifier', 'graph_id':'exact plan lowercase64hex', 'role':'one exact fixed6 role', 'stage':'exact fixed role-stage map', 'snapshot':'exact original accepted saved snapshot fact3', 'record_set_LF_fact3_sha256':'exact complete original ordered roster digest', 'graph_record_count':'exact original N<=256', 'graph_total_record_bytes':'exact original sum<=33554432', 'selected_ordinals':'exact nonempty plan ordinal list in original order', 'selected_fact3_LF_sha256':'exact canonical ordered selected-pin-list+LF digest', 'selected_raw_bytes':'exact sum,1..1048576', 'Source_inputs':'exact original closed9 fixed Source/API/catalogue/protocol/fixture_basis pins', 'records':'ordered nonempty rows matching selected ordinals exactly', 'limits':'exact closed limits below', 'global_seals_unchanged':'literal True or abort', 'metadata_only':'literal True', 'target_execution':'literal False', 'operational_authority':'literal False', 'native_Parser_executed':'literal False', 'scientific_authority':'literal False', 'actual_family_publication':'literal False', 'full_original_I2_DAG_closed':'literal False', 'authentic_loader_qualified':'literal False', 'compact_ABI_qualified':'literal False', 'validator_exports_called':'builtin int0', 'old_case_exports_called':'builtin int0'}
    limits = dict(record_count=256, rawbytes=33554432, perrecord=2097152, partition_rawbytes=1048576, output=2097152, header_bytes=65536, header_nodes=4096, source_node_guard=50000, depth=48)
    schemas = dict(schema_version=1, record_type='I13_prospective_raw_retention_closed_schema', author='/root/project_architecture', created_utc=fresh(), selection_plan=planpin,
      input=dict(signature='retain_I13_M3_input_record_partition(*,m3,publisher,peer,catalogue_bytes,selection_bytes,partition_id,capture_id)',
        module_carriers='exact ModuleType; only source/API raw builtin bytes and closed fact3 via __dict__; original closed9 fixed pins; no function/callback accepted', catalogue_bytes='builtin bytes exact original catalogue008 hash/length', selection_bytes='builtin strict JSON bytes exact original fixed Root plan raw hash/length,<=2MiB; preserve its original whitespace, never require or substitute a canonical reserialization', partition_id='exact builtin str selected fixed identifier; no arbitrary predicate/path/ordinal list', capture_id='canonical lowercase UUID from future exact Scope/claim; no authority'),
      selection_plan_exact_root_keys=fixed_keys(plan), selection_plan_shape='Exact whole fixed Root plan plus its closed graph/roster/partition schemas and all digest/budget invariants in contract; no replacement by caller views.',
      plan_graph_exact_keys=fixed_keys(plan['graphs'][0]),plan_roster_row_exact_keys=['ordinal','pin','labels'],plan_partition_exact_keys=fixed_keys(plan['graphs'][0]['partitions'][0]),
      primitive_rules=dict(fact3=dict(exact_keys=['path','bytes','sha256'],path='builtin str exactly fixed original spelling,1..512characters; no normalization/alias/case substitution',bytes='builtin int/nonbool,1..2097152',sha256='builtin str exactly64 lowercase ASCII hexadecimal'),ordinal='builtin int/nonbool,1..256',capture_id='builtin str36characters, lowercase8-4-4-4-12 hexadecimal UUID spelling; parsed/reformatted value identical; identity only',labels='ordered list builtin str aliases copied exactly from original graph; not authority',enums_and_bools='type is exactly builtin; no subclasses/equality callbacks; every consumed key exact builtin str',nullable_fields='None only where expressly allowed; none of success transport fields nullable',input_JSON='strictUTF8, no BOM,duplicatekeys,floats/nonfinite,surrogates; complete byte cap and wholepin before data use',all_input_data='detached builtin-only snapshot; no arbitrary callbacks, predicates, module getters or mutable authority objects'),
      output=dict(exact_keys=sorted(fields), fields=fields, row=dict(exact_keys=['ordinal','pin','encoding','body_base64'],ordinal='builtin int,nonbool, exact selected original1-based ordinal',pin='closed {path:str,bytes:int,sha256:str}; all3 exactly original graph pin',encoding='literal BASE64_RFC4648_CANONICAL',body_base64='builtin ASCII str; RFC4648 standard alphabet/padding; no whitespace; strict decode then reencode byte equality'),
        limits=limits, canonical_wire="UTF8 json.dumps(sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\\n'; exact wire roundtrip; no BOM/duplicate/unknown keys/floats/nonfinite/surrogates/bool counters/subclasses",
