"""Metadata author only. Never imports, compiles or calls a project module."""
import ast, datetime, hashlib, json, os, pathlib, sys

D = pathlib.Path(__file__).parent
R = D.parent
O = pathlib.Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
C = O / 'm3_peer_contracts_016'
T = C / 'i13'
A = C / 'm3_protocol_audit_001'
CAP = 2097152

def need(v, text):
    if not v:
        raise ValueError(text)

def raw(p):
    p = pathlib.Path(p)
    for q in (p, *p.parents):
        need(not q.is_symlink() and not (getattr(q.lstat(), 'st_file_attributes', 0) & 1024), 'ordinary lineage')
    a = p.stat()
    need(p.is_file() and a.st_nlink == 1 and 0 < a.st_size <= CAP, 'bounded metadata/source')
    b = p.read_bytes()
    z = p.stat()
    need((a.st_ino, a.st_size, a.st_mtime_ns) == (z.st_ino, z.st_size, z.st_mtime_ns) and len(b) == a.st_size, 'stable complete bytes')
    return b

def pin(p):
    b = raw(p)
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def pairs(rows):
    d = {}
    for k, v in rows:
        need(k not in d, 'duplicate JSON key')
        d[k] = v
    return d

def number(v):
    raise ValueError('noninteger/nonfinite metadata number')

def doc(p):
    return json.loads(raw(p).decode('utf8'), object_pairs_hook=pairs, parse_float=number, parse_constant=number)

S = R / 'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json'
SA = R / 'ROOT_I13_SOURCE_SCOPE007_DIFFERENT_REVIEW_ADOPTION_001.json'

def fresh():
    s, a = doc(S), doc(SA)
    need(pin(S)['sha256'] == 'e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5', 'Source007')
    need(pin(SA)['sha256'] == 'a517732dd0b4870e08381fb3ce31baa435385d6ae3e700dd2f014708df3a5969' and a['Source_scope'] == pin(S), 'Source007 adoption')
    now = datetime.datetime.now(datetime.timezone.utc)
    need(datetime.datetime.fromisoformat(s['interval_start']) <= now < datetime.datetime.fromisoformat(s['interval_end']) - datetime.timedelta(seconds=60), 'strict Source publication reserve')
    return now.isoformat(timespec='microseconds')

def save(name, value):
    p = D / name
    b = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf8')
    need(0 < len(b) <= CAP and not os.path.lexists(p), 'unused bounded output')
    fresh()
    with p.open('xb') as f:
        need(f.write(b) == len(b), 'whole write')
        f.flush()
        os.fsync(f.fileno())
    need(raw(p) == b, 'readback')
    return pin(p)

def fixed_keys(value):
    return sorted(value)

def canonical(value, ascii_only=False):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=ascii_only, allow_nan=False) + '\n').encode('utf8')

def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()

def verify_plan(plan, planpin):
    need(planpin['bytes'] == 452561 and planpin['sha256'] == '97fdb498e51580f3eb8bc30ad291d72d5b67fb254f3840128f0ee19e9dbd91e5', 'exact frozen Root plan')
    roles = [('capture_template','templates'),('metadata_manifest','manifest'),('plan','capture'),('capture_bound','capture'),('metadata_binding','capture'),('phase_binding','phase_binding')]
    need([(g['role'],g['stage']) for g in plan['graphs']] == roles, 'fixed six original namespaces')
    rows = partcount = rawsum = maxout = maxnodes = largest = 0
    for g in plan['graphs']:
        saved = doc(pathlib.Path(g['snapshot']['path']))
        need(pin(pathlib.Path(g['snapshot']['path'])) == g['snapshot'], 'saved snapshot whole pin')
        old = next(x for x in saved['ledger']['graphs'] if x['role'] == g['role'])
        need(g['record_roster'] == [{k:x[k] for k in ('ordinal','pin','labels')} for x in old['record_ledger']], 'complete saved ordinal/pin/label roster')
        roster = g['record_roster']; pins = [x['pin'] for x in roster]
        need([x['ordinal'] for x in roster] == list(range(1,len(roster)+1)), 'original1-based ordinal order')
        need(g['record_count'] == len(roster) <= 256 and g['total_record_bytes'] == sum(x['bytes'] for x in pins) <= 33554432, 'graph count/raw caps')
        need(g['record_set_LF_fact3_sha256'] == digest(pins), 'whole roster digest')
        need(g['graph_id'] == digest(dict(snapshot=g['snapshot'],role=g['role'],record_set_LF_fact3_sha256=g['record_set_LF_fact3_sha256'])), 'graph namespace digest')
        groups=[]; current=[]; size=0
        for x in roster:
            n=x['pin']['bytes'];need(type(n)is int and 0<n<=1048576,'whole member partition fit')
            if current and size+n>1048576:groups.append(current);current=[];size=0
            current.append(x);size+=n
        if current:groups.append(current)
        need([p['ordinals'] for p in g['partitions']] == [[x['ordinal'] for x in group] for group in groups], 'exact greedy whole-record partitions')
        for ordinal,(part,group) in enumerate(zip(g['partitions'],groups),1):
            selected=[x['pin'] for x in group]
            need(part['partition_id'] == g['graph_id']+'-part-%03d'%ordinal, 'fixed partition identifier')
            b64=sum(4*((x['bytes']+2)//3) for x in selected)
            empty=sum(len(canonical(dict(ordinal=x['ordinal'],pin=x['pin'],encoding='BASE64_RFC4648_CANONICAL',body_base64=''),True))-1 for x in group)
            upper=65536+empty+b64+max(len(group)-1,0);nodes=4096+15*len(group)
            need(part['rawbytes'] == sum(x['bytes'] for x in selected) <= 1048576 and part['row_count'] == len(group), 'partition raw count')
            need(part['selected_fact3_LF_sha256'] == digest(selected), 'selected digest')
            need(part['base64_character_count'] == b64 and part['canonical_empty_rows_size_upper_bound'] == empty, 'content-independent encoding arithmetic')
            need(part['transport_output_bytes_upper_bound'] == upper <= CAP and part['transport_tree_nodes_upper_bound'] == nodes < 50000, 'strict output/node upper bounds')
            partcount+=1;maxout=max(maxout,upper);maxnodes=max(maxnodes,nodes)
        rows+=len(roster);rawsum+=sum(x['bytes'] for x in pins);largest=max(largest,max(x['bytes'] for x in pins))
    need((rows,rawsum,partcount,largest,maxout,maxnodes) == (973,17399459,23,723621,1493609,6391), 'exact Root aggregate arithmetic')
    return dict(graph_count=6,logical_record_occurrences=rows,total_rawbytes=rawsum,partition_count=partcount,largest_member_bytes=largest,maximum_output_upper_bound=maxout,maximum_transport_node_upper_bound=maxnodes,raw_bodies_read_or_constructed=False)

def main():
    need(len(sys.argv) == 2, 'exact Root selection plan path')
    planpath = pathlib.Path(sys.argv[1])
    need(planpath.is_relative_to(R / 'retention_selection_plan_001'), 'Root-owned plan only')
    plan = doc(planpath)
    planpin = pin(planpath)
    plancheck = verify_plan(plan, planpin)
    basis = []
    def add(role, p, use):
        f = pin(p)
        if str(p).endswith('.json'):
            doc(p)
        basis.append(dict(role=role, subject=f, use=use))
        return f
    add('Source007', S, 'Current contract preparation scheduling only.')
