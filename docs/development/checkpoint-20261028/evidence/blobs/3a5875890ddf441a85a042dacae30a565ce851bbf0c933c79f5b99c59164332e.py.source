"""Preserve complete failed reviewer001 bytes and create reviewer002 only."""
import base64
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path
R=Path(__file__).parent
CAP=2097152
def need(v,m):
 if not v:raise ValueError(m)
def raw(p):
 for q in(p,*p.parents):
  s=q.lstat();need(not stat.S_ISLNK(s.st_mode)and not getattr(s,'st_file_attributes',0)&1024,'nonreparse')
 a=p.stat();need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and a.st_size<=CAP,'bounded singlelink')
 with p.open('rb')as h:
  d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns,x.st_ctime_ns,getattr(x,'st_file_attributes',0))
 need(key(a)==key(d)==key(e)==key(z)and len(b)==a.st_size,'stable whole buffer');return b
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def save(p,b):
 need(p.parent==R and len(b)<=CAP,'own bounded file');need(dt.datetime.now(dt.timezone.utc)<dt.datetime(2026,10,28,9,59,tzinfo=dt.timezone.utc),'currentSource013 strict60')
 with p.open('xb')as h:need(h.write(b)==len(b),'wholeCreateNew');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'whole readback');return fact(p,b)
