CHECKS=[]
def sha(b):return hashlib.sha256(b).hexdigest()
def fact(p):
    b=Path(p).read_bytes();return dict(path=str(p),bytes=len(b),sha256=sha(b))
def ck(n,v,e):
    if any(c['name']==n for c in CHECKS):raise ValueError('duplicate check name')
    CHECKS.append(dict(name=n,passed=v is True,evidence=e))
def pairs(items):
    out={}
    for k,v in items:
        if k in out:raise ValueError('duplicate key')
        out[k]=v
    return out
def bad(v):raise ValueError('float/nonfinite')
def strict(b):
    s=b.decode('utf-8','strict')
    if s.startswith('\ufeff'):raise ValueError('BOM')
    v=json.loads(s,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    def tree(x):
        if type(x) is str:
            if any(55296<=ord(c)<=57343 for c in x):raise ValueError('surrogate')
        elif type(x) is dict:
            for k,w in x.items():tree(k);tree(w)
        elif type(x) is list:
            for w in x:tree(w)
        elif x is not None and type(x) not in (bool,int):raise ValueError('type')
    tree(v);return v
def pinread(pin,name):
    b=Path(pin['path']).read_bytes();ck(name,fact(pin['path'])==pin,pin);return b
def src(pin,name):
    b=pinread(pin,name+'.pin');s=b.decode('utf-8');t=ast.parse(s,filename=pin['path']);compile(t,pin['path'],'exec');ck(name+'.AST_compile_only',True,'No code object evaluated.');return b,s,t
def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def methods(t,c):return {n.name:n for n in defs(t)[c].body if isinstance(n,ast.FunctionDef)}
def meth(t,c,n):return methods(t,c)[n]
def dump(n):return ast.dump(n,include_attributes=False)
def txt(n):return ast.unparse(n)
def segment(s,n):return ast.get_source_segment(s,n)
def frag(n,label,items):
    for key,value in items:ck(label+'.'+key,value in txt(n),value)
def constants(t):
    env={}
    def lit(n):
        if isinstance(n,ast.Name):return env[n.id]
        if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='frozenset' and len(n.args)==1 and not n.keywords:return frozenset(lit(n.args[0]))
        if isinstance(n,ast.BinOp) and isinstance(n.op,ast.BitOr):return lit(n.left)|lit(n.right)
        return ast.literal_eval(n)
    for n in t.body:
        if isinstance(n,ast.Assign) and all(isinstance(x,ast.Name) for x in n.targets):
            try:v=lit(n.value)
            except (ValueError,KeyError,TypeError):continue
            for x in n.targets:env[x.id]=v
    return env
def unchanged(old,new,label,allowed_top,allowed_methods):
    od,nd=defs(old),defs(new)
    for name,n in od.items():
        if isinstance(n,ast.ClassDef) and name in allowed_methods:
            before,after=methods(old,name),methods(new,name)
            for mn,node in before.items():
                if mn not in allowed_methods[name]:ck(label+'.protected_method.'+name+'.'+mn,mn in after and dump(node)==dump(after[mn]),dict(before=node.lineno,after=after[mn].lineno))
        elif name not in allowed_top:ck(label+'.protected_definition.'+name,name in nd and dump(n)==dump(nd[name]),name)
def save(p,v):
    b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
    if len(b)>2097152:raise ValueError('cap')
    with p.open('xb') as h:h.write(b)

