class I13RawRetentionSupervisorError(ValueError):
    def __init__(self, code):
        if type(code) is not str or code not in ERROR_CODES:
            code = 'E_RETENTION_CUSTODY'
        self.code = code
        super().__init__(code)


def _need(value, code='E_RETENTION_CUSTODY'):
    if not value:
        raise I13RawRetentionSupervisorError(code)


def _activation_required():
    raise I13RawRetentionSupervisorError('E_RETENTION_AUTHORITY')


def supervise_I13_raw_retention_once(*, request_bytes, admission_bytes):
    raise I13RawRetentionSupervisorError('E_RETENTION_AUTHORITY')


def main():
    raise I13RawRetentionSupervisorError('E_RETENTION_AUTHORITY')


def _wire(value):
    try:
        return (json.dumps(value, sort_keys=True, separators=(',', ':'),
                           ensure_ascii=False, allow_nan=False) + '\n').encode('utf8')
    except (ValueError, TypeError, UnicodeError, RecursionError):
        raise I13RawRetentionSupervisorError('E_RETENTION_JSON') from None


def _tree(value, depth=0):
    _need(depth <= 48, 'E_RETENTION_OUTPUT_CAP')
    t = type(value)
    if t is dict:
        _need(all(type(k) is str for k in value), 'E_RETENTION_JSON')
        for k in value:
            k.encode('utf8', 'strict')
        count = 1 + len(value)
        for item in value.values():
            count += _tree(item, depth + 1)
            _need(count <= 50000, 'E_RETENTION_OUTPUT_CAP')
        return count
    if t is list:
        count = 1
        for item in value:
            count += _tree(item, depth + 1)
            _need(count <= 50000, 'E_RETENTION_OUTPUT_CAP')
        return count
    _need(t in (str, int, bool, type(None)), 'E_RETENTION_JSON')
    if t is str:
        value.encode('utf8', 'strict')
    return 1


def _decode(raw, canonical=False):
    _need(type(raw) is bytes and 0 < len(raw) <= MAX_BYTES, 'E_RETENTION_JSON')
    def pairs(rows):
        out = {}
        for k, v in rows:
            _need(k not in out, 'E_RETENTION_JSON')
            out[k] = v
        return out
    def number(value):
        raise I13RawRetentionSupervisorError('E_RETENTION_JSON')
    try:
        value = json.loads(raw.decode('utf8', 'strict'), object_pairs_hook=pairs,
                           parse_float=number, parse_constant=number)
        _tree(value)
        if canonical:
            _need(_wire(value) == raw, 'E_RETENTION_JSON')
        return value
    except I13RawRetentionSupervisorError:
        raise
    except (UnicodeError, ValueError, RecursionError):
        raise I13RawRetentionSupervisorError('E_RETENTION_JSON') from None


def _closed(value, keys):
    return type(value) is dict and all(type(k) is str for k in value) and set(value) == set(keys)


def _same(actual, expected):
    if type(actual) is not type(expected):
        return False
    if type(expected) is dict:
        return _closed(actual, expected) and all(_same(actual[k],v) for k,v in expected.items())
    if type(expected) is list:
        return len(actual) == len(expected) and all(_same(a,b) for a,b in zip(actual,expected))
    return actual == expected


def _fact(value, allow_empty=False):
    _need(_closed(value, ('path', 'bytes', 'sha256')), 'E_RETENTION_SOURCE_BINDING')
    _need(type(value['path']) is str and 0 < len(value['path']) <= 512 and
          type(value['bytes']) is int and (0 if allow_empty else 1) <= value['bytes'] <= MAX_BYTES and
          type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}', value['sha256']) is not None,
          'E_RETENTION_SOURCE_BINDING')


def _pin(path, raw):
    _need(type(raw) is bytes and len(raw) <= MAX_BYTES, 'E_RETENTION_OUTPUT_CAP')
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def _uuid(value):
    _need(type(value) is str and re.fullmatch('[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}', value) is not None,
          'E_RETENTION_CAPTURE_ID')
    _need(str(uuid.UUID(value)) == value, 'E_RETENTION_CAPTURE_ID')


def _plan(raw):
    _need(type(raw) is bytes and _pin(FIXED['selection_plan']['path'], raw) == FIXED['selection_plan'],
          'E_RETENTION_SELECTION_PIN')
    plan = _decode(raw)
    _need(_closed(plan, FIXED['plan_root_keys']), 'E_RETENTION_SELECTION_SCHEMA')
    _need(plan['Source_inputs'] == FIXED['Source_inputs'] and
          type(plan['graphs']) is list and len(plan['graphs']) == 6 and
          plan['partition_count'] == 23, 'E_RETENTION_SELECTION_SCHEMA')
    # Exact whole raw pin above fixes every roster/label/partition/digest and its
    # dated Source007 provenance. It is never used as current scheduling.
    return plan


def _partition(plan, partition_id):
    _need(type(partition_id) is str, 'E_RETENTION_PARTITION')
    found = [(g, p) for g in plan['graphs'] for p in g['partitions']
             if p['partition_id'] == partition_id]
    _need(len(found) == 1, 'E_RETENTION_PARTITION')
    return found[0]


def _check_API(api_raw):
    _need(_pin(FIXED['exporter_API']['path'], api_raw) == FIXED['exporter_API'],
          'E_RETENTION_SOURCE_BINDING')
    api = _decode(api_raw)
    _need(_closed(api, FIXED['API_required_keys']), 'E_RETENTION_SOURCE_BINDING')
    _need(api['Source'] == FIXED['exporter_Source'] and
          api['previous_fixture_Source'] == FIXED['previous_fixture_Source'] and
          api['contract'] == FIXED['contract'] and api['schema'] == FIXED['schema'] and
          api['selection_plan'] == FIXED['selection_plan'] and
          api['Source_inputs'] == FIXED['Source_inputs'] and
          api['error_class'] == FIXED['API_error_class'] and
          api['limits'] == FIXED['API_limits'], 'E_RETENTION_SOURCE_BINDING')
    for k, v in FIXED['API_literals'].items():
        _need(_same(api[k], v), 'E_RETENTION_SOURCE_BINDING')
    return api


def _transport(raw, plan, partition_id, capture_id):
    value = _decode(raw, canonical=True)
    _need(_closed(value, FIXED['transport_keys']), 'E_RETENTION_JSON')
    graph, part = _partition(plan, partition_id)
    _uuid(capture_id)
    exact = dict(schema_version=1, record_type='I13_raw_input_retention_partition_transport_v1',
        operation='DATA_ONLY_RAW_RECORD_RETENTION_V1', capture_id=capture_id,
        contract=FIXED['contract'], schema=FIXED['schema'], selection_plan=FIXED['selection_plan'],
        partition_id=partition_id, graph_id=graph['graph_id'], role=graph['role'], stage=graph['stage'],
        snapshot=graph['snapshot'], record_set_LF_fact3_sha256=graph['record_set_LF_fact3_sha256'],
        graph_record_count=graph['record_count'], graph_total_record_bytes=graph['total_record_bytes'],
        selected_ordinals=part['ordinals'], selected_fact3_LF_sha256=part['selected_fact3_LF_sha256'],
        selected_raw_bytes=part['rawbytes'], Source_inputs=FIXED['Source_inputs'], limits=FIXED['transport_limits'],
        metadata_only=True, global_seals_unchanged=True, target_execution=False,
        operational_authority=False, native_Parser_executed=False, scientific_authority=False,
        actual_family_publication=False, full_original_I2_DAG_closed=False,
        authentic_loader_qualified=False, compact_ABI_qualified=False,
        validator_exports_called=0, old_case_exports_called=0)
    for k, expected in exact.items():
        _need(_same(value[k], expected), 'E_RETENTION_ROSTER')
    records = value['records']
    _need(type(records) is list and 0 < len(records) == len(part['ordinals']) <= 256,
          'E_RETENTION_RECORD')
    pins = []
    rawsum = 0
    for ordinal, row in zip(part['ordinals'], records):
        _need(_closed(row, ('ordinal', 'pin', 'encoding', 'body_base64')),
              'E_RETENTION_RECORD')
        expected = graph['record_roster'][ordinal - 1]['pin']
        _fact(row['pin'])
        _need(type(row['ordinal']) is int and row['ordinal'] == ordinal and
              row['pin'] == expected and type(row['encoding']) is str and
              row['encoding'] == 'BASE64_RFC4648_CANONICAL' and type(row['body_base64']) is str,
              'E_RETENTION_RECORD')
        text = row['body_base64']
        _need(len(text) == 4 * ((expected['bytes'] + 2) // 3), 'E_RETENTION_BASE64')
        try:
            body = base64.b64decode(text.encode('ascii', 'strict'), validate=True)
        except (ValueError, UnicodeError):
            raise I13RawRetentionSupervisorError('E_RETENTION_BASE64') from None
        _need(base64.b64encode(body).decode('ascii') == text and
              _pin(expected['path'], body) == expected, 'E_RETENTION_DIGEST')
        # Arbitrary original bytes remain opaque: never JSON parse, execute,
        # normalize or write any per-record original virtual path.
        rawsum += len(body)
        pins.append(expected)
    _need(rawsum == part['rawbytes'] and rawsum <= 1048576 and
          hashlib.sha256(_wire(pins)).hexdigest() == part['selected_fact3_LF_sha256'],
          'E_RETENTION_DIGEST')
    header = dict(value)
    header['records'] = []
    _need(len(_wire(header)) <= 65536 and _tree(header) <= 4096 and
          len(raw) <= part['transport_output_bytes_upper_bound'] <= MAX_BYTES and
          _tree(value) <= part['transport_tree_nodes_upper_bound'] <= 50000,
          'E_RETENTION_OUTPUT_CAP')
    return value


def _ordinary(path, existing=True):
    _activation_required()
    p = Path(path)
    _need(p.is_absolute() and '..' not in p.parts, 'E_RETENTION_CUSTODY')
    for q in p.parents:
        s = q.lstat()
        _need(q.is_dir() and not q.is_symlink() and not getattr(s, 'st_file_attributes', 0) & 1024)
    if existing:
        s = p.lstat()
        _need(stat.S_ISREG(s.st_mode) and s.st_nlink == 1 and not p.is_symlink() and
              not getattr(s, 'st_file_attributes', 0) & 1024)
    return p


def _read_bound(expected):
    _activation_required()
    _fact(expected, allow_empty=True)
    p = _ordinary(expected['path'])
    before = p.stat()
    with p.open('rb') as h:
        fd0 = os.fstat(h.fileno())
        first = h.read(MAX_BYTES + 1)
        h.seek(0)
        second = h.read(MAX_BYTES + 1)
        fd1 = os.fstat(h.fileno())
    after = p.stat()
    identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns)
    own = lambda s: identity(s) + (s.st_ctime_ns,)
    _need(own(before) == own(after) and own(fd0) == own(fd1) and
          identity(before) == identity(fd0) == identity(after) and first == second and
          _pin(p, first) == expected, 'E_RETENTION_SOURCE_BINDING')
    return first


def _date(value):
    _need(type(value) is str,'E_RETENTION_AUTHORITY')
    try:
        result=dt.datetime.fromisoformat(value)
    except (ValueError,TypeError):
        raise I13RawRetentionSupervisorError('E_RETENTION_AUTHORITY') from None
    _need(result.tzinfo is not None,'E_RETENTION_AUTHORITY')
    return result


def _claim_present(path):
    _activation_required()
    return os.path.lexists(path)


def _check_time(source_end, operation_end, deadline, reserve=True):
    now = dt.datetime.now(dt.timezone.utc)
    for end in (_date(source_end), _date(operation_end)):
        _need(end.tzinfo is not None and (end - now).total_seconds() > (60 if reserve else 0),
              'E_RETENTION_AUTHORITY')
    _need(time.monotonic() < deadline, 'E_RETENTION_CUSTODY')


def _write_owned(path, body, source_end, operation_end, deadline):
    _activation_required()
    _need(type(body) is bytes and len(body) <= MAX_BYTES, 'E_RETENTION_OUTPUT_CAP')
    p = _ordinary(path, existing=False)
    _need(p.is_relative_to(OWNED_ROOT) or p.is_relative_to(CLAIM_ROOT))
    _need(not os.path.lexists(p), 'E_RETENTION_CONSUMED')
    _check_time(source_end, operation_end, deadline)
    with p.open('xb') as h:
        _need(h.write(body) == len(body))
        h.flush()
        os.fsync(h.fileno())
    expected = _pin(p, body)
    _need(_read_bound(expected) == body)
    return expected


def _logical_key(partition_id):
    # capture UUID and scope wrapper deliberately excluded: neither permits replay.
    return hashlib.sha256(_wire(dict(operation='DATA_ONLY_RAW_RECORD_RETENTION_V1',
        exporter_Source=FIXED['exporter_Source'], exporter_API=FIXED['exporter_API'],
        selection_plan=FIXED['selection_plan'], partition_id=partition_id))).hexdigest()


def _admission(request_bytes, admission_bytes):
    # Pure, dormant schema validation; no current token or mutable flag activates
    # this Source. All effects separately meet _activation_required first.
    request = _decode(request_bytes)
    admission = _decode(admission_bytes)
    _need(_closed(request, ('capture_id', 'partition_id', 'selection_plan')),
          'E_RETENTION_AUTHORITY')
    _uuid(request['capture_id'])
    _need(request['selection_plan'] == FIXED['selection_plan'], 'E_RETENTION_SELECTION_PIN')
    keys = ('schema_version','record_type','author','operation','capture_id','partition_id',
        'maximum_invocations','contract','schema','selection_plan','exporter_Source','exporter_API',
        'supervisor_Source','Source_scope','Source_adoption','protocol_adoption','prelaunch',
        'runtime_interpreter','interval_start','interval_end','outputs','budgets',
        'new_raw_retention_operation_admitted') + AUTHORITY_FLAGS
    _need(_closed(admission, keys), 'E_RETENTION_AUTHORITY')
    exact = dict(schema_version=1, record_type='Root_I13_exact_once_raw_retention_admission',
        author='/root', operation='DATA_ONLY_RAW_RECORD_RETENTION_V1', capture_id=request['capture_id'],
        partition_id=request['partition_id'], maximum_invocations=1, contract=FIXED['contract'],
        schema=FIXED['schema'], selection_plan=FIXED['selection_plan'],
        exporter_Source=FIXED['exporter_Source'], exporter_API=FIXED['exporter_API'],
        budgets=BUDGETS, new_raw_retention_operation_admitted=True)
    for k, value in exact.items():
        _need(_same(admission[k], value), 'E_RETENTION_AUTHORITY')
    _need(all(admission[k] is False for k in AUTHORITY_FLAGS), 'E_RETENTION_AUTHORITY')
    for k in ('supervisor_Source','Source_scope','Source_adoption','protocol_adoption',
              'prelaunch','runtime_interpreter'):
        _fact(admission[k])
    _need(_closed(admission['outputs'], OUTPUT_NAMES), 'E_RETENTION_CUSTODY')
    now = dt.datetime.now(dt.timezone.utc)
    start = _date(admission['interval_start'])
    end = _date(admission['interval_end'])
    _need(start.tzinfo is not None and end.tzinfo is not None and start <= now and
          (end-now).total_seconds() > 60, 'E_RETENTION_AUTHORITY')
    return request, admission


def _prelaunch(admission,deadline):
    _activation_required()
    # Future activated Source MUST retain all exact provenance joins. Source008
    # and this supervisor can never satisfy raw_capture_admitted=True.
    scope = _decode(_read_bound(admission['Source_scope']))
    adopt = _decode(_read_bound(admission['Source_adoption']))
    protocol = _decode(_read_bound(admission['protocol_adoption']))
    pre = _decode(_read_bound(admission['prelaunch']))
    _need(scope.get('author') == '/root' and scope.get('raw_capture_admitted') is True and
          all(scope.get(k) is False for k in ('target_execution','operational_authority','scientific_authority')),
          'E_RETENTION_AUTHORITY')
    _need(adopt.get('author') == '/root' and adopt.get('retention_Source_qualified') is True and
          all(adopt.get(k) is False for k in ('target_execution','operational_authority','scientific_authority')),
          'E_RETENTION_AUTHORITY')
    _need(protocol.get('author') == '/root' and
          protocol.get('operation') == 'DATA_ONLY_RAW_RECORD_RETENTION_V1' and
          protocol.get('capture_protocol_adopted') is True, 'E_RETENTION_AUTHORITY')
    for record in (adopt, protocol):
        for key in ('contract','schema','selection_plan'):
            _need(_same(record.get(key),FIXED[key]),'E_RETENTION_AUTHORITY')
    _need(adopt.get('Source_scope') == admission['Source_scope'] and
          type(adopt.get('qualified_subjects')) is list and
          all(any(_same(v,p) for v in adopt['qualified_subjects']) for p in
              (FIXED['exporter_Source'],FIXED['exporter_API'],admission['supervisor_Source'])),
          'E_RETENTION_AUTHORITY')
    expected = dict(record_type='Root_I13_raw_retention_fresh_native_prelaunch',
        author='/root', Source_scope=admission['Source_scope'], Source_adoption=admission['Source_adoption'],
        supervisor_Source=admission['supervisor_Source'], exporter_Source=FIXED['exporter_Source'],
        exporter_API=FIXED['exporter_API'], capture_id=admission['capture_id'],
        partition_id=admission['partition_id'], peer_resource_constraints_current=True,
        peer_result_accepted=False, target_execution=False, operational_authority=False,
        scientific_authority=False)
    for k,v in expected.items():
        _need(k in pre and type(pre[k]) is type(v) and pre[k] == v, 'E_RETENTION_AUTHORITY')
    observed = _date(pre['observed_utc'])
    now = dt.datetime.now(dt.timezone.utc)
    _need(observed.tzinfo is not None and 0 <= (now-observed).total_seconds() <= 60 and
          type(pre['available_RAM_bytes']) is int and pre['available_RAM_bytes'] >= 1073741824 and
          type(pre['disk_free_bytes']) is int and pre['disk_free_bytes'] >= 10737418240,
          'E_RETENTION_AUTHORITY')
    # These are pinned genuine external native witnesses, never synthesized here.
    for key in ('native_resource_witness','current_peer_constraints','prelaunch_Root_adoption'):
        _fact(pre[key])
        _read_bound(pre[key])
    own = _read_bound(admission['supervisor_Source'])
    _need(Path(admission['supervisor_Source']['path']) == Path(__file__) and
          hashlib.sha256(own).hexdigest() == admission['supervisor_Source']['sha256'])
    runtime = admission['runtime_interpreter']
    _need(runtime['path'] == sys.executable and
          runtime['path'] == r'C:\Users\aladdin-alyanai\.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe',
          'E_RETENTION_AUTHORITY')
    _read_bound(runtime)
    _need(_date(scope['interval_start']) <= dt.datetime.now(dt.timezone.utc), 'E_RETENTION_AUTHORITY')
    _check_time(scope['interval_end'], admission['interval_end'], deadline)
    return scope, pre


def _effect_namespace(admission):
    _activation_required()
    outputs = admission['outputs']
    _need(all(type(v) is str for v in outputs.values()))
    paths = {k:Path(v) for k,v in outputs.items()}
    _need(len({str(p).casefold() for p in paths.values()}) == len(OUTPUT_NAMES))
    claim = CLAIM_ROOT / (_logical_key(admission['partition_id']) + '.json')
    _need(paths['claim'] == claim, 'E_RETENTION_CONSUMED')
    parent = paths['transport'].parent
    _need(parent.parent == OWNED_ROOT and parent.name == admission['capture_id'])
    for key,p in paths.items():
        _ordinary(p, existing=False)
        _need((p == claim if key == 'claim' else p.parent == parent) and not os.path.lexists(p),
              'E_RETENTION_CONSUMED')
    return paths


