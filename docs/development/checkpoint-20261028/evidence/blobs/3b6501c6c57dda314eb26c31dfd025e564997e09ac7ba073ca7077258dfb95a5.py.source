def _child_input(admission):
    _activation_required()
    plan_raw = _read_bound(FIXED['selection_plan'])
    _plan(plan_raw)
    api_raw = _read_bound(FIXED['exporter_API'])
    _check_API(api_raw)
    source_raw = _read_bound(FIXED['exporter_Source'])
    _need(source_raw.startswith(_read_bound(FIXED['previous_fixture_Source'])))
    sources = {name:_read_bound(pin) for name,pin in FIXED['Source_inputs'].items()
               if name.endswith('_Source') or name.endswith('_API')}
    packed = dict(schema_version=1, fixture=base64.b64encode(source_raw).decode('ascii'),
        fixture_pin=FIXED['exporter_Source'], Source_inputs=FIXED['Source_inputs'],
        sources={k:base64.b64encode(v).decode('ascii') for k,v in sources.items()},
        catalogue=base64.b64encode(_read_bound(FIXED['Source_inputs']['catalogue'])).decode('ascii'),
        selection=base64.b64encode(plan_raw).decode('ascii'), capture_id=admission['capture_id'],
        partition_id=admission['partition_id'])
    raw = _wire(packed)
    _need(len(raw) <= MAX_BYTES, 'E_RETENTION_OUTPUT_CAP')
    return raw


def _owned_child(runtime, entry_path, input_path, input_pin, deadline):
    _activation_required()
    _fact(input_pin)
    command = [runtime['path'], '-I', '-S', '-B', str(entry_path), str(input_path), input_pin['sha256']]
    proc = None
    streams = {'stdout':bytearray(), 'stderr':bytearray()}
    state = {'stdout_eof':False,'stderr_eof':False,'error':False,'cap':False}
    readers = []
    errors = []
    def drain(name, pipe):
        _activation_required()
        try:
            while True:
                chunk = pipe.read(65536)
                if not chunk:
                    state[name+'_eof'] = True
                    break
                remain = MAX_BYTES-len(streams[name])
                streams[name].extend(chunk[:max(remain,0)])
                if len(chunk)>remain:
                    state['cap'] = True
                    # Drain to EOF during owned cleanup, retaining only the cap.
        except BaseException:
            state['error'] = True
        finally:
            pipe.close()
    launch = dt.datetime.now(dt.timezone.utc).isoformat()
    start = time.monotonic()
    timed_out = False
    killed = False
    try:
        proc = subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,shell=False,creationflags=getattr(subprocess,'CREATE_NO_WINDOW',0))
        for name,pipe in (('stdout',proc.stdout),('stderr',proc.stderr)):
            t=threading.Thread(target=drain,args=(name,pipe),daemon=True)
            readers.append(t);t.start()
        # <=50 original wait cap; reserve10cleanup plus5evidence within60total.
        wait_end=min(start+45,deadline-15)
        while proc.poll() is None and time.monotonic()<wait_end:
            if state['cap'] or state['error']:
                break
            time.sleep(min(0.02,max(0,wait_end-time.monotonic())))
        timed_out=proc.poll() is None and not state['cap'] and not state['error']
    except BaseException as exc:
        errors.append(type(exc).__name__[:128])
    finally:
        cleanup_end=min(start+55,deadline-5)
        if proc is not None:
            try:
                if proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=min(5,max(0.001,cleanup_end-time.monotonic())))
                    except subprocess.TimeoutExpired:
                        proc.kill();killed=True
                if proc.poll() is None:
                    proc.wait(timeout=min(5,max(0.001,cleanup_end-time.monotonic())))
            except BaseException as exc:
                errors.append(type(exc).__name__[:128])
            for t in readers:
                t.join(timeout=max(0,cleanup_end-time.monotonic()))
    reaped=proc is not None and proc.poll() is not None
    complete=(reaped and all(not t.is_alive() for t in readers) and
        state['stdout_eof'] and state['stderr_eof'] and not state['cap'] and
        not state['error'] and not timed_out and not errors and time.monotonic()<=deadline)
    custody=dict(owned_pid=proc.pid if proc is not None else None,command=command,
        launch_utc=launch,end_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
        returncode=proc.returncode if proc is not None else None,reaped=reaped,
        stdout_eof=state['stdout_eof'],stderr_eof=state['stderr_eof'],
        cap_violation=state['cap'],drain_error=state['error'],timed_out=timed_out,
        cleanup_errors=errors,kill_used=killed,reader_threads_closed=all(not t.is_alive() for t in readers),
        custody_complete=complete,elapsed_seconds_text=format(time.monotonic()-start,'.9f'),
        budgets=BUDGETS,whole_host_quiet_claimed=False,physical_handle_absence_claimed=False,
        original_target_or_kernel_called=False)
    # Return retained bounded streams and all failed custody facts too; never
    # discard them behind a passing/error Boolean or retry the consumed claim.
    return bytes(streams['stdout']),bytes(streams['stderr']),custody


def _failure(admission, graph_id, step, code, exception_type, transport_created):
    value = dict(schema_version=1, record_type='I13_raw_input_retention_supervisor_failure_v1',
        capture_id=admission['capture_id'], selection_plan=FIXED['selection_plan'],
        partition_id=admission['partition_id'], graph_id=graph_id, status='FAILED',
        step=step, error_code=code, exception_type=exception_type,
        message=code, transport_created=transport_created,
        target_execution=False, operational_authority=False, scientific_authority=False)
    _need(_closed(value, FIXED['failure_keys']))
    return _wire(value)


def _dormant_acquire(*, request_bytes, admission_bytes):
    _activation_required()
    # Complete admitted-operation timer includes input/Source/resource checks.
    deadline = time.monotonic()+60
    request, admission = _admission(request_bytes, admission_bytes)
    scope, pre = _prelaunch(admission,deadline)
    paths = _effect_namespace(admission)
    plan = _plan(_read_bound(FIXED['selection_plan']))
    graph, part = _partition(plan, admission['partition_id'])
    claim = dict(schema_version=1, record_type='Root_I13_raw_retention_exclusive_once_claim',
        operation='DATA_ONLY_RAW_RECORD_RETENTION_V1', logical_key=_logical_key(admission['partition_id']),
        capture_id=admission['capture_id'], partition_id=admission['partition_id'],
        exporter_Source=FIXED['exporter_Source'], exporter_API=FIXED['exporter_API'],
        selection_plan=FIXED['selection_plan'], supervisor_Source=admission['supervisor_Source'],
        created_utc=dt.datetime.now(dt.timezone.utc).isoformat(), automatic_retry_permitted=False)
    claim_pin = None
    claim_present_after_error = None
    step = 'CLAIM_CREATION'
    transport_created = False
    evidence = {}
    custody = None
    try:
        claim_pin = _write_owned(paths['claim'],_wire(claim),scope['interval_end'],admission['interval_end'],deadline)
        step = 'CLAIMED'
        child_input = _child_input(admission)
        for key,body in (('child_entry',CHILD_SOURCE.encode('utf8')),('child_input',child_input)):
            evidence[key] = _write_owned(paths[key],body,scope['interval_end'],admission['interval_end'],deadline)
        step = 'CHILD_PREPARED'
        # Recheck the SAME pinned native prelaunch at the actual launch
        # boundary. A stale observation refuses; no inferred refresh.
        scope, pre = _prelaunch(admission,deadline)
        _check_time(scope['interval_end'],admission['interval_end'],deadline)
        stdout,stderr,custody = _owned_child(admission['runtime_interpreter'],paths['child_entry'],paths['child_input'],evidence['child_input'],deadline)
        step = 'CHILD_REAPED_DRAINED'
        for key,body in (('stdout',stdout),('stderr',stderr)):
            evidence[key] = _write_owned(paths[key],body,scope['interval_end'],admission['interval_end'],deadline)
        _need(custody['custody_complete'] is True and custody['returncode'] == 0 and stderr == b'', 'E_RETENTION_CUSTODY')
        _transport(stdout,plan,admission['partition_id'],admission['capture_id'])
        evidence['transport'] = _write_owned(paths['transport'],stdout,scope['interval_end'],admission['interval_end'],deadline)
        transport_created = True
        _transport(_read_bound(evidence['transport']),plan,admission['partition_id'],admission['capture_id'])
        witness = dict(schema_version=1,record_type='Root_I13_raw_retention_owned_parent_witness',
            capture_id=admission['capture_id'],partition_id=admission['partition_id'],graph_id=graph['graph_id'],
            Source_scope=admission['Source_scope'],Source_adoption=admission['Source_adoption'],
            protocol_adoption=admission['protocol_adoption'],supervisor_Source=admission['supervisor_Source'],
            exporter_Source=FIXED['exporter_Source'],exporter_API=FIXED['exporter_API'],
            contract=FIXED['contract'],schema=FIXED['schema'],selection_plan=FIXED['selection_plan'],
            prelaunch=admission['prelaunch'],runtime_interpreter=admission['runtime_interpreter'],
            claim=claim_pin,evidence=evidence,custody=custody,
            status='SAVED_PENDING_DIFFERENT_REVIEW_AND_ROOT_ADOPTION',
            raw_byte_readback=True,complete_graph_or_global_acceptance=False,
            target_execution=False,operational_authority=False,scientific_authority=False,
            actual_family_publication=False,compact_ABI_qualified=False)
        _write_owned(paths['parent_witness'],_wire(witness),scope['interval_end'],admission['interval_end'],deadline)
        return witness
    except BaseException as exc:
        # No traceback, body dump or replacement of existing partial artifacts.
        code = exc.code if type(exc) is I13RawRetentionSupervisorError else 'E_RETENTION_CUSTODY'
        try:
            claim_present_after_error = _claim_present(paths['claim'])
        except BaseException:
            pass
        for key,body in (
            ('failure',_failure(admission,graph['graph_id'],step,code,type(exc).__name__[:128],transport_created)),
            ('parent_witness',_wire(dict(schema_version=1,
                record_type='Root_I13_raw_retention_owned_parent_failure_witness',
                status='FAILED_PENDING_DIFFERENT_REVIEW_AND_ROOT_ADOPTION',
                capture_id=admission['capture_id'],partition_id=admission['partition_id'],
                graph_id=graph['graph_id'],claim=claim_pin,claim_intended_path=str(paths['claim']),
                claim_write_and_readback_completed=claim_pin is not None,
                claim_present_after_error=claim_present_after_error,evidence=evidence,custody=custody,
                step=step,error_code=code,supervisor_Source=admission['supervisor_Source'],
                exporter_Source=FIXED['exporter_Source'],exporter_API=FIXED['exporter_API'],
                contract=FIXED['contract'],schema=FIXED['schema'],selection_plan=FIXED['selection_plan'],
                Source_scope=admission['Source_scope'],Source_adoption=admission['Source_adoption'],
                protocol_adoption=admission['protocol_adoption'],prelaunch=admission['prelaunch'],
                target_execution=False,operational_authority=False,scientific_authority=False,
                automatic_retry_permitted=False,complete_graph_or_global_acceptance=False)))):
            try:
                _write_owned(paths[key],body,scope['interval_end'],admission['interval_end'],deadline)
            except BaseException:
                pass
        raise


if __name__ == '__main__':
    main()
