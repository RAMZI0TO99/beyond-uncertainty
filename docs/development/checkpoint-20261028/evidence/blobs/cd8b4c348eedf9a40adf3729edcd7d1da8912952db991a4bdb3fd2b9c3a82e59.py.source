def validate_selected_peer_author_packet_metadata(*,packet,records,catalogue_bytes,expected_root_thread,source_editor,now_utc):
    _need(type(packet)is bytes,'E_PACKET_BYTES')
    _need(type(catalogue_bytes)is bytes and len(catalogue_bytes)==COMMON_CATALOGUE_PIN['bytes']and hashlib.sha256(catalogue_bytes).hexdigest()==COMMON_CATALOGUE_PIN['sha256'],'E_CATALOGUE_PIN')
    counter=[0];store=_Store(records,counter)
    _need(store.raw(COMMON_CATALOGUE_PIN)==catalogue_bytes,'E_CATALOGUE_PIN')
    common=store.record(COMMON_CATALOGUE_PIN)
    _need(_same(common['peer_base_catalogue'],CATALOGUE_PIN)and _same(common['peer_role_data'],PEER_ROLE_DATA_PIN)and _same(common['fixed_inventory_LF_annex'],LF_ANNEX_PIN),'E_CATALOGUE_PIN')
    base=store.record(CATALOGUE_PIN);roledata=store.record(PEER_ROLE_DATA_PIN)
    spent={p['path'].casefold()for p in base['spent_pin75']}
    _need(not any(path.casefold()in spent for path in store.pins),'E_SPENT_IDENTITY')
    matches=[store.pins[path]for path,body in store.bodies.items()if body==packet]
    _need(len(matches)==1,'E_PACKET_BYTES');wrapper_pin=matches[0];wrapper=store.record(wrapper_pin)
    _need(type(wrapper.get('record_type'))is str and type(wrapper.get('schema_version'))is int,'E_SCHEMA')
    _need(wrapper['record_type']=='Root_owner_v2_selected_peer_canonical_author_metadata_packet'and wrapper['schema_version']==2,'E_UNSUPPORTED_AUTHOR_PACKET_ABI')
    keys=('schema_version','record_type','Root_thread','role','owner_scope','lease','selection','peer_packet','producer_support','role_inputs','created_utc','target_execution','operational_authority','source_only')
    _closed(wrapper,keys)
    _need(type(wrapper['role'])is str and wrapper['role']in roledata['peer_roles'],'E_UNSUPPORTED_PEER_ROLE')
    _need(wrapper['source_only']is True and wrapper['target_execution']is False and wrapper['operational_authority']is False,'E_AUTHORITY')
    wrapper_time=_time(wrapper['created_utc'])
    for key in ('owner_scope','lease','selection','peer_packet'):_pin(wrapper[key]);_i13_path(wrapper[key]['path'])
    inner=store.record(wrapper['peer_packet'])
    graph=_Peer(packet=store.raw(wrapper['peer_packet']),records=records,catalogue_bytes=store.raw(CATALOGUE_PIN),expected_root_thread=expected_root_thread,source_editor=source_editor,now_utc=now_utc,peer=True,_shared=(base,counter,store,inner))
    graph.roledata=roledata
    _need(wrapper['Root_thread']==expected_root_thread and wrapper['role']==graph.role and _same(wrapper['owner_scope'],graph.scope)and _same(wrapper['lease'],graph.lease)and _same(wrapper['selection'],graph.selection_pin),'E_PEER_WRAPPER_JOIN')
    graph.excluded.add('/root/project_architecture')
    _i13_producer(graph,wrapper['producer_support'])
    inputs=_i13_wrapper_inputs(graph,wrapper)
    contract=roledata['original_output_contracts'][graph.role]
    _i13_original(graph,store.record(graph.p['predecessor']),contract,inputs,wrapper_time,False)
    _i13_original(graph,store.record(graph.p['draft']),contract,inputs,wrapper_time,True)
    graph.validate()
    receipt=store.record(graph.p['receipt'])
    _need(_time(receipt['created_utc'])<=wrapper_time<=graph.now,'E_CHRONOLOGY')
    code_review,code_time=graph.support(wrapper['producer_support'],[wrapper['producer_support']['Source'],wrapper['producer_support']['API']],True)
    _need(code_time<=wrapper_time,'E_CHRONOLOGY')
    return _i13_result(graph,wrapper,wrapper_pin,common)


