def _i13_path(value):
    _need(type(value) is str and len(value)<=512,'E_PATH')
    return _path(value)


def _i13_sha(value):
    _need(type(value) is str and re.fullmatch('[0-9a-f]{64}',value) is not None,'E_ORIGINAL_PEER_SCHEMA')


def _i13_original(graph,value,contract,inputs,wrapper_time,joins):
    _closed(value,contract['closed_keys'],'E_ORIGINAL_PEER_SCHEMA')
    types={'str':str,'int':int,'bool':bool,'list':list,'dict':dict,'NoneType':type(None)}
    for key,name in contract['field_builtin_types'].items():
        _need(type(value[key]) is types[name],'E_ORIGINAL_PEER_SCHEMA')
        if key.endswith('_sha256'):_i13_sha(value[key])
        if key in ('reviewer','reviewer_agent','source_author','binding_author'):
            graph.excluded.add(_actor(value[key]).casefold())
    for key,literal in contract['immutable_literal_fields'].items():
        _need(type(value[key]) is type(literal) and _same(value[key],literal),'E_ORIGINAL_PEER_IMMUTABLE')
    if 'created_utc'in value:_need(_time(value['created_utc'])<=wrapper_time,'E_CHRONOLOGY')
    role=graph.role
    def sha(field,name):
        if joins:_need(value[field]==inputs[name]['sha256'],'E_ORIGINAL_PEER_SOURCE_JOIN')
    if role=='metadata_peer':
        _need(type(value['finite_input_count'])is int and value['finite_input_count']==15 and type(value['manifest_payload_count'])is int and value['manifest_payload_count']==12,'E_ORIGINAL_PEER_SCHEMA')
        sha('source_manifest_sha256','metadata_manifest')
    elif role=='metadata_bound_review':
        _need(value['phase_set']==['before','after'],'E_ORIGINAL_PEER_SCHEMA')
        sha('actual_script_sha256','capture_bound')
        bindings=graph.roledata['role_specific_joins'][role]['source_bindings_closed9']
        _closed(value['source_bindings'],bindings,'E_ORIGINAL_PEER_SCHEMA')
        for field,name in bindings.items():
            _i13_sha(value['source_bindings'][field])
            if joins:_need(value['source_bindings'][field]==inputs[name.split('.',1)[1]]['sha256'],'E_ORIGINAL_PEER_SOURCE_JOIN')
    elif role=='phase_peer':
        policy=graph.roledata['role_specific_joins'][role]
        for field,name in policy['top_sha_fields'].items():sha(field,name)
        _need(type(value['PowerShell_parser_errors'])is int and value['PowerShell_parser_errors']==0 and value['exact_two_literal_reversal_all_four']is True,'E_ORIGINAL_PEER_SCHEMA')
        rows=value['phase_sources'];names=policy['phase_sources']['ordered_bound_roles']
        _need(type(rows)is list and len(rows)==4,'E_ORIGINAL_PEER_SCHEMA')
        for row,name in zip(rows,names):
            _closed(row,policy['phase_sources']['closed_keys'],'E_ORIGINAL_PEER_SCHEMA')
            bound={k:row[k]for k in ('path','bytes','sha256')};_pin(bound,65536);_i13_sha(row['template_sha256'])
            _need(type(row['PowerShell_parser_errors'])is int and row['PowerShell_parser_errors']==0 and row['exact_two_literal_reversal']is True,'E_ORIGINAL_PEER_SCHEMA')
            if joins:_need(_same(bound,inputs[name])and row['template_sha256']==inputs[name.replace('_bound','_template')]['sha256'],'E_ORIGINAL_PEER_SOURCE_JOIN')
    elif role=='pipeline_peer':
        sha('pipeline_source_sha256','pipeline');sha('pipeline_binding_sha256','binding')
        names=graph.roledata['role_specific_joins'][role]['phase_argv_templates_closed8']
        _closed(value['phase_argv_templates'],names,'E_ORIGINAL_PEER_SCHEMA')
        for argv in value['phase_argv_templates'].values():
            _need(type(argv)is list and 0<len(argv)<=512 and all(type(x)is str and bool(x) for x in argv),'E_ORIGINAL_PEER_SCHEMA')
        provenance=value['source_binding_provenance'];_closed(provenance,('path','sha256'),'E_ORIGINAL_PEER_SCHEMA')
        _i13_path(provenance['path']);_i13_sha(provenance['sha256'])
    elif role=='checker_peer':
        sha('checker_template_sha256','checker');sha('source_manifest_sha256','checker_manifest');sha('full_source_details_sha256','checker_dependency_audit')
    else:raise I13MetadataError('E_UNSUPPORTED_PEER_ROLE')


def _i13_producer(graph,support):
    _schema(support,'code_support5',graph.c)
    graph.s.raw(support['Source'],65536)
    api=graph.s.record(support['API'])
    keys=('schema_version','record_type','author','actual_Source_editor','Source','protocol','peer_role_data','peer_base_catalogue','metadata_entry','actual_entry','declared_roles','target_execution','operational_authority','actual_producer_issued')
