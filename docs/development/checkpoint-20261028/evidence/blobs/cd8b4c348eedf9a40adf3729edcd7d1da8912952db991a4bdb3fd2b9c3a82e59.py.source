        for key,child in value.items():
            _need(type(key) is str, 'E_VALUE')
            _tree(key,counter,depth+1,lf_record,pointer+('#key',key))
            _tree(child,counter,depth+1,lf_record,pointer+(key,))
        return
    raise I13MetadataError('E_VALUE')
''')
