def pin(p):
    b=p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())


def save(p,v):
    raw=(json.dumps(v,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    assert len(raw)<=2097152
    with p.open('xb') as h:
        assert h.write(raw)==len(raw)
    return pin(p)


