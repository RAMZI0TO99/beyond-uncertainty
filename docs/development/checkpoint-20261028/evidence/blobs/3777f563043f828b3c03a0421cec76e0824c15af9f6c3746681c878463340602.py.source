sites=[]
def regions(path,names):
 tr=ast.parse(path.read_bytes().decode('utf8'))
 def walk(rows,prefix=''):
  for n in rows:
   if isinstance(n,(ast.ClassDef,ast.FunctionDef)):
    name=prefix+n.name
    if name in names:
     sites.append(dict(id=('fixture'if path==fixture else'm3'if path==m3 else'publisher')+':'+name,Source=pin(path),symbol=name,line=n.lineno,end_line=n.end_lineno,AST_sha256=sha(ast.dump(n,include_attributes=False).encode('utf8'))))
    if isinstance(n,ast.ClassDef):walk(n.body,name+'.')
 walk(tr.body)
