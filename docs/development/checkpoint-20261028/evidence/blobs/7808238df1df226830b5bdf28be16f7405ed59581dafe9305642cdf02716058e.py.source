"""Preserve refused own metadata helper; correct only saved graph stage map."""
import base64, datetime as dt, hashlib, json, os
from pathlib import Path
P=Path(__file__).parent
old=P/'derive_saved_roster_partition_plan_001.py'
new=P/'derive_saved_roster_partition_plan_002.py'
b=old.read_bytes()
a=b"['templates', 'manifest', 'plan', 'capture', 'binding', 'phase_binding']"
z=b"['templates', 'manifest', 'capture', 'capture', 'capture', 'phase_binding']"
assert b.count(a)==1 and len(b)<=2097152
for name in ('ROOT_I13_RAW_RETENTION_SIX_GRAPH_WHOLE_RECORD_SELECTION_PLAN_001.json','ROOT_I13_RAW_RETENTION_SELECTION_PLAN_STATIC_ARITHMETIC_PROOF_001.json','ROOT_I13_RAW_RETENTION_SELECTION_PLAN_AUTHOR_FREEZE_001.json'):
 assert not os.path.lexists(P/name)
now=dt.datetime.now(dt.timezone.utc)
assert (dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00')-now).total_seconds()>60
with new.open('xb') as h:h.write(b.replace(a,z));h.flush();os.fsync(h.fileno())
fact=lambda p,x:dict(path=str(p),bytes=len(x),sha256=hashlib.sha256(x).hexdigest())
v=dict(schema_version=1,record_type='Root_own_metadata_partition_deriver001_prewrite_refusal_and_complete_inverse',author='/root',created_utc=now.isoformat(),complete_predecessor=fact(old,b),complete_predecessor_base64=base64.b64encode(b).decode(),successor=fact(new,new.read_bytes()),actual_tool_chunk='8417af',actual_exit_code=1,original_error='ValueError: known role and stage plan',Root_correction='Only replace assumed plan/binding stages with exact saved graph capture stages; all prospective outputs were absent at refusal and remain new identities.',new_raw_input_or_builder_calls=0,all_execution_gates_held=True)
out=P/'ROOT_I13_PARTITION_DERIVER002_COMPLETE001_INVERSE_AND_REFUSAL_001.json'
w=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
assert len(w)<=2097152
assert (dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
with out.open('xb') as h:h.write(w);h.flush();os.fsync(h.fileno())
print(json.dumps(dict(successor=fact(new,new.read_bytes()),inverse=fact(out,out.read_bytes()))))
