def fact(path, expected_bytes=None, expected_sha=None):
    body = path.read_bytes()
    result = dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())
    if expected_bytes is not None:
        assert result['bytes'] == expected_bytes and result['sha256'] == expected_sha
    facts.append(result)
    return body

def check(name, passed, evidence):
    assert name not in {c['name'] for c in checks}
    checks.append(dict(name=name, passed=bool(passed), evidence=evidence))

def source(path, size, sha):
    raw = fact(path, size, sha)
    text = raw.decode('utf8')
    return text, ast.parse(text)

def find(tree, cls, name):
    return next(n for n in ast.walk(tree) if isinstance(n, cls) and getattr(n, 'name', None) == name)

def segment(path, text, start, end, purpose):
    lines = text.splitlines()
    snippets.append(dict(path=str(path), start_line=start, end_line=end, purpose=purpose,
                         exact_UTF8_lines='\n'.join(lines[start-1:end])))

