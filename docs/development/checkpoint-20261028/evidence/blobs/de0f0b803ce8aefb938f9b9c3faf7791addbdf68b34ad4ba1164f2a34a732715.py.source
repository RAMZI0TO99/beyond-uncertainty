assert request['expected_numerical_budget']==pins['phase_budgets']['tests'] and len(request['expected_numerical_budget'])==8
assert all(type(v) is int and v==0 for v in request['expected_numerical_budget'].values())
assert request['production_backend_factory_model_array_support_gradient_query_work_permitted'] is False
assert request['code_classification_acceleration_only'] is True and request['all_content_hash_inventory_input_unit_join_verifier_guards_unchanged'] is True
assert review['classification_only_not_content_or_authorization_cache'] is True and review['ordinary_open_resolution_policy_unchanged'] is True
assert request['maximum_jobs']==1 and request['max_job_seconds']==600 and request['process_mib']==4096 and request['job_mib']==5120
assert request['startup_ram_gib']==request['active_ram_gib']==4 and request['disk_gib']==20 and request['threads']==1 and request['gpu_hidden'] is True
assert request['all_five_genuine_pause_paths_required'] is True and request['automatic_retry_permitted'] is False and request['scientific_admission'] is False
assert request['requested_window_seconds']==1200 and request['prior_grants_003_through_008_consumed_closed'] is True
assert amendment['owner_instruction_exact']==request['owner_instruction_exact']=='use the available ram now!'
assert amendment['scientific_admission'] is False and amendment['each_slot_requires_distinct_maximum_one_job_release'] is True
assert amendment['content_hash_and_provenance_checks_not_cached'] is True and amendment['old_grants_or_allowances_reused'] is False
pauses=[Path(r'D:\Aenv\pro2\WORK')/('resume-'+day+'-001/coordination/PRO2_REQUEST_PRO3_PAUSE.json') for day in ('20261007','20261012','20261013','20261015','20261025')]
assert not any(p.exists() for p in pauses)
class Memory(ctypes.Structure):
 _fields_=[('length',ctypes.c_ulong),('load',ctypes.c_ulong)]+[(x,ctypes.c_ulonglong) for x in ('total_phys','available_phys','total_page','available_page','total_virtual','available_virtual','available_extended')]
memory=Memory();memory.length=ctypes.sizeof(memory);assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(memory))
now=dt.datetime.now(dt.timezone.utc)
resource=dict(observed_utc=now.isoformat(timespec='microseconds'),available_RAM_bytes=memory.available_phys,disk_free_bytes=shutil.disk_usage(P).free)
assert resource['available_RAM_bytes']>=4*1024**3 and resource['disk_free_bytes']>=20*1024**3
scope_path=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json';scope=load(scope_path)
assert (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>1260
previous=load(Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\coordination\PRO2_PRO3_COMPUTE_RELEASE_20261025_007.json'),'059b8547c1406bb6be2d4f22a5a6a2ee7f6f6e0764db9443d3e1b8b3b3272793')
release008=load(R/'coordination/ROOT_RETAINED_PRO3_008_FAILED_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json','69c4e55e030a8de5eb868c7957f9ee8b5a3b0601ac346fa4b147033de5715de6')
assert release008['reported_full_compute_custody_released'] is True and release008['grant_consumed_closed'] is True
previous.pop('prior006_full_custody_release_report',None)
previous.update(issued_utc=now.isoformat(timespec='microseconds'),window_start_utc=now.strftime('%Y-%m-%dT%H:%M:%SZ'),window_end_utc=(now+dt.timedelta(seconds=1200)).strftime('%Y-%m-%dT%H:%M:%SZ'),
 scope=request['scope'],phase='tests',fixed_output='t1',exact_pins=pin(D/'pins.json'),pins_sha256=pin(D/'pins.json')['sha256'],Source_review=pin(D/'source-review.json'),source_review_sha256=pin(D/'source-review.json')['sha256'],
 owner_resource_amendment=pin(D/'owner-resource-amendment.json'),owner_resource_amendment_sha256=pin(D/'owner-resource-amendment.json')['sha256'],request=pin(D/'compute-request_tests_001.json'),
 verified_13_reviewed_file_pins=files,expected_numerical_budget=request['expected_numerical_budget'],last_resource_observation=resource,
 allowed_action='V6 TESTS ONLY: exactly63 focused fabricated numerical-metadata cases with real OS locks, genuine original fixture Source metadata captures and independent ZERO numerical observer. No production backend/claim/workspace/factory/model/NPZ/support/gradient/query. At mostone600sJob then separately reviewed stdlib external unit closeout<=300s and explicit full custody release. No retry/secondJob. Integration requires a DISTINCT later exact grant externally joining the three new accepted unit proofs.',
 prior_grants001_through008_consumed_closed_not_reused=True,prior008_failed_report=pin(R/'coordination/ROOT_RETAINED_PRO3_008_FAILED_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'),prior008_partial_terminal_correction=pin(R/'coordination/ROOT_RETAINED_PRO3_008_PARTIAL_TERMINAL_CORRECTION_REPORT_002.json'),
 v5_failed_hard600_and_physical_intent_success_quarantined_unknown_ledger=True,v5_unit_acceptance_historical_only=True,classification_acceleration_only=True,content_hash_and_authorization_cache_permitted=False,
 current_Pro2_Source_scope=pin(scope_path),current_Pro2_Source_protocol_adoption=pin(R/'ROOT_I13_FINAL_PROTOCOL005_OBSERVATION9_DIFFERENT_REVIEW_ADOPTION_003.json'),
 Pro2_will_not_launch_target_memory_test_until_peer_reported_full_custody_release=True,peer_results_accepted=False,physical_handle_absence_claimed=False,global_host_or_process_quiet_claimed=False,all_five_pause_paths=[str(p) for p in pauses])
previous['owner_message_evidence']['scope_interpretation']='Same directly authorized engineering work and four-GiB startup reply, independently reviewed v6 operations-only successor; this release admits only fresh zero-numerical63-test phase. No v6 integration, oldgrant reuse or scientific authority follows.'
out=R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_009.json'
raw=(json.dumps(previous,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
with out.open('xb') as h:assert h.write(raw)==len(raw)
print(json.dumps(dict(release=pin(out),window_end_utc=previous['window_end_utc'],resource=resource,phase='v6_tests_only')))
