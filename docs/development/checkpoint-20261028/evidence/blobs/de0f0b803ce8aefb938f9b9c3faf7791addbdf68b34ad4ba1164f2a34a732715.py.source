"""Routine human-authorized peer coordination metadata; does not launch work."""
import ctypes,datetime as dt,hashlib,json,shutil
from pathlib import Path
R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003');P=Path(r'D:\Aenv\pro3')
D=P/'runs/coordination/cho51_provenance_numerical_worker_20261025_v6'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p,sha=None):
 if sha is not None:assert pin(p)['sha256']==sha
 return json.loads(p.read_bytes())
pins=load(D/'pins.json','745015ad931bfc86f6708bc7e440215e8c41095b81adde167d276952b9eb9c33')
review=load(D/'source-review.json','62117d5f4d8fd567013ecba59a184e6cec2b0e48eb53dc2abb622d0a62bbe3fd')
amendment=load(D/'owner-resource-amendment.json','23f30ff00a0c004eae38b886dbef477965ef0369d4d28d17146dbc2c820324b7')
request=load(D/'compute-request_tests_001.json','3dfddfdb286be24c35896177dc90896d46189809126b13a8bab7ed9130e609aa')
assert review['accepted'] is True and review['remaining_actionable_findings']==[] and review['source_only'] is True
assert review['tests_executed'] is False and review['model_executed'] is False and review['execution_admission'] is False
assert review['files']==pins['reviewed_files'] and len(review['files'])==13
files=[]
for name,sha in review['files'].items():
 p=P/name;assert p.resolve().is_relative_to(P.resolve()) and pin(p)['sha256']==sha;files.append(pin(p))
