    Source=fact(helper), predecessor_Source=fact(helper_old), whole_predecessor_Source_bytes_base64=base64.b64encode(raw(helper_old)).decode('ascii'),
    Source_read_policy='read_bytes().decode("utf8") for actual Source/AST', exact_replacement=dict(before=before, after=after),
    all_other_helper_methods_AST_exact=True, regions=regions(helper, h_text, ht), compile_only=True,
    helper_function_or_builder_calls=0, case_results=None, **FLAGS))

kernel_names = [
    'validate_M3_guard_contract_metadata_009.py', 'CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_009.json',
    'validate_selected_peer_author_packet_metadata_009.py', 'CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_009.json',
    'validate_selected_role_publisher_metadata_004.py', 'CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_004.json']
expected = ['b91eefd28fb8d120addd510949e2cca82b310379da7fa81ec3ddd435285d49f2','b3ab0bbd452824ebfe94aef0584fae05e2831454e76536cd21fb9834059501c2','4931d2d5b541a2b7d8ce9c4dc7614482e69ec18ddc4681a44039a8285e93194b','c3f5dfa2d652ab5e17b1128c4825c12e50edf8875f0678caeee219643dfd542c','f1df1975bee9c7fcd546f4c94f9d09a6371165aea83b6dcaa783f0ad7d7dd6bc','93342e63661c7eea78e13cfc7504b547ea047643bf37e1ff5cf84a4e74260ffe']
kernel_pins = [fact(DIR/name) for name in kernel_names]
assert [p['sha256'] for p in kernel_pins] == expected

outputs = []
names_all = []
for kind, new_version, old_version, new_source, old_source in [
    ('M3', '009', '008', 'exercise_M3_guard_and_publisher_metadata_memory_009.py', 'exercise_M3_guard_and_publisher_metadata_memory_008.py'),
    ('PEER', '007', '006', 'exercise_selected_peer_author_metadata_memory_007.py', 'exercise_selected_peer_author_metadata_memory_006.py')]:
    path, prior = DIR/new_source, DIR/old_source
    text, node = tree(path)
    prior_text, prior_node = tree(prior)
    current_defs, prior_defs = defs(node), defs(prior_node)
    rows, prior_rows = ast_rows(node), ast_rows(prior_node)
    assert stable(rows) == stable(prior_rows)
    names = [row['name'] for row in rows]
    assert len(names) == len(set(names)) and all(type(name) is str and name.isascii() for name in names)
    names_all += names
    assert adump(current_defs['run']) == adump(prior_defs['run'])
    assert set(current_defs)-set(prior_defs) == {'_diagnostic_one', 'run_diagnostic'}
    expected_changed = {'_OWAdapter'} | ({'_M3Build'} if kind == 'M3' else set())
    changed = {name for name in prior_defs if adump(prior_defs[name]) != adump(current_defs[name])}
    assert changed == expected_changed, (kind, changed)
    if kind == 'M3':
        old = "o.rewrite('selection',selection);self.selection['selection']=o.p('selection')"
        new = "o.rewrite('selection',selection);o.selection=o.p('selection');self.selection['selection']=o.p('selection')"
        assert prior_text.count(old) == 1
        common_before = prior_text.replace(before, after).replace(old, new)
    else:
        common_before = prior_text.replace(before, after)
    # Successor only appends diagnostics after the unchanged complete literal catalogue.
    assert text.startswith(common_before)
    strict_loop = next(n for n in current_defs['run'].body if isinstance(n, ast.For))
    expected_one_body = strict_loop.body[:-2]
    assert adump(ast.Module(body=expected_one_body, type_ignores=[])) == adump(ast.Module(body=current_defs['_diagnostic_one'].body, type_ignores=[]))
    for entry in ('run', 'run_diagnostic'):
        fn = current_defs[entry]
        assert not fn.args.args and not fn.args.posonlyargs and not fn.args.vararg and not fn.args.kwarg
        assert [a.arg for a in fn.args.kwonlyargs] == ['m3', 'publisher', 'peer', 'catalogue_bytes']
    diagnostic = current_defs['run_diagnostic']
    handlers = [n for n in ast.walk(diagnostic) if isinstance(n, ast.ExceptHandler)]
    assert [adump(n.type) for n in handlers] == [adump(ast.Name(id='MemoryError', ctx=ast.Load())), adump(ast.Name(id='Exception', ctx=ast.Load()))]
    assert len(handlers[0].body) == 1 and isinstance(handlers[0].body[0], ast.Raise)
    assert not any(isinstance(n, ast.Name) and n.id == 'BaseException' for n in ast.walk(diagnostic))
    assert any(isinstance(n, ast.Try) and len(n.finalbody) == 2 and all(isinstance(x, ast.Assert) for x in n.finalbody) for n in ast.walk(diagnostic))
    helper_match = {name: adump(hd[name]) == adump(current_defs[name]) for name in hd}
    assert all(helper_match.values())
    previous_cat = DIR/('I13_'+kind+'_FIXTURE_LITERAL_CASE_CATALOGUE_'+old_version+'.json')
    catalogue = copy.deepcopy(decode(previous_cat))
    assert catalogue['literal_cases'] == stable(rows)
    catalogue.update(Source=fact(path), previous_Source=fact(prior), previous_catalogue=fact(previous_cat), helper=fact(helper),
        actual_successor_Source_editor=AUTHOR, author=AUTHOR, literal_cases=stable(rows), case_count=len(rows), case_names=names,
        case_names_LF_sha256=sha(('\n'.join(names)+'\n').encode('ascii')), added_control_count=0, added_controls=[],
        positive_case_count=sum(row['expected_error'] is None for row in rows), expected_refusal_case_count=sum(row['expected_error'] is not None for row in rows),
        prior_literal_case_prefix_exact=True, strict_run_AST_unchanged=True, diagnostic_entry='run_diagnostic', diagnostic_failure_field_count=5,
        diagnostic_failure_keys=['name','exception_type','expected_code','actual_code','message'], diagnostic_case_results=None,
        new_helpers_builders_fixtures_called=False, case_results=None, **FLAGS)
    cat_path = save('I13_'+kind+'_FIXTURE_LITERAL_CASE_CATALOGUE_'+new_version+'.json', catalogue)
    receipt = dict(schema_version=2, record_type='I13_fixture_lifecycle_fix_and_separate_bounded_diagnostic_Source', author=AUTHOR,
        Source=fact(path), predecessor_Source=fact(prior), whole_predecessor_Source_bytes_base64=base64.b64encode(raw(prior)).decode('ascii'),
        Source_read_policy='read_bytes().decode("utf8") for every Source/JSON/AST read', actual_successor_Source_editor=AUTHOR,
        original_peer_fixture_author='/root/i2_resume_gap' if kind=='PEER' else None, helper=fact(helper), helper_receipt=fact(helper_receipt),
        catalogue=fact(cat_path), kernel_and_API_inputs=kernel_pins, case_results=None, diagnostic_case_results=None,
        prior_case_rows_exact=True, strict_run_AST_unchanged=True, run_actual_UTF8_AST_sha256=ahash(current_defs['run']),
        diagnostic_case_body_AST_equals_strict_loop_minus_result_emission=True,
        diagnostic_one_actual_UTF8_AST_sha256=ahash(current_defs['_diagnostic_one']),
        diagnostic_run_actual_UTF8_AST_sha256=ahash(diagnostic),
        diagnostic_failure_field_count=5, diagnostic_failure_keys=['name','exception_type','expected_code','actual_code','message'],
        diagnostic_catches_only_ordinary_per_case_Exception=True, MemoryError_reraised=True, BaseException_not_caught=True,
        global_seal_and_all_three_actual_flags_checked_in_finally_before_progress=True,
        no_global_or_held_flag_corruption_restoration_or_continue_permission=True,
        diagnostic_failed_cases_are_false_and_counts_truthful=True, strict_all_pass_parent_acceptance_unchanged=True,
        helper_functions_AST_match_fixed_helper=helper_match, changed_existing_top_level_definitions=sorted(changed),
        all_other_existing_definitions_AST_exact=True, regions=regions(path,text,node), compile_only=True,
        target_helper_fixture_builder_function_calls=0, all_previous_frozen_Source_bytes_preserved=True, **FLAGS)
    rec_path=save('I13_'+kind+'_FIXTURE_SOURCE'+new_version+'_LIFECYCLE_DIAGNOSTIC_AND_WHOLE_PREDECESSOR_AUTHOR_RECEIPT_001.json', receipt)
    outputs += [fact(path),fact(cat_path),fact(rec_path)]

