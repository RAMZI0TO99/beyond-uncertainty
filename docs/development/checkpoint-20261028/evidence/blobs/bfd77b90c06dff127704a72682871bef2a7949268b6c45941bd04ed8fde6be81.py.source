"""Own stdlib Source/evidence authoring only; no target/helper/fixture invocation."""
import ast
import base64
import copy
import datetime
import hashlib
import json
import os
from pathlib import Path

ROOT = Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
COMP = ROOT / 'm3_peer_contracts_016'
DIR = COMP / 'i13'
SCOPE = ROOT / 'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'
END = datetime.datetime.fromisoformat('2026-10-25T14:35:29.732506+00:00')
AUTHOR = '/root/project_architecture'
FLAGS = dict(target_execution=False, operational_authority=False, scientific_authority=False, native_Parser_executed=False, actual_family_publication=False)

def raw(path):
    return path.read_bytes()

def decode(path):
    return json.loads(raw(path).decode('utf8'))

def sha(value):
    return hashlib.sha256(value).hexdigest()

def fact(path):
    body = raw(path)
    return dict(path=str(path), bytes=len(body), sha256=sha(body))

def adump(node):
    return ast.dump(node, include_attributes=False)

def ahash(node):
    return sha(adump(node).encode('utf8'))

def tree(path):
    body = raw(path)
    text = body.decode('utf8')
    node = ast.parse(text, filename=str(path))
    compile(node, str(path), 'exec', dont_inherit=True)
    return text, node

def defs(node):
    return {n.name: n for n in node.body if isinstance(n, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef))}

def regions(path, text, node):
    lines = text.splitlines(keepends=True)
    found = []
    for n in ast.walk(node):
        if isinstance(n, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
            body = ''.join(lines[n.lineno-1:n.end_lineno]).encode('utf8')
            found.append(dict(name=n.name, start_line=n.lineno, end_line=n.end_lineno, bytes=len(body), utf8_sha256=sha(body), AST_sha256=ahash(n)))
    return sorted(found, key=lambda row: (row['start_line'], row['end_line']))

def save(name, value):
    # Fresh scheduling sample before each own metadata mutation; no target gate use.
    assert (END-datetime.datetime.now(datetime.timezone.utc)).total_seconds() > 60
    body = (json.dumps(value, ensure_ascii=True, sort_keys=True, indent=2, allow_nan=False)+'\n').encode('utf8')
    assert len(body) <= 2097152
    path = DIR / name
    with path.open('xb') as stream:
        stream.write(body)
        stream.flush()
        os.fsync(stream.fileno())
    assert raw(path) == body
    print(json.dumps(fact(path), sort_keys=True))
    return path

def ast_rows(node):
    assignments = [n for n in node.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'CASE_CATALOGUE' for t in n.targets)]
    assert len(assignments) == 1
    return ast.literal_eval(assignments[0].value)

def stable(value):
    if type(value) is bytes:
        return dict(AST_builtin_type='bytes', canonical_base64=base64.b64encode(value).decode('ascii'))
    if type(value) is dict:
        return {key: stable(child) for key, child in value.items()}
    if type(value) in (list, tuple):
        return [stable(child) for child in value]
    return value

helper_old = DIR / 'I13_NEW_OUTER_ENVELOPE_FIXTURE_HELPER_006.py.source'
helper = DIR / 'I13_NEW_OUTER_ENVELOPE_FIXTURE_HELPER_007.py.source'
ho_text, ho = tree(helper_old)
h_text, ht = tree(helper)
before = "if type(text)is not str:return _ow_ns(17) if pin==self.p('wrapper') else _ow_ns(0)"
after = "if type(text)is not str:return _ow_ns(17) if self.b['labels'].get('wrapper')==pin['path'] else _ow_ns(0)"
assert ho_text.count(before) == 1 and h_text == ho_text.replace(before, after)
old_hd, hd = defs(ho), defs(ht)
assert set(hd) == set(old_hd)
for name in hd:
    if name != '_OWAdapter':
        assert adump(hd[name]) == adump(old_hd[name])
old_methods, methods = defs(old_hd['_OWAdapter']), defs(hd['_OWAdapter'])
assert set(methods) == set(old_methods)
assert [name for name in methods if adump(methods[name]) != adump(old_methods[name])] == ['recorded_birth']
