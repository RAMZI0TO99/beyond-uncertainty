"""Root metadata-only once002 input author after exact new Source adoption."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';cache={}
def raw(p):
 if str(p) not in cache:
  with p.open('rb') as h:b=h.read(2097153)
  assert 0<len(b)<=2097152;cache[str(p)]=b
 return cache[str(p)]
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
m=pin(C/'I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_003.json');a=pin(C/'ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_002.json');s=pin(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_003.py');prior=pin(C/'ROOT_I13_ONCE001_DIFFERENT_SAVED_REFUSAL_ADOPTION_001.json')
v=json.loads(raw(Path(a['path'])));assert v['manifest']==m and v['supervisor']==s and v['previous_saved_refusal']==prior
assert v['verdict']=='ACCEPT_EXACT_I13_NEW_SOURCE_FOR_SEPARATE_ONCE_SYNTHETIC_ADMISSION_ONLY' and all(v[k] is False for k in ('target_execution','operational_authority','scientific_authority','tests_executed','actual_family_publication'))
p=C/'I13_ONCE_ADMISSION_INPUT_002.json';cfg=dict(manifest=m,Source_adoption=a,supervisor=s,previous_refusal_adoption=prior);b=(json.dumps(cfg,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:assert h.write(b)==len(b)
print(json.dumps(dict(admission_input=pin(p),scope_issued=False,suite_invoked=False)))
