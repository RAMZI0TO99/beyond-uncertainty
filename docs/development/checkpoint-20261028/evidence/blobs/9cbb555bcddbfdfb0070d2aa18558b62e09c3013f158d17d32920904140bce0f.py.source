"""Record Root's exact already-sent supplementary timeout cleanup acknowledgment."""
import datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent.parent;P=Path('D:/Aenv/pro3/runs/coordination/cho51_canonical_boundary_20261025_v4')
def pin(p):
 p=Path(p);s=p.stat();assert p.is_file()and not p.is_symlink()and s.st_nlink==1 and s.st_size<=2097152
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes()and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
helper=pin(P/'timeout_closeout_001.py');common=pin(P/'metadata_common.py');reviewp=P/'timeout-auditor-source-review_001.json';reviewpin=pin(reviewp);review=json.loads(reviewp.read_bytes())
assert helper['bytes']==4224 and helper['sha256']=='be39223a025c80fbe957d2f0704a00f2326023ffd97c76bf5d214b3e83d1913a'
assert common['sha256']=='46f9412d8ed2e2ddbf68af7d56b1d13b281bc252652778705e31c3e0277920c4'
assert review['accepted']is True and review['remaining_actionable_findings']==[] and review['sha256']==helper['sha256']
grant=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_016.json');assert grant['sha256']=='0d8b4a45933b487aeb45ca3d69ebeaf21d6368a2c90e51520a9f4818a949e5db'
scope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004_002.json');now=dt.datetime.now(dt.timezone.utc)
v=dict(schema_version=1,record_type='Root_grant016_exact_reviewed_timeout_cleanup_Source_acknowledgment',author='/root',created_utc=now.isoformat(),
 Source_scope=scope,grant=grant,reviewed_exact_timeout_cleanup_Source=helper,frozen_common_Source=common,different_readiness_Source_review=reviewpin,
 Root_full_Source_read_tool='c8c6b5',Root_exact_ack_tool_message_sent_utc='2026-10-25T18:33:42+00:00',
 allowed_action='One exact supplemental stdlib timeout cleanup only under016 after saved different readiness acceptance. Fresh original resource floors/all5pauses/pins; no candidateimports,test,Job,retry or result promotion.',
 absolute_end_utc='2026-10-25T18:38:00+00:00',maximum_external_seconds=300,supervision_deadline='min(actualstart+300seconds,original01618:38:00UTC) including owned reap/drain and explicit release; no full300second reservation or window extension implied',
 expected_actual_timeout_reason='attempt_deadline',runtime_counter_report_available=False,successful_test_evidence=False,
 original_600_plus5_deadlines_unchanged=True,grant016_extended=False,new_Job_authorized=False,automatic_retry_permitted=False,
 peer_results_accepted=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_claimed=False,physical_handle_absence_claimed=False)
out=R/'coordination/ROOT_PRO3_GRANT016_EXACT_TIMEOUT_CLEANUP_SCOPE_ACKNOWLEDGMENT_001.json';b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert pin(out)['sha256']==hashlib.sha256(b).hexdigest()
print(json.dumps(pin(out)))
