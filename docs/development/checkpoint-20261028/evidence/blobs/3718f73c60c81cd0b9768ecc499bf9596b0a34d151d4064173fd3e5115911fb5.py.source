"""Root saved refusal adoption only; no suite, target or replay."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';O=C/'owned_memory_runs/attempt001';cache={}
def raw(p):
 p=Path(p)
 if str(p) not in cache:
  with p.open('rb') as h:b=h.read(2097153)
  assert 0<len(b)<=2097152;cache[str(p)]=b
 return cache[str(p)]
def pin(p):
 p=Path(p);b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(raw(p))
cap=R/'saved_once001_refusal_review_002/INDEPENDENT_I13_ONCE001_SAVED_REFUSAL_CAPSULE_001.json';c=load(cap);full=Path(c['full_proof']['path']);f=load(full);assert pin(full)==c['full_proof']
assert pin(cap)['sha256']=='27ef1d9e2fae176f7e27a7ea1a8298ac74f337efb748debb13becb00fe6f29b1'
for v in (c,f):
 assert v['reviewer']=='/root/i13_final_review' and v['verdict'].startswith('PASS_') and v['checks_passed']==59 and v['checks_failed']==0
 assert all(v[k] is False for k in ('tests_executed','target_execution','operational_authority','scientific_authority','native_Parser_executed'))
assert c['verdict']==f['verdict'] and len(f['checks'])==len({x['name'] for x in f['checks']})==59
assert all(set(x)=={'name','passed','evidence'} and x['passed'] is True for x in f['checks'])
result=O/'SUPERVISOR_RESULT_001.json';s=load(result);w=C/'ROOT_I13_ONCE001_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json';witness=load(w)
assert s['acceptance_at_record_preparation'] is False and s['exit_code']==1 and s['refusal'] is None and s['child_result_absent'] is True
assert s['known_case_pass_prefix_from_complete_stdout']==7 and s['reaped'] is s['streams_drained'] is True and all(s['actual_stream_EOF'].values())
assert s['killed'] is s['terminated'] is False and witness['Root_observed_tool_exit_code']==1 and witness['Root_suite_acceptance'] is False
for p in (pin(result),pin(w)):assert p in c['subjects'] and p in f['subjects']
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json';sc=load(scope);now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sc['interval_start'])<=now and (dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_once001_different_saved_refusal_and_owned_cleanup_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_ONCE001_SAVED_REFUSAL_AND_OWNED_CLEANUP_ONLY',Source_scope=pin(scope),different_saved_refusal_review=pin(cap),full_proof=pin(full),supervisor_result=pin(result),parent_tool_witness=pin(w),consumed_scope=s['scope'],claim=s['claim'],checks_passed=59,checks_failed=0,complete_suite_pass=False,known_complete_case_pass_prefix=7,unestablished_case_count=922,failed_expected_positive='i13_m3_complete_templates',actual_error='E_ACTOR',recorded_supervisor_refusal=None,owned_child_reaped=True,owned_streams_drained_to_EOF=True,claim_reuse_or_replay_authorized=False,repair_requires_exact_new_Source_review_Root_adoption_and_fresh_scope=True,full_I2_G01_closed=False,actual_family_publication=False,Native8_Parser_runtime_science_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_or_physical_PID_absence_accepted=False)
out=C/'ROOT_I13_ONCE001_DIFFERENT_SAVED_REFUSAL_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(b)
print(json.dumps(dict(adoption=pin(out),suite_pass=False,scope001_consumed=True)))
