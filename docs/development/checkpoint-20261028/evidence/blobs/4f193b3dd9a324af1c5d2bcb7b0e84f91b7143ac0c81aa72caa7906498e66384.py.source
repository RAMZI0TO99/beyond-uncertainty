"""Separate Root saved-metadata adoptions, no subject rerun."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def occurs(v,p):return v==p or(type(v)is dict and any(occurs(x,p)for x in v.values()))or(type(v)is list and any(occurs(x,p)for x in v))
def review(path,sha,count):
 c=load(path);assert pin(path)['sha256']==sha;link=c.get('full_proof',c.get('full_review'));fp=Path(link['path']);f=load(fp);assert pin(fp)==link
 for v in(c,f):
  assert v['reviewer']=='/root/i13_final_review' and v['verdict'].startswith('PASS_') and v['checks_passed']==count and v['checks_failed']==0
  assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
 assert len(f['checks'])==len({x['name']for x in f['checks']})==count and all(x['passed']is True for x in f['checks'])
 return c,f,fp
def save(p,v):
 with p.open('xb')as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
 return pin(p)
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';now=dt.datetime.now(dt.timezone.utc);assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-now).total_seconds()>60
cp=R/'saved_once005_partition_timeout_review_001/INDEPENDENT_I13_ONCE005_SAVED_PARTITION_TIMEOUT_CAPSULE_001.json';c,f,fp=review(cp,'5bb14a7a09f13bb58315f94322fa483797700254aafb52650f0a273a1a934e51',140)
o=C/'owned_memory_runs/attempt005';rp=o/'SUPERVISOR_RESULT_001.json';s=load(rp);wp=C/'ROOT_I13_ONCE005_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json';w=load(wp)
assert all(occurs(v,pin(p))for v in(c,f)for p in(rp,wp))
assert s['refusal']=='WAIT50_TIMEOUT' and s['child_result']is None and s['diagnostic_failure_count']is None and s['exit_code']==1 and w['Root_observed_tool_exit_code']==1
assert s['reaped']is s['streams_drained']is True and all(s['actual_stream_EOF'].values())and s['terminated']is True and s['killed']is False and s['custody_error']is None
assert w['completed_case_events']==12 and w['known_pass_events']==8 and w['known_fail_events']==4 and w['case_outcomes_not_established']==20
v=dict(schema_version=1,record_type='Root_I13_once005_different_saved_timeout_and_owned_cleanup_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_ONCE005_SAVED_TIMEOUT_AND_OWNED_CLEANUP_ONLY',Source_scope=pin(scope),different_saved_timeout_review=pin(cp),full_proof=pin(fp),supervisor_result=pin(rp),parent_tool_witness=pin(wp),consumed_scope=s['scope'],claim=s['claim'],checks_passed=140,checks_failed=0,complete_suite_pass=False,partition_id='I13_PARTITION_008',completed_case_events=12,known_pass_events=8,known_fail_events=4,unestablished_case_count=20,recorded_diagnostic_failure_count=None,own_once005_parent_and_owned_child_custody_closed=True,claim_reuse_or_replay_authorized=False,repair_requires_exact_new_Source_review_Root_adoption_and_fresh_scope=True,target_execution=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,whole_host_quiet_or_physical_PID_absence_accepted=False)
a=save(C/'ROOT_I13_ONCE005_DIFFERENT_SAVED_TIMEOUT_ADOPTION_001.json',v)
cp=R/'actual_helper_bundle_reconstruction_review_001/INDEPENDENT_I13_ACTUAL_HELPER_SOURCE_BUNDLE_RECONSTRUCTION_CAPSULE_001.json';c,f,fp=review(cp,'866e98b54b6e0015e55822f0845634e81c45c04e35edcd35c371a758dd23c8b0',1349)
ip=R/'metadata_helper_source_bundles_001/I13_METADATA_HELPER_SOURCE_BUNDLE_INDEX_001.json';index=load(ip);assert all(occurs(v,pin(ip))for v in(c,f))
assert index['member_count']==160 and index['original_member_bytes']==1353151 and index['actual_bundles_created']is True and index['original_files_modified']is False
v=dict(schema_version=1,record_type='Root_I13_actual_helper_bundle_reconstruction_different_saved_review_adoption',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),verdict='ACCEPT_EXACT_I13_ACTUAL_HELPER_SOURCE_BUNDLE_BYTE_RECONSTRUCTION_ONLY',Source_scope=pin(scope),different_saved_review=pin(cp),full_proof=pin(fp),bundle_index=pin(ip),bundles=index['bundles'],member_count=160,original_member_bytes=1353151,checks_passed=1349,checks_failed=0,all_complete_original_bytes_reconstruct_exactly=True,original_files_modified=False,actual_bundle_creation_only=True,managed_candidate_requires_different_review_and_Root_adoption=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
b=save(R/'ROOT_I13_ACTUAL_HELPER_SOURCE_BUNDLE_RECONSTRUCTION_DIFFERENT_REVIEW_ADOPTION_001.json',v)
print(json.dumps(dict(once005_timeout_adoption=a,actual_bundle_reconstruction_adoption=b,subjects_rerun=False)))
