    s=s.replace(x,y)
needle="raws={};trees={}"
s=s.replace(needle,"paths.append((ROOT/'adopt_I13_final_new_Source_set_004.py',7620,'2b22b75f33c9be9a89f88214aa7f9e2b801cc91dcb50f405d325b80b7f40d6c7'))\n"+needle,1)
start=s.index('findings=[\n')
end=s.index("OUT.mkdir(exist_ok=False)",start)
replacement=r'''adopter=raws[paths[4][0].name].decode('utf8');at=trees[paths[4][0].name]
for name,tree,source in (('manifest003',mt,manifest),('admission003',ot,once),('adopter004',at,adopter)):
    buffer=func(tree,'_raw_buffer');buffer_source=ast.get_source_segment(source,buffer)
    check(name+'_bounded_same_immutable_physical_buffer',all(x in buffer_source for x in ("key=str(p.resolve()).casefold()","if key not in BUFFERS:","h.read(2097153)","0<len(raw)<=2097152","BUFFERS[key]=raw","return BUFFERS[key]")),buffer_source)
    check(name+'_all_raw_read_calls_inside_buffer',not any(isinstance(n,ast.Call)and isinstance(n.func,ast.Attribute)and n.func.attr in ('read_bytes','read_text')for n in ast.walk(tree)),'No second Path read bypasses the owned cache.')
    check(name+'_pin_hashes_same_cached_bytes','b=_raw_buffer(p)'in ast.get_source_segment(source,func(tree,'pin')),'Pin and decode use the same actual cached bytes object.')
check('manifest003_semantics_use_cache',all(t in manifest for t in ("selection=json.loads(_raw_buffer(","ast.parse(_raw_buffer(p)","body=json.loads(_raw_buffer(q))","declared=json.loads(_raw_buffer(Path(selection['catalogue'])))")),'Catalogue, selection, Source AST, API JSON and literal cases derived from hash-approved cache.')
check('admission003_supervisor_same_cached_AST', "assert pin(supervisor['path'])==supervisor"in once and "ast.parse(_raw_buffer(Path(supervisor['path'])))"in once,'Supervisor hash and exact SCOPE_KEYS read from same retained bytes.')
check('composition002_strict_builtin_keys_before_set',composition.index('all(type(k) is str for k in value)')<composition.index("set(value)=={'path','bytes','sha256'}"),ast.get_source_segment(composition,func(ct,'_pin_equal')))
check('adopter004_no_subject_execution',not any(isinstance(n,ast.Call)and isinstance(n.func,ast.Name)and n.func.id in ('exec','eval','__import__')for n in ast.walk(at)),'Only metadata AST, hashes, JSON, read-only pin checks and create-once metadata outputs.')
for label,terms in (
 ('canonical_same_reviewer',("type(cap.get('reviewer')) is str",r"re.fullmatch(r'/root(?:/[A-Za-z0-9_-]+)+'","cap['reviewer']==full.get('reviewer')")),
 ('same_PASS_verdict',("type(cap.get('verdict')) is str","cap['verdict'].startswith('PASS_')","cap['verdict']==full.get('verdict')")),
 ('casefold_equality_and_descendant',("who.casefold()!=a.casefold()","a.casefold()=='/root'","who.casefold().startswith(a.casefold()+'/')")),
 ('subject_author_types',("type(r['subject_authors']) is list","all(type(a) is str"))):
    check('adopter004_'+label,all(term in adopter for term in terms),terms)
check('adopter004_positive_closed_unique_checks',all(t in adopter for t in ("body['checks_passed']>0","body['checks_failed']==0","len(full['checks'])==full['checks_passed']","len({x['name'] for x in full['checks']})==len(full['checks'])","set(x)=={'name','passed','evidence'}","x['passed'] is True")),'Actual nonempty unique closed all-pass Source checks required.')
check('adopter004_exact_full_direct_all_subjects',all(t in adopter for t in ("cap['full_proof']==r['full_proof']","for p in r['required_subjects']","p in body['subjects']","for p in allpins:ck(p in covered")),'Each exact reviewed subject is directly covered in capsule/full and the actual input set.')
check('adopter004_source_flags_chronology_and_retained_pins',all(t in adopter for t in ("('tests_executed','target_execution','operational_authority','scientific_authority','native_Parser_executed')","body[key] is False","full['created_utc']","cap['created_utc']","for p in cfg['retained_Source_pins']")),'Five explicit false flags, review chronology, original retained source whole pins.')
check('adopter004_gates_only_separate_future_once',all(t in adopter for t in ('separate_fresh_once_scope_required=True','maximum_once_suite_invocations=1','old_I0_I12_target_imports_functions_mains_tests_admitted=False','full_I2_G01_closed=False','actual_family_publication=False')),'Does not mint claim, start child or grant operational authority.')
check('own_full_check3_unique_names',len(checks)==len({x['name']for x in checks})and all(set(x)=={'name','passed','evidence'}for x in checks),'Own review report has unique closed check3 rows.')
findings=[]
assert all(r['passed']for r in checks),[r for r in checks if not r['passed']]
'''
