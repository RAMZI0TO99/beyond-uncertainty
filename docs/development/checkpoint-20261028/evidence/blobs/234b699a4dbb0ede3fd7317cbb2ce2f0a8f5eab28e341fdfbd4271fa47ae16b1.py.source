s=s.replace("checks_passed=len(checks)-2,checks_failed=2)","checks_passed=len(checks),checks_failed=0)")
s=s.replace('HELPERS001_FULL_SOURCE_REFUSAL','HELPERS_FINAL_FULL_SOURCE_PROOF').replace('HELPERS001_SOURCE_REFUSAL_CAPSULE','HELPERS_FINAL_SOURCE_CAPSULE')
