def sha(b):return hashlib.sha256(b).hexdigest()
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=sha(b))
def read(p,new=False):
 q=Path(p['path']);a=q.stat();assert stat.S_ISREG(a.st_mode)and a.st_nlink==1 and 0<=a.st_size<=2097152
 for x in(q,*q.parents):assert not x.is_symlink()and not getattr(x.lstat(),'st_file_attributes',0)&1024
 with q.open('rb')as h:u=os.fstat(h.fileno());b=h.read(2097153);v=os.fstat(h.fileno())
 z=q.stat();k=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns)
 assert k(a)==k(u)==k(v)==k(z)and len(b)==a.st_size and fact(q,b)==p
