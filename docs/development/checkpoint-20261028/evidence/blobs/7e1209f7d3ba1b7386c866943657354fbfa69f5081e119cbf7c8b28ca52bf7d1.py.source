def nd(v,d=1):
 if type(v)is dict:
  a=[nd(x,d+1)for x in v.values()];return 1+len(v)+sum(x[0]for x in a),max([d]+[x[1]for x in a])
 if type(v)is list:
  a=[nd(x,d+1)for x in v];return 1+sum(x[0]for x in a),max([d]+[x[1]for x in a])
 return 1,d
