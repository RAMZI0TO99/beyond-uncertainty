def fresh():
    now = dt.datetime.now(dt.timezone.utc)
    need(dt.datetime.fromisoformat(scope['interval_start']) <= now and (dt.datetime.fromisoformat(scope['interval_end']) - now).total_seconds() > 60, 'effective Source011 and strict 60-second reserve')
    return now.isoformat()

def save(name, obj):
    shape(obj)
    data = (json.dumps(obj, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    need(len(data) <= 2097152, 'metadata output cap')
    fresh()
    target = R / name
    with target.open('xb') as h:
        need(h.write(data) == len(data), 'whole CreateNew write')
        h.flush()
        os.fsync(h.fileno())
    need(raw(target) == data, 'whole output readback')
    return pin(target, data)

