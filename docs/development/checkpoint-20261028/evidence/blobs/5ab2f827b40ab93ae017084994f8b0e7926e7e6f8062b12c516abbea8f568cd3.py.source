"""Root-owned bounded metadata audit. Never imports, parses or invokes subject PS."""
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path

R = Path(__file__).parent
P = Path('D:/Aenv/pro3/runs/coordination/cho51_p3_contracts_20261027_v1')
S = R.parent / 'pro3_bootstrap002_source_review_001'
checks = []

def need(ok, message):
    if not ok:
        raise ValueError(message)

def ck(name, ok, detail=None):
    need(type(ok) is bool, 'Boolean check outcome')
    checks.append(dict(name=name, passed=ok, detail=detail))

def raw(path):
    path = Path(path)
    for q in (path, *path.parents):
        need(not q.is_symlink() and not getattr(q.lstat(), 'st_file_attributes', 0) & 1024, 'direct nonreparse metadata lineage')
    a = path.stat()
    need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and 0 <= a.st_size <= 2097152, 'bounded ordinary single-link metadata')
    with path.open('rb') as h:
        bstat = os.fstat(h.fileno())
        data = h.read(2097153)
        c = os.fstat(h.fileno())
    d = path.stat()
    key = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns)
    need(key(a) == key(bstat) == key(c) == key(d) and len(data) == a.st_size, 'stable same-buffer bytes')
    return data

def pin(path, data=None):
    if data is None:
        data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pairs(items):
    value = {}
    for k, v in items:
        need(k not in value, 'duplicate JSON key')
        value[k] = v
    return value

def bad(value):
    raise ValueError('noninteger or nonfinite JSON number')

def shape(value):
    pending = [(value, 0)]
    nodes = 0
    depth = 0
    while pending:
        v, d = pending.pop()
        nodes += 1
        depth = max(depth, d)
        need(nodes <= 50000 and d <= 48, 'bounded metadata shape')
        need(v is None or type(v) in (dict, list, str, int, bool), 'built-in metadata only')
        if type(v) is str:
            need(not any(55296 <= ord(c) <= 57343 for c in v), 'no Unicode surrogates')
        elif type(v) is list:
            pending.extend((x, d + 1) for x in v)
        elif type(v) is dict:
            need(all(type(k) is str for k in v), 'string JSON keys')
            for k, x in v.items():
                pending.extend(((k, d + 1), (x, d + 1)))
    return dict(nodes_including_keys=nodes, maximum_depth_including_keys=depth)

def doc(path, sha=None, size=None):
    data = raw(path)
    fact = pin(path, data)
    if sha is not None:
        need(fact['sha256'] == sha, 'exact announced SHA: ' + str(path))
    if size is not None:
        need(fact['bytes'] == size, 'exact announced byte count')
    obj = json.loads(data.decode('utf-8'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
    shape(obj)
    return obj, fact

scope, sp = doc(S / 'ROOT_PRO3_NEW_FINITE_SOURCE_ONLY_COEXISTENCE_SCOPE_011_001.json', 'c52dbbfc4a5202bc5476e6b41071d72a1163b339e8bcaad29acf2a6dae70a540', 9049)
