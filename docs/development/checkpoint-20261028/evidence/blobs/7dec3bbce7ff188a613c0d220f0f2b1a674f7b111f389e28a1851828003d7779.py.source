"""Durable human-authorized finite scheduling metadata; no work launched."""
import ctypes, datetime as dt, hashlib, json, shutil
from pathlib import Path
R=Path(__file__).parent.parent; P=Path(r'D:\Aenv\pro3'); D=P/'runs/coordination/cho51_provenance_numerical_worker_20261025_v7'
def pin(p):
 b=p.read_bytes(); assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p,sha=None):
 if sha: assert pin(p)['sha256']==sha
 return json.loads(p.read_bytes())
reqp=D/'compute-request_integration_001.json'; req=load(reqp,'93febea403c13374fd25b3672c99e29965df2dce8f4ad5d5c6f9585449e8b5d8')
pins=load(D/'pins.json','fbb97f491e52deb7f7d2c600fd647fe3f4f4099dd5135916fddcfc27f8040ce7'); review=load(D/'source-review.json','7d1bf8d4091204b9ea06201447de86cec3a3e8640f2650884a9a68848ff914e8')
assert review['accepted'] is True and review['remaining_actionable_findings']==[] and review['source_only'] is True
assert all(review[k] is False for k in ('tests_executed','model_executed','execution_admission'))
assert review['files']==pins['reviewed_files'] and len(review['files'])==13
files=[]
for name,sha in review['files'].items():
 p=P/name; assert p.resolve().is_relative_to(P.resolve()); q=pin(p); assert q['sha256']==sha; files.append(q)
assert sum(x['bytes'] for x in files)==331568
assert req['phase']=='integration' and req['scope']==pins['phase_scopes']['integration'] and req['fixed_output']=='i1'
assert req['tests_current_job']==0 and req['prior_accepted_tests']==63
budget=dict(source_updates=0,restore_count=1,support_updates=1,gradient_updates=1,target_inference_calls=1,query_count=2,model_constructions=1,measured_cells=0)
assert req['expected_numerical_budget']==budget==pins['phase_budgets']['integration'] and all(type(x) is int for x in budget.values())
proofs={}
for kind,name,sha in (('closeout','closeout-tests-result.json','1c1a2083174c6ed1aca9acb6ee1acd9644498d21bb2bc484770412aeb998f929'),('review','tests-final-review.json','41b1a3d9d2d6882ce21ed2c0a1886c1b3bdbb7147db16c3adb597cd785765995'),('lease_closeout','lease-closeout_tests_001.json','5450c41203047664837e05c9404f2243402cfbb531453c05f6b027cac7007963')):
 proofs[kind]=pin(D/name); assert proofs[kind]['sha256']==sha
 assert req['accepted_tests_'+kind+'_path']==str(D/name) and req['accepted_tests_'+kind+'_sha256']==sha
unit=load(D/'tests-final-review.json'); closed=load(D/'lease-closeout_tests_001.json'); result=load(D/'closeout-tests-result.json')
assert unit['passed'] is True and unit['remaining_actionable_findings']==[] and unit['independent_reviewer']=='/root/readiness'
assert unit['tests']==63 and unit['tests_custody_released'] is True and unit['scientific_admission'] is False
assert closed['closed'] is closed['full_compute_custody_explicitly_released'] is True and closed['jobs_consumed']==1 and closed['outstanding_owned_children']==0
assert closed['integration_admitted'] is closed['automatic_retry_permitted'] is closed['scientific_admission'] is False
assert result['passed'] is True and result['backend_calls']==0 and all(type(x) is int and x==0 for x in result['current_counter_ledger'].values())
assert req['maximum_jobs']==1 and req['max_job_seconds']==600 and req['process_mib']==4096 and req['job_mib']==5120
assert req['startup_ram_gib']==req['active_ram_gib']==4 and req['disk_gib']==20 and req['threads']==1 and req['gpu_hidden'] is True
assert req['all_five_genuine_pause_paths_required'] is True and req['requested_window_seconds']==1200 and req['automatic_retry_permitted'] is req['scientific_admission'] is False
assert req['maximum_pro3_active_agents_including_root']==2 and req['prior_grants_003_through_011_consumed_closed'] is True
policy=req['post_terminal_validation_policy']
assert policy['actual_backend_scope_input_audits']==policy['full_origin_physical_verifier_callbacks']==2 and policy['mandatory_external_full_origin_and_original_input_validation'] is True
assert policy['no_content_hash_or_authorization_cache'] is True and policy['actual_input_observations_required']==2
amend=load(D/'owner-resource-amendment.json','12fb1ed58dce9ca4e589ec09dbe52c469bc07d9cfde656550e7574bc835e994d')
assert amend['owner_instruction_exact']==req['owner_instruction_exact']=='use the available ram now!'
priorp=R/'coordination/ROOT_RETAINED_PRO3_011_TESTS_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'; prior=load(priorp)
assert prior['reported_full_compute_custody_released'] is prior['grant_consumed_closed'] is True and prior['Root_acceptance']['peer_result_accepted'] is False
ownp=R/'m3_peer_contracts_016/ROOT_I13_ONCE003_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json'; own=load(ownp,'29b2052441836b07a460ad4256be008ff52774a7063ac49af190eaa04b90e76b')
assert own['retained_console_value']['reaped'] is own['retained_console_value']['streams_drained'] is True and own['Root_suite_acceptance'] is False
v=load(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_011.json','e45e551040123626e88c371df11a8a884c8a16810886d7bdaa0de259beea90c0')
assert max(int(p.stem.rsplit('_',1)[1]) for p in (R/'coordination').glob('PRO2_PRO3_COMPUTE_RELEASE_20261025_*.json'))==11
assert not any(Path(p).exists() for p in v['all_five_pause_paths'])
class Memory(ctypes.Structure):
 _fields_=[('length',ctypes.c_ulong),('load',ctypes.c_ulong)]+[(x,ctypes.c_ulonglong) for x in ('total_phys','available_phys','total_page','available_page','total_virtual','available_virtual','available_extended')]
m=Memory(); m.length=ctypes.sizeof(m); assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m))
now=dt.datetime.now(dt.timezone.utc); resource=dict(observed_utc=now.isoformat(timespec='microseconds'),available_RAM_bytes=m.available_phys,disk_free_bytes=shutil.disk_usage(P).free)
assert m.available_phys>=4*1024**3 and resource['disk_free_bytes']>=20*1024**3
scopep=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'; scope=load(scopep,'caaf2eb42d2394bccb56e34b040259a9f878cb2b57d4c082d2514079885e42b0')
assert dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>1260
for k in ('all_eight_numerical_budget_fields_exact_zero','future_integration_admitted','maximum_reviewed_unit_record_path_characters','prior010_failed_report','prior_grants001_through010_consumed_closed_not_reused','own_I13_once002_saved_refusal_and_custody_closeout'): v.pop(k,None)
v.update(issued_utc=now.isoformat(timespec='microseconds'),window_start_utc=now.strftime('%Y-%m-%dT%H:%M:%SZ'),window_end_utc=(now+dt.timedelta(seconds=1200)).strftime('%Y-%m-%dT%H:%M:%SZ'),scope=req['scope'],phase='integration',fixed_output='i1',request=pin(reqp),verified_13_reviewed_file_pins=files,expected_numerical_budget=budget,exact_engineering_episode=req['exact_engineering_episode'],accepted_external_unit_proofs=proofs,last_resource_observation=resource,prior011_full_compute_custody_release_report=pin(priorp),prior_grants001_through011_consumed_closed_not_reused=True,own_I13_once003_timeout_custody_witness=pin(ownp),current_Pro2_Source_scope=pin(scopep),Root_peer_unit_metadata_join_accepted_for_distinct_scheduling_only=True,post_terminal_validation_policy=policy,
 allowed_action='V7 ENGINEERING INTEGRATION ONLY: one exact fixedi1 episode and exact eight-counter budget from request. Currenttests0/prior63. One600sJob then separately reviewed stdlib external full-origin/213-original-input closeout<=300s before accepted closeout and explicit full custody release. Both actual audits and full verifiers remain insideJob. No retry, secondJob, sourcefit, measuredcells or scientific admission. Peer unit metadata joins are scheduling prerequisites only; Pro2 accepts no peer runtime/scientific/hostquiet/physicalabsence result.')
v['owner_message_evidence']['scope_interpretation']='Same directly authorized engineering integration and available-RAM reply; reviewed v7 distinct oneepisode slot with three new unit proof joins; no oldgrant reuse or science admission.'
out=R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_012.json'
with out.open('xb') as h: h.write((json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode())
print(json.dumps(dict(release=pin(out),window_end_utc=v['window_end_utc'],resource=resource,phase='v7_engineering_integration_only',child_launched=False)))
