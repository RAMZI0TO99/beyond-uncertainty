def need(v,m):
 if not v:raise ValueError(m)
def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=CAP,'bounded singlelink regular file')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size,'stable samebuffer');return b
def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(rows):
 d={}
 for k,v in rows:need(k not in d,'duplicateJSON');d[k]=v
 return d
def finite(x):
 v=float(x);need(math.isfinite(v),'finite historical metadata');return v
def bad(x):raise ValueError('nonfiniteJSON')
def doc(path,expected=None):
 b=raw(path);f=pin(path,b)
 if expected:need(f==expected,'exact prior fact3')
 return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=bad),f
def tree(v,depth=0):
 if type(v) is dict:
  xs=[tree(x,depth+1) for x in v.values()];return 1+len(v)+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 if type(v) is list:
  xs=[tree(x,depth+1) for x in v];return 1+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 return 1,depth
def save(name,v):
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode();n,d=tree(v)
 need(len(b)<=CAP and n<=50000 and d<=48,'original metadata caps')
 need((end-dt.datetime.now(dt.timezone.utc)).total_seconds()>60,'new010strict60reserve')
 p=R/name
 with p.open('xb') as h:need(h.write(b)==len(b),'wholeCreateNew');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'whole saved readback');return pin(p,b)
