"""Propose a new finite Source-only window; preserve every earlier scope."""
import base64, datetime as dt, hashlib, json, os
from pathlib import Path
R=Path(__file__).parent
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file() and not p.is_symlink() and s.st_nlink==1 and s.st_size<=2097152
 for q in (p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes() and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
before=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';p=pin(before)
assert p['sha256']=='726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'
old=raw(before);v=json.loads(old);now=dt.datetime.now(dt.timezone.utc)
assert (dt.datetime.fromisoformat(v['interval_end'])-now).total_seconds()>60
v.update(schema_version=4,created_utc=now.isoformat(),interval_start=now.isoformat(),interval_end=(now+dt.timedelta(hours=2)).isoformat(),
 predecessor_Source_scope=p,Source_scope003_complete_bytes_preserved=True,Source_scope003_review_and_Root_adoption_completed=True,
 Source_scope004_requires_different_review_and_Root_adoption_before_use=True,
 prior_scopes_or_leases_extended=False,source_preparation_only_no_new_operational_lease=True)
v['Source_scope003_requires_different_review_and_Root_adoption_before_use']=False
v['predecessor_Source_scope003_adoption']=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE003_DIFFERENT_REVIEW_ADOPTION_001.json')
v['current_Pro2_diagnostic_handoff']=pin(R/'ROOT_I13_FIXED6_NODE_LEDGER_AND_NEXT_CONTRACT_DECISION_HANDOFF_001.json')
v['current_peer_scheduling_release']=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_015.json')
v['peer_grant015_is_not_extended']=True
v['Pro3_grant015_failed_Job_external_failure_cleanup_and_explicit_full_release_pending_at_preparation']=True
v['scope']+=' New finite Source-only window004 permits exact proposed parent grammar/bootstrap and child-port validation-boundary protocol design plus different review. Existing Sources are unchanged. A replacement must preserve all semantic validation duties explicitly, every original input and cap, conservative separate-cache full child addition and result54. No positive Source fit follows from a symbolic model with unresolved cells. New target Source authoring still requires an exact genuinely reviewed protocol and separate Root adoption. No new pure snapshot or test call is admitted automatically. Prior once scopes remain consumed and all execution gates remain held.'
out=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004.json'
inverse=R/'ROOT_I13_SOURCE_SCOPE004_COMPLETE003_PREDECESSOR_INVERSE_001.json'
def write(p,v):
 b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(p)
 assert (dt.datetime.fromisoformat(json.loads(old)['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert raw(p)==b
write(out,v)
write(inverse,dict(author='/root',Source_only=True,predecessor=p,complete_predecessor_base64=base64.b64encode(old).decode(),proposed_successor=pin(out),prior_scopes_or_leases_extended=False))
print(json.dumps(dict(proposed_Source_scope=pin(out),complete_predecessor_inverse=pin(inverse),interval_end=v['interval_end'],operational_lease_issued=False)))
