result=O/'SUPERVISOR_RESULT_001.json';s=load(result);w=C/'ROOT_I13_ONCE002_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json';wv=load(w)
assert s['exit_code']==1 and s['acceptance_at_record_preparation'] is False and s['refusal'] is None and s['child_result_absent'] is True and s['known_case_pass_prefix_from_complete_stdout']==8
assert s['reaped'] is s['streams_drained'] is True and all(s['actual_stream_EOF'].values()) and s['killed'] is s['terminated'] is False
assert wv['Root_observed_tool_exit_code']==1 and wv['Root_suite_acceptance'] is False and wv['first_M3_template_expected_positive_passed'] is True
for p in (pin(result),pin(w)):assert p in c['subjects'] and p in f['subjects']
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json';sc=load(scope);now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sc['interval_start'])<=now and (dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_once002_different_saved_refusal_and_owned_cleanup_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_ONCE002_SAVED_REFUSAL_AND_OWNED_CLEANUP_ONLY',Source_scope=pin(scope),different_saved_refusal_review=pin(cap),full_proof=pin(full),supervisor_result=pin(result),parent_tool_witness=pin(w),consumed_scope=s['scope'],claim=s['claim'],checks_passed=60,checks_failed=0,complete_suite_pass=False,known_complete_case_pass_prefix=8,unestablished_case_count=928,first_M3_template_expected_positive_passed=True,next_case='i13_m3_complete_manifest',failure_stage='Fixture construction before manifest validator entry',actual_fixture_exception='KeyError',exception_text="'wrapper'",recorded_supervisor_refusal=None,own_once002_parent_and_owned_child_custody_closed=True,owned_child_reaped=True,owned_streams_drained_to_EOF=True,claim_reuse_or_replay_authorized=False,repair_requires_exact_new_Source_review_Root_adoption_and_fresh_scope=True,full_I2_G01_closed=False,actual_family_publication=False,Native8_Parser_runtime_science_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_or_physical_PID_absence_accepted=False)
out=C/'ROOT_I13_ONCE002_DIFFERENT_SAVED_REFUSAL_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(b)
print(json.dumps(dict(adoption=pin(out),suite_pass=False,scope002_consumed=True,own_custody_closed=True)))
