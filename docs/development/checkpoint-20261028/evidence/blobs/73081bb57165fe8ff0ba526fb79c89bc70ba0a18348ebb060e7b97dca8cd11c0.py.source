"""Own metadata-only spelling successor; target modules remain untouched/unrun."""
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
def pin(path):
    raw=Path(path).read_bytes();assert 0<len(raw)<=2097152
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
prior=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_003.json'
v=json.loads(prior.read_bytes())
old=v['catalogue_and_budget']['common_catalogue']
new=old.replace('peer_base_catalogue_pin','peer_base_catalogue').replace('peer_role_data_pin','peer_role_data')
assert old!=new
v['catalogue_and_budget']['common_catalogue']=new
v['previous_complete_protocol']=pin(prior)
v['created_utc']=dt.datetime.now(dt.timezone.utc).isoformat()
v['author_tool']=pin(Path(__file__))
# Historical version labels in acyclic-binding prose refer to the current core.
for parent,key in ((v,'remaining_exact_freeze'),(v['exact_additive_resolution'],'acyclic_binding')):
    parent[key]=parent[key].replace('protocol003','protocol004').replace('peer003','peer004')
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_004.json'
with path.open('xb')as stream:stream.write(raw)
print(json.dumps(pin(path),sort_keys=True))
