check('metadata_route_detached_rawbytes',"_need(type(raw) is bytes,'E_LAYER_RESULT')"in route and route.rstrip().endswith('return raw'),'Only fixed publisher returns metadata bytes; its own layer validates m3/peer and combined counts.')

