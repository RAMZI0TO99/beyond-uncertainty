check('manifest_literal_cases_and_unique_ASCII',all(t in manifest for t in ('ast.literal_eval(assigns[0].value)','len(names)==len(set(names))',"re.fullmatch('[A-Za-z0-9_.:-]+',n)","names=value['case_names_by_fixture']['m3_publisher']+value['case_names_by_fixture']['peer']")),'Names extracted without importing fixture.')
check('manifest_exact_four_keyword_fixture_signature',all(t in manifest for t in ("not run.args.args","not run.args.posonlyargs","not run.args.vararg","not run.args.kwarg","['m3','publisher','peer','catalogue_bytes']","all(x is None for x in run.args.kw_defaults)")),'No arbitrary callback or signature widening.')
