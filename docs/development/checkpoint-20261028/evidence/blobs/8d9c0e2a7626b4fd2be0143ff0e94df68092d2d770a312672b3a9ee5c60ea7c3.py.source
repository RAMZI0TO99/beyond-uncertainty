    check(name+'_never_launches_or_executes_subject',not any(isinstance(n,ast.Call)and ((isinstance(n.func,ast.Name)and n.func.id in ('exec','eval','__import__'))or(isinstance(n.func,ast.Attribute)and n.func.attr in ('Popen','run','exec_module','spawn','start')))for n in ast.walk(tree)),'Own helper is metadata only; AST/compile/ctypes resource query does not call subject functions.')
