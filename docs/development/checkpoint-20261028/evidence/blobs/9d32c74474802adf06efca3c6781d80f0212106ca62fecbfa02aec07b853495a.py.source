def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=CAP,'singlelink regular bounded bytes')
 with p.open('rb') as h:
  d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size<=CAP,'stable samehandle/path bytes');return b

def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def parse(b):
 def pairs(rows):
  d={}
  for k,v in rows:need(k not in d,'duplicate JSONkey');d[k]=v
  return d
 def finite(x):
  v=float(x);need(math.isfinite(v),'finite JSON');return v
 def reject(x):raise ValueError('nonfinite JSONconstant')
 return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=reject)

def doc(path,sha):
 b=raw(path);p=pin(path,b);need(p['sha256']==sha,'exact whole prior pin');return parse(b),p

def tree(v,depth=1):
 if type(v) is dict:
  xs=[tree(x,depth+1) for x in v.values()];return 1+len(v)+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 if type(v) is list:
  xs=[tree(x,depth+1) for x in v];return 1+sum(x[0] for x in xs),max([depth]+[x[1] for x in xs])
 return 1,depth

def write(name,v):
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');n,d=tree(v)
 need(len(b)<=CAP and n<=50000 and d<=48,'original own metadata caps')
 now=dt.datetime.now(dt.timezone.utc);need((end-now).total_seconds()>60,'new Source008 proposal strict60reserve')
 path=R/name
 with path.open('xb') as h:need(h.write(b)==len(b),'complete exclusiveCreate');h.flush();os.fsync(h.fileno())
 need(raw(path)==b,'whole saved readback');return pin(path,b)

def git(*args):
 env=dict(os.environ);env['GIT_OPTIONAL_LOCKS']='0'
 p=subprocess.run(['git','--no-optional-locks','-c','safe.directory=D:/Aenv/pro2/github-portable-20261012-001',*args],cwd=REPO,env=env,capture_output=True,timeout=45)
 need(p.returncode==0 and len(p.stdout)<=CAP and len(p.stderr)<=CAP,'bounded successful read-only Git');return p.stdout.decode('utf8')

