"""Root adopt exact genuinely reviewed finite Source006, never execution."""
import datetime as dt,hashlib,json,os,sys
from pathlib import Path
R=Path(__file__).parent
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file() and not p.is_symlink() and s.st_nlink==1 and s.st_size<=2097152
 for q in (p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes() and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def read(p):return json.loads(raw(p))
assert len(sys.argv)==3;cp=Path(sys.argv[1]);assert cp.is_relative_to(R) and pin(cp)['sha256']==sys.argv[2]
c=read(cp);fp=c['full_proof'];assert pin(fp['path'])==fp;f=read(fp['path']);checks=f['checks']
assert c['reviewer']==f['reviewer']=='/root/project_architecture' and c['verdict']==f['verdict'] and c['verdict'].startswith('PASS_')
assert c['checks_failed']==f['checks_failed']==0 and len(checks)==len({x['name'] for x in checks})==c['checks_passed']==f['checks_passed'] and all(x['passed'] is True for x in checks)
sp=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_006.json';s=read(sp);assert pin(sp)==c['Source_scope']
assert s['new_operational_execution_lease_issued'] is s['target_execution'] is s['operational_authority'] is s['scientific_authority'] is False
assert s['maximum_local_agents_including_Root']==3 and s['maximum_shared_including_both_roots_and_overlap']==5 and s['publication_reserve_seconds']==60
assert s['interval_end']=='2026-10-25T21:55:00+00:00' and s['grant020_issued'] is s['current_aggregate_admission_or_attempt_authorized'] is False
old=read(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_005.json');assert pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_005.json')['sha256']=='df9d87bcd45f130a8139743fa2eccbc9f4355b46123679a83e2d0ba6c7c850c4'
now=dt.datetime.now(dt.timezone.utc);assert (dt.datetime.fromisoformat(old['interval_end'])-now).total_seconds()>60 and dt.datetime.fromisoformat(s['interval_start'])<=now and (dt.datetime.fromisoformat(s['interval_end'])-now).total_seconds()>60
assert not os.path.lexists(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_020.json')
v=dict(schema_version=1,record_type='Root_current_Source006_different_Source_review_adoption',author='/root',created_utc=now.isoformat(),Source_scope=pin(sp),genuine_different_review_capsule=pin(cp),full_review=fp,checks_passed=len(checks),checks_failed=0,interval_start=s['interval_start'],interval_end=s['interval_end'],prior_scopes_or_leases_extended=False,
 Root_decision='Adopt exact finite Source-only006 for unchanged metadata/protocol preparation and owner-authorized peer-resource coordination until21:55UTC. Aggregate001 remains NOT_ALLOCATED for sourceownership defect. Immutable repaired successors require exact different Source/input review and separate fresh allocation decision. No advance interpreter/Job/test/new target Source/Sourcefit/legacycompatibility/operational lease/primarydocumentpublication/Gitpush follows. All original caps, reserve, agent limits and execution gates remain held.',
 new_peer_compute_or_aggregate_automatically_authorized=False,new_synthetic_or_test_calls_automatically_authorized=False,new_target_Source_automatically_authorized=False,current_compact_ABI_protocol_ready=False,peer_results_accepted=False,actual_family_publication=False,actual6=False,Native8=False,Parser=False,runtime=False,science=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_claimed=False,physical_handle_absence_claimed=False)
out=R/'ROOT_I13_CURRENT_SOURCE_SCOPE006_DIFFERENT_REVIEW_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb') as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert raw(out)==b;print(json.dumps(dict(adoption=pin(out),Source_end=s['interval_end'],operational_lease_issued=False)))
