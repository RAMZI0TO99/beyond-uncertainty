"""Propose a fresh Source-only window; never extend old scope or grant compute."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
before=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json';p=pin(before);assert p['sha256']=='f3c4b711fade603e97d9e41cb26b8135914a2c1b0073cdc62084d11090a3ed66'
v=json.loads(before.read_bytes());now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(v['interval_start'])<=now and (dt.datetime.fromisoformat(v['interval_end'])-now).total_seconds()>60
v.update(schema_version=2,created_utc=now.isoformat(timespec='microseconds'),interval_start=now.isoformat(timespec='microseconds'),interval_end=(now+dt.timedelta(hours=4)).isoformat(timespec='microseconds'),predecessor_Source_scope=p,old_Source_scope001_complete_bytes_preserved=True,overlap_does_not_add_agent_slots=True,same_combined_local3_shared5_throughout_overlap=True,inert_managed_publication_maximum_rows=512,inert_managed_publication_maximum_payload_bytes=67108864,Source_scope002_requires_different_review_and_Root_adoption_before_use=True)
v.pop('current_Pro3_tests_only_grant007_consumed_or_active_not_reused')
v['current_Pro3_grant011']=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_011.json')
v['Pro3_grant011_reported_Job_complete_external_closeout_and_explicit_full_release_still_pending_at_preparation']=True
v['prior_I13_consumed_scope_refusal_adoptions']=[pin(C/('ROOT_I13_ONCE'+n+'_DIFFERENT_SAVED_REFUSAL_ADOPTION_001.json')) for n in ('001','002')]
v['scope']+=' Continue exact new pure diagnostic Source qualification and separately reviewed inert closeout. This fresh window adds no operational or automatic synthetic admission; every new synthetic scope remains separately reviewed/adopted and once-only. A separately reviewed packaging selection may encode complete metadata author/review helper Source bytes in bounded JSON Base64 bundles; target/kernel/fixture Source stays direct inert copies, all original bytes/hashes reconstruct exactly, and all original file/count/byte caps remain unchanged.'
out=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(b)
print(json.dumps(dict(proposed_Source_scope=pin(out),interval_end=v['interval_end'],execution_lease_issued=False)))
