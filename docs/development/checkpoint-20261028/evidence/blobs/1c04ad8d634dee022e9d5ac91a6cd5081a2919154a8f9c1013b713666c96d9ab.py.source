"""Own read/AST/strictJSON corrective metadata; never executes I2 or new kernels."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).parent
ROOT = Path(r'D:\Aenv\pro2')

def fact(path, raw=None):
    raw = path.read_bytes() if raw is None else raw
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

def read(path):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise ValueError('duplicate key')
            out[key] = value
        return out
    def reject(token):
        raise ValueError(token)
    return json.loads(path.read_bytes(), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)

def save(name, value):
    raw = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode()
    if len(raw) > 2097152:
        raise ValueError('cap')
    with (HERE / name).open('xb') as handle:
        handle.write(raw)
    if (HERE / name).read_bytes() != raw:
        raise ValueError('readback')
    return fact(HERE / name, raw)

def main():
    c4 = HERE / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_004.json'
    p4 = HERE / 'I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_004.json'
    source = ROOT / r'WORK\resume-20261025-002\receipt_caller_integration_015\i2\build_M3_metadata_current_owner_deferred_006.py'
    raw = source.read_bytes()
    tree = ast.parse(raw, filename=str(source))
    function = next(node for node in tree.body if isinstance(node,ast.FunctionDef) and node.name == 'read')
    observation = next(node for node in ast.walk(function) if isinstance(node,ast.Assign)
        and isinstance(node.value,ast.Call) and isinstance(node.value.func,ast.Name) and node.value.func.id == 'dict'
        and any(isinstance(target,ast.Subscript) and isinstance(target.value,ast.Name) and target.value.id == 'OBSERVATIONS' for target in node.targets))
    fields = [keyword.arg for keyword in observation.value.keywords]
    expected = ['path','sha256','bytes','cap','path9','descriptor9','shared_identity_indexes','two_read_match','observed_utc']
    if fields != expected:
        raise ValueError('actual I2 observation9 fields changed')
    lines = raw.splitlines(keepends=True)
    fragment = b''.join(lines[function.lineno-1:function.end_lineno])
    clarification = {
        'schema_version': 1,
        'record_type': 'I13_exact_original_I2_receipt22_observation9_metadata_correction',
        'author': '/root/project_architecture',
        'created_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),
        'state': 'PROPOSAL_REQUIRES_DIFFERENT_REVIEW_AND_ROOT_ADOPTION_BEFORE_SOURCE_FREEZE',
        'Source': fact(source,raw),
        'actual_read_function': {'first_line': function.lineno, 'last_line': function.end_lineno,
            'bytes': len(fragment), 'sha256': hashlib.sha256(fragment).hexdigest(),
            'AST_sha256': hashlib.sha256(ast.dump(function,include_attributes=False).encode()).hexdigest()},
        'actual_OBSERVATIONS_assignment': {'first_line': observation.lineno, 'last_line': observation.end_lineno,
            'exact_fields_in_order': fields, 'field_count': 9},
        'prior_adopted_catalogue': fact(c4), 'prior_adopted_protocol': fact(p4),
        'affected_slot': '/schemas/receipt22/fields/finite_actual_Source_observations',
        'wrong_previous_descriptor': 'complete_unique_observation12_list',
        'correct_descriptor': 'complete_unique_M3_read_observation9_list',
        'normative_rule': [
            'Preserve actual original I2_006 closed9 observations in receipt22, without modifying any I2 source, renderer, IO algorithm or receipt22 keys/version/type. This is an ABI correction to new I13 schema data, not additional fields fabricated on historical or future I2 output.',
            'Each observation is a strict builtin dict with exact9 fields path/sha256/bytes/cap/path9/descriptor9/shared_identity_indexes/two_read_match/observed_utc. Path and pin wire exact; SHA lowercase64; size/cap strict positive builtinint and actual role/metadata cap. Supplied full body length/SHA match. observed_utc exact ASCII UTC6, not future under recorded now.',
            'path9 and descriptor9 each exact9 builtin nonnegative integers, ordinary mode/file attributes/single link constraints retained; sizes equal recordedbody. shared_identity_indexes exact builtin list[0,1,2,3,6,7,8], those selected values equal across APIs. two_read_match builtinTrue. Path/descriptor nonshared ctime/mode may differ as inherited contracts allow; do not require full9 equality or timestamp normalization.',
            'Actual I2 read Source already enforces independent whole path9 and descriptor9 stability across paired reads. Observation9 records no extra raw9/shared_descriptor7/both_full_API9_independently_stable fields, and the new metadata kernel must not invent them or claim physical measurement/authentication. Source provenance and recorded metadata checks remain the limited boundary.',
            'Publisher observation12, publication_pair2, selectedpublication31 and reconciliation observation12 remain byte-for-byte schema identical to catalogue004. Only M3 receipt22 observation-list item type changes; other lists do not switch implicitly.',
            'All caps, hash/type/actor/proof/chronology/depth48/node50000/records256/raw32MiB counters and conservative fixed-port accounting remain unchanged. Existing common004 reviews/Rootadoption remain dated history with this exact predicate limitation; Source targets have not been run.',
        ],
        'finite_required_controls': [
            'Positive exact original9 metadata in each complete M3 stage, including allowed nonshared full9 difference; publisher12 remains positive in publication graphs.',
            'Each of9 requiredkeys missing/extra, bool/int/subclass/invalidtimestamp, wrongpin/body/cap/shared7/link/reparse/mode refusal reaches intended typedpredicate.',
            'Real publication12 substituted at receipt22 observation slot refuses closedshape; original9 substituted into publication12 refuses its closedshape. No fallback by field superset.',
            'Own Source/AST inventory verifies unchanged I2 bytes and observation assignment; no calls/imports/tests of I2 or new modules are performed during correction.',
        ],
        'target_Source_executed': False, 'tests_executed': False, 'target_execution': False,
        'operational_authority': False, 'scientific_authority': False,
        'full_original_I2_DAG_closed': False, 'actual_peer_content_qualified': False,
        'current_canonical_authority_qualified': False,
    }
    clarification_pin = save('I13_PROPOSED_ORIGINAL_I2_RECEIPT22_OBSERVATION9_CORRECTION_001.json',clarification)
    c, p = read(c4),read(p4)
    c['predecessor_unadopted_catalogue'] = fact(c4)
    c['original_I2_observation9_correction'] = clarification_pin
    c['schemas']['M3_read_observation9'] = {
        'builtin_type': 'dict', 'additional_fields_allowed': False, 'exact_keys': fields, 'field_count': 9,
        'fields': {'path':'native_absolute_path','sha256':'lower_ascii_hex64','bytes':'positive_builtin_int',
            'cap':'exact_role_or_metadata_cap','path9':'raw9','descriptor9':'raw9',
            'shared_identity_indexes': {'builtin_type':'list','literal':[0,1,2,3,6,7,8]},
            'two_read_match': {'builtin_type':'bool','literal':True}, 'observed_utc':'utc6'}}
    c['schemas']['receipt22']['fields']['finite_actual_Source_observations'] = 'complete_unique_M3_read_observation9_list'
    catalogue_pin = save('I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_005.json',c)
    p['predecessor_unadopted_proposal'] = fact(p4)
    p['catalogue'] = catalogue_pin
    p['original_I2_observation9_correction'] = clarification_pin
    p['M3_exact_join_and_preservation_rules'].append('M3 receipt22 finite_actual_Source_observations is the exact original closed9 recorded read metadata per original_I2_observation9_correction; publication observation12 remains separate unchanged. No fabricated full-API/staging fields and no physical provenance promotion.')
    p['exact_correction_inventory'] += ['Catalogue005 changes only receipt22 finite observation list item schema to actual original I2 closed9 and adds that exact9 schema; publisher observation12 remains exact004. All I2_006/caller003 bytes and original algorithms unchanged.']
    p['finite_required_controls']['positive'] += ['actualI2receipt22 observation9 with allowed nonsharedAPI difference, separately publication12']
    p['finite_required_controls']['refusal'] += ['all9 observationkeys/types/pin/cap/body/time/shared7/ordinaryfields, real12vs9 cross-substitution without fallback']
    p['adoption_subject_policy'] = 'Completecommon005proposal/catalogue plus exact observation9 clarification and genuine different review require freshRootcorrectiveadoption before Sourcefreeze. Preservecommon004/adoption002 and all previous proofs as dated Source-only history with this exact observation predicate limitation. All prior LFannex002/peer004/data001 bindings and authorityholds remain unchanged.'
    protocol_pin = save('I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_005.json',p)
    print(json.dumps({'clarification':clarification_pin,'catalogue':catalogue_pin,'protocol':protocol_pin}))

if __name__ == '__main__':
    main()
