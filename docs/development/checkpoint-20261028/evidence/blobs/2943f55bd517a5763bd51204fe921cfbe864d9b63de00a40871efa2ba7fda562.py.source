"""Root narrow protocol adoption metadata only; no builder, kernel or old Target calls."""
import datetime as dt, hashlib, json, os, re, sys
from pathlib import Path
R=Path(__file__).parent
P=R/'m3_peer_contracts_016/m3_protocol_audit_001/input_node_readset_ledger_protocol_proposal_001/I13_PROPOSED_FIXED_M3_INPUT_NODE_AND_SOURCE_READSET_LEDGER_PROTOCOL_002.json'
LIMIT=2097152
def raw(p):
 p=Path(p); a=p.stat()
 assert p.is_file() and not p.is_symlink() and a.st_nlink==1 and 0<a.st_size<=LIMIT
 for q in (p,*p.parents): assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes(); z=p.stat()
 assert b==p.read_bytes() and len(b)==a.st_size==z.st_size and a.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 p=Path(p); b=raw(p); return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def read(p): return json.loads(raw(p))
def occurs(v,p):
 if type(v) is dict: return v==p or any(occurs(x,p) for x in v.values())
 return type(v) is list and any(occurs(x,p) for x in v)
assert len(sys.argv)==4
cpath,csha,psha=sys.argv[1:]
assert all(re.fullmatch('[0-9a-f]{64}',v) for v in (csha,psha))
cp=Path(cpath); assert cp.parent==R/'input_node_readset_ledger_protocol_different_Source_review_001'
assert pin(cp)['sha256']==csha and pin(P)['sha256']==psha
cap=read(cp); fullp=cap['full_proof']; assert pin(fullp['path'])==fullp
full=read(fullp['path']); proposal=read(P)
assert proposal['author']=='/root/project_architecture'
assert cap['reviewer']==full['reviewer']=='/root/i13_final_review'
assert cap['verdict']==full['verdict'] and (cap['verdict']=='PASS' or cap['verdict'].startswith('PASS_'))
assert type(cap['checks_failed']) is int and cap['checks_failed']==full['checks_failed']==0
checks=full['checks']; assert type(checks) is list and len(checks)>190
assert all(type(x) is dict and x.get('passed') is True and type(x.get('name')) is str for x in checks)
assert len({x['name'] for x in checks})==len(checks)==cap['checks_passed']==full['checks_passed']
assert occurs(cap,pin(P)) and occurs(full,pin(P))
for subject in cap['subjects']:
 assert type(subject) is dict and set(subject)=={'path','bytes','sha256'} and pin(subject['path'])==subject
for obj in (cap,full):
 assert all(obj[k] is False for k in ('target_execution','operational_authority','scientific_authority','actual_family_publication','native_Parser_executed','tests_executed'))
oldp=P.with_name('I13_PROPOSED_FIXED_M3_INPUT_NODE_AND_SOURCE_READSET_LEDGER_PROTOCOL_001.json')
assert pin(oldp)['sha256']=='deb07af94e9f07c58dcfb4674a54b76426d9cff3b012f01d7bc3277ac53b5565'
refp=R/'input_node_readset_ledger_protocol_different_Source_review_001/INDEPENDENT_I13_INPUT_NODE_READSET_LEDGER_PROTOCOL001_SOURCE_REFUSAL_CAPSULE_001.json'
assert pin(refp)['sha256']=='f0f8cc396180f3361b5cc1b0c9f5769ecda0d3b51834fb958df1b11d23c5631f'
ref=read(refp); assert ref['checks_passed']==192 and ref['checks_failed']==1
sourcep=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json'; source=read(sourcep)
assert pin(sourcep)['bytes']==8839 and pin(sourcep)['sha256']=='726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'
now=dt.datetime.now(dt.timezone.utc)
assert source['author']=='/root' and source['target_execution'] is source['operational_authority'] is False
assert dt.datetime.fromisoformat(source['interval_start'])<=now and (dt.datetime.fromisoformat(source['interval_end'])-now).total_seconds()>60
value=dict(schema_version=1,record_type='Root_I13_fixed_input_node_ledger_protocol002_different_Source_review_adoption',
 author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_INPUT_NODE_LEDGER_PROTOCOL002_SOURCE_IMPLEMENTATION_PREPARATION_ONLY',
 proposal=pin(P),genuine_different_Source_capsule=pin(cp),genuine_different_Source_full_proof=fullp,
 checks_passed=len(checks),checks_failed=0,Source_scope=pin(sourcep),prior_refused_proposal=pin(oldp),
 prior_refusal_capsule=pin(refp),prior_refusal_preserved=True,Source_subjects=cap['subjects'],
 Root_judgment='Accept the exact data-only input inventory and hypothetical Source readset/count protocol. Its six roles and two routes are fixed; proposed first crossings are conditional plans, never an observed Target trace. Implementation and Root controls each require separate exact genuine different Source review and Root adoption before any once diagnostic.',
 metadata_only=True,new_implementation_preparation_permitted=True,snapshot_calls_admitted=0,kernel_exports_called=0,
 tests_executed=False,target_execution=False,actual_family_publication=False,operational_authority=False,
 scientific_authority=False,native_Parser_executed=False,Native8=False,runtime=False,science=False,
 full_original_I2_DAG_closed=False,authentic_loader_qualified=False,claim_reuse_or_replay_authorized=False,
 supervisor_and_admission_separate_Source_acceptance_required=True,fresh_once_scope_required=True,
 peer_explicit_full_custody_release_required=True,combined_metadata_nodes_cap=50000)
out=R/'ROOT_I13_FIXED_INPUT_NODE_LEDGER_PROTOCOL002_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
body=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
assert len(body)<=LIMIT and not os.path.lexists(out)
with out.open('xb') as h: assert h.write(body)==len(body); h.flush(); os.fsync(h.fileno())
assert raw(out)==body
print(json.dumps(dict(adoption=pin(out),checks_passed=len(checks),implementation_calls=0,execution_admitted=False)))
