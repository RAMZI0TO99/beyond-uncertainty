"""Retain own checker correction only; never invokes a reviewed subject."""
from pathlib import Path
import datetime as dt,hashlib,json,os
D=Path(__file__).parent
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
a=D/'review_Source008_package_001.py';b=D/'review_Source008_package_002.py';x=a.read_bytes();y=b.read_bytes()
assert x.count(b'0<a.st_size<=2097152')==1 and x.replace(b'0<a.st_size<=2097152',b'0<=a.st_size<=2097152')==y
full=D/'INDEPENDENT_I13_SOURCE008_WORKSPACE_INTERFACE_ADOPTER002_SOURCE_FULL_PROOF_001.json';cap=D/'INDEPENDENT_I13_SOURCE008_WORKSPACE_INTERFACE_ADOPTER002_SOURCE_CAPSULE_001.json'
f=json.loads(full.read_bytes());c=json.loads(cap.read_bytes());assert f['checks_passed']==c['checks_passed']==94 and f['checks_failed']==c['checks_failed']==0 and c['full_proof']==fact(full,full.read_bytes())
v=dict(schema_version=1,record_type='Independent_Source008_own_pre_output_checker_correction_history',reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),original_checker=fact(a,x),corrected_checker=fact(b,y),original_tool_chunk='9bac1c',original_exit_code=1,original_review_outputs_written=0,original_checker_refusal='Own checker incorrectly required positive byte length for every repository baseline member; ten retained empty stderr witnesses are legitimate zero-byte original pins.',correction='Only change own raw-reader minimum from positive to nonnegative byte length. Exact saved zero-byte SHA256 pins and all original subject bytes remain unchanged; no subject failure, alteration or replay is claimed.',success_tool_chunk='11195e',success_exit_code=0,checks_passed=94,checks_failed=0,full_proof=fact(full,full.read_bytes()),capsule=fact(cap,cap.read_bytes()),subject_Sources_imported_or_compiled=False,target_execution=False,raw_capture_admitted=False,tests_executed=False,ready_for_execution=False)
z=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');assert len(z)<2097152 and(dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
p=D/'INDEPENDENT_SOURCE008_OWN_CHECKER_MINIMUM_LENGTH_CORRECTION_HISTORY_001.json'
with p.open('xb')as h:assert h.write(z)==len(z);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==z;print(json.dumps(fact(p,z)))
