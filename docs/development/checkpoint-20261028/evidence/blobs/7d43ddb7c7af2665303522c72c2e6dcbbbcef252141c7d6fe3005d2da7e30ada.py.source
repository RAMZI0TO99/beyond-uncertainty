"""Root standard-library metadata publication helper; no target imports/calls.

Prepare an exact additive inert-copy candidate, then publish that same candidate
only after an independently reviewed Root adoption names its exact whole pin.
Every candidate, copy, index and receipt mutation renews the original60 reserve.
A refusal raises before that mutation; any prior created copies stay preserved.
No post-cutoff managed acceptance or automatic rollback is performed; minimal
Root refusal bookkeeping is a separate own-metadata reconciliation.
"""
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import sys

ROOT = Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
SUBJECTS = ROOT / 'm3_peer_contracts_016'
PUB = ROOT / 'publication_001'
REPO = Path(r'D:\Aenv\pro2\github-portable-20261012-001')
DEST = REPO / 'docs/development/native-producer-qualification/20261025-i13'
SCOPE = ROOT / 'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'
BASELINE = ROOT / 'ROOT_I13_INITIAL_REPOSITORY_BYTES_BASELINE_001.json'
CAP = 2097152


def need(value, why):
    if not value:
        raise ValueError(why)


def utc():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')


def body(path):
    need(path.is_absolute(), 'absolute file')
    for p in (path, *path.parents):
        q = p.lstat()
        need(not p.is_symlink() and not getattr(q, 'st_file_attributes', 0) & 1024, 'ordinary path')
    a = path.stat()
    need(path.is_file() and a.st_nlink == 1 and 0 <= a.st_size <= CAP, 'bounded ordinary metadata or inert Source')
    with path.open('rb') as h:
        raw = h.read(CAP + 1)
        h.seek(0)
        again = h.read(CAP + 1)
    b = path.stat()
    need(raw == again and len(raw) == a.st_size == b.st_size and
         all(getattr(a, n, None) == getattr(b, n, None) for n in
             ('st_dev', 'st_ino', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes')), 'stable complete metadata bytes')
    return raw


def pin(path, raw=None):
    if raw is None:
        raw = body(path)
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()


def save(path, raw):
    need(0 <= len(raw) <= CAP and not os.path.lexists(path), 'fresh bounded output')
    for parent in path.parents:
        if parent.exists():
            info = parent.lstat()
            need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary existing destination parents before directory creation')
    fresh()
    path.parent.mkdir(parents=True, exist_ok=True)
    for parent in path.parents:
        info = parent.lstat()
        need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary destination parents before exclusive file write')
    need(not os.path.lexists(path), 'destination still unused')
    fresh()
    with path.open('xb') as h:
        need(h.write(raw) == len(raw), 'whole write')
        h.flush()
        os.fsync(h.fileno())
    need(body(path) == raw, 'actual whole copy readback')
    return pin(path, raw)


def occurs(value, expected):
    if type(value) is dict:
        if value == expected:
            return True
        return any(occurs(x, expected) for x in value.values())
    return type(value) is list and any(occurs(x, expected) for x in value)


def baseline():
    baseline_raw = body(BASELINE)
    value = json.loads(baseline_raw)
    pins = [r['pin'] for r in value['status_records']] + value['primary_documents'] + value['canonical_manifests'] + [value['current_workspace_pointer']]
    need(len(value['status_records']) == 409, 'original409 repository status identities')
    need(len(value['primary_documents']) == 6 and len(value['canonical_manifests']) == 2, 'exact six primary documents and two canonical manifests')
    for p in pins:
        need(pin(Path(p['path'])) == p, 'preserve original repository input bytes')
    return dict(baseline=pin(BASELINE, baseline_raw), checked_pins=len(pins), all_exact=True,
                original_status_identities=409, primary_documents=6, canonical_manifests=2,
                workspace_pointer_unchanged=True)


def fresh():
    raw = body(SCOPE)
    scope = json.loads(raw)
    now = dt.datetime.now(dt.timezone.utc)
    need(scope['author'] == '/root' and scope['target_execution'] is False and scope['operational_authority'] is False, 'Source-only Root scheduling')
    need(dt.datetime.fromisoformat(scope['interval_start']) <= now and
         (dt.datetime.fromisoformat(scope['interval_end']) - now).total_seconds() > 60, 'original60 publication reserve')
    return pin(SCOPE, raw)


def prepare(nav):
    scope = fresh()
    preservation = baseline()
    need(nav.is_relative_to(PUB) and nav.is_file(), 'prepared navigation in dedicated publication directory')
    need(not os.path.lexists(DEST) and not os.path.lexists(REPO / 'CONTINUE_CURRENT_I13_20261025.json'), 'unused managed destination and navigation')
    rows = []
    for source in sorted(ROOT.rglob('*')):
        if not source.is_file() or source.is_relative_to(PUB):
            continue
        need(source.suffix in ('.json', '.py', '.txt', '.source', '.draft'), 'metadata and inert Source only')
        relative = source.relative_to(SUBJECTS) if source.is_relative_to(SUBJECTS) else Path('root_workspace') / source.relative_to(ROOT)
        if source.suffix == '.py':
            relative = Path(str(relative) + '.source')
        destination = DEST / relative
        rows.append(dict(source=pin(source), destination=str(destination), relative_path=destination.relative_to(REPO).as_posix(), source_copy_inert=source.suffix in ('.py', '.source', '.draft')))
    destination = REPO / 'CONTINUE_CURRENT_I13_20261025.json'
    rows.append(dict(source=pin(nav), destination=str(destination), relative_path=destination.relative_to(REPO).as_posix(), source_copy_inert=False))
    need(1 <= len(rows) <= 512 and sum(x['source']['bytes'] for x in rows) <= 67108864, 'bounded additive inventory')
    need(len({x['destination'].casefold() for x in rows}) == len(rows), 'unique managed destinations')
    need(all(not os.path.lexists(x['destination']) for x in rows), 'all managed file identities unused')
    value = dict(schema_version=1, record_type='Root_I13_exact_additive_inert_managed_publication_candidate', author='/root', created_utc=utc(),
        source_scope=scope, baseline_preservation=preservation, files=rows, file_count=len(rows),
        payload_bytes=sum(x['source']['bytes'] for x in rows), exact_index_destination=str(DEST / 'MANAGED_I13_PORTABILITY_INDEX_001.json'),
        publication_helper=pin(Path(__file__)), publication_reserve_seconds=60,
        transforms='Only .py filenames receive .source suffix; all complete bytes and internal original-path pins remain exact.',
        previous_evidence_and_primary_documents_preserved=True, original75_spent_identities_unreplayed=True,
        target_execution=False, tests_executed=False, actual_family_publication=False, operational_authority=False, scientific_authority=False,
        no_step081_or_operational_lease=True, staged=False, committed=False, pushed=False)
    result = save(PUB / 'ROOT_I13_EXACT_MANAGED_PUBLICATION_CANDIDATE_001.json', wire(value))
    print(json.dumps(dict(candidate=result, files=len(rows), payload_bytes=value['payload_bytes'])))


def publish(candidate, adoption):
    scope = fresh()
    candidate_raw, adoption_raw = body(candidate), body(adoption)
    candidate_pin, adoption_pin = pin(candidate, candidate_raw), pin(adoption, adoption_raw)
    value = json.loads(candidate_raw)
    adopted = json.loads(adoption_raw)
    need(adopted.get('author') == '/root' and str(adopted.get('verdict')).startswith('ACCEPT_') and
         adopted.get('target_execution') is False and adopted.get('operational_authority') is False and occurs(adopted, candidate_pin), 'exact Root candidate Source adoption')
    need(value['publication_helper'] == pin(Path(__file__)) and value['record_type'] == 'Root_I13_exact_additive_inert_managed_publication_candidate', 'same reviewed publication helper and candidate')
    preservation = baseline()
    rows = value['files']
    index = Path(value['exact_index_destination'])
    need(index == DEST / 'MANAGED_I13_PORTABILITY_INDEX_001.json' and not os.path.lexists(index), 'fresh exact index')
    for row in rows:
        source, destination = Path(row['source']['path']), Path(row['destination'])
        need(destination.is_relative_to(DEST) or destination == REPO / 'CONTINUE_CURRENT_I13_20261025.json', 'reviewed additive managed containment')
        need(pin(source) == row['source'] and not os.path.lexists(destination), 'all exact sources and unused managed identities before first write')
    actual = []
    for row in rows:
        fresh()
        raw = body(Path(row['source']['path']))
        need(pin(Path(row['source']['path']), raw) == row['source'], 'exact source at copy')
        q = save(Path(row['destination']), raw)
        actual.append(dict(source=row['source'], copy=q, relative_path=row['relative_path'], copy_matches_source=True))
    indexed = dict(schema_version=1, record_type='Root_I13_actual_inert_managed_portability_index', author='/root', created_utc=utc(),
        candidate=candidate_pin, candidate_Root_adoption=adoption_pin, source_scope=scope, files=actual, file_count=len(actual),
        all_copies_byte_identical=True, source_suffix_only_transform=True, actual_family_publication=False,
        target_execution=False, operational_authority=False, scientific_authority=False,
        current_dated_Source_inventory=dict(present=36,pending=9), frozen_STEP080_inventory=dict(present=35,pending=10),
        actual_creation_requires_different_saved_review_and_Root_adoption=True, staged=False, committed=False, pushed=False)
    index_pin = save(index, wire(indexed))
    receipt = dict(schema_version=1, record_type='Root_I13_actual_inert_managed_creation_receipt', author='/root', created_utc=utc(),
        candidate=candidate_pin, candidate_Root_adoption=adoption_pin, actual_index=index_pin, file_count=len(actual),
        all_exact=True, initial_preservation=preservation, final_preservation=baseline(),
        target_execution=False, operational_authority=False, scientific_authority=False, actual_family_publication=False,
        no_step081_or_operational_lease=True, staged=False, committed=False, pushed=False)
    receipt_pin = save(PUB / 'ROOT_I13_ACTUAL_MANAGED_CREATION_RECEIPT_001.json', wire(receipt))
    print(json.dumps(dict(receipt=receipt_pin, actual_index=index_pin, copied_files=len(actual))))


if __name__ == '__main__':
    need(len(sys.argv) in (3,4), 'prepare navigation | publish candidate adoption')
    if sys.argv[1] == 'prepare':
        need(len(sys.argv) == 3, 'prepare exact navigation')
        prepare(Path(sys.argv[2]))
    else:
        need(sys.argv[1] == 'publish' and len(sys.argv) == 4, 'publish exact reviewed candidate and adoption')
        publish(Path(sys.argv[2]), Path(sys.argv[3]))
