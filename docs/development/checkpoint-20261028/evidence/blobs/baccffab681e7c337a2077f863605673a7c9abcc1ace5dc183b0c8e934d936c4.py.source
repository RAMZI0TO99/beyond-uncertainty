"""Retain Root-observed once003 timeout console and exit; never rerun."""
import datetime as dt, hashlib, json
from pathlib import Path
R=Path(__file__).parent; C=R/'m3_peer_contracts_016'; O=C/'owned_memory_runs/attempt003'
def pin(p):
 b=p.read_bytes(); return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
result=pin(O/'SUPERVISOR_RESULT_001.json')
assert result['sha256']=='a07a355f542e1634823bda50950e5724f3ff0b76ca12c4a6e7f560fece907820'
console=dict(accepted=False,refusal='WAIT50_TIMEOUT',supervisor_result=result,owned_pid=109168,exit_code=1,final_elapsed_nanoseconds=50030999999,acceptance_at_record_preparation=False,reaped=True,streams_drained=True,actual_stream_EOF=dict(stdout=True,stderr=True),stream_pump_errors=dict(stdout=None,stderr=None),total_budget_nanoseconds=60000000000)
p=O/'PARENT_TOOL_STDOUT_RETAINED_001.txt'
with p.open('xb') as h: h.write((json.dumps(console)+'\r\n').encode())
events=[json.loads(x) for x in (O/'CHILD_STDOUT_001.txt').read_text(encoding='utf-8').splitlines()]
cases=[x for x in events if x.get('event') in ('CASE_PASS','CASE_FAIL')]
failed=[x for x in cases if x['event']=='CASE_FAIL']; passed=[x for x in cases if x['event']=='CASE_PASS']
assert (len(cases),len(passed),len(failed))==(175,153,22)
v=dict(schema_version=1,record_type='Root_I13_once003_retained_parent_tool_console_and_exit_witness',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),tool='functions.exec/tools.exec_command_then_write_stdin',initial_tool_chunk_id='66b62f',completed_tool_chunk_id='25675a',tool_session_id=94369,Root_observed_tool_exit_code=1,retained_parent_console=pin(p),retained_console_value=console,supervisor_result=result,supervisor=pin(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_005.py'),scope=pin(C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_003.json'),stdout=pin(O/'CHILD_STDOUT_001.txt'),stderr=pin(O/'CHILD_STDERR_001.txt'),scope_invocations_consumed=1,Root_suite_acceptance=False,known_completed_cases=175,known_pass_events=153,known_fail_events=22,known_contiguous_pass_prefix=8,planned_cases=936,case_outcomes_not_established=761,complete_failure_diagnostics_absent=True,failure_names=[x['name'] for x in failed],child_result_absent=True,claim_reuse_permitted=False,no_rerun_performed=True,operational_authority=False,scientific_authority=False,target_execution=False,actual_family_publication=False,physical_host_or_PID_absence_proved=False)
q=C/'ROOT_I13_ONCE003_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json'
with q.open('xb') as h: h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(witness=pin(q),console=pin(p),completed=175,passed=153,failed=22,suite_rerun=False)))
