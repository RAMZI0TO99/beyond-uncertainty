checks = []

def check(name, passed, evidence):
    assert type(name) is str and name not in {r['name'] for r in checks}
    assert type(passed) is bool
    checks.append(dict(name=name, passed=passed, evidence=evidence))

def pin(path, raw=None):
    raw = path.read_bytes() if raw is None else raw
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def pairs(values):
    value = {}
    for key, child in values:
        assert key not in value, key
        value[key] = child
    return value

def reject(token):
    raise AssertionError('noninteger JSON token ' + token)

def load(path, size, sha):
    raw = path.read_bytes()
    check('whole_pin_' + path.name, len(raw) == size and hashlib.sha256(raw).hexdigest() == sha, pin(path, raw))
    value = json.loads(raw.decode('utf-8'), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)
    check('strict_JSON_object_' + path.name, type(value) is dict and len(raw) <= 2097152 and not raw.startswith(b'\xef\xbb\xbf'), 'Unique-key UTF-8 object, no float/constants/BOM, metadata cap.')
    return value

