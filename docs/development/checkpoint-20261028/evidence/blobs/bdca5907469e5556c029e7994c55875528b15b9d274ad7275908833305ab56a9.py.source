"""Root exact independently reviewed fresh Source-only scope adoption."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;cache={}
def raw(p):
 p=Path(p)
 if str(p) not in cache:
  with p.open('rb') as h:b=h.read(2097153)
  assert 0<len(b)<=2097152;cache[str(p)]=b
 return cache[str(p)]
def pin(p):
 p=Path(p);b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(raw(p))
p=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';scope=load(p);assert pin(p)['sha256']=='caaf2eb42d2394bccb56e34b040259a9f878cb2b57d4c082d2514079885e42b0'
cap=R/'Source_scope002_different_review_001/INDEPENDENT_I13_SOURCE_SCOPE002_SOURCE_CAPSULE_001.json';c=load(cap);full=Path(c['full_proof']['path']);assert pin(full)==c['full_proof'];f=load(full)
for v in (c,f):
 assert v['reviewer']=='/root/project_architecture' and v['verdict'].startswith('PASS_') and v['checks_passed']==113 and v['checks_failed']==0 and pin(p) in v['subjects']
 assert all(v[k] is False for k in ('tests_executed','target_execution','operational_authority','scientific_authority','native_Parser_executed'))
assert c['verdict']==f['verdict'] and len(f['checks'])==len({x['name'] for x in f['checks']})==113 and all(set(x)=={'name','passed','evidence'} and x['passed'] is True for x in f['checks'])
now=dt.datetime.now(dt.timezone.utc);assert dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60
assert scope['maximum_local_agents_including_Root']==3 and scope['maximum_shared_including_both_roots_and_overlap']==5 and scope['overlap_does_not_add_agent_slots'] is True
assert pin(Path(scope['predecessor_Source_scope']['path']))==scope['predecessor_Source_scope']
v=dict(schema_version=1,record_type='Root_I13_Source_scope002_different_Source_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_SOURCE_SCOPE002_LIGHTWEIGHT_SOURCE_AND_INERT_CLOSEOUT_ONLY',Source_scope=pin(p),predecessor_Source_scope=scope['predecessor_Source_scope'],different_Source_review=pin(cap),full_proof=pin(full),checks_passed=113,checks_failed=0,original_Source_scope001_unmodified=True,old_leases_or_scopes_extended=False,shared_local3_overall5_during_overlap=True,all_original_caps_and_budgets_unchanged=True,packaging_requires_separate_exact_Source_and_candidate_review_and_Root_adoptions=True,new_synthetic_calls_require_separate_exact_Source_review_Root_adoption_and_fresh_once_scope=True,Pro3_pending_flag_is_dated_Root_knowledge_only=True,actual_family_publication=False,new_operational_execution_lease_issued=False,Native8_Parser_runtime_science_admitted=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
out=R/'ROOT_I13_CURRENT_SOURCE_SCOPE002_DIFFERENT_REVIEW_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(b)
print(json.dumps(dict(adoption=pin(out),execution_lease_issued=False)))
