"""Preserve uninvoked001; bind strict parsed JSON to the single hashed buffer."""
import ast,base64,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent;p=R/'adopt_Source_scope007_001.py';old=p.read_bytes()
assert len(old)==5738 and hashlib.sha256(old).hexdigest()=='a897faa93f803633f31295f84ff7c6bedd35a44095a74d3484c77b9f9e76b497'
s=old.decode();s=s.replace('hashlib,json,os,sys','hashlib,json,math,os,sys')
a="""def doc(path,sha=None):
 p=pin(path)
 if sha:need(p['sha256']==sha,'exact review/evidence pin')
 return json.loads(raw(path)),p
"""
b="""def doc(path,sha=None):
 b=raw(path);p=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if sha:need(p['sha256']==sha,'exact review/evidence pin')
 def pairs(rows):
  result={}
  for k,v in rows:need(k not in result,'duplicate JSON key');result[k]=v
  return result
 def finite(x):
  v=float(x);need(math.isfinite(v),'finite JSON number');return v
 value=json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=lambda x:(_ for _ in()).throw(ValueError('nonfinite JSON')))
 return value,p
"""
assert s.count(a)==1;s=s.replace(a,b);out=R/'adopt_Source_scope007_002.py';new=s.encode();ast.parse(new,filename=str(out))
assert len(new)<=2097152 and not os.path.lexists(out)
with out.open('xb') as f:assert f.write(new)==len(new);f.flush();os.fsync(f.fileno())
assert out.read_bytes()==new and p.read_bytes()==old
inverse=R/'ROOT_SOURCE007_ADOPTER002_COMPLETE001_INVERSE_001.json'
v=dict(complete_predecessor=dict(path=str(p),bytes=len(old),sha256=hashlib.sha256(old).hexdigest()),complete_predecessor_base64=base64.b64encode(old).decode('ascii'),proposed_successor=dict(path=str(out),bytes=len(new),sha256=hashlib.sha256(new).hexdigest()),old001_invoked=False,adoption_issued=False)
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert not os.path.lexists(inverse)
with inverse.open('xb') as f:assert f.write(raw)==len(raw);f.flush();os.fsync(f.fileno())
print(json.dumps(dict(uninvoked_adopter=v['proposed_successor'],inverse=dict(path=str(inverse),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),old001_preserved=True,adoption_issued=False)))
