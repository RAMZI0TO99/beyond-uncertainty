"""Own metadata-only additive protocol clarification; never loads target code."""
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
def pin(p):
    raw=Path(p).read_bytes()
    assert 0<len(raw)<=2097152
    return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
old=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_001.json'
v=json.loads(old.read_bytes())
def rename(value):
    if type(value)is str:return value.replace('parsed_metadata_nodes_charged','charged_metadata_nodes')
    if type(value)is list:return [rename(x) for x in value]
    if type(value)is dict:return {k:rename(x) for k,x in value.items()}
    return value
v=rename(v)
v['created_utc']=dt.datetime.now(dt.timezone.utc).isoformat()
v['previous_complete_protocol']=pin(old)
v['author_tool']=pin(Path(__file__))
v['exact_additive_resolution']={
'counter_mode':'CONSERVATIVE_SUM_PER_INVOCATION_CACHE',
'result_counter_field':'charged_metadata_nodes',
'Root_resolution':'Root expressly approved conservative additive accounting over independent fixed-port caches. No mutable private session/counter callback and no per-port reset allowance.',
'aggregate':'Publisher charges its own packet/pin/context/catalogue and full direct result parsing nodes; adds actual charged_metadata_nodes returned by every direct fixed port; refuses aggregate>50000. Each port/cache locally parses a designated raw record once. A shared body parsed in two independent caches is charged twice, deliberately stricter. All counts exact builtin int, joined to fixed actual calls, never supplied serialized verdicts.',
'peer_draft_proof_subjects':'No invented peer diff. Peer raw20 has proposal/draft/decision/witness/inverse, not a diff field. Common peer draft_support covers draft, authorreceipt27, contentdecision, serializationwitness, inverse, producerSource/API. M3 diff remains an actual artifact field.',
'typed_original_fields':'For every declared original-output SHA256 slot use exact lowercase64 ASCII hex; created_utc exact ASCII UTC6; source_author/reviewer/reviewer_agent/binding_author are canonical actors. Other string slots are exact immutable literals or declared bounded semantic strings, never generic truthiness. Each top-level field retains exact declared builtin type (bool is not int), dict/list mutable payloads strict global JSON/depth/node/C0 policy. Pipeline source_binding_provenance path/hash is exact closed2 reference metadata, not fact3 proof coverage.',
'no_other_expansion':'Wrapper14/roleinput2/row3/API14, raw20 contracts, exact role data001, role caps, inherited falseguards, operational holds and finite test categories unchanged. Final common protocol/catalogue must still be pinned and genuinely reviewed/adopted before any target Source authoring.'}
v['publisher_binding']['request']='New selected_request25 schema2/tag from final common catalogue. request role/draft/predecessor/cap/owner/lease/selection/producer Source/API equal direct peer rawgraph output; author_packet_support covers whole wrapper; peer draft_support covers draft, authorreceipt27, raw contentdecision, serializationwitness, inverse and producer Source/API. No peer diff invented. M3 kind keeps its exact artifact diff.'
v['catalogue_and_budget']['cross_module']=v['exact_additive_resolution']['aggregate']
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
assert len(raw)<=2097152
p=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_002.json'
with p.open('xb')as stream:stream.write(raw)
print(json.dumps(pin(p),sort_keys=True))
