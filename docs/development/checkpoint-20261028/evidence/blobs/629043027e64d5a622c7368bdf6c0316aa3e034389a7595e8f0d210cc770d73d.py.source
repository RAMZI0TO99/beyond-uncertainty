"""Root adoption of exact independent saved opaque-byte reconstruction, no member call."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
cp=R/'supplemental_bundle_actual_reconstruction_different_review_001/INDEPENDENT_I13_SUPPLEMENTAL61_ACTUAL_RECONSTRUCTION_SOURCE_CAPSULE_001.json'
assert pin(cp)['sha256']=='b13c438f58933b27a783078a1fcd2df83b8ca7037319c1f9f2727611b47909ca'
c=load(cp);fp=Path(c['full_proof']['path']);assert pin(fp)==c['full_proof'];f=load(fp)
for v in(c,f):
 assert v['reviewer']=='/root/project_architecture'and v['verdict'].startswith('PASS_')and v['checks_failed']==0
 assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
assert c['checks_passed']==f['checks_passed']==len(f['checks'])==len({x['name']for x in f['checks']})==534 and all(x['passed']is True for x in f['checks'])
p=R/'supplemental_metadata_helper_source_bundles_001/I13_SUPPLEMENTAL_METADATA_HELPER_SOURCE_BUNDLE_INDEX_001.json';idx=load(p)
assert pin(p)['sha256']=='02efe8ce86b636493b0f498e6e07aa2438bb9070a081d72ed3f9960e5260acf3'
for v in(c,f):
 subjects=v['subjects'];subjects=list(subjects.values())if type(subjects)is dict else subjects
 assert pin(p)in subjects
assert idx['member_count']==61 and idx['original_member_bytes']==546038
for x in idx['members']:assert pin(x['original']['path'])==x['original']
for x in idx['bundles']:assert pin(x['path'])==x
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';now=dt.datetime.now(dt.timezone.utc)
assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_actual_supplemental61_opaque_Source_bundle_reconstruction_different_saved_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_SUPPLEMENTAL61_COMPLETE_BYTE_RECONSTRUCTION_ONLY',Source_scope=pin(scope),different_saved_review=pin(cp),full_proof=pin(fp),subjects=[pin(p),*idx['bundles']],member_count=61,whole_original_bytes=546038,complete_canonical_byte_inverse_accepted=True,all_original_files_preserved=True,actual_managed_files_created=False,managed_candidate_and_actual_creation_require_separate_different_reviews_and_Root_adoptions=True,Source_members_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
q=R/'ROOT_I13_ACTUAL_SUPPLEMENTAL61_BUNDLE_RECONSTRUCTION_DIFFERENT_REVIEW_ADOPTION_001.json'
with q.open('xb')as h:h.write((json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii'))
print(json.dumps(dict(adoption=pin(q),members=61,target_calls=0)))
