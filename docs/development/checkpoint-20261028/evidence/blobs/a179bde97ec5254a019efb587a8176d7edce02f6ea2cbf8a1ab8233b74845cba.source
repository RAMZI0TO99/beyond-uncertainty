    def recorded_birth(self, pin):
        row=next(r for r in self.b['records'] if r['pin']==pin)
        try:value=_ow_json(row['body'])
        except (ValueError,UnicodeError):return _ow_ns(0)
        text=value.get('created_utc') if type(value)is dict else None
        if type(text)is not str:return _ow_ns(17) if self.b['labels'].get('wrapper')==pin['path'] else _ow_ns(0)
        date=datetime.datetime.strptime(text[:19],'%Y-%m-%dT%H:%M:%S').replace(tzinfo=datetime.timezone.utc)
        delta=date-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
        fraction=text[20:].split('+')[0]
        return (delta.days*86400+delta.seconds)*1000000000+int(fraction.ljust(9,'0'))

