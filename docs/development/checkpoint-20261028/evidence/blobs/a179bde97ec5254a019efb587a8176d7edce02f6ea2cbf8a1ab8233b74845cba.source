_OW_HOME = r'D:\Aenv\pro2\WORK\resume-20261025-003\m3_peer_contracts_016\i13\synthetic_outer'
_OW_ZERO = datetime.datetime(2026,10,25,11,0,0,tzinfo=datetime.timezone.utc)


def _ow_wire(value):
    return (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')


def _ow_json(raw):
    return json.loads(raw.decode('utf8'))


def _ow_time(seconds, seven=False):
    text = (_OW_ZERO+datetime.timedelta(seconds=seconds)).isoformat(timespec='microseconds')
    return text.replace('+00:00','0+00:00') if seven else text


def _ow_ns(seconds):
    delta = _OW_ZERO+datetime.timedelta(seconds=seconds)-datetime.datetime(1970,1,1,tzinfo=datetime.timezone.utc)
    return (delta.days*86400+delta.seconds)*1000000000+delta.microseconds*1000


def _ow_pin(path, raw):
    return dict(path=path,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())


def _ow_pins(value):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'}:
            return [copy.deepcopy(value)]
        return [p for child in value.values() for p in _ow_pins(child)]
    if type(value) is list:
        return [p for child in value for p in _ow_pins(child)]
    return []


def _ow_replace(value, old, new):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'} and value == old:
            return copy.deepcopy(new)
        return {k:_ow_replace(v,old,new) for k,v in value.items()}
    if type(value) is list:
        return [_ow_replace(v,old,new) for v in value]
    return value


