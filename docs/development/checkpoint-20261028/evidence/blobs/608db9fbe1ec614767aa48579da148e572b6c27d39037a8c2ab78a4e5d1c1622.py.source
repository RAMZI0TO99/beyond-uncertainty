"""Own metadata proposal author. Reads/hashes only project data; imports no target."""
import datetime as dt
import hashlib
import json
from pathlib import Path

ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
AUDIT=OUT/'I13_CANONICAL_PEER_ACTUAL_HISTORY_AND_OWNER_V2_GAP_AUDIT_001.json'
audit=json.loads(AUDIT.read_bytes())
ROLES=['metadata_peer','metadata_bound_review','phase_peer','pipeline_peer','checker_peer']
def pin(path):
    with Path(path).open('rb') as stream:raw=stream.read(2097153)
    assert 0<len(raw)<=2097152
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(name,value):
    raw=(json.dumps(value,sort_keys=True,indent=2)+'\n').encode()
    assert len(raw)<=2097152
    path=OUT/name
    with path.open('xb') as stream:stream.write(raw)
    return pin(path)
def schema(fields):return dict(closed=True,field_count=len(fields),fields=fields)
canonical={
'metadata_peer':['capture_template','WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION_template','SUPERVISE_ROOT_METADATA_BEFORE_template','WRITE_ROOT_METADATA_AFTER_AUTHORIZATION_template','SUPERVISE_ROOT_METADATA_AFTER_template','profile','static','metadata_manifest'],
