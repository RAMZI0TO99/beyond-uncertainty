'metadata_peer':[(x['role'],x['source_cap']) for x in audit['actual_historical_publication_samples'][0]['author_receipt_carried_inputs']],
'metadata_bound_review':[(x['role'],x['source_cap']) for x in audit['actual_historical_publication_samples'][1]['author_receipt_carried_inputs']],
**{r:[(name,2097152) for name in audit['legacy_role_contracts'][r]['required_carried_Source_roles']] for r in ROLES[2:]}}
original={}
for row in audit['actual_selected_peer_subset']:
    role=row['row']['role'];prior=row['predecessor']
    if role in audit['legacy_role_contracts']:
        contract=audit['legacy_role_contracts'][role]
        immutable=contract['immutable_original_fields'].copy()
        mutable=contract['mutable_original_fields']
        verdict=contract['required_original_verdict']
    elif role=='metadata_peer':
        immutable={k:prior['scalar_fields'][k] for k in ('actual_results','operational_authority','post_capture_reference','record_type','runtime_acceptance','schema_version','scope','source_author','verdict')}
        mutable=[k for k in prior['keys'] if k not in immutable and k!='reviewer']
        verdict=prior['scalar_fields']['verdict']
    else:
        immutable={k:prior['scalar_fields'][k] for k in ('metadata_only','record_type','schema_version','source_author','verdict')}
        mutable=['actual_script_sha256','phase_set','source_bindings']
        verdict=prior['scalar_fields']['verdict']
    immutable['reviewer']=prior['scalar_fields']['reviewer']
    mutable=[key for key in mutable if key not in immutable]
    original[role]=dict(predecessor_sample=prior['pin'],closed_keys=prior['keys'],field_builtin_types=prior['field_builtin_types'],immutable_literal_fields=immutable,mutable_fields=mutable,required_verdict=verdict,source_cap=audit['role_caps'][role])

