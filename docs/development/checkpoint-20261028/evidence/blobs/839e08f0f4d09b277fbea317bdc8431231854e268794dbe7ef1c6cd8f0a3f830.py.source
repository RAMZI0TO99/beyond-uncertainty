 'adopt.proof_workspace': 'proof_path.is_absolute() and proof_path.is_relative_to(R5)',
 'adopt.exact_proof_F3': "document(proof_path, capsule['full_proof'])",
 'adopt.different_reviewer': "capsule['reviewer'] not in (AUTHOR, '/root')",
 'adopt.same_reviewer': "capsule['reviewer'] == proof['reviewer']",
 'adopt.same_PASS_verdict': "capsule['verdict'] == proof['verdict'] and capsule['verdict'].startswith('PASS_')",
 'adopt.empty_same_findings': "capsule['remaining_actionable_findings'] == proof['remaining_actionable_findings'] == []",
 'adopt.positive_named_boolean_checks': "x.get('passed') is True for x in checks",
 'adopt.unique_check_names': "len({x['name'] for x in checks}) == len(checks)",
 'adopt.exact_positive_pass_count': "type(reviewed['checks_passed']) is int and reviewed['checks_passed'] == len(checks)",
 'adopt.exact_zero_failure_count': "type(reviewed['checks_failed']) is int and reviewed['checks_failed'] == 0",
 'adopt.entire_scope_expected': "scope == make_scope(scope['created_utc'], inverse_pin)",
 'adopt.actual_interval_and_reserve': 'start <= fresh() < dt.datetime.fromisoformat(END) - dt.timedelta(seconds=60)',
 'adopt.two_predecessors': "len(inverse['items']) == 2",
 'adopt.whole_inverse_restore': "base64.b64decode(item['base64'], validate=True) == raw(pin['path'])",
 'adopt.exact_ordered_artifacts': 'artifacts = [scope_pin, self_pin, inverse_pin]',
 'adopt.same_exact_candidate': "capsule['candidate'] == proof['candidate'] == scope_pin",
 'adopt.same_exact_review_roster': "capsule['reviewed_artifacts'] == proof['reviewed_artifacts'] == artifacts",
 'adopt.fresh_exact_roster': "fact(Path(pin['path'])) == pin",
 'adopt.every_gate_bool_false': 'type(scope[key]) is bool and scope[key] is val is False',
 'adopt.fixed_adoption_output': 'adoption = save(ADOPTION_NAME, dict(',
 'adopt.no_operative_permission_output': 'Source_only_scheduling_not_operative_lease=True',
}
for name, fragment in SOURCE_REQUIREMENTS.items():
    checked('Source.guard.' + name, fragment in source, fragment)
checked('Source.fixed_END_and_author', "END = '2026-10-28T09:30:00+00:00'" in source and "AUTHOR = '/root/scope013_review'" in source)
checked('Source.capsule_proof_checks_before_adoption_save', source.index("capsule, capsule_pin = document(capsule_path)") < source.index("adoption = save(ADOPTION_NAME") and source.index("for key, val in HOLDS.items():") < source.index("adoption = save(ADOPTION_NAME"))
checked('Source.prepare_and_adopt_are_separate_exit_paths', "sys.exit(0)\n\nneed(len(sys.argv) == 4" in source)
checked('Source.no_subject_import_API_or_call', all(token not in imports for token in ('subprocess', 'ctypes', 'socket', 'multiprocessing', 'threading', 'importlib')) and all(token not in source for token in ('Popen(', 'CreateProcess', 'Add-Type', 'ParseFile(', 'Get-CimInstance', 'Get-Process', 'kill(', 'os.system(', 'os.popen(')))

provenance = {
 'method': 'Reviewer independently used trusted app read_thread with exact thread; then page cursor read the preceding completed turn. No message was sent to peer.',
 'thread_id': '01a171ac-fe4f-71c0-b078-f9c56c579f08',
 'human_turn_id': '01a18180-ded3-72d3-a1d7-58dbfd26121a',
 'human_message_id': '01a18180-df18-7171-bcea-f30a69fd6037',
 'human_exact_text': 'off to the next step! \n',
 'preceding_turn_id': '01a1817f-f803-7d40-8b01-914694a95ffd',
 'preceding_final_message_id': 'msg_0c31757a8e132009016ae1aa1d0cec8191a26d9ed3268290e6',
 'preceding_handoff_confirmed': 'Bootstrap failed on unexpected descendant; cleanup could not be verified. No automatic retry. 117 tests and 34 guards remain unexecuted. Next bounded process-tree and cleanup diagnostics, independent review, then fresh coordination and admission; prior windows expired.',
 'interpretation': 'Fresh bounded Source005 diagnostics/protocol authoring and separate Source review are supported; operative action remains separately conditioned and held.',
}
checked('human.independently_verified_exact_direct_instruction', scope['verified_new_direct_human']['exact_text'] == provenance['human_exact_text'] and scope['verified_new_direct_human']['turn_id'] == provenance['human_turn_id'] and scope['verified_new_direct_human']['user_message_id'] == provenance['human_message_id'])
checked('human.independently_verified_preceding_failed_handoff', scope['immediate_prior_handoff_context']['turn_id'] == provenance['preceding_turn_id'] and scope['immediate_prior_handoff_context']['final_message_id'] == provenance['preceding_final_message_id'])
checked('interpretation.only_new_finite_Source_phase', scope['Source_only_scheduling_not_operative_lease'] is True and all(scope[name] is False for name in HOLDS) and scope['prospective_Source_diagnostics_005']['status'] == 'SOURCE_ONLY_PROPOSAL_NOT_OPERATIVE')

artifacts = [scope_pin, source_pin, inverse_pin]
for index, fact in enumerate(artifacts):
    checked('final_refresh.reviewed_artifact_' + str(index), pin(Path(fact['path'])) == fact, fact)
for label, fact in [('old_scope', old_pin), ('old_adoption', old_adoption_pin), ('scope13', context13_pin), ('adoption13', adoption13_pin)]:
    checked('final_refresh.unchanged_context_' + label, pin(Path(fact['path'])) == fact, fact)
checked('final_review.current_strict_reserve', start <= current() < END - dt.timedelta(seconds=60))
passed = sum(1 for row in CHECKS if row['passed'])
failed = len(CHECKS) - passed
require(passed > 0 and passed + failed == len(CHECKS), 'positive exact proof count')
verdict = 'PASS_WHOLE_SOURCE014_NEW_FINITE_SOURCE_ONLY_METADATA' if not FINDINGS else 'FAIL_SOURCE014_METADATA_ACTIONABLE_FINDINGS'
common = dict(reviewer=REVIEWER, physical_Source_author=AUTHOR, intended_Root_adopter='/root',
    verdict=verdict, candidate=scope_pin, reviewed_artifacts=artifacts,
    checks_passed=passed, checks_failed=failed, remaining_actionable_findings=FINDINGS,
    started_utc=began, completed_utc=current().isoformat(), interval_end=scope['interval_end'],
    publication_reserve_seconds=60, metadata_cap_bytes=CAP, metadata_depth=48, metadata_nodes=50000,
    review_authority='New direct human Source-only phase independently corroborated; separate Source013 saved-failure closeout context is unchanged. No old period is extended.',
    review_scope='Whole exact Scope014, author/adopter Source014 text/AST, exact two-predecessor whole inverse, strict saved metadata and trusted app human/handoff provenance only.',
    Root_decision_made=False, Source_only_coexistence_adopted=False,
    subject_or_author_or_adopter_invoked=False, subject_Source_imported=False,
    process_or_native_or_resource_or_pause_query_performed=False,
    Python_target_or_tests_or_Job_invoked=False, Git_or_capture_or_science_performed=False,
    operational_authority=False, failed004_release_or_result_acceptance=False,
    native_request_advancement=False)
proof = dict(record_type='Independent_Source014_new_finite_coexistence_metadata_full_proof', schema_version=1,
    **common, checks=CHECKS, independent_trusted_app_provenance=provenance,
    reviewer_helper_Source=pin(Path(__file__)),
    context_artifacts=[old_pin, old_adoption_pin, context13_pin, adoption13_pin],
    scope_limitations=['This review does not adopt the proposal; Root alone may make a distinct adoption decision.',
      'No Source005 diagnostic Source or later operation/result is reviewed or accepted here.',
      'FAILED_UNRELEASED_CONSUMED004 and all unknown cleanup/custody remain unclosed; no native request can advance.',
      'Shared five-agent ceiling, Root3/peer2 serialized author OR reviewer, strict original60 reserve and all original guards/caps/budgets remain unchanged.'])
proof_pin = save('INDEPENDENT_SOURCE014_NEW_FINITE_COEXISTENCE_METADATA_FULL_PROOF_001.json', proof)
capsule = dict(record_type='Independent_Source014_new_finite_coexistence_metadata_capsule', schema_version=1,
    **common, full_proof=proof_pin, reviewer_helper_Source=pin(Path(__file__)),
    independent_trusted_app_provenance=provenance,
    summary='Whole candidate, metadata author/adopter and whole predecessor inverse pass independent exact static review; fresh finite Source-only diagnostic authoring/review scheduling remains subject to separate Root adoption. All operational holds remain false.')
capsule_pin = save('INDEPENDENT_SOURCE014_NEW_FINITE_COEXISTENCE_METADATA_CAPSULE_001.json', capsule)
require(strict(read(Path(capsule_pin['path'])))['full_proof'] == pin(Path(proof_pin['path'])), 'final proof/capsule binding')
print(json.dumps({'reviewer': REVIEWER, 'verdict': verdict, 'full_proof': proof_pin, 'capsule': capsule_pin,
    'checks_passed': passed, 'checks_failed': failed, 'remaining_actionable_findings': FINDINGS,
    'reviewer_helper_Source': pin(Path(__file__)), 'completed_utc': current().isoformat()}, sort_keys=True))
