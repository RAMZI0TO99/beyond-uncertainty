"""Independent Source014 whole-buffer static metadata review; no subject invocation."""
import ast
import base64
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path

HERE = Path(__file__).parent
ROOT = HERE.parent
R5 = ROOT.parent
OLD = Path('D:/Aenv/pro2/WORK/resume-20261027-002/coordination/pro3_bootstrap002_source_review_001')
REVIEWER = '/root/coexistence014_final_review'
AUTHOR = '/root/scope013_review'
CAP = 2097152
END = dt.datetime(2026, 10, 28, 9, 30, tzinfo=dt.timezone.utc)
CHECKS = []
FINDINGS = []


def require(value, message):
    if not value:
        raise ValueError(message)


def current():
    now = dt.datetime.now(dt.timezone.utc)
    require(now.date() == dt.date(2026, 10, 28) and now < END - dt.timedelta(seconds=60),
            'current finite review window with strict original sixty-second reserve')
    return now


def shape(value):
    stack = [(value, 0)]
    count = 0
    deepest = 0
    while stack:
        item, depth = stack.pop()
        count += 1
        deepest = max(deepest, depth)
        require(count <= 50000 and depth <= 48, 'own metadata node/depth limits')
        require(item is None or type(item) in (str, int, bool, list, dict), 'float-free builtin metadata')
        if type(item) is str:
            require(not any(55296 <= ord(char) <= 57343 for char in item), 'no surrogate strings')
        elif type(item) is list:
            stack.extend((x, depth + 1) for x in item)
        elif type(item) is dict:
            require(all(type(k) is str for k in item), 'string dictionary keys')
            for key, value in item.items():
                stack.append((key, depth + 1))
                stack.append((value, depth + 1))
    return {'nodes': count, 'max_depth': deepest}


def pairs(items):
    answer = {}
    for key, value in items:
        require(key not in answer, 'duplicate JSON key')
        answer[key] = value
    return answer


def reject_number(token):
    raise ValueError('fractional or nonfinite JSON token forbidden: ' + token)


def strict(data):
    require(type(data) is bytes and len(data) <= CAP, 'strict JSON bounded bytes')
    value = json.loads(data.decode('utf-8'), object_pairs_hook=pairs,
                       parse_float=reject_number, parse_constant=reject_number)
    shape(value)
    return value


def read(path):
    path = Path(path)
    for part in (path, *path.parents):
        metadata = part.lstat()
        require(not part.is_symlink() and not getattr(metadata, 'st_file_attributes', 0) & 1024,
                'nonreparse direct metadata lineage')
    before = path.stat()
    require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 <= before.st_size <= CAP,
            'bounded ordinary single-link saved metadata')
    with path.open('rb') as handle:
        opened = os.fstat(handle.fileno())
        data = handle.read(CAP + 1)
        closed_sample = os.fstat(handle.fileno())
    after = path.stat()
    identity = lambda s: (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size, s.st_mtime_ns)
    require(identity(before) == identity(opened) == identity(closed_sample) == identity(after),
            'stable whole-buffer saved metadata read')
    require(len(data) == before.st_size and len(data) <= CAP, 'whole bounded file buffer')
    return data


def pin(path, data=None):
    if data is None:
        data = read(path)
    return {'path': str(path), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}


def checked(name, result, evidence=None):
    require(type(name) is str and name and all(x['name'] != name for x in CHECKS), 'unique positive check name')
    require(type(result) is bool, 'actual boolean check result')
    row = {'name': name, 'passed': result}
    if evidence is not None:
        shape(evidence)
        row['evidence'] = evidence
    CHECKS.append(row)
    if not result:
        FINDINGS.append({'check': name, 'evidence': evidence})


def load(label, path, byte_count, digest, is_json=True):
    data = read(path)
    item = pin(path, data)
    checked(label + '.exact_bytes_and_sha256', item['bytes'] == byte_count and item['sha256'] == digest, item)
    value = strict(data) if is_json else data.decode('utf-8')
    checked(label + '.whole_bounded_single_link_nonreparse_stable_read', True,
            {'bytes': len(data), 'strict_JSON_shape': shape(value) if is_json else None})
    return value, item, data


def save(name, value):
    require(Path(name).name == name, 'fixed own review output filename')
    require(HERE.is_relative_to(R5) and HERE.name == 'different_review_001', 'only owned reviewer directory')
    shape(value)
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    require(len(data) <= CAP, 'own review output cap')
    current()
    destination = HERE / name
    with destination.open('xb') as handle:
        require(handle.write(data) == len(data), 'whole CreateNew review output write')
        handle.flush()
        os.fsync(handle.fileno())
    require(read(destination) == data and strict(read(destination)) == value, 'whole strict flushed readback')
    return pin(destination, data)


