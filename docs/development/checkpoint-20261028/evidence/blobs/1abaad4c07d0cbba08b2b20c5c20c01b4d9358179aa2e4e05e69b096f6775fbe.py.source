HOME=r'D:\I13PeerSynthetic'
UUID='01234567-89ab-cdef-0123-456789abcdef'
NOW='2026-10-25T11:00:20.000000+00:00'
EDITOR='/root/i13_peer_fixture_caller'
def _wire(v):return(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)+'\n').encode()
def _pin(path,raw):return dict(path=path,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def _json(raw):return json.loads(raw.decode('utf8'))
def _path(kind,name):return HOME+chr(92)+kind+chr(92)+name
def _time(second):return '2026-10-25T11:00:%02d.000000+00:00'%second
def _fixed(name):
    row=copy.deepcopy(FIXED[name]);return row['pin'],base64.b64decode(row['base64'],validate=True)
def _value_get(v,path):
    for key in path.split('.'):
        v=v[int(key)]if type(v)is list else v[key]
    return v
def _parent(v,path):
    parts=path.split('.');return _value_get(v,'.'.join(parts[:-1]))if len(parts)>1 else v,parts[-1]
def _fingerprint(v):
    if type(v)is dict:return('dict',tuple((_fingerprint(k),_fingerprint(x))for k,x in v.items()))
    if type(v)is list:return('list',tuple(_fingerprint(x)for x in v))
    if type(v)is tuple:return('tuple',tuple(_fingerprint(x)for x in v))
    if type(v)is bytes:return('bytes',len(v),hashlib.sha256(v).hexdigest())
    return(type(v).__name__,v)
def _seal():return hashlib.sha256(repr(_fingerprint((FIXED,CASE_CATALOGUE))).encode()).hexdigest()
def _mutable_ids(v):
    out=set()
    def walk(x):
        if type(x)in(dict,list):
            out.add(id(x))
            for y in (list(x)+list(x.values())if type(x)is dict else x):walk(y)
    walk(v);return out

class _Build:
    def __init__(self,role,peer,catalogue_bytes):
        self.rows=[];self.labels={};self.mutable=set();self.role=role
        for name in FIXED:
            p,raw=_fixed(name);self.add_raw(name,p,raw,False)
        self.base=_json(_fixed('base_catalogue')[1]);self.policy=_json(_fixed('role_data')[1])
        self.add_raw('common_catalogue',copy.deepcopy(peer.COMMON_CATALOGUE_PIN),catalogue_bytes,False)
        # The catalogue identity is a pinned Source constant on the owned module.
        self.rows[-1]['pin']=copy.deepcopy(peer.COMMON_CATALOGUE_PIN);self.labels['common_catalogue']=self.rows[-1]['pin']['path']
        owner=self.add('owner',dict(schema_version=2,record_type='synthetic_unissued_owner_scope',author='/root',created_utc=_time(0),target_execution=False,operational_authority=False))
        lease=self.add('lease',dict(schema_version=2,record_type='synthetic_unissued_lease',author='/root',created_utc=_time(0),target_execution=False,operational_authority=False))
        old=_json(_fixed('historical45')[1]);inventory=_json(_fixed('M3_inventory17')[1]);basis={r['role']:r['available_basis']for r in inventory['roles']}
        selected=[]
        for r in old['rows']:
            row=copy.deepcopy(r);name=row['role']
            if name!='composer':
                row.update(canonical_path=_path('canonical',name+'_fresh001.json'),draft_path=_path('draft',name+'_fresh001.json'),selected_ordinal=1,preparation_Source_author='/root/i13_peer_preparer/'+name,must_change_Source_bytes=True)
                row['predecessor']=copy.deepcopy(basis.get(name,row['predecessor']))
                if name==role:row['predecessor']=_fixed('predecessor_'+role)[0]
            selected.append(row)
        selection=self.add('selection',dict(author='/root',created_utc=_time(0),current_complete45_inventory=_fixed('full_historical45')[0],current_owner_scope=owner,current_selection=_fixed('historical45')[0],derived_launcher_runtime_path=HOME+r'\unissued-launcher-runtime.json',new_canonical_lease=lease,operational_authority=False,record_type='Root_owner_v2_actual_separate_future45_Source_path_selection',rows=selected,schema_version=2,selected_Source_nonce='0123456789abcdef0123456789abcdef',target_execution=False))
        self.scope,self.selection=owner,selection
        row=next(r for r in selected if r['role']==role);current=[];inputs={'canonical':[],'carried':[]};byname={}
        for name in self.policy['canonical_input_roles'][role]:
            r=next(x for x in selected if x['role']==name);raw=('fresh synthetic recorded dependency '+name+'\n').encode();p=self.add_raw('input_'+name,_pin(r['canonical_path'],raw),raw,False)
            inputs['canonical'].append(dict(role=name,subject=p,source_cap=r['source_cap']));current.append(p);byname[name]=p
        for r in self.policy['carried_input_names_and_caps'][role]:
            name=r['role'];raw=('fresh synthetic carried data '+name+chr(10)).encode();p=self.add_raw('input_'+name,_pin(_path('carried',str(len(current))+'.data'),raw),raw,False)
            inputs['carried'].append(dict(role=name,subject=p,source_cap=r['source_cap']));current.append(p);byname[name]=p
        priorraw=_fixed('predecessor_'+role)[1];prior=_json(priorraw);draft=copy.deepcopy(prior)
        draft['created_utc']=_time(0)if 'created_utc'in draft else None
        if draft.get('created_utc')is None:draft.pop('created_utc',None)
        if role=='metadata_peer':
            for key in self.policy['role_specific_joins'][role]['nested_mutable_lists']:draft[key]=[]
            draft.update(finite_input_count=15,manifest_payload_count=12,source_manifest_sha256=byname['metadata_manifest']['sha256'])
        elif role=='metadata_bound_review':
            draft['actual_script_sha256']=byname['capture_bound']['sha256'];draft['phase_set']=['before','after']
            draft['source_bindings']={k:byname[v.split('.',1)[1]]['sha256']for k,v in self.policy['role_specific_joins'][role]['source_bindings_closed9'].items()}
        elif role=='phase_peer':
            for key,name in self.policy['role_specific_joins'][role]['top_sha_fields'].items():draft[key]=byname[name]['sha256']
            draft['PowerShell_parser_errors']=0;draft['exact_two_literal_reversal_all_four']=True;draft['phase_sources']=[]
            for name in self.policy['role_specific_joins'][role]['phase_sources']['ordered_bound_roles']:
                r=copy.deepcopy(byname[name]);r.update(PowerShell_parser_errors=0,exact_two_literal_reversal=True,template_sha256=byname[name.replace('_bound','_template')]['sha256']);draft['phase_sources'].append(r)
        elif role=='pipeline_peer':draft.update(pipeline_source_sha256=byname['pipeline']['sha256'],pipeline_binding_sha256=byname['binding']['sha256'])
        else:draft.update(checker_template_sha256=byname['checker']['sha256'],source_manifest_sha256=byname['checker_manifest']['sha256'],full_source_details_sha256=byname['checker_dependency_audit']['sha256'])
        draftpin=self.add_raw('draft',_pin(row['draft_path'],_wire(draft)),_wire(draft),True)
        proposal=self.add_raw('proposal',_pin(_path('proposal',role+'.json'),_wire(draft)),_wire(draft),True)
        constructor_api=_json(_fixed('constructor_API')[1]);constructor_support=self.code('constructor',_fixed('constructor_Source')[0],_fixed('constructor_API')[0],constructor_api['author'])
        self.add_raw('producer_Source',copy.deepcopy(peer.__source_pin__),peer.__source_bytes__,False)
        self.add_raw('producer_API',copy.deepcopy(peer.__API_pin__),peer.__API_bytes__,True)
        producer_support=self.code('producer',self.p('producer_Source'),self.p('producer_API'),'/root/i2_resume_gap')
        ss=self.proof('selection_proof',[selection,lease],1,2);selection_support=dict(subject=selection,different_review=ss[0],Root_adoption=ss[1])
        actor='/root/i13_peer_content/'+role
        decision=dict(schema_version=2,record_type='Root_owner_v2_actual_genuine_selected_peer_content_decision',author=actor,reviewer=actor,created_utc=_time(3),current_owner_scope=owner,operational_authority=False,target_execution=False,verdict='PASS_STATIC_SELECTED_PEER_METADATA_CONTENT_ONLY',role=role,actual_current_Source_inputs=current,actual_support_fact3s=current,approved_original_schema_updates={})
        parsers=[]
        if role=='phase_peer':
            for name in ('result','request','owner_purpose_acceptance','Root_admission','different_result_review','result_Root_adoption'):parsers.append(self.add('parser_'+name,dict(record_type='synthetic_recorded_Parser_reference_'+name,target_execution=False,operational_authority=False)))
            decision.update(record_type='Root_owner_v2_actual_genuine_phase_peer_content_decision',verdict='PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY',actual_fresh_native_Parser_result=parsers[0],actual_fresh_native_Parser_support=parsers)
        dp=self.add('decision',decision);cp=self.proof('content',[dp,*current,owner,selection],4,5);pp=self.proof('proposal',[proposal,dp,*current,owner,selection],6,7)
        content_support=dict(decision=dp,different_review=cp[0],Root_adoption=cp[1]);proposal_support=dict(proposal=proposal,different_review=pp[0],Root_adoption=pp[1])
        context=None
        if role=='phase_peer':
            parser=dict(record_type='Root_owner_v2_fresh_Parser_saved_result_support',schema_version=2,implementation_support={})
            for name,p in zip(('result','request','owner_purpose_acceptance','Root_admission','different_result_review','result_Root_adoption'),parsers):parser[name]=p
            context=self.add('context',dict(schema_version=2,record_type='Root_owner_v2_actual_genuine_phase_peer_dictionary_context',author='/root',created_utc=_time(7),current_owner_scope=owner,role=role,Source_producer_support=constructor_support,own_program_support=constructor_support,publisher_support=constructor_support,lease_producer_support=constructor_support,actual_reversal_FILEs={},canonical_Source_inputs={},carried_Source_inputs={},current_content_evidence_support={},new_lease_support={},fresh_parser_support=parser,genuine_content_support=content_support,genuine_proposal_support=proposal_support,selection_support=selection_support,operational_authority=False,target_execution=False))
        witness=self.add('witness',dict(schema_version=2,record_type='Root_owner_v2_selected_peer_serialization_metadata_witness',author='/root',created_utc=_time(8),current_owner_scope=owner,selection=selection,physical_Source_editor='/root',proposal=proposal,selected_draft=draftpin,content_Root_adoption=cp[1],proposal_Root_adoption=pp[1],operational_authority=False,target_execution=False))
        pred=self.p('predecessor_'+role)
        inv=self.add('inverse',dict(schema_version=2,record_type='Root_owner_v2_peer_complete_predecessor_inverse_metadata',author='/root',created_utc=_time(9),current_owner_scope=owner,selection=selection,draft=draftpin,predecessor=pred,inverse_sha256=pred['sha256'],complete_predecessor_bytes_base64=base64.b64encode(priorraw).decode(),operational_authority=False,target_execution=False))
        receipt=self.add('receipt',dict(schema_version=2,record_type='Root_owner_v2_genuine_static_peer_selected_byte_author_receipt',author='/root',created_utc=_time(10),Root_future_path_selection=selection,actual_Root_content_adoption=pp[1],actual_Root_serialization_witness=witness,actual_complete_predecessor_inverse=inv,actual_current_Source_inputs=current,actual_genuine_content_decision=dp,actual_genuine_content_proposal=proposal,actual_recipe_Source_support=[self.p('constructor_Source')],canonical_publication=False,current_owner_scope=owner,draft=draftpin,genuine_content_author_and_reviewer=actor,metadata_Source_worker=row['preparation_Source_author'],new_canonical_lease=lease,operational_authority=False,original_fixtures_and_runtime_admission=False,original_peer_source_author_nominal=prior['source_author'],physical_receipt_author='/root',physical_selected_byte_editor='/root',predecessor=pred,retained_semantic_Source_author=row['retained_semantic_Source_author'],role=role,target_execution=False))
        inner=self.add('inner',dict(actual_content_actor=actor,actual_content_authors=[],constructor_support=constructor_support,content_decision=dp,content_support=content_support,context=context,current_source_inputs=current,draft=draftpin,inverse_evidence=inv,lease=lease,owner_scope=owner,predecessor=pred,proposal=proposal,proposal_support=proposal_support,receipt=receipt,recipe_sources=[self.p('constructor_Source')],role=role,root_thread=UUID,selection_support=selection_support,serialization_witness=witness))
        self.add('wrapper',dict(schema_version=2,record_type='Root_owner_v2_selected_peer_canonical_author_metadata_packet',Root_thread=UUID,role=role,owner_scope=owner,lease=lease,selection=selection,peer_packet=inner,producer_support=producer_support,role_inputs=inputs,created_utc=_time(11),target_execution=False,operational_authority=False,source_only=True))
    def add_raw(self,label,p,raw,mutable):
        assert all(r['pin']['path']!=p['path']for r in self.rows)
        self.rows.append(dict(pin=copy.deepcopy(p),body=raw));self.labels[label]=p['path']
        if mutable:self.mutable.add(p['path'])
        return copy.deepcopy(p)
    def add(self,label,v):
        raw=_wire(v);return self.add_raw(label,_pin(_path('records',label+'.json'),raw),raw,True)
    def p(self,label):return copy.deepcopy(next(r['pin']for r in self.rows if r['pin']['path']==self.labels[label]))
    def proof(self,name,subjects,when,adopt):
        reviewer='/root/i13_peer_independent_review'
        common=dict(schema_version=1,record_type='synthetic_source_proof',reviewer=reviewer,verdict='PASS_SOURCE_SYNTHETIC_METADATA_ONLY',checks_failed=0,checks_passed=1,created_utc=_time(when),subjects=copy.deepcopy(subjects),target_execution=False,operational_authority=False,native_Parser_executed=False)
        full=copy.deepcopy(common);full['checks']=[dict(name='whole_source_and_metadata',passed=True,evidence=copy.deepcopy(subjects))]
        fp=self.add(name+'_full',full);caps=copy.deepcopy(common);caps['full_proof']=fp;cap=self.add(name+'_capsule',caps)
        ap=self.add(name+'_adoption',dict(schema_version=1,record_type='synthetic_Root_source_adoption',author='/root',verdict='ACCEPT_SOURCE_SYNTHETIC_METADATA_ONLY',created_utc=_time(adopt),subjects=[*copy.deepcopy(subjects),cap,fp,self.scope,self.selection],different_review=cap,full_proof=fp,target_execution=False,operational_authority=False,native_Parser_executed=False))
        return cap,ap
    def code(self,name,source,api,editor):
        p=self.proof(name,[source,api],1,2);return dict(Source=source,API=api,different_review=p[0],Root_adoption=p[1],editor=editor)
    def finish(self):
        rows=copy.deepcopy(self.rows);return dict(packet=next(r['body']for r in rows if r['pin']['path']==self.labels['wrapper']),records=rows,labels=copy.deepcopy(self.labels),mutable=sorted(self.mutable))

def _make(role,peer,catalogue_bytes):return _Build(role,peer,catalogue_bytes).finish()
def _row(b,label):return next(r for r in b['records']if r['pin']['path']==b['labels'][label])
def _replace_pins(v,old,new):
    if type(v)is dict:
        if set(v)=={'path','bytes','sha256'}and v==old:return copy.deepcopy(new)
        return{k:_replace_pins(x,old,new)for k,x in v.items()}
    if type(v)is list:return[_replace_pins(x,old,new)for x in v]
    return v
def _rewrite(b,label,v):
    row=_row(b,label);old=copy.deepcopy(row['pin']);row['body']=v if type(v)is bytes else _wire(v);row['pin']=_pin(old['path'],row['body']);queue=[(old,copy.deepcopy(row['pin']))]
    while queue:
        old,new=queue.pop(0)
        for r in b['records']:
            if r['pin']['path']not in b['mutable']or r is row:continue
            v=_json(r['body']);changed=_replace_pins(v,old,new)
            if changed!=v:
                before=copy.deepcopy(r['pin']);r['body']=_wire(changed);r['pin']=_pin(before['path'],r['body']);queue.append((before,copy.deepcopy(r['pin'])))
    b['packet']=_row(b,'wrapper')['body']

class _Str(str):pass
class _Hostile:
    def __getattribute__(self,name):raise AssertionError('held entry inspected context')

def _mutate(b,spec):
    handler=spec['handler'];label=spec.get('label','draft');field=spec.get('field')
    if handler=='unsupported':b['packet']=_row(b,label)['body'];return
    if handler=='utc7':
        if label=='now':b['now_utc']='2026-10-25T11:00:20.0000001+00:00';return
        v=_json(_row(b,'wrapper')['body']);v['created_utc']='2026-10-25T11:00:11.0000001+00:00';_rewrite(b,'wrapper',v);return
    if handler=='microsecond':
        v=_json(_row(b,'wrapper')['body']);v['created_utc']='2026-10-25T11:00:09.999999+00:00';_rewrite(b,'wrapper',v);return
    if handler=='native100ns':
        v=_json(_row(b,'decision')['body']);v['created_utc']='2026-10-25T11:00:04.0000001+00:00';_rewrite(b,'decision',v);return
    if handler=='cap':
        size=65537 if 'over_cap'in spec['variant']else 65536
        if spec['variant'].startswith('dependency'):_rewrite(b,'input_capture_template',b'x'*size)
        else:
            raw=_row(b,'draft')['body'];assert len(raw)<size;raw=raw+b' '*(size-len(raw));_rewrite(b,'draft',raw);_rewrite(b,'proposal',raw)
        return
    if handler=='nominal':
        inner=_json(_row(b,'inner')['body']);selection=_json(_row(b,'selection')['body']);selected=next(r for r in selection['rows']if r['role']==inner['role'])
        v=_json(_row(b,'receipt')['body']);v['original_peer_source_author_nominal']=selected['retained_semantic_Source_author'];_rewrite(b,'receipt',v);return
    if handler=='union_actor':
        actors=dict(content='/root/i13_peer_content/metadata_peer',worker='/root/i13_peer_preparer/metadata_peer',retained='/root/selector_prep',caller=EDITOR,fixed_other_editor='/root/project_architecture',outside_selected_role='/root/i13_peer_preparer/selector')
        v=_json(_row(b,'producer_capsule')['body']);v['reviewer']=actors[spec['variant']];_rewrite(b,'producer_capsule',v);return
    if handler=='strict':
        variant=spec['variant'];r=b['records'][0]
        if variant=='pin_bytes_bool':r['pin']['bytes']=True
        elif variant=='pin_key_subclass':r['pin']={_Str(k):v for k,v in r['pin'].items()}
        elif variant=='record_key_subclass':b['records'][0]={_Str(k):v for k,v in r.items()}
        elif variant=='record_extra':r['extra']=False
        elif variant=='record_hash':r['body']=bytes([r['body'][0]^1])+r['body'][1:]
        elif variant=='record_length':r['body']+=b'X'
        elif variant=='casefold_alias':r=copy.deepcopy(r);r['pin']['path']=r['pin']['path'][:3]+r['pin']['path'][3:].swapcase();b['records'].append(r)
        else:
            r=_row(b,'wrapper');v=_json(r['body'])
            if variant=='packet_float':v['extra']=0.5;raw=_wire(v)
            elif variant=='packet_duplicate':raw=r['body'].replace(b'{',b'{"role":"metadata_peer",',1)
            elif variant=='packet_C0':v['extra']='\n';raw=_wire(v)
            elif variant=='packet_surrogate':v['extra']='\ud800';raw=(json.dumps(v,sort_keys=True)+'\n').encode()
            elif variant=='metadata_node_budget':v['extra']=[0]*50000;raw=_wire(v)
            else:raw=b'{'
            r['body']=raw;r['pin']=_pin(r['pin']['path'],raw);b['packet']=raw
        return
    v=_json(_row(b,label)['body'])
    if handler=='delete':parent,key=_parent(v,field);del parent[int(key)if type(parent)is list else key]
    elif handler=='extra':v['unexpected_field']=False
    elif handler=='immutable':
        old=v[field];v[field]=(not old)if type(old)is bool else True if old is None else old+1 if type(old)is int else old+'_changed'
    elif handler=='source_hash':parent,key=_parent(v,field);parent[key]='0'*64
    elif handler=='roster':
        v=_json(_row(b,'wrapper')['body']);label='wrapper';xs=v['role_inputs'][spec['kind']]
        if spec['variant']=='omit':xs.pop()
        elif spec['variant']=='reverse':xs.reverse()
        else:xs.append(copy.deepcopy(xs[0]))
    elif handler=='wrapper_join':
        v=_json(_row(b,'wrapper')['body']);label='wrapper';v[field]=('11234567-89ab-cdef-0123-456789abcdef'if field=='Root_thread'else copy.deepcopy(v['peer_packet']))
    elif handler=='value':
        v[field]=3 if field=='schema_version'else'wrong_record_type'if field=='record_type'else'profile'if field=='role'else _time(19)if label=='decision'else _time(19)if label=='receipt'else _time(1)
    elif handler=='flip':v[field]=not v[field]
    elif handler=='reviewer':
        actor='/root/i2_resume_gap';v['reviewer']='/root/'+actor[len('/root/'):].upper()if spec['variant']=='case_alias'else actor+'/descendant'if spec['variant']=='descendant'else actor
    elif handler=='proof_bool':v[field]=False
    elif handler=='coverage':
        v['subjects']=[copy.deepcopy(_row(b,'owner')['pin'])]
        if 'checks'in v:
            for row in v['checks']:row['evidence']=[]
    else:raise AssertionError('unowned fixture handler '+handler)
    _rewrite(b,label,v)
    if handler=='reviewer' and label.endswith('_full'):
        other=label[:-len('_full')]+'_capsule';capsule=_json(_row(b,other)['body']);capsule['reviewer']=v['reviewer'];_rewrite(b,other,capsule)

def run(*,m3,publisher,peer,catalogue_bytes):
    cases=[];seal=_seal()
    for literal in CASE_CATALOGUE:
        spec=copy.deepcopy(literal);name=spec['name'];expected=spec['expected_error']
        assert not(_mutable_ids(spec)&_mutable_ids(CASE_CATALOGUE))
        if spec['handler']=='isolation':
            a=_make(spec['role'],peer,catalogue_bytes);b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(a)&_mutable_ids(b))and not(_mutable_ids(a)&_mutable_ids(FIXED))
            saved=_fingerprint(b);a['records'][0]['pin'].pop('path');assert _fingerprint(b)==saved and _seal()==seal
        elif spec['handler']=='held':
            flag=peer.ACTUAL_ENTRY_QUALIFIED
            try:
                peer.ACTUAL_ENTRY_QUALIFIED=spec['flag']
                try:peer.emit_selected_peer_current_owner(context=_Hostile())
                except peer.I13MetadataError as e:assert e.code==expected
                else:raise AssertionError('held emitter unexpectedly returned')
            finally:peer.ACTUAL_ENTRY_QUALIFIED=flag
        else:
            b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(b)&_mutable_ids(FIXED))
            if spec['handler']!='positive':
                before=_fingerprint(b);_mutate(b,spec);assert _fingerprint(b)!=before,'mutation did not change typed input'
            try:result=peer.validate_selected_peer_author_packet_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b.get('now_utc',NOW))
            except peer.I13MetadataError as e:
                assert expected is not None and e.code==expected,(name,'wrong typed first guard',e.code,expected)
            else:
                assert expected is None,(name,'expected refusal returned')
                v=_json(result);assert v['role']==spec['role']and v['structural_graph_validated']is True and v['metadata_only']is True
                assert v['full_original_I2_DAG_closed']is False and v['actual_peer_content_qualified']is False and v['current_canonical_authority_qualified']is False and v['native_Parser_authority']is False
                assert type(v['charged_metadata_nodes'])is int and v['charged_metadata_nodes']<=50000
        assert _seal()==seal,'global fixed pin/literal/case specification mutated'
        cases.append(dict(name=name,passed=True));print(json.dumps(dict(event='CASE_PASS',name=name),sort_keys=True),flush=True)
    return dict(cases=cases,passed=len(cases),failed=0,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)
