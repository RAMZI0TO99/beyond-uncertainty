def need(ok, msg):
    if not ok:
        raise ValueError(msg)

def ck(name, ok, evidence=None):
    need(type(ok) is bool, 'Boolean result required')
    checks.append(dict(name=name, passed=ok, evidence=evidence))

def raw(p):
    p = Path(p)
    for q in (p, *p.parents):
        st = q.lstat()
        need(not q.is_symlink() and not getattr(st, 'st_file_attributes', 0) & 1024, 'direct nonreparse metadata lineage')
    a = p.stat()
    need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and 0 <= a.st_size <= 2097152, 'ordinary bounded singlelink metadata')
    with p.open('rb') as h:
        b = os.fstat(h.fileno())
        data = h.read(2097153)
        c = os.fstat(h.fileno())
    d = p.stat()
    key = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns)
    need(key(a) == key(b) == key(c) == key(d) and len(data) == a.st_size, 'samebuffer stable retained metadata')
    return data

def fact(p, data):
    return dict(path=str(p), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def get(p, size=None, sha=None):
    p = Path(p)
    data = raw(p)
    fp = fact(p, data)
    need(size is None or fp['bytes'] == size, 'announced size ' + str(p))
    need(sha is None or fp['sha256'] == sha, 'announced hash ' + str(p))
    buffers[str(p)] = data
    return data, fp

def pairs(items):
    d = {}
    for k, v in items:
        need(k not in d, 'duplicate exact JSON key')
        d[k] = v
    return d

def bad(x):
    raise ValueError('noninteger/nonfinite JSON number')

def shape(v):
    pending = [(v, 0)]
    count = depth = 0
    while pending:
        x, n = pending.pop()
        count += 1
        depth = max(depth, n)
        need(count <= 50000 and n <= 48, 'fullkey metadata node/depth limit')
        need(x is None or type(x) in (dict, list, str, int, bool), 'builtin JSON only')
        if type(x) is str:
            need(not any(0xD800 <= ord(c) <= 0xDFFF for c in x), 'surrogate refusal')
        elif type(x) is list:
            pending.extend((e, n + 1) for e in x)
        elif type(x) is dict:
            for k, value in x.items():
                need(type(k) is str, 'string key')
                pending.extend(((k, n + 1), (value, n + 1)))
    return dict(nodes_including_keys=count, maximum_depth_including_keys=depth)

def doc(p, size=None, sha=None):
    data, fp = get(p, size, sha)
    value = json.loads(data.decode('utf-8'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
    json_shapes[str(p)] = shape(value)
    return value, fp

def pinned_doc(fp):
    return doc(fp['path'], fp['bytes'], fp['sha256'])

