def save(name, value):
    shape(value)
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    need(len(data) <= 2097152, 'bounded proof')
    fresh()
    target = OUT / name
    with target.open('xb') as h:
        need(h.write(data) == len(data), 'whole proof write')
        h.flush()
        os.fsync(h.fileno())
    need(raw(target) == data, 'own proof actual readback')
    return fact(target, data)

