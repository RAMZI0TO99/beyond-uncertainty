"""Genuine independent Root002 metadata review; no reviewed Source execution."""
import ast
import base64
import datetime as dt
import hashlib
import json
import os
import stat
from pathlib import Path

OUT = Path(__file__).parent
R = OUT.parent
S = R.parent / 'pro3_bootstrap002_source_review_001'
WHO = '/root/i13_final_review'
checks, buffers, shapes = [], {}, {}

def need(ok, why):
    if not ok:
        raise ValueError(why)

def ck(name, passed, evidence=None):
    need(type(passed) is bool, 'builtin Boolean check')
    checks.append(dict(name=name, passed=passed, evidence=evidence))

def raw(p):
    p = Path(p)
    for q in (p, *p.parents):
        st = q.lstat()
        need(not q.is_symlink() and not getattr(st, 'st_file_attributes', 0) & 1024, 'direct nonreparse lineage')
    a = p.stat()
    need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and 0 <= a.st_size <= 2097152, 'bounded regular singlelink metadata')
    with p.open('rb') as h:
        b = os.fstat(h.fileno())
        data = h.read(2097153)
        c = os.fstat(h.fileno())
    d = p.stat()
    key = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns)
    need(key(a) == key(b) == key(c) == key(d) and len(data) == a.st_size, 'stable samebuffer metadata')
    return data

def fact(p, b):
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def get(p, size=None, sha=None):
    p = Path(p)
    b = raw(p)
    fp = fact(p, b)
    need(size is None or fp['bytes'] == size, 'announced bytes')
    need(sha is None or fp['sha256'] == sha, 'announced SHA')
    buffers[str(p)] = b
    return b, fp

def pairs(items):
    d = {}
    for k, v in items:
        need(k not in d, 'duplicate JSON key')
        d[k] = v
    return d

def bad(x):
    raise ValueError('noninteger or nonfinite JSON number')

def shape(v):
    pending = [(v, 0)]
    count = depth = 0
    while pending:
        x, d = pending.pop()
        count += 1
        depth = max(depth, d)
        need(count <= 50000 and d <= 48, 'fullkey nodes/depth')
        need(x is None or type(x) in (dict, list, str, int, bool), 'builtin JSON only')
        if type(x) is str:
            need(not any(0xD800 <= ord(c) <= 0xDFFF for c in x), 'surrogate refusal')
        elif type(x) is list:
            pending.extend((e, d + 1) for e in x)
        elif type(x) is dict:
            for k, e in x.items():
                need(type(k) is str, 'string key')
                pending.extend(((k, d + 1), (e, d + 1)))
    return dict(fullkey_nodes=count, maximum_depth=depth)

def doc(p, size=None, sha=None):
    b, fp = get(p, size, sha)
    v = json.loads(b.decode('utf-8'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
    shapes[str(p)] = shape(v)
    return v, fp

def pd(fp):
    return doc(fp['path'], fp['bytes'], fp['sha256'])

