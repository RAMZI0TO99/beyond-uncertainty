need(len(checks) > 0 and len(checks) == len({x['name'] for x in checks}) and all(x['passed'] is True for x in checks), 'no artificial PASS or duplicate checks')
need(len(arts) == len({x['path'].casefold() for x in arts}) and all(Path(x['path']).is_relative_to(R) for x in arts), 'exact unique Root artifact roster')

def save(name,v):
    shape(v)
    data=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
    need(len(data)<=2097152,'own proof cap')
    fresh()
    target=OUT/name
    with target.open('xb') as h:
        need(h.write(data)==len(data),'whole CreateNew proof write')
        h.flush()
        os.fsync(h.fileno())
    need(raw(target)==data,'own proof actual readback')
    return fact(target,data)

