"""Propose finite Source006 only; retain complete Source005 and its actual bound."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file() and not p.is_symlink() and s.st_nlink==1 and s.st_size<=2097152
 for q in (p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes() and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
bp=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_005.json';old=raw(bp);before=pin(bp)
assert before['sha256']=='df9d87bcd45f130a8139743fa2eccbc9f4355b46123679a83e2d0ba6c7c850c4'
v=json.loads(old);now=dt.datetime.now(dt.timezone.utc);end=dt.datetime(2026,10,25,21,55,tzinfo=dt.timezone.utc)
assert (dt.datetime.fromisoformat(v['interval_end'])-now).total_seconds()>60 and (end-now).total_seconds()>60
refusal=pin(R/'ROOT_I13_AGGREGATE_SOURCE_REFUSAL_AND_CURRENT_HELD_STATUS_001.json')
assert refusal['sha256']=='1d5a2ae29d552fb6d04b3a34600cb75a9d324ae0e1135f3223739f0ba176dfa6'
assert not os.path.lexists(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_020.json')
v.update(schema_version=6,created_utc=now.isoformat(),interval_start=now.isoformat(),interval_end=end.isoformat(),
 predecessor_Source_scope=before,Source_scope005_complete_bytes_preserved=True,Source_scope005_review_and_Root_adoption_completed=True,
 Source_scope005_requires_different_review_and_Root_adoption_before_use=False,Source_scope006_requires_different_review_and_Root_adoption_before_use=True,
 predecessor_Source_scope005_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE005_DIFFERENT_REVIEW_ADOPTION_001.json'),
 current_peer_scheduling_release=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_019.json'),
 current_peer019_reported_consumed_closed=pin(R/'coordination/ROOT_RETAINED_PRO3_019_BATCH_C_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'),
 current_peer_aggregate_request001_ungranted=pin(Path('D:/Aenv/pro3/runs/coordination/cho51_canonical_boundary_20261025_v5_aggregate/compute-request_001.json')),
 current_peer_aggregate_Source_refusal=refusal,current_peer_aggregate_allocation_status='NOT_ALLOCATED_SOURCE_OWNERSHIP_BLOCKER',
 grant020_issued=False,current_aggregate_admission_or_attempt_authorized=False,prior_scopes_or_leases_extended=False,peer_grants_not_extended=True,
 new_peer_compute_or_aggregate_allocation_automatically_authorized=False,new_synthetic_or_test_calls_automatically_authorized=False,new_target_Source_automatically_authorized=False,
 current_compact_ABI_protocol_ready=False,current_main936_completed=32,current_main936_passed=20,current_main936_failed=12,current_main936_remaining_unestablished=904,full936_qualification=False,
 current_predecessor_epoch_fields_are_dated_history=True,requested_finite_coordination_end_UTC='2026-10-25T21:55:00+00:00')
v['scope']+=' Fresh finite Source-only window006 continues unchanged Source/metadata/protocol preparation and owner-authorized routine peer-resource coordination through21:55UTC October25, with original60second reserve and maximumPro2three/Pro3two/sharedfive including both roots and overlap. Source005 and all earlier scopes retain their complete bytes and original endpoints. Aggregate request001 was NOT_ALLOCATED after a genuinely different Source review found a stale Toolhelp PID/parent-to-opened-handle identity race. This window may prepare/review immutable supplemental supervisor successors, different Source/input audits and fresh requests preserving all predecessor bytes, but grants no aggregate admission/interpreter/Job/test/target/physical/native/runtime/science call automatically. Every separate aggregate allocation still requires exact accepted new Source/inventory/proof/selection/preceding-full-release review, fresh resources/allfivepauses/unusedidentity/liveRootdecision/finitewindow, maximumzeroJobs and one exact stdlib interpreter within300seconds including45cleanup and actual outer completion/reap/EOF/fullrelease. New Source-only closeout or metadata export selections remain separately reviewed/adopted; no actual family publication, primarysixdocument publication, Git commit/push, reducedcaps or future-runtime/scientific authority follows. All old provenance fields carried in this record are dated history. Existing compact receipt ABI remains NOT_READY with eleven unresolved cells and mainI13 remains20PASS/12FAIL/904unestablished; no full936pass, legacycompatibility or implementation protocol follows.'
def write(p,value):
 b=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(p)
 assert (dt.datetime.fromisoformat(json.loads(old)['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
 with p.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
 assert raw(p)==b
out=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_006.json';inv=R/'ROOT_I13_SOURCE_SCOPE006_COMPLETE005_PREDECESSOR_INVERSE_001.json'
write(out,v);write(inv,dict(author='/root',Source_only=True,complete_predecessor=before,complete_predecessor_base64=base64.b64encode(old).decode(),proposed_successor=pin(out),prior_scopes_or_leases_extended=False,new_operational_lease_issued=False))
print(json.dumps(dict(proposed_Source_scope=pin(out),complete_predecessor_inverse=pin(inv),interval_end=v['interval_end'],new_operational_lease_issued=False)))
