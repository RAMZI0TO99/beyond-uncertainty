BUNDLE_PLAN_ADOPTION={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_I13_EXACT_HELPER_SOURCE_BUNDLE_PLAN_DIFFERENT_REVIEW_ADOPTION_001.json', 'bytes': 1818, 'sha256': 'c1ef8f6ae9ce807077a0b45b0cfa027f42131fc9529073b5a395c0cc73d0351e'}



def need(value, why):
    if not value:
        raise ValueError(why)


def utc():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')


def body(path):
    need(path.is_absolute(), 'absolute file')
    for p in (path, *path.parents):
        q = p.lstat()
        need(not p.is_symlink() and not getattr(q, 'st_file_attributes', 0) & 1024, 'ordinary path')
    a = path.stat()
    need(path.is_file() and a.st_nlink == 1 and 0 <= a.st_size <= CAP, 'bounded ordinary metadata or inert Source')
    with path.open('rb') as h:
        raw = h.read(CAP + 1)
        h.seek(0)
        again = h.read(CAP + 1)
    b = path.stat()
    need(raw == again and len(raw) == a.st_size == b.st_size and
         all(getattr(a, n, None) == getattr(b, n, None) for n in
             ('st_dev', 'st_ino', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes')), 'stable complete metadata bytes')
    return raw


def pin(path, raw=None):
    if raw is None:
        raw = body(path)
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()


def save(path, raw):
    need(0 <= len(raw) <= CAP and not os.path.lexists(path), 'fresh bounded output')
    for parent in path.parents:
        if os.path.lexists(parent):
            info = parent.lstat()
            need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary existing destination parents before directory creation')
    fresh()
    path.parent.mkdir(parents=True, exist_ok=True)
    for parent in path.parents:
        info = parent.lstat()
        need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary destination parents before exclusive file write')
    need(not os.path.lexists(path), 'destination still unused')
    fresh()
    with path.open('xb') as h:
        need(h.write(raw) == len(raw), 'whole write')
        h.flush()
        os.fsync(h.fileno())
    need(body(path) == raw, 'actual whole copy readback')
    return pin(path, raw)


def occurs(value, expected):
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'} and wire(value)==wire(expected):
            return True
        return any(occurs(x, expected) for x in value.values())
    return type(value) is list and any(occurs(x, expected) for x in value)


def baseline():
    baseline_raw = body(BASELINE)
    value = decode(baseline_raw)
    pins = [r['pin'] for r in value['status_records']] + value['primary_documents'] + value['canonical_manifests'] + [value['current_workspace_pointer']]
    need(len(value['status_records']) == 409, 'original409 repository status identities')
    need(len(value['primary_documents']) == 6 and len(value['canonical_manifests']) == 2, 'exact six primary documents and two canonical manifests')
    for p in pins:
        need(pin(Path(p['path'])) == p, 'preserve original repository input bytes')
    return dict(baseline=pin(BASELINE, baseline_raw), checked_pins=len(pins), all_exact=True,
                original_status_identities=409, primary_documents=6, canonical_manifests=2,
                workspace_pointer_unchanged=True)


def fresh():
    raw=exact(SCOPE_PIN);scope=decode(raw);adopted(decode(exact(SCOPE_ADOPTION_PIN)),SCOPE_PIN)
    now=dt.datetime.now(dt.timezone.utc)
    need(scope['author']=='/root'and scope['target_execution']is False and scope['operational_authority']is False and scope['new_operational_execution_lease_issued']is False,'Source-only Root scheduling')
    need(dt.datetime.fromisoformat(scope['interval_start'])<=now and(dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60,'original strict60 publication reserve')
    return pin(SCOPE,raw)



def prepare(nav,bundle_review_adoption,run_review_adoption):
    scope=fresh();preservation=baseline();evidence=bundle_evidence(bundle_review_adoption);run_evidence_value=run_evidence(run_review_adoption)
    need(nav.is_relative_to(PUB)and nav.is_file(),'prepared navigation in dedicated publication directory')
    need(not os.path.lexists(DEST)and not os.path.lexists(REPO/'CONTINUE_CURRENT_I13_20261025.json'),'unused managed destination and navigation')
    all_members=evidence['members']+run_evidence_value['members'];need(len({p['original']['path'].casefold()for p in all_members})==len(all_members),'disjoint exact helper/run members');omitted={p['original']['path']:p['original']for p in all_members};rows=[];actual_omitted=[]
    for source in sorted(ROOT.rglob('*')):
        if not source.is_file()or source.is_relative_to(PUB):continue
        need(source.suffix in('.json','.py','.txt','.source','.draft'),'metadata and inert Source only')
        source_pin=pin(source)
        if str(source)in omitted:
            need(source_pin==omitted[str(source)],'only exact frozen Source member omitted');actual_omitted.append(source_pin);continue
        relative=source.relative_to(SUBJECTS)if source.is_relative_to(SUBJECTS)else Path('root_workspace')/source.relative_to(ROOT)
        if source.suffix=='.py':relative=Path(str(relative)+'.source')
        destination=DEST/relative
        rows.append(dict(source=source_pin,destination=str(destination),relative_path=destination.relative_to(REPO).as_posix(),source_copy_inert=source.suffix in('.py','.source','.draft')))
    need(sorted(actual_omitted,key=lambda p:p['path'].casefold())==sorted([m['original']for m in all_members],key=lambda p:p['path'].casefold()),'all and only exact reviewed helper/run members bundled')
    source_paths={x['source']['path']for x in rows}
    need(all(p['path']in source_paths for p in evidence['bundles']+run_evidence_value['bundles'])and evidence['bundle_index']['path']in source_paths and run_evidence_value['bundle_index']['path']in source_paths,'every helper/run bundle and index direct copied')
    destination=REPO/'CONTINUE_CURRENT_I13_20261025.json'
    rows.append(dict(source=pin(nav),destination=str(destination),relative_path=destination.relative_to(REPO).as_posix(),source_copy_inert=False))
    need(1<=len(rows)<=512 and sum(x['source']['bytes']for x in rows)<=67108864,'bounded final inventory or refuse without waiver')
    need(len({x['destination'].casefold()for x in rows})==len(rows),'unique managed destinations')
    need(all(not os.path.lexists(x['destination'])for x in rows),'all managed file identities unused')
    value=dict(schema_version=2,record_type='Root_I13_exact_additive_inert_managed_publication_candidate',author='/root',actual_publication_helper_Source_editor='/root/project_architecture',created_utc=utc(),
        source_scope=scope,baseline_preservation=preservation,files=rows,file_count=len(rows),payload_bytes=sum(x['source']['bytes']for x in rows),
        exact_index_destination=str(DEST/'MANAGED_I13_PORTABILITY_INDEX_001.json'),publication_helper=pin(Path(__file__)),publication_reserve_seconds=60,
        metadata_helper_bundles=evidence,owned_run_metadata_bundles=run_evidence_value,transforms='Only exact reviewed160 helper Sources and exact reviewed owned-run metadata use complete Base64 JSON bundles. All other complete bytes stay direct; .py direct-copy filenames only receive .source suffix. Original internal path pins remain exact.',
        previous_evidence_and_primary_documents_preserved=True,original75_spent_identities_unreplayed=True,target_execution=False,tests_executed=False,actual_family_publication=False,
        operational_authority=False,scientific_authority=False,no_step081_or_operational_lease=True,staged=False,committed=False,pushed=False)
    result=save(PUB/'ROOT_I13_EXACT_MANAGED_PUBLICATION_CANDIDATE_001.json',wire(value));fresh()
    print(json.dumps(dict(candidate=result,files=len(rows),payload_bytes=value['payload_bytes'],bundled_original_helpers=160)))



def publish(candidate,adoption):
    scope=fresh();candidate_raw,adoption_raw=body(candidate),body(adoption)
    candidate_pin,adoption_pin=pin(candidate,candidate_raw),pin(adoption,adoption_raw)
    value=decode(candidate_raw);adopted(decode(adoption_raw),candidate_pin)
    need(value['publication_helper']==pin(Path(__file__))and value['record_type']=='Root_I13_exact_additive_inert_managed_publication_candidate'and type(value['schema_version'])is int and value['schema_version']==2,'same reviewed publication helper and candidate')
    evidence=bundle_evidence(Path(value['metadata_helper_bundles']['bundle_reconstruction_Root_adoption']['path']))
    need(evidence==value['metadata_helper_bundles'],'exact complete reviewed helper bundle context at publication')
    run_evidence_value=run_evidence(Path(value['owned_run_metadata_bundles']['bundle_reconstruction_Root_adoption']['path']))
    need(run_evidence_value==value['owned_run_metadata_bundles'],'exact complete reviewed run bundle context at publication')
    preservation=baseline();rows=value['files'];index=Path(value['exact_index_destination'])
    need(type(rows)is list and 1<=len(rows)<=512 and type(value['file_count'])is int and len(rows)==value['file_count'],'bounded exact candidate count')
    need(sum(fact(x['source'])['bytes']for x in rows)<=67108864 and sum(x['source']['bytes']for x in rows)==value['payload_bytes'],'unchanged final payload cap')
    need(index==DEST/'MANAGED_I13_PORTABILITY_INDEX_001.json'and not os.path.lexists(index),'fresh exact index')
    need(len({x['destination'].casefold()for x in rows})==len(rows),'unique actual destinations')
    omitted={m['original']['path']for m in evidence['members']+run_evidence_value['members']}
    for row in rows:
        source,destination=Path(row['source']['path']),Path(row['destination'])
        need(destination.is_relative_to(DEST)or destination==REPO/'CONTINUE_CURRENT_I13_20261025.json','reviewed additive managed containment')
        need(str(source)not in omitted and pin(source)==row['source']and not os.path.lexists(destination),'exact direct sources and all unused destinations before first write')
    source_set={x['source']['path']for x in rows}
    need(all(p['path']in source_set for p in evidence['bundles']+run_evidence_value['bundles'])and evidence['bundle_index']['path']in source_set and run_evidence_value['bundle_index']['path']in source_set,'complete direct helper/run bundle and index roster')
    actual=[]
    for row in rows:
        fresh();raw=body(Path(row['source']['path']));need(pin(Path(row['source']['path']),raw)==row['source'],'exact source at copy')
        copied=save(Path(row['destination']),raw);actual.append(dict(source=row['source'],copy=copied,relative_path=row['relative_path'],copy_matches_source=True))
    copies={x['source']['path']:x['copy']for x in actual}
    bundled=[dict(original=m['original'],bundle_source=m['bundle'],bundle_copy=copies[m['bundle']['path']],member_ordinal=m['member_ordinal'])for m in evidence['members']]
    run_bundled=[dict(original=m['original'],bundle_source=m['bundle'],bundle_copy=copies[m['bundle']['path']],member_ordinal=m['member_ordinal'])for m in run_evidence_value['members']]
    indexed=dict(schema_version=2,record_type='Root_I13_actual_inert_managed_portability_index',author='/root',actual_publication_helper_Source_editor='/root/project_architecture',created_utc=utc(),
        candidate=candidate_pin,candidate_Root_adoption=adoption_pin,source_scope=scope,files=actual,file_count=len(actual),metadata_helper_bundles=evidence,
        bundled_helper_members=bundled,bundled_original_member_count=160,owned_run_metadata_bundles=run_evidence_value,bundled_run_members=run_bundled,bundled_run_member_count=len(run_bundled),member_ordinal_base=0,all_copies_byte_identical=True,direct_copy_Source_suffix_only_transform=True,
        actual_family_publication=False,target_execution=False,operational_authority=False,scientific_authority=False,
        current_dated_Source_inventory=dict(present=36,pending=9),frozen_STEP080_inventory=dict(present=35,pending=10),
        actual_creation_requires_different_saved_review_and_Root_adoption=True,staged=False,committed=False,pushed=False)
    index_pin=save(index,wire(indexed))
    receipt=dict(schema_version=2,record_type='Root_I13_actual_inert_managed_creation_receipt',author='/root',actual_publication_helper_Source_editor='/root/project_architecture',created_utc=utc(),
        candidate=candidate_pin,candidate_Root_adoption=adoption_pin,actual_index=index_pin,file_count=len(actual),bundled_original_helper_count=160,
        all_exact=True,initial_preservation=preservation,final_preservation=baseline(),target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False,
        no_step081_or_operational_lease=True,staged=False,committed=False,pushed=False)
    receipt_pin=save(PUB/'ROOT_I13_ACTUAL_MANAGED_CREATION_RECEIPT_001.json',wire(receipt));fresh()
    print(json.dumps(dict(receipt=receipt_pin,actual_index=index_pin,copied_files=len(actual),bundled_original_helpers=160)))




def pairs(items):
    value={}
    for key,child in items:
        need(key not in value,'duplicate metadata key');value[key]=child
    return value

def bad(value):
    raise ValueError('float or nonfinite metadata number')

def decode(raw):
    need(type(raw)is bytes and len(raw)<=CAP,'bounded metadata bytes')
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def fact(value):
    need(type(value)is dict and set(value)=={'path','bytes','sha256'}and all(type(k)is str for k in value),'closed fact3')
    need(type(value['path'])is str and type(value['bytes'])is int and 0<=value['bytes']<=CAP and type(value['sha256'])is str and len(value['sha256'])==64 and all(c in'0123456789abcdef'for c in value['sha256']),'typed fact3')
    need(Path(value['path']).is_absolute()and not any(ord(c)<32 for c in value['path']),'ordinary absolute path text')
    return value

def exact(subject):
    fact(subject);path=Path(subject['path']);raw=body(path)
    need(pin(path,raw)==subject,'exact whole pinned metadata bytes');return raw

def adopted(value,subject):
    need(type(value)is dict and value.get('author')=='/root'and type(value.get('verdict'))is str and value['verdict'].startswith('ACCEPT_')and value.get('target_execution')is False and value.get('operational_authority')is False and value.get('scientific_authority')is False and occurs(value,subject),'exact Root reviewed subject adoption')

def bundle_evidence(review_adoption):
    fresh();plan=decode(exact(BUNDLE_PLAN));adopted(decode(exact(BUNDLE_PLAN_ADOPTION)),BUNDLE_PLAN)
    need(plan['member_count']==160 and plan['member_bytes']==1353151 and plan['maximum_metadata_file_bytes']==CAP and plan['maximum_actual_copy_rows']==512 and plan['maximum_actual_copy_payload_bytes']==67108864,'fixed packaging bounds')
    members=plan['members'];need(type(members)is list and len(members)==160,'fixed original membership')
    names=[fact(p)['path']for p in members]
    need(names==sorted(names,key=str.casefold)and len(set(x.casefold()for x in names))==160,'fixed unique ordered original Sources')
    index_raw=body(BUNDLE_INDEX);index_pin=pin(BUNDLE_INDEX,index_raw);index=decode(index_raw)
    need(index['record_type']=='I13_inert_metadata_helper_Source_bundle_index'and index['packaging_plan']==BUNDLE_PLAN and index['packaging_plan_Root_adoption']==BUNDLE_PLAN_ADOPTION,'exact bundle index domain')
    need(index['bundle_author_Source']==BUNDLE_AUTHOR_SOURCE,'fixed reviewed bundle author Source')
    adopted(decode(exact(index['bundle_author_Source_Root_adoption'])),BUNDLE_AUTHOR_SOURCE)
    need(index['Source_scope']==HELPER_BUNDLE_SOURCE_SCOPE_PIN and index['member_count']==160 and index['original_member_bytes']==1353151 and index['member_ordinal_base']==0 and index['actual_bundles_created']is True and index['original_files_modified']is False and index['all_complete_original_bytes_reconstruct_exactly']is True,'bundle index completeness and inertness')
    for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(index[flag]is False,'bundle index false authorities')
    review_raw=body(review_adoption);adopted(decode(review_raw),index_pin);review_pin=pin(review_adoption,review_raw)
    bundles=index['bundles'];need(type(bundles)is list and 1<=len(bundles)<=160 and type(index['bundle_count'])is int and index['bundle_count']==len(bundles),'bounded bundle roster')
    mapping=[];seen=set()
    for number,bundle_pin in enumerate(bundles,1):
        path=Path(fact(bundle_pin)['path'])
        need(path==BUNDLE_DIR/('I13_METADATA_HELPER_SOURCE_BUNDLE_'+str(number).zfill(3)+'.json')and path.name.casefold()not in seen,'exact consecutive bundle path')
        seen.add(path.name.casefold());value=decode(exact(bundle_pin))
        need(value['record_type']=='I13_complete_inert_metadata_helper_Source_bundle'and value['bundle_ordinal']==number and type(value['bundle_ordinal'])is int and value['packaging_plan']==BUNDLE_PLAN and value['packaging_plan_Root_adoption']==BUNDLE_PLAN_ADOPTION and value['Source_scope']==HELPER_BUNDLE_SOURCE_SCOPE_PIN,'exact recorded bundle context')
        for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(value[flag]is False,'bundle false authorities')
        need(type(value['members'])is list and bool(value['members']),'nonempty complete bundle members')
        for ordinal,member in enumerate(value['members']):
            need(type(member)is dict and set(member)=={'original','canonical_base64'}and type(member['canonical_base64'])is str,'closed encoded Source member')
            original=fact(member['original']);original_path=Path(original['path'])
            need(original_path.is_relative_to(ROOT)and not original_path.is_relative_to(SUBJECTS)and not original_path.is_relative_to(PUB)and original_path.suffix=='.py','metadata helper domain only')
            decoded=base64.b64decode(member['canonical_base64'],validate=True)
            need(decoded==exact(original)and base64.b64encode(decoded).decode('ascii')==member['canonical_base64'],'exact canonical whole Source inverse')
            mapping.append(dict(original=original,bundle=bundle_pin,member_ordinal=ordinal))
    need([m['original']for m in mapping]==members and len(mapping)==160 and mapping==index['members'],'every selected Source and indexed ordinal exactly once')
    need(sum(m['bytes']for m in members)==1353151,'complete original Source byte total')
    return dict(packaging_plan=BUNDLE_PLAN,packaging_plan_Root_adoption=BUNDLE_PLAN_ADOPTION,bundle_index=index_pin,
        bundle_author_Source=BUNDLE_AUTHOR_SOURCE,bundle_author_Source_Root_adoption=index['bundle_author_Source_Root_adoption'],
        bundle_reconstruction_Root_adoption=review_pin,bundles=bundles,members=mapping,member_count=160,original_member_bytes=1353151)


RUN_BUNDLE_INDEX=ROOT/'owned_run_metadata_bundles_001/I13_OWNED_RUN_METADATA_BUNDLE_INDEX_001.json'
RUN_BUNDLE_AUTHOR_SOURCE={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\prepare_I13_owned_run_metadata_bundles_001.py', 'bytes': 11279, 'sha256': '02a850f634bb9648f98657f273e04fe956af62482174743e21733c2e8ab61cef'}

def eligible(path):
    need(path.is_absolute() and '..' not in path.parts and path.resolve()==path, 'canonical original metadata path')
    if path.parent==SUBJECTS:
        return bool(re.fullmatch(r'ROOT_I13_(?:ONCE_SYNTHETIC_MEMORY_SCOPE_\d{3}|FRESH_ONCE_PRELAUNCH_METADATA_\d{3}|ONCE\d{3}_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001)\.json',path.name))
    return path.parent.parent==SUBJECTS/'owned_memory_runs' and bool(re.fullmatch(r'attempt\d{3}',path.parent.name)) and path.name in {
        'SCOPE_CLAIM_001.json','CHILD_ENTRY_001.json','CHILD_RESULT_001.json','CHILD_STDOUT_001.txt','CHILD_STDERR_001.txt','SUPERVISOR_RESULT_001.json','PARENT_TOOL_STDOUT_RETAINED_001.txt','ROOT_ACTUAL_PARENT_EXEC_TOOL_RETURN_001.json'}


def run_evidence(review_adoption):
    fresh();index_raw=body(RUN_BUNDLE_INDEX);index_pin=pin(RUN_BUNDLE_INDEX,index_raw);index=decode(index_raw)
    need(index['record_type']=='I13_inert_owned_run_metadata_bundle_index'and index['Source_scope']==SCOPE_PIN and index['bundle_author_Source']==RUN_BUNDLE_AUTHOR_SOURCE,'exact run bundle domain/Source')
    adopted(decode(exact(index['bundle_author_Source_Root_adoption'])),RUN_BUNDLE_AUTHOR_SOURCE)
    plan_pin=fact(index['packaging_plan']);plan=decode(exact(plan_pin));adopted(decode(exact(index['packaging_plan_Root_adoption'])),plan_pin)
    need(plan['record_type']=='Root_I13_exact_consumed_owned_run_metadata_bundle_selection'and plan['author']=='/root'and plan['Source_scope']==SCOPE_PIN,'exact reviewed run selection')
    need(plan['maximum_metadata_file_bytes']==CAP and plan['maximum_actual_copy_rows']==512 and plan['maximum_actual_copy_payload_bytes']==67108864,'all inherited caps unchanged')
    members=plan['members'];need(type(members)is list and 1<=len(members)<=512 and type(plan['member_count'])is int and len(members)==plan['member_count'],'bounded original membership')
    names=[fact(p)['path']for p in members];need(names==sorted(names,key=str.casefold)and len(set(p.casefold()for p in names))==len(names),'exact unique original order')
    need(index['member_count']==len(members)and index['original_member_bytes']==plan['original_member_bytes']and index['member_ordinal_base']==0 and index['original_files_modified']is False and index['all_complete_original_bytes_reconstruct_exactly']is True and index['actual_bundles_created']is True,'actual run reconstruction completeness')
    for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(index[flag]is False and plan[flag]is False,'inert original/result selection')
    review_raw=body(review_adoption);adopted(decode(review_raw),index_pin);review_pin=pin(review_adoption,review_raw)
    bundles=index['bundles'];need(type(bundles)is list and 1<=len(bundles)<=512 and type(index['bundle_count'])is int and index['bundle_count']==len(bundles),'bounded exact bundle roster')
    mapping=[]
    for number,bundle_pin in enumerate(bundles,1):
        path=Path(fact(bundle_pin)['path']);need(path==RUN_BUNDLE_INDEX.parent/('I13_OWNED_RUN_METADATA_BUNDLE_'+str(number).zfill(3)+'.json'),'exact consecutive run bundle path')
        value=decode(exact(bundle_pin));need(value['record_type']=='I13_complete_inert_owned_run_metadata_bundle'and type(value['bundle_ordinal'])is int and value['bundle_ordinal']==number and value['Source_scope']==SCOPE_PIN and value['packaging_plan']==plan_pin and value['packaging_plan_Root_adoption']==index['packaging_plan_Root_adoption'],'whole run context')
        for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(value[flag]is False,'inert bundle')
        need(type(value['members'])is list and 1<=len(value['members'])<=256,'bounded complete members')
        for ordinal,member in enumerate(value['members']):
            need(type(member)is dict and set(member)=={'original','canonical_base64'}and type(member['canonical_base64'])is str,'closed encoded metadata member')
            original=fact(member['original']);need(eligible(Path(original['path'])),'eligible opaque run metadata only')
            decoded=base64.b64decode(member['canonical_base64'],validate=True);need(decoded==exact(original)and base64.b64encode(decoded).decode('ascii')==member['canonical_base64'],'strict complete run byte inverse')
            mapping.append(dict(original=original,bundle=bundle_pin,member_ordinal=ordinal))
    need([m['original']for m in mapping]==members and mapping==index['members']and sum(p['bytes']for p in members)==plan['original_member_bytes']<=67108864,'all selected exact originals once')
    return dict(packaging_plan=plan_pin,packaging_plan_Root_adoption=index['packaging_plan_Root_adoption'],bundle_index=index_pin,bundle_author_Source=RUN_BUNDLE_AUTHOR_SOURCE,bundle_author_Source_Root_adoption=index['bundle_author_Source_Root_adoption'],bundle_reconstruction_Root_adoption=review_pin,bundles=bundles,members=mapping,member_count=len(mapping),original_member_bytes=plan['original_member_bytes'])


