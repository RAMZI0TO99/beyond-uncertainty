SCOPE_PIN = {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json', 'bytes': 8839, 'sha256': '726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'}
