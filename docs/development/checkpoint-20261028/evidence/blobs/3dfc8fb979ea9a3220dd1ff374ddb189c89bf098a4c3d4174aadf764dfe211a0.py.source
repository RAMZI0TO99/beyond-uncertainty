"""Root joins exact peer timeout/cleanup reports; no peer validation acceptance."""
import datetime as dt,decimal,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent.parent;P=Path('D:/Aenv/pro3/runs/coordination/cho51_canonical_boundary_20261025_v4')
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file()and not p.is_symlink()and s.st_nlink==1 and s.st_size<=2097152
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes()and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def read(p):return json.loads(raw(p),parse_float=decimal.Decimal)
gp=R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_016.json';g=read(gp)
assert pin(gp)['sha256']=='0d8b4a45933b487aeb45ca3d69ebeaf21d6368a2c90e51520a9f4818a949e5db'
lp=P/'lease-closeout_001.json';cp=P/'timeout-closeout_001.json';sp=P/'timeout-closeout-supervision_001.json'
l=read(lp);c=read(cp);s=read(sp)
assert l['peer_release_sha256']==c['peer_release_sha256']==pin(gp)['sha256']
assert l['external_timeout_closeout_sha256']==pin(cp)['sha256'] and l['external_supervision_sha256']==pin(sp)['sha256']
assert l['pins_sha256']==c['pins_sha256']==g['pins_sha256']
assert l['full_compute_custody_released']is l['launcher_session_reaped']is l['external_owned_tree_reaped']is l['external_stdout_eof']is l['external_stderr_eof']is True
assert l['guard_attempts_consumed']==l['jobs_created']==l['jobs_executed']==1 and l['native_result']=='attempt_deadline_exit_1'
assert s['exit_code']==l['external_exit_code']==0 and s['limit_seconds']==l['external_limit_seconds']==300
assert decimal.Decimal(0)<s['elapsed_seconds']==l['external_elapsed_seconds']<=300
assert s['timed_out']is False and s['stop_reason']is None and s['owned_tree_reaped']is s['stdout_eof']is s['stderr_eof']is True
assert s['candidate_imported']is s['job_created']is s['validation_passed']is s['complete_runtime_counter_report_available']is s['scientific_admission']is False
assert c['cleanup_verified']is c['fresh_native_job_absent']is c['native_closed_empty']is c['native_handles_closed']is True
assert c['exit_code']==1 and c['reason']=='attempt_deadline'
assert l['validation_passed']is l['complete_runtime_counter_report_available']is l['scientific_admission']is l['automatic_retry_permitted']is False
assert c['validation_passed']is c['successful_test_evidence']is c['complete_runtime_counter_report_available']is c['scientific_admission']is False
assert c['expected_numerical_budget']==g['expected_numerical_budget']and all(type(v)is int for v in c['expected_numerical_budget'].values())
helper=pin(P/'timeout_closeout_001.py');reviewp=P/'timeout-auditor-source-review_001.json';review=read(reviewp)
assert helper['sha256']==s['auditor_sha256']==review['sha256']=='be39223a025c80fbe957d2f0704a00f2326023ffd97c76bf5d214b3e83d1913a'
assert review['accepted']is True and review['remaining_actionable_findings']==[]
np=Path('D:/Aenv/pro3/runs/migration/20261025T182023Z_be9e746d5e/receipt.json')
assert pin(np)['sha256']==l['native_receipt_sha256']==c['native_receipt_sha256']
end=dt.datetime.fromisoformat(g['window_end_utc']);assert dt.datetime.fromisoformat(s['ended_utc'])<=dt.datetime.fromisoformat(l['released_utc'])<=end
scopep=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004_002.json';scope=read(scopep);now=dt.datetime.now(dt.timezone.utc)
assert(dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_retained_peer016_timeout_and_reported_full_custody_release_only',author='/root',created_utc=now.isoformat(),Source_scope=pin(scopep),
 grant=16,compute_grant=pin(gp),grant_consumed_closed=True,peer_lease_closeout=pin(lp),peer_timeout_closeout=pin(cp),peer_external_supervision=pin(sp),
 peer_native_receipt=pin(np),peer_timeout_cleanup_Source=helper,peer_timeout_cleanup_different_Source_review=pin(reviewp),
 Root_exact_cleanup_scope_ack=pin(R/'coordination/ROOT_PRO3_GRANT016_EXACT_TIMEOUT_CLEANUP_SCOPE_ACKNOWLEDGMENT_001.json'),
 peer_reported_full_release=True,peer_explicit_released_utc=l['released_utc'],reported_full_compute_custody_released=True,
 peer_reported_jobs_created=1,peer_reported_native_exit=1,peer_reported_native_reason='attempt_deadline',
 peer_reported_external_elapsed_seconds_decimal=str(s['elapsed_seconds']),peer_reported_external_exit_code=0,peer_reported_owned_tree_reaped=True,
 peer_reported_validation_passed=False,complete_runtime_counter_report_available=False,observed_numerical_zero_budget_verified=False,
 expected_numerical_budget_only=c['expected_numerical_budget'],incomplete_progress_not_counted_as_test_pass=True,
 old_grant_reuse_authorized=False,new_peer_grant_issued=False,grant016_extended=False,new_Job_or_retry_authorized=False,
 Root_acceptance=dict(peer_result_accepted=False,scientific_acceptance=False,whole_host_quiet_proved=False,physical_handle_absence_proved=False),
 Pro2_actual_family_Native8_Parser_runtime_science_admission=False,target_execution=False,operational_authority=False,scientific_authority=False,
 original_I13_result_unchanged=dict(passed=20,failed=12,remaining_current_cases_unestablished=904,full936_pass=False))
out=R/'coordination/ROOT_RETAINED_PRO3_016_TIMEOUT_AND_FULL_CUSTODY_RELEASE_REPORT_001.json';b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert raw(out)==b;print(json.dumps(pin(out)))
