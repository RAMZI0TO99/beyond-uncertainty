from pathlib import Path
import datetime as dt,os
D=Path(__file__).parent;p=D/'review_supervisor002_consolidated_refusal_001.py';b=p.read_bytes();lines=b.decode('utf8').splitlines(keepends=True)
prefix="ck('original60_50_10_5_caps_exact',"
assert sum(x.startswith(prefix)for x in lines)==1
replacement="""budgetcall=next(n.value for n in pt.body if isinstance(n,ast.Assign)and any(isinstance(x,ast.Name)and x.id=='BUDGETS'for x in n.targets))
budgets={x.arg:ast.literal_eval(x.value)for x in budgetcall.keywords}
ck('original60_50_10_5_caps_exact',literal(pt,'MAX_BYTES')==2097152 and budgets==dict(total_seconds=60,wait_seconds=50,cleanup_seconds=10,reap_seconds=5,stdout_maximum_bytes=2097152,stderr_maximum_bytes=2097152),'Fixed BUDGETS declare60total/50wait/10cleanup/5reap and2MiB each stream; dormant wait is narrowed45 to reserve5 evidence within60, never increased.')
"""
out=''.join(replacement if x.startswith(prefix)else x for x in lines).encode('utf8');q=D/'review_supervisor002_consolidated_refusal_002.py'
assert len(out)<2097152 and(dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
with q.open('xb')as h:assert h.write(out)==len(out);h.flush();os.fsync(h.fileno())
assert q.read_bytes()==out
