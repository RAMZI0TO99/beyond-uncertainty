"""Own additive protocol DATA binding for one authenticated descriptive LF leaf."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).parent
PEER = HERE.parent / 'canonical_peer_protocol_audit_001'

def fact(path):
    raw = path.read_bytes()
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

def read(path):
    def pairs(items):
        out = {}
        for key, value in items:
            if key in out:
                raise ValueError('duplicate')
            out[key] = value
        return out
    def reject(token):
        raise ValueError(token)
    return json.loads(path.read_bytes(), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)

def save(name, value):
    raw = (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    if len(raw) > 2097152:
        raise ValueError('cap')
    with (HERE / name).open('xb') as handle:
        handle.write(raw)
    if (HERE / name).read_bytes() != raw:
        raise ValueError('readback')
    return fact(HERE / name)

def main():
    c3 = HERE / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_003.json'
    p3 = HERE / 'I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_003.json'
    annex_path = PEER / 'I13_PROPOSED_EXACT_FIXED_INVENTORY_SINGLE_DESCRIPTIVE_LF_ANNEX_002.json'
    sweep_path = PEER / 'I13_LIMITED_MANDATORY_FIXED_JSON_C0_SURROGATE_NODE_SWEEP_001.json'
    c, p, annex = read(c3), read(p3), read(annex_path)
    rule = annex['exact_exception']
    c['predecessor_unadopted_catalogue'] = fact(c3)
    c['fixed_inventory_LF_annex'] = fact(annex_path)
    c['fixed_inventory_descriptive_LF_rule'] = {key: value for key, value in rule.items()
        if key != 'exact_descriptive_value_utf8_base64'}
    c['fixed_inventory_descriptive_LF_policy'] = [
        'Only exactrecord_fact3 whole rawbody authenticatedbeforedecode may use exactpointercomponents. The exact367UTF8byte/SHA/10LFstring may contain LFcodepoint10; nootherC0atthatleaf. No callerboolean, marker, pointeralone or matchingbytes atothernativepath.',
        'All wholemetadata types/keys/values/surrogates/UTF8/hash/length/duplicate/number/depth48/node50000/records256/raw32MiB/perbody2MiB guards unchanged. Entireleaf/keys/tree retained andcounted; no subtreeopacity or skipped actor/pin/pathchecks. This descriptiveSourceassignment is never executed/parsed asPython or upgradedtoauthority.',
        'All C0 otherrecords/pointers/keys stillrefuse, except separatelyadoptedexactI11API007/root.literal_case_catalogue priorpolicy unchanged. No generalcodeSource/descriptive/review/API exception.',
        'Annex002 carries ASCIIBase64 witness, notactualLF. Annex/audit/finding/backgroundprovenancepins are not recursivelydesignatedmetadataauthority edges. FinalpureSource embedsliteralannexpin+exactcompactguard; peerAPI14.protocol stayscore004. No runtimeannexC0waiver or selfhashcycle.',
        'Eachinvocationcountsfullmandatoryinventory oncebylocalcache; independentportsmaychargeagainconservatively. CONServativecountermode/charged_metadata_nodes andallcaps unchanged. Mutatedfixedleaf firstfailswholehash/pin, andfixturelabelsactualfirstguard.'
    ]
    c['primitive_types']['finite_strict_metadata'] = 'ExactbuiltinJSONtypes only,nofloat/constant/BOM/duplicates/nonbuiltinkeys/surrogates. C0refusedexcept precise fixed_inventory_descriptive_LF_rule andseparatelyadoptedexactI11API007/root.literal_case_catalogue; wholetypes/nodes/depth/hash/byteguards unchanged.'
    c['fixed_data_sweep_basis'] = fact(sweep_path)
    catalogue_pin = save('I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_004.json', c)
    p['predecessor_unadopted_proposal'] = fact(p3)
    p['catalogue'] = catalogue_pin
    p['fixed_inventory_LF_annex'] = fact(annex_path)
    p['fixed_data_sweep_basis'] = fact(sweep_path)
    p['fixed_inventory_descriptive_LF_policy'] = c['fixed_inventory_descriptive_LF_policy']
    p['strict_types_and_counters'] = [
        text.replace('Generic semantic strings reject C0.', 'Generic semantic strings reject C0 except exact authenticated fixedinventory leaf per fixed_inventory_LF_annex.')
        .replace('no broad new opaque exception', 'no broad new opaque exception') for text in p['strict_types_and_counters']]
    p['exact_correction_inventory'] += [
        'Common004 adds only one exactmandatoryinventorywholepin/pointer/367UTF8bytes/SHA/10LF valueguard from independentlyreviewedannex002; fulltree/type/hash/counter/actor/pin checks unchanged. Protocol003/schemas/corepeer004 retained.',
        'Catalogue contains compactrule only, notactualLFleaf; annexpin points C0-freeASCIIBase64witness002. FinalRootadoption separatelybindspeer004,roledata001,common004,annex002+sweep and genuine reviews withoutbidirectionalhashcycle.'
    ]
    p['finite_required_controls']['positive'] += ['exactwholefixedinventorybodywithsingleauthenticatedLFleaf andfullnodecharge']
    p['finite_required_controls']['refusal'] += ['ordinaryLFatotherpointer/path/keyrefuses;mutatedfixedinventorybody/leaftruthfullyfirsthashpinrefusal;nodechargefullleafnotopaque']
    p['adoption_subject_policy'] = 'Completecommon004proposal/catalogue plus exactpeer004/roledata001 andexactLFannex002/sweepbasis requiregenuine different reviews+Rootadoption beforeTargetSourceauthoring. All003/002/001drafts/reviews preserved; original430checkreview didnotcoverfixedinventoryC0predicate. API14.protocol corepeer004 unchanged; newSource fixesannexpin+finalcataloguepin, externalRootadoptionbindsfinalset. NoScope/test/lease/gate extended.'
    p['complete_schema_policy'] = p['complete_schema_policy'].replace('Catalogue003', 'Catalogue004').replace('in003', 'in004')
    protocol_pin = save('I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_004.json', p)
    print(json.dumps({'catalogue': catalogue_pin, 'protocol': protocol_pin}))

if __name__ == '__main__':
    main()
