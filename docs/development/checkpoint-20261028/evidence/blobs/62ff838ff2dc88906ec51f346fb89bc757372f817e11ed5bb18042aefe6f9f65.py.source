REWRITE=r'''    def rewrite(self, label, value, path=None):
        # A bounded snapshot and topological pass avoids repeated dense-DAG rehash.
        records=self.b['records'];assert type(records)is list and len(records)<=256
        target=next(i for i,r in enumerate(records)if r['pin']['path']==self.b['labels'][label])
        snapshot=copy.deepcopy(records);old=snapshot[target]['pin'];path=path or old['path']
        raw=value if type(value)is bytes else _ow_wire(value)
        bypath={r['pin']['path']:i for i,r in enumerate(snapshot)}
        assert len(bypath)==len(snapshot)
        values={}
        for i,r in enumerate(snapshot):
            if r['pin']['path'] in self.mutable or i==target:
                try:values[i]=_ow_json(raw if i==target else r['body'])
                except (ValueError,UnicodeError):pass
        dependencies={}
        for i,v in values.items():
            dependencies[i]=set()
            for ref in _ow_pins(v):
                key=ref.get('path')
                if type(key)is str and key in bypath:
                    j=bypath[key]
                    if ref==snapshot[j]['pin']:dependencies[i].add(j)
        affected={target}
        for unused in range(len(snapshot)):
            more={i for i,d in dependencies.items()if d & affected}
            if more<=affected:break
            affected|=more
        pending=set(affected);resolved={};bodies={}
        def rebind(v):
            if type(v)is dict:
                if set(v)=={'path','bytes','sha256'}:
                    key=v.get('path')
                    if type(key)is str and key in bypath:
                        j=bypath[key]
                        if j in resolved and v==snapshot[j]['pin']:return copy.deepcopy(resolved[j])
                    return copy.deepcopy(v)
                return{k:rebind(child)for k,child in v.items()}
            if type(v)is list:return[rebind(child)for child in v]
            return v
        for unused in range(len(snapshot)):
            ready=sorted(i for i in pending if not(dependencies.get(i,set()) & pending))
            if not ready:break
            for i in ready:
                if i in values:
                    updated=rebind(values[i])
                    body=(_ow_wire(updated)if i==target or updated!=values[i]else snapshot[i]['body'])
                else:body=raw if i==target else snapshot[i]['body']
                destination=path if i==target else snapshot[i]['pin']['path']
                bodies[i]=body;resolved[i]=_ow_pin(destination,body);pending.remove(i)
        assert not pending,'fixture mutable fact3 dependency cycle; no target result claimed'
        for i in sorted(affected):records[i].update(pin=resolved[i],body=bodies[i])
        for name,oldpath in tuple(self.b['labels'].items()):
            if oldpath==old['path']:self.b['labels'][name]=path
        self.mutable.discard(old['path']);self.mutable.add(path)
        return self.p(label)
'''

