def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def wire(v):return(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('utf8')
def save(p,b):
 assert END-datetime.datetime.now(datetime.timezone.utc)>datetime.timedelta(seconds=60)and len(b)<=2097152
 with p.open('xb')as f:f.write(b);f.flush();os.fsync(f.fileno())
 assert p.read_bytes()==b;print(json.dumps(pin(p),sort_keys=True));return p
def sj(n,v):return save(T/n,wire(v))
def dump(n):return ast.dump(n,include_attributes=False)
def ah(n):return hashlib.sha256(dump(n).encode('utf8')).hexdigest()
def defs(n):return{x.name:x for x in n.body if isinstance(x,(ast.FunctionDef,ast.ClassDef))}
def literal(n,name):return ast.literal_eval(next(x.value for x in n.body if isinstance(x,ast.Assign)and any(isinstance(a,ast.Name)and a.id==name for a in x.targets)))
