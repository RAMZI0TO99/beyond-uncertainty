"""Metadata-only immutable clarification: pre-entry facts vs post-capture custody result."""
import base64,datetime as dt,hashlib,json,os,stat
from pathlib import Path
R=Path(__file__).parent;D=R/'capture_protocol_request_001'
def need(v,m):
 if not v:raise ValueError(m)
def raw(p):
 p=Path(p)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and a.st_size<=2097152,'bounded singlelink metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_size,x.st_mtime_ns,x.st_nlink)
 need(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size,'stable samebuffer');return b
def pin(p,b=None):
 if b is None:b=raw(p)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
 d={}
 for k,v in xs:need(k not in d,'duplicateJSON');d[k]=v
 return d
def bad(x):raise ValueError('noninteger/nonfiniteJSON')
def parse(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
scope=parse(raw(R/'ROOT_CURRENT_I13_CAPTURE_PROTOCOL_REQUEST_SOURCE_SCOPE_010.json'))
def fresh():
 n=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(scope['interval_start'])<=n and (dt.datetime.fromisoformat(scope['interval_end'])-n).total_seconds()>60,'Source010strictreserve');return n.isoformat()
def save(name,v):
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode();need(len(b)<=2097152,'own2MiB');fresh();p=D/name
 with p.open('xb') as h:need(h.write(b)==len(b),'wholeCreateNew');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'complete readback');return pin(p,b)
names=['I13_RAW_INPUT_RETENTION_CAPTURE_PROTOCOL_REQUEST_ONLY_001.json','ROOT_I13_FIRST_PARTITION_EXACT_ADMISSION_REQUEST_ONLY_001.json','ROOT_I13_CAPTURE_PROTOCOL_EXACT_REQUEST_IMMUTABLE_AUTHOR_FREEZE_001.json']
rows=[];values=[]
for name in names:
 p=D/name;b=raw(p);rows.append(dict(complete_predecessor=pin(p,b),complete_predecessor_base64=base64.b64encode(b).decode()));values.append(parse(b))
protocol,request,freeze=values
need(protocol['unresolved_before_any_capture']==request['future_facts_UNISSUED'] and len(request['future_facts_UNISSUED'])==18,'exactoldambiguity')
iv=save('ROOT_I13_PROTOCOL_REQUEST002_COMPLETE_THREE001_PREDECESSOR_INVERSE_001.json',dict(schema_version=1,author='/root',created_utc=fresh(),complete_predecessors=rows,reason='Independent i13review identified outer_parent_custody_witness is necessarily a post-capture acceptance result, not a pre-entry admissibility fact. Preserve every old001byte and split17pre-entry facts from1post-capture obligation. No operational fact is issued or subject changed.',all_capture_and_execution_gates_held=True))
pre=dict(protocol['unresolved_before_any_capture']);need(pre.pop('outer_parent_custody_witness') is None,'postresultunissued');post=dict(outer_parent_custody_witness=None)
protocol['created_utc']=fresh();protocol['unresolved_before_any_capture']=pre;protocol['post_capture_acceptance_obligations']=post
protocol['preentry_postcapture_distinction']='All17pre-entry facts remainUNISSUED. Outerparentcustodywitness is a later actual completion result, never a prerequisite artifact/pin supplied to initialadmission and never a futurehash. Before entry the reviewed externalcontroller Source/custody protocol must be present; its actual result is produced only afterentry and required before saved-result acceptance.'
protocol['complete_predecessor_history']=iv
pp=save('I13_RAW_INPUT_RETENTION_CAPTURE_PROTOCOL_REQUEST_ONLY_002.json',protocol)
request['created_utc']=fresh();request['capture_protocol']=pp;request['future_facts_UNISSUED']=pre;request['post_capture_facts_UNISSUED']=post;request['complete_predecessor_history']=iv
rp=save('ROOT_I13_FIRST_PARTITION_EXACT_ADMISSION_REQUEST_ONLY_002.json',request)
freeze['created_utc']=fresh();freeze['author_Source']=pin(Path(__file__));freeze['artifacts']=[request['request_payload'],pp,rp];freeze['complete_predecessor_history']=iv;freeze['preentry_facts_UNISSUED_count']=17;freeze['postcapture_facts_UNISSUED_count']=1
fp=save('ROOT_I13_CAPTURE_PROTOCOL_EXACT_REQUEST_IMMUTABLE_AUTHOR_FREEZE_002.json',freeze)
for row in rows:need(raw(row['complete_predecessor']['path'])==base64.b64decode(row['complete_predecessor_base64'],validate=True),'all001wholebytespreserved')
print(json.dumps(dict(protocol=pp,exact_request=rp,freeze=fp,inverse=iv,payload_unchanged=request['request_payload'],all_capture_and_execution_gates_held=True)))
