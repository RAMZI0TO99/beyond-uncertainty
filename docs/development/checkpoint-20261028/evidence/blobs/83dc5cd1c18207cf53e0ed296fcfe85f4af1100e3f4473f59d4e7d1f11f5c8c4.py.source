def pin(p):
    raw=p.read_bytes();d=dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest());subjects.append(d);return raw
def read_source(name,size,sha):
    p=I/name;raw=pin(p);assert len(raw)==size and hashlib.sha256(raw).hexdigest()==sha
    s=raw.decode('utf8');return p,s,ast.parse(s)
def ck(name,passed,proof):
    assert name not in {x['name']for x in checks}
    checks.append(dict(name=name,passed=bool(passed),evidence=proof))
def nodes(x):
    if type(x)is dict:return 1+sum(1+nodes(v)for v in x.values())
    if type(x)is list:return 1+sum(nodes(v)for v in x)
    assert x is None or type(x)in(bool,int,str)
    return 1
def fn(t,name):return next(n for n in ast.walk(t)if isinstance(n,ast.FunctionDef)and n.name==name)
def method(t,cls,name):return next(n for c in t.body if isinstance(c,ast.ClassDef)and c.name==cls for n in c.body if isinstance(n,ast.FunctionDef)and n.name==name)
def seg(path,s,start,end,purpose):
    evidence.append(dict(path=str(path),start_line=start,end_line=end,purpose=purpose,exact_UTF8_lines='\n'.join(s.splitlines()[start-1:end])))

