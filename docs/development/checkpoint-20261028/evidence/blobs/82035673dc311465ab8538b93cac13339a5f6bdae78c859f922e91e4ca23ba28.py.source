"""Root metadata-only fixed successor port binding input author."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def pin(p):
 with p.open('rb') as h:b=h.read(2097153)
 assert 0<len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
specs={'m3':('validate_M3_guard_contract_metadata_009.py',63213,'b91eefd28fb8d120addd510949e2cca82b310379da7fa81ec3ddd435285d49f2','CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_009.json',3020,'b3ab0bbd452824ebfe94aef0584fae05e2831454e76536cd21fb9834059501c2'),'peer':('validate_selected_peer_author_packet_metadata_009.py',61475,'4931d2d5b541a2b7d8ce9c4dc7614482e69ec18ddc4681a44039a8285e93194b','CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_009.json',1748,'c3f5dfa2d652ab5e17b1128c4825c12e50edf8875f0678caeee219643dfd542c'),'publisher':('validate_selected_role_publisher_metadata_004.py',65507,'f1df1975bee9c7fcd546f4c94f9d09a6371165aea83b6dcaa783f0ad7d7dd6bc','CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_004.json',4291,'93342e63661c7eea78e13cfc7504b547ea047643bf37e1ff5cf84a4e74260ffe')}
v=json.loads((C/'I13_HELD_COMPOSITION_BINDING_INPUT_002.json').read_bytes());v['schema_version']=3
for key,(s,sn,sh,a,an,ah) in specs.items():
 sp=pin(T/s);ap=pin(T/a);assert sp['bytes']==sn and sp['sha256']==sh and ap['bytes']==an and ap['sha256']==ah
 v['fixed_sources'][key]=dict(Source=sp,API=ap)
p=C/'I13_HELD_COMPOSITION_BINDING_INPUT_003.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:h.write(b)
print(json.dumps(dict(binding=pin(p),target_execution=False)))
