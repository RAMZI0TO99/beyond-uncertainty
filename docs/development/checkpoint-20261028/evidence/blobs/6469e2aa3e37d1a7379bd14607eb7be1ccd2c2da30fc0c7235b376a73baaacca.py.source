path=OUT/'exercise_selected_peer_author_metadata_memory_002.py';raw=text.encode();assert len(raw)<=2097152;nt=ast.parse(raw);compile(raw,str(path),'exec',dont_inherit=True)
with path.open('xb')as f:f.write(raw)
def pin(p,b=None):
    b=p.read_bytes()if b is None else b
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def save(p,v):
    b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(b)<=2097152
    with p.open('xb')as f:f.write(b)
    return pin(p,b)
cp=save(OUT/'I13_PEER_FRESH_LITERAL_CASE_CATALOGUE_002.json',dict(schema_version=1,record_type='I13_fresh_peer_literal_case_catalogue',author='/root/i2_resume_gap',Source=pin(path,raw),cases=cases,count=len(cases),names_json_sha256=hashlib.sha256(json.dumps([s['name']for s in cases],separators=(',',':')).encode()).hexdigest(),target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False))
