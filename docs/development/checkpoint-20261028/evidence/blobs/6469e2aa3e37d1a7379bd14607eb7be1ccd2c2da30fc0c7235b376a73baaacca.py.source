    add('cap_'+variant,role='metadata_bound_review'if variant.startswith('draft')else'metadata_peer',handler='cap',expected=expected,variant=variant)
for label in ('wrapper','now'):
    add('UTC6_rejects_UTC7_'+label,handler='utc7',expected='E_TIME',label=label)
add('wrapper_chronology_one_microsecond',handler='microsecond',expected='E_CHRONOLOGY')
