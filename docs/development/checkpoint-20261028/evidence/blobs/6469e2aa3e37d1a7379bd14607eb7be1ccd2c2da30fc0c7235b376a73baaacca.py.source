def add(name,role='metadata_peer',handler='positive',expected=None,**kw):cases.append(dict(name='peer_'+name,role=role,handler=handler,expected_error=expected,**kw))
for label,schema in [('constructor_API','constructor_API13'),('selection','selection13')]:
    fields=list(base['schemas'][schema]['fields'])if schema in base['schemas']else['author','created_utc','current_complete45_inventory','current_owner_scope','current_selection','derived_launcher_runtime_path','new_canonical_lease','operational_authority','record_type','rows','schema_version','selected_Source_nonce','target_execution']
