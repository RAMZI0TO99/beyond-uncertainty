assert len(cases)==len({s['name']for s in cases})
lines=text.splitlines(keepends=True);oldcat=''.join(lines[catalog_node.lineno-1:catalog_node.end_lineno]);text=text.replace(oldcat,'CASE_CATALOGUE = '+repr(cases)+'\n',1)
text=text.replace("    if type(v)is list:return('list',tuple(_fingerprint(x)for x in v))", "    if type(v)is list:return('list',tuple(_fingerprint(x)for x in v))\n    if type(v)is tuple:return('tuple',tuple(_fingerprint(x)for x in v))")
