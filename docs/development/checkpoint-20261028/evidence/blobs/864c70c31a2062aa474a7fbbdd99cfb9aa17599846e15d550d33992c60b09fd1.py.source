"""Adopt genuinely different creation review of WORK-only handoff004; no execution grant."""
import base64,datetime as dt,hashlib,json,math,os,stat,sys
from pathlib import Path
R=Path(__file__).parent

def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded singlelink regular metadata')
 with p.open('rb') as h:
  d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();fields=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(fields(a)==fields(d)==fields(e)==fields(z) and len(b)==a.st_size<=2097152,'stable samehandle metadata buffer');return b

def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def doc(path,expected=None):
 b=raw(path);p=pin(path,b)
 if expected:need(p==expected,'exact whole metadata pin')
 def pairs(rows):
  d={}
  for k,v in rows:need(k not in d,'duplicate JSONkey');d[k]=v
  return d
 def finite(x):
  v=float(x);need(math.isfinite(v),'finiteJSON');return v
 def reject(x):raise ValueError('nonfiniteJSONtoken')
 return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=reject),p

need(len(sys.argv)==3,'different creation capsule path and SHA')
cp=Path(sys.argv[1]);need(cp.is_relative_to(R),'own WORK creation capsule')
c,cf=doc(cp);need(cf['sha256']==sys.argv[2],'exact caller capsule SHA')
f,ff=doc(c['full_proof']['path'],c['full_proof'])
need(c['reviewer']==f['reviewer']=='/root/project_architecture' and c['verdict']==f['verdict'] and c['verdict'].startswith('PASS_') and c['remaining_actionable_findings']==[],'different allclear creation review')
xs=f['checks'];need(type(xs) is list and len(xs)>0 and len(xs)==len({x['name'] for x in xs})==c['checks_passed']==f['checks_passed'] and c['checks_failed']==f['checks_failed']==0 and all(x['passed'] is True for x in xs),'complete nonempty unique allpass checks')
scope_expected=dict(path=str(R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json'),bytes=6266,sha256='e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5')
s,sp=doc(scope_expected['path'],scope_expected);need(c['scope']==f['scope']==sp,'exact current Source scope')
need(c['reviewed_artifacts']==f['reviewed_artifacts'],'same exact reviewed artifact roster')
arts=c['reviewed_artifacts'];need(len({p['path'].casefold() for p in arts})==len(arts),'unique reviewed paths')
for p in arts:
 need(Path(p['path']).is_relative_to(R) and pin(p['path'])==p,'exact own reviewed artifact')
reviewed={p['path']:p for p in arts}
self_pin=pin(Path(__file__));need(reviewed.get(self_pin['path'])==self_pin,'exact this creation adopter Source reviewed')
hp=reviewed[str(R/'ROOT_I13_CURRENT_RAW_INPUT_RETENTION_CONTRACT_AND_EVIDENCE_HANDOFF_004.json')]
h,_=doc(hp['path'],hp)
a,ap=doc(h['prospective_contract_adoption']['path'],h['prospective_contract_adoption'])
inv,ip=doc(h['complete003_inverse']['path'],h['complete003_inverse'])
b=base64.b64decode(inv['complete_predecessor_base64'],validate=True)
need(base64.b64encode(b).decode('ascii')==inv['complete_predecessor_base64'] and pin(inv['complete_predecessor']['path'],b)==inv['complete_predecessor']==h['previous_handoff'] and raw(inv['complete_predecessor']['path'])==b,'canonical whole predecessor inverse and unchanged original')
need(a['prospective_retention_design_adopted'] is True and h['completed_as_design_only'] is True and h['creation_review_pending'] is True and a['implementation_protocol_adopted'] is h['implementation_protocol_adopted'] is False,'creation review closes handoff only')
for k in ('raw_acquisition_admitted','new_raw_retention_operation_admitted','new_target_or_fixture_Source_authoring_admitted','new_builder_fixture_validator_target_calls_admitted','new_tests_admitted','new_operational_execution_lease_issued','prior_scopes_or_leases_extended','actual_family_publication','primary_six_document_publication','Git_commit_or_push_admitted','Native8','Parser','runtime','actual6','science','target_execution','operational_authority','scientific_authority'):
 need(a[k] is h[k] is False,'unchanged held gate '+k)
need(h['Source_scope']==a['Source_scope']==sp and h['implementation_blockers_remain']==a['implementation_blockers_remain']==11 and h['current_main936']==a['current_main936']==dict(completed=32,passed=20,failed=12,remaining_unestablished=904),'exact source boundary and current936 facts')
v=dict(schema_version=1,record_type='Root_I13_WORK_handoff004_different_creation_review_adoption_only',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),Source_scope=sp,handoff=hp,prospective_contract_adoption=ap,complete003_inverse=ip,genuine_different_creation_review=cf,full_proof=ff,checks_passed=len(xs),checks_failed=0,adopter_Source=self_pin,
 Root_decision='Accept exact WORK-only handoff004 creation, its joins and complete003 preservation after genuine different review. This records completion of the requested workspace/scope refresh and prospective raw-input retention contract review only. All capture, implementation, test, execution and managed/Git publication gates remain held; future exporter/API/supervisor qualification and fresh admission are UNISSUED.',
 creation_review_adopted=True,raw_acquisition_admitted=False,new_target_or_fixture_Source_authoring_admitted=False,new_builder_fixture_validator_target_calls_admitted=False,new_tests_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,new_operational_execution_lease_issued=False,actual_family_publication=False,primary_six_document_publication=False,Git_commit_or_push_admitted=False,Native8=False,Parser=False,runtime=False,actual6=False,science=False,implementation_protocol_adopted=False,compact_ABI_status='NOT_READY',implementation_blockers_remain=11)
w=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8');need(len(w)<=2097152,'2MiB own metadata output')
now=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(s['interval_start'])<=now and (dt.datetime.fromisoformat(s['interval_end'])-now).total_seconds()>60,'fresh Source007 strict60reserve at final exclusive write')
p=R/'ROOT_I13_HANDOFF004_DIFFERENT_CREATION_REVIEW_ADOPTION_001.json'
with p.open('xb') as out:need(out.write(w)==len(w),'completeCreateNew');out.flush();os.fsync(out.fileno())
need(raw(p)==w,'whole creation adoption readback');print(json.dumps(dict(adoption=pin(p,w),checks_passed=len(xs),all_execution_gates_held=True)))
