"""Root narrow read/hash/AST metadata correction adoption; no subject calls."""
import ast,copy,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';M=C/'m3_protocol_audit_001';P=C/'canonical_peer_protocol_audit_001'
checks=[]
def ck(ok,name,evidence):
 assert ok,name;checks.append(dict(name=name,passed=True,evidence=evidence))
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise ValueError('noninteger JSON token')
def load(p,sha=None):
 b=p.read_bytes();assert 0<len(b)<=2097152
 if sha is not None:assert hashlib.sha256(b).hexdigest()==sha
 return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def save(p,v):
 raw=(json.dumps(v,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(raw)<=2097152
 with p.open('xb') as h:assert h.write(raw)==len(raw)
 return pin(p)
old_path=R/'ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_002.json'
old_adopt=load(old_path,'e4d882a49c84fde7e1118a9de2ca385b920f6a4170cc4206da5f249054bdd64a')
clar_path=M/'I13_PROPOSED_ORIGINAL_I2_RECEIPT22_OBSERVATION9_CORRECTION_001.json'
