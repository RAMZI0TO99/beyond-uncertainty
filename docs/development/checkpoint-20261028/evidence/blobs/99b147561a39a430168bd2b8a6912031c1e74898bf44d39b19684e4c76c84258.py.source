def need(x,why):
 if not x:raise ValueError(why)
def stream_pin(p):
 p=Path(p)
 for q in(p,*p.parents):
  s=q.lstat();need(not q.is_symlink()and not getattr(s,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 before=p.stat();need(p.is_file()and before.st_nlink==1,'ordinary single-link metadata/source')
 h=hashlib.sha256();n=0
 with p.open('rb')as f:
  while True:
   b=f.read(1048576)
   if not b:break
   h.update(b);n+=len(b)
 after=p.stat();need(n==before.st_size==after.st_size and all(getattr(before,k,None)==getattr(after,k,None)for k in('st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_nlink','st_file_attributes')),'stable whole external pin')
 return dict(path=str(p),bytes=n,sha256=h.hexdigest())
def doc(p,sha=None):
 fact=stream_pin(p);need(fact['bytes']<=2097152,'bounded parsed metadata')
 if sha:need(fact['sha256']==sha,'exact external metadata hash')
 b=Path(p).read_bytes();need(hashlib.sha256(b).hexdigest()==fact['sha256'],'same parsed metadata buffer')
 return json.loads(b),fact
