def _outer_make(role,m3,publisher,peer,catalogue_bytes):
    return _Outer(_make(role,peer,catalogue_bytes)).envelope('selected_peer_receipt27_v2',role,m3,publisher,peer)

def _outer_mutate(b,spec):
    variant=spec['variant']
    if variant=='author_receipt':
        b['packet']=_row(b,'receipt')['body'];return
    if variant=='record_alias':
        row=copy.deepcopy(b['records'][0]);row['pin']['path']=row['pin']['path'][:3]+row['pin']['path'][3:].swapcase();b['records'].append(row);return
    if variant=='record_count':
        while len(b['records'])<257:
            row=copy.deepcopy(b['records'][0]);row['pin']=_pin(_OW_HOME+chr(92)+'over_record_'+str(len(b['records']))+'.data',row['body']);b['records'].append(row)
        return
    outer=_Outer(b)
    if variant=='old_prewrite':
        value=outer.value('outer_prewrite');value.pop('recorded_evaluation_utc');value['record_type']='Root_owner_v2_selected_role_prewrite_metadata_packet';outer.rewrite('outer_prewrite',value)
    elif variant=='old_publication':
        value=outer.value('outer_publication');value.pop('prewrite_packet');value['record_type']='Root_owner_v2_selected_role_Source_metadata_canonical_publication';outer.rewrite('outer_publication',value)
    elif variant=='publication_context':
        value=outer.value('outer_publication');value['prewrite_packet']=outer.p('owner');outer.rewrite('outer_publication',value)
    elif variant=='request_receipt':
        value=outer.value('outer_request');value['author_receipt']=outer.p('decision');outer.rewrite('outer_request',value)
    elif variant=='packet_role':
        value=outer.value('outer_packet');value['role']='pipeline_peer';outer.rewrite('outer_packet',value)
    elif variant in ('packet_extra','packet_nodes'):
        value=outer.value('outer_packet');value['unexpected_field']=[0]*50000 if variant=='packet_nodes'else False;outer.rewrite('outer_packet',value)
    elif variant=='prewrite_UTC7':
        value=outer.value('outer_prewrite');value['recorded_evaluation_utc']='2026-10-25T11:00:24.0000001+00:00';outer.rewrite('outer_prewrite',value)
    else:raise AssertionError('unowned outer variant '+variant)
    outer.b['packet']=outer.row('outer_packet')['body'];outer.b['mutable']=sorted(outer.mutable)
    b.clear();b.update(copy.deepcopy(outer.b))

def _outer_assert_result(raw,b,spec,catalogue_bytes,prewrite):
    assert type(raw)is bytes
    view=_json(raw);fields=_json(catalogue_bytes)['schemas']['result54']['fields']
    assert type(view)is dict and set(view)==set(fields)and len(view)==54
    for key,rule in fields.items():
        if type(rule)is dict and 'literal'in rule:assert type(view[key])is type(rule['literal'])and view[key]==rule['literal'],key
    assert view['validator']==('selected_role_prewrite'if prewrite else'selected_role_canonical_dependency')
    assert view['author_kind']=='selected_peer_receipt27_v2'and view['role']==spec['role']
    assert view['packet']==_row(b,'outer_prewrite'if prewrite else'outer_packet')['pin']
    assert view['author_packet']==_row(b,'wrapper')['pin']and view['author_receipt']==_row(b,'receipt')['pin']
    assert view['request']==_row(b,'outer_request')['pin']and view['producer_Source']==_json(_row(b,'wrapper')['body'])['producer_support']['Source']
    assert type(view['record_count'])is int and view['record_count']==len(b['records'])
    assert type(view['total_record_bytes'])is int and view['total_record_bytes']==sum(len(row['body'])for row in b['records'])
    assert type(view['charged_metadata_nodes'])is int and 0<view['charged_metadata_nodes']<=50000
    assert view['validated_now_utc']==b['now_utc']
    if prewrite:assert view['canonical']is None and view['publication']is None and view['reconciliation']is None
    else:assert view['canonical']==_row(b,'outer_canonical')['pin']and view['publication']==_row(b,'outer_publication')['pin']and view['reconciliation']==_row(b,'outer_reconciliation')['pin']

def _outer_case(spec,m3,publisher,peer,catalogue_bytes,seal):
    expected=spec['expected_error']
    if spec['handler']=='outer_held':
        flag=publisher.ACTUAL_ENTRY_QUALIFIED
        try:
            publisher.ACTUAL_ENTRY_QUALIFIED=spec['flag']
            try:publisher.publish_selected_role_current_owner(context=_Hostile())
            except publisher.I13MetadataError as error:assert error.code==expected
            else:raise AssertionError('actual publisher unexpectedly returned')
        finally:publisher.ACTUAL_ENTRY_QUALIFIED=flag
        return
    b=_outer_make(spec['role'],m3,publisher,peer,catalogue_bytes)
    assert not(_mutable_ids(b)&_mutable_ids(FIXED))and not(_mutable_ids(b)&_mutable_ids(CASE_CATALOGUE))
    variant=spec['variant']
    if variant=='isolation':
        sibling=_outer_make(spec['role'],m3,publisher,peer,catalogue_bytes)
        assert not(_mutable_ids(b)&_mutable_ids(sibling))
        saved=_fingerprint(sibling);before=_fingerprint(b);_row(b,'outer_request')['pin'].pop('path')
        assert _fingerprint(b)!=before and _fingerprint(sibling)==saved and _seal()==seal
        return
    prewrite=variant=='prewrite_positive'
    if prewrite:b['packet']=_row(b,'outer_prewrite')['body'];b['now_utc']=_ow_time(24)
    elif variant=='prior_positive':b['now_utc']=_ow_time(50000)
    elif variant!='canonical_positive':
        before=_fingerprint(b);_outer_mutate(b,spec);assert _fingerprint(b)!=before,'outer mutation did not change typed input'
    try:
        if prewrite:raw=publisher.validate_selected_role_prewrite_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b['now_utc'],m3=m3,peer=peer)
        else:raw=publisher.validate_selected_role_canonical_dependency_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b['now_utc'],m3=m3,peer=peer)
    except publisher.I13MetadataError as error:
        assert expected is not None and error.code==expected,(spec['name'],'wrong typed first guard',error.code,expected)
    else:
        assert expected is None,(spec['name'],'expected refusal returned')
        _outer_assert_result(raw,b,spec,catalogue_bytes,prewrite)

