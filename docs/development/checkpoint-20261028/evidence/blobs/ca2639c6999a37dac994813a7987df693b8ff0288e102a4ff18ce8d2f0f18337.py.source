text=b.decode('utf8');old="0<a.st_size<=2097152,'bounded complete regular bytes'";new="0<=a.st_size<=2097152,'bounded complete regular bytes'";assert text.count(old)==1;text=text.replace(old,new)
oldbase="base=[fact(S),fact(SA),h['workspace_refresh']";newbase="base=[fact(D/'INDEPENDENT_I13_HANDOFF004_OWN_CHECKER_EMPTY_BYTE_ASSERTION_HISTORY_001.json'),fact(S),fact(SA),h['workspace_refresh']";assert text.count(oldbase)==1;text=text.replace(oldbase,newbase)
