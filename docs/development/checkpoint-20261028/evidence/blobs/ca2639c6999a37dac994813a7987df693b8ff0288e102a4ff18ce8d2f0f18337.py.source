    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def fresh():
    p=R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json';b=p.read_bytes();assert hashlib.sha256(b).hexdigest()=='e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5'
    s=json.loads(b.decode('utf8'));n=datetime.datetime.now(datetime.timezone.utc);assert datetime.datetime.fromisoformat(s['interval_start'])<=n<datetime.datetime.fromisoformat(s['interval_end'])-datetime.timedelta(seconds=60)
    return n.isoformat(timespec='microseconds')
def save(name,b):
    p=D/name;assert not os.path.lexists(p) and 0<len(b)<=2097152;fresh()
    with p.open('xb')as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
    assert p.read_bytes()==b;return fact(p,b)
