v=dict(schema_version=1,record_type='Root_Source010_protocol_request_metadata_only_adoption',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),Source_scope=sp,genuine_different_review=cf,full_proof=ff,checks_passed=len(xs),checks_failed=0,adopter_Source=selfpin,complete008_inverse=ip,workspace_refresh=wp,current_handoff=hp,Source_scope_adopted=True,Source_only_protocol_and_request_metadata_preparation_admitted=True,capture_protocol_adopted_for_execution=False,exact_admission_issued=False,Root_decision='Adopt new finite Source010 for inert capture protocol and exact prospective request metadata preparation/static review only. Current supervisor/child remain unconditionally held. No activation Source or admission is issued; an exact request cannot activate a Source hold. Source008 and separate coexistence009 periods/bytes stay unchanged. All capture/native/operational/scientific/publication gates remain held.',**{k:False for k in held})
