s,_=doc(sp['path'],sp);need(c['scope']==f['scope']==sp and c['reviewed_artifacts']==f['reviewed_artifacts'],'exact scope/roster')
arts=c['reviewed_artifacts'];need(len(arts)>0 and len({p['path'].casefold() for p in arts})==len(arts),'nonempty unique reviewed artifactroster')
for p in arts:need(Path(p['path']).is_relative_to(R) and pin(p['path'])==p,'new own reviewed exact artifact')
by={p['path']:p for p in arts};selfpin=pin(Path(__file__));need(by.get(selfpin['path'])==selfpin and by.get(sp['path'])==sp,'thisadopter+scope reviewed')
ip=dict(path=str(R/'ROOT_I13_SOURCE010_COMPLETE008_PREDECESSOR_INVERSE_001.json'),bytes=10478,sha256='4c3b2124a4afaabda9e3d1ee3f5205c099f6ca162a8bf7e546f8e07434af78d3')
i,_=doc(ip['path'],ip);b=base64.b64decode(i['complete_predecessor_base64'],validate=True)
