w,wp=doc(s['current_workspace_refresh']['path'],s['current_workspace_refresh'])
need(by.get(wp['path'])==wp and w['repository_baseline_pins_verified']==418 and w['working_Source_and_evidence_pins_verified']==60 and w['old_I2_caller_I12_Sources_verified']==6 and w['status_identity_count']==409 and w['staged']==0 and w['all_prior_pins_unchanged'] is True,'current complete workspace refresh')
h,hp=doc(s['current_adopted_handoff']['path'],s['current_adopted_handoff']);need(h['retention_Source_qualified'] is True and h['raw_capture_admitted'] is False,'static qualification only')
for p in h['qualified_subjects']:need(pin(p['path'])==p,'unchanged qualified held Source')
