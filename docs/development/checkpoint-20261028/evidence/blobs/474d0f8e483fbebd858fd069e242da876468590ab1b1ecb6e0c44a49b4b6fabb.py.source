xs=f['checks'];need(type(xs) is list and len(xs)>0 and all(type(x['name']) is str and x['name'] for x in xs) and len(xs)==len({x['name'] for x in xs})==c['checks_passed']==f['checks_passed'] and c['checks_failed']==f['checks_failed']==0 and all(x['passed'] is True for x in xs),'nonempty unique allpass')
