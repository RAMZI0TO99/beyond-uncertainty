"""Retain only this reviewer's own pre-output checker repairs."""
from pathlib import Path
import datetime as dt,hashlib,json,os
D=Path(__file__).parent
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
sources=[]
for i in range(1,4):
 p=D/('review_supervisor002_consolidated_refusal_%03d.py'%i);sources.append(fact(p,p.read_bytes()))
v=dict(schema_version=1,record_type='Independent_supervisor002_refusal_own_pre_output_checker_history',reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),checker_Sources=sources,attempts=[dict(version=1,tool_chunk='8f2c1e',exit_code=1,review_outputs_written=0,own_error='Unmatched parenthesis in own metadata budget assertion, before own script execution.'),dict(version=2,tool_chunk='7afa09',exit_code=1,review_outputs_written=0,own_error='Own region lookup initially covered only top-level definitions; author exact region inventory also includes nested __init__/pairs/number/drain definitions.'),dict(version=3,tool_chunk='419127',exit_code=0,review_outputs_written=2,result='Exact existing49parent/childSource regions verified through complete AST definition inventory;80PASS/2FAIL genuinely retained Sup002 refusal.')],all_subject_bytes_unchanged=True,subject_compile_import_or_call=False,raw_capture_admitted=False,process_or_native_query=False,tests_executed=False,ready_for_execution=False)
b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');assert len(b)<2097152 and(dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
p=D/'INDEPENDENT_SUPERVISOR002_REFUSAL_OWN_CHECKER_CORRECTION_HISTORY_001.json'
with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b;print(json.dumps(fact(p,b)))
