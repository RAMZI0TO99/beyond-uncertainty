import ast,json
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003\m3_peer_contracts_016\i13')
s=(P/'exercise_M3_guard_and_publisher_metadata_memory_005.py').read_text(encoding='utf-8');t=ast.parse(s)
for n in t.body:
 if isinstance(n,ast.Assign):
  names=[x.id for x in n.targets if isinstance(x,ast.Name)]
  if any(x in ('CASE_CATALOGUE','FIXED','FINAL_KERNEL_PINS','FIXTURE_SOURCE_PIN') for x in names):
   try:
    v=ast.literal_eval(n.value);print('LITERAL',names,type(v).__name__,len(v));
    if 'CASE_CATALOGUE' in names:print('CASE_SUMMARY',json.dumps(dict(total=len(v),positive=sum(x.get('expected_error') is None for x in v),negative=sum(x.get('expected_error') is not None for x in v),handlers=sorted({x['handler']for x in v}))))
   except Exception:print('nonliteral',names)
 if isinstance(n,ast.FunctionDef) and n.name in ('run','_fixture_make','_fixture_edit','_guard'):
  print('FUNCTION',n.name,n.lineno,n.end_lineno);print(ast.unparse(n))
 if isinstance(n,ast.ClassDef) and n.name=='_Outer':
  for m in n.body:
   if isinstance(m,ast.FunctionDef):
    print('METHOD',m.name,m.lineno,m.end_lineno)
    if m.name in ('publisher','finish','purpose','expected_inputs','code','wrap','_prior'):print(ast.unparse(m))
