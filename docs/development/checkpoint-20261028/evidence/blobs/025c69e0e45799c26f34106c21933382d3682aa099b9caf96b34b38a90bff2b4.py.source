def ck(name,condition,evidence):
 assert name not in{x['name']for x in checks};checks.append(dict(name=name,passed=bool(condition),evidence=evidence))
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def src(p):return p.read_bytes().decode('utf8')
def dump(n):return ast.dump(n,include_attributes=False)
def fs(t):return{x.name:x for x in t.body if isinstance(x,ast.FunctionDef)}
def assigns(t):return{x.targets[0].id:x.value for x in t.body if isinstance(x,ast.Assign)and len(x.targets)==1 and isinstance(x.targets[0],ast.Name)}
def pairs(items):
 v={}
 for k,x in items:
  if k in v:raise ValueError('duplicate JSON key')
  v[k]=x
 return v
def bad(v):raise ValueError('float or nonfinite JSON forbidden')
def rd(p):return json.loads(p.read_bytes().decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def calls(n,name):return[x for x in ast.walk(n)if isinstance(x,ast.Call)and isinstance(x.func,ast.Name)and x.func.id==name]
