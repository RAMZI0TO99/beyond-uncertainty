def save(name,value):
 assert datetime.datetime.now(datetime.timezone.utc)<datetime.datetime.fromisoformat(rd(Path(ast.literal_eval(ha['SCOPE'])['path']))['interval_end'])-datetime.timedelta(seconds=60)
 b=(json.dumps(value,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('utf8');assert len(b)<=2097152
 p=OUT/name
 with p.open('xb')as f:f.write(b);f.flush();os.fsync(f.fileno())
 assert p.read_bytes()==b;print(json.dumps(pin(p),sort_keys=True));return p
