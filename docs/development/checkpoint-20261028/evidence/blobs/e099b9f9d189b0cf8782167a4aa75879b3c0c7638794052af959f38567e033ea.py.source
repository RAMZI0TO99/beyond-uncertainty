def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def method(t,c,n):return next(x for x in defs(t)[c].body if isinstance(x,ast.FunctionDef)and x.name==n)
def txt(n):return ast.unparse(n)
def lit(t,name):return ast.literal_eval(next(n.value for n in t.body if isinstance(n,ast.Assign)and any(isinstance(a,ast.Name)and a.id==name for a in n.targets)))
def frag(n,label,items):
 for k,v in items:ck(label+'.'+k,v in txt(n),v)
def nodes(v):
 if type(v)is dict:return 1+sum(nodes(k)+nodes(x)for k,x in v.items())
 if type(v)is list:return 1+sum(nodes(x)for x in v)
 return 1
def encode_case(v):
 if type(v)is bytes:return dict(AST_builtin_type='bytes',canonical_base64=base64.b64encode(v).decode('ascii'))
 if type(v)is dict:return {k:encode_case(x)for k,x in v.items()}
 if type(v)is list:return [encode_case(x)for x in v]
 return v
