"""Prepare a fresh metadata-only preservation verifier; predecessor untouched."""
import ast,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent;p=R/'verify_I13_current_workspace_preservation_005.py';old=p.read_bytes();s=old.decode()
assert len(old)<=2097152
for a,b in (('SOURCE_SCOPE_004_002.json','SOURCE_SCOPE_006.json'),('OLD_SOURCE_PRESERVATION_005.json','OLD_SOURCE_PRESERVATION_006.json')):
 assert s.count(a)==1;s=s.replace(a,b)
anchor="now=dt.datetime.now(dt.timezone.utc)"
assert s.count(anchor)==1
s=s.replace(anchor,"assert pin(sourcep)['sha256']=='9196eaca8c1988c357abfa72881b3e505317ce7faff50dc352b700407848d821'\nadoptp=R/'ROOT_I13_CURRENT_SOURCE_SCOPE006_DIFFERENT_REVIEW_ADOPTION_001.json'\nassert pin(adoptp)['sha256']=='e139f7ade01ea2c005f70eb7e4befff7be06e9fcdfc9e7706b45c2b8878cfea8' and json.loads(raw(adoptp))['Source_scope']==pin(sourcep)\n"+anchor)
out=R/'verify_I13_current_workspace_preservation_006.py';b=s.encode();ast.parse(b,filename=str(out));assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
assert p.read_bytes()==old and out.read_bytes()==b
print(json.dumps(dict(new_read_hash_Git_verifier=dict(path=str(out),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),prior_whole_Source_unchanged=True)))
