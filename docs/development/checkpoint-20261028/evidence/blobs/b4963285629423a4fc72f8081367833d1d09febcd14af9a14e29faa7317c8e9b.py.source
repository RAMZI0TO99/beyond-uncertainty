import base64,datetime as dt,hashlib,json,os,stat,sys
from pathlib import Path
R=Path(__file__).parent

def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded singlelink regular metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size<=2097152,'samehandle stable exactbuffer');return b

def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def doc(path,p=None):
 b=raw(path);actual=pin(path,b)
 if p:need(actual==p,'exact complete fact3')
 def pairs(rows):
  d={}
  for k,v in rows:need(k not in d,'duplicateJSONkey');d[k]=v
  return d
 def bad(x):raise ValueError('noninteger/nonfiniteJSON')
 return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad),actual

