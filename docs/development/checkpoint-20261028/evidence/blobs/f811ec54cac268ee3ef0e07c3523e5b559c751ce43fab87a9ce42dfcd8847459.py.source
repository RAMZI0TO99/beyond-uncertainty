"""Retain exact peer closure reports without adopting peer validation results."""
import base64, datetime as dt, decimal, hashlib, json, os
from pathlib import Path
R=Path(__file__).parent.parent;P=Path('D:/Aenv/pro3/runs/coordination/cho51_canonical_boundary_20261025_v3')
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file()and not p.is_symlink()and s.st_nlink==1 and s.st_size<=2097152
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes()and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def read(p):return json.loads(raw(p),parse_float=decimal.Decimal)
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';s=read(scope)
def reserve():assert(dt.datetime.fromisoformat(s['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
def write(p,v):
 b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(p);reserve()
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert raw(p)==b
grant=R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_015.json';gp=pin(grant)
assert gp['sha256']=='8689b36a21b59ef4723e8f7a73e6a40be283335656c11d42ae9dd2b3b91491b0'
leasep=P/'lease-closeout_001.json';supP=P/'failure-closeout-supervision_001.json';closep=P/'failure-closeout_001.json'
lease=read(leasep);sup=read(supP);close=read(closep)
assert lease['peer_release_sha256']==close['peer_release_sha256']==gp['sha256']
assert lease['external_failure_closeout_sha256']==pin(closep)['sha256'] and lease['external_supervision_sha256']==pin(supP)['sha256']
assert lease['full_compute_custody_released']is lease['launcher_session_reaped']is True
assert lease['guard_attempts_consumed']==lease['jobs_created']==lease['jobs_executed']==1
assert lease['external_exit_code']==sup['exit_code']==0 and lease['external_limit_seconds']==sup['limit_seconds']==300
assert decimal.Decimal(0)<sup['elapsed_seconds']==lease['external_elapsed_seconds']<=300
assert sup['owned_tree_reaped']is sup['stdout_eof']is sup['stderr_eof']is True and sup['timed_out']is False and sup['stop_reason']is None
assert sup['job_created']is sup['candidate_imported']is sup['validation_passed']is sup['scientific_admission']is False
assert close['cleanup_verified']is close['fresh_native_job_absent']is close['native_closed_empty']is close['native_handles_closed']is True
assert close['normal_process_exit']==1 and close['validation_passed']is close['successful_test_evidence']is close['scientific_admission']is False
assert lease['validation_passed']is lease['scientific_admission']is lease['automatic_retry_permitted']is False
assert sup['auditor_sha256']==pin(P/'failure_closeout_001.py')['sha256']=='553980d3537ce2ed80b6146ef2bdbd00cdf403ab512b574fbf636b4f9c767d15'
review=read(P/'failure-auditor-source-review_001.json');assert review['accepted']is True and review['remaining_actionable_findings']==[] and review['sha256']==sup['auditor_sha256']
report=R/'coordination/ROOT_RETAINED_PRO3_015_FAILED_ATTEMPT_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'
write(report,dict(schema_version=1,record_type='Root_retained_peer015_reported_full_custody_release_only',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
 compute_grant=gp,grant=15,grant_consumed_closed=True,peer_lease_closeout=pin(leasep),peer_failure_closeout=pin(closep),peer_external_supervision=pin(supP),
 peer_failure_cleanup_Source=pin(P/'failure_closeout_001.py'),peer_failure_cleanup_different_Source_review=pin(P/'failure-auditor-source-review_001.json'),
 peer_reported_full_release=True,peer_explicit_released_utc=lease['released_utc'],peer_reported_jobs_created=1,peer_reported_normal_native_exit=1,
 peer_reported_external_elapsed_seconds_decimal=str(sup['elapsed_seconds']),peer_reported_external_exit_code=0,peer_reported_owned_tree_reaped=True,
 peer_reported_validation_passed=False,reported_full_compute_custody_released=True,old_grant_reuse_authorized=False,new_peer_grant_issued=False,
 Root_acceptance=dict(peer_result_accepted=False,scientific_acceptance=False,whole_host_quiet_proved=False,physical_handle_absence_proved=False),
 target_execution=False,operational_authority=False,scientific_authority=False))
before=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004.json';old=raw(before);v=read(before)
assert pin(before)['sha256']=='3af0f32869db2daa83e61fb3ca3b4822936d071afb2011841f27d42f17c84935'
assert v.pop('Pro3_grant015_failed_Job_external_failure_cleanup_and_explicit_full_release_pending_at_preparation')is True
v['Pro3_grant015_explicit_full_release_report_not_yet_received_at_candidate001_preparation']=True
v['Pro3_grant015_full_release_now_physically_joined_as_peer_report_only']=pin(report)
v['Source_scope004_candidate001_temporal_wording_corrected_only']=True
v['Source_scope004_candidate001_complete_bytes_preserved']=pin(before)
out=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004_002.json';write(out,v)
inverse=R/'ROOT_I13_SOURCE_SCOPE004_CANDIDATE002_COMPLETE001_INVERSE_AND_TEMPORAL_CORRECTION_001.json'
write(inverse,dict(author='/root',Source_only=True,complete_predecessor=pin(before),complete_predecessor_base64=base64.b64encode(old).decode(),successor=pin(out),
 correction='Replace inaccurate actual-pending event wording with report not yet received at candidate001 preparation. Actual peer release preceded candidate001 creation; no interval,cap,guard,operational or synthetic authority changes.',peer_release_report=pin(report)))
print(json.dumps(dict(peer_release_report=pin(report),corrected_proposed_Source_scope=pin(out),complete_candidate001_inverse=pin(inverse))))
