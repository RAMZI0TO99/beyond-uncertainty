"""Root saved once002 Source-review input author; no target invocation."""
import hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13';cache={}
def raw(p):
 p=Path(p);key=str(p.resolve()).casefold()
 if key not in cache:
  with p.open('rb') as h:b=h.read(2097153)
  assert 0<len(b)<=2097152;cache[key]=b
 return cache[key]
def pin(p):
 p=Path(p);b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(raw(p))
assert len(sys.argv)==4
caps=[Path(x) for x in sys.argv[1:]];assert all(p.resolve().is_relative_to(R.resolve()) for p in caps)
mp=C/'I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_003.json';m=load(mp)
sup=pin(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_003.py');comp=pin(T/'current_owner_M3_peer_held_composition_004.py');api=pin(T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json');once=pin(R/'prepare_I13_once_admission_004.py')
allpins=[*m['modules'].values(),*m['APIs'].values(),*m['fixtures'].values(),m['catalogue'],sup,comp,api,once]
assert len(allpins)==13 and len({p['path'].casefold() for p in allpins})==13
reviews=[];covered=[]
for index,path in enumerate(caps):
 cap=load(path);assert cap['verdict'].startswith('PASS_') and cap['checks_failed']==0 and cap['checks_passed']>0
 full=cap['full_proof'];assert pin(Path(full['path']))==full
 subjects=[p for p in allpins if p in cap['subjects']];assert subjects
 if index==1:
  for name in ('adopt_I13_final_new_Source_set_005.py','prepare_I13_final_Source_manifest_005.py','prepare_I13_once_supervisor_004.py'):
   p=pin(R/name);assert p in cap['subjects'];subjects.append(p)
 reviews.append(dict(capsule=pin(path),full_proof=full,required_subjects=subjects,subject_authors=['/root','/root/project_architecture','/root/i2_resume_gap']));covered+=subjects
assert all(p in covered for p in allpins)
old=load(R/'ROOT_I13_PRE_ONCE_BASELINE_AND_OLD_SOURCE_PRESERVATION_002.json')['old_Source_pins']
for folder,size,digest in [('i2',26589,'1405122809583ec16058baed38a8d73bfca690c755cb27ade0571d7588fbb23f'),('caller',21076,'d9967f818bd4f5d4dbe5852279158129be7fca83564031600140d9101a1bfcca')]:
 matches=[p for p in Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\receipt_caller_integration_015').glob(folder+'/*.json') if p.stat().st_size==size]
 matches=[pin(p) for p in matches if pin(p)['sha256']==digest];assert len(matches)==1;old.append(matches[0])
v=dict(manifest=pin(mp),protocol_adoption=pin(R/'ROOT_I13_FINAL_PROTOCOL007_RECORDED_CONTEXT_DIFFERENT_REVIEW_ADOPTION_004.json'),previous_saved_refusal=pin(C/'ROOT_I13_ONCE001_DIFFERENT_SAVED_REFUSAL_ADOPTION_001.json'),actor_context_clarification_adoption=pin(C/'ROOT_I13_EXACT_FIXED_I2_API_ACTOR_CONTEXT_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'),supervisor=sup,held_composition=comp,held_composition_API=api,once_admission_helper=once,different_reviews=reviews,retained_Source_baseline=pin(R/'ROOT_I13_RETAINED_I2_006_CALLER003_WHOLE_SOURCE_AND_AST_BASELINE_001.json'),retained_Source_pins=old)
p=C/'I13_FINAL_SOURCE_ADOPTION_INPUT_002.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(b)<=2097152
with p.open('xb') as h:assert h.write(b)==len(b)
print(json.dumps(dict(config=pin(p),covered_final_pins=13,retained_pins=len(old),target_execution=False)))
