def need(v,why):
 if not v:raise ValueError(why)
def stream_pin(p):
 p=Path(p)
 for q in(p,*p.parents):
  s=q.lstat();need(not q.is_symlink()and not getattr(s,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(p.is_file()and a.st_nlink==1,'ordinary single-link metadata/Source');h=hashlib.sha256();n=0
 with p.open('rb')as f:
  while True:
   b=f.read(1048576)
   if not b:break
   h.update(b);n+=len(b)
 z=p.stat();need(n==a.st_size==z.st_size and all(getattr(a,k,None)==getattr(z,k,None)for k in('st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_nlink','st_file_attributes')),'stable whole pin')
 return dict(path=str(p),bytes=n,sha256=h.hexdigest())
def doc(p,sha=None):
