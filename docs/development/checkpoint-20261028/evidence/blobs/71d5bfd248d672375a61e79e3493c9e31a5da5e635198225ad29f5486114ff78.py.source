"""Root metadata-only exact final publisher binding input author."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def pin(p):
 with p.open('rb') as h:b=h.read(2097153)
 assert 0<len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=json.loads((C/'I13_HELD_COMPOSITION_BINDING_INPUT_001.json').read_bytes());v['schema_version']=2
s=pin(T/'validate_selected_role_publisher_metadata_003.py');a=pin(T/'CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_003.json')
assert s['bytes']==65327 and s['sha256']=='415a2498b094c02250e61dc5c711a129856d573d98a5809a65f0e8b09f952fc1'
assert a['bytes']==3878 and a['sha256']=='af6f16a7a35b08f7e95506b19e2b8851d9554ce213a2d49420ebb0ee9cd85522'
v['fixed_sources']['publisher']=dict(Source=s,API=a)
p=C/'I13_HELD_COMPOSITION_BINDING_INPUT_002.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:assert h.write(b)==len(b)
print(json.dumps(dict(binding=pin(p),target_execution=False)))
