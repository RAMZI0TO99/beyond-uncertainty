def sha(b):return hashlib.sha256(b).hexdigest()
def fact(p):
 b=Path(p).read_bytes();return dict(path=str(p),bytes=len(b),sha256=sha(b))
def ck(n,v,e):
 if any(x['name']==n for x in CHECKS):raise ValueError('duplicate check')
 CHECKS.append(dict(name=n,passed=v is True,evidence=e))
def pairs(items):
 d={}
 for k,v in items:
  if k in d:raise ValueError('duplicate key')
  d[k]=v
 return d
def bad(v):raise ValueError('number')
def strict(b):
 s=b.decode('utf-8','strict')
 if s.startswith('\ufeff'):raise ValueError('BOM')
 v=json.loads(s,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
 def tree(x):
  if type(x)is str:
   if any(55296<=ord(c)<=57343 for c in x):raise ValueError('surrogate')
  elif type(x)is dict:
   for k,w in x.items():tree(k);tree(w)
  elif type(x)is list:
   for w in x:tree(w)
  elif x is not None and type(x)not in(bool,int):raise ValueError('type')
 tree(v);return v
def pinread(pin,label):
 b=Path(pin['path']).read_bytes();ck(label,fact(pin['path'])==pin,pin);return b
def source(pin,label):
 b=pinread(pin,label+'.whole_pin');s=b.decode('utf-8');t=ast.parse(s,filename=pin['path']);compile(t,pin['path'],'exec');ck(label+'.AST_compile_only',True,'No code object evaluated.');return b,s,t
def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def method(t,c,n):return next(x for x in defs(t)[c].body if isinstance(x,ast.FunctionDef)and x.name==n)
def txt(n):return ast.unparse(n)
def lit(t,name):return ast.literal_eval(next(n.value for n in t.body if isinstance(n,ast.Assign)and any(isinstance(a,ast.Name)and a.id==name for a in n.targets)))
def frag(n,label,items):
 for k,v in items:ck(label+'.'+k,v in txt(n),v)
def nodes(v):
 if type(v)is dict:return 1+sum(nodes(k)+nodes(x)for k,x in v.items())
 if type(v)is list:return 1+sum(nodes(x)for x in v)
 return 1
def encode_case(v):
 if type(v)is bytes:return dict(AST_builtin_type='bytes',canonical_base64=base64.b64encode(v).decode('ascii'))
 if type(v)is dict:return {k:encode_case(x)for k,x in v.items()}
 if type(v)is list:return [encode_case(x)for x in v]
 return v
def save(p,v):
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
 if len(b)>2097152:raise ValueError('cap')
 with p.open('xb')as h:h.write(b)

