"""Prepare a distinct Root batchB metadata allocator; no peer imports/calls."""
import ast,hashlib,os
from pathlib import Path
R=Path(__file__).parent
before=R/'issue_PRO3_metadata_batchA_grant017_001.py';old=before.read_bytes();s=old.decode('utf-8')
changes=[
 ('cho51_canonical_boundary_20261025_v5_a','cho51_canonical_boundary_20261025_v5_b',2),
 ('5bccfc99827e94e36cc40bf6305d25766ca8ba5a6008304bf6f84b558264c4e0','e1d8a53b4463b982daf54f30ef2889b7f6d7ad23b0f711bada8cef834cb15f29',1),
 ('c6c16feb437ebdc8da485906f66e9b27fd2823b642e2b87733bc4a6e925ed42d','5783de185bbf6318cb9bf2d4fb6f5d2db9446da10631a6198b2792af1f1aeeb4',1),
 ('1a56aef74526e6169dded3ae292a003266577c26fb9bd5cf9bb6d3a6473882ac','6b3be4809c1dd3b54861d62f6d6a96ed2722f16c902908d6bf3ba9c4521b9619',1),
 ("request['batch_id']=='a'","request['batch_id']=='b'",1),
 ("counts=plan['batches']['a']['function_counts']","counts=plan['batches']['b']['function_counts']",1),
 ('len(counts)==10 and sum(counts.values())==36','len(counts)==11 and sum(counts.values())==44',1),
 ('ordered10function36case','ordered11function44case',1),
 ("pr['batch_id']=='a'","pr['batch_id']=='b'",1),
 ("pr['expected_tests']==36","pr['expected_tests']==44",1),
 ('expected_metadata_tests=36','expected_metadata_tests=44',3),
 ("pins=family[0]['pins']","pins=family[1]['pins']",1),
 ("pins['bytes']==3264181","pins['bytes']==3264186",1),
 ('82b820ab809370465c6589124b182106ad3467a2cf61e1d063003479b711b291','f12300fc7c929fd6c70b1b026218c4324b0cc0c56044ecab23b12dadaf9f5dea',1),
 ('exact A external map','exact B external map',1),
 ('ROOT_RETAINED_PRO3_016_TIMEOUT_AND_FULL_CUSTODY_RELEASE_REPORT_001.json','ROOT_RETAINED_PRO3_017_BATCH_A_AND_FULL_CUSTODY_RELEASE_REPORT_001.json',1),
 ('0b0741fdcc639ee8492455cab20a96a27bc4dd04c708111bee87d240444a80e1','e755076235f47885e589768bbe4d9d787808a58190272512ccb678ebe592acf7',1),
 ("prior['grant']==16","prior['grant']==17",1),
 ('prior016','prior017',1),
 ('d40723de0de86aec0a958f651d0b0570024e57e59dfc0943f3f7a28cc2c6abf7','367ea7c3c87e6e6dd7f0892383b4502d6635add27455d53bfd067ca939ffd330',1),
 ("*.json'))==16","*.json'))==17",1),
 ('PRO2_PRO3_COMPUTE_RELEASE_20261025_017.json','PRO2_PRO3_COMPUTE_RELEASE_20261025_018.json',2),
 ('unused017identity','unused018identity',1),
 ('batchA not already','batchB not already',1),
 ('own_work_since016','own_work_since017',1),
 ('own_future_synthetic_held_until017','own_future_synthetic_held_until018',1),
 ('prior_peer016','prior_peer017',1),
 ('BatchA only','BatchB only',1),
 ('ordered10function/36selected','ordered11function/44selected',1),
 ('secondJob/B/C/aggregate','secondJob/C/aggregate',1),
 ('old_grants001_through016','old_grants001_through017',1),
 ('future_batch_B_C_or_aggregate_authorized','future_batch_C_or_aggregate_authorized',1),
 ("batch_id='a'","batch_id='b'",1),
 ]
for oldtext,newtext,count in changes:
 assert s.count(oldtext)==count,(oldtext,s.count(oldtext),count)
 s=s.replace(oldtext,newtext)
anchor="need(pin(prior['peer_lease_closeout']['path'])==prior['peer_lease_closeout']and prior['peer_lease_closeout']['sha256']==request['predecessor_full_release_sha256']=='367ea7c3c87e6e6dd7f0892383b4502d6635add27455d53bfd067ca939ffd330','prior exact lease fullrelease remains unchanged')"
assert s.count(anchor)==1
addition="""
actual,actualp=doc(P/'runs/coordination/cho51_canonical_boundary_20261025_v5_a/actual-review.json','ebb9745e6cd4cfabf221150ca54362ca66f554bbd66fdca8bc12ad0ca6d7e80f')
need(actual['reviewer']=='/root/readiness'and actual['accepted']is actual['accepted_selected_metadata_only']is True and actual['remaining_actionable_findings']==[],'A exact saved selected-metadata audit sealed')
need(actual['tests']==36 and actual['full_collected']==133 and actual['deselected']==97 and actual['reports']==108 and actual['stdlib_controls']==34 and actual['native_and_external_ownership_closed_before_explicit_release']is True,'A complete selected36/full133/97/108reports/34controls and prior closure metadata')
need(actual['full133_suite_accepted']is actual['scientific_admission']is actual['peer_results_accepted']is False,'A audit does not become Root fullsuite/science/peerresult acceptance')
"""
s=s.replace(anchor,anchor+'\n'+addition)
s=s.replace('prior_peer017_full_custody_report=priorp,','prior_peer017_full_custody_report=priorp,prior_batchA_selected_metadata_audit=actualp,')
out=R/'issue_PRO3_metadata_batchB_grant018_001.py';b=s.encode('utf-8');assert len(b)<=2097152 and not os.path.lexists(out)
ast.parse(b,filename=str(out))
with out.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert out.read_bytes()==b
print(str(out),len(b),hashlib.sha256(b).hexdigest())
