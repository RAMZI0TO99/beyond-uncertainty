 schema_version=2,record_type='I13_partition_plan_exact_float_to_decimal_text_Source_repair',author='/root/project_architecture',
 plan=pin(p2),predecessor_plan=pin(p1),whole_predecessor_plan_bytes_base64=base64.b64encode(raw1).decode('ascii'),
