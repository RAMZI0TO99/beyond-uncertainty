def save(n,v):
 shape(v);b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');need(len(b)<=2097152,'own evidence2MiB cap');fresh();p=O/n
