CACHE={};CHECKS=[]
def need(v,m):
 if not v:raise ValueError(m)
def check(n,v,e):
 need(n and n not in {x['name'] for x in CHECKS},'unique check')
 CHECKS.append(dict(name=n,passed=v is True,evidence=e))
 need(v is True,'own Source-review predicate failed: '+n)
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def raw(p):
 p=Path(p)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded singlelink regular file')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size,'stable exact retained buffer')
 return b
def pairs(xs):
 d={}
 for k,v in xs:need(k not in d,'duplicate metadata JSON key');d[k]=v
 return d
def bad(_):raise ValueError('noninteger/nonfinite metadata JSON')
def shape(v):
 todo=[(v,0)];n=0;depth=0
 while todo:
  x,d=todo.pop();n+=1;depth=max(depth,d);need(n<=50000 and d<=48,'own full-key/value node/depth cap')
  need(x is None or type(x) in (str,int,bool,list,dict),'builtin JSON value')
  if type(x) is str:need(not any(55296<=ord(c)<=57343 for c in x),'surrogates refused')
  elif type(x) is list:todo.extend((v,d+1) for v in x)
  elif type(x) is dict:
   need(all(type(k) is str for k in x),'builtin keys')
   for k,v in x.items():todo.extend(((k,d+1),(v,d+1)))
 return dict(nodes=n,depth=depth)
def load(p,expected=None,doc=True):
 p=Path(p);b=raw(p);f=fact(p,b)
 if expected is not None:need(f==expected,'expected whole fact3')
 CACHE[str(p)]=b
 if not doc:return b,f
 v=json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad);shape(v);return v,f

