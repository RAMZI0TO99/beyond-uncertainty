class NumericLiteral(str):pass
def need(v,m):
    if not v:raise ValueError(m)
def ck(name,passed,evidence=None):
    need(type(passed) is bool,'builtin Boolean check');checks.append(dict(name=name,passed=passed,evidence=evidence))
def raw(p):
    p=Path(p)
    for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'direct nonreparse metadata lineage')
    a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded regular singlelink metadata')
    with p.open('rb') as h:
        b=os.fstat(h.fileno());data=h.read(2097153);c=os.fstat(h.fileno())
    d=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
    need(k(a)==k(b)==k(c)==k(d) and len(data)==a.st_size,'stable samebuffer');return data
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def get(p,n=None,sha=None):
    p=Path(p);b=raw(p);fp=fact(p,b);need(n is None or fp['bytes']==n,'announced size');need(sha is None or fp['sha256']==sha,'announced SHA');buffers[str(p)]=b;return b,fp
def pairs(xs):
    d={}
