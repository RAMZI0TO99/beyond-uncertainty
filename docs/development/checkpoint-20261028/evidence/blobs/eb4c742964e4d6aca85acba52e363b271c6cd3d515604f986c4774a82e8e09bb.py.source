"""Narrow Source packaging representation window; no execution permission."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
p=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';before=p.read_bytes();assert pin(p)['sha256']=='caaf2eb42d2394bccb56e34b040259a9f878cb2b57d4c082d2514079885e42b0'
v=json.loads(before); now=dt.datetime.now(dt.timezone.utc);assert (dt.datetime.fromisoformat(v['interval_end'])-now).total_seconds()>60
v.update(schema_version=3,created_utc=now.isoformat(),interval_start=now.isoformat(),predecessor_Source_scope=pin(p),predecessor_Source_scope002_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE002_DIFFERENT_REVIEW_ADOPTION_001.json'),Source_scope002_complete_bytes_preserved=True,Source_scope003_requires_different_review_and_Root_adoption_before_use=True,prior_scopes_or_leases_extended=False,current_peer_scheduling_release=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_012.json'))
v.pop('Pro3_grant011_reported_Job_complete_external_closeout_and_explicit_full_release_still_pending_at_preparation',None)
v['Source_scope002_requires_different_review_and_Root_adoption_before_use']=False
v['Source_scope002_review_and_Root_adoption_completed']=True
v['scope'] += ' Packaging-only clarification: a separately reviewed exact selection may also store complete owned synthetic-run evidence files (once scopes, prelaunch records, retained parent witnesses and owned claim/entry/result/stdout/stderr/supervisor records) in bounded non-executable JSON Base64 bundles. Every original fact3, complete byte sequence and inverse remains represented exactly once in an index; all files remain physically preserved. No target/kernel/fixture Source is bundled, no evidence is normalized, no missing or partial result is repaired, no stored or uncompressed per-file cap, original512-copy-row or64MiB payload cap is waived. Exact final membership, full byte reconstruction, helper Source, candidate and actual creation each require genuine different review and separate Root adoption. This packaging representation grants no synthetic call, result acceptance, operational entry, replay or permission inferred from absent pause files.'
v['additional_packaging_selection_requires_separate_review']=True
q=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json'
b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152
with q.open('xb') as h:h.write(b)
print(json.dumps(dict(scope=pin(q),end_unchanged=v['interval_end'],operational_authority=False,synthetic_calls_admitted=0)))
