                r=copy.deepcopy(byname[name]);r.update(PowerShell_parser_errors=0,exact_two_literal_reversal=True,template_sha256=byname[name.replace('_bound','_template')]['sha256']);draft['phase_sources'].append(r)
        elif role=='pipeline_peer':draft.update(pipeline_source_sha256=byname['pipeline']['sha256'],pipeline_binding_sha256=byname['binding']['sha256'])
        else:draft.update(checker_template_sha256=byname['checker']['sha256'],source_manifest_sha256=byname['checker_manifest']['sha256'],full_source_details_sha256=byname['checker_dependency_audit']['sha256'])
