        p=self.proof(name,[source,api],1,2);return dict(Source=source,API=api,different_review=p[0],Root_adoption=p[1],editor=editor)
    def finish(self):
        rows=copy.deepcopy(self.rows);return dict(packet=next(r['body']for r in rows if r['pin']['path']==self.labels['wrapper']),records=rows,labels=copy.deepcopy(self.labels),mutable=sorted(self.mutable))

def _make(role,peer,catalogue_bytes):return _Build(role,peer,catalogue_bytes).finish()
def _row(b,label):return next(r for r in b['records']if r['pin']['path']==b['labels'][label])
def _replace_pins(v,old,new):
    if type(v)is dict:
        if set(v)=={'path','bytes','sha256'}and v==old:return copy.deepcopy(new)
        return{k:_replace_pins(x,old,new)for k,x in v.items()}
    if type(v)is list:return[_replace_pins(x,old,new)for x in v]
    return v
def _rewrite(b,label,v):
    row=_row(b,label);old=copy.deepcopy(row['pin']);row['body']=_wire(v);row['pin']=_pin(old['path'],row['body']);queue=[(old,copy.deepcopy(row['pin']))]
    while queue:
        old,new=queue.pop(0)
        for r in b['records']:
            if r['pin']['path']not in b['mutable']or r is row:continue
            v=_json(r['body']);changed=_replace_pins(v,old,new)
            if changed!=v:
                before=copy.deepcopy(r['pin']);r['body']=_wire(changed);r['pin']=_pin(before['path'],r['body']);queue.append((before,copy.deepcopy(r['pin'])))
    b['packet']=_row(b,'wrapper')['body']

class _Str(str):pass
class _Hostile:
    def __getattribute__(self,name):raise AssertionError('held entry inspected context')

def _mutate(b,spec):
    handler=spec['handler'];label=spec.get('label','draft');field=spec.get('field')
    if handler=='strict':
        variant=spec['variant'];r=b['records'][0]
        if variant=='pin_bytes_bool':r['pin']['bytes']=True
        elif variant=='pin_key_subclass':r['pin']={_Str(k):v for k,v in r['pin'].items()}
        elif variant=='record_key_subclass':b['records'][0]={_Str(k):v for k,v in r.items()}
        elif variant=='record_extra':r['extra']=False
        elif variant=='record_hash':r['body']=bytes([r['body'][0]^1])+r['body'][1:]
        elif variant=='record_length':r['body']+=b'X'
        elif variant=='casefold_alias':r=copy.deepcopy(r);r['pin']['path']=r['pin']['path'].lower();b['records'].append(r)
        else:
            r=_row(b,'wrapper');v=_json(r['body'])
            if variant=='packet_float':v['extra']=0.5;raw=_wire(v)
            elif variant=='packet_duplicate':raw=r['body'].replace(b'{',b'{"role":"metadata_peer",',1)
            elif variant=='packet_C0':v['extra']='\n';raw=_wire(v)
            elif variant=='packet_surrogate':v['extra']='\ud800';raw=(json.dumps(v,sort_keys=True)+'\n').encode()
            elif variant=='metadata_node_budget':v['extra']=[0]*50000;raw=_wire(v)
            else:raw=b'{'
            r['body']=raw;r['pin']=_pin(r['pin']['path'],raw);b['packet']=raw
        return
    v=_json(_row(b,label)['body'])
    if handler=='delete':parent,key=_parent(v,field);del parent[int(key)if type(parent)is list else key]
    elif handler=='extra':v['unexpected_field']=False
    elif handler=='immutable':
        old=v[field];v[field]=(not old)if type(old)is bool else True if old is None else old+1 if type(old)is int else old+'_changed'
    elif handler=='source_hash':parent,key=_parent(v,field);parent[key]='0'*64
    elif handler=='roster':
        v=_json(_row(b,'wrapper')['body']);label='wrapper';xs=v['role_inputs'][spec['kind']]
        if spec['variant']=='omit':xs.pop()
        elif spec['variant']=='reverse':xs.reverse()
        else:xs.append(copy.deepcopy(xs[0]))
    elif handler=='wrapper_join':
        v=_json(_row(b,'wrapper')['body']);label='wrapper';v[field]=('11234567-89ab-cdef-0123-456789abcdef'if field=='Root_thread'else copy.deepcopy(v['peer_packet']))
    elif handler=='value':
        v[field]=3 if field=='schema_version'else'wrong_record_type'if field=='record_type'else'profile'if field=='role'else _time(19)if label=='decision'else _time(19)if label=='receipt'else _time(1)
    elif handler=='flip':v[field]=not v[field]
    elif handler=='reviewer':
        actor='/root/i2_resume_gap';v['reviewer']=actor.upper()if spec['variant']=='case_alias'else actor+'/descendant'if spec['variant']=='descendant'else actor
    elif handler=='proof_bool':v[field]=False
    elif handler=='coverage':
        v['subjects']=[]
        if 'checks'in v:
            for row in v['checks']:row['evidence']=[]
    else:raise AssertionError('unowned fixture handler '+handler)
    _rewrite(b,label,v)

def run(*,m3,publisher,peer,catalogue_bytes):
    cases=[];seal=_seal()
    for literal in CASE_CATALOGUE:
        spec=copy.deepcopy(literal);name=spec['name'];expected=spec['expected_error']
        assert not(_mutable_ids(spec)&_mutable_ids(CASE_CATALOGUE))
        if spec['handler']=='isolation':
            a=_make(spec['role'],peer,catalogue_bytes);b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(a)&_mutable_ids(b))and not(_mutable_ids(a)&_mutable_ids(FIXED))
            saved=_fingerprint(b);a['records'][0]['pin'].pop('path');assert _fingerprint(b)==saved and _seal()==seal
        elif spec['handler']=='held':
            flag=peer.ACTUAL_ENTRY_QUALIFIED
            try:
                peer.ACTUAL_ENTRY_QUALIFIED=spec['flag']
                try:peer.emit_selected_peer_current_owner(context=_Hostile())
                except peer.I13MetadataError as e:assert e.code==expected
                else:raise AssertionError('held emitter unexpectedly returned')
            finally:peer.ACTUAL_ENTRY_QUALIFIED=flag
        else:
            b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(b)&_mutable_ids(FIXED))
            if spec['handler']!='positive':
                before=_fingerprint(b);_mutate(b,spec);assert _fingerprint(b)!=before,'mutation did not change typed input'
            try:result=peer.validate_selected_peer_author_packet_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=NOW)
            except peer.I13MetadataError as e:
                assert expected is not None and e.code==expected,(name,'wrong typed first guard',e.code,expected)
            else:
                assert expected is None,(name,'expected refusal returned')
                v=_json(result);assert v['role']==spec['role']and v['structural_graph_validated']is True and v['metadata_only']is True
                assert v['full_original_I2_DAG_closed']is False and v['actual_peer_content_qualified']is False and v['current_canonical_authority_qualified']is False and v['native_Parser_authority']is False
                assert type(v['charged_metadata_nodes'])is int and v['charged_metadata_nodes']<=50000
        assert _seal()==seal,'global fixed pin/literal/case specification mutated'
        cases.append(dict(name=name,passed=True));print(json.dumps(dict(event='CASE_PASS',name=name),sort_keys=True),flush=True)
    return dict(cases=cases,passed=len(cases),failed=0,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)
'''
raw=source.encode();assert len(raw)<=2097152
path=OUT/'exercise_selected_peer_author_metadata_memory_001.py';tree=ast.parse(raw);compile(raw,str(path),'exec',dont_inherit=True)
with path.open('xb')as f:f.write(raw)
catalogue=dict(schema_version=1,record_type='I13_fresh_peer_literal_case_catalogue',author='/root/i2_resume_gap',Source=pin(path,raw),cases=cases,count=len(cases),names_json_sha256=hashlib.sha256(json.dumps([x['name']for x in cases],sort_keys=True,separators=(',',':')).encode()).hexdigest(),target_execution=False,tests_executed=False,operational_authority=False)
for name,v in [('I13_PEER_FRESH_LITERAL_CASE_CATALOGUE_001.json',catalogue),('I13_PEER_FRESH_MEMORY_FIXTURE_SOURCE_AUTHOR_RECEIPT_001.json',dict(schema_version=1,record_type='I13_fresh_peer_fixture_Source_author_receipt',author='/root/i2_resume_gap',Source=pin(path,raw),kernel=pin(OUT/'validate_selected_peer_author_packet_metadata_004.py'),API=pin(OUT/'CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_004.json'),case_count=len(cases),fixed_capture_pins=[v['pin']for v in fixed.values()],method='Fresh fixture authored from schema/protocol and exact raw fixed data only. No old fixture imports/copies, no target/fixture import/call/run. AST/compile only; intended first guards require genuine Source review and fresh Root once scope.',author_tool=pin(Path(__file__)),target_execution=False,tests_executed=False,operational_authority=False,actual_family_publication=False))]:
    payload=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(payload)<=2097152
    with (OUT/name).open('xb')as f:f.write(payload)
print(json.dumps(dict(Source=pin(path,raw),cases=len(cases),catalogue=pin(OUT/'I13_PEER_FRESH_LITERAL_CASE_CATALOGUE_001.json')),sort_keys=True))
