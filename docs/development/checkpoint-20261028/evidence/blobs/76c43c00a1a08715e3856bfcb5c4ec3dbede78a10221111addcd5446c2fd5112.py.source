    def p(self,label):return copy.deepcopy(next(r['pin']for r in self.rows if r['pin']['path']==self.labels[label]))
    def proof(self,name,subjects,when,adopt):
        reviewer='/root/i13_peer_independent_review'
        common=dict(schema_version=1,record_type='synthetic_source_proof',reviewer=reviewer,verdict='PASS_SOURCE_SYNTHETIC_METADATA_ONLY',checks_failed=0,checks_passed=1,created_utc=_time(when),subjects=copy.deepcopy(subjects),target_execution=False,operational_authority=False,native_Parser_executed=False)
        full=copy.deepcopy(common);full['checks']=[dict(name='whole_source_and_metadata',passed=True,evidence=copy.deepcopy(subjects))]
        fp=self.add(name+'_full',full);caps=copy.deepcopy(common);caps['full_proof']=fp;cap=self.add(name+'_capsule',caps)
        ap=self.add(name+'_adoption',dict(schema_version=1,record_type='synthetic_Root_source_adoption',author='/root',verdict='ACCEPT_SOURCE_SYNTHETIC_METADATA_ONLY',created_utc=_time(adopt),subjects=[*copy.deepcopy(subjects),cap,fp,self.scope,self.selection],different_review=cap,full_proof=fp,target_execution=False,operational_authority=False,native_Parser_executed=False))
        return cap,ap
