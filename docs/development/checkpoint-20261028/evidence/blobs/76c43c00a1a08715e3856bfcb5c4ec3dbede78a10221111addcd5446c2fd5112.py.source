def _wire(v):return(json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False)+'\n').encode()
def _pin(path,raw):return dict(path=path,bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def _json(raw):return json.loads(raw.decode('utf8'))
def _time(second):return '2026-10-25T11:00:%02d.000000+00:00'%second
def _fixed(name):
    row=copy.deepcopy(FIXED[name]);return row['pin'],base64.b64decode(row['base64'],validate=True)
def _value_get(v,path):
    for key in path.split('.'):
        v=v[int(key)]if type(v)is list else v[key]
    return v
def _parent(v,path):
    parts=path.split('.');return _value_get(v,'.'.join(parts[:-1]))if len(parts)>1 else v,parts[-1]
def _fingerprint(v):
    if type(v)is dict:return('dict',tuple((_fingerprint(k),_fingerprint(x))for k,x in v.items()))
    if type(v)is list:return('list',tuple(_fingerprint(x)for x in v))
    if type(v)is bytes:return('bytes',len(v),hashlib.sha256(v).hexdigest())
    return(type(v).__name__,v)
def _seal():return hashlib.sha256(repr(_fingerprint((FIXED,CASE_CATALOGUE))).encode()).hexdigest()
def _mutable_ids(v):
    out=set()
    def walk(x):
        if type(x)in(dict,list):
            out.add(id(x))
            for y in (list(x)+list(x.values())if type(x)is dict else x):walk(y)
    walk(v);return out

class _Build:
    def __init__(self,role,peer,catalogue_bytes):
        self.rows=[];self.labels={};self.mutable=set();self.role=role
        for name in FIXED:
