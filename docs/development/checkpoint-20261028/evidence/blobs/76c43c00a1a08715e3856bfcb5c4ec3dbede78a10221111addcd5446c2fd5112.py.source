            inputs['carried'].append(dict(role=name,subject=p,source_cap=r['source_cap']));current.append(p);byname[name]=p
        priorraw=_fixed('predecessor_'+role)[1];prior=_json(priorraw);draft=copy.deepcopy(prior)
        draft['created_utc']=_time(0)if 'created_utc'in draft else None
        if draft.get('created_utc')is None:draft.pop('created_utc',None)
        if role=='metadata_peer':
            for key in self.policy['role_specific_joins'][role]['nested_mutable_lists']:draft[key]=[]
            draft.update(finite_input_count=15,manifest_payload_count=12,source_manifest_sha256=byname['metadata_manifest']['sha256'])
        elif role=='metadata_bound_review':
            draft['actual_script_sha256']=byname['capture_bound']['sha256'];draft['phase_set']=['before','after']
            draft['source_bindings']={k:byname[v.split('.',1)[1]]['sha256']for k,v in self.policy['role_specific_joins'][role]['source_bindings_closed9'].items()}
        elif role=='phase_peer':
