"""Prepare independent review criteria only; no subject code imports or calls."""
from pathlib import Path
import datetime as dt,hashlib,json,os
R=Path(__file__).parent.parent;D=Path(__file__).parent
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def doc(p,by,h):
 b=p.read_bytes();assert len(b)==by and hashlib.sha256(b).hexdigest()==h;return json.loads(b),fact(p,b)
s,sp=doc(R/'ROOT_CURRENT_I13_RETENTION_SOURCE_QUALIFICATION_SCOPE_008.json',7324,'6b0562d5c5df10afb6cea07771a75da7b5df03632144e8b625f37ef5f747c515')
a,ap=doc(R/'ROOT_I13_SOURCE_SCOPE008_AND_RETENTION_PROTOCOL_SOURCE_ONLY_ADOPTION_001.json',5920,'9b8e3e1d439a0f471028ad30107b95a4f6318394f9e3726de16cf88568a790ff')
i,ip=doc(R/'I13_RETENTION_EXPORTER_API_AND_HELD_SUPERVISOR_SOURCE_CONTRACT_001.json',9397,'2b3791a36225800aea34b452c0e58a6efe411b2a876cc5b9f7f3a64029a67ca4')
assert a['Source_scope']==sp and a['Source_interface_contract']==ip and a['retention_protocol_adopted_for_Source_authoring_only']is True and a['retention_Source_qualified']is False and a['raw_capture_admitted']is False
criteria=[
 ('provenance_and_exact_frozen_subjects','Read/hash all frozen Source/API/fragments/inverses/author histories and actual Source008 adoption; strict metadata JSON. Independent review never invokes authors or subject code.'),
 ('immutable_prefix_and_old_AST','Full fixture016 must begin with exact570281-byte015 prefix. Old definitions/top-level bindings/936literal rows and all runners/seals remain exact; appended new symbols cannot rebind old names.'),
 ('caps','Retention-only append<=65536; wholefixture<=2097152; API<=65536; heldsupervisor<=65536. Perrecord2MiB/256records/32MiBgraph,1MiBpartition,2MiBwire/stream,50000nodes/depth48,header65536B/4096nodes unchanged.'),
 ('closed_inert_API','Exact31-key issued API shape, seven keyword-only parameters, fullnewSource and old015wholepins, exact prior contract/schema/plan/source9/error20/limits, all literal false creation/capability flags. Source_qualified=False remains dated immutable state.'),
 ('builtin_inputs_and_projection','Exact builtin bytes/str/counters and exact ModuleType raw Source/API fact3 projections; no getters/callback dispatch, arbitrary functions or incoming mutable authority accepted/copied. Fixed prior Source9 pins are complete.'),
 ('strict_plan_and_identity','Hash exact original pretty plan bytes before use; strict duplicate/nonfinite/float/surrogate-refusing JSON. Verify closed fullplan shape/graph namespaces/ordinals/labels/LF digests and fixed partition. Canonical lowercase UUID is identity only.'),
 ('fixed_build_closure','Exactly one canonical graph via same fixed stage/selected_role spec and preserved local _fixture_make/_M3Build/_Outer/_fixed closure. No oldsnapshot/_LDPlan/_ld_inventory/run*/edit/guard/phase_bound/negative/validator/kernel/constructor/encode/export call.'),
 ('all_whole_records_first','Before selecting a partition verify every exact {pin,body} record type/length/hash, graph count/rawcaps, unique casefold path, original order/labels/fullsavedroster and digest. Never trim validation to selected records.'),
 ('wire_exact_bodies','Retain exact builtin raw bytes including binary/duplicate-key/NaN/nonUTF8 bodies without JSON parsing/normalization/serialization. Canonical strict Base64 decode+reencode and original raw fact3 must match every selected whole row.'),
 ('output_schema_and_budget','Closed33-field transport plus exact4-field rows, canonical sorted/minified UTF8+LF, fixed graph/partition/Source9/contract/schema/plan. Enforce actual header bytes/nodes then fullwire/depth/nodes and exact selected digest/rawsum/order; no placeholder success.'),
 ('seals_and_failures','Preserve original fixed globals/held flags/incoming-data snapshots and new immutable constants before/after graph and in finally. No mutation/callback alias. MemoryError/BaseException/corruption abort; error20 codes bounded512 no rawbody/Source/traceback leaks.'),
 ('append_inverse_and_no_side_effects','Exact suffix/whole-prefix inverse and AST complements; pure exporter has no filesystem/process/claim/runtime I/O or current authority interpretation. No selfSource/API hash cycles.'),
 ('supervisor_public_hold','Exact supervise_I13_raw_retention_once(*,request_bytes,admission_bytes) and main unconditionally typed-refuse E_RETENTION_AUTHORITY before inspection, parsing, opening, claiming, child execution or launch.'),
 ('supervisor_private_hold','Every private I/O/claim/launch/child-execution/effect entry first unconditionally activation-refuses; no JSON/UUID/flag/input toggles it. Module top level inert. Future activated Source plus fresh exact admission need new review/adoption.'),
 ('dormant_guard_completeness','Statically review dormant mechanics for exact Source/API/contract/schema/plan and sealed request/scope joins, fresh resource floors/age/peer holds, strict total60/wait50/cleanup10/reap5, publicationreserve>60 and complete outer deadline, exclusive once/output identities.'),
 ('dormant_custody','Ownedchild identity, stream<=2MiB truthful overflow/EOF/drain/errors, bounded cleanup/reap, exact caller/child exits and partialfailure preservation, no unrelated kill/physicalabsence or hostquiet inference. All these mechanics remain unexecuted.'),
 ('consumed_partition_and_no_retry','Logical consumed key binds operation+exporterSource+API+selectionPlan+partition, excludes UUID/scope wrapper as replay bypass. Failure/missingresult consumes. No automatic retry or old snapshot/case identity reset.'),
 ('dormant_readback','Prospective whole result pin/schema/canonicalwire and strict Base64 all selected pins/inverse/order/rawsum; full output fsync/readback with bounded metadata, independent saved review and Root adoption remain future requirements.'),
 ('completion_not_self_admission','Exact23 separate accepted partitions and all6graph coverage/digests/custody needed for separately reviewed global manifest; no current acquisition/completion/result accepted, no self/future hash links.'),
 ('semantic_boundaries','No old raw input omission, proof-event coalescing/new receipt ABI, counter sharing/reset, result54 change, semantic parser exemption or guard waiver. Old field-specific actors/purpose/time/deepobservations remain future designated-body duties.'),
 ('Source_only_conclusion','Only static Source qualification may be concluded. No compiler/import/export/helper/build/snapshot/fixture/test/supervisor/process/native/capture calls, fit/headroom/science/legacyABI claim or actual publication. All11 blockers and20PASS/12FAIL/904unestablished remain.')]
v=dict(schema_version=1,record_type='Independent_I13_retention_qualification_static_review_criteria_only',reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),status='AWAITING_FROZEN_IMPLEMENTATION_SOURCE',scope=sp,Source_only_adoption=ap,closed_interface_contract=ip,criteria=[dict(name=n,requirement=t)for n,t in criteria],criteria_are_completed_checks=False,Source_qualified=False,ready_for_execution=False,raw_capture_admitted=False,target_execution=False,tests_executed=False,subject_import_or_compile=False,operational_authority=False,scientific_authority=False,overall_NOT_READY=True,remaining_ABI_blockers=11)
b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');assert len(b)<2097152 and(dt.datetime.fromisoformat(s['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
p=D/'INDEPENDENT_I13_RETENTION_QUALIFICATION_STATIC_REVIEW_CRITERIA_001.json'
with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b;print(json.dumps(fact(p,b)))
