def sha(b):return hashlib.sha256(b).hexdigest()
def pin(p,b=None):
 p=Path(p);b=p.read_bytes()if b is None else b
 return dict(path=str(p),bytes=len(b),sha256=sha(b))
def load(p):
 def pairs(rows):
  d={}
  for k,v in rows:
   assert k not in d
   d[k]=v
  return d
 def bad(x):raise ValueError(x)
 return json.loads(Path(p).read_bytes().decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def check(name,ok,evidence=None):
 assert type(ok)is bool
 checks.append(dict(name=name,passed=ok,evidence=evidence))
def exact(p):return pin(p['path'])==p
def tree(p):return ast.parse(Path(p).read_bytes().decode('utf8'))
def dump(n):return ast.dump(n,include_attributes=False)
def constants(tr):
 out={}
 for x in tr.body:
  if isinstance(x,ast.Assign)and len(x.targets)==1 and isinstance(x.targets[0],ast.Name):
   try:out[x.targets[0].id]=ast.literal_eval(x.value)
   except(ValueError,TypeError):pass
 return out
def defs(tr):return {n.name:dump(n)for n in tr.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def direct(v,p):
 rows=v.values()if type(v)is dict else v if type(v)is list else ()
 return any(type(x)is dict and set(x)=={'path','bytes','sha256'}and x==p for x in rows)
def changed_top(a,b):
 assert len(a.body)==len(b.body)
 out=[]
 for x,y in zip(a.body,b.body):
  if dump(x)!=dump(y):
   assert isinstance(x,ast.Assign)and isinstance(y,ast.Assign)and dump(x.targets[0])==dump(y.targets[0])
   out.append(x.targets[0].id)
 return out

