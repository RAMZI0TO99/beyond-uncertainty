import json
from pathlib import Path
ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
OLD=ROOT.parent/'resume-20261025-002'/'receipt_caller_integration_015'
BASE=ROOT.parent/'resume-20261015-001'
catpath=OLD/'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json'
cat=json.loads(catpath.read_bytes());spent={p['path'].casefold()for p in cat['spent_pin75']}
source=ast.parse((OLD/'i12'/'validate_selected_peer_receipt_metadata_004.py').read_bytes())
historic=ast.literal_eval(next(n.value for n in source.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='HISTORICAL_SELECTION45_PIN'for t in n.targets)))
paths={
'old_base_catalogue':catpath,
'M3_inventory17':Path(cat['M3_inventory17_pin']['path']),
'current_historical45':Path(cat['current_historical_selection_pin']['path']),
'full_historical45':Path(historic['path']),
'peer_role_data001':OUT/'I13_PROPOSED_SELECTED_PEER_ROLE_INPUT_AND_ORIGINAL_OUTPUT_CONTRACT_DATA_001.json',
'common_catalogue003':ROOT/'m3_peer_contracts_016'/'m3_protocol_audit_001'/'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_003.json',
'LF_annex002':OUT/'I13_PROPOSED_EXACT_FIXED_INVENTORY_SINGLE_DESCRIPTIVE_LF_ANNEX_002.json',
'I0_API001':BASE/'native_owner_implementation_004'/'i0'/'CURRENT_OWNER_SUPPORT_VALIDATOR_INERT_API_001.json',
