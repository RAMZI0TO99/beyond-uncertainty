'I11_API007':ROOT.parent/'resume-20261025-001'/'i2_receipt_contract_014'/'i11'/'CURRENT_OWNER_FINITE8_CANONICAL_RECEIPT_METADATA_INERT_API_007.json',
'I12_formats_API003':OLD/'i12'/'CURRENT_OWNER_OUTSIDE8_RECEIPT_FORMAT_CONSTRUCTOR_INERT_API_003.json',
