def pairs(rows):
    v={}
    for k,x in rows:
        assert k not in v
        v[k]=x
    return v
def bad(x):raise ValueError('noninteger JSON')
rows=[]
for name,path in paths.items():
    assert str(path).casefold()not in spent
    with path.open('rb')as stream:raw=stream.read(2097153)
    assert 0<len(raw)<=2097152
    v=json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    controls=[];surrogates=[];nodes=[0];maxdepth=[0]
    def walk(x,pointer='',depth=0):
        nodes[0]+=1;maxdepth[0]=max(maxdepth[0],depth)
        if type(x)is str:
            cps=sorted({ord(c)for c in x if ord(c)<32})
            if cps:controls.append(dict(pointer=pointer,C0_codepoints=cps,UTF8_bytes=len(x.encode('utf8',errors='surrogatepass')),UTF8_sha256=hashlib.sha256(x.encode('utf8',errors='surrogatepass')).hexdigest(),counts={str(c):sum(ord(z)==c for z in x)for c in cps}))
            if any(0xD800<=ord(c)<=0xDFFF for c in x):surrogates.append(pointer)
        elif type(x)is dict:
            for k,z in x.items():
                esc=k.replace('~','~0').replace('/','~1');walk(k,pointer+'/'+esc+'#key',depth+1);walk(z,pointer+'/'+esc,depth+1)
        elif type(x)is list:
            for i,z in enumerate(x):walk(z,pointer+'/'+str(i),depth+1)
        else:assert x is None or type(x)in(bool,int)
    walk(v)
    known=name=='M3_inventory17'and len(controls)==1 and controls[0]['pointer']=='/capture_six_assignment_ABI/actual_template_assignments/BINDINGS/whole_assignment'and controls[0]['C0_codepoints']==[10]
    known=known or(name=='I11_API007'and all(x['pointer'].startswith('/literal_case_catalogue/')for x in controls))
    rows.append(dict(name=name,pin=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),nodes=nodes[0],maximum_depth=maxdepth[0],C0_leaves=controls,surrogate_leaves=surrogates,all_C0_covered_by_exact_already_known_policies=(not controls or known),bounds_fit_individually=nodes[0]<=50000 and maxdepth[0]<=48))
v=dict(schema_version=1,record_type='I13_limited_mandatory_fixed_JSON_C0_surrogate_node_readonly_sweep',author='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),scope='Only explicitly listed mandatory/known Source-provenance data and retained actual producer/validator APIs; no recursive repository scan, no target call or fixture construction, no75spent body read. New unissued APIs do not yet exist and must be screened when authored.',rows=rows,records=len(rows),C0_record_names=[x['name']for x in rows if x['C0_leaves']],new_unaccounted_C0=[x['name']for x in rows if not x['all_C0_covered_by_exact_already_known_policies']],surrogate_records=[x['name']for x in rows if x['surrogate_leaves']],counter_boundary='Individual raw JSON node counts only. Combined Source-reviewed fixture graph must separately account conservative parent+child totals before actual once admission. No target timing or acceptance claim.',target_execution=False,tests_executed=False,operational_authority=False,spent_identity_body_reads=0)
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=OUT/'I13_LIMITED_MANDATORY_FIXED_JSON_C0_SURROGATE_NODE_SWEEP_001.json'
with path.open('xb')as stream:stream.write(raw)
print(json.dumps(dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest(),records=len(rows),C0_record_names=v['C0_record_names'],new_unaccounted_C0=v['new_unaccounted_C0'],surrogate_records=v['surrogate_records']),sort_keys=True))
