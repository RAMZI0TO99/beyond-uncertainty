"""Exact Root-selected partition admission input; invokes no control or target."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(supervisor=pin(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_007.py'),Source_adoption=pin(C/'ROOT_I13_BOUNDED_PARTITION_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_001.json'),previous_consumed_adoption=pin(C/'ROOT_I13_ONCE003_DIFFERENT_SAVED_TIMEOUT_ADOPTION_001.json'),peer_release_report=pin(R/'coordination/ROOT_RETAINED_PRO3_012_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'))
assert v['Source_adoption']['sha256']=='a0b6b7a7c7b2abdd5e990b7d194129b99b82a53f507b14569ea028dceed99651'
p=C/'I13_BOUNDED_PARTITION_ONCE_ADMISSION_INPUT_001.json'
with p.open('xb') as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(input=pin(p),target_calls=0)))
