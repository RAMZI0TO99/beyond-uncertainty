"""Prepare closed interface decisions as metadata before implementation Source authoring."""
import datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
P=R.parent/'resume-20261027-001'/'raw_input_retention_contract_001'
p=P/'I13_PROSPECTIVE_RAW_INPUT_RETENTION_CONTRACT_001.json'
b=p.read_bytes();assert len(b)==19963 and hashlib.sha256(b).hexdigest()=='d8cebfab150927488ec42b3dbbb8e02a8d5dd69616112b69cd2471b7c09c1aa1'
c=json.loads(b)
v=dict(schema_version=1,record_type='I13_retention_exporter_API_and_held_supervisor_closed_Source_interface_contract',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),basis_contract=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),
 exporter_API_required_keys=['schema_version','record_type','author','Source','previous_fixture_Source','export_name','keyword_only_parameters','return_type','error_class','contract','schema','selection_plan','Source_inputs','limits','metadata_only','Source_qualified','ready_for_execution','capture_admitted','target_execution','operational_authority','scientific_authority','Native8','Parser','runtime','actual6','science','actual_family_publication','full_original_I2_DAG_closed','authentic_loader_qualified','compact_ABI_qualified','original936_results_changed'],
 exporter_API_literals=dict(schema_version=1,record_type='I13_raw_input_retention_exporter_inert_API',author='/root/project_architecture',export_name='retain_I13_M3_input_record_partition',keyword_only_parameters=['m3','publisher','peer','catalogue_bytes','selection_bytes','partition_id','capture_id'],return_type='builtin bytes canonical sort_keys/minified/ensure_ascii=False UTF8 JSON plus LF',metadata_only=True,Source_qualified=False,ready_for_execution=False,capture_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,Native8=False,Parser=False,runtime=False,actual6=False,science=False,actual_family_publication=False,full_original_I2_DAG_closed=False,authentic_loader_qualified=False,compact_ABI_qualified=False,original936_results_changed=False),
 exporter_API_structures=dict(Source='whole newfixture016 fact3',previous_fixture_Source='whole015fact3',error_class=dict(name='I13RawRetentionError',base='ValueError',codes=c['typed_errors']),contract='exact basis_contract fact3',schema=c['schema'],selection_plan=c['selection_plan'],Source_inputs=c['original_Source_inputs'],limits=dict(fixture_Source_bytes=2097152,retention_append_bytes=65536,API_bytes=65536,result_bytes=2097152,partition_raw_bytes=1048576,record_count=256,record_bytes=2097152,graph_raw_bytes=33554432,metadata_nodes=50000,metadata_depth=48,header_bytes=65536,header_nodes=4096)),
 exact_decisions=['Full fixture016 is the exact570281-byte015prefix plus retention-only append<=65536, whole<=2097152; no older symbol or function/row/runner/guard may be rebound or changed. API does not claim wholefixture<=65536.','Plan Source007 is immutable dated design provenance only. Current Source008 authoring and future timing/admission are external; no new scheduling/authority input is added to the seven-keyword pure export.','Exporter contains exact contract/schema/plan/oldclosed9 literals, never its own future Source/API pin. Parent external witness binds actual Source/API/supervisor/adoptions/scope/result, avoiding selfhashcycles.','No _ld_inventory or oldsnapshot/_LDPlan/run*/validator/encoder call. Full N-record byte/hash/labels/roster verification precedes selection; bodies are never parsed/normalized. Fixed existing error codes cover typed record/roster/unmodeled-build failures, bounded message<=512 with no rawbody/traceback leakage. MemoryError/BaseException/finally-seal corruption abort.','API Source_qualified=False is dated creation state. A distinct later genuine Source review and Root adoption records only static Source qualification; no runtime flag is changed in place. No public operational exports are declared by this API.','Root supervisor Source public entry supervise_I13_raw_retention_once(*,request_bytes,admission_bytes), plus main, must unconditionally raise a typed E_RETENTION_AUTHORITY before inspecting input/opening/claiming/launching. Private IO/launch/child-execution entries must each pass an unconditional held activation guard before effects. No admission JSON/UUID/flag alone may activate this Source. A future additive reviewed supervisor Source activation plus separate fresh exact admission is required.','Dormant prospective supervisor mechanics remain subject to original60total/50wait/10cleanup/5reap,2MiB perstream/result, strict60publicationreserve, original resource floors, fixed expectedSource/API/contract/plan and exclusive once claim, ownedchild cleanup/reap/drain/EOF, canonical exactbyte readback and fixed outputschema. No unrelated-process kill or hostquiet/physicalabsence claim. Future Source implementation completeness is reviewed statically, never executed now.'],
 implementation_Source_authored=False,capture_admitted=False,all_execution_gates_held=True,compact_ABI_status='NOT_READY',remaining_blockers=11)
out=R/'I13_RETENTION_EXPORTER_API_AND_HELD_SUPERVISOR_SOURCE_CONTRACT_001.json'
w=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(w)<=2097152 and (dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
with out.open('xb') as h:h.write(w);h.flush();os.fsync(h.fileno())
assert out.read_bytes()==w
print(json.dumps(dict(path=str(out),bytes=len(w),sha256=hashlib.sha256(w).hexdigest())))
