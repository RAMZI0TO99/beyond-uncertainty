"""Bind final supervisor003 instead of preserved unrun002; keep whole adopter001."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
p=R/'adopt_retention_Source_qualification_and_prepare_handoff005_001.py';b=p.read_bytes()
assert len(b)==12383 and hashlib.sha256(b).hexdigest()=='2532d4340ea8b21129b3d0bf1eed2de20b3df03d2539d230f66376a02bcf8806'
s=b.decode()
s=s.replace('ROOT_I13_HELD_RAW_RETENTION_SUPERVISOR_002.py','ROOT_I13_HELD_RAW_RETENTION_SUPERVISOR_003.py').replace("bytes=51489,sha256='3b6501c6c57dda314eb26c31dfd025e564997e09ac7ba073ca7077258dfb95a5'","bytes=53063,sha256='feb29a0bd90cd9f49b3ee7d63f85ae38f3d9317ef4bd60d905c229b05302e341'").replace('heldsupervisor002/embeddedchild002','heldsupervisor003/embeddedchild002').replace('supervisor_bytes=51489','supervisor_bytes=53063')
z=s.encode();assert b!=z and b'3b6501c6c57dda314eb26c31dfd025e564997e09ac7ba073ca7077258dfb95a5' not in z
assert not os.path.lexists(R/'ROOT_I13_RETENTION_EXPORTER_API_SUPERVISOR_STATIC_SOURCE_QUALIFICATION_ADOPTION_001.json')
assert (dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
q=R/'adopt_retention_Source_qualification_and_prepare_handoff005_002.py'
with q.open('xb') as h:h.write(z);h.flush();os.fsync(h.fileno())
pin=lambda p,b:dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,author='/root',record_type='Root_qualification_adopter002_complete_uninvoked001_inverse',complete_predecessor=pin(p,b),complete_predecessor_base64=base64.b64encode(b).decode(),successor=pin(q,z),predecessor_invoked=False,delta='Only replace qualified supervisor002pin/text/summary with corrected003; child002/exporter016/API001 unchanged; all Source-only and execution holds remain.')
out=R/'ROOT_I13_QUALIFICATION_ADOPTER002_COMPLETE_UNINVOKED001_INVERSE_001.json';w=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(w);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b and q.read_bytes()==z and out.read_bytes()==w
print(json.dumps(dict(successor=pin(q,z),inverse=pin(out,w))))
