def save(name,v):
 shape(v);b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode();need(len(b)<=2097152,'own2MiB');fresh();p=R/name
 with p.open('xb') as h:need(h.write(b)==len(b),'wholeCreateNew');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'wholeReadback');return pin(p,b)
