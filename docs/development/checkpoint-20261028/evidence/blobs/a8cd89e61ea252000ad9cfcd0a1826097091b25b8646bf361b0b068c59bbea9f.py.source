def need(v,m):
 if not v:raise ValueError(m)
def raw(p):
 p=Path(p)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'direct nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded regular singlelink metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(k(a)==k(d)==k(e)==k(z) and len(b)==a.st_size,'stable samebuffer');return b
def pin(p,b=None):
 if b is None:b=raw(p)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
 d={}
 for k,v in xs:need(k not in d,'duplicate JSON');d[k]=v
 return d
def bad(x):raise ValueError('noninteger/nonfinite own metadata JSON')
def shape(v):
 t=[(v,0)];n=0
 while t:
  x,d=t.pop();n+=1;need(n<=50000 and d<=48,'metadata shape');need(x is None or type(x) in (str,int,bool,list,dict),'builtin ownmetadata')
  if type(x) is str:need(not any(55296<=ord(c)<=57343 for c in x),'no surrogates')
  elif type(x) is list:t.extend((a,d+1) for a in x)
  elif type(x) is dict:
   need(all(type(k) is str for k in x),'string keys')
   for k,v in x.items():t.extend(((k,d+1),(v,d+1)))
def doc(p,expected=None):
 b=raw(p);f=pin(p,b)
 if expected:need(f==expected,'exact fact3')
 v=json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad);shape(v);return v,f
def fact(p,n,sha):return dict(path=str(p),bytes=n,sha256=sha)
