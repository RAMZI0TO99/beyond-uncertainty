"""Add exact closed API/supervisor interface binding; preserve whole uninvoked001."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
p=R/'adopt_Source008_and_retention_protocol_for_Source_only_001.py';b=p.read_bytes()
q=R/'adopt_Source008_and_retention_protocol_for_Source_only_002.py'
marker=b"held=('existing_target_kernel_Source_authoring_admitted'"
insert=b"ifp=dict(path=str(R/'I13_RETENTION_EXPORTER_API_AND_HELD_SUPERVISOR_SOURCE_CONTRACT_001.json'),bytes=9397,sha256='2b3791a36225800aea34b452c0e58a6efe411b2a876cc5b9f7f3a64029a67ca4')\niface,_=doc(ifp['path'],ifp);need(iface['basis_contract']==contractpin and iface['capture_admitted'] is False and iface['all_execution_gates_held'] is True and len(iface['exporter_API_literals']['keyword_only_parameters'])==7,'exact closed inert API and held supervisor Source contract')\nneed(reviewed.get(ifp['path'])==ifp,'closed interface decisions genuinely reviewed')\n"
a=b"contract_design_adoption=cap,contract_schema=contract['schema']"
z=b"contract_design_adoption=cap,Source_interface_contract=ifp,contract_schema=contract['schema']"
assert len(b)==8338 and hashlib.sha256(b).hexdigest()=='00cba93aff3707f95839f417bd4d2e902b12d0e27cd966bcccb4db5aaa17c1e1' and b.count(marker)==b.count(a)==1
new=b.replace(marker,insert+marker).replace(a,z)
assert not os.path.lexists(R/'ROOT_I13_SOURCE_SCOPE008_AND_RETENTION_PROTOCOL_SOURCE_ONLY_ADOPTION_001.json')
assert (dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
with q.open('xb') as h:h.write(new);h.flush();os.fsync(h.fileno())
pin=lambda p,b:dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,record_type='Root_Source008_adopter002_whole_uninvoked001_inverse_and_interface_binding',author='/root',complete_predecessor=pin(p,b),complete_predecessor_base64=base64.b64encode(b).decode(),successor=pin(q,new),predecessor_invoked=False,delta='Only add strict complete pin join to the newly fixed closed inert API/held supervisor Source-interface contract, require its genuine review, and retain it in Rootadoption. All Source-only/capture/execution gates unchanged.')
out=R/'ROOT_SOURCE008_ADOPTER002_COMPLETE_UNINVOKED001_INVERSE_001.json';w=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(w);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b and q.read_bytes()==new and out.read_bytes()==w
print(json.dumps(dict(successor=pin(q,new),inverse=pin(out,w))))
