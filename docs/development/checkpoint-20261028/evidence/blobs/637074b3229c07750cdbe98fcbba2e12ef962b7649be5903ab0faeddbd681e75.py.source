def need(v,m):
 if not v:raise ValueError(m)
def raw(p):
 p=Path(p)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'direct nonreparse metadata lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded singlelink saved metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(k(a)==k(d)==k(e)==k(z) and len(b)==a.st_size,'stable exactsamebuffer');return b
def pin(p,b=None):
 if b is None:b=raw(p)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
 d={}
 for k,v in xs:need(k not in d,'duplicate JSON');d[k]=v
 return d
class FractionalToken(str):pass
def fractional(s):
 need(len(s)<=128,'bounded original numeric token');d=Decimal(s);need(d.is_finite() and abs(d.adjusted())<=100,'bounded finite original decimal');return FractionalToken(s)
def bad(x):raise ValueError('nonfinite JSON')
def shape(v,original=False):
 t=[(v,0)];n=0
 while t:
  x,d=t.pop();n+=1;need(n<=50000 and d<=48,'metadata shape cap')
  need(x is None or type(x) in (str,int,bool,list,dict) or original and type(x) is FractionalToken,'bounded metadata type')
  if isinstance(x,str):need(not any(55296<=ord(c)<=57343 for c in x),'no surrogates')
  elif type(x) is list:t.extend((a,d+1) for a in x)
  elif type(x) is dict:
   need(all(type(k) is str for k in x),'string keys')
   for k,v in x.items():t.extend(((k,d+1),(v,d+1)))
