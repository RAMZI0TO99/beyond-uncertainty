"""Root adopts exact reviewed packaging selection; grants no bundle execution."""
import datetime as dt, hashlib, json
from pathlib import Path
R=Path(__file__).parent
def pin(p):
 b=p.read_bytes(); assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p): return json.loads(p.read_bytes())
def occurs(v,p):
 return v==p or (type(v) is dict and any(occurs(x,p) for x in v.values())) or (type(v) is list and any(occurs(x,p) for x in v))
p=R/'I13_EXACT_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json'; plan=load(p); assert pin(p)['sha256']=='ee248717db124b607daff4884aae765ccdba995d7ed159fb31521c209abe0fa4'
cp=R/'helper_bundle_plan_Source_review_001/INDEPENDENT_I13_HELPER_BUNDLE_PACKAGING_PLAN_SOURCE_CAPSULE_001.json'; c=load(cp); assert pin(cp)['sha256']=='d620a8bce98d57c32032a91abde125432c91a10b790f673da1f24d821d78f781'
fp=Path(c['full_review']['path']); f=load(fp); assert pin(fp)==c['full_review']
for v in (c,f):
 assert v['reviewer']=='/root/project_architecture' and v['verdict']=='PASS_SOURCE_PLAN_ONLY_NO_PACKAGING_MUTATION' and v['checks_passed']==1004 and v['checks_failed']==0
 assert len(v['checks'])==len({x['name'] for x in v['checks']})==1004 and all(x['passed'] is True for x in v['checks'])
 assert occurs(v,pin(p)) and all(v[k] is False for k in ('target_execution','tests_executed','operational_authority','scientific_authority','actual_family_publication'))
assert c['actual_bundles_created'] is False and f['no_actual_bundles_created'] is True
for m in plan['members']: assert pin(Path(m['path']))==m
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'; s=load(scope); now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(s['interval_start'])<=now and (dt.datetime.fromisoformat(s['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_exact_helper_Source_bundle_plan_different_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_HELPER_SOURCE_BUNDLE_SELECTION_PLAN_ONLY',Source_scope=pin(scope),packaging_plan=pin(p),different_Source_review=pin(cp),full_review=pin(fp),checks_passed=1004,checks_failed=0,member_count=160,member_bytes=1353151,maximum_copy_rows=512,maximum_payload_bytes=67108864,maximum_metadata_file_bytes=2097152,actual_bundles_created=False,later_helper_bundle_candidate_and_creation_reviews_required=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
out=R/'ROOT_I13_EXACT_HELPER_SOURCE_BUNDLE_PLAN_DIFFERENT_REVIEW_ADOPTION_001.json'
with out.open('xb') as h: h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(out),bundles_created=False)))
