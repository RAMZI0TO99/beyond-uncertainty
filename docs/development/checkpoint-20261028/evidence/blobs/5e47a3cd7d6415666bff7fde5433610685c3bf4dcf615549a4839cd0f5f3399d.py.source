}
CACHE={}
CHECKS=[]

def require(v,m):
 if not v:raise ValueError(m)

def check(name,value,evidence):
 require(type(name) is str and name and name not in {x['name'] for x in CHECKS},'unique check name')
 CHECKS.append(dict(name=name,passed=value is True,evidence=evidence))
 require(value is True,'review finding: '+name)

def raw(p):
 p=Path(p)
 for q in (p,*p.parents):
  z=q.lstat();require(not q.is_symlink() and not getattr(z,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();require(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'ordinary singlelink bounded file')
 with p.open('rb') as h:
  d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();key=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 require(key(a)==key(d)==key(e)==key(z) and len(b)==a.st_size,'stable samebuffer read')
 return b

def fact(p,b):
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def load(p,expected=None,is_json=True):
 p=Path(p);b=raw(p);f=fact(p,b)
 if expected is not None:require(f==expected,'exact expected fact3')
 if str(p) in EXPECTED:require((len(b),f['sha256'])==EXPECTED[str(p)],'hardpinned subject')
 CACHE[str(p)]=b
 if not is_json:return b,f
 def pairs(xs):
  r={}
  for k,v in xs:require(k not in r,'duplicate JSON key');r[k]=v
  return r
 def bad(_):raise ValueError('noninteger or nonfinite JSON number')
 v=json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
 shape(v)
 return v,f

def shape(v):
 todo=[(v,0)];n=0;depth=0
 while todo:
  x,d=todo.pop();n+=1;depth=max(depth,d)
  require(n<=50000 and d<=48,'full key/value node/depth bounds')
  require(x is None or type(x) in (bool,int,str,list,dict),'builtin JSON value')
  if type(x) is str:require(not any(55296<=ord(c)<=57343 for c in x),'no surrogate text')
  elif type(x) is list:todo.extend((y,d+1) for y in x)
  elif type(x) is dict:
   require(all(type(k) is str for k in x),'builtin string keys')
   for k,y in x.items():todo.extend(((k,d+1),(y,d+1)))
 return dict(nodes=n,depth=depth)

s,sp=load(S);a,ap=load(A)
def fresh():
 n=dt.datetime.now(dt.timezone.utc)
 require(dt.datetime.fromisoformat(s['interval_start'])<=n and (dt.datetime.fromisoformat(s['interval_end'])-n).total_seconds()>60,'live Source009 strict greater-than-60 write reserve')
 require(raw(S)==CACHE[str(S)] and raw(A)==CACHE[str(A)],'unchanged current Source authority buffers')
 return n.isoformat()

