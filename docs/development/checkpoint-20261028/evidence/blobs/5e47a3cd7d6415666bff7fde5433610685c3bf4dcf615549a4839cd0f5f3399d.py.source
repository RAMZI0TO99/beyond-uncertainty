 str(S):(7516,'b04507102cc00306e99ce9992cd0a526da03101e7d972e79eed6d20aab354739'),
 str(A):(3543,'29dce6bd6b7767449b0bc28d8daeed1023581748d82be41d4eb82cabcf8804ab'),
 str(V):(15782,'8d1096fd36f45b6ae215ee9289091f39cf2eb8c1e4570079d2953aa735a9033d'),
 str(W):(10912,'1e6edd088986840f1d3d33b45ac7ea72cd79acdfaefe9706c7da277b65b4ee2b'),
