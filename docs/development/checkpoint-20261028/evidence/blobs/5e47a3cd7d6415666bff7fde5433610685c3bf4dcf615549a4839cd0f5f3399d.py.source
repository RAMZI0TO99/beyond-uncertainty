def save(name,value):
 shape(value);b=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');require(len(b)<=2097152,'own2MiB evidence cap');fresh()
 p=OUT/name
 with p.open('xb') as h:require(h.write(b)==len(b),'whole exclusive evidence write');h.flush();os.fsync(h.fileno())
 require(raw(p)==b,'evidence whole readback');return fact(p,b)

