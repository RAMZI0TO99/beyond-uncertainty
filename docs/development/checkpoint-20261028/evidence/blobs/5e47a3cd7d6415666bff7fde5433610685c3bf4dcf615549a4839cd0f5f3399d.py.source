check('genuine_refusal_actual_19_positive_3_failed',sum(x['passed'] is True for x in xs)==ic['checks_passed']==f['checks_passed']==19 and sum(x['passed'] is False for x in xs)==ic['checks_failed']==f['checks_failed']==3,'Counts recomputed from saved full proof.')
for k,value in [('source_only',True),('subject_execution_performed',False),('bootstrap_observation_executed',False),('native_helper_compiled_or_loaded',False),('native_queries_performed',False),('children_or_Jobs_launched',False),('observed_API_timeout_or_overrun',False),('peer_result_accepted',False),('physical_release_or_whole_host_quiet_accepted',False)]:
