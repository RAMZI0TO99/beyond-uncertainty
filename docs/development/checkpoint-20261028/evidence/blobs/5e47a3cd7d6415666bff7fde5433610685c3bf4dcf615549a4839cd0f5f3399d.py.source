check('Source009_shared_concurrency_caps',s['Pro2_max_including_Root']==a['Pro2_max_including_Root']==3 and s['Pro3_max_including_Root_and_reviewer']==a['Pro3_max_including_Root_and_reviewer']==2 and s['shared_max_including_both_roots_and_overlap']==a['shared_max_including_both_roots_and_overlap']==5,'No nested agents or new slots.')
