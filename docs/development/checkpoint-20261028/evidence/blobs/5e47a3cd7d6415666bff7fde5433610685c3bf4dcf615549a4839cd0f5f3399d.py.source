 'writer_current_UTC_strict_greater_than_60':"dt.datetime.now(dt.timezone.utc)" in segments['fresh'] and ".total_seconds()>60" in segments['fresh'] and "s['interval_start']" in segments['fresh'],
 'writer_complete_metadata_nodes_depth_keys':all(x in segments['shape'] for x in ('n<=50000 and d<=48','(bool,int,str,list,dict)','55296<=ord(c)<=57343','todo.extend(((k,d+1),(v,d+1)))')),
 'writer_save_cap_fresh_CreateNew_fsync_readback':all(x in segments['save'] for x in ("len(b)<=2097152","fresh();p=R/name","p.open('xb')","h.write(b)==len(b)","os.fsync(h.fileno())","raw(p)==b")),
 'writer_exact_refusal_actor_scope_counts':all(x in wt for x in ("ic['reviewer']==full['reviewer']=='/root/i13_final_review'","ic['scope']==full['scope']==sp","ic['checks_passed']==full['checks_passed']==19","ic['checks_failed']==full['checks_failed']==3")),
 'writer_refusal_and_peer_rehashed_before_modes':all(x in wt for x in ("findings==full['remaining_actionable_findings']","len(findings)==3","len(ic['reviewed_artifacts'])==4","for p in peerpins:need(pin(p['path'])==p")),
 'writer_explicit_modes_and_arity':all(x in wt for x in ("sys.argv[1] in ('prepare','adopt')","len(sys.argv)==2","len(sys.argv)==4")),
 'writer_review_capsule_path_and_wholeSHA':all(x in wt for x in ("cp.is_relative_to(R/'decision_creation_different_review_001')","cf['sha256']==sys.argv[3]","doc(c['full_proof']['path'],c['full_proof'])")),
 'writer_review_independent_role_allclear':all(x in wt for x in ("c['reviewer']==f['reviewer']=='/root/project_architecture'","c['verdict']==f['verdict']","startswith('PASS_')","c['remaining_actionable_findings']==f['remaining_actionable_findings']==[]")),
 'writer_review_unique_nonempty_fullchecks':all(x in wt for x in ("type(xs) is list and len(xs)>0","type(x['name']) is str and x['name']","len({x['name'] for x in xs})","c['checks_failed']==f['checks_failed']==0","all(x['passed'] is True for x in xs)")),
 'writer_review_same_scope_roster_and_currentpins':all(x in wt for x in ("c['scope']==f['scope']==sp","c['reviewed_artifacts']==f['reviewed_artifacts']","Path(p['path']).is_relative_to(R) and pin(p['path'])==p")),
