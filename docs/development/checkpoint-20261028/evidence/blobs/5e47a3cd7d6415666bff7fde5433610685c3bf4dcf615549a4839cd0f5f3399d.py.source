 'writer_stable_singlelink_nonreparse_read':all(x in segments['raw'] for x in ('st_nlink==1','st_file_attributes','os.fstat','key(a)==key(d)==key(e)==key(z)','h.read(2097153)')),
 'writer_samebuffer_fact_and_strict_JSON':all(x in segments['doc'] for x in ('b=raw(p);f=pin(p,b)','object_pairs_hook=pairs','parse_float=bad','parse_constant=bad')),
