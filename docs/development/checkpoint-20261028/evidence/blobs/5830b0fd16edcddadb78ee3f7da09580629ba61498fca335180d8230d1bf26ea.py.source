"""Root retains a peer report, without adopting peer execution or absence claims."""
import hashlib,json
from pathlib import Path
from datetime import datetime,timezone
root=Path(__file__).parent
out=root/'ROOT_RETAINED_PRO3_008_FAILED_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'
assert not out.exists()
value={
 'schema_version':1,'record_type':'Root_retained_peer_failed_integration_full_custody_release_report_only','author':'/root','created_utc':datetime.now(timezone.utc).isoformat(),
 'source_thread':'01a171ac-fe4f-71c0-b078-f9c56c579f08','grant':'008','reported_job':'20261025T105030Z_3e3ac9171a',
 'reported_outcome':'FAILED_HARD600_ATTEMPT_DEADLINE','reported_deadline_utc':'2026-10-25T11:00:30.300421+00:00','reported_normal_exit_zero':False,
 'reported_cleanup':{'owned_termination':True,'closed_empty':True,'process_and_thread_handles_closed':True,'cleanup_or_sampling_errors':False,'guard_and_launcher_reaped':True,'outstanding_owned_children':0,'native_absence_observed_utc':'2026-10-25T11:01:24+00:00'},
 'reported_successful_stdlib_closeout_invoked':False,'reported_accepted_integration_result':False,'reported_qualification':False,'reported_terminal':False,
 'reported_post_backend_ledger':None,'reported_post_backend_state':'incomplete_unknown; no zero or success inference',
 'reported_partial_artifacts':['current-execution','restore witness','target witness','outer attestation'],
 'reported_failure_audit':{'path':r'D:\Aenv\pro3\runs\coordination\cho51_provenance_numerical_worker_20261025_v5\failed-attempt-native-audit_integration_001.json','sha256':'e92080155a3025ee494821c0c85305f5f72e753318a6a6e2771e95c699919808'},
 'reported_lease_closeout':r'D:\Aenv\pro3\runs\coordination\cho51_provenance_numerical_worker_20261025_v5\lease-closeout_integration_001.json',
 'reported_full_compute_custody_released':True,'grant_consumed_closed':True,'retry_or_second_Job_authority':False,
 'reported_next_scope':'Root plus one Source-only performance investigation; no candidate, tests, model or recovery replay under008. Fresh reviewed pins/request/grant required for any successor; original600 and caps unchanged.',
 'Root_acceptance':{'peer_result_accepted':False,'independent_physical_absence_proved':False,'whole_host_quiet_claimed':False,'report_retained':True,'new_peer_grant_issued':False,'Pro2_new_pure_test_admission':False,'Pro2_actual_family_Native8_Parser_runtime_science_admission':False},
 'target_execution':False,'operational_authority':False,'scientific_authority':False
}
raw=(json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
with out.open('xb') as h:assert h.write(raw)==len(raw)
print(json.dumps({'path':str(out),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}))
