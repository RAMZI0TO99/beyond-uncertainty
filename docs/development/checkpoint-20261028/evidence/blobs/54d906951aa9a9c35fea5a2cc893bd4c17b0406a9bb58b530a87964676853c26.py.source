"""Root exact compact SourceSet4 review adoption; no subject import or invocation."""
import ast,datetime as dt,hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def direct(v,p):
 s=v['subjects'];return p in(list(s.values())if type(s)is dict else s)
assert len(sys.argv)>=3 and len(sys.argv)%2==1
reviews=[]
for i in range(1,len(sys.argv),2):
 cp=Path(sys.argv[i]);assert pin(cp)['sha256']==sys.argv[i+1];c=load(cp);link=c.get('full_proof',c.get('full_review'));fp=Path(link['path']);assert pin(fp)==link;f=load(fp)
 for v in(c,f):
  assert v['reviewer']in('/root/i13_final_review','/root/project_architecture')and v['verdict'].startswith('PASS_')and v['checks_failed']==0
  assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
 assert c['checks_passed']==f['checks_passed']==len(f['checks'])==len({x['name']for x in f['checks']})and all(x['passed']is True for x in f['checks'])
 reviews.append((cp,c,fp,f))
sup=C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_011.py';tree=ast.parse(sup.read_bytes());constants={n.targets[0].id:ast.literal_eval(n.value)for n in tree.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id in('SOURCES','APIS','FIXTURES','CATALOGUE','PARTITION_PLAN')};assert len(constants)==5
control=R/'prepare_I13_bounded_partition_once_admission_001.py';composition=T/'current_owner_M3_peer_held_composition_006.py';api=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_006.json'
critical=[*constants['SOURCES'].values(),*constants['APIS'].values(),*constants['FIXTURES'].values(),constants['CATALOGUE'],constants['PARTITION_PLAN'],pin(sup),pin(control),pin(composition),pin(api)]
arch_owned=critical[:9];Root_owned=critical[9:]
assert len(arch_owned)==9 and len(Root_owned)==5
for p in critical:assert pin(p['path'])==p,p['path']
for p in arch_owned:assert any(c['reviewer']=='/root/i13_final_review'and direct(c,p)and direct(f,p)for _,c,_,f in reviews),p['path']
for p in Root_owned:assert any(c['reviewer']in('/root/project_architecture','/root/i13_final_review')and direct(c,p)and direct(f,p)for _,c,_,f in reviews),p['path']
assert all(p['bytes']<=65536 for p in constants['SOURCES'].values())and pin(composition)['bytes']<=65536
plan=load(constants['PARTITION_PLAN']['path']);names=sum([x['case_names']for x in plan['partitions']],[]);assert len(plan['partitions'])==30 and len(names)==len(set(names))==936 and hashlib.sha256(('\n'.join(names)+'\n').encode()).hexdigest()=='995ee1ae8d18c2b3093d4f6ff6e9835321ce5da9cff4c6a388a94d5018250f72'
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';now=dt.datetime.now(dt.timezone.utc);assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-now).total_seconds()>60
previous=C/'ROOT_I13_ONCE007_DIFFERENT_SAVED_PARTITION_RESULT_ADOPTION_001.json';pv=load(previous);assert pv['own_parent_and_owned_child_custody_closed']is True and pv['claim_reuse_or_replay_authorized']is False
base=R/'ROOT_I13_FINAL_PROTOCOL007_RECORDED_CONTEXT_DIFFERENT_REVIEW_ADOPTION_004.json';compact=R/'ROOT_I13_COMPACT_DESCRIPTOR_GRAMMAR002_AND_JOINT_EVENT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'
assert pin(compact)['sha256']=='cb93db3e12f1a2b56a2b81162fb9259d9bf0d1d32fa5c534420cc0dc7a5ffefe'
v=dict(schema_version=1,record_type='Root_I13_exact_corrective_bounded_compact_partition_Source_set_different_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_COMPACT_BOUNDED_PARTITION_SOURCE_SET_ONLY',Source_scope=pin(scope),protocol_adoption=pin(base),compact_descriptor_protocol_adoption=pin(compact),previous_consumed_adoption=pin(previous),subjects=critical,review_adoptions=[dict(reviewer=c['reviewer'],capsule=pin(cp),full_proof=pin(fp),checks_passed=c['checks_passed'],checks_failed=0)for cp,c,fp,f in reviews],Source_review_ownership='All nine architecture-owned kernels/APIs/fixtures/catalogue require independent final_review direct coverage. The five Root-owned composition/API/plan/supervisor/admission-control pins require independent architecture or final_review direct coverage. No author accepts its own Source.',partition_count=30,original_case_count=936,Source_only=True,automatic_partition_invocations_admitted=False,fresh_exact_once_scope_required_per_partition=True,all_original_caps_and_execution_holds_unchanged=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
out=C/'ROOT_I13_BOUNDED_PARTITION_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_005.json'
with out.open('xb')as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
cfg=dict(supervisor=pin(sup),Source_adoption=pin(out),previous_consumed_adoption=pin(previous),peer_release_report=pin(R/'coordination/ROOT_RETAINED_PRO3_012_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'))
q=C/'I13_BOUNDED_PARTITION_ONCE_ADMISSION_INPUT_004.json'
with q.open('xb')as h:h.write((json.dumps(cfg,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(out),admission_configuration=pin(q),source_subjects=len(critical),tests_admitted=False)))
