SCOPE_KEYS = ('schema_version', 'record_type', 'author', 'created_utc', 'interval_start', 'interval_end', 'operation', 'maximum_snapshot_invocations', 'source_scope', 'protocol_adoption', 'source_adoption', 'modules', 'APIs', 'catalogue', 'fixture', 'supervisor', 'runtime', 'prelaunch', 'outputs', 'budgets', 'target_execution', 'operational_authority', 'scientific_authority', 'actual_family_publication', 'role_plan', 'role_group_id')
