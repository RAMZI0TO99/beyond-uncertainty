"""Fixed one-use data-only input snapshot supervisor. Unrun pending exact Source admission."""
import datetime as dt
import hashlib,types,json,os,re,subprocess,sys,threading,time
from pathlib import Path

def need(ok, message):
    if not ok:
        raise ValueError(message)

def wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode('utf8')

def utc():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')

def pairs(items):
    result = {}
    for k, v in items:
        need(k not in result, 'duplicate JSON name')
        result[k] = v
    return result

def bad_number(value):
    raise ValueError('non-integer JSON number')

def decode(raw):
    return json.loads(raw.decode('utf8'), object_pairs_hook=pairs, parse_float=bad_number, parse_constant=bad_number)

def ordinary(path, file=True):
    path = Path(path)
    need(path.is_absolute() and '..' not in path.parts, 'absolute ordinary path')
    for parent in reversed(path.parents):
        info = parent.lstat()
        need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary parent')
    if file:
        info = path.lstat()
        need(path.is_file() and not path.is_symlink() and info.st_nlink == 1 and
             not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary single-link file')
    return path

def read_pin(pin, cap=2097152):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'} and
         type(pin['bytes']) is int and 0 < pin['bytes'] <= cap and type(pin['sha256']) is str and
         re.fullmatch('[0-9a-f]{64}', pin['sha256']) is not None, 'exact bounded positive pin')
    path = ordinary(pin['path'])
    before = path.stat()
    with path.open('rb') as handle:
        first = handle.read(cap + 1)
        handle.seek(0)
        second = handle.read(cap + 1)
        fd = os.fstat(handle.fileno())
    after = path.stat()
    names = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')
    vector = lambda value: tuple(getattr(value, name, None) for name in names)
    need(vector(before) == vector(after) and all(getattr(fd, k, None) == getattr(after, k, None)
         for k in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')), 'owned input changed')
    need(first == second and len(first) == pin['bytes'] and hashlib.sha256(first).hexdigest() == pin['sha256'], 'whole bytes pin')
    return first

def read_limited(path, cap=2097152):
    path = ordinary(path)
    with path.open('rb') as handle:
        raw = handle.read(cap + 1)
    need(0 < len(raw) <= cap, 'bounded metadata input')
    return raw

def fact(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def occurs(value, pin):
    if type(value) is dict:
        if set(value) == {'path', 'bytes', 'sha256'} and all(type(value[k]) is type(v) and value[k] == v for k, v in pin.items()):
            return True
        return any(occurs(v, pin) for v in value.values())
    return type(value) is list and any(occurs(v, pin) for v in value)

def write_new(path, body):
    need(type(body) is bytes and len(body) <= 2097152, 'bounded owned output')
    path = ordinary(path, False)
    need(not os.path.lexists(path), 'exclusive absent owned output')
    with path.open('xb') as handle:
        need(handle.write(body) == len(body), 'whole owned output')
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path, body)

