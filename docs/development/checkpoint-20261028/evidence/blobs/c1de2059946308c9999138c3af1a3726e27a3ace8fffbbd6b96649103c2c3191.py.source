"""Own review metadata successor: explicit source_only field, no subject reread/call."""
from pathlib import Path
import datetime as dt,hashlib,json,os
D=Path(__file__).parent
def fp(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
 d={}
 for k,v in xs:assert k not in d;d[k]=v
 return d
def bad(x):raise ValueError(x)
def parse(b):return json.loads(b.decode('ascii'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
oldf=D/'INDEPENDENT_PRO3_BOOTSTRAP001_STATIC_REQUEST_REFUSAL_FULL_PROOF_001.json';fb=oldf.read_bytes();assert fp(oldf,fb)['sha256']=='06916e41d43218d673093b9926a7a443a7511c62075cf184d42629b1286a5338'
oldc=D/'INDEPENDENT_PRO3_BOOTSTRAP001_STATIC_REQUEST_REFUSAL_CAPSULE_001.json';cb=oldc.read_bytes();assert fp(oldc,cb)['sha256']=='0196286ed7277a25979301dd75bdd85859410abc1c99c8f390ed1780beabba8e'
full=parse(fb);cap=parse(cb);assert cap['full_proof']==fp(oldf,fb)
for v in(full,cap):
 v['source_only']=True;v['observed_API_timeout_or_overrun']=False;v['deadline_finding_is_static_control_flow_only']=True
 v['prior_review_metadata']=[fp(oldf,fb),fp(oldc,cb)]
 v['metadata_successor_reason']='Add explicit lowercase source_only compatibility field requested by Root; same19positive/3blocking checks, fourpeerpins and Source009 scope. NoSourcefinding/decision changed, no empirical timeout or APIoverrun claimed.'
def nd(v,d=0):
 if type(v)is dict:
  xs=[nd(x,d+1)for x in v.values()];return 1+len(v)+sum(x[0]for x in xs),max([d]+[x[1]for x in xs])
 if type(v)is list:
  xs=[nd(x,d+1)for x in v];return 1+sum(x[0]for x in xs),max([d]+[x[1]for x in xs])
 return 1,d
end=dt.datetime.fromisoformat('2026-10-27T16:30:00+00:00')
def write(n,v):
 assert(end-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
 assert oldf.read_bytes()==fb and oldc.read_bytes()==cb
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');nn,dd=nd(v);assert len(b)<=2097152 and nn<=50000 and dd<=48;p=D/n
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert p.read_bytes()==b;return fp(p,b)
f=write('INDEPENDENT_PRO3_BOOTSTRAP001_STATIC_REQUEST_REFUSAL_FULL_PROOF_002.json',full)
cap['full_proof']=f
c=write('INDEPENDENT_PRO3_BOOTSTRAP001_STATIC_REQUEST_REFUSAL_CAPSULE_002.json',cap)
print(json.dumps(dict(checks_passed=19,checks_failed=3,capsule=c,full_proof=f)))
