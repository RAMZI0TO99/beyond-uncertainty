"""Root retains a correction to the peer report; no peer result is adopted."""
import hashlib,json
from pathlib import Path
from datetime import datetime,timezone
root=Path(__file__).parent
out=root/'ROOT_RETAINED_PRO3_008_PARTIAL_TERMINAL_CORRECTION_REPORT_002.json'
assert not out.exists()
audit=Path(r'D:\Aenv\pro3\runs\coordination\cho51_provenance_numerical_worker_20261025_v5\failed-attempt-native-audit_integration_002.json')
raw_audit=audit.read_bytes()
assert 0<len(raw_audit)<=2097152
prior=root/'ROOT_RETAINED_PRO3_008_FAILED_INTEGRATION_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'
raw_prior=prior.read_bytes()
value={'schema_version':1,'record_type':'Root_retained_peer_partial_terminal_precision_correction_only','author':'/root','created_utc':datetime.now(timezone.utc).isoformat(),
 'source_thread':'01a171ac-fe4f-71c0-b078-f9c56c579f08','grant':'008',
 'unchanged_original_report':{'path':str(prior),'bytes':len(raw_prior),'sha256':hashlib.sha256(raw_prior).hexdigest()},
 'reported_correction':'The prior report phrase no terminal meant no accepted integration terminal. Peer now reports physical engineering intent and success files had been published before the hard600 timeout, during post-pipeline verification/finalization.',
 'reported_partial_files':[{'kind':'engineering_intent','bytes':461},{'kind':'engineering_success','bytes':454}],
 'reported_partial_file_parent':r'D:\Aenv\pro3\runs\coordination\cho51_provenance_numerical_worker_20261025_v5\i1\fixture\runs\phase2\lifecycle',
 'reported_partial_publication_utc':'2026-10-25T10:59:35+00:00',
 'reported_failure_audit_supplement':{'path':str(audit),'bytes':len(raw_audit),'sha256':hashlib.sha256(raw_audit).hexdigest()},
 'reported_job_still_failed':True,'reported_accepted_integration_result':False,'reported_qualification':False,'reported_native_exit_zero':False,
 'reported_post_backend_counts':None,'reported_post_backend_state':'incomplete_unknown','reported_full_custody_release_unchanged':True,'grant_consumed_closed':True,
 'retry_recovery_or_second_Job_authority':False,'Root_peer_result_accepted':False,'Root_independent_physical_terminal_verification':False,'whole_host_quiet_claimed':False,
 'target_execution':False,'operational_authority':False,'scientific_authority':False}
raw=(json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
with out.open('xb') as h:assert h.write(raw)==len(raw)
print(json.dumps({'path':str(out),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}))
