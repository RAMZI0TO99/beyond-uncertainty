"""Root exact saved-partition evidence adoption; never runs any subject."""
import datetime as dt,hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def direct(v,p):
 s=v['subjects'];return p in(list(s.values())if type(s)is dict else s)
assert len(sys.argv)==4;number=int(sys.argv[1]);cp=Path(sys.argv[2]);assert pin(cp)['sha256']==sys.argv[3]
c=load(cp);fp=Path(c['full_proof']['path']);f=load(fp);assert pin(fp)==c['full_proof']
for v in(c,f):
 assert v['reviewer']=='/root/i13_final_review' and v['verdict'].startswith('PASS_') and v['checks_failed']==0
 assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
assert c['checks_passed']==f['checks_passed']==len(f['checks'])==len({x['name']for x in f['checks']})and all(x['passed']is True for x in f['checks'])
o=C/('owned_memory_runs/attempt%03d'%number);rp=o/'SUPERVISOR_RESULT_001.json';s=load(rp);wp=C/('ROOT_I13_ONCE%03d_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json'%number);w=load(wp)
assert direct(c,pin(rp))and direct(f,pin(rp))and direct(c,pin(wp))and direct(f,pin(wp))
assert s['reaped']is s['streams_drained']is True and all(s['actual_stream_EOF'].values())and all(x is None for x in s['stream_pump_errors'].values())and s['custody_error']is None
assert s['diagnostic_complete_case_catalogue_valid']is True and s['child_result_absent']is False and s['acceptance_elapsed_nanoseconds']<=60000000000
sc=load(s['scope']['path']);assert pin(sc['outputs']['child_result'])==s['child_result']['pin'];child=load(sc['outputs']['child_result']);assert child==s['child_result']['value']
plan=load(sc['partition_plan']['path']);row=next(x for x in plan['partitions']if x['partition_id']==sc['partition_id'])
assert [x['name']for x in child['cases']]==row['case_names']and len(child['cases'])==row['case_count']and child['passed']+child['failed']==len(child['cases'])
assert child['failed']==len(child['failures'])==s['diagnostic_failure_count'] and s['exit_code']==0
passed=child['failed']==0
assert s['acceptance_at_record_preparation']is passed and w['Root_observed_tool_exit_code']==(0 if passed else 1)and w['retained_console_value']['accepted']is passed
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';now=dt.datetime.now(dt.timezone.utc);assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_different_saved_partition_result_and_cleanup_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_ONCE%03d_SAVED_PARTITION_DIAGNOSTICS_AND_OWNED_CLEANUP_ONLY'%number,Source_scope=pin(scope),different_saved_results_review=pin(cp),full_proof=pin(fp),supervisor_result=pin(rp),parent_tool_witness=pin(wp),consumed_scope=s['scope'],claim=s['claim'],partition_plan=sc['partition_plan'],partition_id=sc['partition_id'],Source_set_adoption=sc['source_adoption'],modules=sc['modules'],APIs=sc['APIs'],fixtures=sc['fixtures'],catalogue=sc['catalogue'],case_count=row['case_count'],passed=child['passed'],failed=child['failed'],partition_complete_all_pass=passed,complete_diagnostics_retained=True,complete_whole936_suite_pass=False,own_parent_and_owned_child_custody_closed=True,claim_reuse_or_replay_authorized=False,new_scope_automatically_admitted=False,actual_family_publication=False,Native8_Parser_runtime_science_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_or_physical_PID_absence_accepted=False)
out=C/('ROOT_I13_ONCE%03d_DIFFERENT_SAVED_PARTITION_RESULT_ADOPTION_001.json'%number)
with out.open('xb')as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(out),partition_id=sc['partition_id'],passed=child['passed'],failed=child['failed'],whole936_pass=False)))
