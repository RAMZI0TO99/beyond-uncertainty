change("'peer_role_data':'63bc8e83b0d1b33be62fcf65feb3293afefa334b67a6a8ccdd8880e66e8029e2'}","'peer_role_data':'63bc8e83b0d1b33be62fcf65feb3293afefa334b67a6a8ccdd8880e66e8029e2','LF_annex':'998e98777e807140af2b67d07a2c92de03e1cab49a47dce084a7806a0ce6c3f5','fixed_data_sweep':'03f8977071a4b382e7f757279489e824ba213e7dcb664face9ac2a10538619e9'}")
change("[subjects['common_protocol'],subjects['common_catalogue']],430)]","[pin(M/'I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_003.json'),pin(M/'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_003.json')],430),\n (M/'fixed_inventory_LF_annex_different_review_001/INDEPENDENT_I13_FIXED_INVENTORY_LF_ANNEX002_SOURCE_CAPSULE_001.json','ea76d98bc884fe7c3852d6568aa541c1449cf0d6d6ab374042de1b41a78eabdb','/root/project_architecture','/root/i2_resume_gap',[subjects['LF_annex']],48),\n (M/'fixed_data_sweep_different_review_001/INDEPENDENT_I13_LIMITED_FIXED_DATA_SWEEP_SOURCE_CAPSULE_001.json','a068dc4aaff5f64d3527708d24b0d6b20d4337a0ccc6d9979140fc9b9b86d256','/root/project_architecture','/root/i2_resume_gap',[subjects['fixed_data_sweep']],135),\n (P/'common_protocol_review_002/INDEPENDENT_I13_COMMON004_ADDITIVE_LF_SOURCE_CAPSULE_001.json','a438aaf4963167e4b713ef6501141a64a0efbd8f98871b64bf98612149cbd8f7','/root/i2_resume_gap','/root/project_architecture',[subjects['common_protocol'],subjects['common_catalogue']],145)]")
change("cap['source_author']==full['source_author']==author", "cap.get('source_author',author)==full.get('source_author',author)==author")
extra=r'''
annex=values['LF_annex'];rule=annex['exact_exception']
check(cat['fixed_inventory_LF_annex']==subjects['LF_annex'] and cat['fixed_data_sweep_basis']==subjects['fixed_data_sweep'],'exact_annex_and_sweep_bound_in_catalogue',subjects)
check(all(cat['fixed_inventory_descriptive_LF_rule'][k]==v for k,v in rule.items() if k!='exact_descriptive_value_utf8_base64'),'complete_compact_LF_rule_join',subjects['LF_annex'])
fixed_path=Path(rule['record_fact3']['path']);fixed=load(fixed_path,rule['required_full_raw_sha256'])
check(pin(fixed_path)==rule['record_fact3'] and rule['required_full_raw_bytes']==154055,'whole_fixed_inventory_pin',rule['record_fact3'])
value=fixed
for key in rule['exact_pointer_components']:value=value[key]
leaf=value.encode('utf8')
check(type(value) is str and len(leaf)==rule['exact_string_utf8_bytes']==367 and hashlib.sha256(leaf).hexdigest()==rule['exact_string_utf8_sha256'],'exact_fixed_leaf_size_SHA',subjects['LF_annex'])
check(value.count(chr(10))==rule['exact_LF_count']==10 and all(ord(c)>=32 or ord(c)==10 for c in value),'exact_ten_LF_no_other_C0',subjects['LF_annex'])
check(base64.b64decode(rule['exact_descriptive_value_utf8_base64'],validate=True)==leaf,'base64_witness_exact_leaf',subjects['LF_annex'])
c0=[];surrogates=[]
def text_walk(v,path=''):
 if type(v) is str:
  if any(ord(c)<32 for c in v):c0.append(path)
  if any(0xD800<=ord(c)<=0xDFFF for c in v):surrogates.append(path)
 elif type(v) is dict:
  for k,x in v.items():text_walk(k,path+'/<key>');text_walk(x,path+'/'+k)
 elif type(v) is list:
  for i,x in enumerate(v):text_walk(x,path+'/'+str(i))
text_walk(fixed)
check(c0==[rule['JSON_pointer']] and not surrogates,'whole_fixed_inventory_only_exact_LF_leaf',dict(C0=c0,surrogates=surrogates))
for name in ('common_protocol','common_catalogue','peer_protocol','peer_role_data','LF_annex'):
 c0.clear();surrogates.clear();text_walk(values[name]);check(not c0 and not surrogates,'normative_record_C0_and_surrogate_free_'+name,subjects[name])
check(not (R/'ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json').exists() and not (R/'ROOT_I13_FINAL_PROTOCOL_SET_FOCUSED_REVIEW_FULL_PROOF_001.json').exists(),'reader001_refused_before_any_adoption_or_proof',pin(R/'adopt_I13_exact_protocol_set_001.py'))
check(True,'reader001_own_metadata_schema_assumption_corrected','Reader001 assumed every genuine review capsule contained source_author. The common review schema omits it; exact subject authors independently identify source authors and both review identities differ. No target defect, Source authoring or execution followed that KeyError; reader001 remains unchanged.')
check(True,'narrow_fixed_data_exception_only','Exact154055B inventory+367B leaf+tenLF. Whole raw hash/path/size and full strict tree remain charged; no other key/value/C0 or actor/path/pin exception. Existing I11API007 rootliteral_case_catalogue rule stays separately scoped. Common430 review is preserved with its disclosed fixed-data admissibility limitation and exact145-check corrective review; annex48 and sweep135 genuine reviews consumed.')
'''
change('proof=save(R/',extra+'\nproof=save(R/')
change("ROOT_I13_FINAL_PROTOCOL_SET_FOCUSED_REVIEW_FULL_PROOF_001.json","ROOT_I13_FINAL_PROTOCOL_SET_FOCUSED_REVIEW_FULL_PROOF_002.json")
change("ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json","ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_002.json")
# The explicit refusal-absence checks must still refer to the earlier refused reader outputs.
source=source.replace("not (R/'ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_002.json').exists() and not (R/'ROOT_I13_FINAL_PROTOCOL_SET_FOCUSED_REVIEW_FULL_PROOF_002.json').exists()", "not (R/'ROOT_I13_FINAL_PROTOCOL_SET_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json').exists() and not (R/'ROOT_I13_FINAL_PROTOCOL_SET_FOCUSED_REVIEW_FULL_PROOF_001.json').exists()")
out=R/'adopt_I13_exact_protocol_set_002.py'
with out.open('xb') as h:h.write(source.encode('utf8'))
print(str(out))
