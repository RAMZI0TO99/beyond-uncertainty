def _i13_omit_outer_input(b, label, birth_only=False):
    o=_Outer(b);target=o.p(label)
    if not birth_only:
        value=o.value('outer_purpose');value['inputs']=[x for x in value['inputs']if x['path']!=target['path']];o.rewrite('outer_purpose',value)
        for name in ('outer_purpose_full','outer_purpose_capsule','outer_purpose_adoption'):
            value=o.value(name);value['subjects']=[x for x in value['subjects']if x['path']!=target['path']]
            if 'subject_reviews'in value:value['subject_reviews']=[x for x in value['subject_reviews']if x['subject']['path']!=target['path']]
            o.rewrite(name,value)
        value=o.value('outer_publication');value['complete_input_postreads']=[x for x in value['complete_input_postreads']if x['path']!=target['path']];o.rewrite('outer_publication',value)
    value=o.value('outer_prewrite')
    if not birth_only:value['expected_inputs']=[x for x in value['expected_inputs']if x['path']!=target['path']]
    value['recorded_births_ns'].pop(target['path']);o.rewrite('outer_prewrite',value)
    o.b['packet']=o.row('outer_packet')['body'];o.b['mutable']=sorted(o.mutable);b.clear();b.update(copy.deepcopy(o.b))


def _i13_body_actor(b, label, field, item=None):
    o=_Outer(b);actor='/root/i13_raw_body_only_author';value=o.value(label)
    if item is None:value[field]=actor
    else:value[field][item]=actor
    o.rewrite(label,value)
    for name in ('outer_publisher_code_full','outer_publisher_code_capsule'):
        value=o.value(name);value['reviewer']=actor;o.rewrite(name,value)
    o.b['packet']=o.row('outer_packet')['body'];o.b['mutable']=sorted(o.mutable);b.clear();b.update(copy.deepcopy(o.b))


def _outer_make(role,m3,publisher,peer,catalogue_bytes):
    return _Outer(_make(role,peer,catalogue_bytes)).envelope('selected_peer_receipt27_v2',role,m3,publisher,peer)

def _outer_mutate(b,spec):
    variant=spec['variant']
    if variant in('child_roster','child_birth'):
        _i13_omit_outer_input(b,spec['label'],variant=='child_birth');return
    if variant=='raw_body_actor':
        _i13_body_actor(b,spec['label'],spec['field']);return
    if variant=='author_receipt':
        b['packet']=_row(b,'receipt')['body'];return
    if variant=='record_alias':
        row=copy.deepcopy(b['records'][0]);row['pin']['path']=row['pin']['path'][:3]+row['pin']['path'][3:].swapcase();b['records'].append(row);return
    if variant=='record_count':
        while len(b['records'])<257:
            row=copy.deepcopy(b['records'][0]);row['pin']=_pin(_OW_HOME+chr(92)+'over_record_'+str(len(b['records']))+'.data',row['body']);b['records'].append(row)
        return
    outer=_Outer(b)
    if variant=='old_prewrite':
        value=outer.value('outer_prewrite');value.pop('recorded_evaluation_utc');value['record_type']='Root_owner_v2_selected_role_prewrite_metadata_packet';outer.rewrite('outer_prewrite',value)
    elif variant=='old_publication':
        value=outer.value('outer_publication');value.pop('prewrite_packet');value['record_type']='Root_owner_v2_selected_role_Source_metadata_canonical_publication';outer.rewrite('outer_publication',value)
    elif variant=='publication_context':
        value=outer.value('outer_publication');value['prewrite_packet']=outer.p('owner');outer.rewrite('outer_publication',value)
    elif variant=='request_receipt':
        value=outer.value('outer_request');value['author_receipt']=outer.p('decision');outer.rewrite('outer_request',value)
    elif variant=='packet_role':
        value=outer.value('outer_packet');value['role']='pipeline_peer';outer.rewrite('outer_packet',value)
    elif variant in ('packet_extra','packet_nodes'):
        value=outer.value('outer_packet');value['unexpected_field']=[0]*50000 if variant=='packet_nodes'else False;outer.rewrite('outer_packet',value)
    elif variant=='prewrite_UTC7':
        value=outer.value('outer_prewrite');value['recorded_evaluation_utc']='2026-10-25T11:00:24.0000001+00:00';outer.rewrite('outer_prewrite',value)
    else:raise AssertionError('unowned outer variant '+variant)
    outer.b['packet']=outer.row('outer_packet')['body'];outer.b['mutable']=sorted(outer.mutable)
    b.clear();b.update(copy.deepcopy(outer.b))

def _outer_assert_result(raw,b,spec,catalogue_bytes,prewrite):
    assert type(raw)is bytes
    view=_json(raw);fields=_json(catalogue_bytes)['schemas']['result54']['fields']
    assert type(view)is dict and set(view)==set(fields)and len(view)==54
    for key,rule in fields.items():
        if type(rule)is dict and 'literal'in rule:assert type(view[key])is type(rule['literal'])and view[key]==rule['literal'],key
    assert view['validator']==('selected_role_prewrite'if prewrite else'selected_role_canonical_dependency')
    assert view['author_kind']=='selected_peer_receipt27_v2'and view['role']==spec['role']
    assert view['packet']==_row(b,'outer_prewrite'if prewrite else'outer_packet')['pin']
    assert view['author_packet']==_row(b,'wrapper')['pin']and view['author_receipt']==_row(b,'receipt')['pin']
    assert view['request']==_row(b,'outer_request')['pin']and view['producer_Source']==_json(_row(b,'wrapper')['body'])['producer_support']['Source']
    assert type(view['record_count'])is int and view['record_count']==len(b['records'])
    assert type(view['total_record_bytes'])is int and view['total_record_bytes']==sum(len(row['body'])for row in b['records'])
    assert type(view['charged_metadata_nodes'])is int and 0<view['charged_metadata_nodes']<=50000
    assert view['validated_now_utc']==b['now_utc']
    if prewrite:assert view['canonical']is None and view['publication']is None and view['reconciliation']is None
    else:assert view['canonical']==_row(b,'outer_canonical')['pin']and view['publication']==_row(b,'outer_publication')['pin']and view['reconciliation']==_row(b,'outer_reconciliation')['pin']

def _outer_case(spec,m3,publisher,peer,catalogue_bytes,seal):
    expected=spec['expected_error']
    if spec['handler']=='outer_held':
        flag=publisher.ACTUAL_ENTRY_QUALIFIED
        try:
            publisher.ACTUAL_ENTRY_QUALIFIED=spec['flag']
            try:publisher.publish_selected_role_current_owner(context=_Hostile())
            except publisher.I13MetadataError as error:assert error.code==expected
            else:raise AssertionError('actual publisher unexpectedly returned')
        finally:publisher.ACTUAL_ENTRY_QUALIFIED=flag
        return
    b=_outer_make(spec['role'],m3,publisher,peer,catalogue_bytes)
    assert not(_mutable_ids(b)&_mutable_ids(FIXED))and not(_mutable_ids(b)&_mutable_ids(CASE_CATALOGUE))
    variant=spec['variant']
    if variant=='isolation':
        sibling=_outer_make(spec['role'],m3,publisher,peer,catalogue_bytes)
        assert not(_mutable_ids(b)&_mutable_ids(sibling))
        saved=_fingerprint(sibling);before=_fingerprint(b);_row(b,'outer_request')['pin'].pop('path')
        assert _fingerprint(b)!=before and _fingerprint(sibling)==saved and _seal()==seal
        return
    prewrite=variant=='prewrite_positive'
    if prewrite:b['packet']=_row(b,'outer_prewrite')['body'];b['now_utc']=_ow_time(24)
    elif variant=='prior_positive':b['now_utc']=_ow_time(50000)
    elif variant!='canonical_positive':
        before=_fingerprint(b);_outer_mutate(b,spec);assert _fingerprint(b)!=before,'outer mutation did not change typed input'
    try:
        if prewrite:raw=publisher.validate_selected_role_prewrite_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b['now_utc'],m3=m3,peer=peer)
        else:raw=publisher.validate_selected_role_canonical_dependency_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b['now_utc'],m3=m3,peer=peer)
    except publisher.I13MetadataError as error:
        assert expected is not None and error.code==expected,(spec['name'],'wrong typed first guard',error.code,expected)
    else:
        assert expected is None,(spec['name'],'expected refusal returned')
        _outer_assert_result(raw,b,spec,catalogue_bytes,prewrite)

def run(*,m3,publisher,peer,catalogue_bytes):
    cases=[];seal=_seal()
    for literal in CASE_CATALOGUE:
        spec=copy.deepcopy(literal);name=spec['name'];expected=spec['expected_error']
        assert not(_mutable_ids(spec)&_mutable_ids(CASE_CATALOGUE))
        if spec['handler']in('outer','outer_held'):
            _outer_case(spec,m3,publisher,peer,catalogue_bytes,seal)
        elif spec['handler']=='i11_isolation':
            a=_make(spec['role'],peer,catalogue_bytes);b=_make(spec['role'],peer,catalogue_bytes);_install_fixed_I11_phase_support(a);_install_fixed_I11_phase_support(b)
            assert not(_mutable_ids(a)&_mutable_ids(b))and not(_mutable_ids(a)&_mutable_ids(I11_EXACT_FIXTURE_DATA))
            saved=_fingerprint(b);_row(a,'fixed_I11_API')['pin'].pop('path');assert _fingerprint(b)==saved and _seal()==seal
        elif spec['handler']=='isolation':
            a=_make(spec['role'],peer,catalogue_bytes);b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(a)&_mutable_ids(b))and not(_mutable_ids(a)&_mutable_ids(FIXED))
            saved=_fingerprint(b);a['records'][0]['pin'].pop('path');assert _fingerprint(b)==saved and _seal()==seal
        elif spec['handler']=='held':
            flag=peer.ACTUAL_ENTRY_QUALIFIED
            try:
                peer.ACTUAL_ENTRY_QUALIFIED=spec['flag']
                try:peer.emit_selected_peer_current_owner(context=_Hostile())
                except peer.I13MetadataError as e:assert e.code==expected
                else:raise AssertionError('held emitter unexpectedly returned')
            finally:peer.ACTUAL_ENTRY_QUALIFIED=flag
        else:
            b=_make(spec['role'],peer,catalogue_bytes)
            assert not(_mutable_ids(b)&_mutable_ids(FIXED))
            if spec['handler']!='positive':
                before=_fingerprint(b);_mutate(b,spec);assert _fingerprint(b)!=before,'mutation did not change typed input'
            try:result=peer.validate_selected_peer_author_packet_metadata(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread=UUID,source_editor=EDITOR,now_utc=b.get('now_utc',NOW))
            except peer.I13MetadataError as e:
                assert expected is not None and e.code==expected,(name,'wrong typed first guard',e.code,expected)
            else:
                assert expected is None,(name,'expected refusal returned')
                v=_json(result);assert v['role']==spec['role']and v['structural_graph_validated']is True and v['metadata_only']is True
                assert v['full_original_I2_DAG_closed']is False and v['actual_peer_content_qualified']is False and v['current_canonical_authority_qualified']is False and v['native_Parser_authority']is False
                assert type(v['charged_metadata_nodes'])is int and v['charged_metadata_nodes']<=50000
        assert _seal()==seal,'global fixed pin/literal/case specification mutated'
        cases.append(dict(name=name,passed=True));print(json.dumps(dict(event='CASE_PASS',name=name),sort_keys=True),flush=True)
    return dict(cases=cases,passed=len(cases),failed=0,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)


def _diagnostic_one(*, literal, m3, publisher, peer, catalogue_bytes, seal):
    spec = copy.deepcopy(literal)
    name = spec['name']
    expected = spec['expected_error']
    assert not _mutable_ids(spec) & _mutable_ids(CASE_CATALOGUE)
    if spec['handler'] in ('outer', 'outer_held'):
        _outer_case(spec, m3, publisher, peer, catalogue_bytes, seal)
    elif spec['handler'] == 'i11_isolation':
        a = _make(spec['role'], peer, catalogue_bytes)
        b = _make(spec['role'], peer, catalogue_bytes)
        _install_fixed_I11_phase_support(a)
        _install_fixed_I11_phase_support(b)
        assert not _mutable_ids(a) & _mutable_ids(b) and (not _mutable_ids(a) & _mutable_ids(I11_EXACT_FIXTURE_DATA))
        saved = _fingerprint(b)
        _row(a, 'fixed_I11_API')['pin'].pop('path')
        assert _fingerprint(b) == saved and _seal() == seal
    elif spec['handler'] == 'isolation':
        a = _make(spec['role'], peer, catalogue_bytes)
        b = _make(spec['role'], peer, catalogue_bytes)
        assert not _mutable_ids(a) & _mutable_ids(b) and (not _mutable_ids(a) & _mutable_ids(FIXED))
        saved = _fingerprint(b)
        a['records'][0]['pin'].pop('path')
        assert _fingerprint(b) == saved and _seal() == seal
    elif spec['handler'] == 'held':
        flag = peer.ACTUAL_ENTRY_QUALIFIED
        try:
            peer.ACTUAL_ENTRY_QUALIFIED = spec['flag']
            try:
                peer.emit_selected_peer_current_owner(context=_Hostile())
            except peer.I13MetadataError as e:
                assert e.code == expected
            else:
                raise AssertionError('held emitter unexpectedly returned')
        finally:
            peer.ACTUAL_ENTRY_QUALIFIED = flag
    else:
        b = _make(spec['role'], peer, catalogue_bytes)
        assert not _mutable_ids(b) & _mutable_ids(FIXED)
        if spec['handler'] != 'positive':
            before = _fingerprint(b)
            _mutate(b, spec)
            assert _fingerprint(b) != before, 'mutation did not change typed input'
        try:
            result = peer.validate_selected_peer_author_packet_metadata(packet=b['packet'], records=b['records'], catalogue_bytes=catalogue_bytes, expected_root_thread=UUID, source_editor=EDITOR, now_utc=b.get('now_utc', NOW))
        except peer.I13MetadataError as e:
            assert expected is not None and e.code == expected, (name, 'wrong typed first guard', e.code, expected)
        else:
            assert expected is None, (name, 'expected refusal returned')
            v = _json(result)
            assert v['role'] == spec['role'] and v['structural_graph_validated'] is True and (v['metadata_only'] is True)
            assert v['full_original_I2_DAG_closed'] is False and v['actual_peer_content_qualified'] is False and (v['current_canonical_authority_qualified'] is False) and (v['native_Parser_authority'] is False)
            assert type(v['charged_metadata_nodes']) is int and v['charged_metadata_nodes'] <= 50000
    assert _seal() == seal, 'global fixed pin/literal/case specification mutated'

def run_diagnostic(*,m3,publisher,peer,catalogue_bytes):
    cases=[];failures=[];seal=_seal()
    for literal in CASE_CATALOGUE:
        name=literal['name'];passed=False
        try:
            _diagnostic_one(literal=literal,m3=m3,publisher=publisher,peer=peer,catalogue_bytes=catalogue_bytes,seal=seal)
            passed=True
        except MemoryError:
            raise
        except Exception as error:
            actual=None
            for candidate in (error,error.__context__,error.__cause__):
                if candidate is not None and type(candidate)in(m3.I13MetadataError,publisher.I13MetadataError,peer.I13MetadataError):
                    code=candidate.__dict__.get('code')
                    if type(code)is str:actual=code[:128];break
            failures.append(dict(name=name,exception_type=type(error).__name__[:128],expected_code=literal['expected_error'],actual_code=actual,message=str(error)[:512]))
        finally:
            assert _seal()==seal,'diagnostic global integrity failure; further cases aborted'
            assert all(module.__dict__.get('ACTUAL_ENTRY_QUALIFIED')is False for module in(m3,publisher,peer)),'diagnostic heldflag integrity failure; further cases aborted'
        cases.append(dict(name=name,passed=passed))
        print(json.dumps(dict(event='CASE_PASS'if passed else'CASE_FAIL',name=name),sort_keys=True),flush=True)
    passed=sum(row['passed']is True for row in cases)
    return dict(cases=cases,passed=passed,failed=len(cases)-passed,failures=failures,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)


# Fixed bounded subset export; existing strict/full diagnostic exports remain exact.
def run_diagnostic_cases(*, m3, publisher, peer, catalogue_bytes, case_names):
    if type(case_names) not in (tuple, list):
        raise ValueError('case_names must be an exact builtin tuple or list')
    if not 1 <= len(case_names) <= 32:
        raise ValueError('case_names requires one through32 cases')
    if any((type(name) is not str for name in case_names)):
        raise ValueError('case_names entries must be exact builtin str')
    requested = tuple(case_names)
    if len(set(requested)) != len(requested):
        raise ValueError('case_names must be unique')
    positions = {row['name']: index for index, row in enumerate(CASE_CATALOGUE)}
    if any((name not in positions for name in requested)):
        raise ValueError('case_names contains unknown catalogue name')
    if any((positions[left] >= positions[right] for left, right in zip(requested, requested[1:]))):
        raise ValueError('case_names must preserve original catalogue order')
    selected = tuple((CASE_CATALOGUE[positions[name]] for name in requested))
    cases = []
    failures = []
    seal = _seal()
    for literal in selected:
        name = literal['name']
        passed = False
        try:
            _diagnostic_one(literal=literal, m3=m3, publisher=publisher, peer=peer, catalogue_bytes=catalogue_bytes, seal=seal)
            passed = True
        except MemoryError:
            raise
        except Exception as error:
            actual = None
            for candidate in (error, error.__context__, error.__cause__):
                if candidate is not None and type(candidate) in (m3.I13MetadataError, publisher.I13MetadataError, peer.I13MetadataError):
                    code = candidate.__dict__.get('code')
                    if type(code) is str:
                        actual = code[:128]
                        break
            failures.append(dict(name=name, exception_type=type(error).__name__[:128], expected_code=literal['expected_error'], actual_code=actual, message=str(error)[:512]))
        finally:
            assert _seal() == seal, 'diagnostic global integrity failure; further cases aborted'
            assert all((module.__dict__.get('ACTUAL_ENTRY_QUALIFIED') is False for module in (m3, publisher, peer))), 'diagnostic heldflag integrity failure; further cases aborted'
        cases.append(dict(name=name, passed=passed))
        if passed:
            event = dict(event='CASE_PASS', name=name)
        else:
            event = dict(event='CASE_FAIL', **failures[-1])
        print(json.dumps(event, sort_keys=True), flush=True)
    passed = sum((row['passed'] is True for row in cases))
    return dict(cases=cases, passed=passed, failed=len(cases) - passed, failures=failures, metadata_only=True, target_execution=False, operational_authority=False, scientific_authority=False, actual_family_publication=False)
