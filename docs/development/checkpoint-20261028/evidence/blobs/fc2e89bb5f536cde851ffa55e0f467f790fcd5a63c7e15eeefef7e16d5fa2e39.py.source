scopepath=ROOT/'ROOT_CURRENT_BOOTSTRAP004_ACTUAL_EVIDENCE_AND_CONDITIONAL_NATIVE_REQUEST_SOURCE_SCOPE_012.json'
adoptpath=ROOT/'ROOT_SOURCE012_DIFFERENT_METADATA_REVIEW_ADOPTION_001.json'
b=scopepath.read_bytes()
assert len(b)==6453 and hashlib.sha256(b).hexdigest()=='faeb9b3037c5f5e157ae7f77056caf29f7ace78ce59e932a8a859400de9eea63'
scope=json.loads(b)
a=adoptpath.read_bytes()
assert len(a)==3537 and hashlib.sha256(a).hexdigest()=='a10be1e14b821bbcecc8da9cfeaedcdf128df3c2912dae9a01491261ce4fb215'
adopt=json.loads(a)
assert adopt['Source_only_saved_evidence_review_scope_adopted'] is True and adopt['Source_only_scope']['sha256']==hashlib.sha256(b).hexdigest()
now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60
data=(json.dumps(payload,ensure_ascii=False,indent=2,sort_keys=True)+'\n').encode('utf-8')
assert len(data)<=2097152
target=OUT/'TRUSTED_APP_BOOTSTRAP004_ACTUAL_SAVED_COMMAND_RECORDS_001.json'
with target.open('xb') as h:
 assert h.write(data)==len(data)
 h.flush()
 os.fsync(h.fileno())
assert target.read_bytes()==data
print(json.dumps(dict(path=str(target),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())))

