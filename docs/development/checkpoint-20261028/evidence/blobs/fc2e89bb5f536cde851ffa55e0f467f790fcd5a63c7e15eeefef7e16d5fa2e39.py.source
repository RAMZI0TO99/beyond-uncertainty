artTicks -gt 0){Need ($process.StartTime.ToUniversalTime().Ticks -eq $childStartTicks) 'Owned process generation changed'}\\n214-}\\n215:function Child-Table{\\n216- Clock 80 $false\\n217- try{\\n218-  $count=0;$seenHelper=$false\\n219-  foreach($parentId in @($PID,$childId)){\\n220-   foreach($row in Get-CimInstance -ClassName Win32_Process -Filter \\\"ParentProcessId = $parentId\\\" -OperationTimeoutSec 3){\\n221-    $count++;Need ($count -le 64) 'Process table row cap exceeded'\\n222-    Need ($parentId -eq $PID -and [long]$row.ProcessId -eq $childId -and [long]$row.ParentProcessId -eq $PID) 'Unexpected descendant; no authority to kill it'\\n223-    Need ($row.CreationDate -is [datetime] -and [math]::Abs($row.CreationDate.ToUniversalTime().Ticks-$childStartTicks) -le 10000) 'CIM helper generation differs'\\n224-    $seenHelper=$true\\n225-   }\\n226-  }\\n227-  Need ($process.HasExited -or $seenHelper) 'Live retained helper missing from process table'\\n228-  Clock 80 $false\\n229- }catch{$script:custodyClosed=$false;throw}\\n230-}\\n231-try{\\n232- Need ($PSScriptRoot -ceq $run -and $PSCommandPath -ceq (Join-Path $run 'bootstrap-supervise_004.ps1')) 'Exact supervisor Source path required'\\n233- if($Mode -ceq 'Begin'){\\n234-  Need ($ExternalFrequency -eq $frequency -and $ExternalEntryQpc -gt 0 -and $ExternalEntryQpc -le $modeEntryQpc) 'Fresh external pre-dispatch QPC required'\\n235-  $commonUtc=Utc $ExternalEntryUtc;$commonQpc=$ExternalEntryQpc\\n236-  Need (($modeEntryQpc-$commonQpc)/[double]$frequency -lt 5 -and $modeEntryUtc -ge $commonUtc -and $modeEntryUtc -lt $commonUtc.AddSeconds(5)) 'External pre-dispatch observation is stale'\\n237- }else{\\n238-  Need ($ExternalEntryQpc -eq 0 -and $ExternalEntryUtc -ceq '' -and $ExternalFrequency -eq 0) 'Only Begin accepts external entry'\\n239-  $dispatchRef=Existing 'bootstrap-dispatch_004.json';$dispatch=$dispatchRef.value\\n240-  Closed $dispatch @('schema','scope','observed_utc','request_sha256','root_admission_