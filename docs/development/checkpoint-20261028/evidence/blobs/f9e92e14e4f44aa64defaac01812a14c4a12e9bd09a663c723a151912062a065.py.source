"""Author an inert same-buffer selection helper successor. No bundle or target call."""
import ast
import base64
import hashlib
import json
from pathlib import Path

R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
old=R/'prepare_I13_exact_owned_run_bundle_selection_002.py'
raw=old.read_bytes()
assert len(raw)==12489 and hashlib.sha256(raw).hexdigest()=='28a592481d43991a3d53402341e93bb97fe62d1a81e1bb9cb7387d6a015ea4b8'
s=raw.decode('utf8')
changes=[
 ("missing=[];allowed={};names=", "missing=[];allowed={};retained={};names="),
 ("        expected_present=[path,pre,witness]", "        expected_present=[path,pre,witness]\n        validated={str(p).casefold():b for p,b in ((path,raw),(cp,cr),(rp,rr),(pre,pre_raw),(witness,wraw))}"),
 ("                body(p);expected_present.append(p)", "                key=str(p).casefold()\n                if key not in validated:validated[key]=body(p)\n                else:need(body(p)==validated[key],'validated output bytes remain exact')\n                expected_present.append(p)"),
 ("            if os.path.lexists(p):body(p);expected_present.append(p)", "            if os.path.lexists(p):validated[str(p).casefold()]=body(p);expected_present.append(p)"),
 ("need(key not in allowed,'each exact original once');allowed[key]=p", "need(key not in allowed,'each exact original once');allowed[key]=p;retained[key]=validated[key]"),
 ("    members=[pin(allowed[key])for key in sorted(allowed)]", "    for key,p in allowed.items():need(body(p)==retained[key],'all selected members retain the exact validated buffers')\n    members=[pin(allowed[key],retained[key])for key in sorted(allowed)]"),
 ("    out=ROOT/('I13_EXACT_OWNED_RUN_METADATA_BUNDLE_PLAN_'+ordinal+'.json');result=save(out,wire(value));fresh()", "    for key,p in allowed.items():need(body(p)==retained[key],'final selected member reread equals its validated original')\n    out=ROOT/('I13_EXACT_OWNED_RUN_METADATA_BUNDLE_PLAN_'+ordinal+'.json');result=save(out,wire(value));fresh()")
]
for a,b in changes:
    assert s.count(a)==1,(a,s.count(a))
    s=s.replace(a,b)
new=s.encode('utf8');ast.parse(s)
out=R/'prepare_I13_exact_owned_run_bundle_selection_003.py'
with out.open('xb')as f:f.write(new)
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,record_type='Root_I13_selection_builder003_same_validated_buffers_Source_author_receipt',author='/root',actual_Source_editor='/root',predecessor=pin(old,raw),successor=pin(out,new),complete_predecessor_bytes_base64=base64.b64encode(raw).decode('ascii'),change='Retain the consumed scope, claim, supervisor result, prelaunch, witness and all output buffers; members derive from those same buffers, with exact reread equality before final save. No retrospective outcome inference.',successor_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
p=R/'ROOT_I13_RUN_SELECTION_BUILDER003_SAME_BUFFER_SOURCE_AUTHOR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii')
with p.open('xb')as f:f.write(b)
print(json.dumps(dict(Source=pin(out,new),receipt=pin(p,b),successor_invoked=False)))
