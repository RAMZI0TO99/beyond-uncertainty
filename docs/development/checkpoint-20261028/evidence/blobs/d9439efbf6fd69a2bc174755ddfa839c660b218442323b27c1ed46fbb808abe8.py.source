"""Held I13 Source composition beside the retained I2 producer and caller.

The sole metadata route calls an exact new publisher port. It parses no packet,
creates no loader or IO capability, and returns no upstream authority. Its
module/Source/API binding is mechanical; authentic callable origin stays held.
"""
import hashlib
import types

ACTUAL_ENTRY_QUALIFIED = False
FIXED_SOURCES = {'m3': {'API': {'bytes': 3020, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_009.json', 'sha256': 'b3ab0bbd452824ebfe94aef0584fae05e2831454e76536cd21fb9834059501c2'}, 'Source': {'bytes': 63213, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_M3_guard_contract_metadata_009.py', 'sha256': 'b91eefd28fb8d120addd510949e2cca82b310379da7fa81ec3ddd435285d49f2'}}, 'peer': {'API': {'bytes': 1748, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_009.json', 'sha256': 'c3f5dfa2d652ab5e17b1128c4825c12e50edf8875f0678caeee219643dfd542c'}, 'Source': {'bytes': 61475, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_selected_peer_author_packet_metadata_009.py', 'sha256': '4931d2d5b541a2b7d8ce9c4dc7614482e69ec18ddc4681a44039a8285e93194b'}}, 'publisher': {'API': {'bytes': 4291, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_004.json', 'sha256': '93342e63661c7eea78e13cfc7504b547ea047643bf37e1ff5cf84a4e74260ffe'}, 'Source': {'bytes': 65507, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\m3_peer_contracts_016\\i13\\validate_selected_role_publisher_metadata_004.py', 'sha256': 'f1df1975bee9c7fcd546f4c94f9d09a6371165aea83b6dcaa783f0ad7d7dd6bc'}}}
METADATA_PORTS = {
 'prewrite':'validate_selected_role_prewrite_metadata',
 'canonical':'validate_selected_role_canonical_dependency_metadata',
}

class I13CompositionError(ValueError):
 def __init__(self,code):
  self.code=code
  super().__init__(code)

def _need(ok,code):
 if not ok:raise I13CompositionError(code)

def _pin_equal(value,expected):
 return type(value) is dict and all(type(k) is str for k in value) and set(value)=={'path','bytes','sha256'} and type(value['path']) is str and type(value['bytes']) is int and type(value['sha256']) is str and value['path']==expected['path'] and value['bytes']==expected['bytes'] and value['sha256']==expected['sha256']

def _publisher_port(publisher,name):
 _need(type(publisher) is types.ModuleType,'E_FIXED_PORT')
 attrs=publisher.__dict__;fixed=FIXED_SOURCES['publisher']
 _need(type(attrs.get('__name__')) is str and attrs['__name__']=='_i13_fixed_publisher','E_FIXED_PORT')
 for label,attr in (('Source','__source'),('API','__API')):
  raw=attrs.get(attr+'_bytes__');expected=fixed[label]
  _need(type(raw) is bytes and len(raw)==expected['bytes'] and hashlib.sha256(raw).hexdigest()==expected['sha256'] and _pin_equal(attrs.get(attr+'_pin__'),expected),'E_FIXED_PORT')
 _need(type(attrs.get('__file__')) is str and attrs['__file__']==fixed['Source']['path'],'E_FIXED_PORT')
 fn=attrs.get(name)
 _need(type(fn) is types.FunctionType and type(fn.__name__) is str and fn.__name__==name and type(fn.__module__) is str and fn.__module__=='_i13_fixed_publisher' and fn.__globals__ is attrs and fn.__code__.co_filename==fixed['Source']['path'],'E_FIXED_PORT')
 code=fn.__code__
 _need(code.co_argcount==code.co_posonlyargcount==0 and code.co_kwonlyargcount==8 and tuple(code.co_varnames[:8])==('packet','records','catalogue_bytes','expected_root_thread','source_editor','now_utc','m3','peer') and not code.co_flags&12 and fn.__defaults__ is None and fn.__kwdefaults__ is None,'E_FIXED_PORT')
 return fn

def validate_current_owner_M3_peer_receipt_metadata(*,phase,packet,records,catalogue_bytes,expected_root_thread,source_editor,now_utc,publisher,m3,peer):
 _need(type(phase) is str and phase in METADATA_PORTS,'E_METADATA_PHASE')
 fn=_publisher_port(publisher,METADATA_PORTS[phase])
 # Publisher validates its own fixed M3/peer ports and the combined node charge.
 # This composition decodes no metadata and owns no mutable counter or loader.
 raw=fn(packet=packet,records=records,catalogue_bytes=catalogue_bytes,expected_root_thread=expected_root_thread,source_editor=source_editor,now_utc=now_utc,m3=m3,peer=peer)
 _need(type(raw) is bytes,'E_LAYER_RESULT')
 return raw

