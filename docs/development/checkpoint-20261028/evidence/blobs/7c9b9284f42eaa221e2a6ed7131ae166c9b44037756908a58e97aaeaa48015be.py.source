"""Root metadata-only pin authoring successors; no target or supervisor calls."""
import ast,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def write(p,b):
 with p.open('xb') as h:assert h.write(b)==len(b)
 return pin(p)
assert not (C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_001.json').exists()
assert not (C/'owned_memory_runs/attempt001').exists()
oldsel=C/'I13_FINAL_SOURCE_SELECTION_INPUT_001.json';v=json.loads(oldsel.read_bytes())
assert v['fixtures']['m3_publisher'].endswith('exercise_M3_guard_and_publisher_metadata_memory_006.py')
v['fixtures']['m3_publisher']=v['fixtures']['m3_publisher'].replace('_memory_006.py','_memory_007.py')
sel=write(C/'I13_FINAL_SOURCE_SELECTION_INPUT_002.json',(json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
def source_successor(before_name,after_name,changes):
 before=R/before_name;text=before.read_bytes().decode('utf8')
 for old,new in changes:
  assert text.count(old)==1,(before_name,old,text.count(old));text=text.replace(old,new)
 ast.parse(text,filename=str(R/after_name))
 return dict(before=pin(before),after=write(R/after_name,text.encode('utf8')))
reader=source_successor('prepare_I13_final_Source_manifest_003.py','prepare_I13_final_Source_manifest_004.py',[
 ('I13_FINAL_SOURCE_SELECTION_INPUT_001.json','I13_FINAL_SOURCE_SELECTION_INPUT_002.json'),
 ('I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_001.json','I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_002.json')])
builder=source_successor('prepare_I13_once_supervisor_002.py','prepare_I13_once_supervisor_003.py',[
 ('I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_001.json','I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_002.json'),
 ('ROOT_I13_ONCE_MEMORY_SUPERVISOR_001.py','ROOT_I13_ONCE_MEMORY_SUPERVISOR_002.py')])
v=dict(schema_version=1,record_type='Root_I13_fixture007_dependent_manifest_and_supervisor_Source_authoring_successors',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),selection=sel,reader=reader,supervisor_builder=builder,changes='Exact input/output identity successors only. Whole prior Source artifacts and unadmitted manifest001/supervisor001 remain preserved. Encoding of authoring reads/writes is explicit UTF-8.',manifest_or_supervisor_successors_invoked=False,once_scope_issued=False,claim_created=False,owned_child_launched=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
p=write(R/'ROOT_I13_FIXTURE007_DEPENDENT_METADATA_SOURCE_AUTHORING_SUCCESSORS_001.json',(json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(receipt=p,reader=reader['after'],supervisor_builder=builder['after'],target_execution=False)))
