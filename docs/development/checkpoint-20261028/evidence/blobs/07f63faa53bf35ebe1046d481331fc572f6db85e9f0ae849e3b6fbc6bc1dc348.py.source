"""Root-only inert composition, partition and supervisor pin authoring; no target calls."""
import ast,base64,datetime as dt,hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def load(p):return json.loads(Path(p).read_bytes())
def pin(p,b=None):
 p=Path(p)
 if b is None:b=p.read_bytes()
 assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def wire(v):return(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('ascii')
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json'
def fresh():assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
def save(p,b):
 fresh();assert p.is_relative_to(C)and len(b)<=2097152
 with p.open('xb')as h:h.write(b)
 assert p.read_bytes()==b
 return pin(p,b)
def replacement(text,name,value):
 tree=ast.parse(text);nodes=[n for n in tree.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id==name];assert len(nodes)==1
 n=nodes[0];a=text.splitlines(keepends=True);a[n.lineno-1:n.end_lineno]=[name+' = '+repr(value)+'\n'];return ''.join(a)
def functions(text):
 return{n.name:ast.dump(n,include_attributes=False)for n in ast.parse(text).body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
assert len(sys.argv)==13
paths=[Path(x)for x in sys.argv[1:]];assert all(p.is_absolute()and p.is_relative_to(C)for p in paths)
ms,ma,ps,pa,us,ua,cat,mf,pf,mc,pc,freeze=paths
protocol=R/'ROOT_I13_COMPACT_DESCRIPTOR_GRAMMAR002_AND_JOINT_EVENT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json';assert pin(protocol)['sha256']=='cb93db3e12f1a2b56a2b81162fb9259d9bf0d1d32fa5c534420cc0dc7a5ffefe'
fresh();sources={k:pin(p)for k,p in zip(('m3','peer','publisher'),(ms,ps,us))};apis={k:pin(p)for k,p in zip(('m3','peer','publisher'),(ma,pa,ua))};fixtures={'m3':pin(mf),'peer':pin(pf)}
assert all(p['bytes']<=65536 for p in sources.values())
fixed={k:dict(Source=sources[k],API=apis[k])for k in sources}
old=T/'current_owner_M3_peer_held_composition_004.py';oldraw=old.read_bytes();new=replacement(oldraw.decode('utf8'),'FIXED_SOURCES',fixed).encode('utf8');assert functions(new.decode())==functions(oldraw.decode())and len(new)<=65536
composition=T/'current_owner_M3_peer_held_composition_005.py';comp_pin=save(composition,new)
oldapi=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json';api=load(oldapi);api.update(Source=comp_pin,fixed_sources=fixed,catalogue=pin(cat),schema_version=5,compact_descriptor_protocol_adoption=pin(protocol));comp_api=save(T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_005.json',wire(api))
oldplan=T/'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_004.json';oldplanraw=oldplan.read_bytes();plan=load(oldplan)
old_sup=C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_009.py';supraw=old_sup.read_bytes();st=ast.parse(supraw);constants={n.targets[0].id:ast.literal_eval(n.value)for n in st.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and n.targets[0].id in('SOURCES','APIS','FIXTURES','CATALOGUE','PARTITION_PLAN')}
mapping={constants['SOURCES'][k]['path']:sources[k]for k in sources};mapping.update({constants['APIS'][k]['path']:apis[k]for k in apis});mapping.update({constants['FIXTURES'][k]['path']:fixtures[k]for k in fixtures});mapping[constants['CATALOGUE']['path']]=pin(cat)
def replace(v):
 if type(v)is dict:
  if set(v)=={'path','bytes','sha256'}and v.get('path')in mapping:return mapping[v['path']]
  return{k:replace(x)for k,x in v.items()}
 if type(v)is list:return[replace(x)for x in v]
 return v
plan=replace(plan);plan.pop('kernel_and_API_inputs_unchanged',None);plan.pop('all_new_and_old_helpers_builders_fixtures_targets_unrun_by_author',None)
plan.update(author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),Source_scope=pin(scope),Source_scope_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE003_DIFFERENT_REVIEW_ADOPTION_001.json'),schema_version=3,current_kernel_and_API_inputs=[*sources.values(),*apis.values()],new_SourceSet4_targets_uninvoked_by_author=True,compact_descriptor_protocol_adoption=pin(protocol),author_Source_freeze=pin(freeze),subjects=[pin(p)for p in(mf,mc,pf,pc)],case_results=None)
names=sum([r['case_names']for r in plan['partitions']],[]);assert len(names)==len(set(names))==936 and hashlib.sha256(('\n'.join(names)+'\n').encode()).hexdigest()=='995ee1ae8d18c2b3093d4f6ff6e9835321ce5da9cff4c6a388a94d5018250f72'
assert [r['case_names']for r in plan['partitions']]==[r['case_names']for r in load(oldplan)['partitions']]
plan_pin=save(T/'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_005.json',wire(plan))
s=supraw.decode('utf8')
for name,value in(('SOURCES',sources),('APIS',apis),('FIXTURES',fixtures),('CATALOGUE',pin(cat)),('PARTITION_PLAN',plan_pin)):s=replacement(s,name,value)
assert functions(s)==functions(supraw.decode('utf8'))
sup=save(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_010.py',s.encode('utf8'))
v=dict(schema_version=1,record_type='Root_I13_compact_SourceSet4_composition005_plan005_supervisor010_inert_Source_author_receipt',author='/root',Source_scope=pin(scope),protocol_adoption=pin(protocol),author_freeze=pin(freeze),subjects=[comp_pin,comp_api,plan_pin,sup],modules=sources,APIs=apis,fixtures=fixtures,catalogue=pin(cat),composition_functions_AST_unchanged=True,supervisor_functions_AST_unchanged=True,original936_order_exact=True,predecessors=[pin(old,oldraw),pin(oldapi),pin(oldplan,oldplanraw),pin(old_sup,supraw)],complete_predecessor_bytes_base64=[base64.b64encode(b).decode('ascii')for b in(oldraw,oldapi.read_bytes(),oldplanraw,supraw)],new_targets_or_composition_invoked=False,tests_executed=False,target_execution=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,separate_Source_review_Root_adoption_and_fresh_once_scope_required=True)
receipt=save(C/'ROOT_I13_SOURCESET4_ROOT_COMPOSITION005_PLAN005_SUPERVISOR010_SOURCE_AUTHOR_RECEIPT_001.json',wire(v))
print(json.dumps(dict(products=v['subjects'],receipt=receipt,targets_invoked=False)))
