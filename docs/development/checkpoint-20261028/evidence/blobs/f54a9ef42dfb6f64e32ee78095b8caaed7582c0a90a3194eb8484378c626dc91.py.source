def diff(a,b,p=''):
 if type(a)is not type(b):return [dict(pointer=p,before=a,after=b)]
 if type(a)is dict:
  assert set(a)==set(b)
  return [x for k in a for x in diff(a[k],b[k],p+'/'+k.replace('~','~0').replace('/','~1'))]
 if type(a)is list:
  assert len(a)==len(b)
  return [x for i,(x0,x1)in enumerate(zip(a,b))for x in diff(x0,x1,p+'/'+str(i))]
 return []if a==b else[dict(pointer=p,before=a,after=b)]
