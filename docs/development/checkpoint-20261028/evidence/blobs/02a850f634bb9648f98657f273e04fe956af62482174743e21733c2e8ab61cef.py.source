"""Create bounded inert metadata Source bundles after exact Root Source adoption.

Actual Source editor of successor: /root. Ordinary IO guard functions carried unchanged from /root/project_architecture. No member is imported, parsed,
compiled, called, restored or deleted. Complete historical bytes remain opaque.
Partial outputs remain on refusal; this helper never rolls back or overwrites.
"""
import base64
import datetime as dt
import hashlib
import json
import os
import re
from pathlib import Path
import sys

ROOT=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
SUBJECTS=ROOT/'m3_peer_contracts_016'
PUB=ROOT/'publication_001'
OUT=ROOT/'owned_run_metadata_bundles_001'
INDEX=OUT/'I13_OWNED_RUN_METADATA_BUNDLE_INDEX_001.json'
CAP=2097152
SCOPE={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json', 'bytes': 8839, 'sha256': '726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'}
SCOPE_ADOPTION={'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261025-003\\ROOT_I13_CURRENT_SOURCE_SCOPE003_DIFFERENT_REVIEW_ADOPTION_001.json', 'bytes': 1418, 'sha256': '120196cc8a9fdbe03411cbde669a7bd94e681bc1cd155a3bc71d8d5a90618571'}

def need(value,why):
    if not value:raise ValueError(why)

def wire(value):
    return(json.dumps(value,sort_keys=True,ensure_ascii=True,separators=(',',':'),allow_nan=False)+'\n').encode('ascii')

def pairs(items):
    value={}
    for key,child in items:
        need(key not in value,'duplicate metadata key')
        value[key]=child
    return value

def bad(value):raise ValueError('float or nonfinite metadata number')

def decode(raw):
    need(type(raw)is bytes and len(raw)<=CAP,'bounded builtin metadata bytes')
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def body(path):
    need(path.is_absolute(),'absolute metadata path')
    for p in(path,*path.parents):
        q=p.lstat()
        need(not p.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
    before=path.stat()
    need(path.is_file()and before.st_nlink==1 and 0<=before.st_size<=CAP,'bounded ordinary Source/data')
    with path.open('rb')as f:
        raw=f.read(CAP+1);f.seek(0);again=f.read(CAP+1)
    after=path.stat()
    need(raw==again and len(raw)==before.st_size==after.st_size and all(getattr(before,k,None)==getattr(after,k,None)for k in('st_dev','st_ino','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes')),'stable whole bytes')
    return raw

def pin(path,raw=None):
    if raw is None:raw=body(path)
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def fact(value):
    need(type(value)is dict and set(value)=={'path','bytes','sha256'}and all(type(k)is str for k in value),'closed fact3')
    need(type(value['path'])is str and type(value['bytes'])is int and 0<=value['bytes']<=CAP and type(value['sha256'])is str and len(value['sha256'])==64 and all(c in'0123456789abcdef'for c in value['sha256']),'typed bounded fact3')
    need(Path(value['path']).is_absolute()and not any(ord(c)<32 for c in value['path']),'absolute ordinary path string')
    return value

def exact(subject):
    fact(subject);path=Path(subject['path']);raw=body(path)
    need(pin(path,raw)==subject,'exact pinned whole bytes')
    return raw

def occurs(value,subject):
    if type(value)is dict:
        if set(value)=={'path','bytes','sha256'}and wire(value)==wire(subject):return True
        return any(occurs(child,subject)for child in value.values())
    return type(value)is list and any(occurs(child,subject)for child in value)

def adoption(value,subject):
    need(type(value)is dict and value.get('author')=='/root'and type(value.get('verdict'))is str and value['verdict'].startswith('ACCEPT_')and value.get('target_execution')is False and value.get('operational_authority')is False and value.get('scientific_authority')is False and occurs(value,subject),'exact Root Source adoption')

def fresh():
    raw=exact(SCOPE);scope=decode(raw);adopted=decode(exact(SCOPE_ADOPTION));adoption(adopted,SCOPE)
    now=dt.datetime.now(dt.timezone.utc)
    need(scope['author']=='/root'and scope['target_execution']is False and scope['operational_authority']is False and scope['new_operational_execution_lease_issued']is False,'Source-only scheduling')
    need(dt.datetime.fromisoformat(scope['interval_start'])<=now and(dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60,'strict original60 Source reserve')
    return pin(Path(SCOPE['path']),raw)

def save(path,raw):
    need(path.is_relative_to(OUT)and type(raw)is bytes and len(raw)<=CAP and not os.path.lexists(path),'fresh contained bounded metadata output')
    for parent in path.parents:
        if os.path.lexists(parent):
            q=parent.lstat();need(parent.is_dir()and not parent.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary existing parent')
    fresh();path.parent.mkdir(parents=True,exist_ok=True)
    for parent in path.parents:
        q=parent.lstat();need(parent.is_dir()and not parent.is_symlink()and not getattr(q,'st_file_attributes',0)&1024,'ordinary output lineage')
    need(not os.path.lexists(path),'still absent output')
    fresh()
    with path.open('xb')as f:
        need(f.write(raw)==len(raw),'complete metadata write');f.flush();os.fsync(f.fileno())
    need(body(path)==raw,'whole output readback')
    return pin(path,raw)


def eligible(path):
    need(path.is_absolute() and '..' not in path.parts and path.resolve()==path, 'canonical original metadata path')
    if path.parent==SUBJECTS:
        return bool(re.fullmatch(r'ROOT_I13_(?:ONCE_SYNTHETIC_MEMORY_SCOPE_\d{3}|FRESH_ONCE_PRELAUNCH_METADATA_\d{3}|ONCE\d{3}_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001)\.json',path.name))
    return path.parent.parent==SUBJECTS/'owned_memory_runs' and bool(re.fullmatch(r'attempt\d{3}',path.parent.name)) and path.name in {
        'SCOPE_CLAIM_001.json','CHILD_ENTRY_001.json','CHILD_RESULT_001.json','CHILD_STDOUT_001.txt','CHILD_STDERR_001.txt','SUPERVISOR_RESULT_001.json','PARENT_TOOL_STDOUT_RETAINED_001.txt','ROOT_ACTUAL_PARENT_EXEC_TOOL_RETURN_001.json'}

def create(plan_path,plan_sha,plan_adoption,source_adoption):
    scope=fresh();own=pin(Path(__file__));adoption(decode(body(source_adoption)),own)
    need(plan_path.parent==ROOT and re.fullmatch(r'I13_EXACT_OWNED_RUN_METADATA_BUNDLE_PLAN_\d{3}\.json',plan_path.name), 'fixed Root selection namespace')
    plan_raw=body(plan_path);plan_pin=pin(plan_path,plan_raw);need(plan_pin['sha256']==plan_sha,'exact selected plan hash')
    plan=decode(plan_raw);adoption(decode(body(plan_adoption)),plan_pin)
    need(plan['record_type']=='Root_I13_exact_consumed_owned_run_metadata_bundle_selection' and plan['author']=='/root' and plan['Source_scope']==SCOPE, 'exact Source-only selection domain')
    need(plan['maximum_metadata_file_bytes']==CAP and plan['maximum_actual_copy_rows']==512 and plan['maximum_actual_copy_payload_bytes']==67108864,'unchanged original packaging caps')
    need(all(plan[k]is False for k in('target_execution','operational_authority','scientific_authority','actual_family_publication','original_files_modified')),'no target/publication authority')
    members=plan['members'];need(type(members)is list and 1<=len(members)<=512 and type(plan['member_count'])is int and len(members)==plan['member_count'],'bounded exact nonempty membership')
    names=[fact(p)['path']for p in members];need(names==sorted(names,key=str.casefold)and len(set(p.casefold()for p in names))==len(names),'fixed unique ordered originals')
    encoded=[]
    for subject in members:
        path=Path(subject['path']);need(eligible(path),'owned run metadata only; no Source bundling')
        original=exact(subject);text=base64.b64encode(original).decode('ascii');need(base64.b64decode(text,validate=True)==original,'complete opaque inverse')
        encoded.append(dict(original=subject,canonical_base64=text))
    need(sum(p['bytes']for p in members)==plan['original_member_bytes']<=67108864,'bounded original byte total')
    created=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')
    def bundle(number,items):
        return dict(schema_version=1,record_type='I13_complete_inert_owned_run_metadata_bundle',author='/root',created_utc=created,Source_scope=scope,packaging_plan=plan_pin,packaging_plan_Root_adoption=pin(plan_adoption),bundle_ordinal=number,members=items,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)
    groups=[];current=[]
    for member in encoded:
        tentative=current+[member]
        if len(tentative)>256 or len(wire(bundle(len(groups)+1,tentative)))>CAP:
            need(bool(current),'one complete member cannot fit original cap');groups.append(current);current=[member]
        else:current=tentative
        need(len(wire(bundle(len(groups)+1,current)))<=CAP,'complete bounded unsplit member')
    if current:groups.append(current)
    outputs=[(OUT/('I13_OWNED_RUN_METADATA_BUNDLE_'+str(i+1).zfill(3)+'.json'),wire(bundle(i+1,group)))for i,group in enumerate(groups)]
    need(not os.path.lexists(OUT)and len(outputs)+1<=512 and sum(len(raw)for _,raw in outputs)<=67108864,'unused bounded output set')
    actual=[];mapping=[]
    for(path,raw),group in zip(outputs,groups):
        for member in group:need(exact(member['original'])==base64.b64decode(member['canonical_base64'],validate=True),'original exact before write')
        saved=save(path,raw);actual.append(saved);recorded=decode(body(path));need(recorded==bundle(len(actual),group),'actual whole bundle readback')
        for ordinal,member in enumerate(recorded['members']):
            decoded=base64.b64decode(member['canonical_base64'],validate=True);need(decoded==exact(member['original'])and base64.b64encode(decoded).decode('ascii')==member['canonical_base64'],'saved canonical inverse')
            mapping.append(dict(original=member['original'],bundle=saved,member_ordinal=ordinal))
    need([m['original']for m in mapping]==members,'every selected whole original exactly once')
    index=dict(schema_version=1,record_type='I13_inert_owned_run_metadata_bundle_index',author='/root',created_utc=created,Source_scope=scope,packaging_plan=plan_pin,packaging_plan_Root_adoption=pin(plan_adoption),bundle_author_Source=own,bundle_author_Source_Root_adoption=pin(source_adoption),bundles=actual,members=mapping,member_count=len(mapping),original_member_bytes=plan['original_member_bytes'],bundle_count=len(actual),member_ordinal_base=0,all_complete_original_bytes_reconstruct_exactly=True,original_files_modified=False,actual_bundles_created=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False,actual_bundle_reconstruction_requires_different_saved_review_and_Root_adoption=True)
    result=save(INDEX,wire(index));fresh();print(json.dumps(dict(bundle_index=result,bundles=actual,members=len(mapping),review_pending=True),sort_keys=True))

if __name__=='__main__':
    need(len(sys.argv)==5,'exact plan path/hash and Root plan/Source adoption paths')
    create(Path(sys.argv[1]),sys.argv[2],Path(sys.argv[3]),Path(sys.argv[4]))
