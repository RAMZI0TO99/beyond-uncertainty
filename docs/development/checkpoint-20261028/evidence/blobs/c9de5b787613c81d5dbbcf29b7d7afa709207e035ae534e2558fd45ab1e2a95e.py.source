"""Source-only pin successor author; does not import the held composition."""
import ast,base64,datetime as dt,hashlib,json
from pathlib import Path

R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13';cache={}
def raw(p):
 p=Path(p);key=str(p.resolve()).casefold()
 if key not in cache:
  with p.open('rb') as h:b=h.read(2097153)
  assert 0<len(b)<=2097152
  cache[key]=b
 return cache[key]
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def exact(p):
 assert pin(Path(p['path']))==p
 return raw(Path(p['path']))
def save(p,b):
 assert len(b)<=2097152
 with p.open('xb') as h:assert h.write(b)==len(b)
 return pin(p)
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()

inp=C/'I13_HELD_COMPOSITION_BINDING_INPUT_002.json';cfg=json.loads(raw(inp))
before=T/'current_owner_M3_peer_held_composition_002.py';api_before=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_002.json'
assert pin(before)==dict(path=str(before),bytes=5104,sha256='8cdf78b7f67711804520ecf36dd822255826b93d2c936bcec1142ddc93197fac')
assert pin(api_before)==dict(path=str(api_before),bytes=4035,sha256='b75415ce66bb0402240093def92c1a06e127cfb4c0130d4256a12ebab4c76988')
old=json.loads(raw(api_before));assert set(cfg)=={'schema_version','fixed_sources','protocol','catalogue'}
assert cfg['schema_version']==2 and cfg['protocol']==old['protocol'] and cfg['catalogue']==old['catalogue']
assert set(cfg['fixed_sources'])=={'m3','peer','publisher'}
for key in ('m3','peer'):assert cfg['fixed_sources'][key]==old['fixed_sources'][key]
assert cfg['fixed_sources']['publisher']!=old['fixed_sources']['publisher']
for key,pair in cfg['fixed_sources'].items():
 assert set(pair)=={'Source','API'}
 for p in pair.values():assert Path(p['path']).resolve().is_relative_to(T.resolve());exact(p)
 body=json.loads(exact(pair['API']));assert body['Source']==pair['Source']
 assert pair['Source']['bytes']<=65536
text=raw(before).decode();tree=ast.parse(text);assign=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='FIXED_SOURCES' for x in n.targets))
assert ast.literal_eval(assign.value)==old['fixed_sources']
lines=text.splitlines(keepends=True);lines[assign.lineno-1:assign.end_lineno]=['FIXED_SOURCES = '+repr(cfg['fixed_sources'])+'\n']
source=''.join(lines).encode();after=T/'current_owner_M3_peer_held_composition_003.py';assert len(source)<=65536
newtree=ast.parse(source,filename=str(after));compile(newtree,str(after),'exec')
def without_fixed(t):
 t.body=[n for n in t.body if not(isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='FIXED_SOURCES' for x in n.targets))]
 return ast.dump(t,include_attributes=False)
assert without_fixed(ast.parse(raw(before)))==without_fixed(ast.parse(source))
newpin=save(after,source);api=dict(old);api.update(schema_version=3,Source=newpin,fixed_sources=cfg['fixed_sources'])
apipin=save(T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_003.json',wire(api))
receipt=dict(schema_version=1,record_type='Root_I13_held_composition_pin_only_Source_successor',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),binding_input=pin(inp),before_Source=pin(before),before_API=pin(api_before),after_Source=newpin,after_API=apipin,complete_before_Source_base64=base64.b64encode(raw(before)).decode(),complete_before_API_base64=base64.b64encode(raw(api_before)).decode(),only_FIXED_SOURCES_AST_assignment_changed=True,all_function_AST_unchanged=True,actual_entries_unconditionally_held=True,composition_metadata_route_executed=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
q=save(C/'ROOT_I13_HELD_COMPOSITION003_PUBLISHER_SUCCESSOR_PIN_REPAIR_RECEIPT_001.json',wire(receipt))
print(json.dumps(dict(Source=newpin,API=apipin,receipt=q,target_execution=False)))
