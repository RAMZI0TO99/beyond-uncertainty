def sha(b): return hashlib.sha256(b).hexdigest()
def fact(p, b=None):
    p = Path(p)
    b = p.read_bytes() if b is None else b
    return dict(path=str(p), bytes=len(b), sha256=sha(b))
def ck(name, passed, evidence):
    checks.append(dict(name=name, passed=bool(passed), evidence=evidence))
def pairs(rows):
    out = {}
    for k, v in rows:
        if k in out: raise ValueError('duplicate key ' + k)
        out[k] = v
    return out
def bad(value): raise ValueError('noninteger JSON ' + value)
def decode(b): return json.loads(b.decode('utf8'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
def read(label, p, expected=None):
    p = Path(p)
    b = p.read_bytes()
    f = fact(p, b)
    subjects[label] = f
    ck(label + '_ordinary_absolute', p.is_absolute() and p.is_file() and not p.is_symlink(), str(p))
    if expected:
        ck(label + '_exact_pin', f == expected if isinstance(expected, dict) else (len(b), sha(b)) == expected, f)
    ck(label + '_original_2MiB_cap', len(b) <= 2097152, len(b))
    return b
def js(label, p, expected=None):
    value = decode(read(label, p, expected))
    ck(label + '_strict_JSON', type(value) is dict, 'UTF8 unique-key object; no floats/nonfinite values')
    return value
def dump(n): return ast.dump(n, include_attributes=False)
def literal_json(v):
    if type(v) is bytes: return dict(AST_builtin_type='bytes',canonical_base64=base64.b64encode(v).decode('ascii'))
    if type(v) is dict: return {k:literal_json(x) for k,x in v.items()}
    if type(v) is list: return [literal_json(x) for x in v]
    return v
def defs(t): return {n.name:n for n in t.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
def assignments(t):
    return {n.targets[0].id:n.value for n in t.body if isinstance(n, ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0], ast.Name)}

