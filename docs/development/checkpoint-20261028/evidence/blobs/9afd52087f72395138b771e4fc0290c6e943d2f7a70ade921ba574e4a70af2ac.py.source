"""Independent read/hash/strict JSON/AST-only original observation9 correction review."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent;B=ROOT/'m3_peer_contracts_016'/'m3_protocol_audit_001'
O=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'/'observation9_protocol_review_001';O.mkdir(exist_ok=True)
checks=[];reads={}
def read(p):
    with Path(p).open('rb')as f:r=f.read(2097153)
    assert 0<len(r)<=2097152
    reads[str(p)]=dict(path=str(p),bytes=len(r),sha256=hashlib.sha256(r).hexdigest());return r
def pin(p):read(p);return reads[str(p)]
def pairs(xs):
    v={}
    for k,x in xs:
        assert k not in v
        v[k]=x
    return v
def bad(x):raise ValueError('noninteger JSON')
def load(p):return json.loads(read(p).decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def ck(n,v,e):checks.append(dict(name=n,passed=v is True,evidence=e))
fix=B/'I13_PROPOSED_ORIGINAL_I2_RECEIPT22_OBSERVATION9_CORRECTION_001.json';v=load(fix)
stem='I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE'
old=load(B/(stem+'_004.json'));new=load(B/(stem+'_005.json'))
ps='I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL'
proto=load(B/(ps+'_005.json'))
raw=read(Path(v['Source']['path']));tree=ast.parse(raw);lines=raw.splitlines(keepends=True)
n=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='read')
part=b''.join(lines[n.lineno-1:n.end_lineno])
ck('original_Source_exact',pin(Path(v['Source']['path']))==v['Source'],v['Source'])
ck('read_region_exact',dict(AST_sha256=hashlib.sha256(ast.dump(n,include_attributes=False).encode()).hexdigest(),bytes=len(part),first_line=n.lineno,last_line=n.end_lineno,sha256=hashlib.sha256(part).hexdigest())==v['actual_read_function'],v['actual_read_function'])
assign=next(x for x in ast.walk(n)if isinstance(x,ast.Assign)and any(isinstance(t,ast.Subscript)and isinstance(t.value,ast.Name)and t.value.id=='OBSERVATIONS'for t in x.targets))
keys=[k.arg for k in assign.value.keywords]
obs=new['schemas']['M3_read_observation9']
ck('Source_emits_actual_closed9',keys==v['actual_OBSERVATIONS_assignment']['exact_fields_in_order']==obs['exact_keys']and len(keys)==9,keys)
ck('Source_actual_assignment_region',assign.lineno==v['actual_OBSERVATIONS_assignment']['first_line']and assign.end_lineno==v['actual_OBSERVATIONS_assignment']['last_line'],{})
ck('new_exact9_schema',obs['field_count']==9 and set(obs['exact_keys'])==set(obs['fields'])and obs['additional_fields_allowed']is False,{})
ck('no_fabricated12_fields',not({'raw9','shared_descriptor7','both_full_API9_independently_stable'}&set(obs['fields'])),{})
for key in old['schemas']:
    if key!='receipt22':ck('unchanged_schema_'+key,old['schemas'][key]==new['schemas'][key],dict(schema=key))
expected=json.loads(json.dumps(old['schemas']['receipt22']));expected['fields']['finite_actual_Source_observations']='complete_unique_M3_read_observation9_list'
ck('only_receipt_slot_changed',new['schemas']['receipt22']==expected,{})
ck('only_one_new_schema',set(new['schemas'])-set(old['schemas'])=={'M3_read_observation9'},{})
for key in ['ROLE_SOURCE_CAPS','counter_mode','counter_composition_policy','original_guards','fixed_port_registry','fixed_inventory_descriptive_LF_rule','peer_base_catalogue','peer_role_data']:
    ck('unchanged_invariant_'+key,old[key]==new[key],dict(key=key))
ck('shared7_literal_exact',obs['fields']['shared_identity_indexes']==dict(builtin_type='list',literal=[0,1,2,3,6,7,8]),{})
ck('two_read_bool_True',obs['fields']['two_read_match']==dict(builtin_type='bool',literal=True),{})
ck('UTC6retained',obs['fields']['observed_utc']=='utc6',{})
ck('raw_body_pin_and_rolecap_rule',all(x in v['normative_rule'][1]for x in ['strict positive builtinint','Supplied full body length/SHA match','actual role/metadata cap']),{})
ck('ordinary_shared7_mode_link_reparse',all(x in v['normative_rule'][2]for x in ['builtin nonnegative integers','ordinary mode','single link','[0,1,2,3,6,7,8]']),{})
ck('original_independent_API_stability',b'raw9(os.fstat(handle.fileno())) == descriptor'in part and b'raw9(path.lstat()) == before'in part,{})
ck('no_physical_acceptance',all(v[k]is False for k in ['target_execution','tests_executed','target_Source_executed','operational_authority','scientific_authority','actual_peer_content_qualified','full_original_I2_DAG_closed','current_canonical_authority_qualified']),{})
ck('metadata_migration_distinct_shapes',any('Real publication12 substituted'in x for x in v['finite_required_controls']),{})
ck('protocol_pins_new_catalogue',proto['catalogue']==pin(B/(stem+'_005.json')),proto['catalogue'])
ck('correction_subject_pinned',pin(fix)in list(proto.values()),{})
failed=[x for x in checks if not x['passed']]
full=dict(schema_version=1,record_type='INDEPENDENT_I13_ORIGINAL_I2_OBSERVATION9_PROTOCOL_FULL_SOURCE_REVIEW',reviewer='/root/i2_resume_gap',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),verdict='PASS_I13_EXACT_ORIGINAL_RECEIPT22_OBSERVATION9_METADATA_SOURCE_ONLY'if not failed else'REFUSE_I13_OBSERVATION9_CORRECTION',subjects=[pin(fix),pin(B/(stem+'_005.json')),pin(B/(ps+'_005.json'))],checks_passed=sum(x['passed']for x in checks),checks_failed=len(failed),checks=checks,read_pins=list(reads.values()),method='Own read/hash/strictJSON/AST only; no target import/call/fixture. Actual untouched I2 read AST compared with exact emitted9 keyword schema. Publisher12 and every other old schema retained.',target_execution=False,tests_executed=False,operational_authority=False,actual_family_publication=False,full_original_I2_DAG_closed=False)
def save(name,v):
    raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
    p=O/name
    with p.open('xb')as f:f.write(raw)
    return pin(p)
fp=save('INDEPENDENT_I13_OBSERVATION9_CORRECTION_FULL_SOURCE_PROOF_001.json',full)
cap={k:full[k]for k in ['schema_version','reviewer','created_utc','verdict','subjects','checks_passed','checks_failed','target_execution','tests_executed','operational_authority','actual_family_publication','full_original_I2_DAG_closed']};cap.update(record_type='INDEPENDENT_I13_OBSERVATION9_CORRECTION_SOURCE_CAPSULE',full_proof=fp,findings=failed)
cp=save('INDEPENDENT_I13_OBSERVATION9_CORRECTION_SOURCE_CAPSULE_001.json',cap)
print(json.dumps(dict(capsule=cp,full_proof=fp,checks_passed=full['checks_passed'],checks_failed=len(failed),failed_names=[x['name']for x in failed]),sort_keys=True))
