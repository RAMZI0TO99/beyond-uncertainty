"""Preserve uninvoked metadata author001; correct the independently read admission enum."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
p=R/'author_capture_protocol_and_exact_request_001.py';b=p.read_bytes();s=b.decode()
old="record_type='Root_I13_raw_retention_once_admission'";new="record_type='Root_I13_exact_once_raw_retention_admission'"
assert s.count(old)==1
s=s.replace(old,new).replace('Exact record_type must be confirmed against future reviewed activated Source before issuance.','Exact record_type is the held003 constant; future activated Source must preserve or separately review its exact ABI before issuance.')
old2="source_subjects_unchanged=subjects,request_and_capture_identity_only=True"
new2="source_subjects_unchanged=subjects,author_preparation_history=pin(R/'ROOT_I13_PROTOCOL_METADATA_AUTHOR002_COMPLETE_UNINVOKED001_INVERSE_001.json'),request_and_capture_identity_only=True"
assert s.count(old2)==1;s=s.replace(old2,new2)
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
target=R/'author_capture_protocol_and_exact_request_002.py';nb=s.encode()
iv=dict(schema_version=1,author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),complete_predecessor=pin(p,b),complete_predecessor_base64=base64.b64encode(b).decode(),successor=pin(target,nb),predecessor_executed=False,prior_subject_outputs_created=False,reason='Own prepublication read-only enum comparison found the guessed prospective operative-admission record_type differed from held003 exact constant. Preserve complete uninvoked001 and correct enum in002 before any protocol/request artifact is authored. No subject or metadata author001 was called.',all_capture_and_execution_gates_held=True)
for q,w in [(R/'ROOT_I13_PROTOCOL_METADATA_AUTHOR002_COMPLETE_UNINVOKED001_INVERSE_001.json',(json.dumps(iv,sort_keys=True,indent=2)+'\n').encode()),(target,nb)]:
 with q.open('xb') as h:assert h.write(w)==len(w);h.flush();os.fsync(h.fileno())
 assert q.read_bytes()==w
assert p.read_bytes()==b
print(json.dumps(dict(author=pin(target,nb),inverse=pin(R/'ROOT_I13_PROTOCOL_METADATA_AUTHOR002_COMPLETE_UNINVOKED001_INVERSE_001.json',(json.dumps(iv,sort_keys=True,indent=2)+'\n').encode()))))
