PREFIX = '$I13_DESCRIPTOR:'

def wire(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(',', ':'), allow_nan=False) + '\n').encode('ascii')

def pretty(value):
    return (json.dumps(value, sort_keys=True, ensure_ascii=True, indent=2, allow_nan=False) + '\n').encode('ascii')

def pin(path, raw=None):
    path = Path(path)
    raw = path.read_bytes() if raw is None else raw
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())

def fresh():
    now = datetime.datetime.now(datetime.timezone.utc)
    assert (datetime.datetime.fromisoformat('2026-10-25T18:03:03.861408+00:00') - now).total_seconds() > 60
    return now.isoformat(timespec='microseconds')

def save(path, raw, cap=CAP):
    path = Path(path)
    assert path.is_relative_to(C) and type(raw) is bytes and len(raw) <= cap
    if os.path.lexists(path):
        allowed={'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_008.json','validate_M3_guard_contract_metadata_010.py','CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_010.json','validate_selected_peer_author_packet_metadata_010.py','CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_010.json'}
        assert path.name in allowed and path.read_bytes()==raw,'only exact known author001 partial bytes may be reused'
        return pin(path,raw)
    fresh()
    with path.open('xb') as handle:
        assert handle.write(raw) == len(raw)
        handle.flush()
        os.fsync(handle.fileno())
    assert path.read_bytes() == raw
    return pin(path, raw)

def nodes(value):
    if type(value) is dict:
        return 1 + sum(1 + nodes(child) for child in value.values())
    if type(value) is list:
        return 1 + sum(nodes(child) for child in value)
    return 1

def key(value):
    return wire(value).decode('ascii')[:-1]

def ast_hash(raw):
    return hashlib.sha256(ast.dump(ast.parse(raw.decode('utf8')), include_attributes=False).encode('utf8')).hexdigest()

def definitions(raw):
    tree = ast.parse(raw.decode('utf8'))
    result = {}
    def visit(items, prefix=''):
        for node in items:
            if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
                name = prefix + node.name
                result[name] = hashlib.sha256(ast.dump(node, include_attributes=False).encode('utf8')).hexdigest()
                if isinstance(node, ast.ClassDef):
                    visit(node.body, name + '.')
    visit(tree.body)
    return result

def inverse(before, after):
    """Exact newline-fragment inverse; never repeats an entire fixture unnecessarily."""
    b, a = before.splitlines(keepends=True), after.splitlines(keepends=True)
    offsets = [0]
    for line in a:
        offsets.append(offsets[-1] + len(line))
    changes = []
    for tag, a0, a1, b0, b1 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != 'equal':
            old = b''.join(b[b0:b1])
            new = b''.join(a[a0:a1])
            changes.append(dict(after_start=offsets[a0], after_end=offsets[a1], after_fragment_sha256=hashlib.sha256(new).hexdigest(), predecessor_fragment_base64=base64.b64encode(old).decode('ascii')))
    recovered = after
    for change in reversed(changes):
        lo, hi = change['after_start'], change['after_end']
        assert hashlib.sha256(recovered[lo:hi]).hexdigest() == change['after_fragment_sha256']
        recovered = recovered[:lo] + base64.b64decode(change['predecessor_fragment_base64'], validate=True) + recovered[hi:]
    assert recovered == before
    return changes

def compact(text):
    tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
    starts, position = [], 0
    for line in text.splitlines(keepends=True):
        starts.append(position)
        position += len(line)
    skip = {tokenize.INDENT, tokenize.DEDENT, tokenize.NEWLINE, tokenize.NL, tokenize.ENDMARKER}
    edits = []
    for left, right in zip(tokens, tokens[1:]):
        if left.type in skip or right.type in skip or left.end[0] != right.start[0]:
            continue
        lo, hi = starts[left.end[0] - 1] + left.end[1], starts[right.start[0] - 1] + right.start[1]
        gap = text[lo:hi]
        if not gap or gap.strip() or '\n' in gap or '\r' in gap:
            continue
        if left.type in (tokenize.NAME, tokenize.NUMBER) and right.type in (tokenize.NAME, tokenize.NUMBER):
            continue
        if left.type == right.type == tokenize.OP and left.string[-1:] + right.string[:1] in ('==', '!=', '<=', '>=', '<<', '>>', '**', '//', ':=', '+=', '-=', '*=', '/=', '%=', '&=', '|=', '^=', '->', '..'):
            continue
        edits.append((lo, hi))
    after = text
    for lo, hi in reversed(edits):
        after = after[:lo] + after[hi:]
    def lex(value):
        return [(t.type, t.string) for t in tokenize.generate_tokens(io.StringIO(value).readline) if t.type not in (tokenize.INDENT, tokenize.DEDENT)]
    assert lex(text) == lex(after)
    assert ast_hash(text.encode('utf8')) == ast_hash(after.encode('utf8'))
    return after

def once(text, old, new):
    assert text.count(old) == 1, (old[:160], text.count(old))
    return text.replace(old, new, 1)

def assignment(text, name, value):
    tree = ast.parse(text)
    node = next(n for n in tree.body if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name) and n.targets[0].id == name)
    lines = text.splitlines(keepends=True)
    lines[node.lineno - 1:node.end_lineno] = [name + ' = ' + repr(value) + '\n']
    return ''.join(lines)

def source_value(text, name):
    tree = ast.parse(text)
    return next(ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == name for t in n.targets))

adoption = R / 'ROOT_I13_COMPACT_DESCRIPTOR_GRAMMAR002_AND_JOINT_EVENT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'
assert pin(adoption)['sha256'] == 'cb93db3e12f1a2b56a2b81162fb9259d9bf0d1d32fa5c534420cc0dc7a5ffefe'
adopted = json.loads(adoption.read_bytes())
assert adopted['author'] == '/root' and adopted['verdict'].startswith('ACCEPT_')
assert all(adopted[k] is False for k in ('target_execution', 'operational_authority', 'scientific_authority'))
fresh()
proposal = json.loads((P / 'I13_EXACT_COMPACT_DESCRIPTOR_GRAMMAR_PROTOCOL_PROPOSAL_002.json').read_bytes())
old_catalogue_path = A / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_007.json'
old_catalogue = json.loads(old_catalogue_path.read_bytes())
DICT5 = {'builtin_type', 'additional_fields_allowed', 'exact_keys', 'field_count', 'fields'}
LIST3 = {'builtin_type', 'exact_length', 'items_by_ordinal'}
conversions = []

def normalize(value, path=()):
    if type(value) is dict:
        result = {k: normalize(v, path + (k,)) for k, v in value.items()}
        if set(value) == DICT5 and value['builtin_type'] == 'dict' and value['additional_fields_allowed'] is False and type(value['fields']) is dict and value['exact_keys'] == list(value['fields']) and type(value['field_count']) is int and value['field_count'] == len(value['fields']):
            conversions.append((path, 'dict'))
            return {k: result[k] for k in ('additional_fields_allowed', 'fields')}
        if set(value) == LIST3 and value['builtin_type'] == 'list' and type(value['exact_length']) is int and type(value['items_by_ordinal']) is list and value['exact_length'] == len(value['items_by_ordinal']):
            conversions.append((path, 'list'))
            return {'items_by_ordinal': result['items_by_ordinal']}
        return result
    if type(value) is list:
        return [normalize(v, path + (i,)) for i, v in enumerate(value)]
    if type(value) is str:
        assert not value.startswith(PREFIX)
    return value

normal = {k: normalize(v, ('schemas', k)) for k, v in old_catalogue['schemas'].items()}
frequency, values = collections.Counter(), {}
def scan(value):
    if type(value) is dict:
        frequency[key(value)] += 1
        values[key(value)] = value
        for child in value.values():
            scan(child)
    elif type(value) is list:
        for child in value:
            scan(child)
for descriptor in normal.values():
    for child in descriptor.values():
        scan(child)
def eligible(v):
    return type(v) is dict and ('builtin_type' in v or set(v) == {'additional_fields_allowed', 'fields'} or set(v) == {'items_by_ordinal'})
selected = {k for k, v in values.items() if eligible(v) and frequency[k] >= 2 and nodes(v) > 1}
header = proposal['exact_representation']['encoding_header_closed5']
def encode(selection):
    ids = {k: 'D%04d' % (i + 1) for i, k in enumerate(sorted(selection))}
    def item(value, root=False):
        k = key(value) if type(value) is dict else None
        if not root and k in ids:
            return PREFIX + ids[k]
        if type(value) is dict:
            return {k: item(v) for k, v in value.items()}
        if type(value) is list:
            return [item(v) for v in value]
        return value
    result = copy.deepcopy(old_catalogue)
    result['schemas'] = {k: item(v, True) for k, v in normal.items()}
    result['schema_descriptor_encoding'] = copy.deepcopy(header)
    result['schema_descriptor_definitions'] = {ids[k]: item(values[k], True) for k in ids}
    return result
catalogue = encode(selected)
while selected:
    score, remove = min((nodes(encode(selected - {k})), k) for k in sorted(selected))
    if score >= nodes(catalogue):
        break
    selected -= {remove}
    catalogue = encode(selected)
assert nodes(catalogue) == 5378 and len(selected) == 30
assert collections.Counter(q[1] for q in conversions) == {'dict': 79, 'list': 23}
defs = catalogue['schema_descriptor_definitions']
def expand(value, stack=()):
    if type(value) is str and value.startswith(PREFIX):
        name = value[len(PREFIX):]
        assert name in defs and name not in stack
        return expand(defs[name], stack + (name,))
    if type(value) is dict:
        result = {k: expand(v, stack) for k, v in value.items()}
        if set(result) == {'additional_fields_allowed', 'fields'} and result['additional_fields_allowed'] is False:
            return dict(additional_fields_allowed=False, builtin_type='dict', exact_keys=list(result['fields']), field_count=len(result['fields']), fields=result['fields'])
        if set(result) == {'items_by_ordinal'}:
            return dict(builtin_type='list', exact_length=len(result['items_by_ordinal']), items_by_ordinal=result['items_by_ordinal'])
        return result
    if type(value) is list:
        return [expand(v, stack) for v in value]
    return value
assert wire(expand(catalogue['schemas'])) == wire(old_catalogue['schemas'])
catalogue['predecessor_unadopted_catalogue'] = pin(old_catalogue_path)
catalogue['state'] = 'FIXED_COMPACT_DESCRIPTOR_DATA_V2_SOURCE_ONLY_ROOT_ADOPTED_PROTOCOL_NO_EXECUTION'
assert nodes(catalogue) == 5378
catalogue_path = A / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_008.json'
catalogue_pin = save(catalogue_path, pretty(catalogue))

ADAPTERS = r'''
def _descriptor(catalogue, descriptor):
 if type(descriptor)is str and descriptor.startswith('$I13_DESCRIPTOR'):
  _need(descriptor.startswith('$I13_DESCRIPTOR:')and re.fullmatch(r'D[0-9]{4}',descriptor[16:])is not None,'E_CATALOGUE_PIN')
  name=descriptor[16:];definitions=catalogue['schema_descriptor_definitions']
  _need(name in definitions,'E_CATALOGUE_PIN');descriptor=definitions[name]
 return descriptor
def _descriptor_keys(catalogue, descriptor):
 descriptor=_descriptor(catalogue,descriptor)
 return descriptor['fields'].keys()if set(descriptor)=={'additional_fields_allowed','fields'}else descriptor['exact_keys']
def _check_descriptor_encoding(catalogue):
 header=catalogue.get('schema_descriptor_encoding');definitions=catalogue.get('schema_descriptor_definitions')
 _closed(header,('schema_version','reference_prefix','namespace','mode','descriptor_grammar'),'E_CATALOGUE_PIN')
 _need(type(header['schema_version'])is int and header['schema_version']==2 and header['reference_prefix']=='$I13_DESCRIPTOR:'and header['namespace']=='I13_CATALOGUE_DESCRIPTOR_DEFINITIONS_V2'and header['mode']=='COUNT_COMPLETE_ENCODED_GRAPH_ONCE_PER_LOCAL_CACHE_NO_EXPANSION'and header['descriptor_grammar']=='CLOSED2_FIELDS_OR_CLOSED1_ORDINALS_LOSSLESS_V1','E_CATALOGUE_PIN')
 _closed(definitions,tuple('D%04d'%i for i in range(1,31)),'E_CATALOGUE_PIN')
 for value in definitions.values():
  _need(type(value)is dict and ('builtin_type'in value or set(value)=={'additional_fields_allowed','fields'}or set(value)=={'items_by_ordinal'}),'E_CATALOGUE_PIN')
 done=set()
 def walk(value,chain=()):
  if type(value)is str and value.startswith('$I13_DESCRIPTOR'):
   _need(value.startswith('$I13_DESCRIPTOR:')and re.fullmatch(r'D[0-9]{4}',value[16:])is not None and value[16:]in definitions and value[16:]not in chain,'E_CATALOGUE_PIN')
   name=value[16:]
   if name not in done:walk(definitions[name],chain+(name,));done.add(name)
  elif type(value)is dict:
   _need(not any(k.startswith('$I13_DESCRIPTOR')for k in value),'E_CATALOGUE_PIN')
   if 'fields'in value and 'builtin_type'not in value:
    _closed(value,('additional_fields_allowed','fields'),'E_CATALOGUE_PIN');_need(value['additional_fields_allowed']is False and type(value['fields'])is dict,'E_CATALOGUE_PIN')
   if 'items_by_ordinal'in value and 'builtin_type'not in value:
    _closed(value,('items_by_ordinal',),'E_CATALOGUE_PIN');_need(type(value['items_by_ordinal'])is list,'E_CATALOGUE_PIN')
   for k,child in value.items():
    if k!='literal':walk(child,chain)
  elif type(value)is list:
   for child in value:walk(child,chain)
 try:walk(catalogue['schemas'])
 except (KeyError,TypeError,RecursionError):raise I13MetadataError('E_CATALOGUE_PIN')from None
 _need(done==set(definitions),'E_CATALOGUE_PIN')
'''
assert len('$I13_DESCRIPTOR:') == 16

COMPACT_BRANCH = '''  desc = _descriptor(cat,desc)
  if type(desc)is dict and set(desc)=={'additional_fields_allowed','fields'}:
    _closed(value,desc['fields'].keys())
    for key,field in desc['fields'].items():_type(value[key],field,cat,value)
    return
  if type(desc)is dict and set(desc)=={'items_by_ordinal'}:
    fields=desc['items_by_ordinal'];_list(value,len(fields),len(fields))
    for child,field in zip(value,fields):_type(child,field,cat)
    return
'''
products, records = {}, [dict(before=pin(old_catalogue_path),after=catalogue_pin,exact_new_to_predecessor_fragment_inverse=inverse(old_catalogue_path.read_bytes(),Path(catalogue_pin['path']).read_bytes()))]
def record_product(old_path, path, raw, cap=CAP, cosmetic=None):
    before = old_path.read_bytes() if old_path else None
    result = save(path, raw, cap)
    entry = dict(after=result)
    if before is not None:
        entry.update(before=pin(old_path, before), exact_new_to_predecessor_fragment_inverse=inverse(before, raw))
        if path.suffix == '.py' or path.name.endswith('.py.source'):
            old_defs, new_defs = definitions(before), definitions(raw)
            entry.update(before_AST_sha256=ast_hash(before), after_AST_sha256=ast_hash(raw), changed_definition_ASTs={name:dict(before=old_defs.get(name),after=new_defs.get(name))for name in sorted(set(old_defs)|set(new_defs))if old_defs.get(name)!=new_defs.get(name)})
    if cosmetic is not None:
        entry['pre_adapter_cosmetic_layout_proof'] = cosmetic
    records.append(entry)
    return result

def kernel(kind, old_source, old_api, new_source, new_api):
    old_raw = (T / old_source).read_bytes()
    text = old_raw.decode('utf8')
    cosmetic = compact(text)
    layout = dict(before=pin(T/old_source,old_raw), cosmetic_only_bytes=len(cosmetic.encode('utf8')),cosmetic_only_sha256=hashlib.sha256(cosmetic.encode('utf8')).hexdigest(),non_layout_token_lexemes_identical=True,whole_AST_identical=ast_hash(old_raw)==ast_hash(cosmetic.encode('utf8')))
    text = assignment(text, 'COMMON_CATALOGUE_PIN' if kind=='peer' else 'CATALOGUE_PIN', catalogue_pin)
    marker = 'def _enum(' if kind!='peer' else 'def _i13_result('
    assert text.count(marker) == 1
    adapters=ADAPTERS
    if kind=='publisher':
        names={'header':'h','definitions':'ds','done':'z','value':'v','chain':'s','name':'n','child':'x'}
        toks=list(tokenize.generate_tokens(io.StringIO(adapters).readline))
        adapters=tokenize.untokenize([(tok.type,names.get(tok.string,tok.string)if tok.type==tokenize.NAME else tok.string)for tok in toks])
    text = text.replace(marker, adapters + '\n' + marker, 1)
    if kind in ('m3','publisher'):
        function = next(n for n in ast.parse(text).body if isinstance(n,ast.FunctionDef)and n.name=='_type')
        lines=text.splitlines(keepends=True)
        if kind=='m3':
            lines[function.lineno:function.lineno]=[COMPACT_BRANCH]
        else:
            branch='\n'.join(line[1:]if line.startswith(' ')else line for line in COMPACT_BRANCH.splitlines())+'\n'
            # Publisher's private argument q1 is the value; preserve exact body local names.
            branch=branch.replace('value','q1')
            lines[function.lineno:function.lineno]=[branch]
        text=''.join(lines)
        if kind=='m3':
            text=once(text,'    self.c = self.s.record(CATALOGUE_PIN)\n','    self.c = self.s.record(CATALOGUE_PIN)\n    _check_descriptor_encoding(self.c)\n')
            text=once(text,"self.c['schemas']['selection_row9']['exact_keys']","_descriptor_keys(self.c,self.c['schemas']['selection_row9'])")
            old="    result = {key: (rule['literal'] if type(rule) is dict and 'literal' in rule else None) for key, rule in fields.items()}"
            text=once(text,old,"    result = {}\n    for key,rule in fields.items():\n      rule=_descriptor(self.c,rule)\n      result[key]=rule['literal'] if type(rule)is dict and 'literal'in rule else None")
        else:
            text=once(text,'  q2.c = q2.s.record(CATALOGUE_PIN)\n','  q2.c = q2.s.record(CATALOGUE_PIN)\n  _check_descriptor_encoding(q2.c)\n')
            text=text.replace("q2.c['schemas']['selection_row9']['exact_keys']","_descriptor_keys(q2.c,q2.c['schemas']['selection_row9'])")
            text=text.replace("g.c['schemas']['held_peer_API14']['exact_keys']","_descriptor_keys(g.c,g.c['schemas']['held_peer_API14'])")
            text=text.replace("g.c['schemas']['peer_author_wrapper14']['exact_keys']","_descriptor_keys(g.c,g.c['schemas']['peer_author_wrapper14'])")
            text=once(text,"expected['record_type']['literal']","_descriptor(g.c,expected['record_type'])['literal']")
            text=once(text," out = {k: rule['literal'] if type(rule) is dict and 'literal' in rule else None for k, rule in fields.items()}"," out = {}\n for k,rule in fields.items():\n  rule=_descriptor(g.c,rule)\n  out[k]=rule['literal']if type(rule)is dict and 'literal'in rule else None")
            fixed=source_value(text,'FIXED_PORTS')
            fixed['M3'].update(Source=products['m3_source'],API=products['m3_api'])
            fixed['PEER'].update(Source=products['peer_source'],API=products['peer_api'])
            text=assignment(text,'FIXED_PORTS',fixed)
    else:
        text=once(text,'    common=store.record(COMMON_CATALOGUE_PIN)\n','    common=store.record(COMMON_CATALOGUE_PIN)\n    _check_descriptor_encoding(common)\n')
        text=text.replace("common['schemas']['result54']['exact_keys']","_descriptor_keys(common,common['schemas']['result54'])")
        text=once(text,"    for key,typ in common['schemas']['result54']['fields'].items():\n","    for key,typ in common['schemas']['result54']['fields'].items():\n        typ=_descriptor(common,typ)\n")
    raw=compact(text).encode('utf8')
    compile(raw,str(T/new_source),'exec',dont_inherit=True)
    sp=record_product(T/old_source,T/new_source,raw,65536,layout)
    api=json.loads((T/old_api).read_bytes());api['Source']=sp
    if kind!='peer':api['catalogue']=catalogue_pin
    if kind=='publisher':api['fixed_ports']=source_value(raw.decode('utf8'),'FIXED_PORTS')
    ap=record_product(T/old_api,T/new_api,pretty(api))
    products[kind+'_source'],products[kind+'_api']=sp,ap

kernel('m3','validate_M3_guard_contract_metadata_009.py','CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_009.json','validate_M3_guard_contract_metadata_010.py','CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_010.json')
kernel('peer','validate_selected_peer_author_packet_metadata_009.py','CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_009.json','validate_selected_peer_author_packet_metadata_010.py','CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_010.json')
kernel('publisher','validate_selected_role_publisher_metadata_004.py','CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_004.json','validate_selected_role_publisher_metadata_005.py','CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_005.json')

# New fixture-local descriptor readers: no cross-module helper imports/callbacks.
FIXTURE_READERS = '''\ndef _ow_descriptor(catalogue,descriptor):
    if type(descriptor)is str and descriptor.startswith('$I13_DESCRIPTOR:'):
        return catalogue['schema_descriptor_definitions'][descriptor[16:]]
    return descriptor
def _ow_descriptor_keys(catalogue,descriptor):
