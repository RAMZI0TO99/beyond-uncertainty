    return descriptor['fields'].keys()if set(descriptor)=={'additional_fields_allowed','fields'}else descriptor['exact_keys']
'''
old_helper=T/'I13_NEW_OUTER_ENVELOPE_FIXTURE_HELPER_009.py.source'
helper=old_helper.read_bytes().decode('utf8')+FIXTURE_READERS
products['helper']=record_product(old_helper,T/'I13_NEW_OUTER_ENVELOPE_FIXTURE_HELPER_010.py.source',helper.encode('utf8'))
old_helper_text=old_helper.read_bytes().decode('utf8')

def fixture(kind, old_name, new_name, old_catalogue_name, new_catalogue_name):
    before=(T/old_name).read_bytes();text=before.decode('utf8')
    assert text.count(old_helper_text)==1
    text=text.replace(old_helper_text,helper,1)
    if kind=='m3':
        text=once(text,"for i,key in enumerate(desc['exact_keys'])","for i,key in enumerate(_ow_descriptor_keys(self.cat,desc))")
        text=once(text,"selections={k:v['literal']for k,v in self.cat['schemas']['capture_role_selections3']['fields'].items()}","selections={k:_ow_descriptor(self.cat,v)['literal']for k,v in self.cat['schemas']['capture_role_selections3']['fields'].items()}")
        text=once(text,"for k in self.cat['schemas']['M3_read_observation9']['exact_keys']","for k in _ow_descriptor_keys(self.cat,self.cat['schemas']['M3_read_observation9'])")
