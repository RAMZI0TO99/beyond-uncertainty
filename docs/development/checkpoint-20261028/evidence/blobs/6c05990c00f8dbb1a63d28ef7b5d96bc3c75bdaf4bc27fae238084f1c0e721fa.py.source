"""Preserve uninvoked001 and correct reviewer-found metadata adoption bindings."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
p=R/'adopt_raw_retention_contract_and_prepare_handoff004_001.py'
q=R/'adopt_raw_retention_contract_and_prepare_handoff004_002.py'
b=p.read_bytes()
old=b"need(type(checks) is list and len(checks)==len({x['name'] for x in checks})"
new=b"need(type(checks) is list and len(checks)>0 and len(checks)==len({x['name'] for x in checks})"
old2=b"prior,prior_pin=doc(prior_expected['path'],prior_expected);prior_bytes=raw(prior_pin['path'])"
new2=old2+b"\nneed(fact(prior_pin['path'],prior_bytes)==prior_pin,'complete inverse bytes equal authenticated predecessor pin')"
assert len(b)<=2097152 and b.count(old)==b.count(old2)==1
z=b.replace(old,new).replace(old2,new2)
now=dt.datetime.now(dt.timezone.utc)
assert (dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00')-now).total_seconds()>60
for name in ('ROOT_I13_RAW_INPUT_RETENTION_CONTRACT_DIFFERENT_REVIEW_ADOPTION_001.json','ROOT_I13_HANDOFF004_COMPLETE003_PREDECESSOR_INVERSE_001.json','ROOT_I13_CURRENT_RAW_INPUT_RETENTION_CONTRACT_AND_EVIDENCE_HANDOFF_004.json'):
 assert not os.path.lexists(R/name)
with q.open('xb') as h:h.write(z);h.flush();os.fsync(h.fileno())
pin=lambda p,b:dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,record_type='Root_retention_adopter002_complete_uninvoked001_predecessor_inverse',author='/root',created_utc=now.isoformat(),complete_predecessor=pin(p,b),complete_predecessor_base64=base64.b64encode(b).decode(),successor=pin(q,z),predecessor_was_invoked=False,independent_reviewer='/root/i13_final_review',corrections=['Explicitly require a nonempty all-pass review check list.','Hash-bind complete handoff003 inverse buffer to its authenticated pin after second read before Base64 encoding.'],raw_acquisition_admitted=False,all_execution_gates_held=True)
out=R/'ROOT_I13_RETENTION_ADOPTER002_COMPLETE_UNINVOKED001_INVERSE_001.json'
w=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
assert len(w)<=2097152 and (dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
with out.open('xb') as h:h.write(w);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b and q.read_bytes()==z and out.read_bytes()==w
print(json.dumps(dict(successor=pin(q,z),complete_inverse=pin(out,w))))
