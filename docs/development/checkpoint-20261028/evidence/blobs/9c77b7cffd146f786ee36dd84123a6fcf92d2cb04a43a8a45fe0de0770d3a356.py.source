  elif desc in ('exact_sorted_unique_fact3_list', 'ordered_fact3_list_exact_purpose_then_expected_inputs', 'complete_ordered_dependency9_list', 'complete_unique_prior_descriptor4_list', 'complete_ordered_stage_artifact6_list', 'complete_unique_observation12_list', 'complete_unique_M3_read_observation9_list', 'exact_expected_input_observation12_list', 'unique_prior_descriptor4_list', 'exact_sorted_unique_native_path_list', 'unique_nonempty_string_list', 'exact_ordered_role_list', 'singleton_request_role_list', 'exact45_selection_row9_list', 'exact_canonical_and_publication_fact3_list'):
    item = 'artifact6' if 'artifact6' in desc else 'dependency9' if 'dependency9' in desc else 'prior_descriptor4' if 'descriptor4' in desc else 'M3_read_observation9' if 'observation9' in desc else 'observation12' if 'observation12' in desc else 'selection_row9' if 'selection_row9' in desc else 'native_absolute_path' if 'native_path' in desc else 'selected_role' if 'role_list' in desc else 'fact3' if 'fact3' in desc else None
    _list(value, 10000 if desc == 'unique_nonempty_string_list' else 2000, 45 if desc == 'exact45_selection_row9_list' else 0)
    if desc == 'exact45_selection_row9_list':
      _need(len(value) == 45, 'E_SCHEMA')
    for child in value:
      if item is None:
        _need(type(child) is str and bool(child), 'E_SCHEMA')
      else:
        _type(child, item, cat)
    if desc.startswith('exact_sorted_unique_'):
      paths = [x['path'] if type(x) is dict else x for x in value]
