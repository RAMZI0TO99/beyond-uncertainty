  return module
def _direct(g, key, module, name, raw, expected, records, catalogue_bytes, now_utc):
  try:
    result = module.__dict__[name](packet=raw, records=records, catalogue_bytes=catalogue_bytes, expected_root_thread=g.root, source_editor=g.editor, now_utc=now_utc)
  except Exception as error:
    cls = module.__dict__[g.c['fixed_port_registry'][key]['error_class']]
    code = getattr(error, 'code', None) if type(error) is cls else None
    if type(code) is str and code in g.c['fixed_port_registry'][key]['typed_error_codes']:
      raise I13MetadataError(code) from None
