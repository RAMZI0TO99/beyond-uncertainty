class I13MetadataError(ValueError):
  def __init__(self, code):
    self.code = code
    super().__init__(code)
def _need(ok, code='E_SCHEMA'):
  if not ok:
    raise I13MetadataError(code)
def _sha(raw):
  return hashlib.sha256(raw).hexdigest()
def _same(a, b):
  if type(a) is not type(b):
    return False
  if type(a) is dict:
    return set(a) == set(b) and all((_same(a[k], b[k]) for k in a))
  if type(a) is list:
    return len(a) == len(b) and all((_same(x, y) for x, y in zip(a, b)))
  return a == b
def _closed(value, keys, code='E_SCHEMA'):
  _need(type(value) is dict and all((type(k) is str for k in value)) and (set(value) == set(keys)), code)
def _path(value):
  _need(type(value) is str and len(value) <= 512 and (re.fullmatch('[A-Z]:\\\\[^/]+', value) is not None), 'E_PATH')
  reserved = {'CON', 'PRN', 'AUX', 'NUL', 'CLOCK$'} | {'COM' + str(i) for i in range(1, 10)} | {'LPT' + str(i) for i in range(1, 10)}
  _need(all((part and part not in ('.', '..') and (part[-1] not in '. ') and (not any((ord(c) < 32 or 55296 <= ord(c) <= 57343 or c in '/:"<>|?*' for c in part))) and (part.split('.')[0].upper() not in reserved) for part in value[3:].split('\\'))), 'E_PATH')
  return value
def _actor(value, root=True):
  _need(type(value) is str and len(value) <= 512 and (re.fullmatch('/root(?:/[A-Za-z0-9_]+)*', value) is not None) and (root or value != '/root'), 'E_ACTOR')
  return value
def _time(value, digits=6):
  _need(type(value) is str and re.fullmatch('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{' + str(digits) + '}\\+00:00', value) is not None, 'E_TIME')
  try:
    date = datetime.datetime.strptime(value[:19], '%Y-%m-%dT%H:%M:%S')
    seconds = (date.date().toordinal() - EPOCH) * 86400 + date.hour * 3600 + date.minute * 60 + date.second
    return seconds * TICK + int(value[20:20 + digits].ljust(7, '0'))
  except (ValueError, OverflowError):
    raise I13MetadataError('E_TIME') from None
def _pin(value, cap=CAP):
  _closed(value, ('path', 'bytes', 'sha256'), 'E_PIN')
  _path(value['path'])
  _need(type(cap) is int and 0 < cap <= CAP and (type(value['bytes']) is int) and (0 < value['bytes'] <= cap) and (type(value['sha256']) is str) and (re.fullmatch('[0-9a-f]{64}', value['sha256']) is not None), 'E_PIN')
  return dict(value)
def _opaque(pin, parts):
  return _same(pin, I11_API) and bool(parts) and (parts[0] == 'literal_case_catalogue')
def _tree(value, counter, depth=0, pin=None, parts=()):
  _need(depth <= 48, 'E_DEPTH')
  counter[0] += 1
  _need(counter[0] <= 50000, 'E_NODE_BUDGET')
  if value is None or type(value) in (bool, int):
    return
  if type(value) is str:
    _need(not any((55296 <= ord(c) <= 57343 for c in value)), 'E_CONTEXT_VALUE')
    if any((ord(c) < 32 for c in value)) and (not _opaque(pin, parts)):
      _need(_same(pin, INVENTORY_PIN) and parts == LF_PARTS and (len(value.encode('utf8')) == 367) and (_sha(value.encode('utf8')) == LF_SHA) and (value.count('\n') == 10) and all((ord(c) >= 32 or c == '\n' for c in value)), 'E_CONTEXT_VALUE')
    return
  if type(value) is list:
    for i, child in enumerate(value):
      _tree(child, counter, depth + 1, pin, parts + (str(i),))
    return
  if type(value) is dict:
    for key, child in value.items():
      _need(type(key) is str, 'E_CONTEXT_VALUE')
      _tree(key, counter, depth + 1, pin, parts + ('@key:' + key,))
      _tree(child, counter, depth + 1, pin, parts + (key,))
    return
  raise I13MetadataError('E_CONTEXT_VALUE')
def _pairs(items):
  out = {}
  for key, value in items:
    _need(key not in out, 'E_JSON_DUPLICATE')
    out[key] = value
  return out
def _bad_number(token):
  raise I13MetadataError('E_JSON_NUMBER')
def _decode(raw, counter, pin=None):
  _need(type(raw) is bytes and 0 < len(raw) <= CAP and (not raw.startswith(b'\xef\xbb\xbf')), 'E_JSON')
  try:
    value = json.loads(raw.decode('utf8'), object_pairs_hook=_pairs, parse_float=_bad_number, parse_constant=_bad_number)
  except (UnicodeError, ValueError, RecursionError, OverflowError) as error:
    if type(error) is I13MetadataError:
      raise
    raise I13MetadataError('E_JSON') from None
  _tree(value, counter, pin=pin)
  return value
def _wire(value):
  try:
    raw = (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False) + '\n').encode('utf8')
  except (TypeError, ValueError, UnicodeError, RecursionError, OverflowError):
    raise I13MetadataError('E_JSON') from None
  _need(0 < len(raw) <= CAP, 'E_CAP')
  return raw
class _Store:
  def __init__(self, records):
    _need(type(records) is list and len(records) <= 256, 'E_RECORD_BUDGET')
    self.count, self.entries, self.cache, self.total = ([1], {}, {}, 0)
    self.used = {}
    seen = set()
    for entry in records:
      _closed(entry, ('pin', 'body'), 'E_SCHEMA')
      pin = _pin(entry['pin'])
      _tree(pin, self.count)
      self.count[0] += 4
      _need(self.count[0] <= 50000, 'E_NODE_BUDGET')
      raw = entry['body']
      _need(type(raw) is bytes and len(raw) == pin['bytes'] and (0 < len(raw) <= CAP) and (_sha(raw) == pin['sha256']), 'E_RECORD_HASH')
      key = pin['path'].casefold()
      _need(key not in seen, 'E_RECORD_ALIAS')
      seen.add(key)
      self.total += len(raw)
      _need(self.total <= 33554432, 'E_RECORD_BUDGET')
      self.entries[pin['path']] = (pin, raw)
  def body(self, pin, cap=CAP):
    pin = _pin(pin, cap)
    _need(pin['path'] in self.entries and _same(self.entries[pin['path']][0], pin), 'E_RECORD_MISSING')
    self.used[pin['path']] = pin
    return self.entries[pin['path']][1]
  def record(self, pin, cap=CAP):
    raw = self.body(pin, cap)
    key = pin['path']
    if key not in self.cache:
      self.cache[key] = _decode(raw, self.count, pin)
    return self.cache[key]
  def locate(self, raw):
    _need(type(raw) is bytes and 0 < len(raw) <= CAP, 'E_JSON')
    hits = [pin for pin, body in self.entries.values() if body == raw]
    _need(len(hits) == 1, 'E_RECORD_ALIAS')
    return hits[0]
def _enum(catalogue, name):
  if name in catalogue['enums']:
    return catalogue['enums'][name]
  if name == 'prior_kind_enum':
    return catalogue[name]
  if name == 'stage_role':
    return catalogue['enums']['M3_selected_roles'] + _enum(catalogue, 'finite8_role')
  if name in ('selected_role', 'original_selected45_role'):
    return list(catalogue['ROLE_SOURCE_CAPS']) + ['composer']
  if name == 'finite8_role':
    return catalogue['M3_complete_stage_roles']['templates'][1:] + [r[:-9] + '_bound' for r in catalogue['M3_complete_stage_roles']['templates'][1:]]
  return None
def _list(value, maximum=2000, minimum=0):
  _need(type(value) is list and minimum <= len(value) <= maximum, 'E_SCHEMA')
  return value
def _type(value, desc, cat, parent=None):
  if type(desc) is dict:
    if 'literal' in desc:
      _need(_same(value, desc['literal']), 'E_SCHEMA_VALUE')
    elif 'conditional_on_sibling' in desc:
      _need(type(parent) is dict and type(parent.get(desc['conditional_on_sibling'])) is str, 'E_SCHEMA')
      _type(value, desc['cases'].get(parent.get(desc['conditional_on_sibling']), desc['otherwise']), cat, parent)
    elif desc.get('builtin_type') == 'dict':
      _closed(value, desc['exact_keys'])
      for key, field in desc['fields'].items():
        _type(value[key], field, cat, value)
    elif desc.get('builtin_type') == 'list':
      _list(value, desc['exact_length'], desc['exact_length'])
      for v, field in zip(value, desc['items_by_ordinal']):
        _type(v, field, cat)
    elif desc.get('builtin_type') == 'str':
      _need(type(value) is str and len(value) <= desc.get('maximum_length', CAP), 'E_SCHEMA')
    else:
      raise I13MetadataError('E_SCHEMA')
    return
  _need(type(desc) is str, 'E_SCHEMA')
  if desc in cat['schemas']:
    _type(value, cat['schemas'][desc], cat, parent)
    return
  enum = _enum(cat, desc)
  if enum is not None:
    _need(type(value) is str and value in enum, 'E_SCHEMA_VALUE')
  elif desc == 'selected_role_or_null_for_complete_stage':
    _need(value is None or (type(value) is str and value in cat['ROLE_SOURCE_CAPS']), 'E_SCHEMA')
  elif desc == 'nullable_selected_bound_role':
    _need(value is None or (type(value) is str and value in [r for r in _enum(cat, 'finite8_role') if r.endswith('_bound')]), 'E_SCHEMA')
  elif desc in ('fact3', 'ordinary_pin') or (desc.endswith('_fact3') and (not desc.startswith('nullable'))):
    _pin(value)
  elif desc.endswith('_or_null_only_composer'):
    if type(parent) is dict and parent.get('role') == 'composer':
      _need(value is None, 'E_SCHEMA')
    else:
      _type(value, desc[:-len('_or_null_only_composer')], cat, parent)
  elif desc == 'nullable_native_absolute_path_only_composer':
    _need(type(parent) is dict, 'E_SCHEMA')
    if parent.get('role') == 'composer':
      _need(value is None, 'E_SCHEMA')
    else:
      _path(value)
  elif desc == 'builtin_bool_true_except_composer':
    _need(type(parent) is dict and value is (parent.get('role') != 'composer'), 'E_SCHEMA')
  elif desc.startswith('nullable_'):
    if value is not None:
      _type(value, desc[len('nullable_'):], cat, parent)
  elif desc in ('native_absolute_path', 'native_path'):
    _path(value)
  elif desc == 'safe_relative_path':
    _need(type(value) is str and len(value) <= 512 and (re.fullmatch('[A-Za-z0-9_./-]+', value) is not None) and (not value.startswith('/')) and all((x not in ('', '.', '..') for x in value.split('/'))), 'E_PATH')
  elif desc.startswith('actor_'):
    _actor(value, not desc.startswith('actor_nonroot'))
  elif desc == 'root_uuid':
    _need(type(value) is str and re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', value) is not None, 'E_ROOT_THREAD')
  elif desc in ('utc6', 'utc7'):
    _time(value, 6 if desc == 'utc6' else 7)
  elif desc in ('lower_ascii_hex64', 'lower_ascii_hex32'):
    _need(type(value) is str and re.fullmatch('[0-9a-f]{' + ('64' if desc.endswith('64') else '32') + '}', value) is not None, 'E_SCHEMA_VALUE')
  elif desc == 'exact_role_cap':
    _need(type(parent) is dict and type(parent.get('role')) is str and (type(value) is int) and (value == (65536 if parent['role'] == 'composer' else cat['ROLE_SOURCE_CAPS'].get(parent['role']))), 'E_ROLE_CAP')
  elif desc.startswith('positive_builtin_int') or desc.startswith('nonnegative_builtin_int') or desc == 'exact_role_or_metadata_cap':
    _need(type(value) is int and value >= (0 if desc.startswith('nonnegative') else 1) and (desc != 'exact_role_or_metadata_cap' or value <= CAP), 'E_SCHEMA')
