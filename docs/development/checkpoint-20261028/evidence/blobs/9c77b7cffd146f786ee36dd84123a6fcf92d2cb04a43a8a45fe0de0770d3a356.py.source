  _need(value['raw9'] == path and value['shared_descriptor7'] == shared == [desc[i] for i in (0, 1, 2, 3, 6, 7, 8)] and (path[2] == desc[2] == pin['bytes']) and (path[6] == desc[6] == 1) and (path[5] & 61440 == desc[5] & 61440 == 32768) and (not path[7] & 1024) and (not desc[7] & 1024) and (path[8] > 0) and (_time(value['observed_utc']) <= g.final_now), 'E_OBSERVATION')
  return path[8]
def _purpose(g, support, request_pin, request, expected, births, outputs):
  _schema(support, 'support3', g.c)
  purpose = g.s.record(support['subject'])
  _schema(purpose, 'publisher_purpose12', g.c)
  _need(purpose['Root_thread'] == g.root and _same(purpose['actual_Root_request'], request_pin) and _same(purpose['current_owner_scope'], request['current_owner_support']['current_owner_scope']) and (purpose['selected_roles'] == [request['role']]) and _same(purpose['inputs'], expected), 'E_PURPOSE_INPUTS')
  planned = purpose['output_paths']
  _need(len(planned) == 3 and set(planned) == set(outputs) and (len({p.casefold() for p in planned}) == 3), 'E_PURPOSE_OUTPUTS')
  aux = [support['subject'], support['different_review'], support['Root_adoption']]
  cap = g.s.record(support['different_review'])
  _schema(cap, 'purpose_capsule15', g.c)
  full_pin = cap['full_proof']
  full = g.s.record(full_pin)
  _schema(full, 'purpose_full17', g.c)
  adoption = g.s.record(support['Root_adoption'])
  _schema(adoption, 'purpose_adoption11', g.c)
  subjects = [support['subject']] + expected
  for value in (cap, full, adoption):
    _need(_same(value['purpose'], purpose) and _same(value['subjects'], subjects), 'E_PROOF')
  who = cap['reviewer'].casefold()
  _need(all((who != actor and (actor == '/root' or not who.startswith(actor + '/')) for actor in g.excluded)) and full['reviewer'] == cap['reviewer'] and _same(cap['scope'], support['subject']) and _same(full['scope'], support['subject']), 'E_REVIEWER')
  names = [c['name'] for c in full['checks']]
  _need(len(names) == len(set(names)) and set(g.c['publisher_purpose_proof_policy']['required_check_names']) <= set(names) and (type(cap['checks_passed']) is int) and (cap['checks_passed'] == full['checks_passed'] == len(names)), 'E_PROOF')
  reviews = full['subject_reviews']
  _need(len(reviews) == len(subjects) and all((_same(row['subject'], subject) and row['subject_kind'] == ('publication_purpose' if i == 0 else 'actual_input') for i, (row, subject) in enumerate(zip(reviews, subjects)))), 'E_PROOF')
  _need(_same(adoption['different_review'], support['different_review']) and _same(adoption['full_proof'], full_pin), 'E_ADOPTION')
  born = births.get(support['subject']['path'])
  _need(type(born) is int and born > 0 and all((pin['path'] in births and births[pin['path']] <= _time(purpose['created_utc']) * 100 for pin in expected)), 'E_CHRONOLOGY')
  _need(_time(request['created_utc']) <= _time(purpose['created_utc']) and born // 100 <= _time(cap['created_utc']) == _time(full['created_utc']) <= _time(adoption['created_utc']) <= g.now, 'E_CHRONOLOGY')
  _need(all((type(births.get(pin['path'])) is int and 0 < births[pin['path']] <= _time(adoption['created_utc']) * 100 for pin in (support['different_review'], full_pin))), 'E_CHRONOLOGY')
  aux.append(full_pin)
  _need(not {p['path'].casefold() for p in aux + expected} & {p.casefold() for p in outputs} and (not {p['path'].casefold() for p in aux} & {p['path'].casefold() for p in expected}), 'E_PURPOSE_CYCLE')
  return (support['subject'], purpose)
def _prewrite(g, p, records, catalogue_bytes, m3, peer, evaluation):
  _dispatch(p, 'prewrite_packet15', g)
  _need(p['Root_thread'] == g.root, 'E_ROOT_THREAD')
  req = g.s.record(p['request'])
  _dispatch(req, 'selected_request25', g)
  _need(req['Root_thread'] == g.root and _same(req['author_packet'], p['author_packet']) and all((_same(req[k], p[k]) for k in ('current_owner_support', 'new_lease_support', 'Root_future_path_selection_support', 'publisher_support'))), 'E_REQUEST_OWNERSHIP')
  _need(_time(p['recorded_evaluation_utc']) == evaluation and p['recorded_evaluation_utc'] == g.eval_text, 'E_CHRONOLOGY')
  g.now = evaluation
  g.births = p['recorded_births_ns']
  g.prime(p)
  g.prime(req)
  author = g.s.record(p['author_packet'])
  g.prime(author)
  g.collect(author, p['author_packet'])
  if req['author_kind'] == 'selected_peer_receipt27_v2':
    inner = g.s.record(author.get('peer_packet'))
    g.collect(inner, author['peer_packet'])
    g.prime(inner)
  own, lease, selection = g.common(p['current_owner_support'], p['new_lease_support'], p['Root_future_path_selection_support'])
  _publisher_code(g, p['publisher_support'])
  for key, module in (('M3', m3), ('PEER', peer)):
    _port(g, key, module, p['validator_supports'][key])
  role, kind = (req['role'], req['author_kind'])
  row = g.rows[role]
  _need(req['draft']['path'] == row['draft_path'] and req['canonical_path'] == row['canonical_path'] and _same(req['predecessor'], row['predecessor']) and (req['source_cap'] == row['source_cap']) and (req['draft']['sha256'] != req['predecessor']['sha256']), 'E_DEPENDENCY_JOIN')
  g.s.body(req['draft'], req['source_cap'])
  g.s.body(req['predecessor'], req['source_cap'])
  if kind == 'M3_stage_receipt22_v2':
    _schema(author, 'm3_packet16', g.c)
    artifacts = [a for a in author['artifacts'] if a['role'] == role]
    _need(len(artifacts) == 1, 'E_STAGE_GROUP')
    a = artifacts[0]
    roster = [a['draft'], a['author_receipt'], a['diff'], author['stage_support']['facts'], req['producer_support']['Source'], req['producer_support']['API']]
    expected = dict(validator='M3_complete_stage_output', role=author['role'], stage=author['stage'], validated_stage_roles=[a['role'] for a in author['artifacts']], author_receipt=None, draft=None, predecessor=None)
    key, module, name = ('M3', m3, 'validate_M3_complete_stage_output_metadata')
  elif kind == 'guard_profile_static_v2':
    _schema(author, 'guard_packet14', g.c)
    a = author
    receipt = g.s.record(author['author_receipt'])
    _schema(receipt, 'guard_author24', g.c)
    roster = [author['draft'], author['author_receipt'], receipt['diff'], author['producer_purpose_support']['subject'], req['producer_support']['Source'], req['producer_support']['API']]
    expected = dict(validator='guard_profile_static_descriptor', role=role, stage=None, validated_stage_roles=[role], author_receipt=req['author_receipt'], draft=req['draft'], predecessor=req['predecessor'])
    key, module, name = ('M3', m3, 'validate_guard_profile_static_descriptor_metadata')
  else:
    _closed(author, g.c['schemas']['peer_author_wrapper14']['exact_keys'])
    _need(type(author['schema_version']) is int and author['schema_version'] == 2 and (author['record_type'] == 'Root_owner_v2_selected_peer_canonical_author_metadata_packet') and (author['role'] == role) and (author['Root_thread'] == g.root) and all((author[k] is False for k in ('target_execution', 'operational_authority'))) and (author['source_only'] is True), 'E_SCHEMA')
    a = dict(author_receipt=inner['receipt'], draft=inner['draft'], predecessor=inner['predecessor'])
    roster = [inner[k] for k in ('draft', 'receipt', 'content_decision', 'serialization_witness', 'inverse_evidence')] + [req['producer_support']['Source'], req['producer_support']['API']]
    expected = dict(validator='selected_peer_author_packet', role=role, stage=None, validated_stage_roles=[role], author_receipt=req['author_receipt'], draft=req['draft'], predecessor=req['predecessor'])
    key, module, name = ('PEER', peer, 'validate_selected_peer_author_packet_metadata')
  _need(all((_same(req[k], a[k]) for k in ('draft', 'predecessor', 'author_receipt'))) and _same(req['producer_support'], author['producer_support']), 'E_DEPENDENCY_JOIN')
  common = dict(author_kind=kind, packet=p['author_packet'], author_packet=p['author_packet'], current_owner_scope=p['current_owner_support']['current_owner_scope'], canonical_lease=p['new_lease_support']['canonical'], selection=p['Root_future_path_selection_support']['selection'], producer_Source=req['producer_support']['Source'], producer_API=req['producer_support']['API'], request=None, canonical=None, publisher_Source=None, publisher_API=None, publisher_purpose=None, publication=None, reconciliation=None, validated_now_utc=g.eval_text)
  expected.update(common)
  view = _direct(g, key, module, name, g.s.body(p['author_packet']), expected, records, catalogue_bytes, g.eval_text)
  _schema(req['author_packet_support'], 'support3', g.c)
  _schema(req['draft_support'], 'support3', g.c)
  _need(_same(req['author_packet_support']['subject'], p['author_packet']) and _same(req['draft_support']['subject'], req['draft']), 'E_PROOF')
  for support, subjects in ((req['author_packet_support'], [p['author_packet']]), (req['draft_support'], roster)):
    proof = g.proof(support['different_review'], subjects)
    ad = g.adoption(support['Root_adoption'], subjects, support['different_review'], proof, p['current_owner_support']['current_owner_scope'], p['Root_future_path_selection_support']['selection'])
    _need(_time(ad['created_utc']) <= _time(req['created_utc']), 'E_CHRONOLOGY')
  expected_inputs = p['expected_inputs']
  required = _declared(req)+[p['request']]+_declared(p['validator_supports'])+_declared(author)
  if kind == 'M3_stage_receipt22_v2':
    facts = g.s.record(author['stage_support']['facts']); required += _declared(facts)
    required += _declared(g.s.record(author['generation_purpose_support']['subject']))
  elif kind == 'selected_peer_receipt27_v2': required += _declared(inner)
  required += list(g.s.used.values())
  aux = p['publisher_purpose_support']; caps = g.s.record(aux['different_review'])
  omitted = {x['path'] for x in (aux['subject'],aux['different_review'],aux['Root_adoption'],_pin(caps.get('full_proof')))} | getattr(g,'future',set()) | {g.packet_pin['path']}
  required = [x for x in required if x['path'] not in omitted]
  _need(all((any((_same(pin, x) for x in expected_inputs)) for pin in required)), 'E_PURPOSE_INPUTS')
  for pin in expected_inputs:
    g.s.body(pin)
  births = p['recorded_births_ns']
  _resource(p['resource'], g.now)
  for pin in required:
    _need(type(births.get(pin['path'])) is int and births[pin['path']] > 0, 'E_CHRONOLOGY')
  purpose = g.s.record(p['publisher_purpose_support']['subject'])
  _schema(purpose, 'publisher_purpose12', g.c)
  staging = [path for path in purpose['output_paths'] if path not in (req['canonical_path'], req['publication_receipt_path'])]
  _need(len(staging) == 1 and staging[0].rsplit('\\', 1)[0] == req['canonical_path'].rsplit('\\', 1)[0] and (staging[0].casefold() not in {req['canonical_path'].casefold(), req['draft']['path'].casefold(), req['publication_receipt_path'].casefold()}), 'E_PURPOSE_OUTPUTS')
  purpose_pin, purpose = _purpose(g, p['publisher_purpose_support'], p['request'], req, expected_inputs, births, [req['canonical_path'], req['publication_receipt_path'], staging[0]])
  return (req, view, purpose_pin, staging[0])
def _outer_result(g, req, view, validator, request_pin, purpose, canonical=None, publication=None, reconciliation=None):
  fields = g.c['schemas']['result54']['fields']
  out = {k: rule['literal'] if type(rule) is dict and 'literal' in rule else None for k, rule in fields.items()}
  out.update(validator=validator, author_kind=req['author_kind'], role=req['role'], packet=g.packet_pin, author_packet=req['author_packet'], author_receipt=req['author_receipt'], draft=req['draft'], predecessor=req['predecessor'], request=request_pin, publisher_purpose=purpose, producer_Source=req['producer_support']['Source'], producer_API=req['producer_support']['API'], publisher_Source=req['publisher_support']['Source'], publisher_API=req['publisher_support']['API'], current_owner_scope=req['current_owner_support']['current_owner_scope'], canonical_lease=req['new_lease_support']['canonical'], selection=req['Root_future_path_selection_support']['selection'], stage=view['stage'], validated_stage_roles=view['validated_stage_roles'], canonical=canonical, publication=publication, reconciliation=reconciliation, validated_now_utc=g.now_text, record_count=len(g.s.entries), total_record_bytes=g.s.total, charged_metadata_nodes=0)
  _tree(out, g.s.count)
  out['charged_metadata_nodes'] = g.s.count[0]
  return _wire(out)
def validate_selected_role_prewrite_metadata(*, packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc, m3, peer):
  g = _Graph(packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc)
  g.now_text = g.eval_text = now_utc
  g.final_now = g.now
  req, view, purpose, staging = _prewrite(g, g.p, records, catalogue_bytes, m3, peer, g.now)
  return _outer_result(g, req, view, 'selected_role_prewrite', g.p['request'], purpose)
def validate_selected_role_canonical_dependency_metadata(*, packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc, m3, peer):
  g = _Graph(packet, records, catalogue_bytes, expected_root_thread, source_editor, now_utc)
  g.now_text = now_utc
  g.final_now = g.now
  p = g.p
  _dispatch(p, 'canonical_packet14', g)
  _need(p['Root_thread'] == g.root, 'E_ROOT_THREAD')
  g.future = {g.packet_pin['path'],p['prewrite_packet']['path'],p['canonical']['path'],p['publication']['path'],p['execution_witness']['path'],p['reconciliation']['path']}
  for support in (p['canonical_delta_support'],p['reconciliation_support']):
    g.future.update((support['subject']['path'],support['different_review']['path'],support['Root_adoption']['path']))
    cap = g.s.record(support['different_review']); g.future.add(_pin(cap.get('full_proof'))['path'])
  g.prime(p)
  before = g.s.record(p['prewrite_packet'])
  _dispatch(before, 'prewrite_packet15', g)
  g.eval_text = before['recorded_evaluation_utc']
  evaluation = _time(g.eval_text)
  _need(evaluation <= g.final_now, 'E_CHRONOLOGY')
  req, view, purpose, staging = _prewrite(g, before, records, catalogue_bytes, m3, peer, evaluation)
  g.now = g.final_now
  del g.births
  _need(p['role'] == req['role'] and p['author_kind'] == req['author_kind'] and _same(p['author_packet'], req['author_packet']), 'E_REQUEST_OWNERSHIP')
  pub = g.s.record(p['publication'])
  _dispatch(pub, 'selected_publication32', g)
  expected = dict(Root_thread=g.root, request_id=req['request_id'], author_kind=req['author_kind'], role=req['role'], actual_Root_request=before['request'], prewrite_packet=p['prewrite_packet'], publication_purpose_support=before['publisher_purpose_support'], current_owner_scope=req['current_owner_support']['current_owner_scope'], new_canonical_lease=req['new_lease_support']['canonical'], Root_future_path_selection=req['Root_future_path_selection_support']['selection'], producer_support=req['producer_support'], publisher_support=req['publisher_support'], author_packet=req['author_packet'], author_receipt=req['author_receipt'], predecessor=req['predecessor'], draft=req['draft'], canonical=p['canonical'], source_cap=req['source_cap'])
  _need(all((_same(pub.get(k), v) for k, v in expected.items())) and p['publication']['path'] == req['publication_receipt_path'] and (p['canonical']['path'] == req['canonical_path']), 'E_DEPENDENCY_JOIN')
  pair = pub['actual_publication_metadata_APIs']
  staged = dict(path=staging, bytes=req['draft']['bytes'], sha256=req['draft']['sha256'])
  born = _observe(g, pair['canonical'], p['canonical'], req['source_cap'])
  _observe(g, pair['staging'], staged, req['source_cap'])
  _need(g.s.body(p['canonical'], req['source_cap']) == g.s.body(req['draft'], req['source_cap']) == g.s.body(staged, req['source_cap']), 'E_DEPENDENCY_JOIN')
  post = pub['complete_input_postreads']
  _need(len(post) == len(before['expected_inputs']), 'E_OBSERVATION')
  for observation, pin in zip(post, before['expected_inputs']):
    cap = next((r['source_cap'] for r in g.rows.values() if pin['path'] in (r['canonical_path'], r['draft_path'], r['predecessor']['path'])), CAP)
    actual_born = _observe(g, observation, pin, cap)
    _need(before['recorded_births_ns'].get(pin['path']) == actual_born, 'E_CHRONOLOGY')
  witness = g.s.record(p['execution_witness'])
  _schema(witness, 'execution_witness16', g.c)
  _need(witness['Root_thread'] == g.root and _same(witness['request'], before['request']) and _same(witness['publication'], p['publication']) and _same(witness['publisher_Source'], req['publisher_support']['Source']) and _same(witness['publisher_API'], req['publisher_support']['API']) and _same(witness['outputs'], [p['canonical'], p['publication']]), 'E_DEPENDENCY_JOIN')
  _need(evaluation <= born // 100 <= _time(pub['created_utc']) <= _time(witness['created_utc']) <= g.final_now and _time(witness['started_utc']) <= _time(witness['completed_utc']) <= _time(witness['created_utc']), 'E_CHRONOLOGY')
  delta_subjects = [p['canonical'], req['draft'], p['publication'], p['execution_witness']]
  _need(_same(p['canonical_delta_support']['subject'], p['canonical']), 'E_PROOF')
  dr = g.proof(p['canonical_delta_support']['different_review'], delta_subjects)
  da = g.adoption(p['canonical_delta_support']['Root_adoption'], delta_subjects, p['canonical_delta_support']['different_review'], dr, req['current_owner_support']['current_owner_scope'], req['Root_future_path_selection_support']['selection'])
  recon = g.s.record(p['reconciliation'])
  _dispatch(recon, 'selected_reconciliation25', g)
  expected = dict(Root_thread=g.root, author_kind=req['author_kind'], role=req['role'], current_owner_scope=req['current_owner_support']['current_owner_scope'], new_canonical_lease=req['new_lease_support']['canonical'], Root_future_path_selection=req['Root_future_path_selection_support']['selection'], initial_actual_Root_request=before['request'], initial_actual_canonical_publication_receipt=p['publication'], initial_actual_execution_witness=p['execution_witness'], prior_actual_publisher_support=req['publisher_support'], exact_draft_Source=req['draft'], canonical_Source=p['canonical'], actual_canonical_delta_Source_review=p['canonical_delta_support']['different_review'], canonical_delta_Root_adoption=p['canonical_delta_support']['Root_adoption'])
  _need(all((_same(recon.get(k), v) for k, v in expected.items())) and _time(recon['canonical_Source_birth_utc'], 7) * 100 == born, 'E_DEPENDENCY_JOIN')
  _need(_time(witness['created_utc']) <= _time(dr[0]['created_utc']) <= _time(da['created_utc']) <= _time(recon['created_utc']) <= g.final_now, 'E_CHRONOLOGY')
  _need(_same(p['reconciliation_support']['subject'], p['reconciliation']), 'E_PROOF')
  subjects = [p['reconciliation'], p['canonical_delta_support']['different_review'], dr[2], p['canonical_delta_support']['Root_adoption']]
  rr = g.proof(p['reconciliation_support']['different_review'], subjects)
  g.adoption(p['reconciliation_support']['Root_adoption'], subjects, p['reconciliation_support']['different_review'], rr, req['current_owner_support']['current_owner_scope'], req['Root_future_path_selection_support']['selection'])
  _need(_time(recon['created_utc']) <= _time(rr[0]['created_utc']), 'E_CHRONOLOGY')
  return _outer_result(g, req, view, 'selected_role_canonical_dependency', before['request'], purpose, p['canonical'], p['publication'], p['reconciliation'])
def publish_selected_role_current_owner(*, context):
  if not ACTUAL_ENTRY_QUALIFIED:
    raise I13MetadataError('E_ACTUAL_ENTRY_HELD')
  raise I13MetadataError('E_ACTUAL_ENTRY_UNWIRED')
def _within(kind, value, cat):
  if kind in ('selected_request25', 'selected_publication32', 'selected_reconciliation25', 'canonical_packet14'):
    domains = {'M3_stage_receipt22_v2': 'M3_selected_roles', 'selected_peer_receipt27_v2': 'peer_selected_roles', 'guard_profile_static_v2': 'guard_role'}
    _need(type(value['author_kind']) is str and value['author_kind'] in domains, 'E_UNSUPPORTED_AUTHOR_KIND')
    _need(value['role'] in cat['enums'][domains[value['author_kind']]], 'E_SCHEMA_VALUE')
  if kind == 'selected_publication32':
    _need(value['canonical']['sha256'] == value['draft']['sha256'] and value['canonical']['bytes'] == value['draft']['bytes'] and (value['predecessor']['sha256'] != value['draft']['sha256']), 'E_SCHEMA_VALUE')
  if kind == 'selected_reconciliation25':
    _need(value['canonical_Source']['sha256'] == value['exact_draft_Source']['sha256'] and value['canonical_Source']['bytes'] == value['exact_draft_Source']['bytes'], 'E_SCHEMA_VALUE')
