"""Root genuine Source review of architect-authored metadata helpers only."""
import ast,base64,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;OUT=R/'Root_bundle_publication_helpers_Source_review_001';checks=[]
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def ck(name,ok,evidence):
 checks.append(dict(name=name,passed=bool(ok),evidence=evidence));assert ok,name
def src(p):
 b=p.read_bytes();t=ast.parse(b);compile(t,str(p),'exec');return b,t,{n.name:ast.unparse(n) for n in t.body if isinstance(n,ast.FunctionDef)}
def has(name,text,parts):
 for i,s in enumerate(parts):ck(name+'_'+str(i+1),s in text,s)
bundle=R/'prepare_I13_metadata_helper_source_bundles_001.py';pub=R/'prepare_I13_managed_candidate_003.py';receipt=R/'I13_BUNDLE_AWARE_MANAGED_HELPER003_AND_BUNDLE_AUTHOR001_SOURCE_AUTHOR_RECEIPT_001.json'
bb,bt,bf=src(bundle);pb,pt,pf=src(pub);r=json.loads(receipt.read_bytes());old=R/'prepare_I13_managed_candidate_002.py'
ck('bundle_exact',pin(bundle)['sha256']=='8f88e6a708dff41bc15ec675a4d54460c5da6cbb6b2af5eb8fef630b369c0c29',pin(bundle));ck('publication_exact',pin(pub)['sha256']=='4cddbda924bdccb2572d7ba131afb1a4d66a5572f9c9c100fbd7bfea794e01c2',pin(pub))
ck('whole_predecessor_inverse',base64.b64decode(r['whole_predecessor_Source_bytes_base64'],validate=True)==old.read_bytes(),pin(old))
ck('source_editor_distinct','/root/project_architecture' in bb.decode() and '/root/project_architecture' in pb.decode(),dict(reviewer='/root',editor='/root/project_architecture'))
for label,functions,tree in (('bundle',bf,bt),('publication',pf,pt)):
 imports=[n for n in ast.walk(tree) if isinstance(n,(ast.Import,ast.ImportFrom))];names=[]
 for n in imports:names.extend([x.name for x in n.names] if isinstance(n,ast.Import) else [n.module])
 ck(label+'_stdlib_only',set(names)<={'base64','datetime','hashlib','json','os','pathlib','sys'},names)
 calls=[n.func.id for n in ast.walk(tree) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name)]
 ck(label+'_no_member_loading_or_execution',not any(n in calls for n in ('exec','eval','compile','__import__','open')),calls)
 has(label+'_stable_body',functions['body'],['is_absolute()', 'lstat()', 'is_symlink()', '1024', 'st_nlink == 1', 'read(CAP + 1)', 'seek(0)', 'raw == again', 'st_ino', 'st_mtime_ns', 'st_ctime_ns'])
 has(label+'_strict_decode',functions['decode'],['object_pairs_hook=pairs','parse_float=bad','parse_constant=bad'])
 has(label+'_closed_fact',functions['fact'],["{'path', 'bytes', 'sha256'}","type(value['bytes']) is int",'CAP',"'0123456789abcdef'",'is_absolute()'])
 has(label+'_fresh',functions['fresh'],['exact(', 'interval_start', 'interval_end', '> 60', 'new_operational_execution_lease_issued', 'is False'])
 has(label+'_save',functions['save'],['not os.path.lexists(path)','fresh()',"open('xb')",'flush()', 'os.fsync(', 'body(path) == raw','is_symlink()', '1024'])
 ck(label+'_two_pre_mutation_fresh_checks',functions['save'].count('fresh()')==2,functions['save'])
has('bundle_create',bf['create'],['adoption(decode(adoption_raw), own)','member_count', '160','1353151','512','67108864','is_relative_to(ROOT)','not path.is_relative_to(SUBJECTS)','not path.is_relative_to(PUB)',"path.suffix == '.py'",'base64.b64encode(raw)', 'base64.b64decode(text, validate=True) == raw','groups = []','tentative = current + [member]','> CAP','not os.path.lexists(OUT)','exact(member[\'original\'])','mapping.append','member_ordinal=i','[m[\'original\'] for m in mapping] == members'])
has('prepare_exact_direct_roster',pf['prepare'],['bundle_evidence(bundle_review_adoption)','source_pin == omitted[str(source)]','only exact frozen Source member omitted','actual_omitted.append','all160 and only frozen exact helpers bundled','every bundle/index direct copied','len(rows) <= 512','<= 67108864','unique managed destinations','all managed file identities unused','source_copy_inert','metadata_helper_bundles=evidence'])
has('publish_revalidates',pf['publish'],['adopted(decode(adoption_raw), candidate_pin)','publication_helper','pin(Path(__file__))','evidence == value[\'metadata_helper_bundles\']','len(rows) <= 512','<= 67108864','unique actual destinations','not os.path.lexists(destination)','pin(source) == row[\'source\']','fresh()','save(Path(row[\'destination\']), raw)','bundle_copy=copies[m[\'bundle\'][\'path\']]','member_ordinal=m[\'member_ordinal\']','final_preservation=baseline()'])
has('reconstruction_join',pf['bundle_evidence'],['decode(exact(BUNDLE_PLAN))','decode(exact(BUNDLE_PLAN_ADOPTION))','BUNDLE_AUTHOR_SOURCE','bundle_author_Source_Root_adoption','adopted(decode(review_raw), index_pin)','base64.b64decode(member[\'canonical_base64\'], validate=True)','decoded == exact(original)','base64.b64encode(decoded).decode(\'ascii\') == member[\'canonical_base64\']','mapping == index[\'members\']','len(mapping) == 160'])
has('preservation',pf['baseline'],['409','6','2',"pin(Path(p['path'])) == p",'current_workspace_pointer'])
ck('actual_outputs_absent',not (R/'metadata_helper_source_bundles_001').exists() and not (R/'publication_001/ROOT_I13_EXACT_MANAGED_PUBLICATION_CANDIDATE_001.json').exists(),dict(bundles=False,candidate=False))
now=dt.datetime.now(dt.timezone.utc);scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';sv=json.loads(scope.read_bytes());ck('source_window_current',(dt.datetime.fromisoformat(sv['interval_end'])-now).total_seconds()>60,sv['interval_end'])
v=dict(schema_version=1,record_type='Root_genuine_different_architect_bundle_publication_helpers_Source_review',reviewer='/root',source_author='/root/project_architecture',created_utc=now.isoformat(),verdict='PASS_EXACT_METADATA_HELPERS_SOURCE_ONLY',subjects=dict(bundle_author=pin(bundle),publication_helper=pin(pub),author_receipt=pin(receipt)),checks=checks,checks_passed=len(checks),checks_failed=0,limitations=['Source review only; no helper call or actual bundle/index/candidate/managed copy','Final growing512-row64MiB inventory must pass or refuse; caps unwaived','Suffix-only field describes direct copies;160 whole Sources are separately represented in exact Base64 bundles with mappings'],target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
OUT.mkdir();full=OUT/'ROOT_DIFFERENT_I13_BUNDLE_PUBLICATION_HELPERS_SOURCE_FULL_PROOF_001.json'
with full.open('xb') as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
cap=OUT/'ROOT_DIFFERENT_I13_BUNDLE_PUBLICATION_HELPERS_SOURCE_CAPSULE_001.json';small={k:x for k,x in v.items() if k!='checks'};small['full_proof']=pin(full)
with cap.open('xb') as h:h.write((json.dumps(small,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(capsule=pin(cap),full_proof=pin(full),checks=len(checks),helper_calls=0)))
