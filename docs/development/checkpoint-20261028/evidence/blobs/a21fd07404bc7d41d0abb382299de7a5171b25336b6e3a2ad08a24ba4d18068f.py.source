"""Root metadata-only Source selection successor author."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
v=json.loads((C/'I13_FINAL_SOURCE_SELECTION_INPUT_002.json').read_bytes())
for key,s,a in [('m3','validate_M3_guard_contract_metadata_009.py','CURRENT_OWNER_M3_GUARD_CONTRACT_METADATA_INERT_API_009.json'),('peer','validate_selected_peer_author_packet_metadata_009.py','CURRENT_OWNER_SELECTED_PEER_CANONICAL_AUTHOR_METADATA_INERT_API_009.json'),('publisher','validate_selected_role_publisher_metadata_004.py','CURRENT_OWNER_SELECTED_ROLE_PUBLISHER_METADATA_INERT_API_004.json')]:
 v['modules'][key]=str(T/s);v['APIs'][key]=str(T/a)
v['fixtures']=dict(m3_publisher=str(T/'exercise_M3_guard_and_publisher_metadata_memory_008.py'),peer=str(T/'exercise_selected_peer_author_metadata_memory_006.py'))
p=C/'I13_FINAL_SOURCE_SELECTION_INPUT_003.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:h.write(b)
print(json.dumps(dict(selection=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),target_execution=False)))
