def H(b): return hashlib.sha256(b).hexdigest()
def fact(p,b=None):
    p=Path(p); b=p.read_bytes() if b is None else b
    return dict(path=str(p),bytes=len(b),sha256=H(b))
def ck(n,v,e): checks.append(dict(name=n,passed=bool(v),evidence=e))
def pairs(rows):
    out={}
    for k,v in rows:
        if k in out: raise ValueError('duplicate key '+k)
        out[k]=v
    return out
def bad(v): raise ValueError('noninteger JSON '+v)
def dec(b): return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def rb(label,p,expected=None):
    p=Path(p); b=p.read_bytes(); subjects[label]=fact(p,b)
    ck(label+'_ordinary_absolute',p.is_absolute() and p.is_file() and not p.is_symlink(),str(p))
    if expected: ck(label+'_exact_pin',subjects[label]==expected if isinstance(expected,dict) else (len(b),H(b))==expected,subjects[label])
    ck(label+'_original_2MiB_cap',len(b)<=2097152,len(b)); return b
def js(label,p,expected=None):
    b=rb(label,p,expected);v=dec(b);ck(label+'_strict_JSON_object',type(v) is dict,'UTF8 unique keys; no float/nonfinite values');return v
def parse(label,p,expected=None):
    b=rb(label,p,expected);s=b.decode('utf8');t=ast.parse(s);compile(t,'<Source review only '+label+'>','exec');return b,s,t
def dump(n): return ast.dump(n,include_attributes=False)
def top(t): return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def methods(c): return {n.name:n for n in c.body if isinstance(n,ast.FunctionDef)}
def assign(t): return {n.targets[0].id:n.value for n in t.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
def invert(label,receipt):
    v=js(label,receipt['path'],receipt);before=rb(label+'_whole_before',v['predecessor_Source']['path'],v['predecessor_Source'])
    ck(label+'_whole_before_base64_inverse',base64.b64decode(v['whole_predecessor_Source_bytes_base64'],validate=True)==before,v['predecessor_Source']);return v,before
def literal_json(v):
    if type(v) is bytes:return dict(AST_builtin_type='bytes',canonical_base64=base64.b64encode(v).decode('ascii'))
    if type(v) is dict:return {k:literal_json(x) for k,x in v.items()}
    if type(v) is list:return [literal_json(x) for x in v]
    return v

