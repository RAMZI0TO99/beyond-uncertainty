"""One explicit Root metadata decision after independent saved-refusal review."""
import datetime as dt,hashlib,json,os,stat
from pathlib import Path
R=Path(__file__).parent
def need(v,m):
 if not v:raise ValueError(m)
def vec(x):return dict(device=x.st_dev,inode=x.st_ino,mode=x.st_mode,links=x.st_nlink,bytes=x.st_size,last_write_ns=x.st_mtime_ns,ctime_ns=x.st_ctime_ns,file_attributes=getattr(x,'st_file_attributes',0))
def sample(p):
 p=Path(p)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'nonreparse metadata lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded ordinary saved metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();vs=[vec(x) for x in (a,d,e,z)];return b,vs,all(x==vs[0] for x in vs) and len(b)==a.st_size
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def raw(p):
 b,vs,ok=sample(p);need(ok,'stable current exact8 metadata read');return b
def pairs(xs):
 d={}
 for k,v in xs:need(k not in d,'duplicate JSON');d[k]=v
 return d
def bad(x):raise ValueError('noninteger/nonfinite own metadata')
def doc(p,sha):
 b=raw(p);need(hashlib.sha256(b).hexdigest()==sha,'exact reviewSHA');return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad),pin(p,b)
def fresh():
 n=dt.datetime.now(dt.timezone.utc);need(n.date()==dt.date(2026,10,28) and n<dt.datetime(2026,10,28,10,29,tzinfo=dt.timezone.utc),'new15strict60');return n.isoformat()
fresh()
cp=R/'adoption_refusal_different_review_001/INDEPENDENT_SOURCE015_METADATA_ADOPTION_REFUSAL_CURRENT_RECONCILIATION_CAPSULE_002.json'
c,cf=doc(cp,'c135b29a7bfa32d3f3bd7c1c58c0120d89b8c128faf56f079ff5326bb0d79ec7')
f,ff=doc(Path(c['full_proof']['path']),c['full_proof']['sha256']);need(ff==c['full_proof'],'fullF3')
need(c['reviewer']==f['reviewer']=='/root/coexistence014_final_review' and c['verdict']==f['verdict']=='PASS_SOURCE015_SAVED_METADATA_REFUSAL_CURRENT_RECONCILIATION' and c['checks_passed']==f['checks_passed']==116 and c['checks_failed']==f['checks_failed']==0 and c['remaining_actionable_findings']==f['remaining_actionable_findings']==[],'genuine corrected review')
need(len(f['checks'])==len({x['name'] for x in f['checks']})==116 and all(x['passed'] is True for x in f['checks']),'all positiveuniquechecks')
need(c['current_seven_input_pins']==f['current_seven_input_pins'] and len(c['current_seven_input_pins'])==7,'exact currentinputs')
observed=[];stable=True
for p in c['current_seven_input_pins']+c['reviewed_artifacts']:
 b,vs,ok=sample(p['path']);actual=pin(p['path'],b);need(actual==p,'unchanged F3');observed.append(dict(pin=p,current_full_eight_vectors=vs,within_read_eight_field_guard_passed=ok));stable=stable and ok
names=[]
with os.scandir(R) as it:
 for entry in it:names.append(entry.name);need(len(names)<=128,'bounded savednamespace')
target='ROOT_PRO3_SOURCE_ONLY_COEXISTENCE015_DIFFERENT_REVIEW_ADOPTION_001.json';need(target not in names,'adoptionexists doNOTinvokeagain')
selfb=raw(Path(__file__))
out=dict(record_type='Root_explicit_Source015_metadata_adoption_attempt002_decision',created_utc=fresh(),author='/root',decision='PERMIT_EXACT_ONE_NEW_METADATA_ADOPTION_INVOCATION' if stable else 'REFUSE_REATTEMPT_CURRENT_EIGHT_FIELD_GUARD_NOT_STABLE',one_new_metadata_adopter_invocation_permitted=stable,original_metadata_helper_and_guard_unchanged=True,reviewed_helper=next(p for p in c['current_seven_input_pins'] if Path(p['path']).name=='prepare_or_adopt_Source015_source_only_coexistence_001.py'),genuine_refusal_reconciliation_review=cf,full_proof=ff,checks_passed=116,checks_failed=0,current_saved_metadata_observations=observed,adoption_target_absent_in_bounded_accessible_listing=True,original_attempt001_tool_chunk='6805c4',original_failed_vectors_or_cause_reconstructed=False,original_failed_cause='UNKNOWN',cross_reader_device_differences_not_interpreted_as_original_failed_cause=True,own_metadata_Source=pin(Path(__file__),selfb),limits='At most one explicit new metadata-only invocation of the unchanged reviewed Source015 adopter, using the original237-check scope-review capsule and SHA. Its original eight-field/F3/window/CreateNew guards must still pass. If this invocation refuses, preserve refusal and stop; no automatic loop. This is not a retry/replay of bootstrap004 or permission for any Source005 function/mode/helper/native/query/test/capture/request.',Source014_cutoff_not_extended='2026-10-28T09:29:00+00:00',Source015_reliance_only_after_actual_successful_adoption=True,operational_authority=False,subject_or_native_or_live_process_query_permitted=False,bootstrap_retry_or_rearm_permitted=False,custody_or_runtime_result_accepted=False,native_request_advancement_permitted=False)
b=(json.dumps(out,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();need(len(b)<2097152,'ownmetadata2MiB');fresh();p=R/'ROOT_SOURCE015_EXPLICIT_METADATA_ADOPTION_ATTEMPT002_DECISION_001.json'
with p.open('xb') as h:need(h.write(b)==len(b),'wholeCreateNew');h.flush();os.fsync(h.fileno())
need(raw(p)==b,'wholeReadback');print(json.dumps(dict(decision=pin(p,b),metadata_invocation_permitted=stable,no_subject_operation_permitted=True)))
