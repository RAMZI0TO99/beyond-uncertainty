 return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad),p

def tree(v,depth=0):
 need(depth<=48,'depth48')
 if type(v) is dict:n=1+len(v)+sum(tree(x,depth+1) for x in v.values())
 elif type(v) is list:n=1+sum(tree(x,depth+1) for x in v)
 else:n=1
 need(n<=50000,'nodes50000');return n

