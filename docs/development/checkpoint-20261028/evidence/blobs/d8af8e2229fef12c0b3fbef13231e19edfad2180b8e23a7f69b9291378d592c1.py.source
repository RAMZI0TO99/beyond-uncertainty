import datetime as dt,hashlib,json
from pathlib import Path
r=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003');w=r/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
s=r/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json';assert pin(s)['sha256']=='f3c4b711fade603e97d9e41cb26b8135914a2c1b0073cdc62084d11090a3ed66'
p=w/'canonical_peer_protocol_audit_001/INDEPENDENT_I13_ROOT_SOURCE_SCOPE_CAPSULE_001.json';assert pin(p)['sha256']=='cdfec1ff3bf7004b8c1dce165d6bd4e0de379f4c65896a2010a888466f85a691'
v=json.loads(p.read_bytes());assert v['reviewer']=='/root/i2_resume_gap' and v['checks_passed']==46 and v['checks_failed']==0 and v['verdict'].startswith('PASS_')
f=v['full_proof'];assert pin(Path(f['path']))==f
z=json.loads(Path(f['path']).read_bytes());assert len(z['checks'])==46 and len({x['name'] for x in z['checks']})==46 and all(x['passed'] is True for x in z['checks'])
a=dict(schema_version=1,record_type='Root_I13_current_Source_scope_different_review_adoption',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),verdict='ACCEPT_CURRENT_I13_SOURCE_SCHEDULING_METADATA_ONLY',source_scope=pin(s),different_Source_review=pin(p),full_proof=f,checks_passed=46,checks_failed=0,exact_target_protocol_review_and_Root_adoption_still_required=True,new_tests_need_exact_Source_adoption_and_separate_fresh_once_scope=True,existing_I0_through_I12_targets_tests_and_fixtures_not_admitted=True,original75_spent_identities_unreplayed=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
d=r/'ROOT_I13_CURRENT_SOURCE_SCOPE_DIFFERENT_REVIEW_ADOPTION_001.json'
with d.open('xb') as h:h.write((json.dumps(a,indent=2,sort_keys=True)+'\n').encode())
print(json.dumps(pin(d)))