def need(v,m):
 if not v:raise ValueError(m)
def fresh():
 n=dt.datetime.now(dt.timezone.utc)
 need(n.date()==dt.date(2026,10,28) and n<dt.datetime(2026,10,28,9,59,tzinfo=dt.timezone.utc),'Source013 current strict60 reserve')
 return n.isoformat()
def shape(v):
 todo=[(v,0)];count=0
 while todo:
  x,d=todo.pop();count+=1
  need(count<=50000 and d<=48,'metadata shape caps')
  need(x is None or type(x) in (str,int,bool,list,dict),'float-free builtins')
  if type(x)is str:need(not any(55296<=ord(c)<=57343 for c in x),'no surrogate strings')
  elif type(x)is list:todo.extend((y,d+1)for y in x)
  elif type(x)is dict:
   need(all(type(k)is str for k in x),'string keys')
   for k,y in x.items():todo.extend(((k,d+1),(y,d+1)))
def pairs(items):
 out={}
 for k,v in items:need(k not in out,'duplicate JSON key');out[k]=v
 return out
def bad(n):raise ValueError('fractional/nonfinite token '+n)
def strict(b):
 need(len(b)<=CAP,'JSON byte cap')
 v=json.loads(b.decode('utf-8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad);shape(v);return v
def vector(s):return dict(device=s.st_dev,inode=s.st_ino,mode=s.st_mode,links=s.st_nlink,bytes=s.st_size,last_write_ns=s.st_mtime_ns,creation_or_change_ns=s.st_ctime_ns,file_attributes=getattr(s,'st_file_attributes',0))
def raw(p):
 p=Path(p);need(p.is_absolute()and p.is_relative_to(R5),'Root metadata workspace')
 for q in(p,*p.parents):
  z=q.lstat();need(not stat.S_ISLNK(z.st_mode)and not getattr(z,'st_file_attributes',0)&1024,'nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode)and a.st_nlink==1 and 0<=a.st_size<=CAP,'bounded ordinary singlelink')
 with p.open('rb')as h:
  d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();vs=[vector(x)for x in(a,d,e,z)]
 need(all(v==vs[0]for v in vs)and len(b)==a.st_size,'current full eight-field four-sample stable buffer')
 return b,vs
def fact(p,b=None):
 if b is None:b,_=raw(p)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def check(n,v,e=None):
 need(type(n)is str and n and all(x['name']!=n for x in CHECKS),'unique checkname');need(type(v)is bool,'boolean check')
 x=dict(name=n,passed=v)
 if e is not None:shape(e);x['evidence']=e
 CHECKS.append(x)
 if not v:FINDINGS.append(dict(check=n,evidence=e))
def save(name,v):
 need(Path(name).name==name,'fixed own name');shape(v)
 b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();need(len(b)<=CAP,'output byte cap');fresh();p=HERE/name
 with p.open('xb')as h:need(h.write(b)==len(b),'whole CreateNew');h.flush();os.fsync(h.fileno())
 x,_=raw(p);need(x==b and strict(x)==v,'flushed whole strict readback');return fact(p,b)
