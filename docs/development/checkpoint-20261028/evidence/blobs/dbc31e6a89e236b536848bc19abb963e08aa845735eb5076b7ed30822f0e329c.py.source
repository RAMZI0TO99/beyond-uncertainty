CHECKS=[]
def sha(b):return hashlib.sha256(b).hexdigest()
def fact(p):
    b=Path(p).read_bytes();return dict(path=str(p),bytes=len(b),sha256=sha(b))
def ck(name,passed,evidence):
    if any(c['name']==name for c in CHECKS):raise ValueError('duplicate check name')
    CHECKS.append(dict(name=name,passed=passed is True,evidence=evidence))
def pairs(items):
    out={}
    for k,v in items:
        if k in out:raise ValueError('duplicate JSON key')
        out[k]=v
    return out
def bad(v):raise ValueError('float/nonfinite')
def strict(b):
    s=b.decode('utf-8','strict')
    if s.startswith('\ufeff'):raise ValueError('BOM')
    v=json.loads(s,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    def tree(x):
        if type(x) is str:
            if any(55296<=ord(c)<=57343 for c in x):raise ValueError('surrogate')
        elif type(x) is dict:
            for k,w in x.items():tree(k);tree(w)
        elif type(x) is list:
            for w in x:tree(w)
        elif x is not None and type(x) not in (bool,int):raise ValueError('JSON type')
    tree(v);return v
def pinread(pin,label):
    b=Path(pin['path']).read_bytes();ck(label,fact(pin['path'])==pin,pin);return b
def src(pin,label):
    b=pinread(pin,label+'.whole_pin');s=b.decode('utf-8');t=ast.parse(s,filename=pin['path']);compile(t,pin['path'],'exec');ck(label+'.AST_compile_only',True,'AST parsed and compiled as data; no code object evaluated.');return b,s,t
def defs(t):return {n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def method(t,c,n):return next(x for x in defs(t)[c].body if isinstance(x,ast.FunctionDef) and x.name==n)
def text(n):return ast.unparse(n)
def lit(t,name):return ast.literal_eval(next(n.value for n in t.body if isinstance(n,ast.Assign) and any(isinstance(a,ast.Name) and a.id==name for a in n.targets)))
def frag(n,label,items):
    for name,value in items:ck(label+'.'+name,value in text(n),value)
def save(p,v):
    b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
    if len(b)>2097152:raise ValueError('metadata cap')
    with p.open('xb') as h:h.write(b)

