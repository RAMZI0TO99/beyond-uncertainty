findings=[
 dict(id='I13-F01',priority=1,title='Apply required general proof/adoption fields to every inherited peer proof consumer',subjects=[ppin],locations=[dict(path=ppin['path'],start=pr.lineno,end=pr.end_lineno),dict(path=ppin['path'],start=pad.lineno,end=pad.end_lineno),dict(path=ppin['path'],start=defs(pt)['_i13_new_code_proofs'].lineno,end=defs(pt)['_i13_new_code_proofs'].end_lineno)],requirement=dict(common_catalogue=adopt['subjects']['common_catalogue'],selectors=['schemas.general_proof_required_fields','schemas.general_adoption_required_fields','schemas.check3'],peer_protocol=adopt['subjects']['peer_protocol'],peer_clause='validation_order.V06 and original graph proofs plus new producer-code proofs'),source_reason='Inherited _Graph.review requires target/op flags, loose name/passed check rows and recursive fact3 occurrence, but does not require typed schema_version/record_type/native_Parser_executed/direct subjects list or closed3 evidence rows. _Graph.adopt similarly omits required typed header/nativefalse/direct subjects list and exact different_review/full_proof equality. _i13_new_code_proofs enforces the stronger requirements only for wrapper.producer_support, so constructor, selection, content and proposal proofs retain a weaker reachable acceptance path.',symbolic_counterexample='In an otherwise matching recorded content/proposal/selection proof, omit schema_version/record_type/native_Parser_executed/subjects and use a full check row {name,passed} without evidence; retain required pins as exact fact3s elsewhere and all existing reviewer/count/time/authority predicates. The inherited review path does not inspect the omitted required fields. No such input was executed.',repair_boundary='Harden shared inherited review/adopt for required general fields, direct typed subject-list coverage and closed check3; preserve allowed inert evidence extensions and original raw27/decision/witness/inverse ABI. Do not impose exact purpose full17 on these general proofs.'),
 dict(id='I13-F02',priority=1,title='Complete operative editor exclusions before checking reviewers in both kernels',subjects=[m3pin,ppin],locations=[dict(path=m3pin['path'],start=26,end=26),dict(path=m3pin['path'],start=mcollect.lineno,end=mcollect.end_lineno),dict(path=ppin['path'],start=pas.lineno,end=pas.end_lineno)],requirement=dict(common_protocol=adopt['subjects']['common_protocol'],selector='proof_actor_and_chronology_rules[0:3]',peer_protocol=adopt['subjects']['peer_protocol'],peer_clause='actor_exclusion.additive_union and validation_order.V06'),source_reason='M3 ACTOR_KEYS omits operative current/prior binding and metadata Source-editor aliases; the mandatory consumed I2_API006 actually names historical_binding_Source_editor and historical_metadata_Source_editor. Peer _proof_author_slots has a smaller fixed alias set and misses actual/historical implementation/binding/provenance editor slots in designated proof bodies/full proofs. Those actors therefore need not enter the exclusion union before review/adoption checks.',actual_I2_API_examples={key:old_i2_api[key] for key in ('actual_binding_Source_editor','historical_binding_Source_editor','historical_metadata_Source_editor','immediate_predecessor_actual_binding_Source_editor')},missing_M3_aliases=missing_M3,symbolic_counterexample='Use a reviewer equal to a missing operative historical editor (or its descendant), with the operative slot present only under that omitted key and omitted from the additive author list. The current collection ignores the key, while generic reviewer syntax/count/time checks can still pass. No target input was executed.',repair_boundary='Derive the conservative union from all independently designated operative Source/content/editor/provenance slots, recursively in designated proof metadata; include current/prior binding and metadata editor aliases, Source_author, actual/historical implementation editors and explicitly operative nested author roles. Lists stay additive. Keep reviewer/reviewer_agent-only roles excluded from author derivation, preserve the Root equality-only exception, and do not infer authority merely from unrelated background bytes.'),
 dict(id='I13-F03',priority=2,title='Choose metadata traversal by consuming ABI rather than .json filename',subjects=[m3pin],locations=[dict(path=m3pin['path'],start=mprime.lineno,end=mprime.end_lineno)],requirement=dict(common_protocol=adopt['subjects']['common_protocol'],selector='strict_types_and_counters designated-record policy; facts.binding_supports raw Source versus proof metadata'),source_reason="prime treats any fact3 reached by a broad key such as source/canonical as semantic JSON whenever its path ends in .json. In facts.binding_supports, source denotes raw selected Source bytes, which may themselves be JSON; the suffix is not a proof/context schema designation. This can promote Source content into recursive metadata edges/actors or refuse valid raw Source data before the specific role/schema consumer establishes the contract.",symbolic_counterexample='A raw JSON Source supplied as facts.binding_supports[name].source is routed into s.record/collect/prime solely because of its filename. The generic prime has no binding-support Source-versus-proof discriminator. No input was executed.',repair_boundary='Use the exact structural consuming context/schema to distinguish raw Source from designated metadata; continue whole-byte pin/hash/cap accounting for all bodies. Decode role-specific JSON Source only where its adopted body contract requires it. Do not broadly exempt operative metadata, weaken actor unions or skip node charges for designated parsed records.')
