need(len(sys.argv) >= 2 and sys.argv[1] in ('prepare', 'adopt'), 'explicit own metadata prepare/adopt mode')
fresh()
if sys.argv[1] == 'prepare':
    need(len(sys.argv) == 2, 'prepare takes no other arguments')
    inverse = save(INVERSE_NAME, dict(record_type='Root_Source014_complete_expired_Source011_and_adoption_inverse',
        created_utc=fresh().isoformat(), physical_Source_author=AUTHOR, metadata_author_Source=self_pin,
        items=[dict(**pin, base64=base64.b64encode(raw(pin['path'])).decode('ascii')) for pin in (old_pin, old_adoption_pin)]))
    now = fresh().isoformat()
    candidate = save(SCOPE_NAME, make_scope(now, inverse))
    print(json.dumps(dict(prepared_scope=candidate, metadata_author_adopter_Source=self_pin,
                          complete_predecessor_inverse=inverse, Root_adoption_pending=True,
                          operational_authority=False), sort_keys=True))
    sys.exit(0)

need(len(sys.argv) == 4, 'Root adopt requires exact capsule path and SHA256 after different review')
capsule_path = Path(sys.argv[2])
need(capsule_path.is_absolute() and capsule_path.is_relative_to(R5), 'review capsule inside owned metadata workspace')
capsule, capsule_pin = document(capsule_path)
need(capsule_pin['sha256'] == sys.argv[3], 'exact capsule SHA256 argument')
proof_path = Path(capsule['full_proof']['path'])
need(proof_path.is_absolute() and proof_path.is_relative_to(R5), 'proof inside owned metadata workspace')
proof, proof_pin = document(proof_path, capsule['full_proof'])
need(capsule['reviewer'] == proof['reviewer'] and type(capsule['reviewer']) is str and
     capsule['reviewer'] not in (AUTHOR, '/root'), 'genuinely different reviewer from physical author and Root adopter')
need(capsule['verdict'] == proof['verdict'] and capsule['verdict'].startswith('PASS_') and
     capsule['remaining_actionable_findings'] == proof['remaining_actionable_findings'] == [],
     'same different-review all-clear verdict and findings')
checks = proof['checks']
need(type(checks) is list and len(checks) > 0 and all(type(x) is dict and type(x.get('name')) is str and x['name'] and
     x.get('passed') is True for x in checks), 'positive named all-pass proof checks')
need(len({x['name'] for x in checks}) == len(checks), 'unique proof check names')
for reviewed in (capsule, proof):
    need(type(reviewed['checks_passed']) is int and reviewed['checks_passed'] == len(checks) and
         type(reviewed['checks_failed']) is int and reviewed['checks_failed'] == 0, 'exact positive checks counts')
scope, scope_pin = document(R / SCOPE_NAME)
inverse, inverse_pin = document(R / INVERSE_NAME)
need(scope == make_scope(scope['created_utc'], inverse_pin), 'entire exact expected Source014 candidate')
start = dt.datetime.fromisoformat(scope['interval_start'])
need(start <= fresh() < dt.datetime.fromisoformat(END) - dt.timedelta(seconds=60), 'current adopted interval and reserve')
need(len(inverse['items']) == 2, 'exact two whole predecessors')
for item, pin in zip(inverse['items'], (old_pin, old_adoption_pin)):
    need({key: item[key] for key in ('path', 'bytes', 'sha256')} == pin and
         base64.b64decode(item['base64'], validate=True) == raw(pin['path']), 'whole predecessor inverse exact')
artifacts = [scope_pin, self_pin, inverse_pin]
need(capsule['candidate'] == proof['candidate'] == scope_pin and
     capsule['reviewed_artifacts'] == proof['reviewed_artifacts'] == artifacts,
     'exact three-file candidate/author/inverse review roster in order')
for pin in artifacts:
    need(fact(Path(pin['path'])) == pin, 'fresh exact reviewed artifact F3')
for key, val in HOLDS.items():
    need(type(scope[key]) is bool and scope[key] is val is False, 'every operational gate remains held: ' + key)
adoption = save(ADOPTION_NAME, dict(record_type='Root_NEW_finite_Source_only_coexistence014_different_review_adoption',
    schema_version=14, author='/root', physical_proposal_Source_author=AUTHOR, created_utc=fresh().isoformat(),
    Source_only_coexistence_adopted=True, Source_only_scope=scope_pin, genuine_different_metadata_review=capsule_pin,
    full_proof=proof_pin, metadata_adopter_Source=self_pin, complete_predecessor_inverse=inverse_pin,
    checks_passed=len(checks), checks_failed=0, interval_start=scope['interval_start'], interval_end=END,
    publication_reserve_seconds=60, Pro2_max_including_Root=3, Pro3_max_including_Root_and_reviewer=2,
    shared_max_including_both_roots_reviewers_children_and_overlap=5, additional_slots_granted=0,
    Pro3_author_and_different_reviewer_serialized=True, Source011_end_unchanged=old['interval_end'],
    Source013_end_unchanged=scope13['interval_end'], Source_only_scheduling_not_operative_lease=True,
    Root_decision='Root adopts NEW finite Source-only coexistence014 solely for separately owned Source005 diagnostics/protocol authoring and genuinely different Source review plus Root bounded coordination metadata. This is not an operative lease, result acceptance, retry, resource/pause/custody/host-quiet clearance, failed004 release, native request advancement or execution permission. Earlier periods, identities, caps and budgets remain unchanged; every future operation requires separate exact reviews, decisions and current admission.',
    **HOLDS))
print(json.dumps(dict(adoption=adoption, Source_only_scope=scope_pin, operational_authority=False), sort_keys=True))
