need(scope13_adoption_pin['bytes'] == 2878 and scope13_adoption_pin['sha256'] == '100db1006bed691e0b4679c0892e88e7239ea225642030d4a38dda8cb71777b6', 'actual separate Source013 adoption context')
need(scope13_adoption['Source_only_scope'] == scope13_pin and scope13_adoption['Source_only_failure_closeout_scope_adopted'] is True,
