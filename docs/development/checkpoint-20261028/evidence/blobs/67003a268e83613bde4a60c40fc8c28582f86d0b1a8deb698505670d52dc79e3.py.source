ADOPTION_NAME = 'ROOT_PRO3_SOURCE_ONLY_COEXISTENCE014_DIFFERENT_REVIEW_ADOPTION_001.json'


def need(value, message):
    if not value:
        raise ValueError(message)


def raw(path):
    path = Path(path)
    for parent in (path, *path.parents):
        info = parent.lstat()
        need(not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024,
             'direct nonreparse metadata lineage')
    first = path.stat()
    need(stat.S_ISREG(first.st_mode) and first.st_nlink == 1 and 0 <= first.st_size <= CAP,
         'bounded ordinary single-link metadata file')
    with path.open('rb') as handle:
        opened = os.fstat(handle.fileno())
        data = handle.read(CAP + 1)
        last = os.fstat(handle.fileno())
    after = path.stat()
    key = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns)
    need(key(first) == key(opened) == key(last) == key(after) and len(data) == first.st_size,
         'stable whole bounded metadata buffer')
    return data


def fact(path, data=None):
    if data is None:
        data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())


def pairs(items):
    out = {}
    for key, value in items:
        need(key not in out, 'duplicate JSON key')
        out[key] = value
    return out


def bad_number(token):
    raise ValueError('fractional or nonfinite own metadata token: ' + token)


def shape(value):
    todo = [(value, 0)]
    count = 0
    while todo:
        obj, depth = todo.pop()
        count += 1
        need(count <= 50000 and depth <= 48, 'metadata node and depth bounds')
        need(obj is None or type(obj) in (str, int, bool, list, dict), 'float-free builtin metadata')
        if type(obj) is str:
            need(not any(55296 <= ord(char) <= 57343 for char in obj), 'no surrogate strings')
        elif type(obj) is list:
            todo.extend((item, depth + 1) for item in obj)
        elif type(obj) is dict:
            need(all(type(key) is str for key in obj), 'string JSON keys')
            for key, val in obj.items():
                todo.extend(((key, depth + 1), (val, depth + 1)))


def document(path, expected=None):
    data = raw(path)
    pin = fact(path, data)
    if expected is not None:
        need(pin == expected, 'exact F3 buffer pin')
    value = json.loads(data.decode('utf-8'), object_pairs_hook=pairs,
                       parse_float=bad_number, parse_constant=bad_number)
    shape(value)
    return value, pin


def fresh():
    now = dt.datetime.now(dt.timezone.utc)
    need(now.date() == dt.date(2026, 10, 28), 'current 28 October metadata interval')
    need(now < dt.datetime.fromisoformat(END) - dt.timedelta(seconds=60),
         'strict original sixty-second publication reserve')
    return now


def save(name, value):
    need(Path(name).name == name, 'fixed own output filename')
    shape(value)
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    need(len(data) <= CAP, 'own metadata output cap')
    fresh()
    path = R / name
    with path.open('xb') as handle:
        need(handle.write(data) == len(data), 'whole CreateNew write')
        handle.flush()
        os.fsync(handle.fileno())
    need(raw(path) == data, 'whole output readback')
    need(document(path)[0] == value, 'strict output readback')
    return fact(path, data)


old_path = OLD / 'ROOT_PRO3_NEW_FINITE_SOURCE_ONLY_COEXISTENCE_SCOPE_011_001.json'
