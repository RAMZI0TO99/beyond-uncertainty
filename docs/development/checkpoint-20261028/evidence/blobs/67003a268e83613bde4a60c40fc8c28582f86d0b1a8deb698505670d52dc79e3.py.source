need(old_adoption_pin['bytes'] == 4571 and old_adoption_pin['sha256'] == '6994cedd8c25318563d4aa398d6681c00e61e91f61bccd8d5ca67c75b554e378', 'exact historical Source011 adoption')
need(old_adoption['Source_only_scope'] == old_pin and old_adoption['Source_only_coexistence_adopted'] is True,
