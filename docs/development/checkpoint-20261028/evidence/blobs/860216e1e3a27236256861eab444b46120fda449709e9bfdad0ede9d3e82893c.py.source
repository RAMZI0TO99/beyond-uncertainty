"""Root saved timeout and owned custody adoption only; no rerun."""
import datetime as dt, hashlib, json
from pathlib import Path
R=Path(__file__).parent; C=R/'m3_peer_contracts_016'; O=C/'owned_memory_runs/attempt003'
def pin(p):
 b=p.read_bytes(); assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p): return json.loads(p.read_bytes())
cap=R/'saved_once003_timeout_review_001/INDEPENDENT_I13_ONCE003_SAVED_TIMEOUT_CAPSULE_001.json'; c=load(cap); assert pin(cap)['sha256']=='6ad62390935e799c702eb3d41b5e3fe3d6d48271abb8ac4b9fbeedc78d232216'
full=Path(c['full_proof']['path']); f=load(full); assert pin(full)==c['full_proof']
for v in (c,f):
 assert v['reviewer']=='/root/i13_final_review' and v['verdict'].startswith('PASS_') and v['checks_passed']==160 and v['checks_failed']==0
 assert all(v[k] is False for k in ('tests_executed','target_execution','operational_authority','scientific_authority','native_Parser_executed'))
assert c['verdict']==f['verdict'] and len(f['checks'])==len({x['name'] for x in f['checks']})==160 and all(x['passed'] is True for x in f['checks'])
result=O/'SUPERVISOR_RESULT_001.json'; s=load(result); witness=C/'ROOT_I13_ONCE003_PARENT_TOOL_CONSOLE_AND_EXIT_WITNESS_001.json'; w=load(witness)
assert s['refusal']=='WAIT50_TIMEOUT' and s['acceptance_at_record_preparation'] is False and s['child_result'] is None and s['diagnostic_failure_count'] is None
assert s['acceptance_elapsed_nanoseconds']==50030999999 and s['known_case_pass_events_from_complete_stdout']==153 and s['known_case_fail_events_from_complete_stdout']==22 and s['known_case_pass_prefix_from_complete_stdout']==8
assert s['terminated'] is True and s['killed'] is False and s['exit_code']==1 and s['reaped'] is s['streams_drained'] is True and all(s['actual_stream_EOF'].values()) and all(x is None for x in s['stream_pump_errors'].values())
assert w['Root_observed_tool_exit_code']==1 and w['Root_suite_acceptance'] is False
for v in (c,f):
 for p in (pin(result),pin(witness)): assert p in v['subjects'].values()
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'; sc=load(scope); now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sc['interval_start'])<=now and (dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_once003_different_saved_timeout_and_owned_cleanup_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_ONCE003_SAVED_TIMEOUT_AND_OWNED_CLEANUP_ONLY',Source_scope=pin(scope),different_saved_timeout_review=pin(cap),full_proof=pin(full),supervisor_result=pin(result),parent_tool_witness=pin(witness),consumed_scope=s['scope'],claim=s['claim'],checks_passed=160,checks_failed=0,complete_suite_pass=False,known_completed_case_events=175,known_pass_events=153,known_fail_events=22,known_contiguous_pass_prefix=8,unestablished_case_count=761,complete_failure_diagnostics_absent=True,recorded_diagnostic_failure_count=None,recorded_supervisor_refusal='WAIT50_TIMEOUT',own_once003_parent_and_owned_child_custody_closed=True,owned_child_reaped=True,owned_streams_drained_to_EOF=True,claim_reuse_or_replay_authorized=False,repair_requires_exact_new_Source_review_Root_adoption_and_fresh_scope=True,full_I2_G01_closed=False,actual_family_publication=False,Native8_Parser_runtime_science_admitted=False,target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_or_physical_PID_absence_accepted=False)
out=C/'ROOT_I13_ONCE003_DIFFERENT_SAVED_TIMEOUT_ADOPTION_001.json'
with out.open('xb') as h: h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(out),suite_pass=False,scope003_consumed=True,own_custody_closed=True)))
