PUBLISH=r'''
def publish(candidate,adoption):
    scope=fresh();candidate_raw,adoption_raw=body(candidate),body(adoption)
    candidate_pin,adoption_pin=pin(candidate,candidate_raw),pin(adoption,adoption_raw)
    value=decode(candidate_raw);adopted(decode(adoption_raw),candidate_pin)
    need(value['publication_helper']==pin(Path(__file__))and value['record_type']=='Root_I13_exact_additive_inert_managed_publication_candidate'and type(value['schema_version'])is int and value['schema_version']==2,'same reviewed publication helper and candidate')
    evidence=bundle_evidence(Path(value['metadata_helper_bundles']['bundle_reconstruction_Root_adoption']['path']))
    need(evidence==value['metadata_helper_bundles'],'exact complete reviewed bundle context at publication')
    preservation=baseline();rows=value['files'];index=Path(value['exact_index_destination'])
    need(type(rows)is list and 1<=len(rows)<=512 and type(value['file_count'])is int and len(rows)==value['file_count'],'bounded exact candidate count')
    need(sum(fact(x['source'])['bytes']for x in rows)<=67108864 and sum(x['source']['bytes']for x in rows)==value['payload_bytes'],'unchanged final payload cap')
    need(index==DEST/'MANAGED_I13_PORTABILITY_INDEX_001.json'and not os.path.lexists(index),'fresh exact index')
    need(len({x['destination'].casefold()for x in rows})==len(rows),'unique actual destinations')
    omitted={m['original']['path']for m in evidence['members']}
    for row in rows:
        source,destination=Path(row['source']['path']),Path(row['destination'])
        need(destination.is_relative_to(DEST)or destination==REPO/'CONTINUE_CURRENT_I13_20261025.json','reviewed additive managed containment')
        need(str(source)not in omitted and pin(source)==row['source']and not os.path.lexists(destination),'exact direct sources and all unused destinations before first write')
    source_set={x['source']['path']for x in rows}
    need(all(p['path']in source_set for p in evidence['bundles'])and evidence['bundle_index']['path']in source_set,'complete direct bundle/index roster')
    actual=[]
    for row in rows:
        fresh();raw=body(Path(row['source']['path']));need(pin(Path(row['source']['path']),raw)==row['source'],'exact source at copy')
        copied=save(Path(row['destination']),raw);actual.append(dict(source=row['source'],copy=copied,relative_path=row['relative_path'],copy_matches_source=True))
    copies={x['source']['path']:x['copy']for x in actual}
    bundled=[dict(original=m['original'],bundle_source=m['bundle'],bundle_copy=copies[m['bundle']['path']],member_ordinal=m['member_ordinal'])for m in evidence['members']]
    indexed=dict(schema_version=2,record_type='Root_I13_actual_inert_managed_portability_index',author='/root',actual_publication_helper_Source_editor='/root/project_architecture',created_utc=utc(),
        candidate=candidate_pin,candidate_Root_adoption=adoption_pin,source_scope=scope,files=actual,file_count=len(actual),metadata_helper_bundles=evidence,
        bundled_helper_members=bundled,bundled_original_member_count=160,member_ordinal_base=0,all_copies_byte_identical=True,source_suffix_only_transform=True,
        actual_family_publication=False,target_execution=False,operational_authority=False,scientific_authority=False,
        current_dated_Source_inventory=dict(present=36,pending=9),frozen_STEP080_inventory=dict(present=35,pending=10),
        actual_creation_requires_different_saved_review_and_Root_adoption=True,staged=False,committed=False,pushed=False)
    index_pin=save(index,wire(indexed))
    receipt=dict(schema_version=2,record_type='Root_I13_actual_inert_managed_creation_receipt',author='/root',actual_publication_helper_Source_editor='/root/project_architecture',created_utc=utc(),
        candidate=candidate_pin,candidate_Root_adoption=adoption_pin,actual_index=index_pin,file_count=len(actual),bundled_original_helper_count=160,
        all_exact=True,initial_preservation=preservation,final_preservation=baseline(),target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False,
        no_step081_or_operational_lease=True,staged=False,committed=False,pushed=False)
    receipt_pin=save(PUB/'ROOT_I13_ACTUAL_MANAGED_CREATION_RECEIPT_001.json',wire(receipt));fresh()
    print(json.dumps(dict(receipt=receipt_pin,actual_index=index_pin,copied_files=len(actual),bundled_original_helpers=160)))
'''
replacement={'fresh':FRESH,'prepare':PREPARE,'publish':PUBLISH}
lines=source.splitlines(keepends=True)
for n in sorted((nodes[k]for k in replacement),key=lambda n:n.lineno,reverse=True):
 lines[n.lineno-1:n.end_lineno]=[replacement[n.name].lstrip()+'\n']
source=''.join(lines)
source=source.replace('import datetime as dt','import base64\nimport datetime as dt',1)
source=source.replace("SCOPE = ROOT / 'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'","SCOPE = ROOT / 'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'",1)
source=source.replace('if parent.exists():','if os.path.lexists(parent):')
source=source.replace('value = json.loads(baseline_raw)','value = decode(baseline_raw)',1)
source=source.replace('if value == expected:','if set(value)=={\'path\',\'bytes\',\'sha256\'} and wire(value)==wire(expected):',1)
source=source.replace('"""Root standard-library metadata publication helper; no target imports/calls.','"""Bundle-aware metadata publication helper; actual Source editor /root/project_architecture.\nRoot predecessor Source retained complete; no target imports/calls.',1)
constants="\nBUNDLE_DIR=ROOT/'metadata_helper_source_bundles_001'\nBUNDLE_INDEX=BUNDLE_DIR/'I13_METADATA_HELPER_SOURCE_BUNDLE_INDEX_001.json'\n"
constants+='BUNDLE_AUTHOR_SOURCE='+repr(pin(BUNDLE))+'\n'
for name,path in [('SCOPE_PIN',R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'),('SCOPE_ADOPTION_PIN',R/'ROOT_I13_CURRENT_SOURCE_SCOPE002_DIFFERENT_REVIEW_ADOPTION_001.json'),('BUNDLE_PLAN',R/'I13_EXACT_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json'),('BUNDLE_PLAN_ADOPTION',R/'ROOT_I13_EXACT_HELPER_SOURCE_BUNDLE_PLAN_DIFFERENT_REVIEW_ADOPTION_001.json')]:constants+=name+'='+repr(pin(path))+'\n'
source=source.replace('CAP = 2097152','CAP = 2097152\n'+constants,1)
main=source.index("if __name__ == '__main__':")
source=source[:main]+EXTRA+'''\n\nif __name__ == '__main__':
    need(len(sys.argv)==4,'prepare navigation actual-bundle-review-adoption | publish candidate adoption')
    if sys.argv[1]=='prepare':prepare(Path(sys.argv[2]),Path(sys.argv[3]))
    else:
        need(sys.argv[1]=='publish','exact prepare or publish mode')
        publish(Path(sys.argv[2]),Path(sys.argv[3]))
'''
newtree=ast.parse(source,filename=str(NEW));compile(newtree,str(NEW),'exec',dont_inherit=True)
assert datetime.datetime.now(datetime.timezone.utc)<END-datetime.timedelta(seconds=60)
with NEW.open('xb')as f:f.write(source.encode('utf8'));f.flush();os.fsync(f.fileno())
assert NEW.read_bytes()==source.encode('utf8')
print(json.dumps(pin(NEW),sort_keys=True))
receipt=dict(schema_version=2,record_type='I13_bundle_aware_metadata_helper_Source_author_receipt_unrun',author='/root/project_architecture',
 Source=pin(NEW),predecessor_Source=pin(OLD),whole_predecessor_Source_bytes_base64=base64.b64encode(before).decode('ascii'),
 bundle_author_Source=pin(BUNDLE),bundle_plan=pin(R/'I13_EXACT_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json'),
 bundle_plan_Root_adoption=pin(R/'ROOT_I13_EXACT_HELPER_SOURCE_BUNDLE_PLAN_DIFFERENT_REVIEW_ADOPTION_001.json'),
 Source_scope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json'),Source_scope_Root_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE002_DIFFERENT_REVIEW_ADOPTION_001.json'),
 protected_existing_IO_guards=['bounded stable two complete reads','ordinary nonreparse one-link paths','strict >60 reserve before mkdir/exclusive open','exclusive writes/fsync/readback','no overwrite/deletion/rollback','all418 repository baseline pins before/after'],
 exact_frozen_helper_member_count=160,original_member_bytes=1353151,maximum_metadata_file_bytes=2097152,maximum_actual_copy_rows=512,maximum_actual_copy_payload_bytes=67108864,
 new_prepare_signature='prepare(nav,bundle_review_adoption)',new_prepare_CLI='prepare navigation actual-bundle-review-adoption',publish_CLI='publish candidate adoption',
 source_only_AST_compile=True,publication_helper_or_bundle_author_invocations=0,actual_bundles_created=False,candidate_created=False,managed_files_created=False,
 target_execution=False,operational_authority=False,scientific_authority=False,native_Parser_executed=False,actual_family_publication=False)
rp=R/'I13_BUNDLE_AWARE_MANAGED_HELPER003_AND_BUNDLE_AUTHOR001_SOURCE_AUTHOR_RECEIPT_001.json'
data=(json.dumps(receipt,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('utf8');assert len(data)<=2097152
with rp.open('xb')as f:f.write(data);f.flush();os.fsync(f.fileno())
assert rp.read_bytes()==data;print(json.dumps(pin(rp),sort_keys=True))
