from pathlib import Path
R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
OLD=R/'prepare_I13_managed_candidate_002.py'
NEW=R/'prepare_I13_managed_candidate_003.py'
BUNDLE=R/'prepare_I13_metadata_helper_source_bundles_001.py'
END=datetime.datetime.fromisoformat('2026-10-25T18:03:03.861408+00:00')
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
before=OLD.read_bytes();source=before.decode('utf8')
tree=ast.parse(source);nodes={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)}
assert pin(BUNDLE)['sha256']=='8f88e6a708dff41bc15ec675a4d54460c5da6cbb6b2af5eb8fef630b369c0c29'
EXTRA=r'''
def pairs(items):
    value={}
    for key,child in items:
        need(key not in value,'duplicate metadata key');value[key]=child
    return value

def bad(value):
    raise ValueError('float or nonfinite metadata number')

def decode(raw):
    need(type(raw)is bytes and len(raw)<=CAP,'bounded metadata bytes')
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)

def fact(value):
    need(type(value)is dict and set(value)=={'path','bytes','sha256'}and all(type(k)is str for k in value),'closed fact3')
    need(type(value['path'])is str and type(value['bytes'])is int and 0<=value['bytes']<=CAP and type(value['sha256'])is str and len(value['sha256'])==64 and all(c in'0123456789abcdef'for c in value['sha256']),'typed fact3')
    need(Path(value['path']).is_absolute()and not any(ord(c)<32 for c in value['path']),'ordinary absolute path text')
    return value

def exact(subject):
    fact(subject);path=Path(subject['path']);raw=body(path)
    need(pin(path,raw)==subject,'exact whole pinned metadata bytes');return raw

def adopted(value,subject):
    need(type(value)is dict and value.get('author')=='/root'and type(value.get('verdict'))is str and value['verdict'].startswith('ACCEPT_')and value.get('target_execution')is False and value.get('operational_authority')is False and value.get('scientific_authority')is False and occurs(value,subject),'exact Root reviewed subject adoption')

def bundle_evidence(review_adoption):
    fresh();plan=decode(exact(BUNDLE_PLAN));adopted(decode(exact(BUNDLE_PLAN_ADOPTION)),BUNDLE_PLAN)
    need(plan['member_count']==160 and plan['member_bytes']==1353151 and plan['maximum_metadata_file_bytes']==CAP and plan['maximum_actual_copy_rows']==512 and plan['maximum_actual_copy_payload_bytes']==67108864,'fixed packaging bounds')
    members=plan['members'];need(type(members)is list and len(members)==160,'fixed original membership')
    names=[fact(p)['path']for p in members]
    need(names==sorted(names,key=str.casefold)and len(set(x.casefold()for x in names))==160,'fixed unique ordered original Sources')
    index_raw=body(BUNDLE_INDEX);index_pin=pin(BUNDLE_INDEX,index_raw);index=decode(index_raw)
    need(index['record_type']=='I13_inert_metadata_helper_Source_bundle_index'and index['packaging_plan']==BUNDLE_PLAN and index['packaging_plan_Root_adoption']==BUNDLE_PLAN_ADOPTION,'exact bundle index domain')
    need(index['bundle_author_Source']==BUNDLE_AUTHOR_SOURCE,'fixed reviewed bundle author Source')
    adopted(decode(exact(index['bundle_author_Source_Root_adoption'])),BUNDLE_AUTHOR_SOURCE)
    need(index['Source_scope']==SCOPE_PIN and index['member_count']==160 and index['original_member_bytes']==1353151 and index['member_ordinal_base']==0 and index['actual_bundles_created']is True and index['original_files_modified']is False and index['all_complete_original_bytes_reconstruct_exactly']is True,'bundle index completeness and inertness')
    for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(index[flag]is False,'bundle index false authorities')
    review_raw=body(review_adoption);adopted(decode(review_raw),index_pin);review_pin=pin(review_adoption,review_raw)
    bundles=index['bundles'];need(type(bundles)is list and 1<=len(bundles)<=160 and type(index['bundle_count'])is int and index['bundle_count']==len(bundles),'bounded bundle roster')
    mapping=[];seen=set()
    for number,bundle_pin in enumerate(bundles,1):
        path=Path(fact(bundle_pin)['path'])
        need(path==BUNDLE_DIR/('I13_METADATA_HELPER_SOURCE_BUNDLE_'+str(number).zfill(3)+'.json')and path.name.casefold()not in seen,'exact consecutive bundle path')
        seen.add(path.name.casefold());value=decode(exact(bundle_pin))
        need(value['record_type']=='I13_complete_inert_metadata_helper_Source_bundle'and value['bundle_ordinal']==number and type(value['bundle_ordinal'])is int and value['packaging_plan']==BUNDLE_PLAN and value['packaging_plan_Root_adoption']==BUNDLE_PLAN_ADOPTION and value['Source_scope']==SCOPE_PIN,'exact recorded bundle context')
        for flag in('target_execution','operational_authority','scientific_authority','actual_family_publication'):need(value[flag]is False,'bundle false authorities')
        need(type(value['members'])is list and bool(value['members']),'nonempty complete bundle members')
        for ordinal,member in enumerate(value['members']):
            need(type(member)is dict and set(member)=={'original','canonical_base64'}and type(member['canonical_base64'])is str,'closed encoded Source member')
            original=fact(member['original']);original_path=Path(original['path'])
            need(original_path.is_relative_to(ROOT)and not original_path.is_relative_to(SUBJECTS)and not original_path.is_relative_to(PUB)and original_path.suffix=='.py','metadata helper domain only')
            decoded=base64.b64decode(member['canonical_base64'],validate=True)
            need(decoded==exact(original)and base64.b64encode(decoded).decode('ascii')==member['canonical_base64'],'exact canonical whole Source inverse')
            mapping.append(dict(original=original,bundle=bundle_pin,member_ordinal=ordinal))
    need([m['original']for m in mapping]==members and len(mapping)==160 and mapping==index['members'],'every selected Source and indexed ordinal exactly once')
    need(sum(m['bytes']for m in members)==1353151,'complete original Source byte total')
    return dict(packaging_plan=BUNDLE_PLAN,packaging_plan_Root_adoption=BUNDLE_PLAN_ADOPTION,bundle_index=index_pin,
        bundle_author_Source=BUNDLE_AUTHOR_SOURCE,bundle_author_Source_Root_adoption=index['bundle_author_Source_Root_adoption'],
        bundle_reconstruction_Root_adoption=review_pin,bundles=bundles,members=mapping,member_count=160,original_member_bytes=1353151)
