"""Retain only own reviewer AST-digest bookkeeping correction."""
from pathlib import Path
import datetime as dt,hashlib,json,os
D=Path(__file__).parent
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
p=D/'review_exporter016_API001_001.py';q=D/'review_exporter016_API001_002.py';a=p.read_bytes();b=q.read_bytes()
assert a.count(b'for x in n.targets))).encode()')==1 and a.replace(b'for x in n.targets))).encode()',b'for x in n.targets)).value).encode()')==b
f=D/'INDEPENDENT_I13_EXPORTER016_API001_STATIC_SOURCE_FULL_PROOF_001.json';c=D/'INDEPENDENT_I13_EXPORTER016_API001_STATIC_SOURCE_CAPSULE_001.json'
v=dict(schema_version=1,record_type='Independent_exporter016_review_own_AST_digest_checker_correction',reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),original_checker=fact(p,a),corrected_checker=fact(q,b),original_tool_chunk='726b21',original_exit_code=1,review_outputs_written_before_correction=0,reason='Own checker hashed the CASE_CATALOGUE assignment node; author metadata explicitly hashes its literal value AST. Whole prefix/CASE_CATALOGUE was already byte/AST exact. Corrected only own AST hash subject to the declared value node.',all_subject_bytes_changed=False,subject_failure_claimed=False,success_tool_chunk='187450',success_exit_code=0,checks_passed=99,checks_failed=0,full_proof=fact(f,f.read_bytes()),capsule=fact(c,c.read_bytes()),subject_compile_import_call=False,capture=False,tests=False,ready_for_execution=False)
z=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');assert len(z)<2097152 and(dt.datetime.fromisoformat('2026-10-27T15:10:56.767745+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
out=D/'INDEPENDENT_EXPORTER016_REVIEW_OWN_AST_DIGEST_CORRECTION_HISTORY_001.json'
with out.open('xb')as h:assert h.write(z)==len(z);h.flush();os.fsync(h.fileno())
assert out.read_bytes()==z;print(json.dumps(fact(out,z)))
