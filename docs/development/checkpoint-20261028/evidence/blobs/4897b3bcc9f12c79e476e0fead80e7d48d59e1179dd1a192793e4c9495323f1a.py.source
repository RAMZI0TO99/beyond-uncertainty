"""Root authorized routine coordination metadata; no peer or Pro2 job is launched."""
import ctypes, datetime as dt, hashlib, json, shutil
from pathlib import Path

R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
P=Path(r'D:\Aenv\pro3')
D=P/'runs/coordination/cho51_provenance_numerical_worker_20261025_v5'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p,sha=None):
 if sha is not None:assert pin(p)['sha256']==sha
 return json.loads(p.read_bytes())
pins=load(D/'pins.json','bc7da9b7694202c42b0090d2e819ce302f638466d9ed9e1bcc1a79d71be59223')
review=load(D/'source-review.json','9fb1e5616b79d016a8b4e2cb68439dc1bb5bc1b0d4100534c3d539c13b10e5a3')
amendment=load(D/'owner-resource-amendment.json','da97a78b807359b7bc9db5fc781793b7e092ae77bc1a98970c08927a4f83fa4a')
request=load(D/'compute-request_integration_001.json')
assert review['accepted'] is True and review['remaining_actionable_findings']==[] and review['source_only'] is True
assert review['tests_executed'] is False and review['execution_admission'] is False
assert review['files']==pins['reviewed_files'] and len(review['files'])==13
files=[]
for name,sha in review['files'].items():
 p=P/name;assert p.resolve().is_relative_to(P.resolve()) and pin(p)['sha256']==sha;files.append(pin(p))
assert request['phase']=='integration' and request['scope']==pins['phase_scopes']['integration']
assert request['fixed_output']=='i1' and request['tests_current_job']==0 and request['prior_accepted_tests']==63
expected=dict(source_updates=0,restore_count=1,support_updates=1,gradient_updates=1,target_inference_calls=1,query_count=2,model_constructions=1,measured_cells=0)
assert request['expected_numerical_budget']==pins['phase_budgets']['integration']==expected
assert all(type(v) is int for v in request['expected_numerical_budget'].values())
assert request['maximum_jobs']==1 and request['max_job_seconds']==600 and request['process_mib']==4096 and request['job_mib']==5120
assert request['startup_ram_gib']==request['active_ram_gib']==4 and request['disk_gib']==20 and request['threads']==1 and request['gpu_hidden'] is True
assert request['automatic_retry_permitted'] is False and request['scientific_admission'] is False
assert request['requested_window_seconds']==1200 and request['all_five_genuine_pause_paths_required'] is True
assert request['prior_grants_003_through_007_consumed_closed'] is True
assert request['owner_instruction_exact']==amendment['owner_instruction_exact']=='use the available ram now!'
assert amendment['scientific_admission'] is False and amendment['each_slot_requires_distinct_maximum_one_job_release'] is True
closed=load(D/'lease-closeout_tests_001.json','7e83878e995087c91ca398058e1a7be758c42a2f55b8c588a2491412ec57eefe')
final=load(D/'tests-final-review.json','43709f479724cfce9f88b257bc720450fdc1d6e94eb1bb2bdba94eb04b3dad8a')
load(D/'closeout-tests-result.json','de5e1bb8c1704bc4c200d68208066ac25ec2d1263a10a5560ef928c4f6ae64bf')
assert all(closed[k] is True for k in ('closed','custody_released','accepted','current_numerical_budget_all_zero','guard_and_launcher_reaped','external_closeout_reaped','full_compute_custody_explicitly_released'))
assert closed['outstanding_owned_children']==0 and closed['jobs_consumed']==1 and closed['integration_admitted'] is False
assert final['passed'] is True and final['remaining_actionable_findings']==[] and final['tests']==63 and final['independent_reviewer']=='/root/readiness'
for key in ('closeout','review','lease_closeout'):
 assert request['accepted_tests_'+key+'_sha256']==pin(Path(request['accepted_tests_'+key+'_path']))['sha256']
pauses=[Path(r'D:\Aenv\pro2\WORK')/('resume-'+day+'-001/coordination/PRO2_REQUEST_PRO3_PAUSE.json') for day in ('20261007','20261012','20261013','20261015','20261025')]
assert not any(p.exists() for p in pauses)
class Memory(ctypes.Structure):
 _fields_=[('length',ctypes.c_ulong),('load',ctypes.c_ulong)]+[(x,ctypes.c_ulonglong) for x in ('total_phys','available_phys','total_page','available_page','total_virtual','available_virtual','available_extended')]
memory=Memory();memory.length=ctypes.sizeof(memory)
assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(memory))
now=dt.datetime.now(dt.timezone.utc)
resource=dict(observed_utc=now.isoformat(timespec='microseconds'),available_RAM_bytes=memory.available_phys,disk_free_bytes=shutil.disk_usage(P).free)
assert resource['available_RAM_bytes']>=4*1024**3 and resource['disk_free_bytes']>=20*1024**3
scope=load(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json')
assert (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>1260
previous=load(Path(r'D:\Aenv\pro2\WORK\resume-20261025-002\coordination\PRO2_PRO3_COMPUTE_RELEASE_20261025_007.json'),'059b8547c1406bb6be2d4f22a5a6a2ee7f6f6e0764db9443d3e1b8b3b3272793')
for k in ('all_eight_numerical_budget_fields_exact_zero','maximum_reviewed_unit_record_path_characters','prior006_full_custody_release_report'):
 previous.pop(k,None)
previous.update(issued_utc=now.isoformat(timespec='microseconds'),window_start_utc=now.strftime('%Y-%m-%dT%H:%M:%SZ'),window_end_utc=(now+dt.timedelta(seconds=1200)).strftime('%Y-%m-%dT%H:%M:%SZ'),
 scope=request['scope'],phase='integration',fixed_output='i1',pins_sha256=pin(D/'pins.json')['sha256'],exact_pins=pin(D/'pins.json'),source_review_sha256=pin(D/'source-review.json')['sha256'],Source_review=pin(D/'source-review.json'),
 request=pin(D/'compute-request_integration_001.json'),owner_resource_amendment=pin(D/'owner-resource-amendment.json'),verified_13_reviewed_file_pins=files,expected_numerical_budget=expected,
 exact_engineering_episode=request['exact_engineering_episode'],last_resource_observation=resource,
 allowed_action='INTEGRATION ONLY: one exact engineering episode and eight-budget vector bound by this immutable request. No current test replay, source fit, measured cell, scientific claim, backend retry, second episode or second Job. At most600s one native Job then only independently reviewed stdlib external integration closeout<=300s and explicit full custody release.',
 future_integration_admitted=False,current_integration_only=True,prior_grants001_through007_consumed_closed_not_reused=True,
 prior007_full_custody_release_report=pin(R/'coordination/ROOT_RETAINED_PRO3_007_FULL_TESTS_CUSTODY_RELEASE_REPORT_001.json'),
 peer_accepted_tests_closure=dict(closeout=pin(D/'closeout-tests-result.json'),independent_review=pin(D/'tests-final-review.json'),lease_closeout=pin(D/'lease-closeout_tests_001.json')),
 current_Pro2_Source_scope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'),
 peer_results_accepted=False,physical_handle_absence_claimed=False,global_host_or_process_quiet_claimed=False,
 all_five_pause_paths=[str(p) for p in pauses],Pro2_will_not_launch_target_memory_test_until_peer_reported_full_custody_release=True)
previous['owner_message_evidence']['scope_interpretation']='The same directly authorized engineering integration and scope-bound four-GiB startup reply; this distinct v5 integration grant consumes one new Job and does not reuse001-007. All Pro2 gates remain held.'
out=R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_008.json'
raw=(json.dumps(previous,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
with out.open('xb') as h:assert h.write(raw)==len(raw)
print(json.dumps(dict(release=pin(out),window_end_utc=previous['window_end_utc'],resource=resource,phase='integration_only')))
