    'Internal elapsed stops before final supervision write, console serialization and outer disposal. A later run must independently retain caller-observed invocation-to-completion/reap walltime <=300 seconds including those operations; the internal value alone is insufficient. This retained limitation is not a runtime acceptance or timing guarantee.')

check('pending_v2_peer_review_input_and_request_are_not_accepted', True,
      'No supervisor-review_v2.json, input-review_v2.json, compute-request_002.json, Root allocation helper invocation, admission, grant020 or aggregate result is accepted by this Source-only proof. Their eventual exact pins and joins need a separate genuine allocation audit.')
check('no_large_external_pinmap_parsed_or_copied_by_this_review', True,
      'This narrow review reads only bounded Source/proof/Source-scope files listed in reviewed_file_pins. No >2MiB external map is loaded, parsed or copied; the earlier 36-ref stream-hash review is historical context only, not refreshed here.')
check('no_peer_compiler_interpreter_API_test_or_Job_execution', True,
      'Reviewer performed only own stdlib file read/hash, strict bounded JSON, byte-line diff and Base64 inverse. No Add-Type, PS parser, C# compiler, peer import/export, interpreter, aggregate, Job, native live-process query, test or Pro2 target was invoked.')
check('no_allocation_or_result_scientific_or_operational_acceptance', True,
      'PASS applies to the repaired Source ownership boundary and unchanged Source complement only. Allocation remains not reviewed/not allocated; no engineering, aggregate input/result, full133, runtime or science acceptance follows.')

assert len({row['name'] for row in checks}) == len(checks)
assert all(type(row['passed']) is bool and row['passed'] for row in checks)
for key, path in paths.items():
    assert path.read_bytes() == raws[key], ('Source changed during review', key)
created = dt.datetime.now(dt.timezone.utc).isoformat()
flags = {key: False for key in ['target_execution', 'tests_executed', 'native_Parser_executed',
         'operational_authority', 'scientific_authority', 'actual_family_publication',
         'peer_result_accepted', 'scientific_admission', 'peer_Code_compiled', 'peer_Code_imported',
         'peer_aggregate_executed', 'allocation_review_performed', 'allocation_review_passed']}
common = {
    'schema_version': 1, 'reviewer': '/root/i13_final_review', 'created_utc': created,
    'verdict': 'PASS_SOURCE_ONLY_REPAIR', 'source_review_passed': True,
    'allocation_verdict': 'NOT_REVIEWED_NOT_ALLOCATED',
    'checks_passed': len(checks), 'checks_failed': 0,
    'remaining_actionable_findings': [], 'reviewed_file_pins': pins,
    'subjects': list(pins.values()), 'peer_interpreter_invocations': 0, 'live_Job_queries_by_reviewer': 0,
    'prior_refusal_preserved': True,
    'resolved_Source_finding_id': 'STALE_TOOLHELP_PID_PARENT_TO_OPENED_HANDLE_OWNERSHIP_GAP',
    'claim_limit': 'Genuine narrow static Source review only. Native PID/PPID/creation checks now precede descendant adoption and retained owned operations. Exact predecessor inverse and unchanged complement are verified. No compiler/native call or runtime behavior was measured. Separate successor reviews/input/request/allocation audit and fresh Root decision remain required. The actual outer caller must prove complete <=300-second walltime including final writes/disposal; internal stopwatch alone does not. All original Pro2 gates and caps remain held.',
    **flags,
}
full = {**common, 'record_type': 'Independent_Pro3_aggregate_supervisor_v2_Source_full_proof',
        'checks': checks,
        'complete_original_Source_Base64': base64.b64encode(old).decode('ascii'),
        'whole_original_Source_inverse': pins['preserved_original_supervisor_Source'],
        'byte_line_inverse_operations': operations,
        'complete_unified_Source_diff': ''.join(difflib.unified_diff(old_text.splitlines(keepends=True), text.splitlines(keepends=True), fromfile='supervise.ps1', tofile='supervise_v2.ps1')),
        'static_ABI_layout': {'field_count_pointer_width': 6, 'bytes_for_pointer_width4': 24, 'bytes_for_pointer_width8': 48,
                              'PID_offset_in_pointer_slots': 4, 'parent_PID_offset_in_pointer_slots': 5,
                              'actual_native_layout_or_query_measured': False},
        'Source_limitations': ['No Source-only audit proves complete host process absence or future runtime custody.',
                               'Discovery is conservative; inaccessible, exited/reused or otherwise uncertain candidates cause refusal without candidate termination.',
                               'Clock checks use a 1ms tolerance and do not prove adversarial clock immunity.',
                               'Native calls themselves are not asynchronously cancelled; a later actual complete caller walltime remains mandatory.',
                               'A successful Source review does not establish syntax compilation, API availability, runtime fit, aggregation success or scientific validity.'],
        'pending_successor_metadata_accepted': False}
reserve()
full_raw = encode(full)
assert not (OUT/FULL_NAME).exists() and not (OUT/CAP_NAME).exists()
with (OUT/FULL_NAME).open('xb') as handle:
    handle.write(full_raw)
full_pin = fact(OUT/FULL_NAME, full_raw)
capsule = {**common, 'record_type': 'Independent_Pro3_aggregate_supervisor_v2_Source_capsule',
           'full_proof': full_pin,
           'checks': [{'name': row['name'], 'passed': row['passed'], 'evidence': 'Full proof contains exact Source region and independent finding.'} for row in checks],
           'pending_successor_metadata_accepted': False,
           'caller_observed_complete_supervisor_walltime_required': True,
           'complete_supervisor_walltime_maximum_seconds': 300,
           'supervisor_internal_stopwatch_alone_proves_complete_walltime': False,
           'post_stop_evidence_write_latency_must_be_included_in_caller_observation': True}
reserve()
cap_raw = encode(capsule)
with (OUT/CAP_NAME).open('xb') as handle:
    handle.write(cap_raw)
assert (OUT/FULL_NAME).read_bytes() == full_raw and (OUT/CAP_NAME).read_bytes() == cap_raw
assert strict(cap_raw)['full_proof'] == full_pin
print(json.dumps({'checks_passed': len(checks), 'checks_failed': 0,
                  'full_proof': full_pin, 'capsule': fact(OUT/CAP_NAME, cap_raw),
                  'source_verdict': common['verdict'], 'allocation': common['allocation_verdict']}))
