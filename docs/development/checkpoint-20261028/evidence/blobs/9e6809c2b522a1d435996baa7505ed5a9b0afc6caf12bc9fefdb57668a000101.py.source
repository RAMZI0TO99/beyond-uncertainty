has('before_snapshot_native_UTC_cutoff_and_QPC_brackets',
    ['long snapshotTicks=Stopwatch.GetTimestamp(); ulong snapshotStarted=PreciseTime(); long snapshotTicksAfter=Stopwatch.GetTimestamp();',
