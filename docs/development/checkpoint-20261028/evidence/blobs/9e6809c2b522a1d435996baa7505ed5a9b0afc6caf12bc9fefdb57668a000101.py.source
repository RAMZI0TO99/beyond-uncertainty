     'confirmed.ParentPid!=actual.ParentPid || confirmed.Created!=actual.Created',
     'confirmedOwner.Exited!=0 && actual.Created>confirmedOwner.Exited'],
    '                        var confirmed=ExactProcessIdentity(handle,row.Pid)',
    '                        Records.Add(new OwnedProcess',
