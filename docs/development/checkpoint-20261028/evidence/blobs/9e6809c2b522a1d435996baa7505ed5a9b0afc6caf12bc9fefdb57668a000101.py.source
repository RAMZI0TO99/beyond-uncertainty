"""Independent read/hash/text-only supervisor review. Never loads a subject module."""
from pathlib import Path
import base64
import datetime as dt
import decimal
import difflib
import hashlib
import json

R = Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
A = Path(r'D:\Aenv\pro3\runs\coordination\cho51_canonical_boundary_20261025_v5_aggregate')
OUT = R / 'pro3_aggregate_supervisor_v2_Source_review_001'
LIMIT = 2097152
END = dt.datetime.fromisoformat('2026-10-25T21:55:00+00:00')
FULL_NAME = 'INDEPENDENT_PRO3_AGGREGATE_SUPERVISOR_V2_SOURCE_FULL_PROOF_001.json'
CAP_NAME = 'INDEPENDENT_PRO3_AGGREGATE_SUPERVISOR_V2_SOURCE_CAPSULE_001.json'

def reserve():
    assert (END - dt.datetime.now(dt.timezone.utc)).total_seconds() > 60

def digest(raw):
    return hashlib.sha256(raw).hexdigest()

def fact(path, raw):
    return {'path': str(path), 'bytes': len(raw), 'sha256': digest(raw)}

def pairs(rows):
    value = {}
    for key, member in rows:
        assert key not in value, ('duplicate key', key)
        value[key] = member
    return value

def strict(raw):
    assert len(raw) <= LIMIT
    return json.loads(raw.decode('utf8'), object_pairs_hook=pairs,
                      parse_float=decimal.Decimal,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))

def encode(value):
    raw = (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=True) + '\n').encode('utf8')
    assert len(raw) <= LIMIT
    return raw

reserve()
paths = {
    'repaired_supervisor_Source': A / 'supervise_v2.ps1',
    'preserved_original_supervisor_Source': A / 'supervise.ps1',
    'unchanged_aggregate_Source': A / 'aggregate.py',
    'preserved_original_refusal_full': R / 'pro3_aggregate_allocation_review_001' / 'INDEPENDENT_PRO3_AGGREGATE_ALLOCATION001_SOURCE_REFUSAL_FULL_PROOF_001.json',
    'preserved_original_refusal_capsule': R / 'pro3_aggregate_allocation_review_001' / 'INDEPENDENT_PRO3_AGGREGATE_ALLOCATION001_SOURCE_REFUSAL_CAPSULE_001.json',
    'current_Source006': R / 'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_006.json',
    'current_Source006_Root_adoption': R / 'ROOT_I13_CURRENT_SOURCE_SCOPE006_DIFFERENT_REVIEW_ADOPTION_001.json',
}
expected = {
    'repaired_supervisor_Source': (39054, '16d2d5f86c16b42de9a07b4933f8a46c7967ed0a5a048bb39440f97e458d0124'),
    'preserved_original_supervisor_Source': (34510, '41e3bb54cccd22f792d261b4f94c7bdcd1250c132f9572c452deeaa98d1faae7'),
    'unchanged_aggregate_Source': (39159, 'eb85e2bb7b682a4215c373ee080bda9a4638708e54190bda3170474c09c3fab8'),
    'preserved_original_refusal_full': (63267, '9cfa424b36f062b435a5b864e10fd588c355bc5472a4c565a24aae4102881e69'),
    'preserved_original_refusal_capsule': (22671, 'ee7ab088b26972f0631f8943b7211746a0a9943ac987041ccef1a04d22b67fd1'),
    'current_Source006': (17107, '9196eaca8c1988c357abfa72881b3e505317ce7faff50dc352b700407848d821'),
    'current_Source006_Root_adoption': (2324, 'e139f7ade01ea2c005f70eb7e4befff7be06e9fcdfc9e7706b45c2b8878cfea8'),
}
raws = {key: path.read_bytes() for key, path in paths.items()}
pins = {key: fact(paths[key], raw) for key, raw in raws.items()}
for key, raw in raws.items():
    assert (len(raw), digest(raw)) == expected[key], key
old = raws['preserved_original_supervisor_Source']
new = raws['repaired_supervisor_Source']
old_text = old.decode('utf8')
text = new.decode('utf8')
old_lines = old.splitlines(keepends=True)
new_lines = new.splitlines(keepends=True)
lines = text.splitlines()
prior = strict(raws['preserved_original_refusal_full'])
prior_cap = strict(raws['preserved_original_refusal_capsule'])
scope = strict(raws['current_Source006'])
adoption = strict(raws['current_Source006_Root_adoption'])
checks = []

def check(name, condition, evidence):
    assert type(condition) is bool
    checks.append({'name': name, 'passed': condition, 'evidence': evidence})
    assert condition, name

def excerpt(first, last=None):
    start = next(i for i, line in enumerate(lines) if first in line)
    end = start if last is None else next(i for i in range(start, len(lines)) if last in lines[i])
    raw = b''.join(new_lines[start:end + 1])
    return {'start_line': start + 1, 'end_line': end + 1,
            'bytes': len(raw), 'sha256': digest(raw),
            'Source': raw.decode('utf8')}

def has(name, strings, first, last=None, conclusion=None):
    check(name, all(string in text for string in strings),
          {'Source_region': excerpt(first, last), 'conclusion': conclusion or 'Exact inspected Source predicates are present.'})

check('current_Source006_exact_Root_adopted_and_reserved',
      adoption['Source_scope'] == pins['current_Source006'] and adoption['checks_failed'] == 0
      and scope['publication_reserve_seconds'] == 60 and scope['maximum_local_agents_including_Root'] == 3
      and scope['maximum_shared_including_both_roots_and_overlap'] == 5
      and scope['interval_end'] == END.isoformat(),
      'Adopted Source006 authorizes this bounded Source-only review; it does not allocate an interpreter or admit any target. Strict >60-second reserve is checked before each own write.')
check('exact_39054_repaired_Source_and_34510_original_preserved', True,
      {'new': pins['repaired_supervisor_Source'], 'old': pins['preserved_original_supervisor_Source']})
check('unchanged_aggregate_whole_Source_pin', True, pins['unchanged_aggregate_Source'])
check('prior_genuine_refusal_preserved_not_overwritten',
      prior['allocation_review_passed'] is False and prior['checks_failed'] == 1
      and prior_cap['full_proof'] == pins['preserved_original_refusal_full']
      and prior['remaining_actionable_findings'][0]['id'] == 'STALE_TOOLHELP_PID_PARENT_TO_OPENED_HANDLE_OWNERSHIP_GAP',
      'The prior allocation001 refusal remains valid for its original Source. This review addresses only the separate repaired Source.')

# A complete, reversible byte-line edit stream, independently derived from both physical Sources.
operations = []
reconstructed = bytearray()
for tag, i, j, k, l in difflib.SequenceMatcher(a=old_lines, b=new_lines, autojunk=False).get_opcodes():
    before = b''.join(old_lines[i:j])
    after = b''.join(new_lines[k:l])
    record = {'kind': tag, 'old_lines_zero_based_half_open': [i, j],
              'new_lines_zero_based_half_open': [k, l],
              'old_bytes': len(before), 'old_sha256': digest(before),
              'new_bytes': len(after), 'new_sha256': digest(after)}
    if tag == 'equal':
        assert before == after
        reconstructed.extend(after)
    else:
        record['complete_old_fragment_Base64'] = base64.b64encode(before).decode('ascii')
        record['complete_new_fragment_Base64'] = base64.b64encode(after).decode('ascii')
        assert base64.b64decode(record['complete_old_fragment_Base64'], validate=True) == before
        assert base64.b64decode(record['complete_new_fragment_Base64'], validate=True) == after
        reconstructed.extend(base64.b64decode(record['complete_old_fragment_Base64'], validate=True))
    operations.append(record)
check('complete_new_to_old_fragment_inverse_reconstructs_whole_original', bytes(reconstructed) == old,
      {'reconstructed_original_bytes': len(reconstructed), 'reconstructed_original_sha256': digest(reconstructed),
       'edit_regions': sum(row['kind'] != 'equal' for row in operations),
       'unchanged_regions': sum(row['kind'] == 'equal' for row in operations)})
check('complete_original_whole_inverse_canonical_Base64',
      base64.b64decode(base64.b64encode(old), validate=True) == old,
      'Full original bytes and every changed fragment are retained in this proof, independently of peer author bookkeeping.')

def region(source, start, stop):
    return source[source.index(start):source.index(stop, source.index(start))]

protected = [
    ('physical_Pin_nonreparse_singlelink_and_retained_identity', '    static Exception Failure', '    static ProcessBasicInformation BasicIdentity', '    public sealed class OwnedProcess'),
    ('known_root_fallback_and_bounded_drain', '    public static bool StopRetainedRoot', "'@", "'@"),
    ('strict_JSON_metadata_and_pause_resource_helpers', 'function Require(', '$process=$null;', '$process=$null;'),
    ('grant_budgets_fixed_proofs_and_launch_cleanup_complement', " foreach($row in @(@('maximum_jobs',0)", '  $identities=@(', '  $identities=@('),
    ('supervision_schema_and_final_acceptance', "  $super=[ordered]@", '\n}finally{', '\n}finally{'),
]
for name, start, new_end, old_end in protected:
    before = region(old_text, start, old_end)
    after = region(text, start, new_end)
    check('protected_whole_Source_complement_' + name, before == after,
          {'bytes': len(after.encode('utf8')), 'sha256': digest(after.encode('utf8')),
           'meaning': 'Exact byte-identical region, not merely token or AST similarity.'})

has('class0_query_structure_six_native_pointer_width_slots',
    ['[StructLayout(LayoutKind.Sequential)] public struct ProcessBasicInformation { public IntPtr Reserved, Peb, Reserved2, Reserved3; public UIntPtr Pid, ParentPid; }',
     'NtQueryInformationProcess(SafeFileHandle process, int informationClass, out ProcessBasicInformation information, uint length, out uint returned)'],
    '[StructLayout(LayoutKind.Sequential)] public struct ProcessBasicInformation',
    conclusion='Sequential six pointer-width slots place PID and inherited-parent PID at slots 4 and 5: 24 bytes on a 32-bit caller or 48 bytes on a 64-bit caller. Signed NTSTATUS is represented by int; the two lengths are 32-bit uint; handle is retained SafeFileHandle. This is a static ABI inspection, not a compiler, API-availability or native-query measurement.')
has('class0_query_exact_success_length_and_PID_range_fail_closed',
    ['NtQueryInformationProcess(handle,0,out information,length,out returned)',
     'status!=0 || returned!=length', 'information.Pid.ToUInt64()==0',
     'information.Pid.ToUInt64()>UInt32.MaxValue', 'information.ParentPid.ToUInt64()>UInt32.MaxValue'],
    '    static ProcessBasicInformation BasicIdentity', '        return information;',
    'Any nonzero NTSTATUS, unsupported size, zero PID or unrepresentable PID/parent causes refusal. There is no cached-row fallback or silent parent-query waiver.')
has('handle_PID_independently_crosschecked_by_GetProcessId',
    ['uint actualPid=GetProcessId(handle); if(actualPid==0)',
     'actualPid!=expectedPid || before.Pid.ToUInt64()!=expectedPid || after.Pid.ToUInt64()!=expectedPid'],
    '    static ProcessIdentity ExactProcessIdentity', '        return new ProcessIdentity',
    'Both retained class0 query samples and GetProcessId must agree with the expected PID before the handle can be adopted.')
has('creation_parent_and_exit_stability_brackets',
    ['GetProcessTimes(handle,out createdBefore,out exitedBefore',
     'GetProcessTimes(handle,out createdAfter,out exitedAfter',
     'before.ParentPid!=after.ParentPid', 'createdBefore.Value==0 || createdBefore.Value!=createdAfter.Value',
     'exitedBefore.Value!=0 && exitedBefore.Value!=exitedAfter.Value'],
    '    static ProcessIdentity ExactProcessIdentity', '        return new ProcessIdentity',
    'Creation and parent are stable across two samples. A live process may legitimately transition from exit-time zero to nonzero; an already nonzero exit-time must remain equal.')
