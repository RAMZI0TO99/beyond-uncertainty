has('clock_screen_rechecked_before_transfer_to_owned_set',
    ['SnapshotClock(snapshotStarted,snapshotTicks,snapshotTicksAfter);',
     'SnapshotCutoff=snapshotStarted,Handle=handle'],
    '                        var confirmed=ExactProcessIdentity(handle,row.Pid)',
    '                    } catch { handle.Dispose(); throw; }',
    'The last clock screen, count bound and adoption occur inside the same try block with no candidate termination before adoption.')
check('three_clock_screen_calls_exact',
      text.count('SnapshotClock(snapshotStarted,snapshotTicks,snapshotTicksAfter);') == 3,
      'Three calls: after capture, before querying a candidate, and immediately before its adoption; the declaration is separate. No fourth call is claimed.')
has('uncertain_candidate_closed_refused_without_becoming_owned',
    ['} catch { handle.Dispose(); throw; }',
     'Records.Add(new OwnedProcess { Pid=actual.Pid,ParentPid=actual.ParentPid,Created=actual.Created,SnapshotCutoff=snapshotStarted,Handle=handle });'],
    '                    var handle=OpenProcess',
    '                if(!changed) return;',
    'All checks precede Records.Add; throwing closes the unadopted handle. Termination is only later over Records, so an unauthenticated candidate is not terminated by this new path. Discovery failure is reported and forbids successful full-custody claims.')
has('liveness_revalidates_before_and_after_wait',
