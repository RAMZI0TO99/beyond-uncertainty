"""Exactly two Root control fixes after genuine126/2 refusal; Source-only, no subject execution."""
import base64,datetime as dt,hashlib,json,os,ast
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13';LIMIT=2097152
def raw(p):
 p=Path(p);a=p.stat();assert p.is_file() and not p.is_symlink() and a.st_nlink==1 and 0<a.st_size<=LIMIT
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();assert b==p.read_bytes() and len(b)==a.st_size;return b
def pin(p):
 p=Path(p);b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def wire(v):return(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
sp=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';scope=json.loads(raw(sp))
assert pin(sp)['sha256']=='726c201dd6349aca56122129acf71b259b821a667c0720a3a4838ffb8aefe1ad'
def reserve():
 now=dt.datetime.now(dt.timezone.utc);assert dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60
def save(p,b):
 reserve();assert 0<len(b)<=LIMIT and not os.path.lexists(p)
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert raw(p)==b;return pin(p)
refp=R/'input_snapshot_controls_different_Source_review_001/INDEPENDENT_I13_ROOT_SNAPSHOT_CONTROLS002_SOURCE_REFUSAL_CAPSULE_001.json'
assert pin(refp)['sha256']=='d6c94fcd8364a4c881ae8f88928567988a7a49386eabca0cc99e2962bfcf7a3a'
ref=json.loads(raw(refp));assert ref['checks_passed']==126 and ref['checks_failed']==2
oldpaths=[R/'I13_INPUT_SNAPSHOT_SUPERVISOR_CUSTOM_SOURCE_002.py.source',R/'prepare_I13_input_snapshot_once_admission_002.py',R/'author_I13_input_snapshot_Root_controls_002.py',C/'ROOT_I13_ONCE_INPUT_SNAPSHOT_SUPERVISOR_001.py',T/'I13_FIXED6_INPUT_SNAPSHOT_DISJOINT_ROLE_SOURCE_PLAN_001.json',C/'ROOT_I13_INPUT_SNAPSHOT_ROOT_CONTROLS001_SOURCE_AUTHOR_FREEZE_001.json']
old=[(p,raw(p))for p in oldpaths]
s=old[0][1].decode();a="op=='CHILD_TOTAL_ADDITION' and site=='publisher:_prewrite'";assert s.count(a)==1;s=s.replace(a,"op=='CHILD_TOTAL_ADDITION' and site=='publisher:_direct'")
template=save(R/'I13_INPUT_SNAPSHOT_SUPERVISOR_CUSTOM_SOURCE_003.py.source',s.encode())
s=old[1][1].decode();a=" and oldplan['Source_inputs']==plan['Source_inputs']";assert s.count(a)==1;s=s.replace(a,'')
admission=save(R/'prepare_I13_input_snapshot_once_admission_003.py',s.encode())
s=old[2][1].decode()
for a,b in [('I13_INPUT_SNAPSHOT_SUPERVISOR_CUSTOM_SOURCE_002.py.source','I13_INPUT_SNAPSHOT_SUPERVISOR_CUSTOM_SOURCE_003.py.source'),
 ('prepare_I13_input_snapshot_once_admission_002.py','prepare_I13_input_snapshot_once_admission_003.py'),
 ('I13_FIXED6_INPUT_SNAPSHOT_DISJOINT_ROLE_SOURCE_PLAN_001.json','I13_FIXED6_INPUT_SNAPSHOT_DISJOINT_ROLE_SOURCE_PLAN_002.json'),
 ('ROOT_I13_ONCE_INPUT_SNAPSHOT_SUPERVISOR_001.py','ROOT_I13_ONCE_INPUT_SNAPSHOT_SUPERVISOR_002.py'),
 ('ROOT_I13_INPUT_SNAPSHOT_ROOT_CONTROLS001_SOURCE_AUTHOR_FREEZE_001.json','ROOT_I13_INPUT_SNAPSHOT_ROOT_CONTROLS002_SOURCE_AUTHOR_FREEZE_001.json')]:
 assert s.count(a)==1,(a,s.count(a));s=s.replace(a,b)
author=save(R/'author_I13_input_snapshot_Root_controls_003.py',s.encode())
for q in (admission,author):ast.parse(raw(q['path']))
v=dict(schema_version=1,record_type='Root_I13_input_snapshot_control_Source003_complete002_inverses',author='/root',
 created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),Source_scope=pin(sp),genuine_different_Root_controls_refusal=pin(refp),
 predecessors=[dict(pin=pin(p),complete_bytes_base64=base64.b64encode(b).decode())for p,b in old],
 successors=dict(custom_template=template,admission_helper=admission,author_helper=author),
 semantic_changes=['CHILD_TOTAL_ADDITION exact Source site publisher:_direct','spent identity depends on actual modules/APIs/catalogue/fixture and selected roles, independent of roleplan Source_inputs/adoption wrappers'],
 output_ordinal_changes_only=['supervisor001->002','roleplan001->002','Rootcontrolsfreeze001->002'],
 previous_all_Source_bytes_preserved=True,fixture_and_kernel_Source_unchanged=True,subject_calls=0,
 tests_executed=False,target_execution=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
for p,b in old:assert raw(p)==b
vp=save(R/'ROOT_I13_INPUT_SNAPSHOT_CONTROL_SOURCE003_COMPLETE002_INVERSES_001.json',wire(v))
print(json.dumps(dict(inverses=vp,successors=v['successors'],subject_calls=0)))
