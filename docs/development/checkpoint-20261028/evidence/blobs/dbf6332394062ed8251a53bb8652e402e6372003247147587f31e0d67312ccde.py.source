"""Root adopts exact different Source review, granting no actual bundle/copy."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def occurs(v,p):return v==p or(type(v)is dict and any(occurs(x,p)for x in v.values()))or(type(v)is list and any(occurs(x,p)for x in v))
cp=R/'owned_run_bundler_Source_review_001/INDEPENDENT_I13_RUN_BUNDLER002_ARCHIVE006_SOURCE_CAPSULE_001.json';c=load(cp);assert pin(cp)['sha256']=='dfac28a06393a65518c645fd6ff6c8c0731e42fb805296630ead364a0626ca6e'
link=c.get('full_proof',c.get('full_review'));fp=Path(link['path']);f=load(fp);assert pin(fp)==link
for v in(c,f):
 assert v['reviewer']=='/root/project_architecture'and v['verdict'].startswith('PASS_')and v['checks_passed']==144 and v['checks_failed']==0
 assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
assert len(f['checks'])==len({x['name']for x in f['checks']})==144 and all(x['passed']is True for x in f['checks'])
subjects=[pin(R/'prepare_I13_owned_run_metadata_bundles_002.py'),pin(R/'prepare_I13_managed_candidate_006.py')]
assert all(occurs(v,p)for v in(c,f)for p in subjects)
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';now=dt.datetime.now(dt.timezone.utc);assert(dt.datetime.fromisoformat(load(scope)['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_run_bundle_and_publication_helpers_different_Source_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_RUN_BUNDLER002_ARCHIVE006_SOURCE_ONLY',Source_scope=pin(scope),different_Source_review=pin(cp),full_proof=pin(fp),subjects=subjects,checks_passed=144,checks_failed=0,actual_selection_review_and_Root_adoption_required=True,actual_reconstruction_candidate_creation_each_require_different_review_and_Root_adoption=True,actual_bundles_created=False,actual_managed_files_created=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
p=R/'ROOT_I13_RUN_BUNDLER002_ARCHIVE006_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
with p.open('xb')as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(p),calls=0)))
