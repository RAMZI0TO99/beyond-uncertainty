"""Independent static review preserving the two uninvoked Root-adopter001 findings."""
from pathlib import Path
import ast,base64,datetime as dt,hashlib,json,os
R=Path(r'D:\Aenv\pro2\WORK\resume-20261027-001');O=R/'raw_retention_contract_different_review_001';END=dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00');checks=[]
def sha(b):return hashlib.sha256(b).hexdigest()
def fp(p,b):return dict(path=str(p),bytes=len(b),sha256=sha(b))
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def js(b):return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=lambda x:(_ for _ in()).throw(ValueError(x)),parse_constant=lambda x:(_ for _ in()).throw(ValueError(x)))
def ck(n,p,e):assert type(p)is bool;checks.append(dict(name=n,passed=p,evidence=e))
def reserve():assert(END-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
reserve()
oldp=R/'adopt_raw_retention_contract_and_prepare_handoff004_001.py';old=oldp.read_bytes();text=old.decode('utf8');tree=ast.parse(text);oldpin=fp(oldp,old)
invp=R/'ROOT_I13_RETENTION_ADOPTER002_COMPLETE_UNINVOKED001_INVERSE_001.json';invraw=invp.read_bytes();assert(len(invraw),sha(invraw))==(16236,'d08257c82e17eb61411b5971504e3ce4e7f0e78874e92beaaedc770750b7a947');inv=js(invraw)
decoded=base64.b64decode(inv['complete_predecessor_base64'],validate=True)
ck('Root001_exact_whole_Source_preserved_in_002_inverse',inv['complete_predecessor']==oldpin and decoded==old and base64.b64encode(old).decode('ascii')==inv['complete_predecessor_base64'],'Original immutable Source is retained and reviewed as text/AST only, not imported or invoked.')
ck('only_own_stdlib_imports_no_target_exports',all(n.name in{'base64','datetime','hashlib','json','math','os','stat','sys'}for x in tree.body if isinstance(x,ast.Import)for n in x.names)and all(x.module=='pathlib'for x in tree.body if isinstance(x,ast.ImportFrom)),'No project/peer/kernel/fixture import is part of this metadata helper.')
ck('metadata_doc_authenticates_and_parses_one_rawbuffer',all(s in text for s in('b=raw(path);p=fact(path,b)','return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=reject),p')),'This doc reader has correct same-buffer exactfact3 and strict duplicate/nonfinite handling.')
ck('reviewer_verdict_scope_full_proof_and_artifact_joins_present',all(s in text for s in("c['reviewer']==f['reviewer']=='/root/i13_final_review'","c['verdict']==f['verdict']","c['scope']==f['scope']==sp","c['reviewed_artifacts']==f['reviewed_artifacts']")),'The helper binds the concrete final different-review identity,full proof,Source007 and exactnewartifact roster.')
ck('own_new_artifacts_only_no_old_basis_in_roster',"Path(p['path']).is_relative_to(R)"in text and "fact(p['path'])==p"in text,'Old snapshot/source evidence belongs in separate basis fields; only newcontract/plan/adopter artifacts enter reviewed_artifacts.')
ck('fixed_scope_adoption_and_plan_hardpins_present',all(s in text for s in('e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5','a517732dd0b4870e08381fb3ce31baa435385d6ae3e700dd2f014708df3a5969','97fdb498e51580f3eb8bc30ad291d72d5b67fb254f3840128f0ee19e9dbd91e5')),'Exact currentScope007/adoption and whole-record plan are fixed, not caller-selected alternatives.')
ck('Source007_preparation_not_actual_acquisition_adoption',all(s in text for s in('prospective_retention_design_adopted=True','implementation_protocol_adopted=False','raw_acquisition_admitted=False','new_target_or_fixture_Source_authoring_admitted=False','new_tests_admitted=False')),'Only prospective design can be adopted; all execution/Sourceimplementation gates remain held.')
ck('each_write_has_2MiB_50knodes_depth48_strict60reserve',all(s in text for s in('nodes<=50000 and depth<=48','total_seconds()>60',"with p.open('xb')",'os.fsync(h.fileno())',"raw(p)==b")),'Every individual publication requires original bounds, currentSource window/freshstrictreserve,exclusivewrite/fsync/complete readback.')
ck('handoff004_is_WORK_only_pending_creationreview','creation_review_pending=True'in text and 'All such gates are presently UNISSUED' in text and 'No raw capture, builder/fixture calls' in text,'A prepared handoff still needs different saved creation review and Root adoption; it supplies no call or publication authority.')
lines=text.splitlines();findings=[]
for ident,needle,mechanism,fix in[
 ('ROOT_ADOPTER001_EMPTY_INDEPENDENT_CHECK_LIST_NOT_REFUSED',"checks=f['checks'];need(", 'The equality/unique/allTrue expression accepts checks=[] with zero passed/failed counts because all(empty) isTrue. The stated review gate requires a nonempty genuine checkset.', 'Add an exact nonempty list condition len(checks)>0 to the same gate, preserving all current uniqueness/count/true predicates.'),
 ('ROOT_ADOPTER001_SECOND_HANDOFF_INVERSE_BUFFER_NOT_PIN_JOINED','prior,prior_pin=doc(', 'doc first authenticates priorhandoff003, then prior_bytes=raw(prior_pin.path) rereads it. That second buffer is Base64-encoded without rechecking its completefact3 against the authenticated pin, so a replacement can produce an inverse whose bytes disagree with its declared predecessor.', 'Before encoding, require fact(prior_pin.path,prior_bytes)==prior_pin using that exact already-read buffer, or retain the verified doc buffer. Preserve original001 and all other output/authority guards.')]:
 i=next(j for j,s in enumerate(lines)if needle in s);region='\n'.join(lines[i:i+3]);finding=dict(id=ident,severity='blocks_uninvoked_metadata_Source_acceptance',Source=oldpin,line=i+1,exact_Source=region,mechanism=mechanism,required_correction=fix);findings.append(finding);ck(ident,False,finding)
ck('no_original_subject_calls_or_Root_helper_invocation_by_reviewer',True,'Own bounded read/hash/strictJSON/AST/Base64 only. No original/peer/fixture/builder/validator/helper imports,exports,tests,compiler/nativeprocessqueries or acquisition.')
assert len({x['name']for x in checks})==len(checks)and sum(not x['passed']for x in checks)==2
assert oldp.read_bytes()==old and invp.read_bytes()==invraw
scope=dict(path=str(R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json'),bytes=6266,sha256='e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5')
base=dict(schema_version=1,reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),verdict='REFUSE_ROOT_RETENTION_ADOPTER001_TWO_METADATA_BINDING_GAPS',scope=scope,checks_passed=sum(x['passed']for x in checks),checks_failed=2,remaining_actionable_findings=findings,reviewed_artifacts=[oldpin,fp(invp,invraw)],basis=[],ready_for_execution=False,target_execution=False,tests_executed=False,native_Parser_executed=False,operational_authority=False,scientific_authority=False,actual_family_publication=False,claim_limit='Static refusal of uninvokedRootadopter001 only. Original gaps and completeSource remain immutable; additive002 must be independently reviewed. No contract adoption, handoff creation, acquisition or target/native/runtime/science call is accepted or authorized.')
def write(n,v):
 reserve();b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');assert len(b)<=2097152;p=O/n
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert p.read_bytes()==b;return fp(p,b)
full=write('INDEPENDENT_I13_ROOT_RETENTION_ADOPTER001_REFUSAL_FULL_PROOF_001.json',dict(base,record_type='Independent_I13_Root_retention_adopter001_refusal_full',checks=checks,complete_original_Source_Base64=base64.b64encode(old).decode('ascii')))
cap=write('INDEPENDENT_I13_ROOT_RETENTION_ADOPTER001_REFUSAL_CAPSULE_001.json',dict(base,record_type='Independent_I13_Root_retention_adopter001_refusal_capsule',full_proof=full))
print(json.dumps(dict(checks_passed=base['checks_passed'],checks_failed=2,full_proof=full,capsule=cap)))
