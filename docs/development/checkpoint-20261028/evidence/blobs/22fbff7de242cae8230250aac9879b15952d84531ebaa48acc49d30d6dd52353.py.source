"""Own metadata-only acyclic final peer protocol author; no target execution."""
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
def pin(path):
    raw=Path(path).read_bytes();assert 0<len(raw)<=2097152
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
previous=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_002.json'
v=json.loads(previous.read_bytes())
v['previous_complete_protocol']=pin(previous)
v['created_utc']=dt.datetime.now(dt.timezone.utc).isoformat()
v['author_tool']=pin(Path(__file__))
v['catalogue_and_budget']['counter']='One per-peer-invocation shared50000 node budget/depth48 across wrapper, exact raw inner20, supplied-pin snapshots, FULL common catalogue, exact old base catalogue, role-data and every unique designated cached JSON record. Catalogue parsing receives no extra allowance. Each public call unconditionally charges its own full common catalogue; no caller already-charged claim is accepted. Same raw record parsed through multiple local references is cached and charged once locally; separate fixed-port caches may charge the same body again conservatively. Every builtin dictionary key is checked before set/index. Source/non-designated raw bodies are hash-verified, not semantically parsed by default.'
v['remaining_exact_freeze']='Acyclic exact subject set: final peer protocol003 + stable roledata001 are standalone core subjects; final common protocol/catalogue are separately pinned by genuine different reviews and one Root adoption. Common catalogue pins roledata001/basecatalogue002 data only; it does not need to pin peer003. Peer003 deliberately embeds no common final hash. New peer API.protocol points peer003, its peer_role_data/basecatalogue fields point stable data. Final Source author receipt and Root adoption bind all final subjects together without a hash cycle. No target Source authoring until that exact adoption.'
v['exact_additive_resolution']['acyclic_binding']=v['remaining_exact_freeze']
v['exact_additive_resolution']['unconditional_catalogue_charge']='Every public invocation charges full common catalogue, basecatalogue and role-data in its own bounded counter. No opaque/uncharged catalogue, no caller-already-charged assertion.'
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
path=OUT/'I13_PROPOSED_CANONICAL_PEER_AUTHOR_WRAPPER_AND_PUBLICATION_JOIN_PROTOCOL_003.json'
with path.open('xb')as stream:stream.write(raw)
print(json.dumps(pin(path),sort_keys=True))
