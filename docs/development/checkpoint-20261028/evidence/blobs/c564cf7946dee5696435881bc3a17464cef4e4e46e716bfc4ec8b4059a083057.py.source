def need(value,message):
 if not value:raise ValueError(message)
def pin(path):
 path=Path(path);before=path.stat();need(path.is_file() and before.st_nlink==1,'regular singlelink evidence')
 for p in (path,*path.parents):need(not p.is_symlink() and not getattr(p.lstat(),'st_file_attributes',0)&1024,'nonreparse lineage')
 h=hashlib.sha256();size=0
 with path.open('rb') as f:
  while True:
   block=f.read(1048576)
   if not block:break
   h.update(block);size+=len(block)
 after=path.stat();need(size==before.st_size==after.st_size and before.st_ino==after.st_ino and before.st_mtime_ns==after.st_mtime_ns,'stable complete pin')
 return dict(path=str(path),bytes=size,sha256=h.hexdigest())
def doc(path,sha=None):
 p=pin(path);need(p['bytes']<=2097152,'unchangedRoot2MiBparsedcap')
 if sha:need(p['sha256']==sha,'exact evidence pin')
 raw=Path(path).read_bytes();need(hashlib.sha256(raw).hexdigest()==p['sha256'],'same parsed buffer');return json.loads(raw),p
