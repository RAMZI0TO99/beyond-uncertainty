def need(v,m):
 if not v:raise ValueError(m)
def raw(path):
 path=Path(path)
 for p in (path,*path.parents):need(not p.is_symlink() and not getattr(p.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=path.stat();need(path.is_file() and a.st_nlink==1 and a.st_size<=2097152,'unchanged2MiB regular metadata cap')
 with path.open('rb') as f:b=f.read(2097153)
 z=path.stat();need(len(b)<=2097152 and len(b)==a.st_size==z.st_size and a.st_ino==z.st_ino and a.st_mtime_ns==z.st_mtime_ns,'bounded stable exact bytes');return b
def pin(path):
 b=raw(path);return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def doc(path,sha=None):
 b=raw(path);p=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if sha:need(p['sha256']==sha,'exact complete evidence pin')
 return json.loads(b),p
def write(path,v):
 need(not os.path.lexists(path),'unused immutable output identity')
 b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');need(len(b)<=2097152,'unchanged2MiB output cap')
 need((dt.datetime.fromisoformat(scope['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60,'original60second Source reserve')
 with path.open('xb') as f:need(f.write(b)==len(b),'completeCreateNewwrite');f.flush();os.fsync(f.fileno())
 need(raw(path)==b,'whole exact output readback');return pin(path)
