"""Own metadata Source correction only; no project Source is executed."""
import ast, base64, datetime, hashlib, json, os, pathlib
D=pathlib.Path(__file__).parent
R=D.parent
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
def fact(p,b=None):
    if b is None:b=p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def fresh():
    p=R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json';b=p.read_bytes()
    assert hashlib.sha256(b).hexdigest()=='e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5'
    s=json.loads(b.decode('utf8'));now=datetime.datetime.now(datetime.timezone.utc)
    assert datetime.datetime.fromisoformat(s['interval_start'])<=now<datetime.datetime.fromisoformat(s['interval_end'])-datetime.timedelta(seconds=60)
    return now.isoformat(timespec='microseconds')
def save(p,b):
    assert not os.path.lexists(p) and 0<len(b)<=2097152
    fresh()
    with p.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
    assert p.read_bytes()==b
    return fact(p,b)
p=D/'author_retention_contract_metadata_001.py';before=p.read_bytes()
assert fact(p,before)['sha256']=='792d1863ffe34ef7e075d99ad9b4c6a787513dd6e72b38f42f9bb1a52c9c57b5'
old="need(g['record_roster'] == old['record_ledger'], 'complete saved ordinal/pin/label roster')"
new="need(g['record_roster'] == [{k:x[k] for k in ('ordinal','pin','labels')} for x in old['record_ledger']], 'complete saved ordinal/pin/label roster')"
text=before.decode('utf8');assert text.count(old)==1
after=text.replace(old,new).encode('utf8');ast.parse(after.decode('utf8'))
for name in ['I13_RAW_INPUT_RETENTION_COMPLETE_BASIS_AND_PRIOR_HISTORIES_001.json','I13_RAW_INPUT_RETENTION_STATIC_BUILDER_AND_NO_TARGET_CALL_CLOSURE_001.json','I13_PROSPECTIVE_RAW_INPUT_RETENTION_CLOSED_SCHEMA_001.json','I13_PROSPECTIVE_RAW_INPUT_RETENTION_CONTRACT_001.json','I13_RAW_INPUT_RETENTION_CONTRACT001_IMMUTABLE_AUTHOR_FREEZE_001.json']:assert not os.path.lexists(D/name)
successor=save(D/'author_retention_contract_metadata_002.py',after)
inverse=dict(schema_version=1,record_type='I13_metadata_author002_complete001_inverse_and_static_refusal',author='/root/project_architecture',created_utc=fresh(),predecessor=fact(p,before),successor=successor,whole_predecessor_base64=base64.b64encode(before).decode('ascii'),inverse_rule='Strict Base64 decode yields all original001 bytes; only declared single equality expression changed.',old_expression=old,new_expression=new,retained_refusal=dict(tool_chunk='d8f440',actual_tool_exit=1,error_type='ValueError',message='complete saved ordinal/pin/label roster',stage='verify_plan before any output save',reason='Own author compared whole ledger row, including cost/readset fields, to exact three-field selection projection.',contract_JSON_outputs_created=0,project_builders_or_exports_called=0),all_old_files_preserved=True,target_execution=False,operational_authority=False,scientific_authority=False)
saved=save(D/'I13_METADATA_AUTHOR002_COMPLETE001_INVERSE_AND_ZERO_OUTPUT_REFUSAL_001.json',wire(inverse))
assert base64.b64decode(inverse['whole_predecessor_base64'],validate=True)==before
print(json.dumps(dict(successor=successor,inverse=saved),ensure_ascii=True))
