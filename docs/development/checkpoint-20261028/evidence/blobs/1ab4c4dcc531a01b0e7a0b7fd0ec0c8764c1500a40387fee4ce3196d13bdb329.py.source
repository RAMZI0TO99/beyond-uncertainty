 need(k(a)==k(d)==k(e)==k(z) and len(b)==a.st_size<=2097152,'stable samehandle/path exactbuffer');return b

def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

