def need(v, message):
    if not v:
        raise ValueError(message)

def raw(path):
    path = Path(path)
    for q in (path, *path.parents):
        need(not q.is_symlink() and not getattr(q.lstat(), 'st_file_attributes', 0) & 1024, 'direct nonreparse metadata lineage')
    a = path.stat()
    need(stat.S_ISREG(a.st_mode) and a.st_nlink == 1 and 0 <= a.st_size <= 2097152, 'bounded ordinary singlelink metadata')
    with path.open('rb') as h:
        d = os.fstat(h.fileno())
        b = h.read(2097153)
        e = os.fstat(h.fileno())
    z = path.stat()
    k = lambda x: (x.st_dev, x.st_ino, x.st_mode, x.st_nlink, x.st_size, x.st_mtime_ns)
    need(k(a) == k(d) == k(e) == k(z) and len(b) == a.st_size, 'stable samebuffer metadata')
    return b

def pin(path, data=None):
    if data is None:
        data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pairs(items):
    value = {}
    for k, v in items:
        need(k not in value, 'duplicate JSON key')
        value[k] = v
    return value

def bad(value):
    raise ValueError('noninteger or nonfinite JSON number')

def shape(value):
    pending = [(value, 0)]
    nodes = 0
    while pending:
        v, d = pending.pop()
        nodes += 1
        need(nodes <= 50000 and d <= 48, 'bounded metadata shape')
        need(v is None or type(v) in (dict, list, str, int, bool), 'built-in metadata only')
        if type(v) is str:
            need(not any(55296 <= ord(c) <= 57343 for c in v), 'no surrogates')
        elif type(v) is list:
            pending.extend((x, d + 1) for x in v)
        elif type(v) is dict:
            need(all(type(k) is str for k in v), 'string JSON keys')
            for k, x in v.items():
                pending.extend(((k, d + 1), (x, d + 1)))

def doc(path, expected=None):
    data = raw(path)
    fact = pin(path, data)
    if expected is not None:
        need(fact == expected, 'exact metadata fact3 differs')
    obj = json.loads(data.decode('utf-8'), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
    shape(obj)
    return obj, fact

