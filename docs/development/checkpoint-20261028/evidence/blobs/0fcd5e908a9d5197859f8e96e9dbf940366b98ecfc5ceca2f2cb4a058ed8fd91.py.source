s=one(s,"omitted={p['original']['path']:p['original']for p in evidence['members']};rows=[];actual_omitted=[]", "all_members=evidence['members']+run_evidence_value['members'];need(len({p['original']['path'].casefold()for p in all_members})==len(all_members),'disjoint exact helper/run members');omitted={p['original']['path']:p['original']for p in all_members};rows=[];actual_omitted=[]")
