oldscope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json');newscope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json');newadopt=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE003_DIFFERENT_REVIEW_ADOPTION_001.json')
