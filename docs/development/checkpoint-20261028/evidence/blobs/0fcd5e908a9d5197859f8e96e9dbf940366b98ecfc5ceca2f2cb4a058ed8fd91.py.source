with out.open('xb')as h:h.write(b)
v=dict(schema_version=1,record_type='Root_I13_run_bundle_aware_managed_helper004_Source_author_receipt',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),before=pin(p),before_complete_base64=base64.b64encode(before).decode(),after=pin(out),owned_run_bundle_author_Source=pin(runhelper),Source_scope=newscope,original_helper_bundle_header_scope_unchanged=oldscope,actual_helpers_called=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
rp=R/'ROOT_I13_MANAGED_HELPER004_RUN_BUNDLE_SOURCE_AUTHOR_RECEIPT_001.json'
