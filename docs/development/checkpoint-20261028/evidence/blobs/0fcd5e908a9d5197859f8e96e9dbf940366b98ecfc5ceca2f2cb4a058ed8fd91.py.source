s=one(s,"'all160 and only frozen exact helpers bundled'","'all and only exact reviewed helper/run members bundled'")
s=one(s,"need(all(p['path']in source_paths for p in evidence['bundles'])and evidence['bundle_index']['path']in source_paths,'every bundle/index direct copied')", "need(all(p['path']in source_paths for p in evidence['bundles']+run_evidence_value['bundles'])and evidence['bundle_index']['path']in source_paths and run_evidence_value['bundle_index']['path']in source_paths,'every helper/run bundle and index direct copied')")
s=one(s,"metadata_helper_bundles=evidence,transforms=", "metadata_helper_bundles=evidence,owned_run_metadata_bundles=run_evidence_value,transforms=")
s=one(s,"Only exact frozen160 helper Sources use complete Base64 JSON bundles. All other complete bytes stay direct; .py filenames only receive .source suffix. Original internal path pins remain exact.","Only exact reviewed160 helper Sources and exact reviewed owned-run metadata use complete Base64 JSON bundles. All other complete bytes stay direct; .py direct-copy filenames only receive .source suffix. Original internal path pins remain exact.")
s=one(s,"need(evidence==value['metadata_helper_bundles'],'exact complete reviewed bundle context at publication')", "need(evidence==value['metadata_helper_bundles'],'exact complete reviewed helper bundle context at publication')\n    run_evidence_value=run_evidence(Path(value['owned_run_metadata_bundles']['bundle_reconstruction_Root_adoption']['path']))\n    need(run_evidence_value==value['owned_run_metadata_bundles'],'exact complete reviewed run bundle context at publication')")
