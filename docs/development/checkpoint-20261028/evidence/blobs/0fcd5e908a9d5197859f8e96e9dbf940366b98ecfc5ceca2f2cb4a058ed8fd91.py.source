for n in reversed(tree.body):
 if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
  key=n.targets[0].id
  if key=='SCOPE_PIN':lines[n.lineno-1:n.end_lineno]=['HELPER_BUNDLE_SOURCE_SCOPE_PIN = '+repr(oldscope)+'\n','SCOPE_PIN = '+repr(newscope)+'\n']
