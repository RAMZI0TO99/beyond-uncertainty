"""Root exact reviewed Source adoption only; no synthetic invocation."""
import ast,datetime as dt,hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def direct(v,p):
 s=v['subjects'];return p in (list(s.values()) if type(s) is dict else s)
assert len(sys.argv)>=3 and len(sys.argv)%2==1
reviews=[]
for index in range(1,len(sys.argv),2):
 cp=Path(sys.argv[index]);assert pin(cp)['sha256']==sys.argv[index+1];c=load(cp)
 link=c['full_proof'] if 'full_proof' in c else c['full_review'];fp=Path(link['path']);assert pin(fp)==link;f=load(fp)
 for v in (c,f):
  assert v['reviewer']=='/root/i13_final_review' and v['verdict'].startswith('PASS_') and v['checks_failed']==0 and type(v['checks_passed']) is int and v['checks_passed']>0
  assert all(v[k] is False for k in ('tests_executed','target_execution','operational_authority','scientific_authority'))
 assert c['verdict']==f['verdict'] and c['checks_passed']==f['checks_passed']
 assert len(f['checks'])==len({x['name'] for x in f['checks']})==f['checks_passed'] and all(x['passed'] is True for x in f['checks'])
 reviews.append((cp,c,fp,f))
sup=C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_009.py';assert pin(sup)['sha256']=='0ccb15edd857d2a1cc1db0b1025fd8a9cb8bf2f67c37341b949c9330a3dcaea6'
tree=ast.parse(sup.read_bytes()); constants={}
for n in tree.body:
 if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('SOURCES','APIS','FIXTURES','CATALOGUE','PARTITION_PLAN'):constants[n.targets[0].id]=ast.literal_eval(n.value)
assert len(constants)==5
control=R/'prepare_I13_bounded_partition_once_admission_001.py'
composition=T/'current_owner_M3_peer_held_composition_004.py';composition_api=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json'
critical=[*constants['SOURCES'].values(),*constants['APIS'].values(),*constants['FIXTURES'].values(),constants['CATALOGUE'],constants['PARTITION_PLAN'],pin(sup),pin(control),pin(composition),pin(composition_api)]
for p in critical:
 assert pin(p['path'])==p and any(direct(c,p) and direct(f,p) for _,c,_,f in reviews),p['path']
assert all(p['bytes']<=65536 for p in constants['SOURCES'].values()) and pin(composition)['bytes']<=65536
plan=load(constants['PARTITION_PLAN']['path']);names=sum([x['case_names'] for x in plan['partitions']],[])
assert len(plan['partitions'])==30 and len(names)==len(set(names))==936 and hashlib.sha256(('\n'.join(names)+'\n').encode()).hexdigest()=='995ee1ae8d18c2b3093d4f6ff6e9835321ce5da9cff4c6a388a94d5018250f72'
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_002.json';sc=load(scope);now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sc['interval_start'])<=now and (dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
previous=C/'ROOT_I13_ONCE005_DIFFERENT_SAVED_TIMEOUT_ADOPTION_001.json';pv=load(previous);assert pv['own_once005_parent_and_owned_child_custody_closed'] is True and pv['claim_reuse_or_replay_authorized'] is False
protocol=R/'ROOT_I13_FINAL_PROTOCOL007_RECORDED_CONTEXT_DIFFERENT_REVIEW_ADOPTION_004.json'
v=dict(schema_version=1,record_type='Root_I13_exact_bounded_partition_Source_set_different_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_BOUNDED_PARTITION_SOURCE_SET_ONLY',Source_scope=pin(scope),protocol_adoption=pin(protocol),previous_consumed_adoption=pin(previous),subjects=critical,review_adoptions=[dict(capsule=pin(cp),full_proof=pin(fp),checks_passed=c['checks_passed'],checks_failed=0) for cp,c,fp,f in reviews],partition_count=30,original_case_count=936,Source_only=True,automatic_partition_invocations_admitted=False,fresh_exact_once_scope_required_per_partition=True,all_original_caps_and_execution_holds_unchanged=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
out=C/'ROOT_I13_BOUNDED_PARTITION_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_003.json'
with out.open('xb') as h:h.write((json.dumps(v,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(adoption=pin(out),subject_count=len(critical),target_calls=0)))
