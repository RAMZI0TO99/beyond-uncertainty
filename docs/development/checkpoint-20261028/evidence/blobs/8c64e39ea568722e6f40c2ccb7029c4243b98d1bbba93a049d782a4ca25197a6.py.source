def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise ValueError(v)
def stream(spec,maximum=8388608):
 p=Path(spec['path'])
 for q in (p,*p.parents):
  st=q.lstat();assert not q.is_symlink()and not getattr(st,'st_file_attributes',0)&1024
 before=p.stat();assert p.is_file()and before.st_nlink==1 and 0<before.st_size<=maximum
 h=hashlib.sha256();size=0
 with p.open('rb')as f:
  opened=os.fstat(f.fileno())
  while True:
   block=f.read(65536)
   if not block:break
   h.update(block);size+=len(block);assert size<=maximum
  finished=os.fstat(f.fileno())
 after=p.stat();keys=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_nlink');assert all(getattr(before,k)==getattr(after,k)for k in keys)and all(getattr(opened,k)==getattr(finished,k)for k in keys)and opened.st_ino==before.st_ino and opened.st_size==size==before.st_size
 fact=dict(path=str(p),bytes=size,sha256=h.hexdigest());assert fact['sha256']==spec['sha256']and('bytes'not in spec or spec['bytes']==size)
 if fact['path']not in seen:subjects.append(fact);seen.add(fact['path'])
 return fact
