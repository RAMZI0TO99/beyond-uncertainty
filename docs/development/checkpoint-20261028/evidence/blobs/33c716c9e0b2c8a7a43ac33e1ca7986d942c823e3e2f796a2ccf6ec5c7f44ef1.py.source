"""Root adopt reviewed WORK-only handoff003 creation; no execution/publication grant."""
import base64,datetime as dt,hashlib,json,os,sys
from pathlib import Path
R=Path(__file__).parent
def need(v,m):
 if not v:raise ValueError(m)
def raw(path):
 path=Path(path)
 for p in (path,*path.parents):need(not p.is_symlink() and not getattr(p.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=path.stat();need(path.is_file() and a.st_nlink==1 and a.st_size<=2097152,'unchanged2MiB regular metadata cap')
 with path.open('rb') as f:b=f.read(2097153)
 z=path.stat();need(len(b)<=2097152 and len(b)==a.st_size==z.st_size and a.st_ino==z.st_ino and a.st_mtime_ns==z.st_mtime_ns,'stable bounded bytes');return b
def pin(path):
 b=raw(path);return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def doc(path,sha=None):
 b=raw(path);p=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if sha:need(p['sha256']==sha,'exact review/evidence pin')
 return json.loads(b),p
need(len(sys.argv)==3,'exact independent creation capsule path/hash')
capath=Path(sys.argv[1]);need(capath.is_relative_to(R),'own capsule containment')
cap,cp=doc(capath,sys.argv[2]);full,fp=doc(cap['full_proof']['path'],cap['full_proof']['sha256'])
need(fp==cap['full_proof'] and cap['reviewer']==full['reviewer']=='/root/project_architecture' and cap['verdict']==full['verdict'] and cap['verdict'].startswith('PASS_'),'genuine different creation review')
checks=full['checks'];need(cap['checks_failed']==full['checks_failed']==0 and cap['checks_passed']==full['checks_passed']==len(checks)==len({c['name'] for c in checks}) and all(c['passed'] is True for c in checks) and cap['remaining_actionable_findings']==[],'all creation checks passed')
handoff,hp=doc(R/'ROOT_I13_CURRENT_CAUSAL_RECEIPT_DESIGN_AND_EVIDENCE_HANDOFF_003.json','d98a694c79269204239498b1ec4248a3209ec3458d9f786bfd30a26d17ee44b7')
need(cap['handoff']==hp and cap['ready_for_execution'] is False,'exact reviewed held handoff')
scope,sp=doc(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_006.json','9196eaca8c1988c357abfa72881b3e505317ce7faff50dc352b700407848d821')
scopead,sap=doc(R/'ROOT_I13_CURRENT_SOURCE_SCOPE006_DIFFERENT_REVIEW_ADOPTION_001.json','e139f7ade01ea2c005f70eb7e4befff7be06e9fcdfc9e7706b45c2b8878cfea8')
need(handoff['Source_scope']==scopead['Source_scope']==sp and handoff['Source_scope_adoption']==sap,'current adopted finite Source006')
now=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60,'currentSourceandoriginal60reserve')
inverse,ip=doc(handoff['complete_predecessor_handoff_inverse']['path'],handoff['complete_predecessor_handoff_inverse']['sha256']);old=base64.b64decode(inverse['complete_predecessor_base64'],validate=True)
need(ip==handoff['complete_predecessor_handoff_inverse'] and base64.b64encode(old).decode()==inverse['complete_predecessor_base64'] and len(old)==inverse['complete_predecessor']['bytes'] and hashlib.sha256(old).hexdigest()==inverse['complete_predecessor']['sha256'] and raw(inverse['complete_predecessor']['path'])==old,'whole unchanged predecessor inverse')
need(handoff['current_I13_main_result']['passed']==20 and handoff['current_I13_main_result']['failed']==12 and handoff['current_I13_main_result']['remaining_current_cases_unestablished']==904 and handoff['current_I13_main_result']['full936_pass'] is False and len(handoff['compact_receipt_ABI']['remaining_blockers'])==11,'unchanged main result and NOT_READY blockers')
for k in ('proposed_raw_retention_operation_admitted','new_fixture_or_test_call_authorized','new_target_Source_authorized','actual_family_publication','primary_six_documents_modified','STEP081_published','current_workspace_pointer_modified','current_I12_navigation_modified','managed_I13_copy_published','commit_or_push_performed','target_execution','operational_authority','scientific_authority'):need(handoff[k] is False,'held authority boundary '+k)
v=dict(schema_version=1,record_type='Root_I13_handoff003_different_creation_review_adoption',author='/root',created_utc=now.isoformat(),current_handoff=hp,Source_scope=sp,Source_scope_adoption=sap,genuine_different_creation_review=cp,genuine_different_full_proof=fp,checks_passed=len(checks),checks_failed=0,complete_predecessor_handoff_inverse=ip,
 Root_decision='Adopt exact reviewed WORK-only handoff003 creation as current Source-only evidence navigation. The handoff links partial causal-design integrity notes, fresh workspace preservation and separately scoped peer020 historical metadata/custody. All11 ABI implementation/fit blockers and main20PASS/12FAIL/904unestablished remain. No raw acquisition, target Source, test, family/primary-document/Git publication or operational/native/runtime/science authority follows.',
 handoff_creation_accepted=True,implementation_protocol_adopted=False,overall_NOT_READY=True,new_raw_retention_operation_authorized=False,new_fixture_or_once_call_authorized=False,new_target_Source_authorized=False,peer_engineering_runtime_or_science_results_accepted=False,actual_family_publication=False,STEP081_published=False,Git_commit_or_push_performed=False,Native8=False,Parser=False,runtime=False,science=False,target_execution=False,operational_authority=False,scientific_authority=False,Source_only_window_end=scope['interval_end'],publication_reserve_seconds=60,creation_adopter_Source=pin(Path(__file__)))
out=R/'ROOT_I13_HANDOFF003_DIFFERENT_CREATION_REVIEW_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');need(len(b)<=2097152 and not os.path.lexists(out),'unused bounded immutable creation adoption')
with out.open('xb') as f:need(f.write(b)==len(b),'completeCreateNew');f.flush();os.fsync(f.fileno())
need(raw(out)==b,'whole final adoption readback');print(json.dumps(dict(adoption=pin(out),current_handoff=hp,all_execution_gates_held=True)))
