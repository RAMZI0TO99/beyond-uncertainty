def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'singlelink bounded metadata')
 with p.open('rb') as h:d=os.fstat(h.fileno());b=h.read(2097153);e=os.fstat(h.fileno())
 z=p.stat();k=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns)
 need(k(a)==k(d)==k(e)==k(z) and len(b)==a.st_size,'stable exactbytes');return b

def pin(p,b=None):
 if b is None:b=raw(p)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def write(name,b,cap=2097152):
 need(len(b)<=cap and (END-dt.datetime.now(dt.timezone.utc)).total_seconds()>60,'originalcap/fresh60reserve')
 p=R/name
 with p.open('xb') as h:need(h.write(b)==len(b),'wholeexclusive');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'whole savedreadback');return pin(p,b)

def data(name,v):return write(name,(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode())

