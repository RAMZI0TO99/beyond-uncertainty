def report(source,root):
 lines=source.splitlines(keepends=True);out=[]
 for n in ast.walk(root):
  if type(n) in (ast.FunctionDef,ast.ClassDef):
   block=''.join(lines[n.lineno-1:n.end_lineno]).encode()
   out.append(dict(symbol=n.name,line=n.lineno,end_line=n.end_lineno,UTF8_sha256=hashlib.sha256(block).hexdigest(),AST_sha256=hashlib.sha256(ast.dump(n,include_attributes=False).encode()).hexdigest(),calls=sorted(set(ast.unparse(c.func) for c in ast.walk(n) if type(c)is ast.Call))))
 return out
