_on_proof_not_exempt_actor', 'peer_F02_same_catalogue_key_on_proof_not_exempt_C0', 'peer_F02_exact_fixed_I11_API_examples_remain_descriptive_positive', 'peer_F02_fixed_I11_extra_graph_isolation', 'peer_outer_canonical_positive_metadata_peer', 'peer_outer_canonical_positive_metadata_bound_review', 'peer_outer_canonical_positive_phase_peer', 'peer_outer_canonical_positive_pipeline_peer', 'peer_outer_canonical_positive_checker_peer', 'peer_outer_current_prewrite_positive', 'peer_outer_prior_canonical_after_source_and_lease_end_positive', 'peer_outer_fresh_outer_graph_and_global_isolation', 'peer_outer_old_prewrite14_actual_shape_refused', 'peer_outer_old_publication31_actual_shape_refused', 'peer_outer_author_receipt27_alone_not_canonical', 'peer_outer_publication_whole_prewrite_pin_join', 'peer_outer_request_author_receipt_valid_other_pin_join', 'peer_outer_canonical_role_valid_other_peer_join', 'peer_outer_canonical_packet_closed_unknown_key', 'peer_outer_packet_aggregate_node_budget', 'peer_outer_whole_store_casefold_alias', 'peer_outer_whole_store_record_count257', 'peer_outer_new_prewrite_UTC7_refused', 'peer_outer_publisher_actual_hold_false', 'peer_outer_publisher_actual_hold_true', 'peer_outer_child_role_data_roster_omitted', 'peer_outer_child_role_data_birth_omitted', 'peer_outer_child_full_historical45_roster_omitted', 'peer_outer_child_full_historical45_birth_omitted', 'peer_outer_parent_actor_raw_draft_source_author', 'peer_outer_parent_actor_raw_predecessor_metadata_peer_source_author', 'peer_outer_parent_actor_raw_draft_reviewer', 'peer_nonfixed_descriptor_actor_author', 'peer_nonfixed_descriptor_actor_retained']}
OWNED_PARENT_ROOT = Path(__file__).parent / 'owned_memory_runs'
BUDGETS = dict(total_seconds=60, wait_seconds=50, cleanup_seconds=10, reap_seconds=5,
               stdout_maximum_bytes=2097152, stderr_maximum_bytes=2097152)
SCOPE_KEYS = ('schema_version', 'record_type', 'author', 'created_utc', 'interval_start', 'interval_end',
              'operation', 'maximum_suite_invocations', 'source_scope', 'protocol_adoption', 'source_adoption',
              'modules', 'APIs', 'catalogue', 'fixtures', 'supervisor', 'runtime', 'prelaunch', 'outputs', 'budgets', 'target_execution',
              'operational_authority', 'scientific_authority', 'actual_family_publication')
OUTPUT_KEYS = ('claim', 'child_entry', 'child_result', 'stdout', 'stderr', 'supervisor_result')


def need(ok, message):
    if not ok:
        raise ValueError(message)


def wire(value):
    return (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode('utf8')


def utc():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')


def pairs(items):
    result = {}
    for k, v in items:
        need(k not in result, 'duplicate JSON name')
        result[k] = v
    return result


def bad_number(value):
    raise ValueError('non-integer JSON number')


def decode(raw):
    return json.loads(raw.decode('utf8'), object_pairs_hook=pairs, parse_float=bad_number, parse_constant=bad_number)


def ordinary(path, file=True):
    path = Path(path)
    need(path.is_absolute() and '..' not in path.parts, 'absolute ordinary path')
    for parent in reversed(path.parents):
        info = parent.lstat()
        need(parent.is_dir() and not parent.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary parent')
    if file:
        info = path.lstat()
        need(path.is_file() and not path.is_symlink() and info.st_nlink == 1 and
             not getattr(info, 'st_file_attributes', 0) & 1024, 'ordinary single-link file')
    return path


def read_pin(pin, cap=2097152):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'} and
         type(pin['bytes']) is int and 0 < pin['bytes'] <= cap and type(pin['sha256']) is str and
         re.fullmatch('[0-9a-f]{64}', pin['sha256']) is not None, 'exact bounded positive pin')
    path = ordinary(pin['path'])
    before = path.stat()
    with path.open('rb') as handle:
        first = handle.read(cap + 1)
        handle.seek(0)
        second = handle.read(cap + 1)
        fd = os.fstat(handle.fileno())
    after = path.stat()
    names = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns', 'st_mode', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')
    vector = lambda value: tuple(getattr(value, name, None) for name in names)
    need(vector(before) == vector(after) and all(getattr(fd, k, None) == getattr(after, k, None)
         for k in ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_nlink', 'st_file_attributes', 'st_birthtime_ns')), 'owned input changed')
    need(first == second and len(first) == pin['bytes'] and hashlib.sha256(first).hexdigest() == pin['sha256'], 'whole bytes pin')
    return first


def read_limited(path, cap=2097152):
    path = ordinary(path)
    with path.open('rb') as handle:
        raw = handle.read(cap + 1)
    need(0 < len(raw) <= cap, 'bounded metadata input')
    return raw


def fact(path, raw):
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


def occurs(value, pin):
    if type(value) is dict:
        if set(value) == {'path', 'bytes', 'sha256'} and all(type(value[k]) is type(v) and value[k] == v for k, v in pin.items()):
            return True
        return any(occurs(v, pin) for v in value.values())
    return type(value) is list and any(occurs(v, pin) for v in value)


def write_new(path, body):
    need(type(body) is bytes and len(body) <= 2097152, 'bounded owned output')
    path = ordinary(path, False)
    need(not os.path.lexists(path), 'exclusive absent owned output')
    with path.open('xb') as handle:
        need(handle.write(body) == len(body), 'whole owned output')
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path, body)


def scope(path, expected_hash):
    path = ordinary(path)
    raw = read_limited(path)
    need(hashlib.sha256(raw).hexdigest() == expected_hash, 'exact Root once-scope hash')
    value = decode(raw)
    need(type(value) is dict and set(value) == set(SCOPE_KEYS) and type(value['schema_version']) is int and value['schema_version'] == 1 and
         value['record_type'] == 'Root_I13_once_owned_synthetic_memory_scope' and value['author'] == '/root' and
         value['operation'] == 'NEW_I13_SYNTHETIC_MEMORY_TEST_ONLY' and type(value['maximum_suite_invocations']) is int and
         value['maximum_suite_invocations'] == 1 and value['budgets'] == BUDGETS and
         all(value[k] is False for k in ('target_execution', 'operational_authority', 'scientific_authority', 'actual_family_publication')), 'exact synthetic-only scope')
    parse_time = lambda x: dt.datetime.fromisoformat(x)
    now = dt.datetime.now(dt.timezone.utc)
    need(parse_time(value['created_utc']) <= now and parse_time(value['interval_start']) <= now < parse_time(value['interval_end']), 'fresh one-use scope window')
    need(value['modules'] == SOURCES and value['APIs'] == APIS and value['catalogue'] == CATALOGUE and value['fixtures'] == FIXTURES, 'exact frozen three new modules/APIs/catalogue/two fixtures')
    need(Path(value['supervisor']['path']) == Path(__file__), 'exact supervisor path')
    for key in ('catalogue', 'supervisor', 'runtime', 'source_scope', 'protocol_adoption', 'source_adoption', 'prelaunch'):
        read_pin(value[key])
    for source_pin in SOURCES.values():
        read_pin(source_pin, cap=65536)
    for name, api_pin in APIS.items():
        need(decode(read_pin(api_pin))['Source'] == SOURCES[name], 'whole new API Source join')
    for fixture_pin in FIXTURES.values():
        read_pin(fixture_pin)
    need(os.path.normcase(value['runtime']['path']) == os.path.normcase(sys.executable), 'pinned general-host runtime; no frozen interpreter fallback')
    source_scope = decode(read_pin(value['source_scope']))
    need(source_scope.get('author') == '/root' and source_scope.get('record_type') == 'Root_current_I13_M3_producer_publisher_and_canonical_peer_Source_scope' and
         source_scope.get('target_execution') is False and source_scope.get('operational_authority') is False and
         parse_time(source_scope['interval_start']) <= now < parse_time(source_scope['interval_end']) and
         parse_time(value['interval_end']) <= parse_time(source_scope['interval_end']), 'current Source scheduling preserved')
    adoption = decode(read_pin(value['source_adoption']))
    need(adoption.get('author') == '/root' and type(adoption.get('verdict')) is str and adoption['verdict'].startswith('ACCEPT_') and
         adoption.get('target_execution') is False and adoption.get('operational_authority') is False and
         all(occurs(adoption, value[k]) for k in ('catalogue', 'supervisor')) and all(occurs(adoption, p) for p in tuple(SOURCES.values()) + tuple(APIS.values()) + tuple(FIXTURES.values())), 'actual Root Source adoption covers exact new programs/APIs and supervisor')
    prelaunch = decode(read_pin(value['prelaunch']))
    need(prelaunch.get('record_type') == 'Root_I13_fresh_once_synthetic_prelaunch_metadata' and
         prelaunch.get('source_scope') == value['source_scope'] and prelaunch.get('source_adoption') == value['source_adoption'] and
         prelaunch.get('peer_reported_full_custody_release') is True and prelaunch.get('new_peer_grant_after_release') is False and
         prelaunch.get('target_execution') is False and prelaunch.get('operational_authority') is False and
         type(prelaunch.get('available_RAM_bytes')) is int and prelaunch['available_RAM_bytes'] >= 1073741824 and
         type(prelaunch.get('disk_free_bytes')) is int and prelaunch['disk_free_bytes'] >= 10737418240 and
         0 <= (now - parse_time(prelaunch['observed_utc'])).total_seconds() <= 60, 'fresh resources and reported peer custody release; no host quiet inference')
    peer_report = decode(read_pin(prelaunch['peer_custody_release_report']))
    need(peer_report.get('reported_full_compute_custody_released') is True and peer_report.get('grant_consumed_closed') is True and
         peer_report.get('Root_acceptance', {}).get('peer_result_accepted') is False, 'retained peer report only; original gates held')
    need(type(value['outputs']) is dict and set(value['outputs']) == set(OUTPUT_KEYS), 'exact six owned outputs')
    outputs = [ordinary(v, False) for v in value['outputs'].values()]
    need(len({str(p).casefold() for p in outputs}) == 6 and len({p.parent for p in outputs}) == 1 and
         all(p.suffix in ('.json', '.txt') for p in outputs), 'one prepared owned output namespace')
    need(all(p.parent.parent == OWNED_PARENT_ROOT for p in outputs), 'declared synthetic owned attempt directory only')
    need(not any(str(p).casefold() == q['path'].casefold() for p in outputs for q in tuple(SOURCES.values()) + tuple(APIS.values()) + tuple(FIXTURES.values()) + (value['catalogue'], value['supervisor'])), 'inputs distinct from outputs')
    return value, fact(path, raw)


def load_new(name, pin, api_pin=None):
    raw = read_pin(pin)
    module = types.ModuleType(name)
    module.__file__ = pin['path']
    exec(compile(raw, pin['path'], 'exec'), module.__dict__)
    module.__source_pin__ = dict(pin)
    module.__source_bytes__ = raw
    if api_pin is not None:
        module.__API_pin__ = dict(api_pin)
        module.__API_bytes__ = read_pin(api_pin)
    return module


DIAGNOSTIC_PART_KEYS = {'cases','passed','failed','failures','metadata_only','actual_family_publication','target_execution','operational_authority','scientific_authority'}

def validate_diagnostic_part(part, expected_names):
    need(type(part) is dict and all(type(k) is str for k in part) and set(part) == DIAGNOSTIC_PART_KEYS, 'closed diagnostic fixture result')
    need(part['metadata_only'] is True and all(part[k] is False for k in ('actual_family_publication','target_execution','operational_authority','scientific_authority')), 'diagnostic metadata holds')
    cases, failures = part['cases'], part['failures']
    need(type(cases) is list and len(cases) == len(expected_names) and all(type(c) is dict and all(type(k) is str for k in c) and set(c) == {'name','passed'} and type(c['name']) is str and type(c['passed']) is bool for c in cases), 'typed complete diagnostic cases')
    need([c['name'] for c in cases] == expected_names, 'exact diagnostic case order')
    passed = sum(c['passed'] is True for c in cases)
    need(type(part['passed']) is int and part['passed'] == passed and type(part['failed']) is int and part['failed'] == len(cases)-passed, 'honest diagnostic counts')
    need(type(failures) is list and len(failures) == part['failed'], 'bounded diagnostic failure count')
    for f in failures:
        need(type(f) is dict and all(type(k) is str for k in f) and set(f) == {'name','exception_type','expected_code','actual_code','message'}, 'closed five-field diagnostic failure')
        need(type(f['name']) is str and type(f['exception_type']) is str and 0 < len(f['exception_type']) <= 128 and type(f['message']) is str and len(f['message']) <= 512 and all(f[k] is None or type(f[k]) is str and 0 < len(f[k]) <= 128 for k in ('expected_code','actual_code')), 'bounded typed diagnostic failure')
    need([f['name'] for f in failures] == [c['name'] for c in cases if c['passed'] is False], 'exact failed-case detail correspondence')


def child(scope_path, expected_hash):
    value, scope_pin = scope(scope_path, expected_hash)
    need(sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1, 'isolated -I -S -B child')
    outputs = value['outputs']
    claim_raw = read_limited(outputs['claim'])
    claim = decode(claim_raw)
    need(claim.get('record_type') == 'I13_once_scope_claim' and claim.get('scope') == scope_pin and
         claim.get('supervisor') == value['supervisor'] and type(claim.get('suite_invocations_maximum')) is int and
         claim['suite_invocations_maximum'] == 1 and type(claim.get('parent_pid')) is int and
         claim['parent_pid'] == os.getppid(), 'actual owned parent claim/scope identity')
    write_new(outputs['child_entry'], wire(dict(record_type='I13_owned_child_entry_before_target_import', created_utc=utc(), pid=os.getpid(), scope=scope_pin)))
    m3 = load_new('_i13_fixed_m3', SOURCES['m3'], APIS['m3'])
    peer = load_new('_i13_fixed_peer', SOURCES['peer'], APIS['peer'])
    publisher = load_new('_i13_fixed_publisher', SOURCES['publisher'], APIS['publisher'])
    catalogue_bytes = read_pin(CATALOGUE)
    fixtures = {key: load_new('_i13_new_fixture_' + key, FIXTURES[key]) for key in ('m3_publisher', 'peer')}
    print(json.dumps(dict(event='SUITE_ENTRY', case_count=sum(len(f.CASE_CATALOGUE) for f in fixtures.values()))), flush=True)
    cases = []
    failures = []
    for key in ('m3_publisher', 'peer'):
        part = fixtures[key].run_diagnostic(m3=m3, publisher=publisher, peer=peer, catalogue_bytes=catalogue_bytes)
        validate_diagnostic_part(part, EXPECTED_CASE_NAMES_BY_FIXTURE[key])
        cases.extend(part['cases'])
        failures.extend(part['failures'])
    passed = sum(c['passed'] is True for c in cases)
    result = dict(schema_version=1, record_type='I13_owned_synthetic_memory_case_results', cases=cases, passed=passed, failed=len(cases)-passed, failures=failures,
                  metadata_only=True, actual_family_publication=False, target_execution=False, operational_authority=False, scientific_authority=False)
    result.update(owned_pid=os.getpid(), scope=scope_pin, created_utc=utc())
    write_new(outputs['child_result'], wire(result))
    print(json.dumps(dict(event='SUITE_COMPLETE', passed=result['passed'], failed=result['failed'])), flush=True)
    return 0


def parent(scope_path, expected_hash):
    start = time.monotonic()
    value, scope_pin = scope(scope_path, expected_hash)
    outputs = value['outputs']
    need((dt.datetime.fromisoformat(value['interval_end']) - dt.datetime.now(dt.timezone.utc)).total_seconds() > 60, 'original60 reserve before claim/child launch')
    need(not any(os.path.lexists(p) for p in outputs.values()), 'all fresh owned identities absent; no reuse')
    claim = write_new(outputs['claim'], wire(dict(record_type='I13_once_scope_claim', created_utc=utc(), scope=scope_pin, supervisor=value['supervisor'], suite_invocations_maximum=1, parent_pid=os.getpid())))
    try:
        proc = subprocess.Popen([sys.executable, '-I', '-S', '-B', str(Path(__file__)), '--child', str(scope_path), expected_hash],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
    except OSError as exc:
        elapsed = time.monotonic() - start
        refused = dict(schema_version=1, record_type='I13_owned_once_memory_supervisor_result', created_utc=utc(), scope=scope_pin,
                       claim=claim, owned_pid=None, exit_code=None, reaped=False, child_launched=False,
                       acceptance_at_record_preparation=False, refusal='CHILD_LAUNCH_REFUSAL', exception_type=type(exc).__name__,
                       elapsed_milliseconds=int(elapsed*1000), budgets=BUDGETS, target_execution=False,
                       actual_family_publication=False, operational_authority=False, scientific_authority=False,
                       physical_host_or_PID_absence_proved=False)
        result_pin = write_new(outputs['supervisor_result'], wire(refused))
        final_elapsed = time.monotonic() - start
        print(json.dumps(dict(accepted=False, refusal='CHILD_LAUNCH_REFUSAL', supervisor_result=result_pin,
                              final_elapsed_milliseconds=int(final_elapsed*1000))), flush=True)
        return 1
    buffers = {'stdout': bytearray(), 'stderr': bytearray()}
    counts = {'stdout': 0, 'stderr': 0}
    overflow = threading.Event()
    pump_failed = threading.Event()
    stream_eof = {'stdout': False, 'stderr': False}
    pump_errors = {'stdout': None, 'stderr': None}
    def pump(name, pipe):
        try:
            while True:
                chunk = pipe.read(65536)
                if not chunk:
                    stream_eof[name] = True
                    break
                counts[name] += len(chunk)
                if counts[name] > 2097152:
                    overflow.set()
                remaining = 2097152 - len(buffers[name])
                if remaining > 0:
                    buffers[name].extend(chunk[:remaining])
        except Exception as exc:
            pump_errors[name] = type(exc).__name__
            pump_failed.set()
        finally:
            try:
                pipe.close()
            except Exception as exc:
                pump_errors[name] = type(exc).__name__
                pump_failed.set()
    threads = [threading.Thread(target=pump, args=(name, getattr(proc, name)), daemon=True) for name in ('stdout', 'stderr')]
    for thread in threads:
        thread.start()
    reason = None
    while proc.poll() is None:
        if pump_failed.is_set():
            reason = 'STREAM_CAPTURE_REFUSAL'; break
        if overflow.is_set():
            reason = 'OUTPUT_CAP_REFUSAL'; break
        if time.monotonic() - start >= 50:
            reason = 'WAIT50_TIMEOUT'; break
        time.sleep(0.01)
    terminated = killed = False
    custody_error = None
    if proc.poll() is None:
        try:
            proc.terminate(); terminated = True
            try:
                proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
            except subprocess.TimeoutExpired:
                proc.kill(); killed = True
                try:
                    proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
                except subprocess.TimeoutExpired:
                    reason = 'FINAL_REAP_TIMEOUT'
        except OSError as exc:
            custody_error = type(exc).__name__
            reason = 'OWNED_CLEANUP_REFUSAL'
    else:
        try:
            proc.wait(timeout=max(0, min(5, 60 - (time.monotonic() - start))))
        except subprocess.TimeoutExpired:
            reason = 'FINAL_REAP_TIMEOUT'
    for thread in threads:
        thread.join(timeout=max(0, min(1, 60 - (time.monotonic() - start))))
    threads_finished = not any(t.is_alive() for t in threads)
    drained = threads_finished and all(stream_eof.values()) and not any(pump_errors.values())
    if not drained:
        reason = reason or 'STREAM_DRAIN_REFUSAL'
    stdout = write_new(outputs['stdout'], bytes(buffers['stdout']))
    stderr = write_new(outputs['stderr'], bytes(buffers['stderr']))
    result = None
    if os.path.lexists(outputs['child_result']):
        try:
            path = ordinary(outputs['child_result']); body = read_limited(path)
            decoded = decode(body)
            need(type(decoded) is dict, 'child result object')
            result = dict(pin=fact(path, body), value=decoded)
        except (OSError, ValueError, UnicodeError) as exc:
            reason = reason or 'CHILD_RESULT_REFUSAL'
            child_result_error = type(exc).__name__
        else:
            child_result_error = None
    else:
        child_result_error = None
    catalogue_valid = False
    if result is not None:
        child_value = result['value']
        cases = child_value.get('cases')
        if type(cases) is list and len(cases) == EXPECTED_CASE_COUNT and all(type(c) is dict and set(c) == {'name', 'passed'} and
                type(c['name']) is str and c['passed'] is True for c in cases):
            names = [c['name'] for c in cases]
            catalogue_valid = (hashlib.sha256(json.dumps(names, separators=(',', ':'), ensure_ascii=True).encode()).hexdigest() == EXPECTED_CASE_NAMES_SHA256 and
                               len(set(names)) == len(names) and type(child_value.get('passed')) is int and child_value['passed'] == EXPECTED_CASE_COUNT and
                               type(child_value.get('failed')) is int and child_value['failed'] == 0 and child_value.get('metadata_only') is True and
                               child_value.get('record_type') == 'I13_owned_synthetic_memory_case_results' and child_value.get('scope') == scope_pin and
                               type(child_value.get('owned_pid')) is int and child_value['owned_pid'] == proc.pid and
                               all(child_value.get(k) is False for k in ('actual_family_publication', 'target_execution', 'operational_authority', 'scientific_authority')))
    diagnostic_complete = False
    diagnostic_failures = None
    if result is not None:
        try:
            child_value = result['value']
            need(type(child_value) is dict and child_value.get('record_type') == 'I13_owned_synthetic_memory_case_results' and type(child_value.get('schema_version')) is int and child_value['schema_version'] == 1 and child_value.get('scope') == scope_pin and type(child_value.get('owned_pid')) is int and child_value['owned_pid'] == proc.pid, 'diagnostic child identity')
            projection = {key: child_value.get(key) for key in DIAGNOSTIC_PART_KEYS}
            expected_names = sum((EXPECTED_CASE_NAMES_BY_FIXTURE[key] for key in ('m3_publisher','peer')), [])
            validate_diagnostic_part(projection, expected_names)
            diagnostic_complete = True
            diagnostic_failures = projection['failed']
        except (ValueError, TypeError, KeyError):
            diagnostic_complete = False
    events = None
    if drained and not overflow.is_set():
        try:
            events = [decode(line) for line in bytes(buffers['stdout']).splitlines() if line]
        except (ValueError, UnicodeError):
            events = None
    known_entry = None if events is None else any(type(e) is dict and e.get('event') == 'SUITE_ENTRY' for e in events)
    known_pass_events = None if events is None else sum(type(e) is dict and e.get('event') == 'CASE_PASS' for e in events)
    known_fail_events = None if events is None else sum(type(e) is dict and e.get('event') == 'CASE_FAIL' for e in events)
    known_pass_prefix = None if events is None else 0
    if events is not None:
        for event in events:
            if type(event) is dict and event.get('event') == 'CASE_FAIL':
                break
            if type(event) is dict and event.get('event') == 'CASE_PASS':
                known_pass_prefix += 1
    if reason is None and diagnostic_complete and diagnostic_failures > 0:
        reason = 'SYNTHETIC_CASE_FAILURES'
    # This sample includes reap, stream drains, stdout/stderr writes and result
    # parsing. The create-once witness reports this candidate honestly. Final
    # acceptance is sampled again after its fsync and joined to parent exit0.
    acceptance_elapsed_ns = int((time.monotonic() - start) * 1000000000)
    if acceptance_elapsed_ns > 60000000000:
        reason = 'TOTAL60_REFUSAL'
    accepted = reason is None and proc.returncode == 0 and drained and not overflow.is_set() and catalogue_valid and diagnostic_complete and acceptance_elapsed_ns <= 60000000000
    witness = dict(schema_version=1, record_type='I13_owned_once_memory_supervisor_result', created_utc=utc(), scope=scope_pin, claim=claim,
                   owned_pid=proc.pid, exit_code=proc.returncode, reaped=proc.returncode is not None, streams_drained=drained,
                   terminated=terminated, killed=killed, refusal=reason, stdout=stdout, stderr=stderr, observed_stream_bytes=counts,
                   stream_threads_finished=threads_finished, actual_stream_EOF=stream_eof, stream_pump_errors=pump_errors,
                   elapsed_milliseconds=acceptance_elapsed_ns//1000000, acceptance_elapsed_nanoseconds=acceptance_elapsed_ns, budgets=BUDGETS, child_result=result,
                   acceptance_at_record_preparation=accepted, final_acceptance_requires_saved_console_and_parent_exit0=True,
                   child_launched=True, custody_error=custody_error, child_result_error=child_result_error,
                   actual_family_publication=False, target_execution=False,
                   operational_authority=False, scientific_authority=False, physical_host_or_PID_absence_proved=False,
                   diagnostic_complete_case_catalogue_valid=diagnostic_complete, diagnostic_failure_count=diagnostic_failures, known_case_pass_events_from_complete_stdout=known_pass_events, known_case_fail_events_from_complete_stdout=known_fail_events,
                   actual_case_catalogue_valid=catalogue_valid, expected_case_count=EXPECTED_CASE_COUNT,
                   expected_case_names_sha256=EXPECTED_CASE_NAMES_SHA256,
                   known_suite_entry_from_complete_stdout=known_entry, known_case_pass_prefix_from_complete_stdout=known_pass_prefix,
                   child_result_absent=result is None, progress_unknown_without_complete_streams=events is None)
    witness_pin = write_new(outputs['supervisor_result'], wire(witness))
    # Reporting boundary: no rewrite of the saved candidate. Final console and
    # actual parent exit must both be retained and joined with this exact pin.
    final_elapsed_ns = int((time.monotonic() - start) * 1000000000)
    final_accepted = accepted and final_elapsed_ns <= 60000000000
    final_reason = 'TOTAL60_REFUSAL' if final_elapsed_ns > 60000000000 else reason
    print(json.dumps(dict(accepted=final_accepted, refusal=final_reason, supervisor_result=witness_pin,
                          owned_pid=proc.pid, exit_code=proc.returncode, final_elapsed_nanoseconds=final_elapsed_ns,
                          acceptance_at_record_preparation=accepted, reaped=proc.returncode is not None,
                          streams_drained=drained, actual_stream_EOF=stream_eof, stream_pump_errors=pump_errors,
                          total_budget_nanoseconds=60000000000)), flush=True)
    return 0 if final_accepted else 1


def main():
    args = sys.argv[1:]
    is_child = bool(args and args[0] == '--child')
    if is_child:
        args = args[1:]
    need(len(args) == 2 and re.fullmatch('[0-9a-f]{64}', args[1]) is not None, 'scope path and exact SHA256 required')
    return child(*args) if is_child else parent(*args)


if __name__ == '__main__':
    raise SystemExit(main())
