def walk(v,path=''):
 global schema_count
 if type(v) is dict:
  if 'exact_keys' in v:
   keys=v['exact_keys'];check(type(keys) is list and all(type(k) is str for k in keys) and len(keys)==len(set(keys)),'unique_schema_keys_'+path,keys)
   check(type(v['field_count']) is int and v['field_count']==len(keys),'schema_count_'+path,v['field_count'])
   if 'fields' in v:check(set(v['fields'])==set(keys),'schema_field_map_'+path,list(v['fields']))
   schema_count+=1
  for k,x in v.items():walk(x,path+'/'+k)
 elif type(v) is list:
  for i,x in enumerate(v):walk(x,path+'/'+str(i))
