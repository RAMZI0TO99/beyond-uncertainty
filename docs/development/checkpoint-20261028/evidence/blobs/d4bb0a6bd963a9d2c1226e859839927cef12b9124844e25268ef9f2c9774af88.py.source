"""Independent Root-created WORK handoff review; no project Source execution."""
import ast,base64,datetime,hashlib,json,os,pathlib,stat,subprocess
D=pathlib.Path(__file__).parent;R=D.parent
checks=[]
def check(name,value,evidence):
    checks.append(dict(name=name,passed=value is True,evidence=evidence))
def need(v,m):
    if not v:raise ValueError(m)
def raw(p):
    p=pathlib.Path(p)
    for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary lineage')
    a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<a.st_size<=2097152,'bounded complete regular bytes')
    with p.open('rb')as f:
        b0=os.fstat(f.fileno());b=f.read(2097153);b1=os.fstat(f.fileno())
    z=p.stat();identity=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
    need(identity(a)==identity(b0)==identity(b1)==identity(z) and len(b)==a.st_size,'samebuffer stable read')
    return b
def fact(p,b=None):
    if b is None:b=raw(p)
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
    d={}
    for k,v in xs:need(k not in d,'duplicate metadata key');d[k]=v
    return d
def bad(v):raise ValueError('noninteger/nonfinite metadata token')
def doc(p):return json.loads(raw(p).decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def linked(p):
    need(fact(pathlib.Path(p['path']))==p,'exact linked whole pin');return doc(p['path'])
S=R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json';SA=R/'ROOT_I13_SOURCE_SCOPE007_DIFFERENT_REVIEW_ADOPTION_001.json'
def fresh():
    s=doc(S);a=doc(SA)
    need(fact(S)['sha256']=='e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5' and fact(SA)['sha256']=='a517732dd0b4870e08381fb3ce31baa435385d6ae3e700dd2f014708df3a5969' and a['Source_scope']==fact(S),'Source007 exact adoption')
    now=datetime.datetime.now(datetime.timezone.utc)
    need(datetime.datetime.fromisoformat(s['interval_start'])<=now<datetime.datetime.fromisoformat(s['interval_end'])-datetime.timedelta(seconds=60),'fresh strict60 reserve')
    return now.isoformat(timespec='microseconds')
def save(name,value):
    p=D/name;b=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
    need(0<len(b)<=2097152 and not os.path.lexists(p),'unused bounded output');fresh()
    with p.open('xb')as f:need(f.write(b)==len(b),'whole write');f.flush();os.fsync(f.fileno())
    need(raw(p)==b,'whole readback');return fact(p,b)

