def sha(b):return hashlib.sha256(b).hexdigest()
def read(p,size=None,digest=None,JSON=True):
    raw=p.read_bytes();f=dict(path=str(p),bytes=len(raw),sha256=sha(raw))
    assert p.is_absolute()and p.is_file()and len(raw)<=2097152
    if size is not None:assert len(raw)==size and sha(raw)==digest
    if str(p)not in seen:subjects.append(f);seen[str(p)]=f
    return decode(raw)if JSON else raw
def readpin(f,JSON=True):return read(Path(f['path']),f['bytes'],f['sha256'],JSON)
def nodes(x):
