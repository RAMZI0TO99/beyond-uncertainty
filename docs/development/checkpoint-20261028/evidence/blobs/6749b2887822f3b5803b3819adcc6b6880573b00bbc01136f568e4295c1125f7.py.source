"""Create an inert Root metadata publisher successor; no target or publication."""
import ast,hashlib,json
from pathlib import Path
R=Path(__file__).parent
p=R.parent/'resume-20261025-002/prepare_I12_managed_candidate_004.py'
b=p.read_bytes();text=b.decode('utf8')
assert len(b)<2097152
assert "ROOT = Path(r'D:\\Aenv\\pro2\\WORK\\resume-20261025-002')" in text
assert "SUBJECTS = ROOT / 'receipt_caller_integration_015'" in text
assert "len(value['status_records']) == 149" in text
text=text.replace('I12','I13').replace('20261025-i12','20261025-i13')
text=text.replace('resume-20261025-002','resume-20261025-003').replace('receipt_caller_integration_015','m3_peer_contracts_016')
text=text.replace('ROOT_CURRENT_I13_RECEIPT_CALLER_SOURCE_SCOPE_001.json','ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json')
text=text.replace("len(value['status_records']) == 149","len(value['status_records']) == 409").replace('original149','original409').replace('original_status_identities=149','original_status_identities=409')
assert 'I12' not in text and '== 149' not in text
ast.parse(text)
out=R/'prepare_I13_managed_candidate_001.py'
with out.open('xb') as h:h.write(text.encode())
print(json.dumps(dict(authored=dict(path=str(out),bytes=out.stat().st_size,sha256=hashlib.sha256(out.read_bytes()).hexdigest()),own_metadata_predecessor=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),target_execution=False,publication_performed=False)))
