"""Root metadata-only exact admission input author."""
import hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 with p.open('rb') as h:b=h.read(2097153)
 assert 0<len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
m=pin(C/'I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_002.json');a=pin(C/'ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_001.json');s=pin(C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_002.py')
assert m['sha256']=='a608a79a76c74027f6769825dd99f0df763d35b43cbf6f0d1614bb44002c1587'
assert a['sha256']=='10f1540c4f92da98887104290bf1060e07b3db042c425087655b5dcebfeb0e03'
assert s['sha256']=='9770009a8c14e76f7960f1e899a5ebe155a797174b752ed98a349dab1bd08291'
p=C/'I13_ONCE_ADMISSION_INPUT_001.json';v=dict(manifest=m,Source_adoption=a,supervisor=s);b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:assert h.write(b)==len(b)
print(json.dumps(dict(admission_input=pin(p),scope_issued=False,suite_invoked=False)))
