"""Root adoption of genuinely reviewed finite Source-only scope004 candidate002."""
import datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file()and not p.is_symlink()and s.st_nlink==1 and s.st_size<=2097152
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes()and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def read(p):return json.loads(raw(p))
cp=R/'Source_scope004_different_review_001/INDEPENDENT_I13_SOURCE_SCOPE004_CANDIDATE002_SOURCE_CAPSULE_001.json'
assert pin(cp)['sha256']=='3a2dfb0028c3c44ca2785bcadf68e1ad2a21deb8db415283a0ee205cc4fba432'
cap=read(cp);fp=cap['full_proof'];assert pin(fp['path'])==fp and fp['sha256']=='ae77e307442d96bcde45e91de430b5d76e9018ea79c8e2177b78b8e20e760ab5'
full=read(fp['path']);checks=full['checks']
assert cap['reviewer']==full['reviewer']=='/root/i13_final_review' and cap['verdict']==full['verdict'] and cap['verdict'].startswith('PASS_')
assert cap['checks_failed']==full['checks_failed']==0 and len(checks)==len({x['name']for x in checks})==cap['checks_passed']==full['checks_passed']==90
assert all(x['passed']is True for x in checks)
for x in cap['subjects']:assert pin(x['path'])==x
sp=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004_002.json';s=read(sp);assert pin(sp)==cap['Source_scope']
assert pin(sp)['sha256']=='6c662ad8498106d08811121e3d848919a3c60cca15510556cc8033f9a13bb4ee'
now=dt.datetime.now(dt.timezone.utc);assert dt.datetime.fromisoformat(s['interval_start'])<=now
assert(dt.datetime.fromisoformat(s['interval_end'])-now).total_seconds()>60
old=read(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json');assert(dt.datetime.fromisoformat(old['interval_end'])-now).total_seconds()>60
assert s['new_operational_execution_lease_issued']is s['target_execution']is s['operational_authority']is s['scientific_authority']is False
assert s['maximum_local_agents_including_Root']==3 and s['maximum_shared_including_both_roots_and_overlap']==5 and s['publication_reserve_seconds']==60
out=R/'ROOT_I13_CURRENT_SOURCE_SCOPE004_CANDIDATE002_DIFFERENT_REVIEW_ADOPTION_001.json'
v=dict(schema_version=1,record_type='Root_current_Source004_candidate002_different_review_adoption',author='/root',created_utc=now.isoformat(),
 Source_scope=pin(sp),genuine_different_review_capsule=pin(cp),full_review=fp,checks_passed=90,checks_failed=0,
 interval_start=s['interval_start'],interval_end=s['interval_end'],prior_scopes_or_leases_extended=False,
 Root_decision='Adopt exact corrected finite Source-only window004 candidate002 and its explicit original caps/holds. The first candidate temporal wording refusal remains preserved. This admits exact metadata/protocol design, not implementation, positive fit, synthetic calls, original target work or an operational lease. New target Source still requires exact genuinely different protocol review and separate Root adoption. All execution gates remain held.',
 peer_release_report_is_report_only=True,peer_result_accepted=False,peer015_extended=False,new_peer_grant_issued=False,
 new_target_Source_automatically_authorized=False,new_synthetic_or_test_calls_automatically_authorized=False,
 actual_family_publication=False,actual6=False,Native8=False,Parser=False,runtime=False,science=False,
 target_execution=False,operational_authority=False,scientific_authority=False,whole_host_quiet_claimed=False,physical_handle_absence_claimed=False)
b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert raw(out)==b
print(json.dumps(dict(adoption=pin(out),Source_end=s['interval_end'],operational_lease_issued=False)))
