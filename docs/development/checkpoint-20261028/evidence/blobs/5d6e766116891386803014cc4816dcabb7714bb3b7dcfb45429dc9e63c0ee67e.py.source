for a,b,n in changes:
 assert s.count(a)==n,(a,s.count(a),n)
 s=s.replace(a,b)
out=R/'issue_PRO3_metadata_batchC_grant019_001.py';b=s.encode('utf-8');assert len(b)<=2097152 and not os.path.lexists(out);ast.parse(b,filename=str(out))
with out.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert out.read_bytes()==b;print(str(out),len(b),hashlib.sha256(b).hexdigest())
