"""Propose fresh finite Source-only preparation/coordination; old scopes unchanged."""
import base64,datetime as dt,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
def raw(p):
 p=Path(p);s=p.stat();assert p.is_file()and not p.is_symlink()and s.st_nlink==1 and s.st_size<=2097152
 for q in(p,*p.parents):assert not getattr(q.lstat(),'st_file_attributes',0)&1024
 b=p.read_bytes();z=p.stat();assert b==p.read_bytes()and len(b)==s.st_size==z.st_size and s.st_mtime_ns==z.st_mtime_ns
 return b
def pin(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
bp=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_004_002.json';old=raw(bp);before=pin(bp)
assert before['sha256']=='6c662ad8498106d08811121e3d848919a3c60cca15510556cc8033f9a13bb4ee'
v=json.loads(old);now=dt.datetime.now(dt.timezone.utc)
assert(dt.datetime.fromisoformat(v['interval_end'])-now).total_seconds()>60
preserve=pin(R/'ROOT_I13_CURRENT_WORKSPACE_AND_OLD_SOURCE_PRESERVATION_005.json')
assert preserve['sha256']=='350a64b6dcec9652b6642a3a9a534d8798d6a2e504058e1bb4e07574136973d5'
v.update(schema_version=5,created_utc=now.isoformat(),interval_start=now.isoformat(),interval_end=(now+dt.timedelta(hours=2)).isoformat(),
 predecessor_Source_scope=before,Source_scope004_complete_bytes_preserved=True,Source_scope004_review_and_Root_adoption_completed=True,
 Source_scope004_requires_different_review_and_Root_adoption_before_use=False,Source_scope005_requires_different_review_and_Root_adoption_before_use=True,
 predecessor_Source_scope004_adoption=pin(R/'ROOT_I13_CURRENT_SOURCE_SCOPE004_CANDIDATE002_DIFFERENT_REVIEW_ADOPTION_001.json'),
 current_workspace_preservation_and_fresh_remote=preserve,current_Pro2_diagnostic_handoff=pin(R/'ROOT_I13_FIXED6_NODE_LEDGER_AND_NEXT_CONTRACT_DECISION_HANDOFF_002.json'),
 current_peer_scheduling_release=pin(R/'coordination/PRO2_PRO3_COMPUTE_RELEASE_20261025_016.json'),
 current_peer016_reported_consumed_closed=pin(R/'coordination/ROOT_RETAINED_PRO3_016_TIMEOUT_AND_FULL_CUSTODY_RELEASE_REPORT_001.json'),
 current_peer_batch_A_request_ungranted=pin(Path('D:/Aenv/pro3/runs/coordination/cho51_canonical_boundary_20261025_v5_a/compute-request_001.json')),
 prior_scopes_or_leases_extended=False,peer_grants_not_extended=True,new_peer_compute_or_aggregate_allocation_automatically_authorized=False,
 current_compact_ABI_protocol_ready=False,current_main936_completed=32,current_main936_passed=20,current_main936_failed=12,
 current_main936_remaining_unestablished=904,full936_qualification=False)
v['scope']+=' Fresh finite Source-only window005 continues the same metadata/protocol preparation and routine shared-resource coordination already authorized by the owner. It may review exact complementary metadata-only peer batch requests and separately scoped stdlib aggregation, but grants no batch, aggregate call, numerical work or operational authority automatically. Each allocation needs exact genuine Source/inventory/selection/preceding-full-release review, fresh resources/pauses, a separate Root decision and its own unchanged finite window. Root original I2/M3 execution gates, Source/output/node/record caps and three-local/five-shared limits remain unchanged. Existing indexed-ABI assessment remains NOT_READY with eleven unresolved cells; no Source fit, legacy compatibility, implementation protocol or target authoring permission follows. Older dated provenance fields are carried history, not new resource grants.'
out=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_005.json';inv=R/'ROOT_I13_SOURCE_SCOPE005_COMPLETE004_PREDECESSOR_INVERSE_001.json'
def write(p,value):
 b=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152 and not os.path.lexists(p)
 assert(dt.datetime.fromisoformat(json.loads(old)['interval_end'])-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
 with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
 assert raw(p)==b
write(out,v);write(inv,dict(author='/root',Source_only=True,complete_predecessor=before,complete_predecessor_base64=base64.b64encode(old).decode(),proposed_successor=pin(out),prior_scopes_or_leases_extended=False,new_operational_lease_issued=False))
print(json.dumps(dict(proposed_Source_scope=pin(out),complete_predecessor_inverse=pin(inv),interval_end=v['interval_end'],new_operational_lease_issued=False)))
