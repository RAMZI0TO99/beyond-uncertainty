CHECKS=[];READS={}
def check(name,ok,evidence):
    CHECKS.append(dict(name=name,passed=ok is True,evidence=evidence))
def read(path):
    with Path(path).open('rb')as stream:raw=stream.read(2097153)
    assert 0<len(raw)<=2097152
    p=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest());READS[str(path)]=p
    return raw
def pin(path):
    raw=read(path);return READS[str(path)]
def pairs(rows):
    v={}
    for k,x in rows:
        if k in v:raise ValueError('duplicate JSON key')
        v[k]=x
    return v
def bad(value):raise ValueError('not integer JSON')
def load(path):return json.loads(read(path).decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def verify(p,name):
    check(name,p==pin(Path(p['path'])),p)
def literal(tree,name):
    n=next(n for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id==name for t in n.targets))
    x=n.value
    if isinstance(x,ast.Call)and isinstance(x.func,ast.Name)and x.func.id in ('set','frozenset'):x=x.args[0]
    return ast.literal_eval(x)
