"""Author fresh once003 controls as Source only; never admit or launch."""
import ast,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';pending=[];rows=[]
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def successor(before_name,after_name,changes):
 before=R/before_name;text=before.read_bytes().decode('utf8')
 for old,new,n in changes:
  assert text.count(old)==n,(before_name,old,text.count(old),n);text=text.replace(old,new)
 ast.parse(text,filename=str(R/after_name));pending.append((R/after_name,text.encode('utf8')));rows.append(dict(before=pin(before),after_path=str(R/after_name)))
