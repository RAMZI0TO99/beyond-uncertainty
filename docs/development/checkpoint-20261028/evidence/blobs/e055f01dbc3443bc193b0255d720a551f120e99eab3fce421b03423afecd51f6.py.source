 ('ROOT_I13_FINAL_NEW_SOURCE_SET_FOCUSED_FULL_PROOF_002.json','ROOT_I13_FINAL_NEW_SOURCE_SET_FOCUSED_FULL_PROOF_003.json',1),
 ('ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_002.json','ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_003.json',1)])
successor('prepare_I13_final_Source_manifest_005.py','prepare_I13_final_Source_manifest_006.py',[
 ('I13_FINAL_SOURCE_SELECTION_INPUT_003.json','I13_FINAL_SOURCE_SELECTION_INPUT_004.json',2),
 ('I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_003.json','I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_004.json',1)])
assert all(not p.exists() for p,b in pending) and not (C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_003.json').exists() and not (C/'owned_memory_runs/attempt003').exists()
for p,b in pending:
 with p.open('xb') as h:assert h.write(b)==len(b)
for row in rows:row['after']=pin(Path(row.pop('after_path')))
v=dict(schema_version=1,record_type='Root_I13_once003_metadata_controls_Source_author_receipt',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),subjects=rows,changes='Fresh003 identities, adopted consumed once002 refusal, any genuinely changed module/API/fixture/catalogue input set, explicit lastPro3grant011 and its future retained full-release report. Budget/resource/review/Source reserve guards unchanged.',new_helpers_invoked=False,scope003_issued=False,claim_created=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
p=R/'ROOT_I13_ONCE003_METADATA_CONTROLS_SOURCE_AUTHOR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
