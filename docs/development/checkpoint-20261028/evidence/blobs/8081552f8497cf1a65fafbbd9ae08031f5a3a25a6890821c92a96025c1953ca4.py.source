"""Prepare immutable successor Root metadata issuer; never invoke it here."""
import ast,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent
oldpath=R/'issue_PRO3_metadata_aggregate_grant020_001.py';old=oldpath.read_bytes()
assert len(old)==19172 and hashlib.sha256(old).hexdigest()=='8d9554287b47a692f6e99f29c55022692119e41ef59781bcb14d999711989f5c'
s=old.decode()
for a,b in (
 ('compute-request_001.json','compute-request_002.json'),
