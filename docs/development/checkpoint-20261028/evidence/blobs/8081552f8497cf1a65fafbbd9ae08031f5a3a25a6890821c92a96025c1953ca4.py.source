 ('41e3bb54cccd22f792d261b4f94c7bdcd1250c132f9572c452deeaa98d1faae7','16d2d5f86c16b42de9a07b4933f8a46c7967ed0a5a048bb39440f97e458d0124'),
 ('SOURCE_SCOPE_005.json','SOURCE_SCOPE_006.json'),
 ('df9d87bcd45f130a8139743fa2eccbc9f4355b46123679a83e2d0ba6c7c850c4','9196eaca8c1988c357abfa72881b3e505317ce7faff50dc352b700407848d821'),
 ('SOURCE_SCOPE005_DIFFERENT_REVIEW_ADOPTION_001.json','SOURCE_SCOPE006_DIFFERENT_REVIEW_ADOPTION_001.json'),
 ('988e73fa8d7e0f84e18c8879bfbbc00d7613cf81ca031002165fb70260020076','e139f7ade01ea2c005f70eb7e4befff7be06e9fcdfc9e7706b45c2b8878cfea8'),
 ('Source005','Source006')):
 assert a in s,a;s=s.replace(a,b)
anchor="own,ownp=doc(R/'coordination/ROOT_I13_THREE_INPUT_SNAPSHOTS_EXPLICIT_OWN_CUSTODY_RELEASE_001.json'"
assert s.count(anchor)==1
extra='''need(inputs['current_source_scope_metadata']['scope']==scopep and inputs['current_source_scope_metadata']['adoption']==adoptp,'fresh input audit binds exact current Source006/adoption')
need(inputs['accepted_for_distinct_successor_request002_and_native_admission_preparation_only'] is True and inputs['successor_request_admission_interpreter_attempt_and_outputs_absent'] is True,'successor-only preparation audit')
need(request['caller_observed_full_dispatch_to_tool_reap_seconds_maximum']==300 and type(request['caller_observed_full_dispatch_to_tool_reap_seconds_maximum']) is int,'complete caller dispatch/reap/pipes bound')
for name,spec in inputs['predecessor'].items():same(spec)
need(request['unissued_predecessor_request_sha256']==inputs['predecessor']['request']['sha256']=='603b1a400557a608a0f74e296f35a85d60167b7a0339cd4e3ee24125d96c7aa1','old unallocated request exact preservation')
need(request['unadmitted_predecessor_supervisor_sha256']==inputs['predecessor']['supervisor']['sha256']=='41e3bb54cccd22f792d261b4f94c7bdcd1250c132f9572c452deeaa98d1faae7','old refused Source remains exact and unadmitted')
refusal,refusalp=doc(request['source_refusal_path'],request['source_refusal_sha256'])
need(refusalp==inputs['predecessor']['refusal'] and refusalp['sha256']=='1d5a2ae29d552fb6d04b3a34600cb75a9d324ae0e1135f3223739f0ba176dfa6' and refusal['grant020_issued'] is False,'exact Root Source refusal remains history')
need(request['independent_source_refusal_capsule_sha256']==inputs['predecessor']['capsule']['sha256']=='ee7ab088b26972f0631f8943b7211746a0a9943ac987041ccef1a04d22b67fd1','exact different original refusal capsule')
repair,repairp=doc(R/'pro3_aggregate_supervisor_v2_Source_review_001/INDEPENDENT_PRO3_AGGREGATE_SUPERVISOR_V2_SOURCE_CAPSULE_001.json','c7a71689a619737a15b141e1494f5c26f72ba308198b14b34edeac6890bc827a')
repairfull,repairfullp=doc(repair['full_proof']['path'],repair['full_proof']['sha256'])
need(repair['reviewer']==repairfull['reviewer']=='/root/i13_final_review' and repair['source_review_passed'] is True and repair['allocation_review_performed'] is False and repair['checks_failed']==repairfull['checks_failed']==0 and repair['checks_passed']==repairfull['checks_passed']==52 and repairfullp==repair['full_proof'],'exact independent52-check Source-only repair review')
need(len(repairfull['checks'])==52 and all(c['passed'] is True for c in repairfull['checks']) and all(item in repair['subjects'] for item in (source,supervisor,scopep,adoptp)),'complete repair checks and operative Source/authority subjects')
for item in repair['subjects']:same(item)
'''
s=s.replace(anchor,extra+anchor)
s=s.replace(' request=rp,proofs=pp,',' Root_independent_supervisor_repair_Source_review=repairp,Root_independent_supervisor_repair_Source_full_proof=repairfullp,preserved_Source_refusal=refusalp,request=rp,proofs=pp,')
assert s!=old.decode();out=R/'issue_PRO3_metadata_aggregate_grant020_002.py';new=s.encode();assert len(new)<=2097152 and not os.path.lexists(out)
ast.parse(new,filename=str(out))
with out.open('xb') as f:assert f.write(new)==len(new);f.flush();os.fsync(f.fileno())
assert out.read_bytes()==new and oldpath.read_bytes()==old
print(json.dumps(dict(prepared_unexecuted_issuer=dict(path=str(out),bytes=len(new),sha256=hashlib.sha256(new).hexdigest()),old_issuer_preserved=True,grant020_issued=False)))
