"""Author separate once002 metadata controls; never issues a scope or launches."""
import ast,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
buffers=[];records=[]
def successor(before_name,after_name,changes):
 before=R/before_name;text=before.read_bytes().decode('utf8')
 for old,new,count in changes:
  assert text.count(old)==count,(before_name,old,text.count(old),count)
  text=text.replace(old,new)
 ast.parse(text,filename=str(R/after_name));buffers.append((R/after_name,text.encode('utf8')));records.append(dict(before=pin(before),after_path=str(R/after_name)))
successor('prepare_I13_once_admission_003.py','prepare_I13_once_admission_004.py',[
 ('I13_ONCE_ADMISSION_INPUT_001.json','I13_ONCE_ADMISSION_INPUT_002.json',1),
 ("allpins=[*manifest['modules'].values()", "previous=exact(cfg['previous_refusal_adoption'])\nassert previous['author']=='/root' and previous['verdict']=='ACCEPT_EXACT_I13_ONCE001_SAVED_REFUSAL_AND_OWNED_CLEANUP_ONLY' and previous['claim_reuse_or_replay_authorized'] is False\nassert adopt['previous_saved_refusal']==cfg['previous_refusal_adoption']\nprior_scope=exact(previous['consumed_scope'])\nassert manifest['modules']!=prior_scope['modules'] and previous['consumed_scope']==pin(C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_001.json')\nallpins=[*manifest['modules'].values()",1),
 ('owned_memory_runs/attempt001','owned_memory_runs/attempt002',1),
 ('ROOT_I13_FRESH_ONCE_PRELAUNCH_METADATA_001.json','ROOT_I13_FRESH_ONCE_PRELAUNCH_METADATA_002.json',1),
 ("out=save(C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_001.json'", "out=save(C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_002.json'",1)])
successor('adopt_I13_final_new_Source_set_004.py','adopt_I13_final_new_Source_set_005.py',[
 ('I13_FINAL_SOURCE_ADOPTION_INPUT_001.json','I13_FINAL_SOURCE_ADOPTION_INPUT_002.json',1),
 ('prepare_I13_once_admission_003.py','prepare_I13_once_admission_004.py',1),
 ("allpins=[*manifest['modules'].values()", "prior_refusal=cfg['previous_saved_refusal'];prior=exact(prior_refusal)\nck(prior['author']=='/root' and prior['verdict']=='ACCEPT_EXACT_I13_ONCE001_SAVED_REFUSAL_AND_OWNED_CLEANUP_ONLY' and prior['claim_reuse_or_replay_authorized'] is False,'previous_scope_consumed_no_replay',prior_refusal)\nclarification=cfg['actor_context_clarification_adoption'];clar=exact(clarification)\nck(clar['author']=='/root' and clar['verdict']=='ACCEPT_EXACT_FIXED_I2_API_ACTOR_CONTEXT_SOURCE_ONLY' and all(clar[k] is False for k in ('target_execution','operational_authority','scientific_authority')),'exact_actor_context_Source_clarification',clarification)\nallpins=[*manifest['modules'].values()",1),
 ('ROOT_I13_FINAL_NEW_SOURCE_SET_FOCUSED_FULL_PROOF_001.json','ROOT_I13_FINAL_NEW_SOURCE_SET_FOCUSED_FULL_PROOF_002.json',1),
 ('ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_001.json','ROOT_I13_FINAL_NEW_SOURCE_SET_DIFFERENT_REVIEW_ADOPTION_002.json',1),
 ("protocol_adoption=protocol,manifest=cfg['manifest']", "protocol_adoption=protocol,previous_saved_refusal=prior_refusal,actor_context_clarification_adoption=clarification,manifest=cfg['manifest']",1)])
successor('prepare_I13_final_Source_manifest_004.py','prepare_I13_final_Source_manifest_005.py',[
 ('I13_FINAL_SOURCE_SELECTION_INPUT_002.json','I13_FINAL_SOURCE_SELECTION_INPUT_003.json',2),
 ('I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_002.json','I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_003.json',1)])
successor('prepare_I13_once_supervisor_003.py','prepare_I13_once_supervisor_004.py',[
 ('I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_002.json','I13_FINAL_ONCE_SOURCE_INPUT_MANIFEST_003.json',1),
 ('ROOT_I13_ONCE_MEMORY_SUPERVISOR_002.py','ROOT_I13_ONCE_MEMORY_SUPERVISOR_003.py',1)])
assert all(not p.exists() for p,b in buffers)
assert not (C/'ROOT_I13_ONCE_SYNTHETIC_MEMORY_SCOPE_002.json').exists() and not (C/'owned_memory_runs/attempt002').exists()
for p,b in buffers:
 with p.open('xb') as h:assert h.write(b)==len(b)
for row in records:row['after']=pin(Path(row.pop('after_path')))
v=dict(schema_version=1,record_type='Root_I13_once002_metadata_controls_Source_successor_author_receipt',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),subjects=records,changes='Fresh exclusive once002 identities; require adopted saved once001 refusal, changed module set and exact actor-context Source clarification. All other admission/review/resource/custody guards retained.',Source_scope=pin(R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_001.json'),successor_helpers_invoked=False,scope002_issued=False,claim_created=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
out=R/'ROOT_I13_ONCE002_METADATA_CONTROLS_SOURCE_AUTHOR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with out.open('xb') as h:h.write(b)
print(json.dumps(dict(receipt=pin(out),Sources=[x['after'] for x in records],target_execution=False)))
