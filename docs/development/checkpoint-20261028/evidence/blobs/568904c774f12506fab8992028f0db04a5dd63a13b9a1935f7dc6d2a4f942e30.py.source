def _diagnostic_one(*, literal, m3, publisher, peer, catalogue_bytes, seal):
    spec = copy.deepcopy(literal)
    name = spec['name']
    expected = spec['expected_error']
    assert not _ids(spec) & _ids(CASE_CATALOGUE)
    if spec['handler'] == 'held':
        module = publisher if spec['module'] == 'publisher' else m3
        old = module.ACTUAL_ENTRY_QUALIFIED
        try:
            module.ACTUAL_ENTRY_QUALIFIED = spec['flag']
            try:
                module.__dict__[spec['entry']](context=_Hostile())
            except module.I13MetadataError as error:
                assert error.code == expected
            else:
                raise AssertionError('held entry returned')
        finally:
            module.ACTUAL_ENTRY_QUALIFIED = old
    elif spec['handler'] == 'isolation':
        a = _fixture_make(spec, m3, publisher, peer, catalogue_bytes)
        b = _fixture_make(spec, m3, publisher, peer, catalogue_bytes)
        assert not _ids(a) & _ids(b) and (not _ids(a) & _ids(FIXED))
        before = _fp(b)
        a['records'][0]['pin'].pop('path')
        assert _fp(b) == before
    else:
        b = _fixture_make(spec, m3, publisher, peer, catalogue_bytes)
        assert not _ids(b) & _ids(FIXED)
        if spec['handler'] not in ('positive', 'constructor', 'port', 'kwargs'):
            before = _fp(b)
            _fixture_edit(b, spec)
            assert before != _fp(b), 'typed mutation did not change owned bundle'
        module = publisher if spec.get('route') in ('prewrite', 'canonical') else m3
        entry = 'validate_selected_role_prewrite_metadata' if spec.get('route') == 'prewrite' else 'validate_selected_role_canonical_dependency_metadata' if spec.get('route') == 'canonical' else 'validate_guard_profile_static_descriptor_metadata' if spec.get('guard') else 'validate_M3_complete_stage_output_metadata'
        kwargs = dict(packet=b['packet'], records=b['records'], catalogue_bytes=catalogue_bytes, expected_root_thread='11111111-1111-4111-8111-111111111111', source_editor='/root/project_architecture', now_utc=b['now_utc'])
        if module is publisher:
            kwargs.update(m3=m3, peer=peer)
        if spec['handler'] == 'kwargs':
            if spec['variant'] == 'catalogue':
                kwargs['catalogue_bytes'] = catalogue_bytes + b' '
            elif spec['variant'] == 'packet_bytearray':
                kwargs['packet'] = bytearray(kwargs['packet'])
            elif spec['variant'] == 'now_arabic':
                kwargs['now_utc'] = '2026-10-25T11:00:20.٠٠٠٠٠٠+00:00'
            elif spec['variant'] == 'root':
                kwargs['expected_root_thread'] = 'not-a-uuid'
            elif spec['variant'] == 'editor':
                kwargs['source_editor'] = '/ROOT/actor'
            else:
                raise AssertionError('unknown kwargs control')
        if spec['handler'] == 'port':
            clone = types.ModuleType(m3.__dict__['__name__'])
            clone.__dict__.update(m3.__dict__)
            attr = spec['attribute']
            if spec.get('remove'):
                clone.__dict__.pop(attr, None)
            else:
                clone.__dict__[attr] = copy.deepcopy(spec['value'])
            kwargs['m3'] = clone
        if spec['handler'] == 'constructor':
            kind = spec['kind']
            value = _Outer(b).value(spec['label'])
            if kind == 'artifact6':
                value = copy.deepcopy(value['artifacts'][0])
            if 'field' in spec:
                if spec.get('remove'):
                    value.pop(spec['field'])
                else:
                    value[spec['field']] = copy.deepcopy(spec['value'])
            kwargs = dict(kind=kind, value=value, catalogue_bytes=catalogue_bytes)
            module = m3
            entry = 'encode_I13_contract_record'
        try:
            result = module.__dict__[entry](**kwargs)
        except module.I13MetadataError as error:
            assert expected is not None and error.code == expected, (name, error.code, expected)
        else:
            assert expected is None, (name, 'refusal expected')
            view = _ow_json(result)
            if spec['handler'] == 'constructor':
                assert type(result) is bytes and view == value
                view = dict(metadata_only=True, structural_graph_validated=True, charged_metadata_nodes=0, **{k: False for k in ('target_execution', 'operational_authority', 'scientific_authority', 'actual_family_publication', 'full_original_I2_DAG_closed', 'current_canonical_authority_qualified', 'recursive_prior_publication_authority', 'authentic_loader_qualified')})
            assert view['metadata_only'] is True and view['structural_graph_validated'] is True and (view['charged_metadata_nodes'] <= 50000)
            assert all((view[k] is False for k in ('target_execution', 'operational_authority', 'scientific_authority', 'actual_family_publication', 'full_original_I2_DAG_closed', 'current_canonical_authority_qualified', 'recursive_prior_publication_authority', 'authentic_loader_qualified')))
    assert _fp((FIXED, CASE_CATALOGUE)) == seal, 'global fixed data/catalogue changed'

def run_diagnostic(*,m3,publisher,peer,catalogue_bytes):
    cases=[];failures=[];seal=_fp((FIXED,CASE_CATALOGUE))
    for literal in CASE_CATALOGUE:
        name=literal['name'];passed=False
        try:
            _diagnostic_one(literal=literal,m3=m3,publisher=publisher,peer=peer,catalogue_bytes=catalogue_bytes,seal=seal)
            passed=True
        except MemoryError:
            raise
        except Exception as error:
            actual=None
            for candidate in (error,error.__context__,error.__cause__):
                if candidate is not None and type(candidate)in(m3.I13MetadataError,publisher.I13MetadataError,peer.I13MetadataError):
                    code=candidate.__dict__.get('code')
                    if type(code)is str:actual=code[:128];break
            failures.append(dict(name=name,exception_type=type(error).__name__[:128],expected_code=literal['expected_error'],actual_code=actual,message=str(error)[:512]))
        finally:
            assert _fp((FIXED,CASE_CATALOGUE))==seal,'diagnostic global integrity failure; further cases aborted'
            assert all(module.__dict__.get('ACTUAL_ENTRY_QUALIFIED')is False for module in(m3,publisher,peer)),'diagnostic heldflag integrity failure; further cases aborted'
        cases.append(dict(name=name,passed=passed))
        print(json.dumps(dict(event='CASE_PASS'if passed else'CASE_FAIL',name=name),sort_keys=True),flush=True)
    passed=sum(row['passed']is True for row in cases)
    return dict(cases=cases,passed=passed,failed=len(cases)-passed,failures=failures,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)


# Fixed bounded subset export; existing strict/full diagnostic exports remain exact.
def run_diagnostic_cases(*, m3, publisher, peer, catalogue_bytes, case_names):
    if type(case_names) not in (tuple, list):
        raise ValueError('case_names must be an exact builtin tuple or list')
    if not 1 <= len(case_names) <= 32:
        raise ValueError('case_names requires one through32 cases')
    if any((type(name) is not str for name in case_names)):
        raise ValueError('case_names entries must be exact builtin str')
    requested = tuple(case_names)
    if len(set(requested)) != len(requested):
        raise ValueError('case_names must be unique')
    positions = {row['name']: index for index, row in enumerate(CASE_CATALOGUE)}
    if any((name not in positions for name in requested)):
        raise ValueError('case_names contains unknown catalogue name')
    if any((positions[left] >= positions[right] for left, right in zip(requested, requested[1:]))):
        raise ValueError('case_names must preserve original catalogue order')
    selected = tuple((CASE_CATALOGUE[positions[name]] for name in requested))
    cases = []
    failures = []
    seal = _fp((FIXED, CASE_CATALOGUE))
    for literal in selected:
        name = literal['name']
        passed = False
        try:
            _diagnostic_one(literal=literal, m3=m3, publisher=publisher, peer=peer, catalogue_bytes=catalogue_bytes, seal=seal)
            passed = True
        except MemoryError:
            raise
        except Exception as error:
            actual = None
            for candidate in (error, error.__context__, error.__cause__):
                if candidate is not None and type(candidate) in (m3.I13MetadataError, publisher.I13MetadataError, peer.I13MetadataError):
                    code = candidate.__dict__.get('code')
                    if type(code) is str:
                        actual = code[:128]
                        break
            failures.append(dict(name=name, exception_type=type(error).__name__[:128], expected_code=literal['expected_error'], actual_code=actual, message=str(error)[:512]))
        finally:
            assert _fp((FIXED, CASE_CATALOGUE)) == seal, 'diagnostic global integrity failure; further cases aborted'
            assert all((module.__dict__.get('ACTUAL_ENTRY_QUALIFIED') is False for module in (m3, publisher, peer))), 'diagnostic heldflag integrity failure; further cases aborted'
        cases.append(dict(name=name, passed=passed))
        if passed:
            event = dict(event='CASE_PASS', name=name)
        else:
            event = dict(event='CASE_FAIL', **failures[-1])
        print(json.dumps(event, sort_keys=True), flush=True)
    passed = sum((row['passed'] is True for row in cases))
    return dict(cases=cases, passed=passed, failed=len(cases) - passed, failures=failures, metadata_only=True, target_execution=False, operational_authority=False, scientific_authority=False, actual_family_publication=False)

