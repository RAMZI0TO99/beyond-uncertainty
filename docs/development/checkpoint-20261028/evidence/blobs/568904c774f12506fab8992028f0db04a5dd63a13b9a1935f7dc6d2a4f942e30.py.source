def _fixed(name):
    item=FIXED[name];z=zlib.decompressobj();raw=z.decompress(base64.b64decode(item['compressed_base64']),2097153)
    assert z.eof and not z.unused_data and not z.unconsumed_tail and len(raw)==item['pin']['bytes']<=2097152 and hashlib.sha256(raw).hexdigest()==item['pin']['sha256']
    return copy.deepcopy(item['pin']),raw

def _new_base(m3,catalogue_bytes):
    b=dict(records=[],labels={},mutable=[]);o=_Outer(b)
    for name in FIXED:
        p,raw=_fixed(name);o.add_raw(name,raw,p['path'])
    o.add_raw('common_catalogue',catalogue_bytes,m3.CATALOGUE_PIN['path'])
    o.add('owner',dict(schema_version=2,record_type='synthetic_owner',Root_thread='11111111-1111-4111-8111-111111111111',author='/root',target_execution=False,operational_authority=False))
    lease=o.add('lease',dict(record_type='synthetic_lease',author='/root',target_execution=False,operational_authority=False))
    old=_ow_json(_fixed('historical45')[1]);inv=_ow_json(_fixed('M3_inventory17')[1]);basis={x['role']:x['available_basis']for x in inv['roles']}
    rows=copy.deepcopy(old['rows'])
    for row in rows:
