def _fixture_make(spec,m3,publisher,peer,catalogue_bytes):
    if spec.get('guard'):
        b=_guard(spec['guard'],m3,catalogue_bytes)
    else:b=_M3Build(spec.get('stage','templates'),spec.get('role'),m3,catalogue_bytes).finish()
    if spec.get('route')in('prewrite','canonical'):
        role=spec.get('guard')or spec.get('selected_role','capture_template')
        kind='guard_profile_static_v2'if spec.get('guard')else'M3_stage_receipt22_v2'
        b=_Outer(b).envelope(kind,role,m3,publisher,peer)
        if spec['route']=='prewrite':b['packet']=next(r['body']for r in b['records']if r['pin']['path']==b['labels']['outer_prewrite']);b['now_utc']=_ow_time(24)
    return b


def _fp(value):
    if type(value)is dict:return('dict',tuple(sorted(((_fp(k),_fp(v))for k,v in value.items()),key=repr)))
    if type(value)is list:return('list',tuple(_fp(v)for v in value))
    if type(value)is tuple:return('tuple',tuple(_fp(v)for v in value))
    return(type(value).__name__,repr(value))


def _ids(value):
    out={id(value)}if type(value)in(dict,list,set)else set()
    if type(value)is dict:
        for k,v in value.items():out|=_ids(k)|_ids(v)
    elif type(value)in(list,tuple,set):
        for v in value:out|=_ids(v)
    return out


def _i13_omit_outer_input(b, label, birth_only=False):
    o=_Outer(b);target=o.p(label)
    if not birth_only:
        value=o.value('outer_purpose');value['inputs']=[x for x in value['inputs']if x['path']!=target['path']];o.rewrite('outer_purpose',value)
        for name in ('outer_purpose_full','outer_purpose_capsule','outer_purpose_adoption'):
            value=o.value(name);value['subjects']=[x for x in value['subjects']if x['path']!=target['path']]
            if 'subject_reviews'in value:value['subject_reviews']=[x for x in value['subject_reviews']if x['subject']['path']!=target['path']]
            o.rewrite(name,value)
        value=o.value('outer_publication');value['complete_input_postreads']=[x for x in value['complete_input_postreads']if x['path']!=target['path']];o.rewrite('outer_publication',value)
    value=o.value('outer_prewrite')
    if not birth_only:value['expected_inputs']=[x for x in value['expected_inputs']if x['path']!=target['path']]
    value['recorded_births_ns'].pop(target['path']);o.rewrite('outer_prewrite',value)
    o.b['packet']=o.row('outer_packet')['body'];o.b['mutable']=sorted(o.mutable);b.clear();b.update(copy.deepcopy(o.b))


def _i13_body_actor(b, label, field, item=None):
    o=_Outer(b);actor='/root/i13_raw_body_only_author';value=o.value(label)
    if item is None:value[field]=actor
    else:value[field][item]=actor
    o.rewrite(label,value)
    for name in ('outer_publisher_code_full','outer_publisher_code_capsule'):
        value=o.value(name);value['reviewer']=actor;o.rewrite(name,value)
    o.b['packet']=o.row('outer_packet')['body'];o.b['mutable']=sorted(o.mutable);b.clear();b.update(copy.deepcopy(o.b))


def _fixture_edit(b,spec):
    if spec['handler']in('child_roster','child_birth'):
        _i13_omit_outer_input(b,spec['label'],spec['handler']=='child_birth');return
    if spec['handler']=='raw_body_actor':
        _i13_body_actor(b,spec['label'],spec['field'],spec.get('item'));return
    o=_Outer(b);label=spec.get('label','wrapper');value=o.value(label)
    if spec['handler']=='nested':
        parent=value
        for key in spec['keys'][:-1]:parent=parent[key]
        key=spec['keys'][-1]
        if spec.get('remove'):parent.pop(key)
        else:parent[key]=copy.deepcopy(spec['value'])
    elif spec['handler']=='wire':
        variant=spec['variant']
        raw=o.row(label)['body']
        if variant=='duplicate':raw=raw.replace(b'{',b'{"schema_version":2,',1)
        elif variant=='float':raw=raw.replace(b'"schema_version":2',b'"schema_version":2.0',1)
        elif variant=='nan':raw=raw.replace(b'"schema_version":2',b'"schema_version":NaN',1)
        elif variant=='bom':raw=b'\xef\xbb\xbf'+raw
        elif variant=='depth':raw=b'['*49+b'0'+b']'*49
        elif variant=='nodes':raw=b'['+b'0,'*50000+b'0]'
        else:raise AssertionError('unknown wire variant')
        o.rewrite(label,raw);b.update(o.b)
        target='outer_prewrite'if spec.get('route')=='prewrite'else'outer_packet'if spec.get('route')=='canonical'else'wrapper'
        b['packet']=o.row(target)['body'];return
    elif spec['handler']=='records':
        variant=spec['variant']
        if variant=='duplicate':b['records'].append(copy.deepcopy(b['records'][0]))
        elif variant=='count':b['records']=[copy.deepcopy(b['records'][0])for _ in range(257)]
        elif variant=='missing':b['records']=[r for r in b['records']if r['pin']['path']!=b['labels'][label]]
        elif variant=='pin_bool':b['records'][0]['pin']['bytes']=True
        else:raise AssertionError('unknown records variant')
        return
    elif spec['handler']=='pin_swap':value[spec['field']]=o.p(spec['other_label'])
    elif spec['handler']=='delete':value.pop(spec['field'])
    elif spec['handler']=='value':value[spec['field']]=copy.deepcopy(spec['value'])
    elif spec['handler']=='record_body':
        o.row(label)['body']+=b' ';b.update(o.b);return
    elif spec['handler']=='source_boundary':
        value['interval_end']=_ow_time(84,True)if spec['variant']=='exact60'else'2026-10-25T11:01:24.0000001+00:00'
    elif spec['handler']=='resource_age':
        value['resource']['observed_utc']=_ow_time(24-spec['age'])
    elif spec['handler']=='reviewer':
        actor=spec['actor'];value['reviewer']=actor
        full=value['full_proof'];full_label=next(k for k,p in b['labels'].items()if p==full['path']);fv=o.value(full_label);fv['reviewer']=actor;o.rewrite(full_label,fv);value=o.value(label);value['reviewer']=actor
    elif spec['handler']=='review_author':value['author']=value['reviewer']
    elif spec['handler']=='nested_author':value['Source_provenance']=dict(author=value['reviewer'])
    elif spec['handler']=='phase_capture':value['role']='capture_bound'
    else:raise AssertionError('unknown owned fixture mutation')
    o.rewrite(label,value);b.update(o.b)
    target='outer_prewrite'if spec.get('route')=='prewrite'else'outer_packet'if spec.get('route')=='canonical'else'wrapper'
    b['packet']=o.row(target)['body']


class _Hostile:
    def __getattribute__(self,name):raise AssertionError('held public entry inspected context')


def run(*,m3,publisher,peer,catalogue_bytes):
    cases=[];seal=_fp((FIXED,CASE_CATALOGUE))
    for literal in CASE_CATALOGUE:
        spec=copy.deepcopy(literal);name=spec['name'];expected=spec['expected_error']
        assert not(_ids(spec)&_ids(CASE_CATALOGUE))
        if spec['handler']=='held':
            module=publisher if spec['module']=='publisher'else m3;old=module.ACTUAL_ENTRY_QUALIFIED
            try:
                module.ACTUAL_ENTRY_QUALIFIED=spec['flag']
                try:module.__dict__[spec['entry']](context=_Hostile())
                except module.I13MetadataError as error:assert error.code==expected
                else:raise AssertionError('held entry returned')
            finally:module.ACTUAL_ENTRY_QUALIFIED=old
        elif spec['handler']=='isolation':
            a=_fixture_make(spec,m3,publisher,peer,catalogue_bytes);b=_fixture_make(spec,m3,publisher,peer,catalogue_bytes)
            assert not(_ids(a)&_ids(b))and not(_ids(a)&_ids(FIXED));before=_fp(b);a['records'][0]['pin'].pop('path');assert _fp(b)==before
        else:
            b=_fixture_make(spec,m3,publisher,peer,catalogue_bytes)
            assert not(_ids(b)&_ids(FIXED))
            if spec['handler']not in('positive','constructor','port','kwargs'):
                before=_fp(b);_fixture_edit(b,spec);assert before!=_fp(b),'typed mutation did not change owned bundle'
            module=publisher if spec.get('route')in('prewrite','canonical')else m3
            entry='validate_selected_role_prewrite_metadata'if spec.get('route')=='prewrite'else'validate_selected_role_canonical_dependency_metadata'if spec.get('route')=='canonical'else'validate_guard_profile_static_descriptor_metadata'if spec.get('guard')else'validate_M3_complete_stage_output_metadata'
            kwargs=dict(packet=b['packet'],records=b['records'],catalogue_bytes=catalogue_bytes,expected_root_thread='11111111-1111-4111-8111-111111111111',source_editor='/root/project_architecture',now_utc=b['now_utc'])
            if module is publisher:kwargs.update(m3=m3,peer=peer)
            if spec['handler']=='kwargs':
                if spec['variant']=='catalogue':kwargs['catalogue_bytes']=catalogue_bytes+b' '
                elif spec['variant']=='packet_bytearray':kwargs['packet']=bytearray(kwargs['packet'])
                elif spec['variant']=='now_arabic':kwargs['now_utc']='2026-10-25T11:00:20.\u0660\u0660\u0660\u0660\u0660\u0660+00:00'
                elif spec['variant']=='root':kwargs['expected_root_thread']='not-a-uuid'
                elif spec['variant']=='editor':kwargs['source_editor']='/ROOT/actor'
                else:raise AssertionError('unknown kwargs control')
            if spec['handler']=='port':
                clone=types.ModuleType(m3.__dict__['__name__']);clone.__dict__.update(m3.__dict__)
                attr=spec['attribute']
                if spec.get('remove'):clone.__dict__.pop(attr,None)
                else:clone.__dict__[attr]=copy.deepcopy(spec['value'])
                kwargs['m3']=clone
            if spec['handler']=='constructor':
                kind=spec['kind'];value=_Outer(b).value(spec['label'])
                if kind=='artifact6':value=copy.deepcopy(value['artifacts'][0])
                if 'field'in spec:
                    if spec.get('remove'):value.pop(spec['field'])
                    else:value[spec['field']]=copy.deepcopy(spec['value'])
                kwargs=dict(kind=kind,value=value,catalogue_bytes=catalogue_bytes);module=m3;entry='encode_I13_contract_record'
            try:result=module.__dict__[entry](**kwargs)
            except module.I13MetadataError as error:assert expected is not None and error.code==expected,(name,error.code,expected)
            else:
                assert expected is None,(name,'refusal expected');view=_ow_json(result)
                if spec['handler']=='constructor':
                    assert type(result)is bytes and view==value
                    view=dict(metadata_only=True,structural_graph_validated=True,charged_metadata_nodes=0,**{k:False for k in('target_execution','operational_authority','scientific_authority','actual_family_publication','full_original_I2_DAG_closed','current_canonical_authority_qualified','recursive_prior_publication_authority','authentic_loader_qualified')})
                assert view['metadata_only']is True and view['structural_graph_validated']is True and view['charged_metadata_nodes']<=50000
                assert all(view[k]is False for k in('target_execution','operational_authority','scientific_authority','actual_family_publication','full_original_I2_DAG_closed','current_canonical_authority_qualified','recursive_prior_publication_authority','authentic_loader_qualified'))
        assert _fp((FIXED,CASE_CATALOGUE))==seal,'global fixed data/catalogue changed'
        cases.append(dict(name=name,passed=True));print(json.dumps(dict(event='CASE_PASS',name=name),sort_keys=True),flush=True)
    return dict(cases=cases,passed=len(cases),failed=0,metadata_only=True,target_execution=False,operational_authority=False,scientific_authority=False,actual_family_publication=False)


