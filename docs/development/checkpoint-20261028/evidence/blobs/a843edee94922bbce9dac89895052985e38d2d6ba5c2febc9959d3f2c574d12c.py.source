"""Root Source-only fail-closed parent acceptance repair; no supervisor call."""
import ast,base64,datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
before=C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_004.py';raw=before.read_bytes();assert len(raw)==77118 and hashlib.sha256(raw).hexdigest()=='07224ba4237c93683a318fa75cc8ac13d35defd7bd76c658eb0be8adae354070'
s=raw.decode('utf8');old='accepted = reason is None and proc.returncode == 0 and drained and not overflow.is_set() and catalogue_valid and acceptance_elapsed_ns <= 60000000000';new=old.replace('and catalogue_valid and','and catalogue_valid and diagnostic_complete and');assert s.count(old)==1;s=s.replace(old,new)
after=C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_005.py';ast.parse(s);compile(s,str(after),'exec')
def funcs(b):return {n.name:ast.dump(n,include_attributes=False) for n in ast.parse(b).body if isinstance(n,ast.FunctionDef)}
f,g=funcs(raw),funcs(s);assert set(f)==set(g) and all(f[k]==g[k] for k in f if k!='parent')
with after.open('xb') as h:h.write(s.encode('utf8'))
authors=[]
for oldname,newname in [('prepare_I13_final_Source_adoption_input_005.py','prepare_I13_final_Source_adoption_input_006.py'),('prepare_I13_once_admission_input_003.py','prepare_I13_once_admission_input_004.py')]:
 p=R/oldname;text=p.read_bytes().decode('utf8');assert text.count('ROOT_I13_ONCE_MEMORY_SUPERVISOR_004.py')==1;text=text.replace('ROOT_I13_ONCE_MEMORY_SUPERVISOR_004.py','ROOT_I13_ONCE_MEMORY_SUPERVISOR_005.py');ast.parse(text);q=R/newname
 with q.open('xb') as h:h.write(text.encode('utf8'))
 authors.append(dict(before=pin(p),after=pin(q)))
v=dict(schema_version=1,record_type='Root_I13_supervisor005_fail_closed_diagnostic_acceptance_Source_repair',author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),before_Source=pin(before),after_Source=pin(after),complete_before_Source_base64=base64.b64encode(raw).decode(),only_parent_acceptance_conjunct_added='diagnostic_complete',every_original_acceptance_predicate_retained=True,every_other_function_AST_unchanged=True,input_authors=authors,supervisors004_005_uninvoked=True,scope003_or_claim_issued=False,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
p=C/'ROOT_I13_SUPERVISOR005_FAIL_CLOSED_DIAGNOSTIC_SOURCE_REPAIR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:h.write(b)
print(json.dumps(dict(supervisor=pin(after),receipt=pin(p),input_authors=[x['after'] for x in authors],target_execution=False)))
