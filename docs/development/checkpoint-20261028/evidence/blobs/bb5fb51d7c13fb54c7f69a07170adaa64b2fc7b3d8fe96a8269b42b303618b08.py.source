"""Adopt exact independently reviewed metadata packaging Source and its separate selection."""
import datetime as dt,hashlib,json
from pathlib import Path
R=Path(__file__).parent
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
cp=R/'packaging_selection003_supplemental_archive007_Source_review_001/INDEPENDENT_I13_SELECTION003_SUPPLEMENTAL_ARCHIVE007_SOURCE_CAPSULE_002.json'
assert pin(cp)['sha256']=='beedece336d3e2261a7f35f7bf6aeb88f51a8aa9f97844d350958fa2e32a5123'
c=load(cp);fp=Path(c['full_proof']['path']);assert pin(fp)==c['full_proof'];f=load(fp)
for v in(c,f):
 assert v['reviewer']=='/root/i13_final_review'and v['verdict'].startswith('PASS_')and v['checks_failed']==0
 assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
assert c['checks_passed']==f['checks_passed']==len(f['checks'])==len({x['name']for x in f['checks']})==107 and all(x['passed']is True for x in f['checks'])
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';sc=load(scope);now=dt.datetime.now(dt.timezone.utc)
assert(dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
plan=R/'I13_EXACT_SUPPLEMENTAL_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json'
helpers=[R/x for x in('prepare_I13_exact_owned_run_bundle_selection_003.py','prepare_I13_supplemental_metadata_helper_source_bundles_001.py','prepare_I13_managed_candidate_007.py')]
for p in[plan,*helpers]:
 for v in(c,f):assert pin(p)in v['subjects']
pv=load(plan);assert pv['member_count']==61 and pv['member_bytes']==546038
for p in pv['members']:assert pin(p['path'])==p
base=dict(schema_version=1,author='/root',created_utc=now.isoformat(),Source_scope=pin(scope),different_Source_review=pin(cp),full_proof=pin(fp),checks_passed=107,checks_failed=0,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,actual_bundle_reconstruction_candidate_creation_each_require_separate_different_review_and_Root_adoption=True)
items=[('ROOT_I13_SUPPLEMENTAL61_EXACT_SOURCE_SELECTION_DIFFERENT_REVIEW_ADOPTION_001.json',dict(base,record_type='Root_I13_supplemental61_exact_whole_metadata_helper_Source_selection_different_review_adoption',verdict='ACCEPT_EXACT_I13_SUPPLEMENTAL61_SOURCE_SELECTION_ONLY',subjects=[pin(plan)],member_count=61,member_bytes=546038,actual_bundles_created=False)),('ROOT_I13_SELECTION003_SUPPLEMENTAL_CREATOR001_ARCHIVE007_SOURCE_DIFFERENT_REVIEW_ADOPTION_001.json',dict(base,record_type='Root_I13_selection003_supplemental_creator001_archive007_different_Source_review_adoption',verdict='ACCEPT_EXACT_I13_SELECTION003_SUPPLEMENTAL_CREATOR001_ARCHIVE007_SOURCE_ONLY',subjects=[pin(p)for p in helpers],actual_helpers_invoked=False,actual_managed_files_created=False))]
out=[]
for name,value in items:
 p=R/name
 with p.open('xb')as h:h.write((json.dumps(value,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii'))
 out.append(pin(p))
print(json.dumps(dict(adoptions=out,target_calls=0)))
