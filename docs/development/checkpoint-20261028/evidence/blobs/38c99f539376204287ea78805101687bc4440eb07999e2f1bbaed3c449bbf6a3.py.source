"""Prepare own additive read-only review checker; no target execution."""
import ast
from pathlib import Path

root = Path(r'D:\Aenv\pro2\WORK\resume-20261025-003')
old = root / 'review_I13_common006_context_correction_001.py'
new = root / 'review_I13_common007_context_correction_001.py'
s = old.read_text()
s = s.replace('common_protocol_review_003', 'common_protocol_review_004')
s = s.replace('common006', 'common007').replace('COMMON006', 'COMMON007')
s = s.replace('CATALOGUE_006.json', 'CATALOGUE_007.json').replace('PROTOCOL_006.json', 'PROTOCOL_007.json')
s = s.replace('CONTEXT_CORRECTION_001.json', 'CONTEXT_CORRECTION_002.json')
for before, after in (
    ('219030', '219028'), ('47693', '47768'), ('6844', '7478'),
    ('1e3e71618c0e6f8a560c6475c19970113f8d81273b8aaad0ae98f22006226614', 'd565de0ef802629303403570437e951247c0bc6b16d2a9c8276d56aa2aa3b9ea'),
    ('14f5d7062647ae70fcf525bf48fd846fcf08d277437bc4292aa694998fb5b082', 'af11217ab593da410452cac6761679674340a32f75d0c7ea09a71dc68d25b493'),
    ('f1cbe9e4dd99763b9db2ea6188d7c5ee7a4394450e249ae342293d5d8c7ead5e', '6097199e1927511aee1014f045fdfcee5d9beb25512b7d21e73d791d2a5cd9f3'),
):
    assert before in s
    s = s.replace(before, after)
s = s.replace("c['predecessor_unadopted_catalogue'] == pin(bcpath)", "c['predecessor_unadopted_catalogue'] == pin(A / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_006.json')")
s = s.replace("p['predecessor_unadopted_proposal'] == pin(bppath)", "p['predecessor_unadopted_proposal'] == pin(A / 'I13_PROPOSED_M3_GUARD_AND_SHARED_SELECTED_ROLE_PUBLISHER_PROTOCOL_006.json')")
start = s.index("check('new006_preserves_original_strict_Source60_boundary'")
end = s.index('\n\nfailed = ', start)
s = s[:start] + """check('new007_preserves_original_strict_Source60_boundary', 'interval_end-evaluation>60seconds' in x['canonical_prior_rules'][1] and 'reserve>60' in p['shared_publication_join_rules'][4] and 'exactly60 seconds refuses' in x['required_controls'][3] and '60seconds+100ns passes with Source UTC7 and evaluation UTC6' in x['required_controls'][3], dict(resolved_finding='F01', actual_original=guard_raw, proposed_rule=x['canonical_prior_rules'][1], proposed_control=x['required_controls'][3]))
check('strict_reserve_annotation_no_relaxation', 'not >=60' in x['strict_reserve_correction'] and 'resource maximum age remains <=60' in x['strict_reserve_correction'], x['strict_reserve_correction'])
check('007_keeps_exact006_schemas', c['schemas'] == json.loads((A / 'I13_PROPOSED_M3_AND_SELECTED_ROLE_PUBLISHER_CLOSED_SCHEMA_CATALOGUE_006.json').read_bytes())['schemas'], 'All schema15/32 and every other field/type/literal are exact006; only source-reserve policy correction.')
check('correction002_complete001_history_pin', x['predecessor_unadopted_correction'] == pin(A / 'I13_PROPOSED_RECORDED_PREWRITE_EVALUATION_AND_PUBLICATION_CONTEXT_CORRECTION_001.json'), x['predecessor_unadopted_correction'])
check('boundary_reference_arithmetic_Source_and_resource_differ', not(600000000>600000000) and 600000001>600000000 and 600000000<=600000000 and not(600000001<=600000000), 'Own integer100ns reference arithmetic only; no target predicate invoked. Source60 refuses/+100ns permits; resource age60 permits/+100ns refuses.')
""" + s[end:]
s = s.replace("assert len(failed) == 1 and failed[0]['name'] == 'new006_preserves_original_strict_Source60_boundary'", "assert not failed, failed")
s = s.replace("verdict = 'REFUSE_I13_COMMON007_RECORDED_CONTEXT_SOURCE_RESERVE_BOUNDARY'", "verdict = 'PASS_I13_COMMON007_RECORDED_CONTEXT_DIFFERENT_SOURCE_REVIEW_ONLY'")
s = s.replace('checks_passed=len(checks)-1, checks_failed=1, findings=[failed[0]]', 'checks_passed=len(checks), checks_failed=0, findings=[]')
s = s.replace('checks_passed=len(checks)-1, checks_failed=1, findings=[dict(', 'checks_passed=len(checks), checks_failed=0, findings=[dict(')
bad = "findings=[dict(id='F01', location='correction001 canonical_prior_rules[1]/required_controls[3], copied catalogue006/protocol006 policies', issue='Source reserve>=60 and exact60 positive relax original strict>60.', original_Source=pin(i8), original_lines=[275,276], requested='Immutable007 strict>60 and boundary controls; keep resource age<=60 separate.')]"
assert bad in s
s = s.replace(bad, 'findings=[]')
s = s.replace('target_execution=False, operational_authority=False, scientific_authority=False, native_Parser_executed=False', 'target_execution=False, tests_executed=False, operational_authority=False, scientific_authority=False, native_Parser_executed=False')
s = s.replace('checks_passed=len(checks)-1, checks_failed=1)', 'checks_passed=len(checks), checks_failed=0)')
assert 'assert not failed, failed' in s and 'PASS_I13_COMMON007' in s and 'tests_executed=False' in s
assert 'checks_passed=len(checks)-1' not in s and 'checks_failed=1' not in s
ast.parse(s)
assert not new.exists()
with new.open('x', encoding='utf-8', newline='\n') as f:
    f.write(s)
print(str(new))
