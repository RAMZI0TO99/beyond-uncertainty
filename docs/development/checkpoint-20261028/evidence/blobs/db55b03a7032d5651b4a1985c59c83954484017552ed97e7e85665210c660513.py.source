import decimal
import hashlib
import json
import os
import stat
from pathlib import Path

ROOT = Path(r'D:\Aenv\pro2\WORK\resume-20261028-001')
OLD = Path(r'D:\Aenv\pro2\WORK\resume-20261027-004')
OLDER = Path(r'D:\Aenv\pro2\WORK\resume-20261027-002')
PEER = Path(r'D:\Aenv\pro3\runs\coordination\cho51_p3_contracts_20261027_v1')
OUT = ROOT / 'failure_disposition_creation_review_001'
CAP, DEPTH, NODES = 2097152, 48, 50000
CHECKS = []
CACHE = {}
TREES = {}

def require(value, name, evidence=None):
    if type(name) is not str or not name or any(c['name'] == name for c in CHECKS):
        raise ValueError('nonempty unique check name required')
    CHECKS.append({'name': name, 'passed': bool(value), 'evidence': evidence})
    if not value:
        raise ValueError(name)

def fp(s):
    return (s.st_dev, s.st_ino, s.st_mode, s.st_nlink, s.st_size,
            s.st_mtime_ns, s.st_ctime_ns, getattr(s, 'st_file_attributes', 0))

def lineage(p):
    for part in (p, *p.parents):
        st = part.lstat()
        if stat.S_ISLNK(st.st_mode) or getattr(st, 'st_file_attributes', 0) & 1024:
            raise ValueError('direct nonreparse lineage required')

def raw(p):
    p = Path(p)
    if not p.is_absolute() or not any(p.is_relative_to(r) for r in (ROOT, OLD, OLDER, PEER)):
        raise ValueError('fixed saved metadata roots only')
    lineage(p)
    before = p.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or not 0 <= before.st_size <= CAP:
        raise ValueError('bounded ordinary singlelink saved file only')
    with p.open('rb') as handle:
        opened = os.fstat(handle.fileno())
        data = handle.read(CAP + 1)
        afterfd = os.fstat(handle.fileno())
    after = p.lstat()
    lineage(p)
    if not fp(before) == fp(opened) == fp(afterfd) == fp(after) or len(data) != before.st_size:
        raise ValueError('stable same-buffer metadata read required')
    CACHE[str(p)] = data
    return data

def f3(p, data=None):
    p = Path(p)
    if data is None:
        data = raw(p)
    return {'path': str(p), 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}

def fact(p, size, digest):
    return {'path': str(p), 'bytes': size, 'sha256': digest}

def pairs(items):
    value = {}
    for k, v in items:
        if k in value:
            raise ValueError('duplicate JSON key')
        value[k] = v
    return value

def constant(token):
    raise ValueError('nonfinite JSON forbidden: ' + token)

def shape(value, label, own=True):
    pending, count, maximum = [(value, 0)], 0, 0
    while pending:
        item, depth = pending.pop()
        count += 1
        maximum = max(maximum, depth)
        if count > NODES or depth > DEPTH:
            raise ValueError('metadata shape cap')
        if type(item) is dict:
            if not all(type(k) is str for k in item):
                raise ValueError('string keys only')
            for k, v in item.items():
                pending.extend(((k, depth + 1), (v, depth + 1)))
        elif type(item) is list:
            pending.extend((v, depth + 1) for v in item)
        elif type(item) is str:
            if any(55296 <= ord(c) <= 57343 for c in item):
                raise ValueError('surrogate prohibited')
        elif type(item) is decimal.Decimal and not own:
            if not item.is_finite():
                raise ValueError('finite exact original decimal required')
        elif item is not None and type(item) not in (int, bool):
            raise ValueError('float-free own metadata required')
    TREES[label] = {'nodes': count, 'depth': maximum}

def doc(p, expected=None, own=True):
    data = raw(p)
    pin = f3(p, data)
    if expected is not None and pin != expected:
        raise ValueError('exact F3 mismatch: ' + str(p))
    value = json.loads(data.decode('utf-8-sig'), object_pairs_hook=pairs,
                       parse_float=decimal.Decimal, parse_constant=constant)
    shape(value, str(p), own)
    return value, pin

