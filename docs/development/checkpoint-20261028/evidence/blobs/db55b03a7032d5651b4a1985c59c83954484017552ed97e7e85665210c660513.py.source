def save(name, value):
    shape(value, name, True)
    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False, allow_nan=False) + '\n').encode('utf-8')
    if len(data) > CAP:
        raise ValueError('own output byte cap')
    reserve()
    path = OUT / name
    lineage(path.parent)
    with path.open('xb') as handle:
        if handle.write(data) != len(data):
            raise ValueError('whole exclusive output required')
        handle.flush()
        os.fsync(handle.fileno())
    if raw(path) != data:
        raise ValueError('own output exact full readback required')
    return f3(path, data)

