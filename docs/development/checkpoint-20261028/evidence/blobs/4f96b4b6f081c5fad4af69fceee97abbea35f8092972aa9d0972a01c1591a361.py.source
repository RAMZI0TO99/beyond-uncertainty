"""Own inert JSON proposal authoring. This is not a target implementation."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).parent
ROOT = Path(r'D:\Aenv\pro2')
W2 = ROOT / r'WORK\resume-20261025-002\receipt_caller_integration_015'

def pin(path):
    raw = path.read_bytes()
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

def read(path):
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError('duplicate key')
            result[key] = value
        return result
    def reject(value):
        raise ValueError('noninteger token ' + value)
    return json.loads(path.read_bytes(), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)

def save(name, value):
    raw = (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    if len(raw) > 2097152:
        raise ValueError('metadata cap')
    with (HERE / name).open('xb') as handle:
        handle.write(raw)
    if (HERE / name).read_bytes() != raw:
        raise ValueError('readback')
    return pin(HERE / name)

def shape(fields, tag=None, version=None):
    result = {'builtin_type': 'dict', 'exact_keys': list(fields), 'fields': fields,
              'additional_fields_allowed': False}
    if tag is not None:
        fields['record_type'] = {'literal': tag}
    if version is not None:
        fields['schema_version'] = {'builtin_type': 'int', 'literal': version}
    return result

def literal(value):
    return {'literal': value, 'builtin_type': type(value).__name__}

