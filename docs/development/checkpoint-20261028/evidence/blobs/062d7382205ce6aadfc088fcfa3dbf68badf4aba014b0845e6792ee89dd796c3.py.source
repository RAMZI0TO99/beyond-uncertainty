"""Select exact additional metadata helper Source bytes only; no bundle or target call."""
import datetime as dt
import hashlib
import json
from pathlib import Path
R=Path(r'D:\Aenv\pro2\WORK\resume-20261025-003');C=R/'m3_peer_contracts_016';P=R/'publication_001'
def pin(p):
 b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
old=R/'I13_EXACT_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json';op=pin(old)
assert op['sha256']=='ee248717db124b607daff4884aae765ccdba995d7ed159fb31521c209abe0fa4'
oldset={x['path'].casefold()for x in json.loads(old.read_bytes())['members']}
paths=sorted((p for p in R.rglob('*.py')if p.is_file()and not p.is_relative_to(C)and not p.is_relative_to(P)and str(p).casefold()not in oldset),key=lambda p:str(p).casefold())
members=[pin(p)for p in paths];assert 1<=len(members)<=256 and len({p['path'].casefold()for p in members})==len(members)
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';sv=json.loads(scope.read_bytes());now=dt.datetime.now(dt.timezone.utc)
assert (dt.datetime.fromisoformat(sv['interval_end'])-now).total_seconds()>60
v=dict(schema_version=1,record_type='Root_I13_exact_supplemental_metadata_helper_Source_bundle_packaging_plan',author='/root',created_utc=now.isoformat(),Source_scope=pin(scope),original160_helper_selection=op,members=members,member_count=len(members),member_bytes=sum(x['bytes']for x in members),maximum_metadata_file_bytes=2097152,maximum_actual_copy_rows=512,maximum_actual_copy_payload_bytes=67108864,selection='Additional whole .py metadata author/review/packaging helpers outside the entire target/fixture/process Source directory and publication directory, disjoint from the original exact160. All historical failed helpers stay opaque. No target Source, fixture Source, test/process supervisor or metadata JSON is selected.',original_files_modified=False,actual_bundles_created=False,source_helpers_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,exact_selection_different_review_and_Root_adoption_required=True,helper_Source_actual_reconstruction_candidate_creation_require_separate_different_reviews_and_Root_adoptions=True)
p=R/'I13_EXACT_SUPPLEMENTAL_METADATA_HELPER_SOURCE_BUNDLE_PACKAGING_PLAN_001.json';raw=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii');assert len(raw)<=2097152
with p.open('xb')as f:f.write(raw)
print(json.dumps(dict(plan=pin(p),members=len(members),whole_original_bytes=v['member_bytes'],bundles_created=False)))
