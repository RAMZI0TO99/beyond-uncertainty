def _i13_producer(graph,support):
    _schema(support,'code_support5',graph.c)
    for key in('Source','API','different_review','Root_adoption'):_i13_path(support[key]['path'])
    graph.s.raw(support['Source'],65536)
    api=graph.s.record(support['API'])
    keys=('schema_version','record_type','author','actual_Source_editor','Source','protocol','peer_role_data','peer_base_catalogue','metadata_entry','actual_entry','declared_roles','target_execution','operational_authority','actual_producer_issued')
    _closed(api,keys,'E_CODE_API')
    _need(type(api['schema_version'])is int and api['schema_version']==2 and api['record_type']=='I13_selected_peer_held_emitter_and_metadata_kernel_API','E_CODE_API')
    _need(_actor(api['author'],True)==_actor(api['actual_Source_editor'],True)==_actor(support['editor'],True),'E_CODE_API')
    for key,want in(('Source',support['Source']),('protocol',I13_PROTOCOL_PIN),('peer_role_data',PEER_ROLE_DATA_PIN),('peer_base_catalogue',CATALOGUE_PIN)):
        _pin(api[key]);_need(_same(api[key],want),'E_CODE_API')
    _need(api['metadata_entry']=='validate_selected_peer_author_packet_metadata'and api['actual_entry']=='emit_selected_peer_current_owner'and api['declared_roles']==graph.roledata['peer_roles'],'E_CODE_API')
    for key in('target_execution','operational_authority','actual_producer_issued'):_need(api[key]is False,'E_CODE_API')
    graph.excluded.update((_actor(api['author'],True).casefold(),_actor(support['editor'],True).casefold()))
    graph.codes.append(('I13_peer_held_emitter',support,None))
    graph._proof_author_slots()



def _i13_new_code_proofs(graph,support):
    capsule=graph.s.record(support['different_review'])
    full_pin=_pin(capsule.get('full_proof'));full=graph.s.record(full_pin)
    adoption=graph.s.record(support['Root_adoption'])
    required=('checks_failed','checks_passed','created_utc','native_Parser_executed','operational_authority','record_type','reviewer','schema_version','subjects','target_execution','verdict')
    for value in(capsule,full):
        _need(all(key in value for key in required),'E_REVIEW')
        _need(type(value['schema_version'])is int and value['schema_version']>0 and type(value['record_type'])is str and bool(value['record_type']),'E_REVIEW')
        _need(value['native_Parser_executed']is False,'E_AUTHORITY')
        _i13_utc6(value['created_utc']);_pin_list(value['subjects'],True)
        _need(all(any(_same(p,subject)for p in value['subjects'])for subject in(support['Source'],support['API'])),'E_REVIEW_COVERAGE')
    checks=full.get('checks')
    _need(type(checks)is list and 0<len(checks)<=10000,'E_REVIEW')
    for check in checks:
        _closed(check,('name','passed','evidence'),'E_REVIEW')
        _need(type(check['name'])is str and 0<len(check['name'])<=512 and check['passed']is True,'E_REVIEW')
    required=('author','created_utc','different_review','full_proof','native_Parser_executed','operational_authority','record_type','schema_version','subjects','target_execution','verdict')
    _need(all(key in adoption for key in required),'E_ADOPTION')
    _need(type(adoption['schema_version'])is int and adoption['schema_version']>0 and type(adoption['record_type'])is str and bool(adoption['record_type']),'E_ADOPTION')
    _need(adoption['native_Parser_executed']is False,'E_AUTHORITY')
    _i13_utc6(adoption['created_utc']);_pin_list(adoption['subjects'],True)
    _need(_same(_pin(adoption['different_review']),support['different_review'])and _same(_pin(adoption['full_proof']),full_pin),'E_ADOPTION_COVERAGE')
    expected=(support['Source'],support['API'],support['different_review'],full_pin,graph.scope,graph.selection_pin)
    _need(all(any(_same(p,subject)for p in adoption['subjects'])for subject in expected),'E_ADOPTION_COVERAGE')


def _i13_wrapper_inputs(graph,wrapper):
    policy=graph.roledata;role=graph.role
    rosters=wrapper['role_inputs'];_closed(rosters,('canonical','carried'),'E_PEER_INPUT_ROSTER')
    result={};ordered=[];folded=set()
    expected={'canonical':[(r,graph.c['ROLE_SOURCE_CAPS'][r])for r in policy['canonical_input_roles'][role]],'carried':[(r['role'],r['source_cap'])for r in policy['carried_input_names_and_caps'][role]]}
    for kind in('canonical','carried'):
        values=rosters[kind];_need(type(values)is list and len(values)==len(expected[kind]),'E_PEER_INPUT_ROSTER')
        for row,(name,cap)in zip(values,expected[kind]):
            _closed(row,('role','subject','source_cap'),'E_PEER_INPUT_ROSTER')
            _need(type(row['role'])is str and row['role']==name and type(row['source_cap'])is int and row['source_cap']==cap and name not in result,'E_PEER_INPUT_ROSTER')
            subject=_pin(row['subject'],cap);_i13_path(subject['path'])
            _need(subject['path'].casefold()not in folded,'E_PEER_INPUT_ROSTER');folded.add(subject['path'].casefold())
            if kind=='canonical':_need(subject['path']==graph.rows[name]['canonical_path'],'E_PEER_INPUT_ROSTER')
            graph.s.raw(subject,cap);result[name]=subject;ordered.append(subject)
    _need(_same(ordered,graph.p['current_source_inputs']),'E_PEER_INPUT_ROSTER')
    return result



def _descriptor(catalogue,descriptor):
 if type(descriptor)is str and descriptor.startswith('$I13_DESCRIPTOR'):
  _need(descriptor.startswith('$I13_DESCRIPTOR:')and re.fullmatch(r'D[0-9]{4}',descriptor[16:])is not None,'E_CATALOGUE_PIN')
  name=descriptor[16:];definitions=catalogue['schema_descriptor_definitions']
  _need(name in definitions,'E_CATALOGUE_PIN');descriptor=definitions[name]
 return descriptor
def _descriptor_keys(catalogue,descriptor):
 descriptor=_descriptor(catalogue,descriptor)
 return descriptor['fields'].keys()if set(descriptor)=={'additional_fields_allowed','fields'}else descriptor['exact_keys']
def _check_descriptor_encoding(catalogue):
 header=catalogue.get('schema_descriptor_encoding');definitions=catalogue.get('schema_descriptor_definitions')
 _closed(header,('schema_version','reference_prefix','namespace','mode','descriptor_grammar'),'E_CATALOGUE_PIN')
 _need(type(header['schema_version'])is int and header['schema_version']==2 and header['reference_prefix']=='$I13_DESCRIPTOR:'and header['namespace']=='I13_CATALOGUE_DESCRIPTOR_DEFINITIONS_V2'and header['mode']=='COUNT_COMPLETE_ENCODED_GRAPH_ONCE_PER_LOCAL_CACHE_NO_EXPANSION'and header['descriptor_grammar']=='CLOSED2_FIELDS_OR_CLOSED1_ORDINALS_LOSSLESS_V1','E_CATALOGUE_PIN')
 _closed(definitions,tuple('D%04d'%i for i in range(1,31)),'E_CATALOGUE_PIN')
 for value in definitions.values():
  _need(type(value)is dict and('builtin_type'in value or set(value)=={'additional_fields_allowed','fields'}or set(value)=={'items_by_ordinal'}),'E_CATALOGUE_PIN')
 done=set()
 def walk(value,chain=()):
  if type(value)is str and value.startswith('$I13_DESCRIPTOR'):
   _need(value.startswith('$I13_DESCRIPTOR:')and re.fullmatch(r'D[0-9]{4}',value[16:])is not None and value[16:]in definitions and value[16:]not in chain,'E_CATALOGUE_PIN')
   name=value[16:]
   if name not in done:walk(definitions[name],chain+(name,));done.add(name)
  elif type(value)is dict:
   if'builtin_type'in value:_need(type(value['builtin_type'])is str and value['builtin_type']in('dict','list','str','int','bool','NoneType'),'E_CATALOGUE_PIN')
   _need(not any(k.startswith('$I13_DESCRIPTOR')for k in value),'E_CATALOGUE_PIN')
   if'fields'in value and'builtin_type'not in value:
    _closed(value,('additional_fields_allowed','fields'),'E_CATALOGUE_PIN');_need(value['additional_fields_allowed']is False and type(value['fields'])is dict,'E_CATALOGUE_PIN')
   if'items_by_ordinal'in value and'builtin_type'not in value:
    _closed(value,('items_by_ordinal',),'E_CATALOGUE_PIN');_need(type(value['items_by_ordinal'])is list,'E_CATALOGUE_PIN')
   for k,child in value.items():
    if k!='literal':walk(child,chain)
  elif type(value)is list:
   for child in value:walk(child,chain)
 try:walk(catalogue['schemas'])
 except(KeyError,TypeError,RecursionError):raise I13MetadataError('E_CATALOGUE_PIN')from None
 _need(done==set(definitions),'E_CATALOGUE_PIN')

def _i13_result(graph,wrapper,wrapper_pin,common):
    result={k:None for k in _descriptor_keys(common,common['schemas']['result54'])}
    result.update(schema_version=2,record_type='Root_owner_v2_I13_detached_metadata_graph_result',validator='selected_peer_author_packet',metadata_only=True,structural_graph_validated=True,author_kind='selected_peer_receipt27_v2',role=graph.role,packet=wrapper_pin,author_packet=wrapper_pin,author_receipt=graph.p['receipt'],draft=graph.p['draft'],predecessor=graph.p['predecessor'],current_owner_scope=graph.scope,canonical_lease=graph.lease,selection=graph.selection_pin,producer_Source=wrapper['producer_support']['Source'],producer_API=wrapper['producer_support']['API'],validated_stage_roles=[graph.role],validated_now_utc=graph.now_text,record_count=len(graph.s.pins),total_record_bytes=graph.s.total,charged_metadata_nodes=0,recorded_boundary='FORMAT_AND_RECORDED_GRAPH_ONLY_REQUIRES_DIFFERENT_REVIEW_AND_SEPARATE_ACTUAL_ADMISSION',recorded_source_api_mechanical_binding_only=True)
    for key,typ in common['schemas']['result54']['fields'].items():
        typ=_descriptor(common,typ)
        if type(typ)is dict and typ.get('builtin_type')=='bool'and typ.get('literal')is False:result[key]=False
    _closed(result,_descriptor_keys(common,common['schemas']['result54']))
    _tree(result,graph.counter)
    result['charged_metadata_nodes']=graph.counter[0]
    raw=_wire(result);_need(0<len(raw)<=CAP,'E_METADATA_CAP')
    return raw


def validate_selected_peer_author_packet_metadata(*,packet,records,catalogue_bytes,expected_root_thread,source_editor,now_utc):
    _need(type(packet)is bytes,'E_PACKET_BYTES')
    _i13_utc6(now_utc)
    _need(type(catalogue_bytes)is bytes and len(catalogue_bytes)==COMMON_CATALOGUE_PIN['bytes']and hashlib.sha256(catalogue_bytes).hexdigest()==COMMON_CATALOGUE_PIN['sha256'],'E_CATALOGUE_PIN')
    counter=[0];store=_Store(records,counter)
    _need(store.raw(COMMON_CATALOGUE_PIN)==catalogue_bytes,'E_CATALOGUE_PIN')
    common=store.record(COMMON_CATALOGUE_PIN)
    _check_descriptor_encoding(common)
    _need(_same(common['peer_base_catalogue'],CATALOGUE_PIN)and _same(common['peer_role_data'],PEER_ROLE_DATA_PIN)and _same(common['fixed_inventory_LF_annex'],LF_ANNEX_PIN),'E_CATALOGUE_PIN')
    base=store.record(CATALOGUE_PIN);roledata=store.record(PEER_ROLE_DATA_PIN)
    spent={p['path'].casefold()for p in base['spent_pin75']}
    _need(not any(path.casefold()in spent for path in store.pins),'E_SPENT_IDENTITY')
    matches=[store.pins[path]for path,body in store.bodies.items()if body==packet]
    _need(len(matches)==1,'E_PACKET_BYTES');wrapper_pin=matches[0];wrapper=store.record(wrapper_pin)
    _need(type(wrapper.get('record_type'))is str and type(wrapper.get('schema_version'))is int,'E_SCHEMA')
    _need(wrapper['record_type']=='Root_owner_v2_selected_peer_canonical_author_metadata_packet'and wrapper['schema_version']==2,'E_UNSUPPORTED_AUTHOR_PACKET_ABI')
    keys=('schema_version','record_type','Root_thread','role','owner_scope','lease','selection','peer_packet','producer_support','role_inputs','created_utc','target_execution','operational_authority','source_only')
    _closed(wrapper,keys)
    _need(type(wrapper['role'])is str and wrapper['role']in roledata['peer_roles'],'E_UNSUPPORTED_PEER_ROLE')
    _need(wrapper['source_only']is True and wrapper['target_execution']is False and wrapper['operational_authority']is False,'E_AUTHORITY')
    wrapper_time=_i13_utc6(wrapper['created_utc'])
    for key in('owner_scope','lease','selection','peer_packet'):_pin(wrapper[key]);_i13_path(wrapper[key]['path'])
    inner=store.record(wrapper['peer_packet'])
    graph=_Peer(packet=store.raw(wrapper['peer_packet']),records=records,catalogue_bytes=store.raw(CATALOGUE_PIN),expected_root_thread=expected_root_thread,source_editor=source_editor,now_utc=now_utc,peer=True,_shared=(base,counter,store,inner))
    graph.roledata=roledata
    _need(wrapper['Root_thread']==expected_root_thread and wrapper['role']==graph.role and _same(wrapper['owner_scope'],graph.scope)and _same(wrapper['lease'],graph.lease)and _same(wrapper['selection'],graph.selection_pin),'E_PEER_WRAPPER_JOIN')
    graph.excluded.add('/root/project_architecture')
    _i13_producer(graph,wrapper['producer_support'])
    _i13_new_code_proofs(graph,wrapper['producer_support'])
    inputs=_i13_wrapper_inputs(graph,wrapper)
    contract=roledata['original_output_contracts'][graph.role]
    _i13_original(graph,store.record(graph.p['predecessor']),contract,inputs,wrapper_time,False)
    _i13_original(graph,store.record(graph.p['draft']),contract,inputs,wrapper_time,True)
    for subject in(graph.p['predecessor'],graph.p['draft']):
        original=store.record(subject);graph.add_actors(original)
        if'reviewer'in original:graph.excluded.add(_actor(original['reviewer']).casefold())
    graph.validate()
    receipt=store.record(graph.p['receipt'])
    _need(_time(receipt['created_utc'])<=wrapper_time<=graph.now,'E_CHRONOLOGY')
    code_review,code_time=graph.support(wrapper['producer_support'],[wrapper['producer_support']['Source'],wrapper['producer_support']['API']],True)
    _need(code_time<=wrapper_time,'E_CHRONOLOGY')
    return _i13_result(graph,wrapper,wrapper_pin,common)


def emit_selected_peer_current_owner(*,context):
    if ACTUAL_ENTRY_QUALIFIED is not True:raise I13MetadataError('E_ACTUAL_ENTRY_UNWIRED')
    raise I13MetadataError('E_ACTUAL_ENTRY_UNWIRED')
