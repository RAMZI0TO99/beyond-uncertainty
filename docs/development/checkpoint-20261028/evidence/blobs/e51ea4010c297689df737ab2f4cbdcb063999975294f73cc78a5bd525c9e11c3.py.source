class I13MetadataError(ValueError):
    def __init__(self,code):
        self.code=code
        super().__init__(code)


def _need(ok,code):
    if not ok:
        raise I13MetadataError(code)


def _tree(value,counter,depth=0,lf_record=False,pointer=(),i11_record=False):
    _need(depth<=48,'E_DEPTH')
    counter[0]+=1
    _need(counter[0]<=50000,'E_NODES')
    if value is None or type(value)in(bool,int):return
    if type(value)is str:
        _need(not any(0xD800<=ord(c)<=0xDFFF for c in value),'E_VALUE')
        controls={ord(c)for c in value if ord(c)<32}
        if controls and not(i11_record and pointer and pointer[0]=='literal_case_catalogue'):
            _need(lf_record and pointer==LF_POINTER and controls=={10}and len(value.encode('utf8'))==367 and value.count('\n')==10 and hashlib.sha256(value.encode('utf8')).hexdigest()==LF_LEAF_SHA256,'E_VALUE')
        return
    if type(value)is list:
        for i,child in enumerate(value):_tree(child,counter,depth+1,lf_record,pointer+(i,),i11_record)
        return
    if type(value)is dict:
        for key,child in value.items():
            _need(type(key)is str,'E_VALUE')
            _tree(key,counter,depth+1,lf_record,pointer+('#key',key),i11_record)
            _tree(child,counter,depth+1,lf_record,pointer+(key,),i11_record)
        return
    raise I13MetadataError('E_VALUE')


def _wire(value):
    try:
        return(json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
    except(TypeError,ValueError,UnicodeError,RecursionError):
        raise I13MetadataError('E_JSON')from None


def _pairs(items):
    value={}
    for key,child in items:
        _need(key not in value,'E_DUPLICATE_JSON_KEY')
        value[key]=child
    return value


def _bad_number(value):
    raise I13MetadataError('E_JSON_NUMBER')


def _decode(raw,counter,byte_code='E_METADATA_CAP',lf_record=False,i11_record=False):
    _need(type(raw)is bytes and 0<len(raw)<=CAP,byte_code)
    try:
        value=json.loads(raw.decode('utf8'),object_pairs_hook=_pairs,parse_float=_bad_number,parse_constant=_bad_number)
    except I13MetadataError:
        raise
    except(ValueError,UnicodeError,RecursionError):
        raise I13MetadataError('E_JSON')from None
    _tree(value,counter,lf_record=lf_record,i11_record=i11_record)
    return value


def _same(a,b):
    return _wire(a)==_wire(b)


def _closed(value,keys,code='E_SCHEMA'):
    _need(type(value)is dict and all(type(key)is str for key in value)and set(value)==set(keys),code)
    return value


def _path(value):
    _need(type(value)is str and 3<len(value)<=32767 and re.fullmatch(r'[A-Z]:\\[^/]+',value)is not None,'E_PATH')
    _need(not any(ord(c)<32 or ord(c)==127 for c in value)and':'not in value[2:],'E_PATH')
    for part in value[3:].split('\\'):
        _need(bool(part)and part not in('.','..')and not part.endswith((' ','.'))and
              not any(c in part for c in'<>"|?*')and
              re.fullmatch(r'(CON|PRN|AUX|NUL|CLOCK\$|COM[1-9]|LPT[1-9])(?:\..*)?',part,re.I)is None,'E_PATH')
    return value


def _pin(value,cap=CAP):
    _closed(value,('path','bytes','sha256'),'E_PIN')
    _path(value['path'])
    _need(type(cap)is int and 0<cap<=CAP and type(value['bytes'])is int and 0<value['bytes']<=cap,'E_PIN_BYTES')
    _need(type(value['sha256'])is str and re.fullmatch('[0-9a-f]{64}',value['sha256'])is not None,'E_PIN_SHA256')
    return value


def _actor(value,child=False):
    _need(type(value)is str and len(value)<=512 and re.fullmatch(r'/root(?:/[A-Za-z0-9_-]+)*',value)is not None and
          (not child or value.casefold()!='/root'),'E_ACTOR')
    return value


def _time(value):
    _need(type(value)is str,'E_TIME')
    m=re.fullmatch(r'([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})\.([0-9]{6,7})\+00:00',value)
    _need(m is not None,'E_TIME')
    try:
        instant=datetime.datetime(*(int(m[i])for i in range(1,7)))
    except ValueError:
        raise I13MetadataError('E_TIME')from None
    seconds=(instant-datetime.datetime(1,1,1)).days*86400+instant.hour*3600+instant.minute*60+instant.second
    return seconds*10000000+int(m[7].ljust(7,'0'))


def _pin_list(value,nonempty=False):
    _need(type(value)is list and int(nonempty)<=len(value)<=512,'E_PIN_LIST')
    paths=[]
    for pin in value:
        _pin(pin);paths.append(pin['path'].casefold())
    _need(len(set(paths))==len(paths),'E_PIN_LIST')
    return value




def _typed(value,typ,catalogue,context):
    """Interpret only the finite adopted catalogue DSL; no eval or import."""
    _need(type(typ)is str and typ in KNOWN_TYPE_DESCRIPTORS,'E_UNSUPPORTED_FIELD_TYPE')
    if typ in catalogue['schemas']:
        return _schema(value,typ,catalogue)
    if typ=='literal_record_type':
        return
    if typ.startswith('literal:'):
        _need(type(value)is str and value==typ[8:],'E_SCHEMA_VALUE');return
    if typ=='false':
        _need(value is False,'E_AUTHORITY');return
    if typ=='true':
        _need(value is True,'E_SCHEMA_VALUE');return
    if typ=='null':
        _need(value is None,'E_SCHEMA_VALUE');return
    if typ=='int2'or typ=='builtin_int1':
        _need(type(value)is int and value==(2 if typ=='int2'else 1),'E_VERSION');return
    if typ=='utc':
        _time(value);return
    if typ=='native_path':
        _path(value);return
    if typ.startswith('ordinary_pin'):
        if value is None and('null'in typ or'None'in typ):
            return
        _pin(value);return
    if typ.startswith('actor'):
        _actor(value,typ.startswith('actor_child'));return
    if typ=='sha256':
        _need(type(value)is str and re.fullmatch('[0-9a-f]{64}',value)is not None,'E_PIN_SHA256');return
    if typ=='base64':
        _need(type(value)is str and value.isascii(),'E_INVERSE')
        try:
            raw=base64.b64decode(value,validate=True)
        except(ValueError,UnicodeError):
            raise I13MetadataError('E_INVERSE')from None
        _need(base64.b64encode(raw).decode('ascii')==value,'E_INVERSE');return
    if typ.startswith('opaque_json_object'):
        _need(type(value)is dict,'E_SCHEMA_VALUE');return
    if typ=='builtin_bytes':
        _need(type(value)is bytes,'E_VALUE');return
    if typ.startswith('positive_builtin_int'):
        _need(type(value)is int and 0<value<=CAP,'E_PIN_BYTES');return
    if typ=='builtin_int':
        _need(type(value)is int,'E_SCHEMA_VALUE');return
    if typ=='list_builtin_int'or typ=='list9_builtin_int':
        _need(type(value)is list and all(type(v)is int for v in value)and(typ!='list9_builtin_int'or len(value)==9),'E_OBSERVATION');return
    if typ.startswith('pin_list'):
        _pin_list(value,'nonempty'in typ);return
    if typ=='source_role'or typ.startswith('outside8_role')or typ.startswith('generic9_role')or typ.startswith('peer_role'):
        allowed=set(catalogue['ROLE_SOURCE_CAPS'])
        if typ.startswith('outside8_role'):allowed-=set(catalogue['finite8_roles'])
        if typ.startswith('generic9_role'):allowed=set(catalogue['generic9_roles'])
        if typ.startswith('peer_role'):allowed=set(catalogue['peer_format_roles'])
        if'excluding phase_peer'in typ:allowed.discard('phase_peer')
        _need(type(value)is str and value in allowed,'E_UNSUPPORTED_PRODUCER_ROUTE');return
    if typ.startswith('enum:'):
        _need(type(value)is str and value in typ[5:].split('|'),'E_SCHEMA_VALUE');return
    if typ=='publication_stage_support6 when stage=publish; opaque_json_object otherwise':
        if context['stage']=='publish':_schema(value,'publication_stage_support6',catalogue)
        else:_need(type(value)is dict,'E_SCHEMA_VALUE')
        return
    if typ.startswith('list(recorded_observation12'):
        _need(type(value)is list and len(value)<=512,'E_OBSERVATION')
        for observation in value:
            _need(type(observation)is dict,'E_OBSERVATION')
            _need('exact_spent_exception'not in observation or'fixed_spent_observation10'in typ,'E_OBSERVATION')
            name='fixed_spent_observation10'if'exact_spent_exception'in observation else'recorded_observation12'
            _schema(observation,name,catalogue)
        return
    if typ.startswith('phase_parser_support9_v2'):
        _schema(value,'phase_parser_support9_v2',catalogue);return
    if typ=='exact ordered constructor_implemented_record_kinds in catalogue002':
        _need(_same(value,catalogue['constructor_implemented_record_kinds']),'E_SCHEMA_VALUE');return
    if typ=='exact generic9 role list':
        _need(_same(value,catalogue['generic9_roles']),'E_SCHEMA_VALUE');return
    if typ=='exact peer_format_roles list':
        _need(_same(value,catalogue['peer_format_roles']),'E_SCHEMA_VALUE');return
    if typ=='canonical_UUID':
        _need(type(value)is str and re.fullmatch('[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',value)is not None,'E_ROOT_THREAD');return
    if typ=='list_actor_additive':
        _need(type(value)is list and len(value)<=512,'E_ACTOR')
        for actor in value:_actor(actor)
        _need(len({x.casefold()for x in value})==len(value),'E_ACTOR');return
    if typ in('builtin_int0','builtin_int75'):
        _need(type(value)is int and value==(0 if typ=='builtin_int0'else 75),'E_SCHEMA_VALUE');return
    if typ.startswith('nonnegative_builtin_int<='):
        _need(type(value)is int and 0<=value<=int(typ.split('<=')[1]),'E_SCHEMA_VALUE');return
    if typ=='builtin_bool equal role==phase_peer':
        _need(type(value)is bool and value==(context['role']=='phase_peer'),'E_SCHEMA_VALUE');return
    if typ=='exact ordered list from companion by result kind':
        expected=list(PEER_UNWIRED if context['record_type']=='I12_selected_peer_author_receipt_metadata_view'else SINGLE_UNWIRED)
        _need(_same(value,expected),'E_SCHEMA_VALUE');return
    raise I13MetadataError('E_UNSUPPORTED_FIELD_TYPE')


def _schema(value,name,catalogue):
    spec=catalogue['schemas'][name]
    _closed(value,spec['fields'])
    if'schema_version'in spec:
        _need(type(value.get('schema_version'))is int and value['schema_version']==spec['schema_version'],'E_VERSION')
    if'record_type'in spec:
        _need(type(value.get('record_type'))is str and value['record_type']==spec['record_type'],'E_RECORD_TYPE')
    for key,typ in spec['fields'].items():
        _typed(value[key],typ,catalogue,value)
    if name in('phase_content_decision15_v2','generic_peer_content_decision13_v2'):
        _need(value['author']==value['reviewer']and _same(value['actual_current_Source_inputs'],value['actual_support_fact3s']),'E_RECORD_JOIN')
    if name in('constructor_API13','held_generic_emitter_API14','single_graph_API13','peer_graph_API13'):
        _need(value['actual_Source_editor']==value['author'],'E_RECORD_JOIN')
    if name=='peer_inverse12_v2':
        rebuilt=base64.b64decode(value['complete_predecessor_bytes_base64'],validate=True)
        _need(len(rebuilt)==value['predecessor']['bytes']and hashlib.sha256(rebuilt).hexdigest()==value['inverse_sha256']==value['predecessor']['sha256'],'E_INVERSE')
    if name in('recorded_observation12','fixed_spent_observation10'):
        for key in('raw9','path9','descriptor9'):
            _need(len(value[key])==9,'E_OBSERVATION')
        a,b=value['path9'],value['descriptor9']
        _need(value['raw9']==a and a[2]==b[2]==value['bytes']and a[6]==b[6]==1 and a[5]&0o170000==b[5]&0o170000==0o100000 and not(a[7]&0x400 or b[7]&0x400)and all(a[i]==b[i]for i in catalogue['ordinary_observation_shared7']),'E_OBSERVATION')
        if name=='recorded_observation12':
            _pin({k:value[k]for k in('path','bytes','sha256')},value['cap'])
            _need(value['shared_identity_indexes']==catalogue['ordinary_observation_shared7']and value['shared_descriptor7']==[b[i]for i in catalogue['ordinary_observation_shared7']],'E_OBSERVATION')
        else:
            fixed={p['path']:p for p in catalogue['spent_pin75']}
            archive={p['path']for p in catalogue['archival_spent2']}
            _need(value['path']in fixed,'E_SPENT_IDENTITY')
            pin=fixed[value['path']]
            _need(value['bytes']==pin['bytes']and value['sha256']==pin['sha256']and value['cap']==(4194304 if value['path']in archive else CAP),'E_SPENT_IDENTITY')
    return value



