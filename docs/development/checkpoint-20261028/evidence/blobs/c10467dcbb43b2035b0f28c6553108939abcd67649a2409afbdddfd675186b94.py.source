class Back(ast.NodeTransformer):
    def visit_Call(self,n):
        n=self.generic_visit(n)
        if isinstance(n.func,ast.Name)and n.func.id in('_descriptor','_ow_descriptor'):return n.args[1]
        if isinstance(n.func,ast.Name)and n.func.id in('_descriptor_keys','_ow_descriptor_keys'):return ast.Subscript(value=n.args[1],slice=ast.Constant(value='exact_keys'),ctx=ast.Load())
        return n
    def visit_Expr(self,n):
        if isinstance(n.value,ast.Call)and isinstance(n.value.func,ast.Name)and n.value.func.id=='_check_descriptor_encoding':return None
        return self.generic_visit(n)
    def visit_Assign(self,n):
        if isinstance(n.value,ast.Call)and isinstance(n.value.func,ast.Name)and n.value.func.id=='_descriptor'and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)and isinstance(n.value.args[1],ast.Name)and n.targets[0].id==n.value.args[1].id:return None
        return self.generic_visit(n)
