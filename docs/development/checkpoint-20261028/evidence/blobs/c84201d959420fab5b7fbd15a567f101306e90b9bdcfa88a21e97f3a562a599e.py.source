'ROOT_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_CKPEER14_001.json']
samples=[];canonical_pins=[]
for name in SAMPLES:
    path=BASE/name;pub=load(path);rows=[r for r in pub['published'] if r['role'] in ROLES]
    selection_key='Root_future_path_selection' if 'Root_future_path_selection' in pub else 'Root_selection'
    lease_key='actual_new_lease' if 'actual_new_lease' in pub else 'actual_lease009'
    sample=dict(publication=summary(path),selected_peer_rows=rows,original_request=summary(Path(pub['actual_Root_request']['path'])),publisher_Source=pin(Path(pub['publisher_source']['path'])),actual_selection_field=selection_key,actual_selection_value=pub[selection_key],actual_lease_field=lease_key,actual_lease_value=pub[lease_key],publication_current_selection_matches=pub[selection_key]==pin(selectionpath))
    assert sample['original_request']['pin']==pub['actual_Root_request']
    assert sample['publisher_Source']==pub['publisher_source']
    for row in rows:
        verify(row['canonical']);verify(row['draft']);canonical_pins.append(row['canonical'])
        verify(row['exact_Source_review']);verify(row['Root_Source_review_adoption'])
        if 'author_receipt' in row:
            a=load(Path(row['author_receipt']['path']));verify(row['author_receipt'])
            sample['issued_author_receipt']=summary(Path(row['author_receipt']['path']))
            sample['author_receipt_canonical_inputs']=[{k:x[k] for k in ('role','kind','subject','source_cap','different_Source_review','Root_adoption','Root_canonical_publication')} for x in a['canonical_Source_inputs']]
            sample['author_receipt_carried_inputs']=[{k:x[k] for k in ('role','kind','subject','source_cap')} for x in a['carried_Source_inputs']]
            for key in ('actual_author_request','actual_peer_content_proposal','Owner_genuine_content_review','Owner_review_Root_adoption'):
                sample[key]=summary(Path(a[key]['path']));assert sample[key]['pin']==a[key]
    samples.append(sample)
recons=[]
for path in sorted(BASE.glob('*RECONCILIATION*.json')):
    if str(path).casefold() in SPENT:continue
    value=load(path)
    if type(value) is dict and value.get('canonical_Source') in canonical_pins:
        row=summary(path);row['canonical_Source']=value['canonical_Source'];row['original_refs']={}
        for key in ('initial_actual_Root_request','initial_actual_canonical_publication_receipt','initial_actual_execution_witness','actual_canonical_delta_Source_review','canonical_delta_Root_adoption'):
            p=value[key];verify(p);row['original_refs'][key]=summary(Path(p['path']))
        for key in ('Root_future_path_selection','new_canonical_lease','prior_actual_publisher_Source'):row[key]=value[key]
        recons.append(row)
sourcepaths={
'I12_peer004':OLD/'i12'/'validate_selected_peer_receipt_metadata_004.py',
'I12_peer_API004':OLD/'i12'/'CURRENT_OWNER_SELECTED_PEER_RECEIPT_METADATA_GRAPH_INERT_API_004.json',
'I12_single003':OLD/'i12'/'validate_generic_single_receipt_metadata_003.py',
'I11_finite8003':ROOT.parent/'resume-20261025-001'/'i2_receipt_contract_014'/'i11'/'validate_finite8_canonical_receipt_metadata_003.py',
'I5_phase_current003':Path(r'D:\Aenv\pro2\github-portable-20261012-001\docs\development\native-interface-implementation\20261015-i5\assemble_genuine_phase_peer_current_owner_deferred_003.py.source'),
'I2_held006':OLD/'i2'/'build_M3_metadata_current_owner_deferred_006.py'}
sources={};phase_tree=None
for key,path in sourcepaths.items():
    raw=read(path);value=dict(pin=pin(path,raw))
    if path.suffix in ('.py','.source'):
        tree=ast.parse(raw);lines=raw.splitlines(keepends=True);value['regions']=[]
        keep={'_Peer','_Graph','validate_selected_peer_receipt_metadata','validate_selected_peer_canonical_dependency_metadata','execute_stage','validate_current_owner_phase_peer_context','_i5_phase_shapes','_current_generic_receipt24','canonical_dependency','admit'}
        for n in tree.body:
            if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name in keep:
                part=b''.join(lines[n.lineno-1:n.end_lineno]);value['regions'].append(dict(name=n.name,first_line=n.lineno,last_line=n.end_lineno,bytes=len(part),sha256=hashlib.sha256(part).hexdigest()))
        if key=='I5_phase_current003':phase_tree=tree
    sources[key]=value
schema24=ast.literal_eval(next(n.value for n in phase_tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='SCHEMA24' for t in n.targets)))
decls={k:CAT['schemas'][k] for k in ('selected_peer_receipt27_v2','generic_peer_content_decision13_v2','phase_content_decision15_v2','peer_serialization_witness13_v2','peer_inverse12_v2','peer_packet20','phase_context21_v2','phase_parser_support9_v2','code_support5','decision_support3','proposal_support3')}
