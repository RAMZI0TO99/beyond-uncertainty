OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
OLD=ROOT.parent/'resume-20261025-002'/'receipt_caller_integration_015'
BASE=ROOT.parent/'resume-20261007-001'/'generation'/'observer010_lease009_root_001'
CATPATH=OLD/'I12_EXACT_RECEIPT_FORMAT_SCHEMA_AND_FIXED_DATA_CATALOGUE_002.json'
CAT=json.loads(CATPATH.read_bytes())
SPENT={p['path'].casefold() for p in CAT['spent_pin75']}
READS={}
def read(path):
    path=Path(path)
    assert str(path).casefold() not in SPENT,('spent body forbidden',str(path))
    with path.open('rb') as f:raw=f.read(2097153)
    assert 0<len(raw)<=2097152,str(path)
    READS[str(path)]=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    return raw
def pin(path,raw=None):
    raw=read(path) if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def pairs(rows):
    value={}
    for key,item in rows:
        if key in value:raise ValueError('duplicate JSON key')
        value[key]=item
    return value
def bad(value):raise ValueError('noninteger JSON')
def load(path):return json.loads(read(path).decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def summary(path):
    raw=read(path);v=json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    assert type(v) is dict
    return dict(pin=pin(path,raw),schema_version=v.get('schema_version'),record_type=v.get('record_type'),keys=sorted(v),field_builtin_types={k:type(x).__name__ for k,x in v.items()},scalar_fields={k:x for k,x in v.items() if type(x) in (str,int,bool) or x is None})
def verify(p):
    raw=read(Path(p['path']));assert pin(Path(p['path']),raw)==p
    return raw
ROLES=['metadata_peer','metadata_bound_review','phase_peer','pipeline_peer','checker_peer']
selectionpath=BASE/'ROOT_SOURCE022_LEASE010_SEPARATE_FUTURE45_SOURCE_PATH_SELECTION_001.json'
selection=load(selectionpath)
selected=[]
for row in selection['rows']:
    if row['role'] not in ROLES:continue
    result=dict(row=row,canonical_path_present=Path(row['canonical_path']).is_file(),draft_path_present=Path(row['draft_path']).is_file(),predecessor=summary(Path(row['predecessor']['path'])))
    assert result['predecessor']['pin']==row['predecessor']
    if result['canonical_path_present']:
        result['canonical']=summary(Path(row['canonical_path']))
        result['draft']=summary(Path(row['draft_path']))
        result['canonical_equals_draft_whole_bytes']=read(Path(row['canonical_path']))==read(Path(row['draft_path']))
    selected.append(result)
SAMPLES=[
'ROOT_SOURCE022_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_M3_PEER009_001.json',
'ROOT_SOURCE022_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_BOUNDPEER018_002.json',
'ROOT_SOURCE021_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_PHASEPEER019_001.json',
