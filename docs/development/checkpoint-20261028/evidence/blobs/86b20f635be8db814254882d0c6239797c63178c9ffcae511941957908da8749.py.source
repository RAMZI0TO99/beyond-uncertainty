"""Root adoption of exact independently reviewed new metadata protocol; no target call."""
import datetime as dt,hashlib,json,sys
from pathlib import Path
R=Path(__file__).parent
M=R/'m3_peer_contracts_016/m3_protocol_audit_001'
proposal=M/'descriptor_dictionary_factor_protocol_proposal_001/I13_EXACT_COMPACT_DESCRIPTOR_GRAMMAR_PROTOCOL_PROPOSAL_002.json'
clarification=M/'descriptor_dictionary_factor_protocol_proposal_001/I13_PROTOCOL002_EXACT_TEMPLATE_CHOICES_DESCRIPTOR_KEYS_CLARIFICATION_001.json'
assert hashlib.sha256(clarification.read_bytes()).hexdigest()=='ad0e25b86fb274c68524966303dcb9d76792a65991013a56ee511fa0fa6232bc'
def pin(p):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def load(p):return json.loads(Path(p).read_bytes())
def direct(v,p):
 s=v['subjects'];return p in(list(s.values())if type(s)is dict else s)
assert len(sys.argv)==3;cp=Path(sys.argv[1]);assert pin(cp)['sha256']==sys.argv[2]
c=load(cp);link=c.get('full_proof',c.get('full_review'));fp=Path(link['path']);assert pin(fp)==link;f=load(fp)
assert pin(proposal)['sha256']=='fae3aa96dc8ea0278b67f70ce571e0fce0a5413f0389c7d2af762415f0c93e47'
for v in(c,f):
 assert v['reviewer']=='/root/i13_final_review'and v['verdict'].startswith('PASS_')and v['checks_failed']==0
 assert all(v[k]is False for k in('tests_executed','target_execution','operational_authority','scientific_authority'))
 assert direct(v,pin(proposal))and direct(v,pin(clarification))
assert c['checks_passed']==f['checks_passed']==len(f['checks'])==len({x['name']for x in f['checks']})and all(x['passed']is True for x in f['checks'])
scope=R/'ROOT_CURRENT_I13_M3_PEER_CONTRACT_SOURCE_SCOPE_003.json';sc=load(scope);now=dt.datetime.now(dt.timezone.utc)
assert dt.datetime.fromisoformat(sc['interval_start'])<=now and(dt.datetime.fromisoformat(sc['interval_end'])-now).total_seconds()>60
p=load(proposal);assert p['analysis']['all65_schemas_canonical_wire_bytes_equal']is True and p['analysis']['encoded_whole_nodes_header_and_definitions_included']==5378
v=dict(schema_version=1,record_type='Root_I13_compact_descriptor_grammar002_and_joint_fixture_events_different_protocol_review_adoption',author='/root',created_utc=now.isoformat(),verdict='ACCEPT_EXACT_I13_COMPACT_DESCRIPTOR_GRAMMAR002_AND_JOINT_FIXTURE_SOURCE_PROTOCOL_ONLY',Source_scope=pin(scope),base_protocol_adoption=pin(R/'ROOT_I13_FINAL_PROTOCOL007_RECORDED_CONTEXT_DIFFERENT_REVIEW_ADOPTION_004.json'),proposal=pin(proposal),exact_reader_clarification=pin(clarification),different_Source_review=pin(cp),full_proof=pin(fp),checks_passed=c['checks_passed'],checks_failed=0,Source_implementation_authorized='New own I13 catalogue representation, three pure kernel/API successors, descriptor-only fixture readers, shared exact nine-binding proof event and one complete reference-only marker for the five capture dependencies. All precise predicates/subjects/chronology/actors/pins remain required. No expanded runtime schema graph or duplicate parse cache; all actual encoded definitions/header/reference nodes charged locally and parent plus child counts summed. Exact original65 schemas and all old semantic constraints reconstruct in independent review only.',Source_layout_compaction_authorized='Only layout/comment changes with exact non-layout token and AST equivalence before separately identified semantic adapters; original complete bytes and predecessor inverses retained, each new kernel remains<=65536 bytes.',separate_genuine_implementation_Source_review_and_Root_adoption_required=True,fresh_exact_once_scope_required_per_partition=True,automatic_synthetic_invocations_admitted=False,positive_fit_or_case_pass_established=False,new_I13_representation_only=True,old_I0_through_I12_unchanged=True,combined_nodes_cap=50000,conservative_per_invocation_cache_sum_unchanged=True,result54_unchanged=True,all_other_original_caps_and_gates_unchanged=True,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False,Native8_Parser_runtime_science_admitted=False)
out=R/'ROOT_I13_COMPACT_DESCRIPTOR_GRAMMAR002_AND_JOINT_EVENT_PROTOCOL_DIFFERENT_REVIEW_ADOPTION_001.json'
with out.open('xb')as h:h.write((json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii'))
print(json.dumps(dict(adoption=pin(out),implementation_review_required=True,tests_admitted=False)))
