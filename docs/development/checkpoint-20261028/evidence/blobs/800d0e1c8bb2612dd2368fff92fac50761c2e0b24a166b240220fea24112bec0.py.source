parent=pt.replace('@@FIXED@@',repr(fixed)).replace('@@CHILD_SOURCE@@',repr(child)).replace('@@ERROR_CODES@@',repr(contract['typed_errors']))
parentb=parent.encode('utf8');need(len(parentb)<=65536 and len(childb)<=65536,'supervisor/child narrow Sourcecaps')
pa=ast.parse(parent);ch=ast.parse(child) # Static AST only; NEVER compile or exec either subject.

def first_guard(node,kind):
 first=node.body[0]
 if kind=='raise':return type(first) is ast.Raise
 return type(first) is ast.Expr and type(first.value) is ast.Call and type(first.value.func) is ast.Name and first.value.func.id=='_activation_required'

def declaration_report(source,root):
 lines=source.splitlines(keepends=True);rows=[]
 for node in ast.walk(root):
  if type(node) in (ast.FunctionDef,ast.ClassDef):
   body=''.join(lines[node.lineno-1:node.end_lineno]).encode('utf8')
   rows.append(dict(symbol=node.name,line=node.lineno,end_line=node.end_lineno,UTF8_sha256=hashlib.sha256(body).hexdigest(),AST_sha256=hashlib.sha256(ast.dump(node,include_attributes=False).encode()).hexdigest(),calls=sorted(set(ast.unparse(x.func) for x in ast.walk(node) if type(x) is ast.Call))))
 return rows

