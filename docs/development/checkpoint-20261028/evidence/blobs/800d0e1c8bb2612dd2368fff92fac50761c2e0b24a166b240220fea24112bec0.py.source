"""Assemble inert supervisor/child Source and static evidence; never execute subjects."""
import ast,datetime as dt,hashlib,json,math,os,stat
from pathlib import Path
R=Path(__file__).parents[1]
P=R.parent/'resume-20261027-001'
OUT=Path(__file__).parent
CAP=2097152

def need(v,m):
 if not v:raise ValueError(m)

def raw(path):
 p=Path(path)
 for q in (p,*p.parents):need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=CAP,'bounded singlelink regular bytes')
 with p.open('rb') as h:
  d=os.fstat(h.fileno());b=h.read(CAP+1);e=os.fstat(h.fileno())
 z=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
 need(k(a)==k(d)==k(e)==k(z) and len(b)==a.st_size<=CAP,'stable samehandle metadata/Source');return b

def pin(path,b=None):
 if b is None:b=raw(path)
 return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

def doc(path,sha):
 b=raw(path);p=pin(path,b);need(p['sha256']==sha,'exact frozen input')
 def pairs(rows):
  d={}
  for k,v in rows:need(k not in d,'duplicate JSONkey');d[k]=v
  return d
 def bad(v):raise ValueError('noninteger/nonfinite JSON')
 return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad),p

def tree(v,depth=1):
 need(depth<=48,'metadata depth48')
 if type(v) is dict:
  n=1+len(v)+sum(tree(x,depth+1) for x in v.values())
 elif type(v) is list:n=1+sum(tree(x,depth+1) for x in v)
 else:n=1
 need(n<=50000,'metadata nodes50000');return n

def write(name,b,limit=CAP):
 need(type(b) is bytes and len(b)<=limit,'exact unchanged own Source/output cap')
 now=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(scope['interval_start'])<=now and (dt.datetime.fromisoformat(scope['interval_end'])-now).total_seconds()>60,'fresh Source008 strict60reserve at every write')
 p=OUT/name
 with p.open('xb') as h:need(h.write(b)==len(b),'complete exclusiveCreate');h.flush();os.fsync(h.fileno())
 need(raw(p)==b,'whole saved readback');return pin(p,b)

def wire(v):return (json.dumps(v,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
def data(name,v):
 tree(v);return write(name,(json.dumps(v,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8'))

