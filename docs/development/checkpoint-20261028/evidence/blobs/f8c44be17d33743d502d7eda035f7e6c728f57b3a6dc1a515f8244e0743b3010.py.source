check('manifest_exact_three_modules_two_fixtures',all(t in manifest for t in ("{'m3','peer','publisher'}","{'m3_publisher','peer'}","0<s['bytes']<=65536","0<api['bytes']<=2097152","0<s['bytes']<=2097152")),'All paths resolved under component; per-file caps unchanged.')
check('manifest_literal_cases_and_unique_ASCII',all(t in manifest for t in ('ast.literal_eval(assigns[0].value)','len(names)==len(set(names))',"re.fullmatch('[A-Za-z0-9_.:-]+',n)","names=value['case_names_by_fixture']['m3_publisher']+value['case_names_by_fixture']['peer']")),'Names extracted without importing fixture.')
check('manifest_exact_four_keyword_fixture_signature',all(t in manifest for t in ("not run.args.args","not run.args.posonlyargs","not run.args.vararg","not run.args.kwarg","['m3','publisher','peer','catalogue_bytes']","all(x is None for x in run.args.kw_defaults)")),'No arbitrary callback or signature widening.')
check('manifest_closed_peer_API14_and_current_catalogue',all(t in manifest for t in ("['schemas']['held_peer_API14']","len(body)==declared['field_count']==14","ast.literal_eval(catalogue_assign.value)==value['catalogue']","('target_execution','operational_authority','actual_producer_issued')")),'Peer API does not contain scientific_authority; exact14 is handled without inferring absent authority.')

findings=[
    dict(id='ROOT-F01',title='Bind semantic reads to the exact hashed bounded buffer',subjects=[subject_pins[2],subject_pins[3]],locations=[dict(file=subject_pins[2]['path'],function='exact',lines=[21,23]),dict(file=subject_pins[3]['path'],functions=['pin','module/API loop','fixture loop'])],reason='once exact(p) hashes one read then read(p.path) decodes another. Manifest pins Source/API/catalogue/fixture bytes and later rereads for AST/JSON/case extraction. Supervisor pin and SCOPE_KEYS AST also use separate reads. Hash-approved bytes must be the actual semantic buffer.',repair='Retain one bounded bytes buffer per input, derive both pin and JSON/AST/literal catalogue from that buffer; retain supervisor buffer for pin+SCOPE_KEYS; include bounded config/selection reads. Preserve001 and issue additive002.'),
    dict(id='ROOT-F02',title='Require exact builtin string dictionary keys in the composition fact3 binder',subjects=[subject_pins[0],subject_pins[1]],locations=[dict(file=subject_pins[0]['path'],function='_pin_equal',lines=[27,28])],reason='type(value)is dict plus set(value) accepts str-subclass keys equal to path/bytes/sha256. Value type guards do not establish exact key types.',repair='Add all(type(k)is str for k in value) before set/index operations; preserve001 and issue additive Source/API002.')]
