def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode();assert len(raw)<=2097152
    with path.open('xb')as f:f.write(raw)
    return pin(path,raw)
common=dict(schema_version=2,reviewer='/root/i2_resume_gap',author='/root/i2_resume_gap',source_author='/root',created_utc=created,verdict=verdict,subjects=subject_pins,checks_passed=len(checks)-2,checks_failed=2,findings=findings,tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False,native_Parser_executed=False,actual_family_publication=False)
