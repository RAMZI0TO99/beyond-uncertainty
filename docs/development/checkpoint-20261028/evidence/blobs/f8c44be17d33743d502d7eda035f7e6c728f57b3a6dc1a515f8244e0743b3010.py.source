for key in ('target_execution','operational_authority','scientific_authority','authentic_loader_qualified','actual_family_publication','full_original_I2_DAG_closed','current_canonical_authority_qualified','composition_metadata_route_executed','old_I2_caller_imported_or_modified'):
    check('composition_API_explicit_false_'+key,api.get(key)is False,{key:api.get(key)})
