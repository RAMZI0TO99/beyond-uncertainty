for token in ("reported['grant']=='010'","reported['reported_full_compute_custody_released'] is True","reported['grant_consumed_closed'] is True","reported['Root_acceptance']['peer_result_accepted'] is False","for p in grantfiles)==10"):
    check('once_coordination_'+str(len(checks)),token in once,token)
