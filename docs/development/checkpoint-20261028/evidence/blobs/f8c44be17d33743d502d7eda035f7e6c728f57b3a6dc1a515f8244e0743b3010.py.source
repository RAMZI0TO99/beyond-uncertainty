ct=trees[paths[0][0].name];ot=trees[paths[2][0].name];mt=trees[paths[3][0].name]
def func(tree,name):return next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name==name)
def assign(tree,name):return next(n for n in tree.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id==name for t in n.targets))
fixed=ast.literal_eval(assign(ct,'FIXED_SOURCES').value)
ports=ast.literal_eval(assign(ct,'METADATA_PORTS').value)
