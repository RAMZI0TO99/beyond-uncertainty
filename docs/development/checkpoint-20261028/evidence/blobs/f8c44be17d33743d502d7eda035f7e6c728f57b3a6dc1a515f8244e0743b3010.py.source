check('metadata_route_no_decode_counter_or_IO',not any(isinstance(n,ast.Name)and n.id in ('json','open','read_bytes','counter','importlib','exec')for n in ast.walk(func(ct,'validate_current_owner_M3_peer_receipt_metadata')))and 'raw=fn(packet=packet,records=records,catalogue_bytes=catalogue_bytes' in route,route)
check('metadata_route_detached_rawbytes',"_need(type(raw) is bytes,'E_LAYER_RESULT')"in route and route.rstrip().endswith('return raw'),'Only fixed publisher returns metadata bytes; its own layer validates m3/peer and combined counts.')

