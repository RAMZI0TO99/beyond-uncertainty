check('once_exact_60_50_10_5_stream_budgets',"dict(total_seconds=60,wait_seconds=50,cleanup_seconds=10,reap_seconds=5,stdout_maximum_bytes=2097152,stderr_maximum_bytes=2097152)"in once,'No cap or reserve widened.')
check('once_creates_only_unclaimed_owned_paths',all(t in once for t in ("assert not os.path.lexists(owned)","not os.path.lexists(p)","p.open('xb')","('claim','SCOPE_CLAIM_001.json')","maximum_suite_invocations=1")),'Helper does not create or consume the one-use claim, child-entry, or child-result; supervisor later owns those exact output paths.')
check('once_no_quiet_or_peer_result_acceptance',"whole_host_quiet_claimed=False,physical_handle_absence_claimed=False"in once and 'peer_result_accepted' in once,'Retained report is scheduling data only, not peer result or whole-host physical proof.')
