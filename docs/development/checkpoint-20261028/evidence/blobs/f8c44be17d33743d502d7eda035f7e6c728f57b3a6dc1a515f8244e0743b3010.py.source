def pin(path,raw=None):
    raw=path.read_bytes()if raw is None else raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
paths=[
    (I/'current_owner_M3_peer_held_composition_001.py',5065,'4d9560ad15440509d502646a70a0bdb9ba525504c16c0878afd43e4308ca4c27'),
    (I/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_001.json',4035,'c5a5d03175fd9511ce0c7ba3c0337da980d0cb97f555aaeacfa465a671f32d2d'),
