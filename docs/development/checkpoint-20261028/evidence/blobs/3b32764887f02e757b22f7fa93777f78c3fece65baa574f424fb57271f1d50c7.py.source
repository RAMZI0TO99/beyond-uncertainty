"""Author a repaired inert Root control generator; no generated control or target call."""
import ast,base64,hashlib,json
from pathlib import Path
R=Path(__file__).parent;p=R/'author_I13_compact_SourceSet4_Root_controls_001.py';raw=p.read_bytes();assert hashlib.sha256(raw).hexdigest()=='07f63faa53bf35ebe1046d481331fc572f6db85e9f0ae849e3b6fbc6bc1dc348';s=raw.decode('utf8')
changes=[
 ("fixtures={'m3':pin(mf),'peer':pin(pf)}","fixtures={'m3_publisher':pin(mf),'peer':pin(pf)}"),
 ("fresh();sources={k:pin(p)for k,p in zip(('m3','peer','publisher'),(ms,ps,us))}","def occurs(v,p):\n if type(v)is dict:return v==p or any(occurs(x,p)for x in v.values())\n return type(v)is list and any(occurs(x,p)for x in v)\nfrozen=load(freeze)\nassert all(occurs(frozen,pin(p))for p in paths[:-1]),'all eleven supplied exact assets occur in the frozen author manifest'\nprospective=[T/'current_owner_M3_peer_held_composition_005.py',T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_005.json',T/'I13_EXACT936_DISJOINT_MAX32_CASE_PARTITION_SOURCE_PLAN_005.json',C/'ROOT_I13_ONCE_MEMORY_SUPERVISOR_010.py',C/'ROOT_I13_SOURCESET4_ROOT_COMPOSITION005_PLAN005_SUPERVISOR010_SOURCE_AUTHOR_RECEIPT_001.json']\nassert all(not p.exists()for p in prospective),'all prospective Root products unused before first write'\nfresh();sources={k:pin(p)for k,p in zip(('m3','peer','publisher'),(ms,ps,us))}"),
 ("oldapi=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json';api=load(oldapi);", "oldapi=T/'CURRENT_OWNER_M3_PEER_SEPARATE_HELD_COMPOSITION_INERT_API_004.json';oldapi_raw=oldapi.read_bytes();api=json.loads(oldapi_raw);"),
 ("oldplanraw=oldplan.read_bytes();plan=load(oldplan)","oldplanraw=oldplan.read_bytes();oldplan_value=json.loads(oldplanraw);plan=oldplan_value"),
 ("[r['case_names']for r in load(oldplan)['partitions']]","[r['case_names']for r in oldplan_value['partitions']]"),
 ("pin(oldapi),pin(oldplan,oldplanraw)","pin(oldapi,oldapi_raw),pin(oldplan,oldplanraw)"),
 ("(oldraw,oldapi.read_bytes(),oldplanraw,supraw)","(oldraw,oldapi_raw,oldplanraw,supraw)")
]
for a,b in changes:assert s.count(a)==1,(a,s.count(a));s=s.replace(a,b)
ast.parse(s);out=R/'author_I13_compact_SourceSet4_Root_controls_002.py';new=s.encode('utf8')
with out.open('xb')as h:h.write(new)
def pin(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=dict(schema_version=1,record_type='Root_I13_control_author002_fixed_fixture_domain_and_same_buffer_Source_author_receipt',author='/root',predecessor=pin(p,raw),successor=pin(out,new),complete_predecessor_bytes_base64=base64.b64encode(raw).decode('ascii'),change='Use the existing exact m3_publisher fixture domain; bind all eleven supplied assets to the frozen author manifest and preflight all unused Root outputs; retain the same old API and old plan buffers for parsing, decisions, predecessor facts and complete inverse. No control author or target invoked.',successor_invoked=False,target_execution=False,tests_executed=False,actual_family_publication=False,operational_authority=False,scientific_authority=False)
q=R/'ROOT_I13_SOURCESET4_ROOT_AUTHOR002_PRELAUNCH_SOURCE_REPAIR_RECEIPT_001.json';b=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2)+'\n').encode('ascii')
with q.open('xb')as h:h.write(b)
print(json.dumps(dict(Source=pin(out,new),receipt=pin(q,b),author_invoked=False)))
