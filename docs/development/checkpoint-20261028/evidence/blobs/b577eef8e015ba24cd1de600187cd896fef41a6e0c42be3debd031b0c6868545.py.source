import ast,hashlib,json
from pathlib import Path
R=Path(__file__).parent;C=R/'m3_peer_contracts_016';T=C/'i13'
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
v=json.loads((C/'I13_FINAL_SOURCE_SELECTION_INPUT_003.json').read_bytes());v['fixtures']=dict(m3_publisher=str(T/'exercise_M3_guard_and_publisher_metadata_memory_009.py'),peer=str(T/'exercise_selected_peer_author_metadata_memory_007.py'))
p=C/'I13_FINAL_SOURCE_SELECTION_INPUT_004.json';b=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode()
with p.open('xb') as h:h.write(b)
def successor(before_name,after_name,changes):
 s=(R/before_name).read_bytes().decode('utf8')
 for old,new,n in changes:
  assert s.count(old)==n,(before_name,old,s.count(old),n);s=s.replace(old,new)
 ast.parse(s,filename=str(R/after_name));p=R/after_name
 with p.open('xb') as h:h.write(s.encode('utf8'))
 return pin(p)
