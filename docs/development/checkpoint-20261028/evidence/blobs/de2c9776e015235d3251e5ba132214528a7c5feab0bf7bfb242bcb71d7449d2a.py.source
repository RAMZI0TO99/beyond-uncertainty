def need(value,message):
 if not value: raise ValueError(message)
def pin(path):
 path=Path(path)
 for p in (path,*path.parents):
  st=p.lstat();need(not p.is_symlink() and not getattr(st,'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 before=path.stat();need(path.is_file() and before.st_nlink==1,'single-link regular metadata/Source')
 h=hashlib.sha256();size=0
 with path.open('rb') as f:
  opened=os.fstat(f.fileno())
  while True:
   block=f.read(1048576)
   if not block:break
   h.update(block);size+=len(block)
  finished=os.fstat(f.fileno())
 after=path.stat()
 keys=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_nlink','st_file_attributes')
 need(size==before.st_size and all(getattr(before,k,None)==getattr(after,k,None) for k in keys),'stable physical path pin')
 need(all(getattr(opened,k,None)==getattr(finished,k,None) for k in keys) and opened.st_ino==before.st_ino and opened.st_size==size,'stable same-handle pin')
 return dict(path=str(path),bytes=size,sha256=h.hexdigest())
def doc(path,sha=None):
 meta=pin(path);need(meta['bytes']<=2097152,'Root unchanged2MiB parsed metadata cap')
 if sha:need(meta['sha256']==sha,'exact immutable metadata pin')
 raw=Path(path).read_bytes();need(hashlib.sha256(raw).hexdigest()==meta['sha256'],'same parsed metadata buffer')
 def pairs(rows):
  result={}
  for k,v in rows:need(k not in result,'duplicate metadata key');result[k]=v
  return result
 value=json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda x:(_ for _ in()).throw(ValueError('nonfinite metadata')))
 return value,meta
def same(spec):
 actual=pin(spec['path']);need(actual['sha256']==spec['sha256'],'exact complete external streamed pin')
 if 'bytes' in spec:need(actual['bytes']==spec['bytes'],'exact complete external byte size')
 return actual
