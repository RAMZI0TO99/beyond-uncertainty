"""Preserve unexecuted adopter001 and add final-boundary reserve guard in002."""
import ast,hashlib,json,os
from pathlib import Path
R=Path(__file__).parent;p=R/'adopt_I13_handoff003_creation_001.py';old=p.read_bytes()
assert len(old)==6008 and hashlib.sha256(old).hexdigest()=='33c716c9e0b2c8a7a43ac33e1ca7986d942c823e3e2f796a2ccf6ec5c7f44ef1'
s=old.decode();anchor="with out.open('xb') as f:"
assert s.count(anchor)==1
s=s.replace(anchor,"commit_now=dt.datetime.now(dt.timezone.utc)\nneed(dt.datetime.fromisoformat(scope['interval_start'])<=commit_now and (dt.datetime.fromisoformat(scope['interval_end'])-commit_now).total_seconds()>60,'freshSource006intervalandoriginal60reserveatfinalexclusivewrite')\n"+anchor)
out=R/'adopt_I13_handoff003_creation_002.py';b=s.encode();ast.parse(b,filename=str(out));assert len(b)<=2097152 and not os.path.lexists(out)
with out.open('xb') as f:assert f.write(b)==len(b);f.flush();os.fsync(f.fileno())
assert p.read_bytes()==old and out.read_bytes()==b
print(json.dumps(dict(new_unexecuted_adopter=dict(path=str(out),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),old001_preserved=True,adoption_issued=False)))
