def need(v,m):
 if not v:raise ValueError(m)
def raw(path):
 path=Path(path)
 for p in (path,*path.parents):need(not p.is_symlink() and not getattr(p.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=path.stat();need(path.is_file() and a.st_nlink==1 and 0<=a.st_size<=CAP,'regular singlelink bounded metadata/Source')
 with path.open('rb') as f:
  opened=os.fstat(f.fileno());b=f.read(CAP+1);ended=os.fstat(f.fileno())
 z=path.stat();keys=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_nlink')
 need(len(b)<=CAP and len(b)==a.st_size==z.st_size and all(getattr(a,k)==getattr(z,k) for k in keys),'stable bounded pathname bytes')
 need(all(getattr(opened,k)==getattr(ended,k) for k in keys) and opened.st_ino==a.st_ino and opened.st_size==len(b),'stable opened bytes')
 return b
def pin(path):
 b=raw(path);return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def parse(b):
 def pairs(rows):
  result={}
  for k,v in rows:need(k not in result,'duplicate JSON key');result[k]=v
  return result
 def finite(x):
  v=float(x);need(math.isfinite(v),'finite JSON number');return v
 return json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=lambda x:(_ for _ in()).throw(ValueError('nonfinite JSON')))
def doc(path,sha=None):
 b=raw(path);p=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if sha:need(p['sha256']==sha,'exact prior evidence pin')
 return parse(b),p
def write(path,value):
 need(not os.path.lexists(path),'unused output identity')
 b=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii');need(len(b)<=CAP,'unchanged2MiB output cap')
 with path.open('xb') as f:need(f.write(b)==len(b),'completeCreateNew');f.flush();os.fsync(f.fileno())
 need(raw(path)==b,'complete output readback');return pin(path)
def git(*args):
 env=dict(os.environ);env['GIT_OPTIONAL_LOCKS']='0'
 p=subprocess.run(['git','--no-optional-locks','-c','safe.directory=D:/Aenv/pro2/github-portable-20261012-001',*args],cwd=REPO,env=env,capture_output=True,timeout=45)
 need(p.returncode==0 and len(p.stdout)<=CAP and len(p.stderr)<=CAP,'bounded successful read-only Git command')
 return p.stdout.decode('utf-8')
