def save(name,v):
 assert END-datetime.datetime.now(datetime.timezone.utc)>datetime.timedelta(seconds=60)
 b=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('utf8');assert len(b)<=2097152
 p=OUT/name
 with p.open('xb')as f:f.write(b);f.flush();os.fsync(f.fileno())
 assert p.read_bytes()==b;print(json.dumps(pin(p),sort_keys=True));return p
