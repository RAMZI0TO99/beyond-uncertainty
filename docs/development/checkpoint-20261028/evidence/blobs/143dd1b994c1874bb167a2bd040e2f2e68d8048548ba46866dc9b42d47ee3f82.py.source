"""Own metadata source author only; preserve complete refused001 and author002.
Never execute either subject PowerShell source or either candidate/writer.
"""
import ast, base64, datetime as dt, hashlib, json, os, stat
from pathlib import Path
R=Path(__file__).parent
S=R.parent/'pro3_bootstrap002_source_review_001'
def need(v,m):
    if not v: raise ValueError(m)
def raw(p):
    p=Path(p)
    for q in (p,*p.parents): need(not q.is_symlink() and not getattr(q.lstat(),'st_file_attributes',0)&1024,'direct nonreparse lineage')
    a=p.stat();need(stat.S_ISREG(a.st_mode) and a.st_nlink==1 and 0<=a.st_size<=2097152,'bounded regular singlelink metadata')
    with p.open('rb') as h:
        b0=os.fstat(h.fileno());b=h.read(2097153);b1=os.fstat(h.fileno())
    z=p.stat();k=lambda x:(x.st_dev,x.st_ino,x.st_mode,x.st_nlink,x.st_size,x.st_mtime_ns)
    need(k(a)==k(b0)==k(b1)==k(z) and len(b)==a.st_size,'stable same-buffer read');return b
def pin(p,b=None):
    if b is None:b=raw(p)
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(xs):
    d={}
    for k,v in xs:need(k not in d,'duplicate JSON');d[k]=v
    return d
def bad(v):raise ValueError('noninteger/nonfinite JSON')
def doc(p):return json.loads(raw(p),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
scopepath=S/'ROOT_PRO3_NEW_FINITE_SOURCE_ONLY_COEXISTENCE_SCOPE_011_001.json'
scope=doc(scopepath)
need(pin(scopepath)['sha256']=='c52dbbfc4a5202bc5476e6b41071d72a1163b339e8bcaad29acf2a6dae70a540','actual scope011')
def fresh():
    n=dt.datetime.now(dt.timezone.utc)
    need(dt.datetime.fromisoformat(scope['interval_start'])<=n and (dt.datetime.fromisoformat(scope['interval_end'])-n).total_seconds()>60,'effective011 strict60 reserve')
    return n.isoformat()
def save(name,b):
    need(len(b)<=2097152,'own2MiB metadata cap');fresh();p=R/name
    with p.open('xb') as h:need(h.write(b)==len(b),'whole CreateNew');h.flush();os.fsync(h.fileno())
    need(raw(p)==b,'whole readback');return pin(p,b)
fresh()
oldsource=R/'prepare_or_adopt_bootstrap004_once_peer_decision_001.py'
oldcandidate=R/'ROOT_PRO3_BOOTSTRAP_REQUEST004_ONCE_PEER_DECISION_CANDIDATE_001.json'
oldb=raw(oldsource);oldc=raw(oldcandidate)
need(pin(oldsource,oldb)==dict(path=str(oldsource),bytes=20406,sha256='5b06aff4bb9fe08b0f78fab22b2a48433699cf0e72024b378899ee2147c9b189'),'exact old writer')
need(pin(oldcandidate,oldc)==dict(path=str(oldcandidate),bytes=17106,sha256='5ee0b1d09580fd3a7d7cd2ae86e350e987e0f3e5aacf2628b4c83132e5bde09a'),'exact old candidate')
refpath=R/'decision004_creation_different_review_001/INDEPENDENT_ROOT_BOOTSTRAP004_CANDIDATE_CREATION_REFUSAL_CAPSULE_001.json'
refpin=pin(refpath)
need(refpin['bytes']==12296 and refpin['sha256']=='9e7ff032949ce6d8bd2c472a4207c62cfeac06a9b4a12a391fab9236e8fc82e0','exact genuine refusal001')
ref=doc(refpath);need(ref['checks_passed']==102 and ref['checks_failed']==1 and ref['remaining_actionable_findings'][0]['id']=='D004_CANDIDATE_OPERATIVE_COMPATIBILITY','single Root-only creation issue')
inverse=dict(record_type='Root_candidate002_complete_refused001_metadata_inverse',created_utc=fresh(),scope=pin(scopepath),author_Source=pin(Path(__file__)),refusal=refpin,complete_predecessors=[dict(**pin(p,b),base64=base64.b64encode(b).decode()) for p,b in [(oldsource,oldb),(oldcandidate,oldc)]],own_metadata_only=True,subject_execution=False)
invbytes=(json.dumps(inverse,sort_keys=True,indent=2)+'\n').encode()
# Own metadata shape: below2MiB, fixed small schema/depth and bounded Base64 strings.
need(len(invbytes)<100000 and len(inverse['complete_predecessors'])==2,'small bounded whole inverse')
invname='ROOT_PRO3_BOOTSTRAP004_COMPLETE_REFUSED_CANDIDATE_WRITER001_INVERSE_001.json'
invpin=save(invname,invbytes)
source=oldb.decode('utf-8')
edits=[]
def change(before,after):
    global source
    need(source.count(before)==1,'unique own source edit: '+before[:100])
    source=source.replace(before,after,1);edits.append(dict(before=before,after=after))
change("R / 'ROOT_PRO3_BOOTSTRAP_REQUEST004_ONCE_PEER_DECISION_CANDIDATE_001.json'", "R / 'ROOT_PRO3_BOOTSTRAP_REQUEST004_ONCE_PEER_DECISION_CANDIDATE_002.json'")
change("schema='pro2_pro3_bootstrap_observation_decision_v1', scope=request['scope']", "schema='Root_proposed_bootstrap_peer_decision_candidate_v1', scope=request['scope']")
change("decision='CONDITIONALLY_ACCEPT_ONE_PRO3_BOOTSTRAP004_ONLY', accepted=True, released=True", "decision='CANDIDATE_NOT_AN_OPERATIVE_PEER_DECISION', accepted=False, released=False")
change("helper_invocations_granted=1, controller_mode_invocations_granted=4, Pro3_bootstrap004_only_conditionally_admitted=True, bounded_cleanup_after_pause_admitted=True", "helper_invocations_granted=0, controller_mode_invocations_granted=0, Pro3_bootstrap004_only_conditionally_admitted=False, bounded_cleanup_after_pause_admitted=False, prospective_permission=prospective, complete_candidate_writer001_inverse=inverse_pin, refused_candidate001=old_candidate_pin, refused_metadata_writer001=old_writer_pin, genuine_candidate001_refusal=refusal_pin")
change("R / 'decision004_creation_different_review_001'", "R / 'decision004_creation_different_review_002'")
oldguard="need(v['accepted'] is v['released'] is v['bounded_cleanup_after_pause_admitted'] is True and v['helper_invocations_granted'] == 1 and v['controller_mode_invocations_granted'] == 4 and v['remaining_actionable_Source_findings'] == [], 'only the reviewed exact conditional P3 bootstrap permission')"
newguard="need(v['schema'] == 'Root_proposed_bootstrap_peer_decision_candidate_v1' and v['accepted'] is v['released'] is v['bounded_cleanup_after_pause_admitted'] is False and v['helper_invocations_granted'] == 0 and v['controller_mode_invocations_granted'] == 0 and v['Pro3_bootstrap004_only_conditionally_admitted'] is False and v['prospective_permission'] == prospective and v['complete_candidate_writer001_inverse'] == inverse_pin and v['refused_candidate001'] == old_candidate_pin and v['refused_metadata_writer001'] == old_writer_pin and v['genuine_candidate001_refusal'] == refusal_pin and v['remaining_actionable_Source_findings'] == [], 'candidate mechanically ineligible; exact prospective once-permission and full refusal lineage genuinely reviewed')"
change(oldguard,newguard)
change("v = dict(v, record_is_candidate=False, observed_utc=fresh(True)", "v = dict(v, **prospective, record_is_candidate=False, observed_utc=fresh(True)")
lineage="""fresh()
# All prior001 bytes/refusal remain immutable; candidate002 itself cannot pass an operative schema/released gate.
old_writer_pin = {oldwriter!r}
old_candidate_pin = {oldcandidate!r}
inverse_pin = {inverse!r}
refusal_pin = {refusal!r}
for lineage_fact in [old_writer_pin, old_candidate_pin, inverse_pin, refusal_pin]:
    need(pin(lineage_fact['path']) == lineage_fact, 'exact complete refused001 lineage')
inverse, _ = doc(inverse_pin['path'], inverse_pin)
import base64
for item in inverse['complete_predecessors']:
    need(base64.b64decode(item['base64'], validate=True) == raw(item['path']), 'complete predecessor reconstruction')
prospective = dict(schema='pro2_pro3_bootstrap_observation_decision_v1', decision='CONDITIONALLY_ACCEPT_ONE_PRO3_BOOTSTRAP004_ONLY', accepted=True, released=True, helper_invocations_granted=1, controller_mode_invocations_granted=4, Pro3_bootstrap004_only_conditionally_admitted=True, bounded_cleanup_after_pause_admitted=True)
audit_pin =""".format(oldwriter=pin(oldsource,oldb),oldcandidate=pin(oldcandidate,oldc),inverse=invpin,refusal=refpin)
change('fresh()\naudit_pin =',lineage)
ast.parse(source,filename='own_metadata_writer002')
outsource=save('prepare_or_adopt_bootstrap004_once_peer_decision_002.py',source.encode('utf-8'))
reconstructed=source
for edit in reversed(edits):
    need(reconstructed.count(edit['after'])==1,'unique inverse ownsource edit')
    reconstructed=reconstructed.replace(edit['after'],edit['before'],1)
need(reconstructed.encode()==oldb,'whole ownwriter001 inverse')
receipt=dict(record_type='Root_candidate002_metadata_Source_authoring_receipt',created_utc=fresh(),author_Source=pin(Path(__file__)),new_metadata_writer_Source=outsource,complete001_inverse=invpin,genuine001_refusal=refpin,exact_edits=edits,whole_001_Source_inverse_verified=True,new_own_Source_AST_only_verified=True,subject_PS_or_runtime_operation=False,candidate002_not_yet_prepared=True,actual_peer_decision_not_issued=True)
receiptpin=save('ROOT_PRO3_BOOTSTRAP004_METADATA_WRITER002_AUTHOR_RECEIPT_001.json',(json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
print(json.dumps(dict(new_writer=outsource,complete001_inverse=invpin,author_receipt=receiptpin,no_candidate_or_writer_executed_by_author=True)))
