def save(p,v):
 raw=(json.dumps(v,sort_keys=True,ensure_ascii=True,indent=2,allow_nan=False)+'\n').encode('ascii');assert len(raw)<=2097152 and not os.path.lexists(p)
 assert(datetime.datetime.fromisoformat('2026-10-25T18:03:03.861408+00:00')-datetime.datetime.now(datetime.timezone.utc)).total_seconds()>60
 with p.open('xb')as h:h.write(raw);h.flush();os.fsync(h.fileno())
 assert p.read_bytes()==raw
 return pin(p,raw)
