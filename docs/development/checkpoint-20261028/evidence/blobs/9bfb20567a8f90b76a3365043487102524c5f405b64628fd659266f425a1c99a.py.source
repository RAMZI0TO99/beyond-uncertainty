"""Root adopt genuinely reviewed Source007 for contract preparation only."""
import base64,datetime as dt,hashlib,json,math,os,sys
from pathlib import Path
R=Path(__file__).parent
def need(v,m):
 if not v:raise ValueError(m)
def raw(path):
 path=Path(path)
 for p in (path,*path.parents):need(not p.is_symlink() and not getattr(p.lstat(),'st_file_attributes',0)&1024,'ordinary nonreparse lineage')
 a=path.stat();need(path.is_file() and a.st_nlink==1 and a.st_size<=2097152,'unchanged2MiB metadata cap')
 with path.open('rb') as f:b=f.read(2097153)
 z=path.stat();need(len(b)<=2097152 and len(b)==a.st_size==z.st_size and a.st_ino==z.st_ino and a.st_mtime_ns==z.st_mtime_ns,'stable bounded bytes');return b
def pin(path):
 b=raw(path);return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def doc(path,sha=None):
 b=raw(path);p=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if sha:need(p['sha256']==sha,'exact review/evidence pin')
 def pairs(rows):
  result={}
  for k,v in rows:need(k not in result,'duplicate JSON key');result[k]=v
  return result
 def finite(x):
  v=float(x);need(math.isfinite(v),'finite JSON number');return v
 value=json.loads(b,object_pairs_hook=pairs,parse_float=finite,parse_constant=lambda x:(_ for _ in()).throw(ValueError('nonfinite JSON')))
 return value,p
need(len(sys.argv)==3,'exact different Source007 capsule path and SHA')
cp=Path(sys.argv[1]);need(cp.is_relative_to(R),'own capsule containment');c,cf=doc(cp,sys.argv[2])
f,ff=doc(c['full_proof']['path'],c['full_proof']['sha256']);need(ff==c['full_proof'],'complete different review proof')
need(c['reviewer']==f['reviewer']=='/root/i13_final_review' and c['verdict']==f['verdict'] and c['verdict'].startswith('PASS_') and c['remaining_actionable_findings']==[],'genuine different all-clear Source review')
checks=f['checks'];need(len(checks)==len({x['name'] for x in checks})==c['checks_passed']==f['checks_passed'] and c['checks_failed']==f['checks_failed']==0 and all(x['passed'] is True for x in checks),'complete unique all-pass checks')
s,sp=doc(R/'ROOT_CURRENT_I13_RAW_INPUT_RETENTION_SOURCE_SCOPE_007.json','e203fe614b01e19b4ecc6632ff77ddebc8c812a88dae46aba4bd3643454563f5')
need(c['Source_scope']==sp,'exact independently reviewed scope')
inv,ip=doc(R/'ROOT_I13_SOURCE_SCOPE007_COMPLETE006_PREDECESSOR_INVERSE_001.json','c9f1944ab38a69a58c2923044464bdbbed2ba070806b2f858ce5ad2ffa1ece35')
b=base64.b64decode(inv['complete_predecessor_base64'],validate=True);need(base64.b64encode(b).decode()==inv['complete_predecessor_base64'] and len(b)==inv['complete_predecessor']['bytes'] and hashlib.sha256(b).hexdigest()==inv['complete_predecessor']['sha256'] and raw(inv['complete_predecessor']['path'])==b and inv['proposed_successor']==sp,'complete unchanged predecessor inverse')
w,wp=doc(s['current_workspace_refresh']['path'],s['current_workspace_refresh']['sha256']);need(wp==s['current_workspace_refresh'] and w['repository_baseline_pins_verified']==418 and w['status_identity_count']==409 and w['working_Source_and_evidence_pins_verified']==60,'fresh unchanged workspace evidence')
for key in ('target_execution','operational_authority','scientific_authority','new_target_Source_authoring_admitted','new_fixture_or_test_Source_authoring_admitted','new_raw_retention_operation_admitted','new_synthetic_or_test_call_admitted','builder_or_fixture_calls_admitted','raw_capture_admitted','Native8','Parser','runtime','actual6','science','actual_family_publication','new_operational_execution_lease_issued'):need(s[key] is False,'held scope boundary '+key)
need(s['publication_reserve_seconds']==60 and s['maximum_local_agents_including_Root']==3 and s['maximum_shared_including_both_roots_and_overlap']==5 and s['metadata_only_cap_bytes']==2097152 and s['implementation_blockers_remain']==11,'original reserve/caps/agents/blockers')
now=dt.datetime.now(dt.timezone.utc)
v=dict(schema_version=1,record_type='Root_Source007_different_review_adoption_contract_preparation_only',author='/root',created_utc=now.isoformat(),Source_scope=sp,genuine_different_review=cf,full_proof=ff,checks_passed=len(checks),checks_failed=0,workspace_refresh=wp,complete006_inverse=ip,interval_start=s['interval_start'],interval_end=s['interval_end'],
 Root_decision='Adopt exact Source007 for bounded read/hash/strict JSON/AST and raw-input retention contract/schema/plan authoring plus independent review and WORK-only closeout. All acquisition, builder/fixture/validator/target calls, target/fixture implementation, tests and operational/publication/native/Parser/runtime/science gates remain held. The old006 endpoint is unchanged and expired; this is a fresh Source-only window, not an execution lease.',
 contract_preparation_and_review_adopted=True,raw_acquisition_admitted=False,new_builder_fixture_target_calls_admitted=False,new_target_or_fixture_Source_authoring_admitted=False,new_tests_admitted=False,implementation_protocol_adopted=False,compact_ABI_status='NOT_READY',implementation_blockers_remain=11,actual_family_publication=False,primary_six_document_publication=False,Git_commit_or_push_admitted=False,prior_scopes_or_leases_extended=False,new_operational_execution_lease_issued=False,Native8=False,Parser=False,runtime=False,science=False,target_execution=False,operational_authority=False,scientific_authority=False,adopter_Source=pin(Path(__file__)))
out=R/'ROOT_I13_SOURCE_SCOPE007_DIFFERENT_REVIEW_ADOPTION_001.json';b=(json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();need(len(b)<=2097152 and not os.path.lexists(out),'unused bounded adoption identity')
commit=dt.datetime.now(dt.timezone.utc);need(dt.datetime.fromisoformat(s['interval_start'])<=commit and (dt.datetime.fromisoformat(s['interval_end'])-commit).total_seconds()>60,'fresh current interval and strict60reserve at final write')
with out.open('xb') as h:need(h.write(b)==len(b),'completeCreateNew');h.flush();os.fsync(h.fileno())
need(raw(out)==b,'whole adoption readback');print(json.dumps(dict(adoption=pin(out),Source_window_end=s['interval_end'],raw_acquisition_admitted=False,all_execution_gates_held=True)))
