"""Own metadata-only C0-free annex successor; no target code loaded."""
import base64
import datetime as dt
import hashlib
import json
from pathlib import Path
ROOT=Path(__file__).parent
OUT=ROOT/'m3_peer_contracts_016'/'canonical_peer_protocol_audit_001'
def pin(path):
    raw=Path(path).read_bytes();assert 0<len(raw)<=2097152
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
old=OUT/'I13_PROPOSED_EXACT_FIXED_INVENTORY_SINGLE_DESCRIPTIVE_LF_ANNEX_001.json'
v=json.loads(old.read_bytes())
value=v['exact_exception'].pop('exact_descriptive_value')
v['exact_exception']['exact_descriptive_value_utf8_base64']=base64.b64encode(value.encode('utf8')).decode('ascii')
v['created_utc']=dt.datetime.now(dt.timezone.utc).isoformat()
v['previous_complete_annex']=pin(old)
v['author_tool']=pin(Path(__file__))
v['normative_rule'].append('The annex itself is C0-free: descriptive witness bytes are ASCII Base64, strict decode yields exact367-byte/10LF/hash leaf. This data encoding grants no exception to the annex, historical audit/finding records, metadata tools, proof contexts or arbitrary body. Background evidence pins are provenance metadata, not automatic recursively designated schemas or input-authority edges.')
def controls(x):
    if type(x)is str:return any(ord(z)<32 for z in x)
    if type(x)is list:return any(controls(z)for z in x)
    if type(x)is dict:return any(controls(k)or controls(z)for k,z in x.items())
    return False
assert not controls(v)
raw=(json.dumps(v,sort_keys=True,indent=2)+'\n').encode();assert len(raw)<=2097152
p=OUT/'I13_PROPOSED_EXACT_FIXED_INVENTORY_SINGLE_DESCRIPTIVE_LF_ANNEX_002.json'
with p.open('xb')as stream:stream.write(raw)
print(json.dumps(pin(p),sort_keys=True))
