"""Retain only this reviewer's own pre-output assertion correction history."""
from pathlib import Path
import datetime as dt,hashlib,json,os
D=Path(__file__).parent
def fact(p,b):return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
rows=[]
for i in range(1,5):
 p=D/('review_contract001_adopter002_combined_%03d.py'%i);b=p.read_bytes();rows.append(fact(p,b))
full=D/'INDEPENDENT_I13_RAW_RETENTION_CONTRACT001_PLAN001_ADOPTER002_DESIGN_FULL_PROOF_001.json'
cap=D/'INDEPENDENT_I13_RAW_RETENTION_CONTRACT001_PLAN001_ADOPTER002_DESIGN_CAPSULE_001.json'
proof=json.loads(full.read_bytes());capsule=json.loads(cap.read_bytes())
assert proof['checks_passed']==capsule['checks_passed']==175 and proof['checks_failed']==capsule['checks_failed']==0
assert len(proof['checks'])==len({r['name']for r in proof['checks']})==175 and all(r['passed']is True for r in proof['checks'])
assert capsule['full_proof']==fact(full,full.read_bytes())
record=dict(schema_version=1,record_type='Independent_I13_own_review_checker_pre_output_assertion_history',reviewer='/root/i13_final_review',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),checker_Sources=rows,
 attempts=[dict(Source_version=1,tool_chunk='f5275b',exit_code=1,outputs_written=0,reason='Own checker compared the narrative contract operation description with the transport operation enum. Subject documents already distinguish those fields correctly.'),dict(Source_version=2,tool_chunk='b8bfa8',exit_code=1,outputs_written=0,reason='Own call classifier treated a builtin rsplit of data-only m3.I2_SOURCE[path] as a module export. Source inspection found only that string method, no module export.'),dict(Source_version=3,tool_chunk='00b1e2',exit_code=1,outputs_written=0,reason='Own exact call-multiplicity check expected one occurrence while preserved Source has two identical builtin path.rsplit calls. No subject change or call.'),dict(Source_version=4,tool_chunk='f670b4',exit_code=0,outputs_written=2,checks_passed=175,checks_failed=0,reason='Own checks use the exact operation enum and the two actual data-only path string method calls. All subject bytes and all other checks remained unchanged.')],
 whole_original_subject_bytes_changed=False,subject_failure_claimed=False,original_checker_Sources_preserved=True,author_or_project_helpers_invoked=False,raw_acquisition=False,target_execution=False,tests_executed=False,native_queries=False,implementation_authority=False,full_proof=fact(full,full.read_bytes()),capsule=fact(cap,cap.read_bytes()),ready_for_execution=False)
b=(json.dumps(record,sort_keys=True,indent=2,ensure_ascii=True,allow_nan=False)+'\n').encode('ascii')
assert len(b)<2097152 and(dt.datetime.fromisoformat('2026-10-27T14:27:32.449418+00:00')-dt.datetime.now(dt.timezone.utc)).total_seconds()>60
p=D/'INDEPENDENT_I13_COMBINED_REVIEW_OWN_CHECKER_ASSERTION_HISTORY_001.json'
with p.open('xb')as h:assert h.write(b)==len(b);h.flush();os.fsync(h.fileno())
assert p.read_bytes()==b
print(json.dumps(fact(p,b)))
