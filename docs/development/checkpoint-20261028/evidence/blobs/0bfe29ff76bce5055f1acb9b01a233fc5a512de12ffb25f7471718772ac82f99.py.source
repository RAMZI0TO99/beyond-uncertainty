M=C/'m3_protocol_audit_001';P=C/'canonical_peer_protocol_audit_001'
checks=[]
def check(ok,name,evidence):
 assert ok,name
 checks.append(dict(name=name,passed=True,evidence=evidence))
def pin(p):
 b=p.read_bytes();return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pairs(rows):
 d={}
 for k,v in rows:
  assert k not in d,'duplicate JSON name';d[k]=v
 return d
def bad(s):raise ValueError('noninteger JSON number '+s)
def load(p,expected=None):
 q=pin(p);check(q['bytes']<=2097152,'metadata_cap_'+p.name,q)
 if expected is not None:check(q['sha256']==expected,'exact_SHA_'+p.name,q)
 return json.loads(p.read_bytes().decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def save(p,v):
 raw=(json.dumps(v,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(raw)<=2097152
 with p.open('xb') as h:assert h.write(raw)==len(raw)
 return pin(p)
