"""Create corrected complete JSON proposal/catalogue; no target Source entry."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).parent
ROOT = Path(r'D:\Aenv\pro2')
W2 = ROOT / r'WORK\resume-20261025-002\receipt_caller_integration_015'

def pin(path):
    raw = path.read_bytes()
    return {'path': str(path), 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}

def read(path):
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise ValueError('duplicate key')
            result[key] = value
        return result
    def reject(value):
        raise ValueError('noninteger token ' + value)
    return json.loads(path.read_bytes(), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)

def save(name, value):
    raw = (json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    if len(raw) > 2097152:
        raise ValueError('metadata cap')
    with (HERE / name).open('xb') as handle:
        handle.write(raw)
    if (HERE / name).read_bytes() != raw:
        raise ValueError('readback')
    return pin(HERE / name)

def schema(fields):
    return {'builtin_type': 'dict', 'additional_fields_allowed': False,
            'exact_keys': list(fields), 'field_count': len(fields), 'fields': fields}

def lit(value):
    return {'builtin_type': type(value).__name__, 'literal': value}

def structural(value):
    if type(value) is dict:
        return schema({key: structural(child) for key, child in value.items()})
    if type(value) is list:
        return {'builtin_type': 'list', 'exact_length': len(value), 'items_by_ordinal': [structural(child) for child in value]}
    if type(value) is str:
        return {'builtin_type': 'str', 'maximum_length': 2097152, 'no_C0_or_surrogates': True}
    return lit(value)

def literal_constants(path):
    result = {}
    for node in ast.parse(path.read_bytes(), filename=str(path)).body:
        if not isinstance(node, ast.Assign):
            continue
        value = node.value
        if isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id in ('frozenset', 'set') and len(value.args) == 1 and not value.keywords:
            try:
                value = sorted(ast.literal_eval(value.args[0]))
            except (ValueError, TypeError):
                continue
        else:
            try:
                value = ast.literal_eval(value)
            except (ValueError, TypeError):
                continue
        for target in node.targets:
            if isinstance(target, ast.Name):
                result[target.id] = value
    return result

