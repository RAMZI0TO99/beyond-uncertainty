add('F01_constructor_full_extended_subject_not_fact3','E_PIN',label='constructor_full',variant='extended_subject')
for field in ('name','passed','evidence'):
    add('F01_constructor_check3_missing_'+field,'E_REVIEW',label='constructor_full',variant='check_missing',field=field)
for variant,error in (('unknown','E_REVIEW'),('name_empty','E_REVIEW'),('name512',None),('name513','E_REVIEW'),('name_bool','E_REVIEW'),('passed_false','E_REVIEW'),('passed_int','E_REVIEW'),('duplicate','E_REVIEW')):
