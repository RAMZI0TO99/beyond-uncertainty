"""
assert text.count(needle)==1;text=text.replace(needle,replacement,1)
raw=text.encode('utf8');assert len(raw)<=2097152
nt=ast.parse(raw);compile(raw,str(PREP/'I13_PEER004_STANDALONE_AUTHORED_SOURCE_001.py.source'),'exec',dont_inherit=True)
newcat=ast.literal_eval(next(n.value for n in nt.body if isinstance(n,ast.Assign)and any(isinstance(z,ast.Name)and z.id=='CASE_CATALOGUE'for z in n.targets)))
assert newcat==cases and cases[:504]==ast.literal_eval(catalog_node.value)
