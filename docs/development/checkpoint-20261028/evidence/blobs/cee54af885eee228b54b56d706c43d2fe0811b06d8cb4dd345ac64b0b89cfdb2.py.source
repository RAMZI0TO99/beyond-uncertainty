contexts=ast.literal_eval(next(n.value for n in kernel_tree.body if isinstance(n,ast.Assign)and any(isinstance(z,ast.Name)and z.id=='I13_OPERATIVE_AUTHOR_CONTEXTS'for z in n.targets)))
