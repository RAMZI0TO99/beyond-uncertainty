assert not PREP.exists();PREP.mkdir()
source_path=PREP/'I13_PEER004_STANDALONE_AUTHORED_SOURCE_001.py.source'
with source_path.open('xb')as f:f.write(raw)
def save(path,value):
    body=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=True)+'\n').encode();assert len(body)<=2097152
    with path.open('xb')as f:f.write(body)
    return pin(path,body)
catalogue=save(PREP/'I13_PEER004_STANDALONE_LITERAL_CASES_001.json',dict(schema_version=1,record_type='I13_peer004_standalone_authored_case_preparation_not_final',author='/root/i2_resume_gap',Source=pin(source_path,raw),cases=cases,case_count=len(cases),new_case_count=len(new_cases),names_json_sha256=hashlib.sha256(json.dumps([row['name']for row in cases],separators=(',',':')).encode()).hexdigest(),pending='Final new outer helper copy and five canonical-peer publisher positives; target004 remains absent.',tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False))
print(json.dumps(dict(Source=pin(source_path),catalogue=catalogue,standalone_case_count=len(cases),new_cases=len(new_cases),target_calls=0),sort_keys=True))
