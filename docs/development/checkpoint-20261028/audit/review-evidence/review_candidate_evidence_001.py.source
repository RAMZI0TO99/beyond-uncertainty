need('not a complete transitive dependency closure' in idx['scope'] and 'Empty directories and filesystem identities are not reproduced' in idx['scope'], 'index portability limits disclosed')
allrows = []
for partno, part in enumerate(idx['parts'], 1):
    b = read(CAND / part['path'])
    need(pin(b) == {k:part[k] for k in ('bytes','sha256')}, 'part exact pin ' + str(partno))
    pobj = parse(CAND / part['path'])
    rows = pobj['files']
    need(pobj['part'] == partno and pobj['execution_authority'] is False, 'part identity and authority ' + str(partno))
    need(len(rows) == part['file_count'] and len(rows) <= 384, 'part record cap ' + str(partno))
    need(sum(r['bytes'] for r in rows) == part['logical_bytes'] <= 64*1024*1024, 'part byte cap ' + str(partno))
    allrows.extend(rows)
need(len(allrows) == idx['source_file_count'] and sum(r['bytes'] for r in allrows) == idx['source_logical_bytes'], 'part totals join')
origins = {str(Path(r['original_path'])).casefold():r for r in allrows}
need(len(origins) == len(allrows), 'unique original evidence identities')
expected = set()
tree_counts = []
for tree in idx['complete_selected_work_trees']:
    p = ROOT / 'WORK' / tree
    paths = [q for q in p.rglob('*') if q.is_file()]
    expected.update(str(q).casefold() for q in paths)
    tree_counts.append({'tree':tree,'file_count':len(paths),'logical_bytes':sum(q.stat().st_size for q in paths)})
    need(all(str(q).casefold() in origins for q in paths), 'complete selected tree ' + tree)
