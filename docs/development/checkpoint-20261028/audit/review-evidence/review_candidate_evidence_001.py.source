    need(good, 'exact source copy ' + str(n))
    if src.suffix.lower() in ('.py','.ps1','.bat','.cmd','.sh','.exe','.dll','.pyc'):
        need(dst.name.endswith(src.suffix.lower() + '.source'), 'inert executable suffix ' + str(n))
    source_rows.append({'original_path':str(src),'archive_path':row['archive_path'],**wanted,'exact_copy':good})
for row in external:
