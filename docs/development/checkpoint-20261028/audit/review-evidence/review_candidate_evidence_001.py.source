"""Independent content-only review; no project import, execution, or native queries."""
from pathlib import Path
import datetime as dt
import hashlib
import json
import os
import stat
from decimal import Decimal

HOME = Path('D:/Aenv/pro2/WORK/docs-publication-20261028-001')
CAND = HOME / 'candidate'
REVIEW = HOME / 'review-evidence'
ROOT = Path('D:/Aenv/pro2')
REPO = ROOT / 'github-portable-20261012-001'
BASE = Path('docs/development/checkpoint-20261028')
LIMIT = 2 * 1024 * 1024
checks = []
source_rows = []

def need(ok, label, detail=None):
    checks.append({'id': label, 'passed': bool(ok), 'detail': detail})

def read(p):
    s = p.lstat()
    if not stat.S_ISREG(s.st_mode) or p.is_symlink() or s.st_size > LIMIT:
        raise ValueError(('read boundary', str(p), s.st_size))
    b = p.read_bytes()
    if len(b) != s.st_size or p.read_bytes() != b:
        raise ValueError(('ordinary content read changed', str(p)))
    return b

def pin(b):
    return {'bytes': len(b), 'sha256': hashlib.sha256(b).hexdigest()}

def pairs(items):
    out = {}
    for key, val in items:
        if key in out:
            raise ValueError(('duplicate key', key))
        out[key] = val
    return out

def parse(p):
    return json.loads(read(p), object_pairs_hook=pairs, parse_float=Decimal,
                      parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))

def save(name, value):
    b = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True) + '\n').encode()
    if len(b) > LIMIT:
        raise ValueError(('review output cap', len(b)))
    p = REVIEW / name
    with p.open('xb') as f:
        f.write(b)
        f.flush()
        os.fsync(f.fileno())
    if read(p) != b:
        raise ValueError('proof readback')
    return {'path': str(p), **pin(b)}

scope = parse(HOME / 'PUBLICATION_SCOPE.json')
need(dt.datetime.now(dt.timezone.utc) < dt.datetime.fromisoformat(scope['end_utc']) - dt.timedelta(seconds=60), 'fresh documentation scope reserve')
need(scope['user_request'] == 'push to the repo after you update the docs and the handoff', 'exact current human publication request')
need(scope['Root_max_agents'] == 3 and scope['peer_reserved'] == 2 and scope['shared_max'] == 5, 'unchanged agent allocation')
need(scope['subject_execution_or_test_or_capture_or_native_or_science_authorized'] is False and scope['Source015_adopted'] is False and scope['old_Source_windows_extended'] is False, 'scope remains publication only')

manifest = parse(HOME / 'CANDIDATE.json')
listed = {r['path']: r for r in manifest['files']}
need(len(listed) == len(manifest['files']), 'unique candidate manifest paths')
actual = {p.relative_to(CAND).as_posix() for p in CAND.rglob('*') if p.is_file()}
need(actual == set(listed), 'complete candidate manifest roster')
for rel, row in listed.items():
    p = (CAND / rel).resolve()
    need(p.is_relative_to(CAND.resolve()), 'candidate path containment ' + rel)
    need(pin(read(p)) == {k:row[k] for k in ('bytes','sha256')}, 'candidate byte pin ' + rel)

idxpath = CAND / BASE / 'evidence-index.json'
