"""Root exact saved pre-invocation review adoption, without target entry."""
import datetime,hashlib,json,os
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publication_implementation_009');CAP=2097152
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 b=raw(q['path']);assert type(q['bytes']) is int and len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
cp=fact(P/'independent_review_001/INDEPENDENT_I6_FRESH_MEMORY_SCOPE_PREINVOCATION_SOURCE_CAPSULE_001.json');assert cp['sha256']=='0400b94d4a127aad96570abeeaaf4b114b0384274bd653c9054581d4f1d15ad9'
c=json.loads(pin(cp));f=json.loads(pin(c['full_proof']));pin(c['reviewer_Source'])
for x in (c,f):assert x['reviewer']=='/root/owner_source_review' and type(x['checks_failed']) is int and x['checks_failed']==0 and x['target_execution'] is False and x['tests_executed'] is False
assert len(f['checks'])==61 and len({q['name'] for q in f['checks']})==61 and all(q['passed'] is True for q in f['checks'])
inputs=f['all_actual_inputs'];assert len(inputs)==14 and len({q['path'] for q in inputs})==14
for q in inputs:pin(q)
scopepin=fact(P/'ROOT_I6_ONCE_SYNTHETIC_MEMORY_TEST_SCOPE_001.json');s=json.loads(pin(scopepin));assert scopepin in inputs
assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(s['interval_end'])
for k in ('consumption_marker_name','supervisor_marker_name','saved_result_name','supervisor_result_name','child_stdout_name','child_stderr_name'):assert not (P/s[k]).exists()
x=dict(schema_version=1,record_type='Root_actual_exact_I6_fresh_one_use_memory_scope_preinvocation_Source_review_adoption',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),verdict='ACCEPT_EXACT_ONCE_I6_NEW_PURE_METADATA_MEMORY_SCOPE_ONLY',scope=scopepin,different_Source_review=cp,full_proof=c['full_proof'],reviewer_Source=c['reviewer_Source'],actual_named_checks=61,all14_actual_review_inputs_rehashed=True,all6_one_use_outputs_absent=True,supervisor=s['exact_supervisor_Source'],child_runner=s['exact_child_runner'],expected_case_count=55,maximum_invocations=1,automatic_retry_authorized=False,tests_executed=False,target_execution=False,original_project_native_Parser_runtime_scientific_execution_authorized=False,operational_authority=False,scientific_authority=False)
p=P/'ROOT_I6_FRESH_MEMORY_SCOPE_PREINVOCATION_REVIEW_ADOPTION_001.json';b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
print(json.dumps(fact(p)))
