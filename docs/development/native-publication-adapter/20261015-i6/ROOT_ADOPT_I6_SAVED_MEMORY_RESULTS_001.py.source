"""Root saved-outcome review adoption; no target imports, calls, or retries."""
import ast,datetime,hashlib,json,os,sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publication_implementation_009');CAP=2097152
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<=q['bytes']<=CAP
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise AssertionError(v)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def save(n,x):
 b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP;p=P/n
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 return fact(p)
def main():
 assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
 cp=fact(P/'independent_review_001'/sys.argv[1]);assert cp['sha256']==sys.argv[2];c=obj(pin(cp))
 assert c['reviewer']=='/root/owner_source_review' and c['target_execution'] is False and c['verdict'].startswith(('PASS_','ACCEPT_'))
 assert type(c['checks_failed']) is int and c['checks_failed']==0
 fp=c['full_proof'];f=obj(pin(fp));rp=c['reviewer_Source'];pin(rp)
 assert f['reviewer']==c['reviewer'] and f['target_execution'] is False and f['tests_executed'] is False
 assert type(f['checks_failed']) is int and f['checks_failed']==0 and type(f['I6_fixture_reruns']) is int and f['I6_fixture_reruns']==0
 checks=f['checks'];assert checks and len({q['name'] for q in checks})==len(checks) and all(q['passed'] is True for q in checks)
 review_inputs=f['all_actual_inputs'];assert review_inputs and len({q['path'] for q in review_inputs})==len(review_inputs)
 for q in review_inputs:pin(q)
 scopepin=fact(P/'ROOT_I6_ONCE_SYNTHETIC_MEMORY_TEST_SCOPE_001.json');s=obj(pin(scopepin))
 resultpin=fact(P/s['saved_result_name']);r=obj(pin(resultpin));superpin=fact(P/s['supervisor_result_name']);supervisor=obj(pin(superpin))
 assert resultpin in review_inputs and superpin in review_inputs and scopepin in review_inputs
 assert r['scope']==scopepin==supervisor['scope'] and r['adapter_Source']==s['adapter_Source'] and r['fixture_Source']==s['fixture_Source']
 assert r['actual_Source_adoption']==s['actual_final_Source_adoption']
 for q in (s['adapter_Source'],s['fixture_Source'],s['actual_final_Source_adoption'],s['exact_child_runner'],s['exact_supervisor_Source']):pin(q)
 assert r['tests_executed'] is True and type(r['I6_memory_test_runs']) is int and r['I6_memory_test_runs']==1 and r['synthetic_memory_only'] is True
 assert r['all_cases_passed'] is True and r['error'] is None and r['original_project_native_Parser_runtime_scientific_execution'] is False and r['actual_publisher_filesystem_action'] is False
 assert type(r['elapsed_integer_nanoseconds']) is int and 0<r['elapsed_integer_nanoseconds']<=60000000000 and r['blocked_forbidden_event_names']==[]
 assert set(r['profile_call_counts'])=={s['adapter_Source']['path'],s['fixture_Source']['path']} and all(type(v) is int and v>0 for v in r['profile_call_counts'].values())
 tree=ast.parse(pin(s['fixture_Source']));literals={}
 for n in tree.body:
  if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('PLANNED_CASE_NAMES','EXPECTED_CASE_COUNT'):literals[n.targets[0].id]=ast.literal_eval(n.value)
 assert literals['EXPECTED_CASE_COUNT']==s['expected_planned_case_count']==55 and type(literals['EXPECTED_CASE_COUNT']) is int
 o=r['outcome'];cases=o['cases'];names=[q['name'] for q in cases]
 assert type(cases) is list and type(r['actual_test_case_count']) is int and r['actual_test_case_count']==len(cases)==55
 assert names==list(literals['PLANNED_CASE_NAMES']) and len(set(names))==55 and all(q['passed'] is True and type(q['subject_body_reader_calls']) is int and q['subject_body_reader_calls']==0 for q in cases)
 assert type(o['subject_body_reader_calls']) is int and o['subject_body_reader_calls']==0 and o['synthetic_fixture'] is True and o['project_or_native_tests'] is False
 assert type(o['checks_failed']) is int and o['checks_failed']==0 and type(o['checks_passed']) is int and o['checks_passed']==55
 assert supervisor['child_saved_result']==resultpin and supervisor['passed'] is True and supervisor['refusal'] is None and type(supervisor['owned_child_exit_code']) is int and supervisor['owned_child_exit_code']==0 and supervisor['owned_child_wait_reaped'] is True
 assert supervisor['wall_cap_seconds']==60 and supervisor['cleanup_reap_seconds']==5 and type(supervisor['elapsed_integer_nanoseconds']) is int and 0<supervisor['elapsed_integer_nanoseconds']<=65000000000
 assert supervisor['argv']==[r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe','-I','-S','-B',s['exact_child_runner']['path'],Path(scopepin['path']).name,scopepin['sha256']] and supervisor['cwd']==str(P)
 assert supervisor['original_project_native_Parser_runtime_scientific_execution'] is False
 for q in supervisor['streams']:pin(q)
 for q in (r['consumption_marker'],supervisor['supervisor_marker']):
  marker=obj(pin(q));assert marker['scope']==scopepin and marker['automatic_retry_authorized'] is False
 for stamp in (r['started_utc'],r['created_utc'],supervisor['started_utc'],supervisor['created_utc']):assert datetime.datetime.fromisoformat(s['interval_start'])<=datetime.datetime.fromisoformat(stamp)<datetime.datetime.fromisoformat(s['interval_end'])
 capturepin=fact(P/'ROOT_I6_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_001.json');capture=obj(pin(capturepin));assert capturepin in review_inputs and capture['supervisor_result']==superpin
 for e in capture['streams']:assert e['actual_capture'] in supervisor['streams'] and e['UTF8_text'].encode()==pin(e['actual_capture'])
 inputs=[];seen=set()
 for path in sorted(P.rglob('*'),key=lambda p:str(p)):
  if not path.is_file() or path.suffix not in ('.json','.py') or any(part.startswith('managed_') for part in path.relative_to(P).parts):continue
  q=fact(path);assert path.name not in seen;seen.add(path.name);inputs.append(q)
 assert cp in inputs and fp in inputs and rp in inputs and capturepin in inputs and fact(Path(__file__)) in inputs
 adoption=dict(schema_version=1,record_type='Root_actual_I6_pure_M3_metadata_implementation_and_saved_memory_results_adoption',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),verdict='ACCEPT_I6_PURE_METADATA_ADAPTER_AND_SAVED_MEMORY_RESULTS_ONLY',Source_adoption=s['actual_final_Source_adoption'],adapter_Source=s['adapter_Source'],fixture_Source=s['fixture_Source'],actual_memory_scope=scopepin,actual_memory_saved_result=resultpin,actual_memory_owned_supervisor_result=superpin,actual_owned_streams=capturepin,different_saved_results_review=cp,full_proof=fp,reviewer_Source=rp,actual_independent_saved_results_checks=len(checks),all_actual_saved_review_inputs_rehashed=True,actual_rehashed_saved_review_input_count=len(review_inputs),actual_memory_case_count=55,actual_memory_cases_passed=55,actual_memory_cases_failed=0,I6_memory_test_runs=1,tests_executed=True,synthetic_memory_only=True,no_measured_Source_body_reads=True,no_observed_forbidden_audit_events=True,observed_audit_boundary=r['audit_evidence_boundary'],owned_hidden_child_exit_code=0,owned_child_reaped=True,original_project_native_Parser_runtime_scientific_execution=False,actual_publisher_or_canonical_write=False,current_dated_Source_present=36,current_dated_pending=9,frozen_STEP080_present=35,frozen_STEP080_pending=10,all75_spent_no_replay_and_all_prior_holds_preserved=True,all_actual_new_lease_family_grant_paths_ordinals_purpose_native_Parser_results=None,operational_authority=False,scientific_authority=False,managed_evidence_inputs=inputs,managed_raw_stream_boundary='Exact saved UTF8 capture envelope copied; raw .txt streams retained at dated absolute provenance, not executable metadata-schema support pins.',next='Implement actual owner-v2 filesystem publisher and consumer bindings, Native8 support carrier and Parser saved-result adapter, then qualified I2/I3/I4/I5 successors under separate reviewed scopes.')
 print(json.dumps(save('ROOT_I6_M3_PUBLICATION_ADAPTER_AND_SAVED_MEMORY_RESULTS_ADOPTION_001.json',adoption)))
