ck('supervisor_one_wait5_unverified_cleanup_honest',supervisor.count('proc.wait(timeout=5)')==1 and all(t in supervisor for t in ('code=None;reaped=False','cleanup unverified','owned_child_wait_reaped=reaped')),None)
now=datetime.now(timezone.utc);start=datetime.fromisoformat(s['interval_start']);end=datetime.fromisoformat(s['interval_end']);source_end=datetime.fromisoformat(source_scope['interval_end'])
ck('Source_review_then_adoption_then_freshscope_chronology',datetime.fromisoformat(full['created_utc'])<=datetime.fromisoformat(a['created_utc'])<=start==datetime.fromisoformat(s['created_utc'])<=now,None)
ck('actual_fresh15min_inside_originalscope',end-start==timedelta(minutes=15) and end<=source_end and now+timedelta(seconds=120)<end,dict(actual_UTC=now.isoformat(),start=s['interval_start'],end=s['interval_end']))
