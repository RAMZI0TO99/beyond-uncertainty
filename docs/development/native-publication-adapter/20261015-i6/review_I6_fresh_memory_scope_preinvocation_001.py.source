ck('actual_Source_proof_strictzero_named_unique_true',type(full['checks_failed']) is int and full['checks_failed']==0 and len(full['checks'])==len({r['name'] for r in full['checks']})==236 and all(r['passed'] is True for r in full['checks']) and full['tests_executed'] is False and full['target_execution'] is False,None)
