ck('child_actual_outcomes_unique_typed_exactcount_and_zero_subject_reads',all(t in child for t in ("type(outcome['subject_body_reader_calls']) is int","outcome['subject_body_reader_calls']==0",'len(cases)==fixtures.EXPECTED_CASE_COUNT',"all(c['passed'] is True for c in cases)","len({c['name'] for c in cases})==len(cases)")),None)
