def pin(p):
    raw=p.read_bytes()
    return dict(path=str(p),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

def wire(value):return (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')

def save(p,raw):
    assert len(raw)<=2097152 and not p.exists()
    with p.open('xb') as f:f.write(raw)
    assert p.read_bytes()==raw
    return pin(p)

def literals(path):
    result={}
    for n in ast.parse(path.read_bytes()).body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            v=n.value
            if isinstance(v,ast.Call) and isinstance(v.func,ast.Name) and v.func.id=='frozenset' and len(v.args)==1 and not v.keywords:v=v.args[0]
            try:result[n.targets[0].id]=ast.literal_eval(v)
            except (ValueError,TypeError,SyntaxError):pass
    return result

