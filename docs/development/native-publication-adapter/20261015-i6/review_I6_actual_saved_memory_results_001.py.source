def pairs(rows):
 d={}
 for k,v in rows:
  if k in d:raise ValueError('duplicate JSON')
  d[k]=v
 return d
def bad(v):raise ValueError(v)
def read(p,external_empty_capture=False):
 p=Path(p);b=p.read_bytes();assert len(b)<=2097152 and (len(b)>0 or external_empty_capture)
 q=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 assert str(p) not in inputs or inputs[str(p)]==q
 inputs[str(p)]=q;return q,b
def obj(p):
 q,b=read(p);return q,json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def ck(name,passed,evidence=None):
