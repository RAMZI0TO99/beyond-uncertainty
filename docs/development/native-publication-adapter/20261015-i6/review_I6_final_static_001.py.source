def literal_definitions(path):
    f,b=read(path);tree=ast.parse(b);values={}
    for n in tree.body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            value=n.value
            if isinstance(value,ast.Call) and isinstance(value.func,ast.Name) and value.func.id=='frozenset' and len(value.args)==1:value=value.args[0]
            try:values[n.targets[0].id]=ast.literal_eval(value)
            except (ValueError,TypeError,SyntaxError):pass
    return f,values

def signatures(tree,label):
    defs={n.name:n for n in tree.body if isinstance(n,ast.FunctionDef)}
    inventory=[]
    for n in ast.walk(tree):
        if not isinstance(n,ast.Call) or not isinstance(n.func,ast.Name) or n.func.id not in defs:continue
        if any(isinstance(a,ast.Starred) for a in n.args) or any(k.arg is None for k in n.keywords):continue
        a=defs[n.func.id].args;pos=a.posonlyargs+a.args;names=[x.arg for x in pos];kw={k.arg for k in n.keywords}
        provided=set(names[:len(n.args)])|kw
        passed=(len(n.args)<=len(pos) or a.vararg is not None) and (not kw-set(names)-{x.arg for x in a.kwonlyargs} or a.kwarg is not None)
        passed=passed and all(x in provided for x in names[:len(pos)-len(a.defaults)]) and all(x.arg in kw for x,d in zip(a.kwonlyargs,a.kw_defaults) if d is None)
        inventory.append(dict(line=n.lineno,target=n.func.id,passed=passed))
    ck(label+':all_unexpanded_direct_global_call_signatures',all(r['passed'] for r in inventory),inventory)

