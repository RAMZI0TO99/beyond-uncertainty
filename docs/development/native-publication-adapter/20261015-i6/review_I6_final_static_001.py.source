"""Independent new-I6 Source audit; stdlib read/hash/JSON/AST only.

Does not import, compile, execute or test any target Source. Immutable completed
proofs are written only after every named predicate is true. Root's later actual
memory fixture invocation requires its separate adoption and one-use scope.
"""
import ast
import builtins
import hashlib
import json
from pathlib import Path
from datetime import datetime, timezone

P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publication_implementation_009')
O=P/'independent_review_001'
WHO='/root/owner_source_review'
INPUTS={}
CHECKS=[]
READINGS=[]

def pair(rows):
    d={}
    for k,v in rows:
        if k in d:raise ValueError('review input duplicate JSON key')
        d[k]=v
    return d

def reject(v):raise ValueError('review input floats/constants prohibited: '+v)

def read(p):
    p=Path(p);b=p.read_bytes()
    if not 0<len(b)<=2097152:raise ValueError('review input cap')
    f=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    if str(p) in INPUTS and INPUTS[str(p)]!=f:raise ValueError('input changed during review')
    INPUTS[str(p)]=f
    return f,b

def obj(p):
    f,b=read(p)
    return f,json.loads(b,object_pairs_hook=pair,parse_float=reject,parse_constant=reject)

def ck(name,condition,evidence=None):
    if type(condition) is not bool:raise TypeError('actual named check must be strict bool')
    if any(r['name']==name for r in CHECKS):raise ValueError('duplicate actual check name')
    CHECKS.append(dict(name=name,passed=condition,evidence=evidence))

def exact(pin,label):
    f,b=read(pin['path'])
    ck('actual_pin:'+label,type(pin) is dict and set(pin)=={'path','bytes','sha256'} and type(pin['bytes']) is int and f==pin,f)
    return b

def source(pin,label):
    b=exact(pin,label);text=b.decode('utf8','strict');tree=ast.parse(text,filename=pin['path'])
    defs={}
    for n in ast.walk(tree):
        if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef,ast.ClassDef)):
            s=ast.get_source_segment(text,n)
            defs.setdefault(n.name,[]).append(dict(kind=type(n).__name__,line=n.lineno,end_line=n.end_lineno,bytes=len(s.encode()),sha256=hashlib.sha256(s.encode()).hexdigest()))
    imports=[];calls=[]
    for n in ast.walk(tree):
        if isinstance(n,(ast.Import,ast.ImportFrom)):
            imports.append(dict(line=n.lineno,text=ast.get_source_segment(text,n)))
        if isinstance(n,ast.Call):
            calls.append(dict(line=n.lineno,target=ast.unparse(n.func),positional=len(n.args),keywords=[k.arg for k in n.keywords]))
    READINGS.append(dict(subject=pin,label=label,AST_only=True,definitions=defs,imports=imports,actual_callsite_inventory=calls))
    return text,tree

def function(tree,name):
    found=[n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef) and n.name==name]
    if len(found)!=1:raise ValueError('unique function expected: '+name)
    return found[0]

def region(text,tree,name):return ast.get_source_segment(text,function(tree,name))

def const(tree,name):
    found=[]
    for n in tree.body:
        if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets):found.append(n.value)
    if len(found)!=1:raise ValueError('unique literal constant expected: '+name)
    return ast.literal_eval(found[0])

def contains(text,terms):return all(t in text for t in terms)

def save(path,value):
    b=(json.dumps(value,ensure_ascii=False,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    if len(b)>2097152:raise ValueError('complete independent proof exceeds2MiB')
    with Path(path).open('xb') as h:h.write(b)
    return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

