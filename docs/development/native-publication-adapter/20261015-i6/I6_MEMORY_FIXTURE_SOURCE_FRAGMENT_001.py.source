def run_memory_suite(adapter_module):
    """Called once by separately admitted Root loader; all evidence here is synthetic."""
    m=adapter_module;outcomes=[];body_reads=[]
    def case(name,kind='batch',fault=None,refusal=None):
        expected,p4,p6,reader,calls,subjects,oracle=_make(m,fault)
        passed=False;actual=None
        try:
            if kind=='proof4':result=m.validate_proof4_metadata(proof4=p4,expected=expected,read_record=reader)
            elif kind=='proof6':result=m.validate_proof6_metadata(proof6=p6,expected=expected,read_record=reader)
            else:result=m.validate_batch_metadata(expected=expected,read_record=reader)
            if refusal is None:
                views=result if type(result) is tuple else (result,)
                wanted_roles=list(m.ROLE_ORDER) if kind=='batch' else [m.ROLE_ORDER[0]]
                representation={'batch':'ORIGINAL_BATCH_METADATA','proof6':'DIRECT_PROOF6_METADATA','proof4':'VERIFIED_PRIOR_RECONCILIATION_PROOF4_METADATA'}[kind]
                passed=[v.role for v in views]==wanted_roles and all(v.representation==representation and v.subject.to_dict()==oracle[v.role]['subject'] and
                    v.author_receipt.to_dict()==oracle[v.role]['author_receipt'] and v.facts.to_dict()==oracle[v.role]['facts'] and
                    v.metadata_only is True and v.operational_authority is False and v.scientific_authority is False and
                    v.native_authority is False and v.physical_observation_validated is False and v.canonical_write_performed is False and
                    v.producer_or_caller_qualification_established is False for v in views)
                if name=='immutable_detached_view':
                    view=views[0];before=view.subject.path;copy_pin=view.subject.to_dict();copy_pin['path']='MUTATED'
                    expected['subjects'][0]['canonical']['path']='MUTATED'
                    try:view[0]='MUTATED'
                    except TypeError:passed=passed and view.subject.path==before
                    else:passed=False
        except m.MetadataError as exc:
            actual=exc.code;passed=refusal==actual
        except BaseException as exc:actual=type(exc).__name__
        if fault in ('protected_selection','case_protected_selection','path_dot','path_ADS','pair_ordinal'):
            passed=passed and not calls
        passed=passed and not subjects;body_reads.extend(subjects)
        outcomes.append(dict(name=name,passed=bool(passed),expected_refusal_code=refusal,actual_refusal_code=actual,
                             metadata_reader_calls=len(calls),subject_body_reader_calls=len(subjects),synthetic_fixture=True))
    case('positive_original_batch')
    case('positive_direct_proof6','proof6')
    case('positive_reconciliation_proof4','proof4')
    case('immutable_detached_view')
    case('callback_pin_mutation_detached',fault='callback_mutates_pin')
    case('callback_expected_mutation_snapshot',fault='callback_mutates_expected')
    case('recorded_resource60_inclusive',fault='resource60')
    for name,fault,code,kind in __NEGATIVE_CASES__:
        case(name,kind,fault,code)
    passed=sum(c['passed'] for c in outcomes)
    return dict(synthetic_fixture=True,project_or_native_tests=False,cases=outcomes,case_count=len(outcomes),
                expected_case_count=EXPECTED_CASE_COUNT,checks_passed=passed,checks_failed=len(outcomes)-passed,
                unique_case_names=len({c['name'] for c in outcomes})==len(outcomes),
                subject_body_reader_calls=len(body_reads),filesystem_process_network_native_observation='EXTERNAL_ROOT_AUDIT_REQUIRED',
                note='Synthetic metadata predicates only; no actual publication, resource measurement, owner grant, Source body read, native or Parser qualification.')
