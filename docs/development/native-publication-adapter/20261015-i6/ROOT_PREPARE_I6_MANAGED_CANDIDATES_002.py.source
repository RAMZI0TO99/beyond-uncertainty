"""Prepare reviewed I6 pure metadata adapter and saved memory result development evidence; invoke no project helper."""
import datetime
import hashlib
import json
import os
from pathlib import Path

R = Path(r"D:\Aenv\pro2")
P = R / "WORK/resume-20261015-001/native_publication_implementation_009"
G = R / "github-portable-20261012-001"
C = R / "WORK/I6P009/c1"
REL = "docs/development/native-publication-adapter/20261015-i6/"
CAP = 2097152


def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_pin = fact(P / "ROOT_I6_M3_PUBLICATION_ADAPTER_AND_SAVED_MEMORY_RESULTS_ADOPTION_001.json")
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I6_PURE_METADATA_ADAPTER_AND_SAVED_MEMORY_RESULTS_ONLY"
    assert adoption["I6_memory_test_runs"] == 1 and adoption["tests_executed"] is True and adoption["original_project_native_Parser_runtime_scientific_execution"] is False
    scope_pin = fact(P / "ROOT_CURRENT_I6_PUBLICATION_METADATA_ADAPTER_SOURCE_SCOPE_001.json")
    assert scope_pin["sha256"] == "270773fd6dec2d81b517eaf04315fc2b55646103dbf701aa3416b0b8e02c297f"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    previous_scope_pin = fact(R / "WORK/resume-20261015-001/native_interface_implementation_008/managed_preparation_001/candidates_001/EXACT_MANAGED_I5_INTERFACE_IMPLEMENTATION_PUBLICATION_SCOPE_001.json")
    assert previous_scope_pin["sha256"] == "979a8e0de96cba1e329ec26e590a9e82e29d011eb5f1e6c150497dc4f2807fdd"
    previous = json.loads(pinned(previous_scope_pin))
    rows, evidence, names = [], [], set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = Path(pin["path"])
        assert path.resolve().is_relative_to(P.resolve())
        inert_source = path.suffix in (".py", ".ps1")
        name = path.name + (".source" if inert_source else "")
        assert Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": inert_source})
    add(REL + "evidence-index.json", {
        "schema_version": 1, "record_type": "I6_exact_pure_publication_metadata_Source_and_memory_evidence_index",
        "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
        "actual_evidence_copy_count": len(evidence), "files": evidence,
        "I6_new_metadata_library_memory_tests_executed": True, "original_helper_import_call_test_native_or_scientific_execution": False,
        "actual_Parser_grant_facts_result_or_family_created": False,
        "current_dated_Source_inventory": {"present": 36, "pending": 9},
        "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}})
    report = "# Finite-eight M3 publication metadata adapter\n\nRoot accepted the new pure metadata adapter after independent Source review, one separately scoped isolated memory-fixture run, and independent saved-results review. The [final Root adoption](ROOT_I6_M3_PUBLICATION_ADAPTER_AND_SAVED_MEMORY_RESULTS_ADOPTION_001.json) and [evidence index](evidence-index.json) pin the exact code, fixtures, outcomes and review. This qualifies the tested metadata component only. No real publication, selected family, lease, Native8 measurement or Parser result was created.\n\nThe adapter validates strict version2 batch request21/row10, publication43/published-row13 and separate reconciliation26 records. It follows the actual batch row author receipt to M3receipt22 and facts21. The generic single14/publication29 route has no M3 author-receipt slot and is explicitly unsupported for this use. Old Source024/022 records cannot become current authority through changed pins.\n\nA trusted caller must supply all eight canonical and draft identities before the first metadata callback. The adapter blocks protected-path reads, including conservative case variants, while preserving the original path/pin strings. It checks only designated metadata and trusted code-support bytes, never the eight Source bodies. It performs no filesystem, process, network or native action. Physical hardlinks/junctions/aliases and real observed native births remain caller obligations.\n\nReceipt metadata checks preserve actual Root physical serialization versus the separate selected helper Source editor, dynamic author/subtree exclusion, code Source/API/different proof/fullproof/direct Root coverage, scope/selection/lease joins, exact stage-purpose6 and recorded resource policy. Existing stage purpose support is exactly facts/different_review/Root_adoption: the purpose literal occurs in the receipt, capsule, fullproof and Root adoption. No standalone purpose document was invented. Actual I0/lease/producer admission, physical observations and full producer/caller bindings remain separate work.\n\nProof4 resolves verified-prior-publication reconciliation26 to the original batch publication. Proof6 points directly to that original publication and exact selected author receipt. Opaque execution-witness/API leaves are authenticated only by trusted pins and metadata proof coverage; the library does not infer PID/exit/process correctness. Reconciliation verifies an earlier real write and performs no canonical rewrite. The proof graph retains separate prepublication draft review and later canonical delta review before reconciliation.\n\nThe new library and fixture Source were reviewed before invocation. A fresh Root one-use memory scope then exercised only this new metadata component with synthetic in-memory records and poisoned Source-body callbacks. These are actual local metadata tests, not actual family/publication/native/Parser/runtime/scientific evidence. The API and initial author receipt retain their unrun creation snapshots; the separately saved outcomes and Root adoption record later metadata test execution. I0's earlier17 methods and every I0-I5/original project test remained unrun in this step.\n\nAll prior helpers, algorithm guards, execution holds and75 spent identities remain unchanged. Current dated Source inventory stays36/45 with nine pending; frozen STEP080 stays35/45 with ten pending. All608 historical managed byte rows, eight frozen sentinels and original36 Source bytes remain exact, with the nine pending canonical paths absent. The three navigation prepends retain complete earlier bytes.\n\nNext: implement and review the actual owner-v2 canonical publisher and consumer bindings using this metadata ABI, then the accepted Native8 support carrier, Parser saved-result adapter and qualifying I2/I3/I4/I5 successors. No boolean or successful fixture replaces that work or supplies real execution authority.\n\nCode and fixture programs are saved here as inert `.source` copies. Absolute original paths are dated provenance, not portable runtime bindings. Later Git publication is recorded by external Root receipts and repository history.\n"
    add(REL + "I6_PUBLICATION_METADATA_ADAPTER.md", report.encode())
    prefix = ("**October15 I6 pure publication adapter tested.** The [finite-eight metadata report](" + REL + "I6_PUBLICATION_METADATA_ADAPTER.md) records a reviewed batch/reconciliation adapter and separately scoped synthetic memory tests. It reads no measured Source bodies and grants no real publisher, family, lease, Native8, Parser or runtime authority. Existing caller/producer holds stay in place; actual writer/consumer binding is next. Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        old_bytes = pinned(predecessor)
        saved = save(P / "managed_preparation_001/predecessors_001" / name, old_bytes)
        source = save(C / name, prefix + old_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {
        "schema_version": 1, "record_type": "Root_exact_finite_I6_pure_metadata_adapter_and_memory_results_managed_publication_scope",
        "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "base_HEAD": "2d14827a048492df14d1d7c18adf9c90cf16b698",
        "managed_file_count": len(rows), "files": rows, "Root_implementation_adoption": adoption_pin,
        "preexisting608_byte_baseline": previous["preexisting608_byte_baseline"],
        "all_frozen_STEP080_sentinels": previous["all_frozen_STEP080_sentinels"],
        "current36_Source_baseline": previous["current36_Source_baseline"],
        "target_execution": False, "tests_executed": True, "I6_memory_test_runs": 1, "original_project_target_execution": False}
    print(json.dumps(save(P / "managed_preparation_001/candidates_001/EXACT_MANAGED_I6_PUBLICATION_ADAPTER_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
