def pin(path):
    p=Path(path);b=p.read_bytes();f={'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()};inputs[str(p)]=f;return f,b
def obj(path):
    f,b=pin(path);return f,json.loads(b)
def functions(path,names):
    f,b=pin(path);text=b.decode();tree=ast.parse(b);defs={n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
    rows=[]
    for name in names:
        node=defs[name];raw=b''.join(b.splitlines(keepends=True)[node.lineno-1:node.end_lineno])
        rows.append({'Source':f,'function':name,'line_start':node.lineno,'line_end':node.end_lineno,'whole_bytes':len(raw),'whole_sha256':hashlib.sha256(raw).hexdigest(),'actual_Source_text':raw.decode()})
    return f,rows
