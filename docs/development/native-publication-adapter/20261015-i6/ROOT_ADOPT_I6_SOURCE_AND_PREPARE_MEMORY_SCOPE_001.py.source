"""Root review adoption and fresh one-use synthetic memory scope; no target calls."""
import datetime, hashlib, json, os, sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publication_implementation_009')
CAP=2097152
def now():return datetime.datetime.now(datetime.timezone.utc)
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and 0<p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise AssertionError(v)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def save(name,x):
 b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP;p=P/name
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 return fact(p)
def main():
 assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
 authority_pin=fact(P/'ROOT_CURRENT_I6_PUBLICATION_METADATA_ADAPTER_SOURCE_SCOPE_001.json');a=obj(pin(authority_pin))
 assert now()+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(a['interval_end'])
 adoption_name='ROOT_I6_FINAL_ADAPTER_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json'
 if sys.argv[1]=='adopt':
  cp=fact(P/'independent_review_001'/sys.argv[2]);assert cp['sha256']==sys.argv[3];c=obj(pin(cp))
  assert c['reviewer']=='/root/owner_source_review' and c['source_author']=='/root/phase_frontier' and c['target_execution'] is False
  assert c['verdict'].startswith(('PASS_','ACCEPT_')) and c['checks_failed']==0
  fp=c['full_proof'];f=obj(pin(fp));rp=c['reviewer_Source'];pin(rp)
  assert f['checks_failed']==0 and f['reviewer']==c['reviewer'] and f['target_execution'] is False
  checks=f['checks'];assert checks and len({r['name'] for r in checks})==len(checks) and all(r['passed'] is True for r in checks)
  inputs=f['all_actual_inputs'];assert inputs and len({q['path'] for q in inputs})==len(inputs)
  for q in inputs:pin(q)
  subjects=c['subjects'];assert len(subjects)==4 and subjects==f['subjects']
  for q in subjects:pin(q);assert q in inputs
  expected={'validate_current_owner_M3_publication_metadata_002.py':'b1fa875d93e38727b494ae6a63d1319c03001ac153ae3dc2aca478892c24845a','test_current_owner_M3_publication_metadata_memory_only_002.py':'8b55b5b8345a3859322b2d6168336238e55b7d106fc06826c39605bf00b6bd3e','CURRENT_OWNER_M3_PUBLICATION_METADATA_INERT_API_002.json':'fc4363c20541add634522654f9f9195fa3333504b6b850c3decfaca0677c07f9','CURRENT_OWNER_M3_PUBLICATION_METADATA_ACTUAL_SOURCE_AUTHOR_RECEIPT_002.json':'2a7d3e82c89ae3c11209190765632a5dc927bb51c833171e96e6ee13ecc0b118'}
  assert {Path(q['path']).name:q['sha256'] for q in subjects}==expected
  print(json.dumps(save(adoption_name,dict(schema_version=1,record_type='Root_actual_I6_final_Source002_adapter_and_fixture_Source_review_adoption',author='/root',created_utc=now().isoformat(),scope=authority_pin,verdict='ACCEPT_I6_PURE_METADATA_ADAPTER_AND_FIXTURE_SOURCE_ONLY',subjects=subjects,different_Source_review=cp,full_proof=fp,reviewer_Source=rp,actual_named_checks=len(checks),all_actual_review_inputs_rehashed=True,actual_rehashed_input_count=len(inputs),tests_executed=False,target_execution=False,new_I6_tests_require_fresh_separate_Root_one_use_scope=True,actual_original_project_native_Parser_runtime_scientific_authority=False,all_future_lease_family_grant_paths_ordinals_purpose_native_Parser_results=None,operational_authority=False,scientific_authority=False))))
 elif sys.argv[1]=='scope':
  adoption=fact(P/adoption_name);ad=obj(pin(adoption));assert ad['verdict']=='ACCEPT_I6_PURE_METADATA_ADAPTER_AND_FIXTURE_SOURCE_ONLY'
  adapter=fact(P/'i6/validate_current_owner_M3_publication_metadata_002.py');fixture=fact(P/'i6/test_current_owner_M3_publication_metadata_memory_only_002.py')
  assert adapter in ad['subjects'] and fixture in ad['subjects'];start=now();end=min(start+datetime.timedelta(minutes=15),datetime.datetime.fromisoformat(a['interval_end']))
  assert start+datetime.timedelta(seconds=120)<end
  s=dict(schema_version=1,record_type='Root_fresh_exact_once_I6_new_pure_metadata_synthetic_memory_test_scope',author='/root',Root_thread=a['Root_thread'],created_utc=start.isoformat(),interval_start=start.isoformat(),interval_end=end.isoformat(),original_Source_scope=authority_pin,maximum_invocations=1,automatic_retry_authorized=False,new_I6_pure_memory_fixture_invocation_authorized=True,original_I0_I1_I2_I3_I4_I5_native_Parser_project_invocations_authorized=False,actual_final_Source_adoption=adoption,adapter_Source=adapter,fixture_Source=fixture,exact_child_runner=fact(P/'ROOT_RUN_I6_ONCE_ISOLATED_MEMORY_FIXTURES_002.py'),exact_supervisor_Source=fact(P/'ROOT_SUPERVISE_I6_ONCE_MEMORY_FIXTURES_002.py'),consumption_marker_name='ROOT_I6_MEMORY_TEST_SCOPE_CONSUMED_001.json',supervisor_marker_name='ROOT_I6_MEMORY_TEST_SUPERVISOR_CONSUMED_001.json',saved_result_name='ROOT_I6_ACTUAL_ONCE_SYNTHETIC_MEMORY_RESULTS_001.json',supervisor_result_name='ROOT_I6_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_001.json',child_stdout_name='ROOT_I6_OWNED_MEMORY_CHILD_STDOUT_001.txt',child_stderr_name='ROOT_I6_OWNED_MEMORY_CHILD_STDERR_001.txt',expected_planned_case_count=55,owned_hidden_child_maximum=1,wall_cap_seconds=60,cleanup_reap_seconds=5,stream_cap_bytes=CAP,synthetic_metadata_callback_only=True,Source_body_reads_authorized=False,actual_publisher_filesystem_write_authorized=False,audit_boundary='Observed CPython audit events plus independently reviewed pure Source; not exhaustive physical filesystem/stat/native interception.',original_Native_Parser_budgets_120_110_10_5_unchanged=True,all75_spent_identities_and_all_prior_holds_preserved=True,all_actual_new_lease_family_grant_paths_ordinals_purpose_native_Parser_results=None,operational_authority=False,scientific_authority=False)
  print(json.dumps(save('ROOT_I6_ONCE_SYNTHETIC_MEMORY_TEST_SCOPE_001.json',s)))
 else:raise AssertionError(sys.argv[1])
if __name__=='__main__':main()
