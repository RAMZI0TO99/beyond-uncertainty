capsule_pin = emit(OUT/'INDEPENDENT_CURRENT_OWNER_CHECKER_PEER015_SCOPE_FLOAT_FREE_SOURCE_CAPSULE_001.json',capsule)
print(json.dumps({'verdict':verdict,'checks':len(checks),'checks_failed':failed,'actual_inputs':len(inputs),'full_proof':proof_pin,'capsule':capsule_pin},sort_keys=True))
if failed:
    print(json.dumps([c for c in checks if not c['passed']],sort_keys=True))
