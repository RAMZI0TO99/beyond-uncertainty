check(scope['canonical_publication_role_allowlist'] == ['checker_peer'], 'Canonical role scope is finite checker_peer only')
check(scope['future_lease_family_duration_paths_INIT_or_clocks'] is None and scope['expired_Source030_and_previous_local_docs_scope_not_extended'] is True,
