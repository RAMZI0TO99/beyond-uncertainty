         'scope':'Exact current owner static checker_peer015 scope only; does not review future peer content or grant execution.'}
proof_pin = emit(OUT/'INDEPENDENT_CURRENT_OWNER_CHECKER_PEER015_SCOPE_FULL_SOURCE_PROOF_001.json', proof)
capsule = {'schema_version':1,'record_type':'independent_current_owner_checker_peer015_scope_float_free_Source_review',
           'reviewer':'/root/phase_frontier','reviewer_agent':'/root/phase_frontier','source_author':'/root','created_utc':created,
           'subject':scope_pin,'subjects':[dict(path=r['path'],sha256=r['sha256'],bytes=r['bytes']) for r in inputs],
