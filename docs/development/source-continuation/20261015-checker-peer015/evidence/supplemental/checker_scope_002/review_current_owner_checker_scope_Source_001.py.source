predecessor_body = read(Path(selected[0]['predecessor']['path']))
predecessor = decode(predecessor_body)
check(pin(Path(selected[0]['predecessor']['path']), predecessor_body) == selected[0]['predecessor'],
      'Actual predecessor014 whole bytes match retained selected pin')
check(set(predecessor) == set(contract['original_closed_keys_in_order']) and len(predecessor) == 15,
