ROOT = Path(r'D:\Aenv\pro2')
OUT = ROOT / r'WORK\resume-20261015-001\reviews\checker_scope_002'
SCOPE = ROOT / r'WORK\resume-20261015-001\source_continuation_002\ROOT_CURRENT_OWNER_STATIC_CHECKER_PEER015_SCOPE_001.json'
CONTRACT = ROOT / r'WORK\resume-20261007-001\generation\post_STEP077_Source022_genuine_static_checker15_pipeline26_peer_schema_prep_001\SOURCE022_CHECKER015_GENUINE_STATIC_ORIGINAL_PEER_SCHEMA_CONTRACT_001.json'
SELECTION = ROOT / r'WORK\resume-20261007-001\generation\observer010_lease009_root_001\ROOT_SOURCE022_LEASE010_SEPARATE_FUTURE45_SOURCE_PATH_SELECTION_001.json'
CAP = 2097152
checks = []
inputs = []

def check(condition, name):
    checks.append({'name': name, 'passed': bool(condition)})

def raw9(info):
    return [info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_mode, info.st_nlink,
            getattr(info, 'st_file_attributes', None), getattr(info, 'st_birthtime_ns', None)]

def pin(path, body):
    return {'path': str(path), 'sha256': hashlib.sha256(body).hexdigest(), 'bytes': len(body)}

def read(path):
    before = path.lstat()
    p9 = raw9(before)
    check(stat.S_ISREG(before.st_mode) and not path.is_symlink() and before.st_nlink == 1,
          str(path) + ': ordinary single-link regular file')
    check(0 < before.st_size <= CAP, str(path) + ': unchanged 2MiB input cap')
    with path.open('rb', buffering=0) as stream:
        f9 = raw9(os.fstat(stream.fileno()))
        a = stream.read(CAP + 1)
        stream.seek(0)
        b = stream.read(CAP + 1)
        f_after = raw9(os.fstat(stream.fileno()))
    after = raw9(path.lstat())
    check(a == b and len(a) == before.st_size, str(path) + ': two complete byte reads match')
    check(p9 == after, str(path) + ': complete Python path vector unchanged')
    check(f9 == f_after, str(path) + ': complete Python descriptor vector unchanged')
    check(all(p9[i] == f9[i] for i in (0,1,2,3,6,7,8)),
          str(path) + ': original shared Python identity indexes agree')
    record = dict(pin(path,a), Python_PATH9_before=p9, Python_PATH9_after=after,
                  Python_fd9_before=f9, Python_fd9_after=f_after,
                  two_complete_reads_equal=(a==b), complete_first_bytes_base64=base64.b64encode(a).decode('ascii'),
                  complete_second_bytes_base64=base64.b64encode(b).decode('ascii'))
    inputs.append(record)
    return a

def decode(body):
    def pairs(items):
        value = {}
        for key, item in items:
            if key in value:
                raise ValueError('Duplicate JSON key: ' + key)
            value[key] = item
        return value
    def reject(value):
        raise ValueError('Forbidden float or nonfinite JSON token: ' + value)
    return json.loads(body.decode('utf-8'), object_pairs_hook=pairs, parse_float=reject, parse_constant=reject)

def emit(path, value):
    body = (json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)+'\n').encode('utf-8')
    if len(body) > CAP:
        raise ValueError('Original output cap exceeded')
    with path.open('xb') as stream:
        stream.write(body)
    actual = path.read_bytes()
    if actual != body:
        raise ValueError('Saved output differs from written bytes')
    return pin(path, body)

check(sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.dont_write_bytecode,
