for key, value in contract['immutable_original_fields'].items():
    check(type(predecessor[key]) is type(value) and predecessor[key] == value,
          'Actual predecessor retains original immutable field ' + key)
check(contract['required_original_verdict'] == 'PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY',
      'Checker peer verdict is static Source-only')
check(set(contract['required_current_Source_dependencies']) == {'checker','checker_dependency_audit','checker_manifest','checker_protocol'},
      'Dormant checker contract requires exact canonical checker/audit/protocol/manifest frontier')
check(scope['record_type'] == 'Root_current_owner_directed_static_checker_peer015_scope' and scope['author'] == '/root' and scope['schema_version'] == 1,
      'Current scope has truthful Root author/schema/record type')
check(scope['owner_current_instruction_exact'] == 'resume working.' and scope['standing_direct_owner_override_exact'] == 'work and tell me if you need pauses or anything no need to keep workin with pro3.',
      'Current and standing owner directions match direct trusted conversation')
start = dt.datetime.fromisoformat(scope['interval_start'])
end = dt.datetime.fromisoformat(scope['interval_end'])
now = dt.datetime.now(dt.timezone.utc)
check(start.utcoffset() is not None and end.utcoffset() is not None and end-start == dt.timedelta(hours=2),
      'Scope is a finite actual two-hour interval')
check(scope['created_utc'] == scope['interval_start'] and start <= now and now + dt.timedelta(seconds=60) < end,
      'Actual review is current and retains full original 60-second reserve')
check(scope['original_publication_reserve_seconds'] == 60 and scope['ordinary_metadata_output_cap_bytes'] == CAP,
      'Original Source reserve60 and metadata output cap2MiB retained')
check(scope['maximum_local_agents_including_Root'] == 3 and scope['historical_shared_maximum_including_both_roots_and_overlap'] == 5 and scope['two_slots_reserved_for_other_root_overlap'] is True,
      'Local3 plus reserved2 fits one historical shared5 ceiling; actual host occupancy not inferred')
check(scope['Pro3_coordination_required'] is False and scope['Pro3_pause_requested'] is False and scope['notify_owner_if_actual_resource_pause_needed'] is True,
