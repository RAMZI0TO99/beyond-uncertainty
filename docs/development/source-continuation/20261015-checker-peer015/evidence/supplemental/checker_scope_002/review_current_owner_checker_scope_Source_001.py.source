for key in ('target_execution','tests_executed','operational_authority','scientific_authority','scientific_totals_recounted'):
    check(scope[key] is False, 'Current scope excludes ' + key)
for key in ('actual_binding_remains_null','genuine_Root_Source_details_and_decision_required','different_actual_Source_review_before_draft_and_canonical_acceptance_required','Native10_PATH9_fd9_guards_original_spent75_Unit006_and_all_caps_reserves_preserved'):
