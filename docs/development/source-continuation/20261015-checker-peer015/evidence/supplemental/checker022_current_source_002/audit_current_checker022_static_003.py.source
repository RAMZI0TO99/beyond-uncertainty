"""Independent stdlib Source-byte audit. Never imports or invokes project Sources."""
import ast,base64,copy,datetime as dt,hashlib,json,os,re,stat,sys
from pathlib import Path
ROOT=Path(r'D:\Aenv\pro2')
HERE=ROOT/'WORK/resume-20261015-001/reviews/checker022_current_source_002'
BASE=ROOT/'resume-2026-10-03-continuation001/metadata3-actual-checker-prep001'
GEN=ROOT/'WORK/resume-20261007-001/generation/observer010_lease009_root_001'
NEW=ROOT/'WORK/resume-20261013-001'
SCOPE=ROOT/'WORK/resume-20261015-001/source_continuation_002/ROOT_CURRENT_OWNER_STATIC_CHECKER_PEER015_SCOPE_001.json'
FIELDS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns')
SHARED=(0,1,2,3,6,7,8)
OBS={};BODIES={};CHECKS=[];HISTORY=[];PIN_ALIASES=[]
def check(value,label,context=None):
    CHECKS.append(dict(label=label,context=context,passed=value is True))
    if value is not True: raise ValueError(str(label)+' '+str(context))
def digest(b):return hashlib.sha256(b).hexdigest()
def utc():return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')
def fact(p,b):return dict(path=str(p),sha256=digest(b),bytes=len(b))
def raw(s):return [getattr(s,n,None) for n in FIELDS]
def ordinary(p):
    p=Path(p);check(p.is_absolute() and '..' not in p.parts,'absolute ordinary Source path',str(p))
    for x in [*reversed(p.parents),p]:
        s=x.lstat();check(not stat.S_ISLNK(s.st_mode) and not(getattr(s,'st_file_attributes',0)&1024),'Source chain non-reparse',str(x))
        if x!=p:check(stat.S_ISDIR(s.st_mode),'Source ancestor directory',str(x))
    s=p.lstat();check(stat.S_ISREG(s.st_mode) and s.st_nlink==1,'single-link regular Source',str(p));return p

def read(p,expected=None,cap=2097152):
    p=ordinary(p);a=raw(p.lstat());check(a[2]<=cap,'finite input cap',str(p))
    with p.open('rb') as h:
        f=raw(os.fstat(h.fileno()));check(all(a[i]==f[i] for i in SHARED),'PATH9/fd9 shared7 only',str(p))
        one=h.read(cap+1);h.seek(0);two=h.read(cap+1);end=raw(os.fstat(h.fileno()))
        check(one==two and f==end,'two complete reads and independent fd9 stable',str(p))
    check(a==raw(p.lstat()) and len(one)==a[2]<=cap,'full independent PATH9 stable and exact byte length',str(p))
    if expected is not None:check(digest(one)==expected,'actual SHA matches accepted pin',str(p))
    if str(p) in OBS:check(OBS[str(p)]['path9']==a and OBS[str(p)]['descriptor9']==f and BODIES[str(p)]==one,'same actual Source and raw metadata across audit',str(p))
    else:OBS[str(p)]={**fact(p,one), 'path9':a,'descriptor9':f,'read_cap':cap};BODIES[str(p)]=one
    return one

def pairs(items):
    out={}
    for k,v in items:
        if k in out:raise ValueError('duplicate JSON key '+k)
        out[k]=v
    return out

def decode(b):
    check(not b.startswith(b'\xef\xbb\xbf'),'strict JSON without BOM')
    def refuse(v):raise ValueError('float/nonfinite Source JSON '+v)
    return json.loads(b.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=refuse,parse_constant=refuse)
def record(p,expected=None,cap=2097152):return decode(read(p,expected,cap))
def pin_read(pin,cap=2097152):
    check(type(pin) is dict and all(k in pin for k in ('path','sha256','bytes')),'actual fact3 required')
    check(type(pin['bytes']) is int and 0<=pin['bytes']<=cap and re.fullmatch('[a-f0-9]{64}',pin['sha256']) is not None,'typed finite SHA/byte pin')
    b=read(pin['path'],pin['sha256'],cap);check(len(b)==pin['bytes'],'accepted fact3 byte count',pin['path']);return b

def pin_record(pin):return decode(pin_read(pin))
def contains(value,pin):
    if type(value) is dict:return value==pin or any(contains(x,pin) for x in value.values())
    if type(value) is list:return any(contains(x,pin) for x in value)
    return False

def at(value,path):
    for part in path:value=value[part]
    return value

def replace_field(value,path,new):
    if not path:return copy.deepcopy(new)
    parent=value
    for part in path[:-1]:parent=parent[part]
    parent[path[-1]]=copy.deepcopy(new);return value

def wire(v,compact=False):return (json.dumps(v,sort_keys=True,ensure_ascii=True,allow_nan=False,**({'separators':(',',':')} if compact else {'indent':2}))+'\n').encode()
def ast_dump(v):return ast.dump(v,include_attributes=False)
class StringEraser(ast.NodeTransformer):
    def visit_Constant(self,node):
        return ast.copy_location(ast.Constant(value='SOURCE_STRING_LITERAL'),node) if type(node.value) is str else node

def literal_packet(label,protocol,old,new):
    check(len(protocol['transformations'])==protocol['transformation_count'],'exact transformation packet size',label)
    cursor=old;steps=[]
    for i,t in enumerate(protocol['transformations']):
        if 'before_sha256' in t:check(digest(cursor)==t['before_sha256'],'actual literal step before SHA',[label,i])
        else:check(label=='checker020_to_checker021' and i==31,'only documented historical last-step hash absent',[label,i])
        a=t['old'].encode();b=t['new'].encode();n=t['exact_count']
        check(type(n) is int and n>0 and cursor.count(a)>=n,'retained bounded literal replacement count',[label,i])
        positions=[];start=0
        for k in range(n):
            pos=cursor.find(a,start);check(pos>=0,'actual selected replacement offset',[label,i,k]);positions.append(pos);start=pos+len(a)
        replacement=cursor.replace(a,b,n)
        if 'after_sha256' in t:check(digest(replacement)==t['after_sha256'],'actual literal step after SHA',[label,i])
        steps.append(dict(index=i,old=t['old'],new=t['new'],exact_count=n,old_offsets=positions,before_sha256=digest(cursor),after_sha256=digest(replacement)))
        cursor=replacement
    check(cursor==new,'entire forward packet yields canonical Source bytes',label)
    reverse=cursor
    for step in reversed(steps):
        check(digest(reverse)==step['after_sha256'],'inverse starts from exact step bytes',[label,step['index']])
        a=step['old'].encode();b=step['new'].encode();positions=step['old_offsets']
        for k in range(len(positions)-1,-1,-1):
            pos=positions[k]+k*(len(b)-len(a));check(reverse[pos:pos+len(b)]==b,'exact actual reverse byte slice',[label,step['index'],k]);reverse=reverse[:pos]+a+reverse[pos+len(b):]
        check(digest(reverse)==step['before_sha256'],'whole inverse step SHA',[label,step['index']])
    check(reverse==old,'whole actual predecessor bytes reconstructed',label)
    ta=ast.parse(old.decode('utf8'));tb=ast.parse(new.decode('utf8'));tr=ast.parse(reverse.decode('utf8'))
    check(ast_dump(ta)==ast_dump(tr),'whole predecessor AST reconstructed',label)
    check(ast_dump(StringEraser().visit(copy.deepcopy(ta)))==ast_dump(StringEraser().visit(copy.deepcopy(tb))),'whole control-flow/operators/guards/numeric/None AST exact excluding declared string literals',label)
    fa=[x for x in ta.body if isinstance(x,(ast.FunctionDef,ast.AsyncFunctionDef))];fb=[x for x in tb.body if isinstance(x,(ast.FunctionDef,ast.AsyncFunctionDef))]
    check(len(fa)==len(fb)==69 and [x.name for x in fa]==[x.name for x in fb],'all original69 top-level functions in exact order',label)
    functions=[];changed=[]
    for a,b in zip(fa,fb):
        signature=lambda n:ast_dump(ast.FunctionDef(name=n.name,args=copy.deepcopy(n.args),body=[],decorator_list=copy.deepcopy(n.decorator_list),returns=copy.deepcopy(n.returns),type_comment=n.type_comment))
        check(signature(a)==signature(b),'function signature/default/annotation/decorator exact',[label,a.name])
        guards=lambda n:[ast_dump(x.func) for x in ast.walk(n) if isinstance(x,ast.Call)]
        check(guards(a)==guards(b),'all function calls and guard call order exact',[label,a.name])
        same=ast_dump(a)==ast_dump(b)
        if not same:changed.append(a.name)
        functions.append(dict(name=a.name,predecessor_AST_sha256=digest(ast_dump(a).encode()),current_AST_sha256=digest(ast_dump(b).encode()),AST_exact_without_literal_changes=same,call_count=len(guards(a)),signature_sha256=digest(signature(a).encode())))
    check(changed==protocol['changed_functions'],'declared changed function list exact',[label,changed])
    check(protocol['functions_total']==69 and protocol['functions_AST_exact']==69-len(changed),'protocol function counts match actual AST',label)
    numbers=lambda t:[dict(kind=type(n.value).__name__,value_repr=repr(n.value)) for n in ast.walk(t) if isinstance(n,ast.Constant) and not isinstance(n.value,str)]
    check(numbers(ta)==numbers(tb),'all non-string constants including caps/reserves/bools/None exact',label)
    timecalls=lambda t:[ast_dump(n) for n in ast.walk(t) if isinstance(n,ast.Call) and (isinstance(n.func,ast.Name) and n.func.id in ('now_exact','now','stamp','moment','moment_exact') or isinstance(n.func,ast.Attribute) and n.func.attr in ('now','utcnow','time','monotonic','perf_counter'))]
    check(timecalls(ta)==timecalls(tb),'all timestamp/clock call ASTs exact',label)
    return dict(label=label,step_count=len(steps),steps=steps,old_sha256=digest(old),current_sha256=digest(new),reconstructed_predecessor_sha256=digest(reverse),whole_predecessor_AST_sha256=digest(ast_dump(ta).encode()),current_AST_sha256=digest(ast_dump(tb).encode()),string_erased_AST_sha256=digest(ast_dump(StringEraser().visit(copy.deepcopy(tb))).encode()),functions=functions,changed_functions=changed,unchanged_function_count=69-len(changed),all_nonstring_constants=numbers(tb),clock_call_count=len(timecalls(tb)))

def metadata_inverse(label,current,receipt):
    inv=receipt['complete_predecessor_inverse'];old=pin_read(receipt['predecessor'])
    saved=base64.b64decode(inv['complete_predecessor_bytes_base64'],validate=True)
    check(saved==old and inv['predecessor']==receipt['predecessor'],'saved entire metadata predecessor bytes exact',label)
    restored=copy.deepcopy(current);rows=[]
    for row in inv['field_reversal_rows']:
        check(at(current,row['JSON_path'])==row['new_value'],'declared whole-field new value exact',[label,row['JSON_path']])
        check(row['actual_assertion'] is True,'retained actual metadata field assertion',[label,row['JSON_path']])
        restored=replace_field(restored,row['JSON_path'],row['old_value']);rows.append(dict(JSON_path=row['JSON_path'],old_value_sha256=digest(json.dumps(row['old_value'],sort_keys=True,separators=(',',':')).encode()),new_value_sha256=digest(json.dumps(row['new_value'],sort_keys=True,separators=(',',':')).encode())))
    check(restored==decode(old),'all and only disclosed metadata whole-field reversals reconstruct predecessor JSON',label)
    check(wire(restored)==old,'complete canonical metadata predecessor wire bytes exact after field reversals',label)
    return dict(role=label,predecessor=receipt['predecessor'],complete_predecessor_inverse_sha256=digest(saved),field_reversals=rows,whole_predecessor_wire_sha256=digest(wire(restored)))

def historical_review(pin,subjects):
    v=pin_record(pin);check(v.get('reviewer') not in (None,'/root') and v.get('checks_failed',0)==0,'historical genuinely different saved review',pin['path'])
    check(all(contains(v,p) for p in subjects),'saved review binds actual subjects',pin['path'])
    if 'full_proof' in v:pin_read(v['full_proof'])
    HISTORY.append(dict(review=pin,reviewer=v['reviewer'],verdict=v.get('verdict'),historical_serialized_checks=v.get('serialized_check_count'),historical_count_not_rerun_or_summed=True))
    return v

def audit():
    check(Path(__file__).absolute().parent==HERE and sys.flags.isolated==1 and sys.flags.no_site==1 and sys.dont_write_bytecode,'own host isolated stdlib Source audit only')
    scope=record(SCOPE);scope_adoption=record(SCOPE.parent/'ROOT_CURRENT_CHECKER_PEER015_SCOPE_DIFFERENT_REVIEW_ADOPTION_001.json');scope_review=pin_record(scope_adoption['different_review']);pin_read(scope_adoption['full_proof']);check(scope_adoption['author']=='/root' and scope_adoption['subject']==fact(SCOPE,BODIES[str(SCOPE)]) and scope_review['checks_failed']==0 and scope_review['reviewer']!='/root','current scope genuinely different review and Root adoption');check(scope['author']=='/root' and scope['canonical_publication_role_allowlist']==['checker_peer'] and scope['target_execution'] is False and scope['operational_authority'] is False and scope['Pro3_coordination_required'] is False,'current direct owner Source-only scope')
    now=dt.datetime.now(dt.timezone.utc);check(dt.datetime.fromisoformat(scope['interval_start'])<=now<dt.datetime.fromisoformat(scope['interval_end'])-dt.timedelta(seconds=60),'current scope and original60 publication reserve')
    selection=pin_record(scope['selected_family']);rows={x['role']:x for x in selection['rows']}
    check(rows['checker_peer']==scope['selected_exact_role'],'Root exact selected checker015 row unchanged')
    peer_old=pin_record(rows['checker_peer']['predecessor'])
    for name in ('draft_path','canonical_path'):
        p=Path(rows['checker_peer'][name]);check(not os.path.lexists(p) and not os.path.lexists(str(p)+'.staging'),'fresh selected peer path absent at content audit',name)
    roles={n:rows[n] for n in ('checker','checker_protocol','checker_dependency_audit','checker_manifest')}
    actual={};objects={}
    for name,row in roles.items():
        b=read(row['canonical_path'],cap=row['source_cap']);actual[name]=fact(Path(row['canonical_path']),b)
        if name!='checker':objects[name]=decode(b)
    protocol=objects['checker_protocol'];current=BODIES[actual['checker']['path']];old=pin_read(protocol['predecessor'],262144)
    check(protocol['transformation_count']==57 and protocol['occurrence_count']==57,'checker022 exact57 Source literal steps')
    lineage=[literal_packet('checker021_to_checker022',protocol,old,current)]
    prior_protocol=record(BASE/'SOURCE_PROTOCOL_AND_REVIEW_CONTRACT_021.json');prior=pin_read(prior_protocol['predecessor'],262144)
    lineage.append(literal_packet('checker020_to_checker021',prior_protocol,prior,old))
    check(protocol['source_only'] is True and protocol['operational_authority'] is False and protocol['actual_tests'] is None and protocol['actual_READY'] is None,'protocol static only null actual results')
    manifest=objects['checker_manifest'];check(manifest['payload_count']==len(manifest['payloads'])==3,'manifest exact3 payloads')
    for role,payload in zip(('checker','checker_protocol','checker_dependency_audit'),manifest['payloads']):
        check(payload['canonical_path']==rows[role]['canonical_path'] and payload['path']==rows[role]['draft_path'],'manifest exact selected draft/canonical pair',role)
        b=pin_read(payload,rows[role]['source_cap']);check(b==BODIES[actual[role]['path']],'all actual manifest payload bytes equal canonical',role)
    check(manifest['actual_execution'] is None and manifest['operational_authority'] is False,'manifest no actual execution authority')
    auditdata=objects['checker_dependency_audit'];check(auditdata['full_configure_source_closure_ready'] is False and auditdata['target_import_or_execution'] is False and auditdata['operational_authority'] is False,'audit coherent configure closure remains false and Source only')
    inverse=[];triplet=record(NEW/'generation/ROOT_SOURCE030_CHECKER022_TRIPLET_ACTUAL_STATIC_PUBLICATION_OUTCOME_001.json')
    for entry in triplet['canonical_acceptance_support']:
        role=entry['role'];check(entry['canonical']==actual[role],'actual accepted Source030 canonical subject exact',role)
        receipt=pin_record(entry['author_receipt']);check(receipt['target_execution'] is False and receipt['operational_authority'] is False,'historical author receipt Source-only',role)
        check(receipt['draft']['path']==rows[role]['draft_path'] and pin_read(receipt['draft'])==BODIES[actual[role]['path']],'Source030 draft receipt binds current complete bytes',role)
        inverse.append(metadata_inverse(role,objects[role],receipt))
        pub=pin_record(entry['publication']);review=historical_review(entry['different_review'],[actual[role]])
        adopt=pin_record(entry['Root_adoption'])
        check(pub['canonical']==entry['canonical'] and pub['author']=='/root','actual Root triplet canonical publication',role)
        check(adopt['author']=='/root' and adopt['different_review']==entry['different_review'] and adopt['canonical']==actual[role] and adopt['canonical_publication'] is True and adopt['target_execution'] is False and adopt['operational_authority'] is False,'Root accepts exact genuinely different canonical Source030 review',role)
        check(review['author_receipt']==entry['author_receipt'] and review['original_publication']==entry['publication'],'different canonical review binds actual original publication and author receipt',role)
    check(len(inverse)==3,'all three complete metadata predecessor inverses retained')
    recon=record(GEN/'ROOT_SOURCE022_CHECKER022_ACTUAL_CANONICAL_SOURCE_VERIFIED_PRIOR_PUBLICATION_RECONCILIATION_001.json')
    check(recon['canonical_Source']==actual['checker'] and recon['new_canonical_Source_write_by_reconciliation'] is False and recon['canonical_publication'] is True,'checker022 actual separate canonical publication reconciliation')
    publication=pin_record(recon['initial_actual_canonical_publication_receipt']);pin_read(recon['initial_actual_Root_request']);pin_read(recon['initial_actual_execution_witness'])
    check(publication['published_count']==1 and publication['canonical_publication'] is True and contains(publication,actual['checker']),'actual Root checker022 single publication exact')
    rv=historical_review(recon['actual_canonical_delta_Source_review'],[actual['checker']]);ad=pin_record(recon['canonical_delta_Root_adoption'])
    check(ad['author']=='/root' and ad['different_review']==recon['actual_canonical_delta_Source_review'],'Root adoption binds actual different checker022 canonical review')
    draftrv=historical_review(pin_record(rv['Root_draft_Source_adoption'])['different_review'],[actual['checker']|{'path':rows['checker']['draft_path']}])
    check(draftrv['literal_steps']==57 and draftrv['complete_whole_predecessor_byte_inverse'] is True and draftrv['whole_AST_complement_exact'] is True and draftrv['original_top_level_functions']==69,'inherited checker022 draft review semantics authenticated history')
    rreview=record(ROOT/'WORK/resume-20261007-001/reviews/source022_actual_checker022_prior_publication_reconciliation_001/INDEPENDENT_SOURCE022_ACTUAL_CHECKER022_PRIOR_PUBLICATION_RECONCILIATION_FLOAT_FREE_SOURCE_CAPSULE_001.json')
    radopt=record(GEN/'ROOT_SOURCE022_CHECKER022_VERIFIED_PRIOR_PUBLICATION_RECONCILIATION_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json')
    check(rreview['checks_failed']==0 and rreview['reviewer']!='/root' and contains(rreview,fact(GEN/'ROOT_SOURCE022_CHECKER022_ACTUAL_CANONICAL_SOURCE_VERIFIED_PRIOR_PUBLICATION_RECONCILIATION_001.json',BODIES[str(GEN/'ROOT_SOURCE022_CHECKER022_ACTUAL_CANONICAL_SOURCE_VERIFIED_PRIOR_PUBLICATION_RECONCILIATION_001.json')])),'separate reconciliation genuine saved review exact')
    check(radopt['author']=='/root' and contains(radopt,fact(ROOT/'WORK/resume-20261007-001/reviews/source022_actual_checker022_prior_publication_reconciliation_001/INDEPENDENT_SOURCE022_ACTUAL_CHECKER022_PRIOR_PUBLICATION_RECONCILIATION_FLOAT_FREE_SOURCE_CAPSULE_001.json',BODIES[str(ROOT/'WORK/resume-20261007-001/reviews/source022_actual_checker022_prior_publication_reconciliation_001/INDEPENDENT_SOURCE022_ACTUAL_CHECKER022_PRIOR_PUBLICATION_RECONCILIATION_FLOAT_FREE_SOURCE_CAPSULE_001.json')])),'Root separately adopts reconciliation review')
    api=record(NEW/'generation/source030_checker_metadata_triplet_001/SOURCE030_CHECKER022_METADATA_TRIPLET_STATIC_TOOLS_INERT_API_003.json')
    check(len(api['exact17_design_sites'])==17,'exact original17 Source path coordinates')
    sites=[]
    for site in api['exact17_design_sites']:
        ref=site['reference'];expected=selection['new_canonical_lease']['path'] if ref['source']=='lease' else rows[ref['source']][ref['field']]
        value=at(objects[site['role']],site['JSON_path']);check(value==expected,'preserved exact original17 selected path coordinate',[site['role'],site['JSON_path']]);sites.append(dict(role=site['role'],JSON_path=site['JSON_path'],exact_current_value=value,reference=ref))
    check(protocol['dependency_audit']['path']==actual['checker_dependency_audit']['path'] and protocol['dependency_audit']['sha256']==actual['checker_dependency_audit']['sha256'] and protocol['dependency_audit']['bytes']==actual['checker_dependency_audit']['bytes'],'protocol audit actual pin exact while draft coordinate retained')
    contract_path=ROOT/'WORK/resume-20261007-001/generation/step079_three_external_peer_deferred_Source024_preparation_001/SOURCE024_THREE_EXTERNAL_PEER_DEFERRED_ORIGINAL_SCHEMAS_AND_LATE_INPUT_CONTRACT_003.json'
    contract=record(contract_path);contract_pin=fact(contract_path,BODIES[str(contract_path)])
    extreview_path=ROOT/'WORK/resume-20261007-001/reviews/source024_STEP079_external_three_peer003_implementation001/INDEPENDENT_SOURCE024_EXTERNAL003_FLOAT_FREE_SOURCE_REVIEW_CAPSULE_001.json'
    extreview_pin=fact(extreview_path,read(extreview_path));extreview=historical_review(extreview_pin,[contract_pin])
    extadopt=record(GEN/'ROOT_SOURCE024_STEP079_EXTERNAL003_PAIR_API_DIFFERENT_DORMANT_WHOLE_SOURCE_REVIEW_ADOPTION_001.json')
    check(extadopt['author']=='/root' and extadopt['different_review']==extreview_pin,'genuine later Source024 original peer schema review Root adoption')
    schema=contract['original_peer_schemas']['checker_peer'];keys=schema['original_closed_keys_in_order']
    check(len(keys)==15 and list(peer_old)==keys and schema['peer_Source_cap']==rows['checker_peer']['source_cap']==65536,'exact original15 schema order and65536 cap')
    check(schema['required_Source_roles']==['checker','checker_dependency_audit','checker_manifest','checker_protocol'] and schema['required_carried_Source_roles']==[],'independent checker Source peer requires only four canonical Source roles')
    check(schema['genuine_content_author']=='/root' and schema['required_original_verdict']=='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY','genuine Root fresh content authority and original verdict')
    for key,value in schema['immutable_original_fields'].items():check(type(peer_old[key]) is type(value) and peer_old[key]==value,'predecessor original immutable field retained',key)
    details_path=SCOPE.parent/'ROOT_GENUINE_CHECKER022_FULL_STATIC_SOURCE_REVIEW_DETAILS_001.json'
    decision_path=SCOPE.parent/'ROOT_GENUINE_CHECKER_PEER015_CONTENT_DECISION_001.json'
    details=record(details_path,'63d2d59203c36174c99db9414ea8e66fcb878f7e28e8370b67e7e2bee1f7791e');details_pin=fact(details_path,BODIES[str(details_path)])
    decision=record(decision_path,'76d7a089f58111a23a36696fcf427cfba07fbe860c333257cfdf48543d2c0a13');decision_pin=fact(decision_path,BODIES[str(decision_path)])
    for pin in details['actual_input_pins']:pin_read(pin)
    check(details['author']==details['reviewer']=='/root' and details['source_author']=='/root/actual_record_checker' and details['verdict']=='PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY','fresh genuine Root own full Source details nominal')
    check(details['actual_canonical_Source']==actual and details['selection']==scope['selected_family'],'Root full details binds exact four actual canonical Sources and selection')
    check(details['actual_binding'] is None and details['independent_current_full_details_Source_review'] is None and details['new_native_vectors_or_Parser_results'] is None and all(details[k] is False for k in ('target_execution','tests_executed','operational_authority','runtime_acceptance','scientific_authority','scientific_totals_recounted','spent_identity_replay','full_configure_source_closure_ready')),'Root full details keeps null/false result and authority boundaries')
    check(details['literal_step_count']==57 and details['original_function_count']==69 and details['unchanged_original_function_count']==56 and details['changed_functions_with_only_declared_literal_bindings']==lineage[0]['changed_functions'] and details['whole_predecessor_inverse_sha256']==digest(old) and details['whole_predecessor_inverse_exact'] is True and details['whole_inverse_AST_exact'] is True,'fresh Root complete Source lineage claims match actual independent reconstruction')
    check(details['serialized_check_count']==len(details['checks'])==209 and details['checks_failed']==0 and all(x['passed'] is True for x in details['checks']),'Root own209 saved checks are internally exact, not counted as this reviewer checks')
    a=ast.parse(old.decode());b=ast.parse(current.decode())
