def write(name,value):
    p=HERE/name;check(p.parent==HERE and not os.path.lexists(p),'fresh own output path',str(p));b=wire(value,compact=True);check(len(b)<=2097152,'ordinary output2097152 cap',name)
    with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
    if p.read_bytes()!=b:raise ValueError('write readback mismatch')
    return fact(p,b)

