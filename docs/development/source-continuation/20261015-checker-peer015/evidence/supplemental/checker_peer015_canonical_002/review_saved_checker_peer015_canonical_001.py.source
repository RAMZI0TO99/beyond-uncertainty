FIELDS=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns','st_mode','st_nlink','st_file_attributes','st_birthtime_ns');SHARED=(0,1,2,3,6,7,8)
CHECKS=[];OBS={};BODIES={}
def ck(v,label,context=None):
    CHECKS.append(dict(label=label,context=context,passed=v is True))
    if v is not True:raise ValueError(str(label)+' '+str(context))
def sha(b):return hashlib.sha256(b).hexdigest()
def utc():return dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')
def fact(p,b):return dict(path=str(p),sha256=sha(b),bytes=len(b))
def vec(s):return [getattr(s,k,None) for k in FIELDS]
def ordinary(p):
    p=Path(p);ck(p.is_absolute() and '..' not in p.parts,'absolute Source path',str(p))
    for x in [*reversed(p.parents),p]:
        q=x.lstat();ck(not stat.S_ISLNK(q.st_mode) and not(getattr(q,'st_file_attributes',0)&1024),'non-reparse Source path chain',str(x))
        if x!=p:ck(stat.S_ISDIR(q.st_mode),'ordinary Source ancestor',str(x))
    q=p.lstat();ck(stat.S_ISREG(q.st_mode) and q.st_nlink==1,'single-link regular Source input',str(p));return p

def read(p,expected=None,cap=2097152):
    p=ordinary(p);a=vec(p.lstat());ck(a[2]<=cap,'actual finite Source input cap',str(p))
    with p.open('rb') as h:
        f=vec(os.fstat(h.fileno()));ck(all(a[i]==f[i] for i in SHARED),'separate PATH9/fd9 with only original shared7 equality',str(p))
        one=h.read(cap+1);h.seek(0);two=h.read(cap+1);ck(one==two and f==vec(os.fstat(h.fileno())),'two exact complete reads and independent fd9 stability',str(p))
    ck(a==vec(p.lstat()) and len(one)==a[2]<=cap,'independent full PATH9 stability and byte length',str(p))
    if expected is not None:ck(sha(one)==expected,'exact actual saved SHA pin',str(p))
    if str(p) in OBS:ck(OBS[str(p)]['path9']==a and OBS[str(p)]['descriptor9']==f and BODIES[str(p)]==one,'retained complete first bytes and raw observations',str(p))
    else:OBS[str(p)]={**fact(p,one),'path9':a,'descriptor9':f,'read_cap':cap};BODIES[str(p)]=one
    return one

def pairs(items):
    out={}
    for k,v in items:
        if k in out:raise ValueError('duplicate JSON key '+k)
        out[k]=v
    return out

def decode(b):
    ck(not b.startswith(b'\xef\xbb\xbf'),'strict UTF8 JSON without BOM')
    def refuse(t):raise ValueError('float/nonfinite token '+t)
    return json.loads(b.decode('utf8','strict'),object_pairs_hook=pairs,parse_float=refuse,parse_constant=refuse)
def rec(p,expected=None,cap=2097152):return decode(read(p,expected,cap))
def pread(p,cap=2097152):
    ck(type(p) is dict and set(p)=={'path','sha256','bytes'} and type(p['bytes']) is int and 0<p['bytes']<=cap and re.fullmatch('[a-f0-9]{64}',p['sha256']) is not None,'closed typed bounded actual fact3')
    b=read(p['path'],p['sha256'],cap);ck(len(b)==p['bytes'],'exact saved byte pin count',p['path']);return b

def prec(p):return decode(pread(p))
def contains(v,p):
    if type(v) is dict:return v==p or any(contains(x,p) for x in v.values())
    if type(v) is list:return any(contains(x,p) for x in v)
    return False

def wire(v):return (json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
def moment(t):return dt.datetime.fromisoformat(t)
def exact_record(p,kind,expected_author='/root'):
