    ck(review['checks_failed']==proof['checks_failed']==0 and all(x['passed'] is True for x in proof['checks']),'all genuinely saved result rows passed',review['record_type'])
    ck(review['actual_input_count']==expected_inputs,'saved input count explicit and separate',review['record_type'])

