def write(name,v):
    p=HERE/name;ck(not os.path.lexists(p),'own create-once output absent',name);b=(json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode();ck(len(b)<=2097152,'original2097152 own metadata output cap',name)
    with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
    if p.read_bytes()!=b:raise ValueError('own complete output readback mismatch')
    return fact(p,b)

