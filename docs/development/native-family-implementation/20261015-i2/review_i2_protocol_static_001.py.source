def check(name,passed,evidence):
    checks.append({"name":name,"passed":bool(passed),"evidence":evidence})
    if not passed:raise ValueError(name)
def read(path,size,digest):
    raw=path.read_bytes()
    pin={"path":str(path),"bytes":len(raw),"sha256":hashlib.sha256(raw).hexdigest()}
    inputs.append(pin)
    check("Actual complete bounded input "+path.name,0<len(raw)<=2097152 and len(raw)==size and pin["sha256"]==digest,pin)
    return raw
def reject(_):raise ValueError("Noninteger JSON")
def unique(items):
    obj={}
    for k,v in items:
        if k in obj:raise ValueError("Duplicate input JSON key")
        obj[k]=v
    return obj
def doc(path,size,digest):return json.loads(read(path,size,digest).decode(),object_pairs_hook=unique,parse_float=reject,parse_constant=reject)
