"""Prepare finite I2 development evidence; no helper/family generation."""
import datetime
import hashlib
import json
import os
from pathlib import Path

R = Path(r"D:\Aenv\pro2")
P = R / "WORK/resume-20261015-001/native_family_implementation_005"
G = R / "github-portable-20261012-001"
C = P / "managed_preparation_001/candidates_001"
REL = "docs/development/native-family-implementation/20261015-i2/"
CAP = 2097152


def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_pin = fact(P / "ROOT_I2_FAMILY_HELPER_SOURCE_REVIEW_ADOPTION_001.json")
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I2_FAMILY_HELPER_SOURCE_ONLY"
    assert adoption["I2_executed"] is False and adoption["tests_executed"] is False
    scope_pin = fact(P / "ROOT_CURRENT_I2_STATIC_FAMILY_HELPER_IMPLEMENTATION_SCOPE_001.json")
    assert scope_pin["sha256"] == "440a2cbeb1eda40b08a109efb260d7484d3419752e2224693af18281c4bc3d4c"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    previous_scope_pin = fact(R / "WORK/resume-20261015-001/native_owner_implementation_004/managed_preparation_001/candidates_001/EXACT_MANAGED_I0_I1_IMPLEMENTATION_PUBLICATION_SCOPE_001.json")
    assert previous_scope_pin["sha256"] == "204723e29cb273c4cb846dcab1a0da6a3269cd62e4541f480eb00c533261ab4e"
    previous = json.loads(pinned(previous_scope_pin))
    rows, evidence, names = [], [], set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = Path(pin["path"])
        assert path.resolve().is_relative_to(P.resolve())
        name = path.name + (".source" if path.suffix in (".py", ".ps1") else "")
        assert Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": path.suffix in (".py", ".ps1")})
    add(REL + "evidence-index.json", {
        "schema_version": 1, "record_type": "I2_exact_family_helper_Source_and_review_evidence_index",
        "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
        "actual_evidence_copy_count": len(evidence), "files": evidence,
        "I2_or_original_helper_import_call_test_native_or_scientific_execution": False,
        "actual_family_selection_or_eight_Source_generation": False,
        "current_dated_Source_inventory": {"present": 36, "pending": 9},
        "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}})
    report = """# Current owner M3 family Source implementation

Root accepted the I2 M3/fresh-cohort helper and API Source after actual independent Source review and [Root adoption](ROOT_I2_FAMILY_HELPER_SOURCE_REVIEW_ADOPTION_001.json). This completes the I2 implementation step. The helper remains unrun; no M3/I1 helper, project test, Native8, Parser or actual family generation was invoked during this step.

The helper ports the expired Source024 authority context to the reviewed I0 owner validator and accepted I1 lease-producer context. It requires an explicit Root thread, actual bounded owner support and real Source/API review/adoption chains. The selected45 decision retains its closed13 shape with an explicit version2 type. New stage-purpose facts21 and draft receipt22 likewise retain their field counts with explicit version2 authority/context types. Old, unknown or malformed contracts fail closed.

**I0 context validation grants no M3 generation permission.** Future actual stage-purpose facts must have a genuine different full Source proof and a separate Root adoption before I0 dynamic loading, rendering or writes. Capsule, full proof and Root adoption must agree on the exact finite stage/role, whole-input pins and output paths derived from the selection. Canonical publication stays a separate action. These are specifications; no real stage purpose or owner grant was issued here.

The original paired reads and full PATH9/descriptor9 checks, literal/template/BOUND inverses, payload renderers, exclusive writer, seven-link M3 proof, caps and reserves remain preserved. The graph retains45 identity rows:44 fresh successors and one exact carried composer;17 M3 roles comprise14 generated roles and three genuine external peers. The manifest, capture assignments, phase assignments and closed7 phase binding retain their original contracts. Future phase TEMPLATE/BOUND ordinals must all exceed018; no ordinals, paths or nonce were selected now.

**M3 retains its narrower exact43200-second lease requirement.** I1 can represent a shorter bounded duration, but this M3 port accepts only its original12-hour subset. Source60, lease1200 and all original resource/cap constraints remain in force. The new guard does not broaden the lease or native/Parser authority.

Future receipt22 identifies Root as the physical serializer and receipt author, preserves the selected row's semantic author, and records the helper implementation's Source editor/pin separately. Complete predecessor inverses and the change inventory retain the original Source/API bytes and provenance.

**Canonical-dependency stages remain held for the external I5 receipt interface.** Original canonical-publication, reconciliation26 and peer receipt formats lack exact owner-v2 schemas in I2. A fixed false Source guard refuses that boundary with no JSON/CLI override. Later I5 interface definitions and a separately reviewed I2 Source successor are required; flipping a flag alone cannot qualify it. Original seven-link semantic predicates remain retained behind the guard. The zero-dependency template algorithm remains implemented, with every actual invocation gate still required.

No real selected45 family, new lease, eight canonical phase Sources, stage-purpose grant, native clock, Native8 or Parser result was created. Fresh original fixtures, C8, actual6, runtime, recovery and science remain unentered. The dated old family stays **36/45, nine pending**; frozen STEP080 stays **35/45, ten pending**. All75 spent identities and prior refusals remain preserved. Historical I0's17 passing memory-only methods remain the earlier I0 result and were not rerun for I2.

The next step is a separately scoped **I3 Native8 helper/wrapper/API context port**, then I4 Parser and later I5 family-specific consumers. Actual lease issuance, family selection, eight genuine new phase Sources and native/Parser admission follow their separate ceremony gates. An implemented helper supplies no invocation permission.

The [evidence index](evidence-index.json) records exact Source/API/inverse/protocol/review copies. Code is published as inert `.source` evidence with dated absolute-path provenance. This development directory does not rebuild or overlay the STEP080 archive. Three navigation prepends retain every complete earlier byte; Git history and external Root receipts record the later publication.
"""
    add(REL + "I2_FAMILY_IMPLEMENTATION.md", report.encode())
    prefix = ("**October15 I2 family helper Source accepted.** The [M3 family implementation report](" + REL + "I2_FAMILY_IMPLEMENTATION.md) records the reviewed owner-context/stage-purpose port, preserved algorithms and explicit future phase ordinals>018. I2 remains unrun; no actual family, stage grant or native/Parser result was created. Next: separately scope I3 Native8 helper/wrapper/API context. The dated Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        old_bytes = pinned(predecessor)
        saved = save(P / "managed_preparation_001/predecessors_001" / name, old_bytes)
        source = save(C / name, prefix + old_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {
        "schema_version": 1, "record_type": "Root_exact_finite_I2_family_Source_implementation_managed_publication_scope",
        "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "base_HEAD": "f33c945a21570328c8489466074a59b516a396af",
        "managed_file_count": len(rows), "files": rows, "Root_implementation_adoption": adoption_pin,
        "preexisting608_byte_baseline": previous["preexisting608_byte_baseline"],
        "all_frozen_STEP080_sentinels": previous["all_frozen_STEP080_sentinels"],
        "current36_Source_baseline": previous["current36_Source_baseline"],
        "target_execution": False, "tests_executed": False, "I2_executed": False}
    print(json.dumps(save(C / "EXACT_MANAGED_I2_FAMILY_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
