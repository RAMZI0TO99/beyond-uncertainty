def check(name,passed,evidence):
    checks.append({"name":name,"passed":bool(passed),"evidence":evidence})
    if not passed:raise ValueError((name,evidence))
def raw(path,n=None,digest=None):
    b=path.read_bytes()
    pin={"path":str(path),"bytes":len(b),"sha256":hashlib.sha256(b).hexdigest()}
    inputs.append(pin)
    check("Actual complete bounded input "+path.name,0<len(b)<=2097152 and (n is None or n==len(b)) and (digest is None or digest==pin["sha256"]),pin)
    return b
def reject(_):raise ValueError("Noninteger input JSON")
def unique(items):
    value={}
    for k,v in items:
        if k in value:raise ValueError("Duplicate input JSON key")
        value[k]=v
    return value
def doc(path,n=None,digest=None):return json.loads(raw(path,n,digest).decode("utf-8"),object_pairs_hook=unique,parse_float=reject,parse_constant=reject)
def pin(path):return next(x for x in inputs if x["path"]==str(path))
def fs(b):
    t=ast.parse(b)
    lines=b.splitlines(keepends=True)
    return t,{n.name:b"".join(lines[n.lineno-1:n.end_lineno]) for n in t.body if isinstance(n,ast.FunctionDef)}

