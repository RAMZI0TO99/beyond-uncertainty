with path.open("xb") as h:h.write(out)
full_pin={"path":str(path),"bytes":len(out),"sha256":hashlib.sha256(out).hexdigest()}
summary={k:proof[k] for k in ["schema_version","reviewer","source_author","created_utc","verdict","subjects","scope","checks_performed","checks_failed","target_execution","operational_authority","scientific_authority","external_canonical_receipt_ABI_qualified","canonical_dependency_stages_held"]}
summary.update(record_type="independent_I2_Source002_actual_Source_review_capsule",full_proof=full_pin,actual_unique_input_count=len(unique_inputs),I2_tests_or_native_execution=False)
summary["reviewer_Source"]=pin(Path(__file__))
sraw=(json.dumps(summary,sort_keys=True,indent=2,allow_nan=False)+"\n").encode()
sp=O/"INDEPENDENT_I2_SOURCE002_SOURCE_CAPSULE_001.json"
with sp.open("xb") as h:h.write(sraw)
print(json.dumps({"full_proof":full_pin,"capsule":{"path":str(sp),"bytes":len(sraw),"sha256":hashlib.sha256(sraw).hexdigest()},"checks_performed":len(checks),"checks_failed":0,"unique_inputs":len(unique_inputs)}))
