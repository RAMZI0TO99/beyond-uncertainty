"""Prepare inert evidence candidates; do not write checkout files or run targets."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path

ROOT = Path(r"D:\Aenv\pro2\WORK\resume-20261025-001")
REPO = Path(r"D:\Aenv\pro2\github-portable-20261012-001")
CANDIDATES = ROOT / "managed_candidates_002"

def pin(path):
    with path.open("rb") as stream:
        data = stream.read(2097153)
    if len(data) > 2097152:
        raise ValueError("metadata cap")
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}

def add(source, relative, rows):
    if source.is_symlink() or not source.is_file():
        raise ValueError("ordinary existing evidence file required")
    with source.open("rb") as stream:
        data = stream.read(2097153)
    if len(data) > 2097152:
        raise ValueError("metadata/Source candidate cap exceeded")
    destination = CANDIDATES / relative
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open("xb") as stream:
        stream.write(data)
    original = {"path": str(source), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}
    copied = pin(destination)
    if copied["bytes"] != original["bytes"] or copied["sha256"] != original["sha256"]:
        raise ValueError("copied buffer/readback mismatch")
    rows.append({"managed_path": relative.as_posix(), "original_source": original,
                 "candidate": copied, "exact_original_bytes_preserved": True,
                 "executable_entry": False})

def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write("\n")

def main():
    if CANDIDATES.exists():
        raise ValueError("candidate directory already exists; no overwrite")
    workspace_report = ROOT / "ROOT_CURRENT_EVIDENCE_WORKSPACE_ESTABLISHMENT_002.json"
    workspace = json.loads(workspace_report.read_bytes())
    if workspace["verdict"] != "VERIFIED":
        raise ValueError("full accepted current evidence workspace required")
    i11 = ROOT / "i2_receipt_contract_014"
    outcome = i11 / "ROOT_I11_SAVED_RESULTS_DIFFERENT_REVIEW_ADOPTION_001.json"
    if not outcome.is_file():
        raise ValueError("different saved-results adoption required")
    accepted = json.loads(outcome.read_bytes())
    if not (accepted.get("author") == "/root" and accepted.get("record_type") ==
            "Root_I11_finite8_metadata_saved_results_different_review_adoption" and
            accepted.get("verdict") == "ACCEPT_FINITE8_RECEIPT_METADATA_SYNTHETIC_QUALIFICATION_ONLY" and
            type(accepted.get("checks_failed")) is int and accepted["checks_failed"] == 0 and
            accepted.get("metadata_only") is True and accepted.get("tests_executed") is True and
            all(accepted.get(key) is False for key in ("full_G01_closed", "old_I2_external_ABI_qualified",
                "target_execution", "actual_family_publication", "operational_authority", "scientific_authority"))):
        raise ValueError("exact narrow accepted Root outcome required")
    actual = accepted.get("actual_cases")
    if not (type(actual) is dict and set(actual) == {"passed", "failed"} and
            type(actual["passed"]) is int and actual["passed"] > 0 and
            type(actual["failed"]) is int and actual["failed"] == 0):
        raise ValueError("actual all-pass synthetic count required")
    review = accepted.get("different_saved_results_review")
    if not (type(review) is dict and set(review) == {"path", "bytes", "sha256"} and
            pin(Path(review["path"])) == review):
        raise ValueError("actual different saved-results review pin required")
    rows = []
    for source in sorted(i11.rglob("*")):
        if source.is_file():
            relative = source.relative_to(i11)
            if "__pycache__" in relative.parts:
                continue
            if source.suffix == ".py":
                relative = relative.with_name(relative.name + ".source")
            add(source, Path("docs/development/native-producer-qualification/20261025-i11") / relative, rows)
    outer_witness = ROOT / "ROOT_CAPTURE_I11_ONCE_SUPERVISOR_EXECUTION_001.py"
    add(outer_witness, Path("docs/development/native-producer-qualification/20261025-i11") /
        (outer_witness.name + ".source"), rows)
    portability_sources = [ROOT / "ROOT_CURRENT_I11_SOURCE_CONTRACT_AND_PORTABILITY_SCOPE_001.json",
        ROOT / "ROOT_PREPARE_MANAGED_RESUME_EVIDENCE_CANDIDATES_001.py",
        ROOT / "ROOT_PREPARE_MANAGED_RESUME_EVIDENCE_CANDIDATES_002.py",
        ROOT / "ROOT_ESTABLISH_CURRENT_EVIDENCE_WORKSPACE_001.py",
        ROOT / "ROOT_ESTABLISH_CURRENT_EVIDENCE_WORKSPACE_002.py",
        ROOT / "ROOT_CURRENT_EVIDENCE_WORKSPACE_ESTABLISHMENT_001.json", workspace_report,
        ROOT / "ROOT_VERIFIER_OVERLAY_SOURCE_REVIEW_ADOPTION_001.json",
        ROOT / "ROOT_CURRENT_EVIDENCE_WORKSPACE_DIFFERENT_SAVED_REVIEW_ADOPTION_001.json"]
    portability_sources += sorted((ROOT / "portability_review_001").glob("*.json"))
    portability_sources += sorted(ROOT.glob("*_STDOUT_00*.txt"))
    portability_sources += sorted(ROOT.glob("*_STDERR_00*.txt"))
    for source in portability_sources:
        leaf = source.name + (".source" if source.suffix == ".py" else "")
        add(source, Path("docs/development/portability/20261025-verifier-overlay") / leaf, rows)
    for source in sorted((ROOT / "coordination").glob("*.json")):
        add(source, Path("docs/development/portability/20261025-verifier-overlay/coordination") / source.name, rows)
    for prefix in ("docs/development/native-producer-qualification/20261025-i11",
                   "docs/development/portability/20261025-verifier-overlay"):
        subset = [row for row in rows if row["managed_path"].startswith(prefix + "/")]
        save(CANDIDATES / prefix / "evidence-index.json", {"schema_version": 1,
            "record_type": "inert_managed_resume_evidence_candidates", "author": "/root",
            "created_utc": datetime.now(timezone.utc).isoformat(), "files": subset,
            "absolute_paths_are_dated_provenance": True, "project_execution_authority": False})
    save(CANDIDATES / "CONTINUE_CURRENT_20261025.json", {"schema_version": 1,
        "record_type": "current_resume_navigation", "author": "/root",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "frozen_checkpoint": "STEP080", "current_source_inventory": 36,
        "current_pending_roles": 9, "frozen_source_inventory": 35,
        "workspace_establishment": "docs/development/portability/20261025-verifier-overlay/" + workspace_report.name,
        "I11_saved_results_adoption": "docs/development/native-producer-qualification/20261025-i11/" + outcome.name,
        "I11_actual_synthetic_cases": actual,
        "local_workspace_pointer": ".continuation/current-workspace.json",
        "later_evidence_is_separate_from_frozen_snapshot": True,
        "full_I2_external_ABI_qualified": False, "actual_family_publication_authorized": False,
        "Native8_Parser_runtime_science_authorized": False,
        "next": "Read the exact accepted I11 saved results and scope limits; continue outside-eight receipt contracts and actual I8/I9/I7 caller composition under fresh reviewed scopes."})
    save(ROOT / "ROOT_MANAGED_RESUME_CANDIDATE_INVENTORY_002.json", {"schema_version": 1,
        "record_type": "Root_finite_inert_resume_candidate_inventory", "author": "/root",
        "created_utc": datetime.now(timezone.utc).isoformat(), "files": [pin(path) for path in sorted(CANDIDATES.rglob("*")) if path.is_file()],
        "primary_documents_modified": False, "frozen_metadata_modified": False,
        "target_execution": False, "operational_authority": False, "scientific_authority": False})
    print(CANDIDATES)

if __name__ == "__main__":
    main()
