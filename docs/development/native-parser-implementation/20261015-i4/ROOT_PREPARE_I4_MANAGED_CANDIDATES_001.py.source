"""Prepare reviewed I3 development evidence; invoke no measurement helper."""
import datetime
import hashlib
import json
import os
from pathlib import Path

R = Path(r"D:\Aenv\pro2")
P = R / "WORK/resume-20261015-001/native_parser_implementation_007"
G = R / "github-portable-20261012-001"
C = P / "managed_preparation_001/candidates_001"
REL = "docs/development/native-parser-implementation/20261015-i4/"
CAP = 2097152


def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_pin = fact(P / "ROOT_I4_PARSER_PARENT_CHILD_API_SOURCE_REVIEW_ADOPTION_001.json")
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I4_PARSER_PARENT_CHILD_API_SOURCE_ONLY"
    assert adoption["I4_executed"] is False and adoption["tests_executed"] is False
    scope_pin = fact(P / "ROOT_CURRENT_I4_STATIC_PARSER_PARENT_CHILD_API_IMPLEMENTATION_SCOPE_001.json")
    assert scope_pin["sha256"] == "97ff82f261d1bcf91b40c5ffc26fa95ccb4e248574d266b98ed6570ec6377fa7"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    previous_scope_pin = fact(R / "WORK/resume-20261015-001/native_measurement_implementation_006/managed_preparation_001/candidates_001/EXACT_MANAGED_I4_PARSER_IMPLEMENTATION_PUBLICATION_SCOPE_001.json")
    assert previous_scope_pin["sha256"] == "787d71a02ccd60ff441f724d5ef3e0620b56b9cf1e82fe1d45abd09ef2a19e6b"
    previous = json.loads(pinned(previous_scope_pin))
    rows, evidence, names = [], [], set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = Path(pin["path"])
        assert path.resolve().is_relative_to(P.resolve())
        inert_source = path.suffix in (".py", ".ps1")
        name = path.name + (".source" if inert_source else "")
        assert Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": inert_source})
    add(REL + "evidence-index.json", {
        "schema_version": 1, "record_type": "I4_exact_Parser_parent_child_Source_and_review_evidence_index",
        "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
        "actual_evidence_copy_count": len(evidence), "files": evidence,
        "I4_or_original_helper_import_call_test_native_or_scientific_execution": False,
        "actual_Parser_grant_facts_result_or_family_created": False,
        "current_dated_Source_inventory": {"present": 36, "pending": 9},
        "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}})
    report = """# Current owner Parser parent and child Source port

Root accepted the I4 PowerShell parent, child and API after actual independent Source review and [Root adoption](ROOT_I4_PARSER_PARENT_CHILD_API_SOURCE_REVIEW_ADOPTION_001.json). This completes the I4 authority-context Source port. Both Sources remain unrun. No project helper, Parser, PowerShell Language Parser syntax validation, original fixture or project test ran during this step.

The new authority validators use exact version2 facts27, request32, owner acceptance16 and admission30 with OWNER_DIRECT. Both Sources pin the trusted current Root chat in reviewed Source; JSON cannot choose that trusted identity. Actual owner instruction, retained acceptance bytes, different Source proof and Root adoption precede a future real admission. The Source literal does not authenticate the human or calling process. I0-style owner context alone supplies no Parser permission.

The new pure PowerShell owner-support validators implement the bounded I0 contract without spawning Python or another process. Their Source predicates were compared against the actual I0 Source/API. The earlier17 Python memory-only test methods were not rerun and do not verify this PowerShell port. Current Source review is static; no PowerShell syntax compilation or runtime correctness is claimed.

**All47 protected I/O spans and both complete original mains remain byte-exact.** The original strict readers/codecs/native vectors including LastAccess, retained buffers, owned-handle cleanup, paired input/postread behavior and full capture stay preserved. The parent keeps its exact child argv and one owned hidden child. The original120 total,110 wait,10 cleanup and5 reap budgets remain nonadditive. Four real ParseFile calls, complete token/error arrays and genuine two-literal proofs remain future requirements; no subject evaluation or invocation was added.

**Both Sources have a literal false entry hold before the original main.** Accepted I3 Native8 result support has no qualified carrier in the current closed facts/phase/proof shapes. That route remains UNWIRED; local resampling or a declared birth time cannot substitute for accepted Native8 evidence. External I5 publication/M3 provenance interfaces remain unqualified. A reviewed I3/I4 binding successor must implement the exact later contracts and required chronology. Flipping a flag or JSON approval cannot qualify them.

**The version2 Parser result-envelope route also remains UNWIRED.** The protected mains end with exit and retain schema1 INTENT12, child result20 and physical witness20, including genuine BOUND018 lineage labels. They carry exact real version2 facts/request/admission pins and remain data leaves. No unreachable emitter was appended, no leaf was relabeled, and no old leaf becomes current result authority. A later reviewed saved-result adapter/binding must define the actual version2 envelope, owner/producers, leaf pins and saved-result proof joins before new result authority can be accepted.

The existing protected Read-Fact can initialize native metadata before internal admission validation. This ordering is retained and disclosed. The new false hold prevents current entry; a later qualified route must validate owner purpose before directory creation, child launch and ParseFile. Current validators are not claimed to precede every native initialization.

Source60, lease1200, resource60/RAM1GiB/disk10GiB, phase65536, ordinary2MiB metadata/output/captures and131072 model-export caps remain unchanged. All75 spent identities and prior refusals remain unreplayed. No actual owner grant, lease, selected family/path/ordinal, Parser purpose, process or result was issued. The dated Source family stays **36/45, nine pending**; frozen STEP080 stays **35/45, ten pending**. Fresh fixtures, C8, actual6, recovery, runtime and science remain unentered.

Next is a separately scoped I5 family-specific peer/generic binding/config interface port and qualification. Current I2/I3/I4 dependency holds, accepted-result carriers and the Parser saved-result adapter remain separate required work before actual generation/Native8/Parser admission. This Source milestone grants no execution.

The [evidence index](evidence-index.json) records exact Source/API/inverse/protocol/review copies. Code is retained as inert `.source` files. Absolute paths preserve dated provenance and require fresh bindings elsewhere. This directory does not overlay STEP080. Three navigation prepends preserve complete prior bytes; later Git publication is recorded by external Root receipts and history.
"""
    add(REL + "I4_PARSER_IMPLEMENTATION.md", report.encode())
    prefix = ("**October15 I4 Parser Source port accepted.** The [Parser parent/child report](" + REL + "I4_PARSER_IMPLEMENTATION.md) records owner-direct version2 authority checks with all47 I/O spans and both complete mains preserved. Both Sources remain unrun; accepted Native8 support, I5 interfaces and the version2 saved-result adapter remain explicitly unwired behind false entry guards. Next: separately scope I5 interface work and later reviewed dependency binding. The dated Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        old_bytes = pinned(predecessor)
        saved = save(P / "managed_preparation_001/predecessors_001" / name, old_bytes)
        source = save(C / name, prefix + old_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {
        "schema_version": 1, "record_type": "Root_exact_finite_I4_Parser_Source_implementation_managed_publication_scope",
        "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "base_HEAD": "8f858ae019331d1fc4c8e32f655a9620b75b66e5",
        "managed_file_count": len(rows), "files": rows, "Root_implementation_adoption": adoption_pin,
        "preexisting608_byte_baseline": previous["preexisting608_byte_baseline"],
        "all_frozen_STEP080_sentinels": previous["all_frozen_STEP080_sentinels"],
        "current36_Source_baseline": previous["current36_Source_baseline"],
        "target_execution": False, "tests_executed": False, "I4_executed": False}
    print(json.dumps(save(C / "EXACT_MANAGED_I4_PARSER_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
