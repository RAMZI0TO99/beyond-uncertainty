    return pin,data
def pinned(pin,label):
    actual,raw=fact(pin['path'])
    ck('pin:'+label,type(pin) is dict and set(pin)=={'path','bytes','sha256'} and actual==pin,actual)
    return raw
def allpins(value):
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'} and type(value.get('path')) is str and type(value.get('bytes')) is int:return [value]
        return [p for v in value.values() for p in allpins(v)]
    if type(value) is list:return [p for v in value for p in allpins(v)]
    return []
def terms(mod,fs,fn,items):
