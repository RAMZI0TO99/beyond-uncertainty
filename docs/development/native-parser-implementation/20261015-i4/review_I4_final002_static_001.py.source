def ck(name,passed,evidence=None):
    if any(c['name']==name for c in checks):raise ValueError('duplicate check '+name)
    checks.append({'name':name,'passed':bool(passed),'evidence':evidence})
def obj(path):
    pin,raw=fact(path)
