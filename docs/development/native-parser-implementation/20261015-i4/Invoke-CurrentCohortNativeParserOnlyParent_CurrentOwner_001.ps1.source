        $wire=[byte[]]::new(52);[Runtime.InteropServices.Marshal]::Copy($memory,$wire,0,52)
        return ,@([BitConverter]::ToUInt32($wire,0),[BitConverter]::ToInt64($wire,4),[BitConverter]::ToInt64($wire,12),[BitConverter]::ToInt64($wire,20),[BitConverter]::ToUInt32($wire,28),[BitConverter]::ToUInt32($wire,32),[BitConverter]::ToUInt32($wire,36),[BitConverter]::ToUInt32($wire,40),[BitConverter]::ToUInt32($wire,44),[BitConverter]::ToUInt32($wire,48))
