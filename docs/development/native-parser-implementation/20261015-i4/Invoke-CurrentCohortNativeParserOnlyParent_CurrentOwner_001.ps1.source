    Require ($item.Exists -and ([int]$item.Attributes -band 1024) -eq 0) 'Ordinary non-reparse native path file'
    return ,@($item.FullName,[long]$item.Length,$item.CreationTimeUtc.Ticks,$item.LastWriteTimeUtc.Ticks,$item.LastAccessTimeUtc.Ticks,[int]$item.Attributes,[bool]$item.Exists,$item.DirectoryName,$item.Name)
}
function Read-Whole([IO.FileStream]$Stream,[long]$ExpectedLength,[long]$Cap) {
    Require ($ExpectedLength -gt 0 -and $ExpectedLength -le $Cap -and $Stream.Length -eq $ExpectedLength) 'Exact original Source/input byte cap'
    $buffer=[byte[]]::new([int]$ExpectedLength);$Stream.Position=0;$offset=0
    while($offset -lt $buffer.Length){$got=$Stream.Read($buffer,$offset,$buffer.Length-$offset);Require ($got -gt 0) 'Complete held Source read';$offset+=$got}
    Require ($Stream.ReadByte() -eq -1) 'No trailing unpinned bytes'
