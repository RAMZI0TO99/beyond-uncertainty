function Skip-JsonSpace([hashtable]$State) {while($State.offset -lt $State.text.Length -and " `t`r`n".Contains($State.text[$State.offset])){$State.offset++}}
function Parse-JsonString([hashtable]$State) {
    Require ($State.offset -lt $State.text.Length -and $State.text[$State.offset] -eq '"') 'JSON string begins'
    $State.offset++;$builder=[Text.StringBuilder]::new()
