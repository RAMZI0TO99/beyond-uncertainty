    $attrs=[Reflection.MethodAttributes]::Public -bor [Reflection.MethodAttributes]::Static -bor [Reflection.MethodAttributes]::PinvokeImpl
    $method=$type.DefinePInvokeMethod('GetFileInformationByHandle','kernel32.dll',$attrs,[Reflection.CallingConventions]::Standard,[bool],[type[]]@([IntPtr],[IntPtr]),[Runtime.InteropServices.CallingConvention]::Winapi,[Runtime.InteropServices.CharSet]::Unicode)
    $method.SetImplementationFlags($method.GetMethodImplementationFlags() -bor [Reflection.MethodImplAttributes]::PreserveSig)
    $directory=$type.DefinePInvokeMethod('CreateDirectoryW','kernel32.dll',$attrs,[Reflection.CallingConventions]::Standard,[bool],[type[]]@([string],[IntPtr]),[Runtime.InteropServices.CallingConvention]::Winapi,[Runtime.InteropServices.CharSet]::Unicode)
    $directory.SetImplementationFlags($directory.GetMethodImplementationFlags() -bor [Reflection.MethodImplAttributes]::PreserveSig)
    $script:NativeType=$type.CreateType()
}
function Native-Handle10([IO.FileStream]$Stream) {
    Require (-not $Stream.SafeFileHandle.IsInvalid -and -not $Stream.SafeFileHandle.IsClosed) 'Retained valid file handle'
