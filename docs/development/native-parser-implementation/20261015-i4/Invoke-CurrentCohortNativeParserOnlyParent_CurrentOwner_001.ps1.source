function Read-JsonFact([object]$Fact,[long]$Cap=2097152) {return Decode-Strict (Read-Fact $Fact $Cap)}
function Same-Fact([object]$Left,[object]$Right) {Require-Keys $Left @('path','sha256','bytes');Require-Keys $Right @('path','sha256','bytes');Integer $Left.bytes 1 2097152;Integer $Right.bytes 1 2097152;return $Left.path -ceq $Right.path -and $Left.sha256 -ceq $Right.sha256 -and $Left.bytes -eq $Right.bytes}
