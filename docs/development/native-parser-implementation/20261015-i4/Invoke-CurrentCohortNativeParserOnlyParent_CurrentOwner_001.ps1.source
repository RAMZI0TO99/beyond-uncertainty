                'b'{[void]$builder.Append([char]8)};'f'{[void]$builder.Append([char]12)};'n'{[void]$builder.Append([char]10)};'r'{[void]$builder.Append([char]13)};'t'{[void]$builder.Append([char]9)}
                'u'{Require ($State.offset+4 -le $State.text.Length) 'Complete unicode escape';$hex=$State.text.Substring($State.offset,4);Require ($hex -cmatch '^[0-9a-fA-F]{4}$') 'Unicode escape hex';[void]$builder.Append([char][Convert]::ToInt32($hex,16));$State.offset+=4}
