        try {
            $handleBefore=Native-Handle10 $stream
            Require ($handleBefore[7] -eq $(if($Image){2}else{1}) -and ([int]$handleBefore[0] -band 1024) -eq 0) 'Actual handle exact image2 or ordinary1 link count/no reparse'
            Require ($before[1] -eq $stream.Length -and $before[2] -eq [DateTime]::FromFileTimeUtc($handleBefore[1]).Ticks -and $before[3] -eq [DateTime]::FromFileTimeUtc($handleBefore[3]).Ticks -and $before[5] -eq $handleBefore[0]) 'Actual native path/handle shared size/creation/write/attributes linked'
            $old=[ordered]@{fact=$Fact;cap=$Cap;image=$Image;stream=$stream;path9=$before;handle10=$handleBefore;bytes=$null}
            $script:Inputs.Add($path,$old);$script:InputOrder.Add($path)
        } catch {$stream.Dispose();throw}
    }
    $first=Read-Whole $stream ([long]$Fact.bytes) $Cap;$second=Read-Whole $stream ([long]$Fact.bytes) $Cap
    $pathAfter=Native-Path9 $path;$handleAfter=Native-Handle10 $stream
    Require ((Same-Bytes $first $second) -and (Sha-Bytes $first) -ceq $Fact.sha256) 'Double complete buffers match actual pin'
    Require ((Same-Vector $old.path9 $pathAfter) -and (Same-Vector $old.handle10 $handleAfter)) 'Both complete named native APIs independently unchanged'
