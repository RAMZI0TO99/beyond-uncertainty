        else{while($true){Parse-JsonValue $State;Skip-JsonSpace $State;Require ($State.offset -lt $State.text.Length) 'Complete array';$sep=$State.text[$State.offset];$State.offset++;if($sep -eq ']'){break};Require ($sep -eq ',') 'Array separator'}}
