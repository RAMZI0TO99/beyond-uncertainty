    foreach($row in @($Observation.path9,$Observation.descriptor9)){foreach($cell in $row){Integer $cell 0 ([long]::MaxValue)}}
    foreach($index in @(0,1,2,3,6,7,8)){Require ($Observation.path9[$index] -eq $Observation.descriptor9[$index]) 'Actual original shared7 identity'}
    Require ($Observation.path9[2] -eq $Fact.bytes -and $Observation.path9[6] -eq $Links -and $Observation.descriptor9[6] -eq $Links -and ($Observation.path9[7] -band 1024) -eq 0 -and ($Observation.descriptor9[7] -band 1024) -eq 0 -and ($Observation.path9[5] -band 61440) -eq 32768 -and ($Observation.descriptor9[5] -band 61440) -eq 32768) 'Exact ordinary regular-file/link/preflight metadata without cross-API ctime equality'
}
function Active-Window([bool]$Launching=$false) {
    Require ($null -ne $script:LiveGate -and $null -ne $script:LiveAdmission) 'Live reviewed Source and separate exact Parser admission loaded'
    $now=[DateTimeOffset]::UtcNow;$gb=Moment $script:LiveGate.interval_start;$ge=Moment $script:LiveGate.interval_end;$pb=Moment $script:LiveAdmission.interval_start;$pe=Moment $script:LiveAdmission.interval_end
    Require ($gb -le $now -and $pb -le $now -and $now.AddSeconds(60) -lt $ge -and $now.AddSeconds(60) -lt $pe) 'Current exact intervals and original60 publication reserve'
    if($Launching){Require ($now.AddSeconds(180) -lt $ge -and $now.AddSeconds(180) -lt $pe) 'Worst-case120 owned budget plus retained publication60 fit; neither limit extended'}
}
function Absent([string]$Path) {Require (-not [IO.File]::Exists($Path) -and -not [IO.Directory]::Exists($Path)) 'Actual fresh file/staging identity absent'}
function Own-OutputPath([string]$Path,[string]$RunDirectory) {
    Require ($Path -is [string] -and [IO.Path]::GetFullPath($Path) -ceq $Path -and [IO.Path]::GetDirectoryName($Path) -ceq $RunDirectory) 'Exact Root-selected ordinary owned output leaf'
