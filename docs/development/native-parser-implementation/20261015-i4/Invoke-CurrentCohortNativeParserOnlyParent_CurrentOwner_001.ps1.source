    if($null -ne $closeFailure){throw ('Held input close failed: '+$closeFailure)}
}
function Decode-Strict([byte[]]$Bytes) {
    Require ($Bytes.Length -gt 0 -and $Bytes.Length -le 2097152 -and -not ($Bytes.Length -ge 3 -and $Bytes[0] -eq 239 -and $Bytes[1] -eq 187 -and $Bytes[2] -eq 191)) 'Ordinary strict JSON no BOM/cap'
