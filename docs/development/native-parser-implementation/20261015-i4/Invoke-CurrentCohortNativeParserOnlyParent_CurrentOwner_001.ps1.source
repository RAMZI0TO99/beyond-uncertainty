    $path=[string]$Fact.path
    if($Image){Require ([string]::Equals($path,$script:ImagePath,[StringComparison]::OrdinalIgnoreCase) -and $Fact.sha256 -ceq $script:ImageSha -and $Fact.bytes -eq 454656) 'Only fixed exact native image has two-link exception'}
    else {Require ($path.StartsWith('D:\Aenv\pro2\',[StringComparison]::Ordinal) -or $path.StartsWith('D:\Aenv\pro3\runs\coordination\',[StringComparison]::Ordinal)) 'Finite actual input namespaces'}
    if($script:Inputs.ContainsKey($path)){
