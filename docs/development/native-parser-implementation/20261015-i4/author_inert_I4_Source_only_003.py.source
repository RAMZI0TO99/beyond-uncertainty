ADDENDUM=pin(P/'ROOT_I4_COMPATIBLE_PROOF13_ROOT9_AND_PREREQUISITE_SOURCE_BINDING_ADDENDUM_001.json')
ENUM=exact(P/'ROOT_I4_EXACT_OWNER_DIRECT_ADMISSION_DECISION_ENUM_SOURCE_CLARIFICATION_001.json',940,'ea5a6a2cd45788acd544323d66106c7fcaf2efeaf4ae14163233aeb8d350bd8f')
assert read(Path(ADOPTION['path']))['author']=='/root'
assert read(Path(ENUM['path']))['required_exact_value']=='ADMIT_REVIEWED_FOUR_CURRENT_COHORT_PARSEFILE_ONLY_OWNER_DIRECT'
