scope_fixed.update(schema_version=2,record_type='Root_owner_v2_native_metadata_Source_preparation_scope',author='/root',operation_scope='EXACT8_NATIVE_SOURCE_METADATA_AND_SEPARATELY_ADMITTED_PARSER4_ONLY',scope_stage='SEPARATELY_GRANTED_METADATA_PREPARATION',read_only_native_metadata_authority=True)
CONSTANTS='\n# Current owner-v2 context; historical Source024 constants below are provenance only.\n'
for name,value in dict(ActualSourceEditor=AUTHOR,CurrentAPIPath=str(API_PATH),CurrentProtocolPin=PROTOCOL,I0SourcePin=protocol['fixed_I0_Source'],I0APIPin=protocol['fixed_I0_API'],I1APIPin=protocol['fixed_I1_API'],OwnerSupportKeys3=I0['schema_fields']['support3'],OwnerScopeKeys28=I0['schema_fields']['owner_scope28_v2'],OwnerWitnessKeys9=I0['schema_fields']['retained_witness9_v2'],OwnerFullProofKeys15=I0['schema_fields']['full_Source_proof15_v2']).items():
 CONSTANTS+='$script:'+name+' = '+ps(value)+'\n'
CONSTANTS+='$script:OwnerScopeFixed = [ordered]@{'+(';'.join(str(k)+'='+ps(v) for k,v in scope_fixed.items()))+'}\n'
CONSTANTS+='$script:OwnerAdmissionDecision = '+ps(read(Path(ENUM['path']))['required_exact_value'])+'\n'

def replace_once(source,old,new):
 assert source.count(old)==1,(old[:160],source.count(old))
 return source.replace(old,new,1)
def replace_schema(source,var,schema):
 return re.sub(r'(?m)^\$script:'+re.escape(var)+r' = [^\r\n]+',lambda m:'$script:'+var+' = '+ps(schemas[schema]['keys']),source,count=1)

def dedicated_lease(which):
 s=original_functions[which]['Validate-DedicatedLeasePublication'][2]
 for field in ('decision','publication','candidateReceipt','producerFact'):
  s=s.replace('Integer $'+field+'.schema_version 1 1','Integer $'+field+'.schema_version 2 2')
 mapping={'Root_separate_Source024_prospective_closed12_lease_issuance_decision':'Root_owner_v2_prospective_lease_issuance_decision','Root_actual_Source024_exact_reviewed_closed12_lease_Source_publication':'Root_owner_v2_prospective_lease_original_publication','Root_actual_Source024_prospective_closed12_lease_candidate_receipt':'Root_owner_v2_prospective_lease_candidate_author_receipt','Root_deferred_Source024_prospective_lease_metadata_facts':'Root_owner_v2_prospective_lease_metadata_facts','ROOT_SOURCE024_PROSPECTIVE_LEASE_CANONICAL_PUBLICATION_RECEIPT_001.json':'ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_CANONICAL_PUBLICATION_RECEIPT_003.json','ROOT_SOURCE024_PROSPECTIVE_LEASE_CANDIDATE_RECEIPT_001.json':'ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_CANDIDATE_RECEIPT_003.json','ROOT_SOURCE024_PROSPECTIVE_LEASE_AUTHOR_FACTS_001.json':'ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_AUTHOR_FACTS_001.json','ROOT_SOURCE024_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json':'ROOT_CURRENT_OWNER_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json'}
 for before,after in mapping.items():s=s.replace(before,after)
 s=s.replace('.Source024_support.gate','.current_owner_support.current_owner_scope').replace('.Source024','.current_owner_scope')
 s=s.replace(".metadata_tool_Source_author -ceq '/root/runtime_audit'",".metadata_tool_Source_author -ceq '/root/phase_frontier'")
 needle="        [void](Read-Fact $producerFact.tool_source);[void](Read-Fact $producerFact.tool_review);[void](Read-Fact $producerFact.tool_Root_adoption)"
 extra="""        Require-Keys $producerFact.current_owner_support $script:OwnerSupportKeys3
        Require ((Same-Fact $producerFact.current_owner_support.different_current_owner_scope_Source_review $Facts.Source_preparation_review) -and (Same-Fact $producerFact.current_owner_support.current_owner_scope_Root_adoption $Facts.Source_preparation_Root_adoption)) 'Strict actual I1 support3 joins current owner review and Root adoption'
        [void](Read-ContextPin $script:I1APIPin)
        $actualToolReview=Lease-CandidateSourceReview $producerFact.tool_review @($producerFact.tool_source,$script:I1APIPin)
        Require-ActualToolCodeAcceptance $producerFact.tool_Root_adoption $producerFact.tool_review $actualToolReview $producerFact.tool_source $script:I1APIPin $script:ActualSourceEditor
"""
 s=replace_once(s,needle,needle+'\n'+extra)
 s=s.replace('Read-JsonFact','Read-OwnerObjectFact').replace('Decode-Strict','Decode-OwnerObject')
 return s

def candidate_review(which):
 s=original_functions[which]['Lease-CandidateSourceReview'][2]
 s=s.replace("$review.reviewer -cin @('/root/runtime_audit','/root/m3_source_editor','/root/owner_docs_review','/root/actual_record_checker','/root/pipeline_source_editor')","$review.reviewer -cmatch '\\A/root(?:/[A-Za-z0-9_-]+)+\\z'")
 s=s.replace("$review.reviewer -cne '/root/runtime_audit'","$review.reviewer -cne '/root/phase_frontier' -and -not $review.reviewer.StartsWith('/root/phase_frontier/',[StringComparison]::Ordinal) -and $review.reviewer -cne '/root/runtime_audit'")
 s=s.replace("$review.verdict.StartsWith('PASS_',[StringComparison]::Ordinal)","$review.verdict.StartsWith('PASS_',[StringComparison]::Ordinal) -and $review.verdict.ToUpperInvariant().Contains('SOURCE')")
 needle='    [void](Read-Fact $review.full_proof)'
 extra="""    $full=Read-JsonFact $review.full_proof
    Require ($full.reviewer -ceq $review.reviewer -and $full.verdict -ceq $review.verdict) 'Actual dedicated candidate fullproof reviewer/verdict joins'
    Integer $full.checks_failed 0 0;Owner-Exact $full.target_execution $false;Owner-Exact $full.operational_authority $false
    Require ($full.checks -is [Array]) 'Actual finite dedicated producer Source checks';Integer $full.checks.Count 1 10000
    foreach($check in $full.checks){Owner-Text $check.name 4096;Owner-Exact $check.passed $true}
    foreach($subject in $Subjects){Require (Contains-LeaseProducerFact $full $subject) 'Dedicated fullproof covers exact producer subject'}
    Require ((Moment $full.created_utc) -le (Moment $review.created_utc)) 'Actual fullproof precedes dedicated producer capsule'
"""
 s=replace_once(s,needle,extra.rstrip())
 return s.replace('Read-JsonFact','Read-OwnerObjectFact')

def admission(which):
 s=original_functions[which]['Validate-Admission'][2]
 first=s.index('\n')+1
 s=s[:first]+"    Require ($script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED -is [bool] -and $script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED) 'Current owner dependency binding Source hold'\n    Require-QualifiedParserInterfaces\n    $Facts=Decode-OwnerObject $script:Inputs[[string]$FactsPin.path].bytes\n    $Admission=Decode-OwnerObject $script:Inputs[[string]$AdmissionPin.path].bytes\n"+s[first:]
 for v in ('Facts','Admission','request','response','pathSelection','sourceAuthorReceipt'):
  s=s.replace('Integer $'+v+'.schema_version 1 1','Integer $'+v+'.schema_version 2 2').replace('$'+v+'.schema_version -eq 1','$'+v+'.schema_version -eq 2')
 for old,new in {'Root_four_BOUND018_native_Parser_only_actual_facts':schemas['Parser_facts27_v2']['new_record_type'],'Root_four_BOUND018_native_Parser_only_execution_admission':schemas['Parser_admission30_v2']['new_record_type'],'ADMIT_REVIEWED_FOUR_BOUND018_NATIVE_PARSEFILE_ONLY':'ADMIT_REVIEWED_FOUR_CURRENT_COHORT_PARSEFILE_ONLY_OWNER_DIRECT','Root_exact_four_BOUND018_native_Parser_only_purpose_request':schemas['Parser_request32_v2']['new_record_type'],'Pro3_genuine_four_BOUND018_native_Parser_only_response':schemas['Parser_owner_acceptance16_v2']['new_record_type'],'ACCEPT_EXACT_FOUR_BOUND018_NATIVE_PARSEFILE_ONLY':'ACCEPT_EXACT_PARSER_ONLY_PURPOSE_OWNER_DIRECT','Root_Source024_actual_separate_future45_Source_path_selection':schemas['selected45_decision13_v2']['new_record_type'],'Source024_actual_deferred_M3_Source_draft_author_receipt':'Root_owner_v2_actual_deferred_M3_Source_draft_author_receipt'}.items():s=s.replace(old,new)
 for old,new in schemas['Parser_admission30_v2']['explicit_field_renames'].items():s=s.replace('$Admission.'+old,'$Admission.'+new)
 s=s.replace('$request.peer_thread','$request.authority_mode').replace('$response.author_thread','$response.author').replace('$response.peer_thread','$response.authority_mode')
 # Replace the historical roster-bound context block with typed owner28; old source constants remain inert provenance.
 start=s.index('    foreach($field in $script:FixedHistoricalSupport.Keys)')
 end=s.index('    foreach($pin in @($Facts.Source_preparation_review',start)
 new="""    $gate=Read-JsonFact $Facts.Source_preparation
    Require (Same-Fact $Admission.Source_preparation $Facts.Source_preparation) 'Actual admission binds exact new owner scope pin'
    $ownerContext=Validate-CurrentOwnerSupport $Facts $gate
    Owner-Exact $Admission.Root_thread $script:RootThread;Owner-Exact $Admission.authority_mode 'OWNER_DIRECT'
"""
 s=s[:start]+new+s[end:]
 # API pin is selected only from the one reviewed exact known path, not a new facts/argv field.
 s=replace_once(s,"    $implementationSubjects=@($Facts.native_parent,$Facts.parser_child)","    $apiPin=Validate-ImplementationAPI $Facts\n    $implementationSubjects=@($Facts.native_parent,$Facts.parser_child,$apiPin,$script:I0SourcePin,$script:I0APIPin)")
 s=s.replace("Different-Review $Facts.implementation_Source_review $implementationSubjects '/root/owner_docs_review'","Different-Review $Facts.implementation_Source_review $implementationSubjects $script:ActualSourceEditor")
 start=s.index('    $currentDesign=Read-JsonFact $Facts.prerequisite_design')
 end=s.index('    [void](Different-Review $Facts.Root_future_path_review',start)
 new="""    Require (Same-Fact $Facts.prerequisite_design $script:CurrentProtocolPin) 'Exact reviewed static current I4 protocol Source, never old Source024 design cast'
    $currentDesign=Read-JsonFact $Facts.prerequisite_design;Integer $currentDesign.schema_version 1 1
    Require ($currentDesign.record_type -ceq 'Root_I4_exact_owner_direct_Parser_Source_protocol_not_grant' -and $currentDesign.author -ceq '/root' -and $currentDesign.authority.mode -ceq 'OWNER_DIRECT' -and $currentDesign.authority.trusted_Root_thread_Source_literal -ceq $script:RootThread -and $null -eq $currentDesign.actual_future_decisions) 'Exact static protocol authority specification and actual Root literal, not a future owner scope or grant'
    Owner-Exact $currentDesign.target_execution $false;Owner-Exact $currentDesign.operational_authority $false;Owner-Exact $currentDesign.scientific_authority $false;Owner-Exact $currentDesign.all_specification_cells_are_not_issued_grants $true
"""
 s=s[:start]+new+s[end:]
 s=s.replace('$pathSelection.Source024','$pathSelection.current_owner_scope')
 # Acceptance16 author/mode joins are explicit Owner Direct, never an invented peer response.
 s=s.replace("$response.author -ceq $Admission.authority_mode -and $response.authority_mode -ceq $Admission.Root_thread","$response.author -ceq '/root' -and $response.authority_mode -ceq 'OWNER_DIRECT'")
 s=replace_once(s,"    Integer $request.schema_version 2 2;Integer $response.schema_version 2 2","    Integer $request.schema_version 2 2;Integer $response.schema_version 2 2\n    Owner-Exact $request.Root_thread $script:RootThread;Owner-Exact $request.authority_mode 'OWNER_DIRECT';Owner-Exact $response.Root_thread $script:RootThread;Owner-Exact $response.authority_mode 'OWNER_DIRECT'")
 # The proof is checked after all known metadata preflight, for complete acyclic input coverage.
 marker="    [void](Different-Review $Admission.owner_acceptance_Source_review @($Admission.request,$Admission.owner_purpose_acceptance,$Admission.retained_owner_acceptance_copy) '/root');Root-Adoption $Admission.owner_acceptance_Root_adoption $Admission.owner_acceptance_Source_review @($Admission.request,$Admission.owner_purpose_acceptance,$Admission.retained_owner_acceptance_copy)"
 s=replace_once(s,marker,'')
 s=s.replace("'Source024','actual_Source_packet'","'current_owner_scope','actual_Source_packet'").replace('$sourceAuthorReceipt.Source024','$sourceAuthorReceipt.current_owner_scope')
 s=s.replace("$sourceAuthorReceipt.author -ceq '/root/m3_source_editor'","$sourceAuthorReceipt.author -ceq '/root'")
 s=s.replace('Integer $chosen[0].selected_ordinal 1 ([long]::MaxValue)','Integer $chosen[0].selected_ordinal 19 ([long]::MaxValue)').replace('Integer $chosenTemplate[0].selected_ordinal 1 ([long]::MaxValue)','Integer $chosenTemplate[0].selected_ordinal 19 ([long]::MaxValue)')
 s=s.replace("$sourceReceiptRole.preparation_Source_author -ceq '/root/m3_source_editor'","$sourceReceiptRole.preparation_Source_author -ceq $sourceAuthorReceipt.steps.metadata_Source_provenance.actual_implementation_Source_editor")
 s=s.replace("$phaseSourceReview.reviewer -cne '/root/m3_source_editor' -and -not $phaseSourceReview.reviewer.StartsWith('/root/m3_source_editor/',[StringComparison]::Ordinal)","$phaseSourceReview.reviewer -cne $actualMetadataSourceEditor -and -not $phaseSourceReview.reviewer.StartsWith($actualMetadataSourceEditor+'/',[StringComparison]::Ordinal)")
 s=replace_once(s,"            Require ((Moment $sourceAuthorReceipt.created_utc) -le (Moment $proof.actual_Source_birth_utc))", "            $actualMetadataSourceEditor=Validate-KnownM3ReceiptProvenance $sourceAuthorReceipt $sourceReceiptRole $proof.subject $Facts $proof.actual_Source_author_receipt\n            Require ((Moment $sourceAuthorReceipt.created_utc) -le (Moment $proof.actual_Source_birth_utc))")
 before='    $script:LiveGate=$gate;$script:LiveAdmission=$Admission'
 proof="""    $purposeSubjects=Parser-PurposeInputs $Admission $AdmissionPin $Facts
    $ownerAcceptanceReview=Different-Review $Admission.owner_acceptance_Source_review $purposeSubjects '/root'
    Root-Adoption $Admission.owner_acceptance_Root_adoption $Admission.owner_acceptance_Source_review $purposeSubjects
    $ownerAcceptanceAdoption=Decode-Strict $script:Inputs[[string]$Admission.owner_acceptance_Root_adoption.path].bytes
    Require ((Moment $response.created_utc) -le (Moment $ownerAcceptanceReview.created_utc) -and (Moment $ownerAcceptanceAdoption.created_utc) -le (Moment $Admission.created_utc)) 'Real owner acceptance then different full-input Source proof then Root adoption precede actual admission'
    $purposeSubjectsAfter=Parser-PurposeInputs $Admission $AdmissionPin $Facts
    Require ((Sha-Bytes (Json-Bytes $purposeSubjects)) -ceq (Sha-Bytes (Json-Bytes $purposeSubjectsAfter))) 'Complete known bootstrap metadata closure, ownproof/admission excluded; later unknown I3/I5 binding stays unwired'
"""
 s=replace_once(s,before,proof+before)
 s=s.replace('Read-JsonFact','Read-OwnerObjectFact').replace('Decode-Strict','Decode-OwnerObject')
 s=s.replace('metadata worker M3 and physical editor Root remain distinct','Root physical serializer and real helper implementation editor remain distinct').replace('Actual Root13 metadata worker, exact role','Actual Root13 preparation editor, exact role').replace('Retain metadata worker M3 and subtree reviewer exclusions','Retain actual helper Source editor and subtree reviewer exclusions')
 return s

M3_PS=r'''
function Validate-KnownM3ReceiptProvenance([object]$Receipt,[object]$SelectedRow,[object]$Canonical,[object]$Facts,[object]$ReceiptPin) {
    Require ($script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED -is [bool] -and $script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED) 'Known M3 schema predicates remain behind held I5/native-support binding'
    Require-Keys $Receipt $script:M3ReceiptKeys22;Integer $Receipt.schema_version 2 2
    Require ($Receipt.record_type -ceq 'Root_owner_v2_actual_deferred_M3_Source_draft_author_receipt' -and $Receipt.author -ceq '/root' -and $Receipt.actual_physical_Source_editor -ceq '/root') 'Known22 Root physical serializer, distinct actual helper Source editor and semantic author'
    Require ($Receipt.finite_actual_Source_observations -is [Array]) 'Known actual finite Source observation list'
    $sourceFacts=Decode-OwnerObject (Read-ContextPin $Receipt.actual_Source_packet)
    Require-Keys $sourceFacts $script:M3FactsKeys21;Integer $sourceFacts.schema_version 2 2
    Require ($sourceFacts.record_type -ceq 'Root_owner_v2_exact_M3_Source_stage_purpose_and_facts' -and $sourceFacts.author -ceq '/root' -and $sourceFacts.Root_thread -ceq $script:RootThread -and (Same-Fact $sourceFacts.current_owner_scope $Facts.Source_preparation)) 'Actual known M3 facts21 Root/current owner context'
    Owner-Exact $sourceFacts.source_only $true
    foreach($flag in @('target_execution','operational_authority','canonical_publication','native_Parser_authority')){Owner-Exact $sourceFacts.$flag $false}
    Require-Keys $sourceFacts.lease_support @('canonical','separate_Root_decision','different_review','Root_adoption','original_publication')
    Require-Keys $sourceFacts.selection_support @('selection','different_review','Root_adoption')
    Require ((Same-Fact $sourceFacts.lease_support.canonical $Facts.canonical_lease) -and (Same-Fact $sourceFacts.selection_support.selection $Facts.Root_future_path_selection)) 'Known M3 facts exact real lease/selection, not historical context'
    Require-Keys $sourceFacts.tool_support @('Source','API','different_review','Root_adoption')
    Require-Keys $Receipt.steps @('complete_inverse','actual_diff_removed_byte_basis','actual_check_codec','metadata_Source_provenance')
    $provenance=$Receipt.steps.metadata_Source_provenance
    Require-Keys $provenance @('Source','API','actual_implementation_Source_editor','historical_implementation_Source_editor','stage_purpose','resource_observation')
    Owner-Actor $provenance.actual_implementation_Source_editor
    Require ($provenance.historical_implementation_Source_editor -ceq '/root/pipeline_source_editor' -and $SelectedRow.preparation_Source_author -ceq $provenance.actual_implementation_Source_editor -and (Same-Fact $provenance.Source $sourceFacts.tool_support.Source) -and (Same-Fact $provenance.API $sourceFacts.tool_support.API)) 'Actual selected preparation author and real helper Source/API/editor, historical nominal separate'
    Require (-not (Same-Fact $provenance.Source $script:HeldI2SourcePin) -and -not (Same-Fact $provenance.API $script:HeldI2APIPin)) 'Held I2Source002/API cannot be actual eight-Source generator'
    [void](Read-ContextPin $provenance.Source)
    $helperAPI=Decode-OwnerObject (Read-ContextPin $provenance.API);Integer $helperAPI.schema_version 2 2
    Require ($helperAPI.record_type -ceq 'Root_owner_v2_M3_deferred_metadata_inert_API' -and $helperAPI.author -ceq $provenance.actual_implementation_Source_editor -and $helperAPI.actual_binding_Source_editor -ceq $provenance.actual_implementation_Source_editor -and (Same-Fact $helperAPI.Source $provenance.Source)) 'Actual M3 helper API exact Source/editor/provenance crossjoins'
    Owner-Exact $helperAPI.external_canonical_receipt_ABI_qualified $true
    $actualToolReview=Lease-CandidateSourceReview $sourceFacts.tool_support.different_review @($provenance.Source,$provenance.API)
    Require-ActualToolCodeAcceptance $sourceFacts.tool_support.Root_adoption $sourceFacts.tool_support.different_review $actualToolReview $provenance.Source $provenance.API $provenance.actual_implementation_Source_editor
    $purpose=$provenance.stage_purpose;Require-Keys $purpose @('schema_version','stage','role','facts','inputs','output_paths');Integer $purpose.schema_version 2 2
    Require ($purpose.stage -ceq $sourceFacts.stage -and (Same-Fact $purpose.facts $Receipt.actual_Source_packet) -and $purpose.inputs -is [Array] -and $purpose.output_paths -is [Array]) 'Known exact Source-stage purpose refers to real facts21'
    $templateRoles=@($script:RoleOrder|ForEach-Object{$_.Substring(0,$_.Length-6)+'_template'})
    if($sourceFacts.stage -ceq 'templates'){
        Require ($null -eq $sourceFacts.role -and $null -eq $purpose.role -and $SelectedRow.role -cin $templateRoles) 'Template facts/purpose role null, selected actual template receipt role'
        $stageRoles=@('capture_template')+$templateRoles
    }else{
        Require ($sourceFacts.stage -ceq 'phase_bound' -and $sourceFacts.role -ceq $SelectedRow.role -and $purpose.role -ceq $SelectedRow.role -and $SelectedRow.role -cin $script:RoleOrder) 'Phase-bound facts/purpose exact selected bound role'
        $stageRoles=@($SelectedRow.role)
    }
    Require ((Same-Fact $Receipt.draft ([pscustomobject]@{path=$SelectedRow.draft_path;bytes=$Canonical.bytes;sha256=$Canonical.sha256})) -and (Same-Fact $Receipt.predecessor $SelectedRow.predecessor)) 'Known receipt exact draft path plus actual canonical SHA/bytes and genuine predecessor'
    foreach($inputPin in $purpose.inputs){Owner-Pin $inputPin}
    foreach($requiredPin in @($Receipt.actual_Source_packet,$provenance.Source,$provenance.API,$Facts.Source_preparation,$Facts.canonical_lease,$Facts.Root_future_path_selection)){
        $matches=@($purpose.inputs|Where-Object{Same-Fact $_ $requiredPin})
        Require ($matches.Count -eq 1) 'Known M3 purpose directly declares each exact facts21/helper/current scope/lease/selection fact3'
    }
    $selection=Read-OwnerObjectFact $Facts.Root_future_path_selection
    $helperHere=[IO.Path]::GetDirectoryName([string]$provenance.Source.path)
    $expectedOutputs=[Collections.Generic.List[string]]::new();$seenOutputs=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach($stageRole in $stageRoles){
        $chosen=@($selection.rows|Where-Object{$_.role -ceq $stageRole});Require ($chosen.Count -eq 1) 'One exact selected row per known M3 stage role'
        $draftPath=[string]$chosen[0].draft_path
        $diffPath=$helperHere+'\source_diffs\'+[IO.Path]::GetFileName($draftPath)+'.diff'
        $receiptPath=$helperHere+'\stage_receipts\ROOT_CURRENT_OWNER_'+$stageRole.ToUpperInvariant()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json'
        foreach($path in @($draftPath,$diffPath,$receiptPath)){Require ($seenOutputs.Add($path)) 'Known stage output paths exact and distinct';$expectedOutputs.Add($path)}
    }
    $expectedOutputs.Sort([StringComparer]::Ordinal)
    Require ($purpose.output_paths.Count -eq $expectedOutputs.Count) 'Exact finite known M3 stage output whitelist count'
    for($i=0;$i -lt $expectedOutputs.Count;$i++){Require ($purpose.output_paths[$i] -is [string] -and $purpose.output_paths[$i] -ceq $expectedOutputs[$i]) 'Exact ordinal-sorted draft/diff/receipt output routes, no arbitrary paths'}
    Owner-Pin $ReceiptPin
    Require ($ReceiptPin.path -ceq ($helperHere+'\stage_receipts\ROOT_CURRENT_OWNER_'+$SelectedRow.role.ToUpperInvariant()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json') -and $Receipt.diff.path -ceq ($helperHere+'\source_diffs\'+[IO.Path]::GetFileName([string]$SelectedRow.draft_path)+'.diff')) 'Actual known receipt and diff routes derived from exact selected role and real helper namespace'
    $resource=$provenance.resource_observation;Require-Keys $resource @('observed_utc','available_RAM_bytes','free_disk_bytes')
    Integer $resource.available_RAM_bytes 1073741824 ([long]::MaxValue);Integer $resource.free_disk_bytes 10737418240 ([long]::MaxValue)
    $factsCreated=Owner-Ticks $sourceFacts.created_utc;$resourceObserved=Owner-Ticks $resource.observed_utc;$receiptCreated=Owner-Ticks $Receipt.created_utc
    Require ($factsCreated -le $resourceObserved -and $resourceObserved -le $receiptCreated) 'Known M3 Source creation resource chronology; this historical stage observation is not fresh Parser prelaunch evidence'
    return [string]$provenance.actual_implementation_Source_editor
}
'''
AUTHORITY_PS+=r'''
function Require-ActualToolCodeAcceptance([object]$AdoptionPin,[object]$ReviewPin,[object]$Review,[object]$Source,[object]$API,[object]$ActualEditor) {
    Owner-Actor $ActualEditor;Owner-Actor $Review.reviewer
    Require ($Review.reviewer -cne $ActualEditor -and -not $Review.reviewer.StartsWith($ActualEditor+'/',[StringComparison]::Ordinal)) 'Actual tool-code reviewer excludes real dynamic implementation Source editor and subtree'
    Require ((Contains-LeaseProducerFact $Review $Source) -and (Contains-LeaseProducerFact $Review $API)) 'Actual tool Source review covers exact Source and API whole pins'
    Owner-Pin $Review.full_proof
    $adoption=Read-OwnerObjectFact $AdoptionPin
    Require ($adoption.author -ceq '/root' -and $adoption.verdict -is [string] -and $adoption.verdict.StartsWith('ACCEPT_',[StringComparison]::Ordinal)) 'Actual separate Root code Source acceptance, not a candidate-leaf receipt'
    Owner-Exact $adoption.target_execution $false;Owner-Exact $adoption.operational_authority $false
