AUTHORITY_PS=r'''
function Decode-OwnerObject([byte[]]$Bytes) {
    Require ($Bytes.Length -gt 0 -and $Bytes.Length -le 2097152) 'Bounded complete owner JSON bytes'
    $at=0
    while($at -lt $Bytes.Length -and $Bytes[$at] -in @(9,10,13,32)){$at++}
    Require ($at -lt $Bytes.Length -and $Bytes[$at] -eq 123) 'Raw JSON root object required before protected pipeline decoder; no singleton-array unwrapping'
    $value=Decode-Strict $Bytes
    Require ($null -ne $value -and $value -is [pscustomobject]) 'Decoded strict owner root object'
    return $value
}
function Read-OwnerObjectFact([object]$Pin,[long]$PreferredCap=2097152) {
    return Decode-OwnerObject (Read-ContextPin $Pin $PreferredCap)
}
function Require-QualifiedParserInterfaces() {
    throw 'UNWIRED: accepted I3 Native8 support carrier, I5 canonical SourceProof6/publication ABI, saved v2 Parser result adapter and actual fresh Root pre-launch resource evidence require a separately reviewed enforcing binding successor. Editing the False flag alone cannot qualify this Source.'
}
function Read-ContextPin([object]$Pin,[long]$PreferredCap=2097152,[bool]$Image=$false) {
    Owner-Pin $Pin
    if($script:Inputs.ContainsKey([string]$Pin.path)){
        $held=$script:Inputs[[string]$Pin.path]
        return ,(Read-Fact $Pin ([long]$held.cap) ([bool]$held.image))
    }
    return ,(Read-Fact $Pin $PreferredCap $Image)
}
function Validate-ImplementationAPI([object]$Facts) {
    $codeReview=Read-OwnerObjectFact $Facts.implementation_Source_review
    $matches=@($codeReview.subjects|Where-Object{$_.path -is [string] -and $_.path -ceq $script:CurrentAPIPath})
    Require ($matches.Count -eq 1) 'One exact known current API path among genuinely reviewed implementation subjects; no arbitrary carrier traversal'
    $apiPin=$matches[0];Owner-Pin $apiPin
    $api=Decode-OwnerObject (Read-ContextPin $apiPin)
    Integer $api.schema_version 2 2
    Require ($api.record_type -ceq 'Root_owner_v2_native_Parser_parent_child_inert_API' -and $api.author -ceq $script:ActualSourceEditor -and (Same-Fact $api.parent_Source $Facts.native_parent) -and (Same-Fact $api.child_Source $Facts.parser_child)) 'Acyclic actual API to exact parent/child Source crossjoins'
    Require ((Same-Fact $api.fixed_I0_Source $script:I0SourcePin) -and (Same-Fact $api.fixed_I0_API $script:I0APIPin)) 'Actual accepted I0 Source/API provenance, pure PS port never imports Python'
    return $apiPin
}
function Different-Review([object]$Pin,[object[]]$Subjects,[string]$PhysicalAuthor) {
    $r=Read-OwnerObjectFact $Pin;Require-Keys $r $script:ReviewKeys13;Integer $r.schema_version 1 1
    Require ($r.record_type -ceq 'different_native_Parser_only_Source_review' -and $r.scope -ceq $script:ExactScope) 'Exact retained compatible Source13 schema1 scope, never v2 authority by itself'
    Owner-Actor $r.reviewer
    Require ($r.reviewer -cne '/root' -and $r.reviewer -cne $PhysicalAuthor -and -not ($PhysicalAuthor -cne '/root' -and $r.reviewer.StartsWith($PhysicalAuthor+'/',[StringComparison]::Ordinal)) -and $r.reviewer -cne $script:ActualSourceEditor -and -not $r.reviewer.StartsWith($script:ActualSourceEditor+'/',[StringComparison]::Ordinal)) 'Actual genuinely different reviewer; Root excluded exactly, actual nonRoot editor and subtrees excluded'
    Require ($r.verdict -is [string] -and $r.verdict.StartsWith('PASS_',[StringComparison]::Ordinal) -and $r.verdict.ToUpperInvariant().Contains('SOURCE')) 'Positive Source verdict retains PASS and SOURCE markers'
    foreach($flag in @('target_execution','operational_authority','native_Parser_executed')){Owner-Exact $r.$flag $false}
    Integer $r.checks_failed 0 0
    Require ($r.source_author -is [string] -and $r.source_author -ceq $PhysicalAuthor -and (Moment $r.created_utc) -le [DateTimeOffset]::UtcNow) 'Exact covered collection author and actual review chronology'
    foreach($subject in $Subjects){Owner-Pin $subject;Require (Covers-Fact $r $subject) 'Actual Source13 covers every exact subject pin'}
    $full=Read-OwnerObjectFact $r.full_proof
    Require ($full.reviewer -ceq $r.reviewer -and $full.source_author -ceq $r.source_author -and $full.verdict -ceq $r.verdict -and $full.scope -ceq $script:ExactScope) 'Actual bounded full Source proof joins genuine capsule and scope'
    Integer $full.checks_failed 0 0
    foreach($flag in @('target_execution','operational_authority','native_Parser_executed')){Owner-Exact $full.$flag $false}
    Require ($full.checks -is [Array]) 'Actual finite named full Source check array';Integer $full.checks.Count 1 10000
    $checkNames=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach($check in $full.checks){Owner-Text $check.name 4096;Owner-Exact $check.passed $true;Require ($checkNames.Add([string]$check.name)) 'Every actual full Source check unique and passed'}
    foreach($subject in $Subjects){Require (Covers-Fact $full $subject) 'Actual full proof covers every exact Source input';if($script:Inputs.ContainsKey([string]$subject.path)){Require ((Moment $r.created_utc).UtcDateTime.Ticks -ge $script:Inputs[[string]$subject.path].path9[2]) 'Actual already observed Source birth precedes different review'}}
    Require ((Moment $full.created_utc) -le (Moment $r.created_utc)) 'Actual full Source proof precedes capsule, no recast or fabricated measurements'
    return $r
}
function Root-Adoption([object]$Pin,[object]$ReviewPin,[object[]]$Subjects) {
    $r=Read-OwnerObjectFact $Pin;Require-Keys $r $script:AdoptionKeys9;Integer $r.schema_version 1 1
    Require ($r.record_type -ceq 'Root_native_Parser_only_different_Source_review_adoption' -and $r.author -ceq '/root' -and $r.verdict -ceq 'ACCEPT_NATIVE_PARSER_ONLY_DIFFERENT_SOURCE_REVIEW' -and (Same-Fact $r.different_review $ReviewPin)) 'Actual compatible schema1 Root9 exact Source acceptance'
    Owner-Exact $r.target_execution $false;Owner-Exact $r.operational_authority $false
    foreach($subject in $Subjects){Require (Covers-Fact $r $subject) 'Separate Root9 covers each exact subject'}
    $review=Decode-OwnerObject $script:Inputs[[string]$ReviewPin.path].bytes
    Require ((Moment $review.created_utc) -le (Moment $r.created_utc) -and (Moment $r.created_utc) -le [DateTimeOffset]::UtcNow) 'Actual Source review then Root acceptance'
}
function Parser-PurposeInputs([object]$Admission,[object]$AdmissionPin,[object]$Facts) {
    $excluded=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach($p in @($AdmissionPin,$Admission.owner_acceptance_Source_review,$Admission.owner_acceptance_Root_adoption)){[void]$excluded.Add([string]$p.path)}
    [void]$excluded.Add([string]$Facts.outputs.parent_INTENT)
    if($script:Inputs.ContainsKey([string]$Admission.owner_acceptance_Source_review.path)){
        $r=Decode-OwnerObject $script:Inputs[[string]$Admission.owner_acceptance_Source_review.path].bytes
        Owner-Pin $r.full_proof;[void]$excluded.Add([string]$r.full_proof.path)
    }
    $paths=[Collections.Generic.List[string]]::new()
    foreach($path in $script:InputOrder){if(-not $excluded.Contains([string]$path)){$paths.Add([string]$path)}}
    $paths.Sort([StringComparer]::Ordinal)
    $subjects=[Collections.Generic.List[object]]::new()
    foreach($path in $paths){$subjects.Add($script:Inputs[$path].fact)}
    return ,$subjects.ToArray()
}
