def sha(b):return hashlib.sha256(b).hexdigest()
def pin(p):
 b=p.read_bytes();assert 0<len(b)<=2097152
 return dict(path=str(p),bytes=len(b),sha256=sha(b))
def exact(p,n,s):
 x=pin(p);assert (x['bytes'],x['sha256'])==(n,s),(p,x);return x
def read(p):return json.loads(p.read_bytes())
def save(p,value):
 b=value if type(value)is bytes else (json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
 assert 0<len(b)<=2097152
 with p.open('xb') as f:assert f.write(b)==len(b)
 assert p.read_bytes()==b
 return pin(p)
