def ps(value):
 if value is None:return '$null'
 if type(value)is bool:return '$true' if value else '$false'
 if type(value)is int:return str(value)
 if type(value)is str:return "'"+value.replace("'","''")+"'"
 if type(value)is list:return '@('+','.join(ps(x) for x in value)+')'
 if type(value)is dict:return '[pscustomobject]@{'+(';'.join(str(k)+'='+ps(v) for k,v in value.items()))+'}'
 raise TypeError(type(value))

def lexical(source):
 """Generic quote/comment/here-string aware delimiter scan; not a PS parser."""
 masked=list(source);stack=[];pairs={};i=0;state='code';quote=None
 while i<len(source):
  c=source[i]
  if state=='comment':
   if c=='\n':state='code'
   else:masked[i]=' '
  elif state=='block':
   if source.startswith('#>',i):masked[i:i+2]=[' ',' '];i+=1;state='code'
   elif c!='\n':masked[i]=' '
  elif state=='here':
   if (i==0 or source[i-1]=='\n') and source.startswith(quote+'@',i):
    masked[i:i+2]=[' ',' '];i+=1;state='code'
   elif c!='\n':masked[i]=' '
  elif state=='quote':
   masked[i]=' ' if c!='\n' else '\n'
   if quote=='"' and c=='`' and i+1<len(source):masked[i+1]=' ';i+=1
   elif c==quote:
    if i+1<len(source) and source[i+1]==quote:masked[i+1]=' ';i+=1
    else:state='code'
  else:
   if source.startswith('<#',i):masked[i:i+2]=[' ',' '];i+=1;state='block'
   elif c=='#':masked[i]=' ';state='comment'
   elif c=='@' and i+2<len(source) and source[i+1] in "'\"" and source[i+2] in '\r\n':
    quote=source[i+1];masked[i:i+2]=[' ',' '];i+=1;state='here'
   elif c in "'\"":quote=c;masked[i]=' ';state='quote'
   elif c=='`' and i+1<len(source):masked[i:i+2]=[' ',' '];i+=1
   elif c in '([{':stack.append((c,i))
   elif c in ')]}':
    assert stack and '([{'.index(stack[-1][0])==')]}'.index(c),(i,c,stack[-1:] )
    _,begin=stack.pop();pairs[begin]=i
  i+=1
 assert not stack and state in ('code','comment'),(stack,state)
 return ''.join(masked),pairs
def funcs(source):
 mask,pairs=lexical(source);result={}
 for m in re.finditer(r'(?m)^function ([A-Za-z0-9_-]+)\(',mask):
  start=m.start();opening=mask.index('{',m.end());end=pairs[opening]+1
  if source[end:end+2]=='\r\n':end+=2
  elif source[end:end+1]=='\n':end+=1
  assert m[1] not in result
  result[m[1]]=(start,end,source[start:end])
 return result
original_functions=[funcs(s) for s in texts]
