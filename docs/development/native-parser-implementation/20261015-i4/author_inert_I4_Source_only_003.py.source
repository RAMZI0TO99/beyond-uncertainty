OWNER_PS=r'''
# Pure owner context predicates mirror accepted I0 Source/API; they do not invoke Python.
function Owner-Text([object]$Value,[long]$Maximum=4096,[bool]$MessageWhitespace=$false) {
    Require ($Value -is [string] -and $Value.Length -gt 0) 'Nonempty exact owner text'
    foreach($c in $Value.ToCharArray()){
        $number=[int]$c
        Require (-not (($number -lt 32 -and -not ($MessageWhitespace -and $number -in @(9,10,13))) -or $number -eq 127)) 'Only declared retained-message whitespace allowed'
    }
    $encoding=[Text.UTF8Encoding]::new($false,$true)
    Require ($encoding.GetByteCount($Value) -le $Maximum) 'Exact owner text UTF8 cap, no surrogate replacement'
}
function Owner-Pin([object]$Pin) {
    Require-Keys $Pin @('path','bytes','sha256')
    Owner-Text $Pin.path 4096;Integer $Pin.bytes 1 2097152
    Require ($Pin.sha256 -is [string] -and $Pin.sha256 -cmatch '\A[0-9a-f]{64}\z') 'Exact lowercase Source SHA256'
}
function Owner-Ticks([object]$Value) {
    Require ($Value -is [string] -and $Value -cmatch '\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{6,7}(Z|\+00:00)\z') 'Exact UTC6or7 Z/+00 integer timestamp'
    $formats=[string[]]@("yyyy-MM-dd'T'HH:mm:ss.ffffff'Z'","yyyy-MM-dd'T'HH:mm:ss.fffffff'Z'","yyyy-MM-dd'T'HH:mm:ss.ffffffzzz","yyyy-MM-dd'T'HH:mm:ss.fffffffzzz")
    $valueTime=[DateTimeOffset]::ParseExact($Value,$formats,[Globalization.CultureInfo]::InvariantCulture,([Globalization.DateTimeStyles]::AssumeUniversal -bor [Globalization.DateTimeStyles]::AdjustToUniversal))
    Require ($valueTime.Year -ge 1601) 'FILETIME1601 supported calendar range'
    return $valueTime.UtcDateTime.ToFileTimeUtc()
}
function Owner-Actor([object]$Value) {
    Require ($Value -is [string] -and $Value.Length -le 4096 -and $Value -cmatch '\A/root(?:/[A-Za-z0-9_-]+)+\z') 'Actual nonRoot actor subtree'
}
function Owner-Exact([object]$Actual,[object]$Expected) {
    if($Expected -is [bool]){Require ($Actual -is [bool] -and $Actual -eq $Expected) 'Exact owner boolean'}
    elseif($Expected -is [int] -or $Expected -is [long]){Integer $Actual ([long]$Expected) ([long]$Expected)}
    elseif($Expected -is [string]){Require ($Actual -is [string] -and $Actual -ceq $Expected) 'Exact case-sensitive owner string'}
    else{throw 'Undeclared owner exact type'}
}
function Owner-Record([object]$Pin,[object]$Held) {
    Owner-Pin $Pin;Require ($Held.Add([string]$Pin.path)) 'Distinct owner records cannot replay or alias exact held path'
    $value=Decode-OwnerObject (Read-Fact $Pin)
    Require ($null -ne $value -and $value -is [pscustomobject]) 'Strict float-free unique-key owner JSON object'
    return $value
}
function Owner-Subjects([object]$Actual,[object[]]$Expected) {
    Require ($Actual -is [Array] -and $Actual.Count -eq $Expected.Count) 'Exact ordered owner subject list'
    for($i=0;$i -lt $Expected.Count;$i++){Owner-Pin $Actual[$i];Require (Same-Fact $Actual[$i] $Expected[$i]) 'Exact ordered scope/instruction/policy subject'}
}
function Owner-Witness([object]$Value,[string]$Kind,[string]$RootThread,[long]$ScopeCreated) {
    Require-Keys $Value $script:OwnerWitnessKeys9
    Owner-Exact $Value.schema_version 2;Owner-Exact $Value.record_type ('Root_retained_owner_'+$Kind+'_witness_v2')
    Owner-Exact $Value.author '/root';Owner-Exact $Value.Root_thread $RootThread
    Owner-Exact $Value.attribution 'DIRECT_USER_MESSAGE_RETAINED_BY_ROOT'
    Owner-Text $Value.human_message_reference 4096;Owner-Text $Value.exact_text 65536 $true
    $observed=Owner-Ticks $Value.human_message_observed_utc;$created=Owner-Ticks $Value.created_utc
    Require ($observed -le $created -and $created -le $ScopeCreated) 'Actual retained witness chronology; human origin remains external Root obligation'
}
function Validate-OwnerSupportPure([object]$Support,[object]$ExpectedRootThread,[object]$SourceEditor,[object]$NowUtc) {
    Require-Keys $Support $script:OwnerSupportKeys3
    Owner-Text $ExpectedRootThread 512;Owner-Actor $SourceEditor
    $now=Owner-Ticks $NowUtc
    $held=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    $scopePin=$Support.current_owner_scope;$reviewPin=$Support.different_current_owner_scope_Source_review;$adoptionPin=$Support.current_owner_scope_Root_adoption
    foreach($p in @($scopePin,$reviewPin,$adoptionPin)){Owner-Pin $p}
    $scope=Owner-Record $scopePin $held;Require-Keys $scope $script:OwnerScopeKeys28
    foreach($name in $script:OwnerScopeFixed.Keys){Owner-Exact $scope.$name $script:OwnerScopeFixed[$name]}
    Owner-Exact $scope.Root_thread $ExpectedRootThread
    $created=Owner-Ticks $scope.created_utc;$start=Owner-Ticks $scope.interval_start;$end=Owner-Ticks $scope.interval_end
    Require ($start -le $created -and $created -le $now -and $end-$now -gt 600000000) 'Finite current owner scope with strictly more than Source60'
    $instructionPin=$scope.owner_instruction_record;$policyPin=$scope.owner_policy_record
    Owner-Pin $instructionPin;Owner-Pin $policyPin
    $instruction=Owner-Record $instructionPin $held;$policy=Owner-Record $policyPin $held
    Owner-Witness $instruction 'instruction' $ExpectedRootThread $created;Owner-Witness $policy 'resource_policy' $ExpectedRootThread $created
    $subjects=@($scopePin,$instructionPin,$policyPin)
    $review=Owner-Record $reviewPin $held;Require-Keys $review $script:ReviewKeys13
    Owner-Exact $review.schema_version 2;Owner-Exact $review.record_type 'independent_Root_owner_v2_metadata_scope_Source_review'
    Owner-Exact $review.source_author '/root';Owner-Exact $review.verdict 'PASS_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY'
    Integer $review.checks_failed 0 0
    foreach($flag in @('target_execution','operational_authority','native_Parser_executed')){Owner-Exact $review.$flag $false}
    Owner-Actor $review.reviewer
    Require ($review.reviewer -cne $SourceEditor -and -not $review.reviewer.StartsWith($SourceEditor+'/',[StringComparison]::Ordinal)) 'Genuinely different owner reviewer excludes actual editor and subtree, Root exactly'
    Owner-Subjects $review.subjects $subjects;Owner-Pin $review.scope;Require (Same-Fact $review.scope $scopePin) 'Scope review exact pin'
    $reviewed=Owner-Ticks $review.created_utc;$fullPin=$review.full_proof;Owner-Pin $fullPin
    $full=Owner-Record $fullPin $held;Require-Keys $full $script:OwnerFullProofKeys15
    Owner-Exact $full.schema_version 2;Owner-Exact $full.record_type 'independent_Root_owner_v2_metadata_scope_full_Source_proof'
    Owner-Exact $full.reviewer $review.reviewer;Owner-Exact $full.source_author '/root';Owner-Exact $full.verdict $review.verdict
    Owner-Exact $full.owner_provenance_boundary 'ROOT_RETAINED_WITNESSES_REQUIRE_CALLER_PROVENANCE_VERIFICATION'
    Integer $full.checks_failed 0 0
    foreach($flag in @('target_execution','operational_authority','native_Parser_executed')){Owner-Exact $full.$flag $false}
    Owner-Subjects $full.subjects $subjects;Owner-Pin $full.scope;Require (Same-Fact $full.scope $scopePin) 'Full proof exact scope'
    Require ($full.checks -is [Array]) 'Actual named owner Source check array';Integer $full.checks.Count 4 10000
    $names=[Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
    foreach($row in $full.checks){Require-Keys $row @('name','passed');Owner-Text $row.name 4096;Owner-Exact $row.passed $true;Require ($names.Add([string]$row.name)) 'Unique actual fullproof check name'}
    foreach($required in @('owner_scope_whole_bytes_and_closed28','instruction_retained_witness_binding_and_provenance','policy_retained_witness_binding_and_provenance','scope_resource_time_and_authority_bounds')){Require ($names.Contains($required)) 'Required owner context Source predicate covered'}
    Require ($full.subject_reviews -is [Array] -and $full.subject_reviews.Count -eq 3) 'Exact three whole-subject coverage rows'
    $kinds=@('OWNER_SCOPE','RETAINED_INSTRUCTION','RETAINED_POLICY')
    for($i=0;$i -lt 3;$i++){
        $row=$full.subject_reviews[$i];Require-Keys $row @('subject','subject_kind','whole_bytes_reviewed','provenance_reviewed')
        Owner-Pin $row.subject;Require (Same-Fact $row.subject $subjects[$i]) 'Whole-source proof ordered subject coverage'
        Owner-Exact $row.subject_kind $kinds[$i];Owner-Exact $row.whole_bytes_reviewed $true;Owner-Exact $row.provenance_reviewed $true
    }
    $proofCreated=Owner-Ticks $full.created_utc
    $adoption=Owner-Record $adoptionPin $held;Require-Keys $adoption $script:AdoptionKeys9
    Owner-Exact $adoption.schema_version 2;Owner-Exact $adoption.record_type 'Root_owner_v2_metadata_scope_Source_review_adoption'
    Owner-Exact $adoption.author '/root';Owner-Exact $adoption.verdict 'ACCEPT_ROOT_OWNER_V2_METADATA_SCOPE_SOURCE_ONLY'
    Owner-Exact $adoption.target_execution $false;Owner-Exact $adoption.operational_authority $false
    Owner-Subjects $adoption.subjects $subjects;Owner-Pin $adoption.different_review;Require (Same-Fact $adoption.different_review $reviewPin) 'Actual owner adoption binds real different review'
    $adopted=Owner-Ticks $adoption.created_utc
    Require ($created -le $proofCreated -and $proofCreated -le $reviewed -and $reviewed -le $adopted -and $adopted -le $now) 'Owner scope/fullproof/review/Rootadoption/current-clock exact chronology'
    return [ordered]@{root_thread=$ExpectedRootThread;scope_pin=$scopePin;review_pin=$reviewPin;adoption_pin=$adoptionPin;instruction_pin=$instructionPin;policy_pin=$policyPin;full_proof_pin=$fullPin;created_ticks=$created;interval_start_ticks=$start;interval_end_ticks=$end;validated_now_ticks=$now;metadata_only=$true;operational_authority=$false;scientific_authority=$false;Parser_requires_separate_purpose_admission=$true;human_origin_authenticated_by_this_pure_validator=$false}
}
function Validate-CurrentOwnerSupport([object]$Facts,[object]$Gate) {
    Require ($script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED -is [bool] -and $script:CURRENT_OWNER_PARSER_DEPENDENCY_BINDINGS_QUALIFIED) 'Source-held Parser bindings require actual reviewed successor, never a flag-only qualification'
    [void](Read-Fact $script:I0SourcePin);[void](Read-Fact $script:I0APIPin)
    $support=[pscustomobject]@{current_owner_scope=$Facts.Source_preparation;different_current_owner_scope_Source_review=$Facts.Source_preparation_review;current_owner_scope_Root_adoption=$Facts.Source_preparation_Root_adoption}
