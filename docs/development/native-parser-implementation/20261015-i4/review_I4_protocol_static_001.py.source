def check(name,passed,evidence):
    if any(c['name']==name for c in checks):raise ValueError('duplicate own check')
    checks.append(dict(name=name,passed=bool(passed),evidence=evidence))
def fact(path,b):return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def raw(path,n=None,h=None):
    path=Path(path);b=path.read_bytes();f=fact(path,b)
    if str(path)not in inputs:
        inputs[str(path)]=f;bodies[str(path)]=b
        check('Whole bounded actual input '+str(path),0<len(b)<=2097152 and(n is None or len(b)==n)and(h is None or f['sha256']==h),f)
    else:check('Retained input pin '+str(path),f==inputs[str(path)]and(n is None or len(b)==n)and(h is None or f['sha256']==h),f)
    return b
def exact(p):
    if p['path']in inputs:
        check('Declared exact input '+p['path'],inputs[p['path']]==p,p);return bodies[p['path']]
    return raw(p['path'],p['bytes'],p['sha256'])
def pairs(rows):
    result={}
    for k,v in rows:
        if k in result:raise ValueError('duplicate JSON key '+k)
        result[k]=v
    return result
def reject(s):raise ValueError('float/nonfinite token '+s)
def decode(b):return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
def doc(p,n=None,h=None):return decode(raw(p,n,h))
