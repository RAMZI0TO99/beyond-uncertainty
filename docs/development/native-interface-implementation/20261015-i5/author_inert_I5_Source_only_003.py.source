GENERIC = r'''

def _i5_generic_reader(pin, cap=2097152):
    held=OBSERVATIONS.get(pin['path'])
    if held is not None:
        _i5_need(type(held['cap']) is int and 0<held['cap']<=2097152,'original retained cap identity')
        cap=min(cap,held['cap'])
    return read_pin(pin,cap=cap)

def validate_current_owner_generic_metadata_stage(*, owner_support, facts_pin, facts_review,
        facts_Root_adoption, expected_root_thread, actual_now_utc):
    if I5_DEPENDENCY_INTERFACES_QUALIFIED is not True:
        raise ValueError('I5 SOURCE ONLY: current-owner generic stage entry held')
    _i5_unwired_interfaces()
    context=_i5_owner_context(owner_support,_i5_generic_reader,OBSERVATIONS,expected_root_thread,actual_now_utc)
    facts=_i5_record(facts_pin,_i5_generic_reader)
    decision=_i5_record(facts['stage_decision'],_i5_generic_reader)
    _i5_generic_shapes(facts,decision,owner_support)
    now=_i5_ticks(actual_now_utc)
    review=_i5_review(facts_review,[facts_pin,facts['stage_decision'],owner_support['current_owner_scope']],
                     ['/root',I5_ACTUAL_SOURCE_EDITOR],_i5_generic_reader,OBSERVATIONS,now)
    _i5_root(facts_Root_adoption,[facts_pin,facts['stage_decision'],owner_support['current_owner_scope']],
             facts_review,review,_i5_generic_reader,OBSERVATIONS,now)
    _i5_lease_shapes(facts['lawful_lease_support'],owner_support,_i5_generic_reader,OBSERVATIONS,actual_now_utc)
    selected=_i5_record(facts['Root_selection'],_i5_generic_reader)
    rows=_i5_selection_shape(selected,owner_support['current_owner_scope'],facts['lawful_lease_support']['canonical'])
    _i5_need(facts['predecessor']==rows[facts['role']]['predecessor'],'exact selected predecessor')
    _i5_unwired_interfaces()  # No old algorithm receives projected v2 authority.

# No callable historical alias is retained. Definitions above remain exact inverse/preservation basis.
for _i5_disabled_name in I5_DISABLED_LEGACY_ENTRIES:
    globals()[_i5_disabled_name]=_i5_legacy_refusal

if __name__=='__main__':
    _i5_require_qualification()
