    prior_root=_i5_root(support['candidate_Root_adoption'],[support['candidate'],author_pin],support['candidate_review'],prior,read_record,observations,now)
    later=_i5_review(support['canonical_review'],[support['canonical'],support['original_publication']],['/root','/root/phase_frontier'],read_record,observations,now)
    later_root=_i5_root(support['canonical_Root_adoption'],[support['canonical'],support['original_publication']],support['canonical_review'],later,read_record,observations,now)
