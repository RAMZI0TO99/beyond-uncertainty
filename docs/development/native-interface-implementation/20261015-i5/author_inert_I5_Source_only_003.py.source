    raw=_i5_read(I5_FIXED['I0_Source'],read_record)
    if _I5_I0_MODULE is None:
        name='_I5_I0_'+_i5_hashlib.sha256(I5_SELF.encode('utf8')).hexdigest()+'_'+I5_FIXED['I0_Source']['sha256']
        _i5_need(name not in _i5_sys.modules,'unique authenticated role/self I0 loader')
        module=_i5_types.ModuleType(name);module.__file__=I5_FIXED['I0_Source']['path']
        _i5_sys.modules[name]=module
        try:
            exec(compile(raw,I5_FIXED['I0_Source']['path'],'exec'),module.__dict__)
        except BaseException:
            _i5_sys.modules.pop(name,None)
            raise
        _I5_I0_MODULE=module
    context=_I5_I0_MODULE.validate_current_owner_support(support=owner_support,
        read_record=lambda p:_i5_read(p,read_record),expected_root_thread=expected_root_thread,
        source_editor=I5_ACTUAL_SOURCE_EDITOR,now_utc=actual_now_utc)
    _i5_need(context.root_thread==expected_root_thread and context.scope_pin.to_dict()==owner_support['current_owner_scope'] and
              context.metadata_only is True and context.operational_authority is False and context.scientific_authority is False and
              context.interval_start_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS<=now and
              now+600000000<context.interval_end_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS,
              'I0 context only, exact FILETIME-to-Unix epoch bridge and strict Source60')
    return context

def _i5_shape(value, name):
    spec=I5_SCHEMAS[name]
    _i5_closed(value,spec['keys'],name)
    _i5_need(type(value['schema_version']) is int and value['schema_version']==2 and
              value['record_type']==spec['record_type'],'explicit owner-v2 version/type; no old cast')
