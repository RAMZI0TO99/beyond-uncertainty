def sha(b):
    return hashlib.sha256(b).hexdigest()

def pin(p):
    b=p.read_bytes()
    return {'path':str(p),'bytes':len(b),'sha256':sha(b)}

def wire(v):
    return (json.dumps(v,ensure_ascii=False,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')

def save(p,b):
    assert len(b)<=2097152 and not p.exists(),str(p)
    with p.open('xb') as f:
        f.write(b)
    assert p.read_bytes()==b
    return pin(p)

def literals(path):
    tree=ast.parse(path.read_bytes())
    values={}
    for n in tree.body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            try:
                values[n.targets[0].id]=ast.literal_eval(n.value)
            except (ValueError,TypeError,SyntaxError):
                if isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='frozenset' and len(n.value.args)==1 and not n.value.keywords:
                    values[n.targets[0].id]=frozenset(ast.literal_eval(n.value.args[0]))
    return values

def functions(b):
    text=b.decode('utf8'); lines=text.splitlines(keepends=True)
    return [(n.name,n.lineno,n.end_lineno,''.join(lines[n.lineno-1:n.end_lineno]).encode('utf8'))
            for n in ast.parse(text).body if isinstance(n,(ast.FunctionDef,ast.ClassDef))]

