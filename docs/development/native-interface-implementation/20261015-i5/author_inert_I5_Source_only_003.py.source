PHASE = r'''

def _i5_phase_reader(pin, cap, *, byte_pairs, observations):
    held=observations[pin['path']]
    _i5_need(type(held['cap']) is int and 0<held['cap']<=2097152,'original retained phase cap identity')
    return _bytes24(pin,byte_pairs,observations,min(cap,held['cap']))

def validate_current_owner_phase_peer_context(*, owner_support, context_pin, content_decision_pin,
        byte_pairs, observations, expected_root_thread, actual_now_utc, actual_content_actor):
    if I5_DEPENDENCY_INTERFACES_QUALIFIED is not True:
        raise ValueError('I5 SOURCE ONLY: current-owner phase-peer entry held')
    _i5_unwired_interfaces()
    def retained_reader(pin,cap=2097152):
        return _i5_phase_reader(pin,cap,byte_pairs=byte_pairs,observations=observations)
    owner=_i5_owner_context(owner_support,retained_reader,observations,expected_root_thread,actual_now_utc)
    context=_i5_record(context_pin,retained_reader)
    decision=_i5_record(content_decision_pin,retained_reader)
    _i5_phase_shapes(context,decision,owner_support,actual_content_actor)
    now=_i5_ticks(actual_now_utc)
