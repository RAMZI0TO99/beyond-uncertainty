        _i5_need(type(row['source_cap']) is int and row['source_cap']==cap,'original role cap')
        _i5_pin(row['predecessor'],cap)
        _i5_need(type(row['canonical_path']) is str and row['canonical_path'] not in paths,'unique exact canonical identity')
        _i5_path(row['canonical_path']);paths.add(row['canonical_path'])
        if role=='composer':
            _i5_need(row['canonical_path']==row['predecessor']['path'] and row['must_change_Source_bytes'] is False and
                      all(row[k] is None for k in ('draft_path','selected_ordinal','preparation_Source_author','retained_semantic_Source_author')),
                      'one composer carry with original null4')
        else:
            _i5_actor(row['preparation_Source_author'])
            _i5_need(type(row['selected_ordinal']) is int and 0<row['selected_ordinal']<1000 and
                      row['must_change_Source_bytes'] is True and row['retained_semantic_Source_author']==I5_ROLE_SEMANTICS[role],
                      'explicit new ordinal/actual physical editor/distinct retained semantic author')
            _i5_path(row['draft_path'])
            _i5_need(row['draft_path'] not in drafts and len({row['canonical_path'],row['draft_path'],row['predecessor']['path']})==3 and
                      _i5_WindowsPath(row['draft_path']).name==_i5_WindowsPath(row['canonical_path']).name and
                      _i5_WindowsPath(row['draft_path']).parent.name=='drafts','44 unique fresh draft identities')
            drafts.add(row['draft_path'])
            if role in I5_PHASE8_ROLES:
                _i5_need(row['selected_ordinal']>18,'all eight future TEMPLATE/BOUND identities strictly beyond018')
    _i5_need(len(paths)==45 and len(drafts)==44,'whole45/44 structural selection')
    return {row['role']:row for row in rows}

def _i5_lease_shapes(support, owner_support, read_record, observations, actual_now_utc):
    # Known I1 metadata predicates only; actual timestamp entry/grant/native evidence is not inferred.
