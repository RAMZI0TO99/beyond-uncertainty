def _i5_selection_shape(selection, scope, lease_pin):
    _i5_closed(selection,I5_SELECTION_KEYS,'owner selection13')
    _i5_need(type(selection['schema_version']) is int and selection['schema_version']==2 and
              selection['record_type']=='Root_owner_v2_actual_separate_future45_Source_path_selection' and
