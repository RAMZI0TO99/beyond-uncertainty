    _i5_closed(content,('decision','different_review','Root_adoption'),'genuine content support3')
    _i5_need(content['decision']==content_decision_pin,'exact actual genuine decision')
    review=_i5_review(content['different_review'],[content_decision_pin,*decision['actual_support_fact3s'],owner_support['current_owner_scope']],
                      ['/root',I5_ACTUAL_SOURCE_EDITOR,actual_content_actor],retained_reader,observations,now)
    _i5_root(content['Root_adoption'],[content_decision_pin,*decision['actual_support_fact3s'],owner_support['current_owner_scope']],
             content['different_review'],review,retained_reader,observations,now)
    _i5_unwired_interfaces()  # No saved-result adapter or original recipe emission wired.

