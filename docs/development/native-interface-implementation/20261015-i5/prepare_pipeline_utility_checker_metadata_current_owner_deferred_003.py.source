    publication = lease_producer_record(support['original_publication'],
        'ROOT_SOURCE024_PROSPECTIVE_LEASE_CANONICAL_PUBLICATION_RECEIPT_001.json')
    request = lease_producer_record(support['original_request'],
        'ROOT_SOURCE024_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json')
    need(type(publication['schema_version']) is int and publication['schema_version']==1
        and publication['record_type']=='Root_actual_Source024_exact_reviewed_closed12_lease_Source_publication'
        and publication['physical_Source_editor']=='/root'
        and publication['metadata_tool_Source_author']=='/root/runtime_audit'
        and publication['canonical']==support['canonical'] and publication['candidate']==support['candidate']
        and publication['different_lease_Source_review']==support['candidate_review']
        and publication['candidate_Root_adoption']==support['candidate_Root_adoption']
        and publication['issuance_decision']==support['issuance_decision']
        and publication['Root_facts']==support['original_request'] and publication['Source024']==SOURCE024
        and all(publication[key] is True for key in ('original_closed12_schema_preserved',
            'complete_candidate_bytes_exact','original_owner_and_timestamp_contracts_preserved'))
        and all(publication[key] is False for key in ('operational_authority','lease_is_owner_deadline',
            'target_execution','source_family_selected','actual_entry006','original_fixture_or_case_grant',
            'old_leases_extended','host_quiet','actor_Job_or_science_authority')),
        'exact original producer publication ABI and real pins; no invented canonical_publication flag')
    exact(request, LEASE_PRODUCER_FACT_KEYS, 'original Root lease-publication facts closed14')
