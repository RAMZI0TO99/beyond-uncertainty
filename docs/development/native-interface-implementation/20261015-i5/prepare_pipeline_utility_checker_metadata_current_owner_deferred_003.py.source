def exact(value, keys, label):
    need(type(value) is dict and set(value) == set(keys), label)


def positive_pin(pin):
    pin = exact_fact3(pin)
    need(0 < pin['bytes'] <= 2097152, 'positive ordinary Source2M pin')
    return pin


def root_record(pin, *, coordination=False):
    value = strict_source_json(read_pin(positive_pin(pin)))
    parents=(ROOT_OWNED,SESSION/'coordination') if coordination else (ROOT_OWNED,)
    need(absolute(pin['path']).parent in parents and absolute(pin['path']).name.startswith('ROOT_')
        and value.get('author') == '/root', 'actual explicitly Root-owned metadata record')
    return value


def source_acceptance(subject, review_pin, adoption_pin, selection_pin, physical_editor, *, worker=None):
    read_pin(positive_pin(subject))
    review = reviewed_subject(positive_pin(review_pin), subject, physical_editor)
    if worker is not None and worker != '/root':
        need(review['reviewer'] != worker and not review['reviewer'].startswith(worker+'/'),
            'genuine review independent of the actual metadata Source worker/subtree')
    need(absolute(adoption_pin['path']).parent == ROOT_OWNED, 'one genuine Root adoption namespace')
    adoption = root_adopted_review(adoption_pin, subject, review_pin, selection_pin, review)
    return review, adoption


def source_reserve(lease):
    scope = gate(SOURCE024['path'], SOURCE024['sha256'])
    need(current_ticks() + 600000000 < moment(scope['interval_end']), 'original Source024 publication60 reserve')
    need(moment(lease['created_utc'], 7) <= current_ticks()
        and current_ticks() + 12000000000 < moment(lease['lease_end_utc'], 7), 'original lawful lease1200 admission reserve')
    return scope


