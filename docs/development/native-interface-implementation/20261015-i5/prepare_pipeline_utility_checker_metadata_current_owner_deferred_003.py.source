        and issuance['owner_review']['sha256']==lease['owner_review_sha256'] and issuance['predecessor_lease']==EXISTING_LEASE010
        and all(issuance[key] is False for key in ('lease_is_owner_deadline','old_leases_extended','source_family_selected'))
        and issuance['target_execution'] is False and issuance['operational_authority'] is False
        and moment(issuance['created_utc']) <= start, 'genuine separate prior Root issuance decision, not gate-issued lease')
    for key in ('design','native_timestamp_entry','owner_master','owner_review'):
