BATCH_SOURCE024_SUPPORT = {'gate': {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\coordination\\ROOT_SOURCE_COMPUTE_ACCEPTANCE_024.json', 'sha256': '067f88660764f212356e8fc5ec35d2024a8db7d212dbefde2d9358ddf4d1a1b6', 'bytes': 46054}, 'request': {'bytes': 11812, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\coordination\\ROOT_SOURCE_COMPUTE_WINDOW_REQUEST_024.json', 'sha256': 'a391eff863b181a9bf802c81b8fc4520938b207b0b72758fcd6f8839f288bd4c'}, 'genuine_response': {'bytes': 15583, 'path': 'D:\\Aenv\\pro3\\runs\\coordination\\pro2_source024_scheduling_20261011_v1\\pro2_source024_response_001.json', 'sha256': '7b8907724bc546cef8ac94bb0b23f2488b9b0cd294e38faf0115c16e683822ed'}, 'retained_copy': {'bytes': 15583, 'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\coordination\\PRO3_GENUINE_SOURCE024_RESPONSE_RETAINED_COPY_001.json', 'sha256': '7b8907724bc546cef8ac94bb0b23f2488b9b0cd294e38faf0115c16e683822ed'}, 'different_review': {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\reviews\\source024_actual_gate_001\\INDEPENDENT_SOURCE024_GENUINE_ACTUAL_GATE_FLOAT_FREE_SOURCE_CAPSULE_001.json', 'sha256': '626c2425b05ae07f8ae7d64b94464315c5c80ed93ae605eef77924d4f4f44d12', 'bytes': 4634}, 'Root_adoption': {'path': 'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\generation\\observer010_lease009_root_001\\ROOT_SOURCE024_ACTUAL_GENUINE_GATE_DIFFERENT_REVIEW_ADOPTION_001.json', 'sha256': '0d623559036542a05d5a05674e9c92f3cb21e9401488790a36faf761628a2fa7', 'bytes': 48529}}

def original_publication_draft_request(request, publication, request_pin, publication_pin,
                                     canonical_pin, draft_pin, role, rows, selection_pin):
    """Join two distinct original request schemas; later canonical proofs stay separate."""
    need(type(request['schema_version']) is int and request['schema_version'] == 1
        and request['author'] == '/root' and request['target_execution'] is False
        and request['operational_authority'] is False,
        'actual original Root request, exact schema version and false authority')
    kind = request['record_type']
    if kind == 'Root_Source024_selected_role_exact_reviewed_Source_publication_request':
        exact(request, PUBLICATION_REQUEST_KEYS, 'original single-role request exact14, never canonical fact3 insertion')
        need(request['Source024'] == SOURCE024 and request['Root_selection'] == selection_pin
            and request['decision'] == 'PUBLISH_EXACT_REVIEWED_SOURCE_ONLY_SELECTED_ROLE'
            and request['role'] == role and request['draft'] == draft_pin
            and request['canonical_path'] == canonical_pin['path'],
            'request14 exact selected draft and canonical path string')
        exact(publication, SINGLE_ROLE_PUBLICATION_KEYS, 'original single-role publication exact29')
        need(publication['stage'] == 'publish' and publication['role'] == role
            and publication['draft'] == draft_pin and publication['canonical'] == canonical_pin
            and publication['original_request'] == request_pin and publication['Root_selection'] == selection_pin
            and publication['Source024'] == SOURCE024 and publication['physical_actor'] == '/root'
            and publication['details']['different_draft_Source_review'] == request['Source_review']
            and publication['details']['Root_draft_adoption'] == request['Root_adoption'],
            'actual original single-role receipt links prior draft review/adoption and requested bytes')
        prior_review_pin, prior_adoption_pin = request['Source_review'], request['Root_adoption']
    elif kind == 'Root_Source024_selected45_role_Source_canonical_publication_request':
        exact(request, BATCH_PUBLICATION_REQUEST_KEYS, 'distinct original Root batch request exact21')
        exact(publication, BATCH_PUBLICATION_KEYS, 'original batch publication exact producer schema')
        need(request['Root_thread'] == ROOT_THREAD and request['source_only'] is True
            and request['canonical_publication_selected'] is True
            and request['Source024_support'] == BATCH_SOURCE024_SUPPORT
            and publication['actual_Root_request'] == request_pin and publication['Source024'] == SOURCE024
            and publication['Root_future_path_selection'] == selection_pin
            and publication['Root_future_path_selection_acceptance'] == request['Root_future_path_selection_support']
            and publication['actual_new_lease_support'] == request['new_lease_support']
            and publication['predecessor_inventory_support'] == request['predecessor_inventory_support']
            and publication['producer_supports'] == request['producer_supports'],
            'actual original batch request/publication and exact current scheduling/selection/lease support')
        # This is the declared retained label in the actual batch producer, not an old scheduling fallback.
        need(publication['Source023_support'] == request['Source024_support'],
            'retained batch receipt label contains exactly current24 support')
        path_support = request['Root_future_path_selection_support']
        exact(path_support, ('subject','different_review','Root_adoption'), 'batch actual selection support3')
        need(path_support['subject'] == selection_pin, 'batch selection is actual admitted selected family')
        selection_review, selection_adoption = source_acceptance(selection_pin,
            path_support['different_review'], path_support['Root_adoption'], CURRENT_ROOT_SELECTION, '/root')
        tool_pin = positive_pin(request['publisher_source'])
        api_pin = positive_pin(request['publisher_API'])
        publisher_tree = ast.parse(read_pin(tool_pin))
        api = strict_source_json(read_pin(api_pin))
        def declared_keys(name):
            candidates = [node.value for node in publisher_tree.body if isinstance(node, ast.Assign)
                and any(isinstance(target, ast.Name) and target.id == name for target in node.targets)]
            need(len(candidates) == 1, 'one actually read batch producer key declaration')
            value = candidates[0]
            if isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id == 'frozenset':
                need(len(value.args) == 1 and not value.keywords, 'literal batch closed-key declaration only')
                value = value.args[0]
            return set(ast.literal_eval(value))
        need(api['Source'] == tool_pin and api['current_Source024_support'] == BATCH_SOURCE024_SUPPORT
            and set(api['Root_request21']) == set(BATCH_PUBLICATION_REQUEST_KEYS)
            and set(api['Root_publication_row10']) == set(BATCH_PUBLICATION_ROW_KEYS)
            and api['actual_binding_Source_editor'] == '/root/pipeline_source_editor'
            and api['retained_tool_Source_author_nominal'] == '/root/runtime_audit'
            and declared_keys('REQUEST_KEYS') == set(BATCH_PUBLICATION_REQUEST_KEYS)
            and declared_keys('PUBLICATION_ROW_KEYS') == set(BATCH_PUBLICATION_ROW_KEYS),
            'real batch Source/API explicitly reviewed for their own21/10 schema, never request14 reinterpretation')
        tool_review, tool_adoption = source_acceptance(tool_pin, request['publisher_Source_review'],
            request['publisher_Root_adoption'], CURRENT_ROOT_SELECTION, '/root/pipeline_source_editor',
            worker='/root/runtime_audit')
        need(tool_review['reviewer'] != '/root' and exact_pin_occurs(tool_review, api_pin)
            and exact_pin_occurs(tool_adoption, api_pin)
            and publication['publisher_source'] == tool_pin and publication['publisher_API'] == api_pin
            and publication['publisher_different_Source_review'] == request['publisher_Source_review']
            and publication['publisher_Root_Source_adoption'] == request['publisher_Root_adoption'],
            'genuine prior batch implementation Source/API review and Root adoption, not schema-basis acceptance')
        request_id = request['request_id']
        need(type(request_id) is str and re.fullmatch('[A-Z0-9_]{1,48}', request_id) is not None
            and absolute(request_pin['path']) == ROOT_OWNED/('ROOT_SOURCE024_SELECTED45_ROLE_SOURCE_PUBLICATION_REQUEST_'+request_id+'.json')
            and absolute(publication_pin['path']) == ROOT_OWNED/('ROOT_SOURCE024_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_'+request_id+'.json')
            and request['publication_receipt_path'] == publication_pin['path']
            and publication['request_id'] == request_id
            and api['fixed_request_name'] == 'ROOT_SOURCE024_SELECTED45_ROLE_SOURCE_PUBLICATION_REQUEST_<ID>.json'
            and api['fixed_original_publication_name'] == 'ROOT_SOURCE024_SELECTED45_ROLE_SOURCE_CANONICAL_PUBLICATION_RECEIPT_<ID>.json',
            'exact current24 unique original batch request/receipt identities, no refused old23 identity fallback')
        need(type(request['rows']) is list and request['rows']
            and len({item['role'] for item in request['rows']}) == len(request['rows'])
            and type(publication['published']) is list
            and len({item['role'] for item in publication['published']}) == len(publication['published'])
            and {item['role'] for item in request['rows']} == {item['role'] for item in publication['published']},
            'finite unique original batch rows and exact actual published role set')
        for item in request['rows']:
            exact(item, BATCH_PUBLICATION_ROW_KEYS, 'every original batch publication row exact10')
        requested = next((item for item in request['rows'] if item['role'] == role), None)
        published = next((item for item in publication['published'] if item['role'] == role), None)
        need(requested is not None and published is not None and requested['draft'] == draft_pin
            and requested['canonical_path'] == canonical_pin['path']
            and requested['source_cap'] == rows[role]['source_cap']
            and requested['physical_Source_editor'] == '/root'
            and requested['metadata_Source_worker'] == rows[role]['preparation_Source_author']
            and requested['retained_semantic_Source_author'] == rows[role]['retained_semantic_Source_author']
            and published['draft'] == draft_pin and published['canonical'] == canonical_pin
            and published['author_receipt'] == requested['author_receipt']
            and published['exact_Source_review'] == requested['source_review']
            and published['Root_Source_review_adoption'] == requested['Root_adoption']
            and published['canonical_physical_actor'] == '/root'
            and published['physical_Source_editor'] == requested['physical_Source_editor']
            and published['metadata_Source_worker'] == requested['metadata_Source_worker']
            and published['retained_semantic_Source_author'] == requested['retained_semantic_Source_author']
            and published['source_cap'] == requested['source_cap'],
            'actual exact selected batch draft/bytes/cap/authors and original prior draft Source approval')
        need(moment(tool_adoption['created_utc']) <= moment(request['created_utc'])
            and moment(selection_adoption['created_utc']) <= moment(request['created_utc']),
            'original batch request follows actual implementation and selection approvals')
        prior_review_pin, prior_adoption_pin = requested['source_review'], requested['Root_adoption']
    else:
        need(False, 'only the distinct exact original request14 or batch21 schema may be joined')
    prior_review, prior_adoption = source_acceptance(draft_pin, prior_review_pin, prior_adoption_pin,
        selection_pin, '/root', worker=rows[role]['preparation_Source_author'])
    need(exact_pin_occurs(publication, prior_review_pin) and exact_pin_occurs(publication, prior_adoption_pin)
        and moment(prior_adoption['created_utc']) <= moment(request['created_utc'])
        and moment(request['created_utc']) <= moment(publication['created_utc']) <= current_ticks()
        and draft_pin['sha256'] == canonical_pin['sha256'] and draft_pin['bytes'] == canonical_pin['bytes'],
        'genuine prior draft review/adoption before original request/publication and complete canonical byte identity')
    return prior_review, prior_adoption


def dependency(support, role, rows, selection_pin):
    exact(support, DEPENDENCY_KEYS, 'canonical dependency8, original publication distinct from reconciliation')
    pin = positive_pin(support['canonical'])
    need(pin['path'] == rows[role]['canonical_path'] and pin['bytes'] <= rows[role]['source_cap'], 'exact actual selected canonical dependency/cap')
    data = read_pin(pin)
    if role == 'composer':
        need(all(support[key] is None for key in ('original_publication', 'original_request', 'reconciliation',
            'reconciliation_review', 'reconciliation_Root_adoption')), 'composer carry cannot claim new publication/birth')
        source_acceptance(pin, support['Source_review'], support['Root_adoption'], selection_pin, '/root')
        return pin, data
    source_acceptance(pin, support['Source_review'], support['Root_adoption'], selection_pin, '/root',
        worker=rows[role]['preparation_Source_author'])
    pub = root_record(support['original_publication'])
    req = root_record(support['original_request'])
    need(pub.get('record_type') == 'Root_Source024_selected45_role_Source_canonical_publication'
        and pub.get('canonical_publication') is True and pub.get('target_execution') is False
        and pub.get('operational_authority') is False and exact_pin_occurs(pub, pin)
        and exact_pin_occurs(pub, support['original_request']) and exact_pin_occurs(pub, selection_pin)
        and exact_pin_occurs(pub, SOURCE024) and exact_pin_occurs(req, selection_pin),
        'actual current original canonical publication/request, never filename or reconciliation inference')
    draft = fact(rows[role]['draft_path'], read(rows[role]['draft_path'], pin['sha256']))
    need(draft['bytes'] == pin['bytes'], 'selected draft and canonical same actual complete bytes')
    original_publication_draft_request(req, pub, support['original_request'], support['original_publication'],
        pin, draft, role, rows, selection_pin)
    canonical_review = strict_source_json(read_pin(support['Source_review']))
    canonical_adoption = root_record(support['Root_adoption'])
    publication_birth = OBSERVATIONS[support['original_publication']['path']]['path9'][8]
    need(type(publication_birth) is int and publication_birth > 0
        and publication_birth // 100 <= moment(canonical_review['created_utc'])
        and exact_pin_occurs(canonical_review, support['original_publication'])
        and exact_pin_occurs(canonical_adoption, support['original_publication']),
        'separate later canonical creation review/adoption covers actual original publication; never inserted into prior request')
    recon = root_record(support['reconciliation'])
    need(exact_pin_occurs(recon, pin) and exact_pin_occurs(recon, support['original_publication'])
        and recon.get('target_execution') is False and recon.get('operational_authority') is False,
        'separate actual publication reconciliation')
    source_acceptance(support['reconciliation'], support['reconciliation_review'],
        support['reconciliation_Root_adoption'], selection_pin, '/root')
    return pin, data


def admitted(args):
    need(os.name == 'nt' and sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1,
        'own Windows general-host isolated metadata transport only')
    scope = gate(SOURCE024['path'], SOURCE024['sha256'])
    own_pin = fact(SELF, read(SELF, args.expected_self_sha256))
    frame = strict_source_json(read_pin(BASIS_FRAME))
    facts_pin = fact(args.facts, read(args.facts, args.expected_facts_sha256))
    facts = strict_source_json(read_pin(facts_pin))
    exact(facts, FACT_KEYS, 'Root late facts exact26, never external original binding20/config18')
    need(absolute(args.facts).parent == ROOT_OWNED and facts['author'] == facts['physical_actor'] == '/root'
        and type(facts['schema_version']) is int and facts['schema_version']==1
        and facts['record_type']=='Root_Source024_lawful_future_cohort_deferred_metadata_stage_facts'
        and facts['metadata_Source_worker'] == SOURCE_AUTHOR and facts['source_only'] is True
        and all(facts[key] is False for key in ('target_execution','operational_authority','lease_issuance'))
        and facts['Source024'] == SOURCE024 and facts['tool_source'] == own_pin
        and facts['stage'] in ('render','binding','config','publish') and facts['role'] in SUPPORTED_ROLES,
        'genuine Root-only current Source metadata facts/actor; no native, fixture or lease issuance')
    tool_review, tool_adoption = source_acceptance(own_pin, facts['tool_review'], facts['tool_Root_adoption'], CURRENT_ROOT_SELECTION, SOURCE_AUTHOR)
    own_API_pin = fact(API_PATH, read(API_PATH))
    own_API = strict_source_json(read_pin(own_API_pin))
    need(own_API['tool_source'] == own_pin and own_API['current_Source024'] == SOURCE024
        and own_API['actual_binding_Source_editor'] == BINDING_SOURCE_EDITOR
        and exact_pin_occurs(tool_review, own_API_pin) and exact_pin_occurs(tool_adoption, own_API_pin),
        'fresh genuine current24 Tool and API review/Root adoption before any metadata write')
    source_acceptance(facts_pin, positive_pin(dict(path=args.facts_review, sha256=args.expected_facts_review_sha256,
        bytes=ordinary_chain(args.facts_review,file=True).stat().st_size)),
        positive_pin(dict(path=args.facts_adoption, sha256=args.expected_facts_adoption_sha256,
        bytes=ordinary_chain(args.facts_adoption,file=True).stat().st_size)), facts['Root_selection'], '/root')
    selection = root_record(facts['Root_selection'])
    source_acceptance(facts['Root_selection'], facts['selection_review'], facts['selection_Root_adoption'], CURRENT_ROOT_SELECTION, '/root')
    lease = actual_lawful_lease(facts['lawful_lease_support'])
    need(selection['new_canonical_lease'] == facts['lawful_lease_support']['canonical'], 'selection and real reviewed lawful lease agree')
    rows = role_paths(selection, facts['output_namespace'], frame)
    row = rows[facts['role']]
    need(facts['predecessor'] == row['predecessor'], 'exact actual Source predecessor selected at late decision')
    before = read_pin(positive_pin(facts['predecessor']))
    decision = root_record(facts['stage_decision'])
    exact(decision,STAGE_DECISION_KEYS,'separate Root metadata stage decision exact14, no circular facts pin')
    need(decision.get('decision') == 'ADMIT_SEPARATE_SOURCE024_LAWFUL_COHORT_METADATA_STAGE'
        and decision.get('stage') == facts['stage'] and decision.get('role') == facts['role']
        and decision['record_type']=='Root_Source024_separate_lawful_cohort_metadata_stage_decision'
        and type(decision['schema_version']) is int and decision['schema_version']==1
        and decision.get('physical_actor') == '/root' and decision.get('target_execution') is False
        and decision.get('operational_authority') is False and exact_pin_occurs(decision, SOURCE024)
        and exact_pin_occurs(decision, facts['lawful_lease_support']['canonical'])
        and exact_pin_occurs(decision, own_pin) and exact_pin_occurs(decision, facts['Root_selection']),
        'separate prior genuine Root stage decision; reviewed facts bind it without a digest cycle')
    need(moment(decision['created_utc'],6)<=moment(facts['created_utc'],6)<=current_ticks(),
        'actual Root decision precedes exact reviewed late facts, no prospective fabricated dates')
    need(type(facts['canonical_dependencies']) is dict,'finite actual canonical dependency object')
    pins, bodies = {}, {}
    for role, support in facts['canonical_dependencies'].items():
        need(role in rows, 'finite selected actual dependency role')
        pins[role], bodies[role] = dependency(support, role, rows, facts['Root_selection'])
    source_reserve(lease)
    return dict(facts=facts, facts_pin=facts_pin, rows=rows, frame=frame, lease=lease, row=row, before=before,
        pins=pins, bodies=bodies, own_pin=own_pin, scope=scope)


def restore_byte_edits(after, edits):
    result = after
    for edit in reversed(edits):
        start = edit['new_start']
        fresh = base64.b64decode(edit['new_bytes_base64'], validate=True)
        old = base64.b64decode(edit['old_bytes_base64'], validate=True)
        need(result[start:start+len(fresh)] == fresh, 'exact new literal bytes before reversal')
        result = result[:start] + old + result[start+len(fresh):]
    return result


def replacement_value(kind, reference_role, old, state):
    rows, frame, pins = state['rows'], state['frame'], state['pins']
    if kind.startswith('lease_'):
        lease = state['facts']['lawful_lease_support']['canonical']
        prior = frame['existing_lease010']
        expected = {'lease_leaf': Path(prior['path']).name, 'lease_sha256': prior['sha256'],
            'lease_end': frame['existing_lease010_end']}[kind]
        need(old == expected, 'real original exact lease literal, not arbitrary string')
        return {'lease_leaf': Path(lease['path']).name, 'lease_sha256': lease['sha256'],
            'lease_end': state['lease']['lease_end_utc']}[kind]
    need(reference_role in rows, 'actual selected identity role')
    candidates = frame['role_basis'][reference_role]['historical_identity_candidates']
    paths = frame['role_basis'][reference_role]['historical_identity_paths']
    selected_path = rows[reference_role]['canonical_path']
    if kind == 'sha256':
        need(reference_role != state['facts']['role'] and reference_role in pins
            and any(pin.get('sha256') == old for pin in candidates), 'actual dependency digest only, never own hash cycle')
        return pins[reference_role]['sha256']
    if kind in ('leaf', 'path'):
        matches = [path for path in paths if old == (Path(path).name if kind == 'leaf' else path)]
        need(len(matches) > 0, 'exact whole old identity leaf/path from actual retained basis')
        return Path(selected_path).name if kind == 'leaf' else selected_path
    if kind == 'relative_path':
        matches=[path for path in paths if Path(path).is_relative_to(BASE)
            and old==Path(path).relative_to(BASE).as_posix()]
        need(len(matches)>0 and Path(selected_path).is_relative_to(BASE),'exact whole original canonical relative identity path')
        return Path(selected_path).relative_to(BASE).as_posix()
    if kind == 'relative_windows_path':
        matches=[path for path in paths if Path(path).is_relative_to(BASE)
            and old==str(Path(path).relative_to(BASE))]
        need(len(matches)>0 and Path(selected_path).is_relative_to(BASE),'exact whole original Windows relative identity path')
        return str(Path(selected_path).relative_to(BASE))
    if kind == 'phase_stem':
        need(reference_role.endswith('_bound') and any(Path(path).name == old+'.BOUND.ps1' for path in paths),
            'exact utility old generated-bound phase stem')
        need(Path(selected_path).name.endswith('.BOUND.ps1'), 'actual selected bound phase suffix')
        return Path(selected_path).name[:-len('.BOUND.ps1')]
    if kind == 'phase_template_suffix':
        need(reference_role.endswith('_template') and any(Path(path).name.endswith(old) for path in paths)
            and re.fullmatch(r'_003-corrected\d{3}\.TEMPLATE\.ps1', old), 'exact old utility corrected-template suffix')
        match = re.search(r'_003-corrected\d{3}\.TEMPLATE\.ps1$', Path(selected_path).name)
        need(match is not None, 'real selected corrected-template suffix')
        return match.group()
    raise ValueError('unaccepted literal transformation kind')


def render_literal_source(state):
    role, before = state['facts']['role'], state['before']
    need(role in SOURCE_ROLES and state['facts']['publication_request'] is None, 'seven literal Source producers only')
    support = state['facts']['stage_support']
    exact(support, ('literal_edits',), 'render literal support exact1')
    need(type(support['literal_edits']) is list and 1 <= len(support['literal_edits']) <= 512, 'finite genuinely reviewed late literal plan')
    allowed = state['frame']['literal_slots'][role]
    need({(edit['start'],edit['end']) for edit in support['literal_edits']}==
        {(slot['start'],slot['end']) for slot in allowed} and len(support['literal_edits'])==len(allowed),
        'exact complete finite identity/lease slot plan; no omitted active reference or extra code edit')
    pieces, changes, cursor, offset = [], [], 0, 0
    python = role in ('utility', 'checker')
    for edit in sorted(support['literal_edits'], key=lambda item:item['start']):
        exact(edit, ('start','end','expected_Source','kind','reference_role'), 'late literal edit exact5')
        start, end = edit['start'], edit['end']
        need(type(start) is int and type(end) is int and cursor <= start < end <= len(before)
            and before[start:end].decode('utf8') == edit['expected_Source'], 'nonoverlapping exact original byte coordinates')
        need(any(row['start'] == start and row['end'] == end and row['whole_literal'] == edit['expected_Source']
            and dict(kind=edit['kind'],reference_role=edit['reference_role']) in row['permitted_transformations'] for row in allowed),
            'only actual inventoried Source literal slots, no arbitrary code edit')
        source = edit['expected_Source']
        if python:
            old = ast.literal_eval(source)
            need(type(old) is str, 'Python string literal only; original None/types/constants protected')
        else:
            need(source.startswith("'") and source.endswith("'"), 'PS singlequoted literal only; no variable expression normalization')
            old = source[1:-1].replace("''", "'")
        fresh_value = replacement_value(edit['kind'], edit['reference_role'], old, state)
        fresh = (repr(fresh_value) if python else "'"+fresh_value.replace("'", "''")+"'").encode('utf8')
        pieces.extend((before[cursor:start], fresh))
        changes.append(dict(start=start, end=end, new_start=start+offset, old_bytes_base64=base64.b64encode(before[start:end]).decode('ascii'),
            new_bytes_base64=base64.b64encode(fresh).decode('ascii'), kind=edit['kind'], reference_role=edit['reference_role']))
        offset += len(fresh)-(end-start)
        cursor = end
    pieces.append(before[cursor:])
    result = b''.join(pieces)
    need(result != before and len(result) <= state['row']['source_cap']
        and restore_byte_edits(result, changes) == before, 'whole canonical predecessor byte inverse/original cap/no untouched payload drift')
    if python:
        old_tree, new_tree = ast.parse(before), ast.parse(result)
        need(ast.dump(ast.parse(restore_byte_edits(result,changes)),include_attributes=False)==
            ast.dump(old_tree,include_attributes=False),'entire original AST reconstructed by exact literal reversal')
        old_functions = [(type(node).__name__,node.name) for node in old_tree.body if isinstance(node,(ast.FunctionDef,ast.ClassDef))]
        new_functions = [(type(node).__name__,node.name) for node in new_tree.body if isinstance(node,(ast.FunctionDef,ast.ClassDef))]
        need(old_functions == new_functions, 'all original function/class names/order retained; whole literal inverse preserves their bodies')
        for tree in (old_tree,new_tree):
            assignments = {n.targets[0].id:n.value for n in tree.body if isinstance(n,ast.Assign)
                and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
            if role == 'utility':
                need(all(isinstance(assignments[name],ast.Constant) and assignments[name].value is None
                    for name in ('SOURCE_BINDINGS','SOURCE_PROTOCOL','OWNER_PIN','OWNER_END')), 'utility original unbound globals remain None')
    return result, dict(literal_edits=changes, whole_predecessor_bytes_base64=base64.b64encode(before).decode('ascii'),
        exact_whole_byte_inverse=True, Parser_or_target_execution=False)


class CanonicalMetadata:
    """Metadata facade for the preserved genuine seven-M3-link validator, not an imported helper."""
    def __init__(self, state):
        self.state = state
    def read(self, path, expected=None):
        pins = list(self.state['pins'].values()) + self.state.get('carried_pins', [])
        matches = [pin for pin in pins if pin['path'] == str(path) and (expected is None or pin['sha256'] == expected)]
        need(len(matches) > 0, 'only authenticated actual dependency or carried input')
        return read_pin(matches[0])
    def decode(self, data):
        return strict_source_json(data)
    def fact(self, path, data):
        return fact(path, data)
    def sha(self, data):
        return sha(data)


def assemble_pipeline_binding(state):
    need(state['facts']['role'] == 'binding' and state['facts']['publication_request'] is None, 'binding stage is metadata only')
    support = state['facts']['stage_support']
    exact(support, ('carried_inputs',), 'binding carry support exact1')
    old = strict_source_json(state['before'])
    frame, rows, pins = state['frame'], state['rows'], state['pins']
    required = set(BINDING_SOURCE_ROLES.values()) | {'child','driver_bound','observer_bound','launcher_template','profile','static',
        'metadata_manifest','metadata_peer','metadata_binding','capture_bound','metadata_bound_review','phase_binding','phase_peer'}
    need(set(pins)==required and len(pins)==21,'actual14 original Source pins plus genuine7 M3 chain, no external closed20 facts')
    exact(old, frame['original_binding_closed20'], 'same original closed20, generated internally')
    need(old['author'] == '/root' and old['scope'] == state['lease']['scope']
        and type(old['maximum_retained_seconds']) is int and old['maximum_retained_seconds'] == 3600,
        'original Unit006 scope/Root nominal/retained3600')
    new = copy.deepcopy(old)
    changes = []
    def update(pointer, role, location):
        need(role in pins and set(pointer) in ({'path','sha256'},{'path','sha256','bytes'}), 'original Source pointer2/3')
        previous = copy.deepcopy(pointer)
        pointer.update(path=pins[role]['path'],sha256=pins[role]['sha256'])
        if 'bytes' in pointer:
            pointer['bytes'] = pins[role]['bytes']
        changes.append(dict(where=location,role=role,old=previous,new=copy.deepcopy(pointer)))
    for key, role in (('child','child'),('driver','driver_bound'),('observer','observer_bound'),('launcher_template','launcher_template')):
        update(new['guard_sources'][key],role,'guard_sources.'+key)
    update(new['profile'],'profile','profile')
    update(new['harness_static_review'],'static','harness_static_review')
    static = strict_source_json(state['bodies']['static'])
    need(static['reviewer'] == '/root' and static['verdict'] == 'PASS_STATIC_PREPARATION_ONLY'
        and static['target_definitions_executed'] is False and static['tests_executed'] is False,
        'real genuinely authored Root static Source peer, never a template clone')
    exact(new['sources'], tuple(BINDING_SOURCE_ROLES), 'eight original Source rows')
    for key, role in BINDING_SOURCE_ROLES.items():
        update(new['sources'][key],role,'sources.'+key)
    need(len(changes) == 14, 'fourteen actual Source pointers with no guessed digest')
    new['owner_lease_sha256'] = state['facts']['lawful_lease_support']['canonical']['sha256']
    new['owner_lease_end_utc'] = state['lease']['lease_end_utc']
    carried_fields = ('coordination_peer_reply','coordination_root_response','source_capsule','source_capsule_review',
        'source_manifest','projection','packet_composer')
    exact(support['carried_inputs'], carried_fields, 'all original carried binding inputs explicit')
    state['carried_pins'] = []
    for key in carried_fields:
        carried = support['carried_inputs'][key]
        exact(carried,('canonical','Source_review','Root_adoption'),'current carried input support3')
        pin = positive_pin(carried['canonical'])
        need(pin['path'] == old[key]['path'] and pin['sha256'] == old[key]['sha256'], 'original dated carried input unchanged')
        source_acceptance(pin,carried['Source_review'],carried['Root_adoption'],state['facts']['Root_selection'],'/root')
        state['carried_pins'].append(pin)
        need(new[key] == old[key], 'original carried pointer and nominal fields entire exact')
    for key in ('coordination_peer_reply','coordination_root_response'):
        exact(new[key], ('path','relative','sha256'), 'carried historical closed3 coordinates remain entire exact')
    meta = CanonicalMetadata(state)
    chain = genuine_m3_source_chain(meta, rows, new)
    inverse = copy.deepcopy(new)
    for change in changes:
        parent = inverse
        path = change['where'].split('.')
        for key in path[:-1]:
            parent = parent[key]
        parent[path[-1]] = change['old']
    inverse['owner_lease_sha256'] = old['owner_lease_sha256']
    inverse['owner_lease_end_utc'] = old['owner_lease_end_utc']
    need(inverse == old and set(new) == set(old), 'complete predecessor metadata inverse, no schema widening')
    indent = state['frame']['binding_wire_indent']
    need(wire(old,indent=indent) == state['before'], 'exact original canonical binding wire')
    result = wire(new,indent=indent)
    need(len(result) <= state['row']['source_cap'], 'original binding Source cap')
    return result, dict(actual14_Source_changes=changes, actual_genuine_M3_chain=chain,
        old_lease_SHA=old['owner_lease_sha256'],old_lease_end=old['owner_lease_end_utc'],
        whole_predecessor_bytes_base64=base64.b64encode(state['before']).decode('ascii'), exact_whole_metadata_inverse=True)


def json_changes(old,new,path=()):
    need(type(old) is type(new), 'original JSON field types remain exact')
    if type(old) is dict:
        need(set(old) == set(new), 'original nested closed keysets exact')
        return [change for key in old for change in json_changes(old[key],new[key],path+(key,))]
    if type(old) is list:
        need(len(old) == len(new), 'original list length retained')
        return [change for index in range(len(old)) for change in json_changes(old[index],new[index],path+(index,))]
    return [] if old == new else [dict(path=list(path),old=old,new=new)]


def restore_json(value, changes):
    value = copy.deepcopy(value)
    for change in reversed(changes):
        found = value
        for key in change['path'][:-1]:
            found = found[key]
        need(found[change['path'][-1]] == change['new'], 'exact changed JSON value before inverse')
        found[change['path'][-1]] = change['old']
    return value


def assemble_checker_config(state):
    need(state['facts']['role'] == 'checker_config' and state['facts']['publication_request'] is None, 'config stage internally generated closed18')
    support = state['facts']['stage_support']
    exact(support, ('nonce_carry','spent_map','checker_Source_details','checker_details_review','checker_details_Root_adoption','carried_inputs'),
        'config finite support exact6')
    expected_roles = set(state['rows'])-{'checker_config','table','constructor','constructor_manifest','constructor_review','selector'}
    pins, bodies = state['pins'], state['bodies']
    need(set(pins) == expected_roles and len(pins) == 39, 'exact39 genuinely canonical dependencies before config')
    peer = strict_source_json(bodies['checker_peer'])
    exact(peer, state['frame']['original_checker_peer_closed15'], 'genuine Root checker peer original closed15')
    details = root_record(support['checker_Source_details'])
    source_acceptance(support['checker_Source_details'],support['checker_details_review'],
        support['checker_details_Root_adoption'],state['facts']['Root_selection'],'/root')
    need(peer['reviewer'] == '/root' and peer['verdict'] == 'PASS_STATIC_METADATA3_CHECKER_SOURCE_ONLY'
        and peer['checker_template_sha256'] == pins['checker']['sha256']
        and peer['source_manifest_sha256'] == pins['checker_manifest']['sha256']
        and peer['full_source_details_sha256'] == support['checker_Source_details']['sha256']
        and exact_pin_occurs(details,pins['checker']) and exact_pin_occurs(details,pins['checker_protocol'])
        and exact_pin_occurs(details,pins['checker_dependency_audit']) and exact_pin_occurs(details,pins['checker_manifest'])
        and peer['actual_binding'] is None and all(peer[key] is False for key in
            ('operational_authority','runtime_acceptance','target_execution','tests_executed')),
        'fresh genuine Root full Source details distinct from worker author receipt; no peer borrow')
    for role, verdict in (('metadata_peer','PASS_STATIC_METADATA_PREPARATION_ONLY'),('metadata_bound_review','PASS_STATIC_BOUND_METADATA_ONLY'),
        ('phase_peer','PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY'),('pipeline_peer','PASS_STATIC_ROOT_PIPELINE_SOURCE_ONLY')):
        value = strict_source_json(bodies[role])
        need(value['reviewer'] == '/root/owner_docs_review' and value['verdict'] == verdict, 'actual genuine original dependency peer')
    old = strict_source_json(state['before'])
    exact(old,state['frame']['original_config_closed18'],'same original config closed18')
    need(old['maximum_wait_seconds'] == 3600 and type(old['maximum_wait_seconds']) is int and old['binder'] == '/root'
        and old['actual_actions_executed'] is False and old['scope'] == state['lease']['scope'], 'unchanged original config caps/flags/scope')
    carry = root_record(support['nonce_carry'])
    need(carry['decision'] == 'SELECT_CARRY_EXISTING_UNENTERED_PROSPECTIVE_SOURCE_NONCE'
        and carry['selected_nonce'] == old['execution_launch_witness']['nonce']
        and carry['proposed_nonce_was_not_a_physical_actor_witness'] is True
        and carry['actual_entry_or_execution_authority'] is False and exact_pin_occurs(carry,SOURCE024)
        and exact_pin_occurs(carry,state['facts']['Root_selection']), 'original unconsumed nonce retained by real separate Root decision')
    cfg = copy.deepcopy(old)
    cfg.update(checker_template_sha256=pins['checker']['sha256'],checker_source_peer_sha256=pins['checker_peer']['sha256'],
        owner_lease_sha256=state['facts']['lawful_lease_support']['canonical']['sha256'],owner_lease_end_utc=state['lease']['lease_end_utc'])
    for field,role in (('guard_profile_sha256','profile'),('guard_harness_static_review_sha256','static'),('preparer_static_review_sha256','metadata_peer')):
        cfg['metadata_bindings'][field] = pins[role]['sha256']
    cfg['metadata_input_paths']['guard_harness_static_review_sha256'] = pins['static']['path']
    cfg['metadata_input_paths']['preparer_static_review_sha256'] = pins['metadata_peer']['path']
    for group,assignments in CONFIG_GROUPS.items():
        exact(cfg[group],tuple(assignments),'original config group closed keys')
        for key,role in assignments.items():
            exact(cfg[group][key],('path','sha256'),'original Source pointer2')
            cfg[group][key].update(path=pins[role]['path'],sha256=pins[role]['sha256'])
    cfg['root_pipeline_source'] = dict(path=pins['pipeline']['path'],sha256=pins['pipeline']['sha256'],
        source_peer_path=pins['pipeline_peer']['path'],source_peer_sha256=pins['pipeline_peer']['sha256'])
    need(cfg['execution_launch_witness'] == old['execution_launch_witness'], 'entire prospective launch witness retained, no physical actor fabricated')
    carried_fields={key for key,path in old['metadata_input_paths'].items()
        if key not in ('guard_harness_static_review_sha256','preparer_static_review_sha256')}
    exact(support['carried_inputs'],tuple(carried_fields),'original six carried metadata input fields')
    for field,carried in support['carried_inputs'].items():
        exact(carried,('canonical','Source_review','Root_adoption'),'current carried Source eligibility support3')
        need(carried['canonical']==state['frame']['config_carried_inputs'][field], 'exact original dated config input f3')
        source_acceptance(carried['canonical'],carried['Source_review'],carried['Root_adoption'],state['facts']['Root_selection'],'/root')
    for field,path in cfg['metadata_input_paths'].items():
        need(any(pin['path'] == path and pin['sha256'] == cfg['metadata_bindings'][field] for pin in pins.values())
            or path == old['metadata_input_paths'][field], 'original or exact new authenticated metadata path')
        read(path,cfg['metadata_bindings'][field])
    capture = strict_source_json(bodies['metadata_binding'])
    bound = strict_source_json(bodies['metadata_bound_review'])
    phase = strict_source_json(bodies['phase_binding'])
    binding = strict_source_json(bodies['binding'])
    pp = strict_source_json(bodies['pipeline_peer'])
    need(capture['bindings'] == cfg['metadata_bindings'] == bound['source_bindings']
        and capture['actual_script_sha256'] == bound['actual_script_sha256'] == pins['capture_bound']['sha256']
        and phase['actual_script_sha256'] == pins['capture_bound']['sha256']
        and phase['bound_review_sha256'] == pins['metadata_bound_review']['sha256'], 'original capture/config nine binding and genuine phase chain')
    need(binding['owner_lease_sha256'] == cfg['owner_lease_sha256'] and binding['owner_lease_end_utc'] == cfg['owner_lease_end_utc']
        and binding['maximum_retained_seconds'] == cfg['maximum_wait_seconds']
        and pp['pipeline_binding_sha256'] == pins['binding']['sha256'] and pp['pipeline_source_sha256'] == pins['pipeline']['sha256']
        and pp['target_execution'] is False and pp['operational_authority_granted'] is False, 'same actual pipeline/config lease and genuinely accepted Source-only peer')
    assignments = {n.targets[0].id:n.value for n in ast.parse(bodies['checker']).body if isinstance(n,ast.Assign)
        and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
    need(ast.literal_eval(assignments['M3_MANIFEST_SHA']) == pins['metadata_manifest']['sha256']
        and Path(pins['pipeline']['path']).name.encode() in bodies['checker'], 'actual checker baked manifest/pipeline identity')
    changes = json_changes(old,cfg)
    need(len(changes) == 43 and wire(restore_json(cfg,changes)) == state['before'], 'original43 authorized leaves and whole config byte inverse')
    spent = verify_spent75(support['spent_map'],carry,old,state)
    result = wire(cfg)
    need(len(result) <= state['row']['source_cap'], 'original config Source cap')
    return result, dict(changed_leaves=changes,whole_predecessor_bytes_base64=base64.b64encode(state['before']).decode('ascii'),
        exact_whole_byte_inverse=True,original_nonce_unconsumed=True,actual_spent75=spent,
        genuine_Root_checker_details=support['checker_Source_details'],genuine_Source_peer=pins['checker_peer'])


def verify_spent75(pin,carry,old,state):
    need(pin == state['frame']['spent_map'], 'exact original spent75 map, no new operational identity allocation')
    mapping = strict_source_json(read_pin(pin))
    rows = mapping['all75_spent_entry005_records_reference']
    need(len(rows) == 75, 'original75 immutable spent identities')
    result,absences = [],set()
    for row in rows:
        spent = row['spent']
        need(spent in state['frame']['spent_pins'], 'finite exact authenticated spent fact3 whitelist')
        read_spent_pin(spent)
        result.append(spent)
        absences.add(row['future_path'])
    for row in mapping['actual_output_names_and_read_only_absence_snapshot'].values():
        absences.add(row['path'])
    for path in absences:
        absent_output(path)
    ready_rows = []
    for entry in state['frame']['historical_READY']:
        value = strict_source_json(read_pin(entry))
        need(value['execution_nonce'] != old['execution_launch_witness']['nonce'], 'no old READY consumes prospective retained nonce')
        ready_rows.append(entry)
    need(len(ready_rows) == 2 and carry['intended_future_ready'] in absences, 'original two READY history and future identities remain unentered')
    return result


def read_spent_pin(pin):
    """Exact old spent-only empty/4MiB exceptions; ordinary Source remains2MiB."""
    need(pin in SPENT_PINS, 'only exact original75 spent fact3s')
    if pin['bytes'] == 0:
        need(pin in EMPTY_SPENT_PINS and pin['sha256'] == sha(b''), 'exact finite11 historical empty spent streams only')
    cap = 4194304 if pin in ARCHIVAL_SPENT_PINS else 2097152
    need(pin['bytes'] <= cap, 'original specific archive4MiB cap; no blanket increase')
    # The original paired reader guard is retained for these exact archival subjects only.
    path = ordinary_chain(pin['path'],file=True)
    before = raw9(path.lstat())
    with path.open('rb') as handle:
        opened = raw9(os.fstat(handle.fileno()))
        info=os.fstat(handle.fileno())
        need(stat.S_ISREG(info.st_mode) and info.st_nlink==1 and not (getattr(info,'st_file_attributes',0)&0x400),
            'same ordinary singlelink/nonreparse spent descriptor guard')
        need(all(before[i] == opened[i] for i in (0,1,2,3,6,7,8)), 'spent shared7 exact')
        one = handle.read(cap+1);handle.seek(0);two = handle.read(cap+1)
        need(raw9(os.fstat(handle.fileno())) == opened, 'spent whole fd9 unchanged')
    need(raw9(path.lstat()) == before and one == two and fact(path,one) == pin, 'actual exact spent bytes/fullPATH9/fd9')
    prior = OBSERVATIONS.get(str(path))
    current = dict(path=str(path),sha256=sha(one),bytes=len(one),cap=cap,path9=before,descriptor9=opened,
        raw9=before,two_read_match=True,observed_utc=utc(),exact_spent_exception=True)
    need(prior is None or prior['path9'] == before and prior['descriptor9'] == opened, 'whole initial spent independent APIs retained')
    OBSERVATIONS[str(path)] = current
    return one


def guarded_postread():
    rows = [dict(value) for value in OBSERVATIONS.values()]
    for value in rows:
        if value.get('exact_spent_exception') is True:
            read_spent_pin(dict(path=value['path'],sha256=value['sha256'],bytes=value['bytes']))
        else:
            read(value['path'],value['sha256'],value['cap'])
        fresh = OBSERVATIONS[value['path']]
        need(fresh['path9'] == value['path9'] and fresh['descriptor9'] == value['descriptor9']
            and fresh['sha256'] == value['sha256'] and fresh['bytes'] == value['bytes'], 'both whole independent API9 and full bytes retained across stage')
    return rows


def write_once(path,data,cap,state,*,canonical=False):
    need(type(data) is bytes and 0 < len(data) <= cap <= 2097152, 'unchanged bounded Source output bytes')
    path = absolute(path)
    namespace = absolute(state['facts']['output_namespace'])
    role_path = absolute(state['row']['canonical_path'] if canonical else state['row']['draft_path'])
    need(path == role_path or path.parent == namespace/'receipts', 'only selected role output or own selected receipt namespace')
    ordinary_chain(path.parent,file=False)
    need(path.parent.is_dir(), 'Root must physically prepare the reviewed output parent; no allocator or implicit directory creation')
    absent_output(path)
    source_reserve(state['lease']);guarded_postread();source_reserve(state['lease'])
    staging = Path(str(path)+'.staging')
    with staging.open('xb') as handle:
        need(handle.write(data) == len(data), 'whole owned staging write')
        handle.flush();os.fsync(handle.fileno())
    staged = fact(staging,read(staging,sha(data),cap))
    need(staged['bytes'] == len(data), 'whole staging Source readback')
    source_reserve(state['lease']);guarded_postread();source_reserve(state['lease'])
    need(not os.path.lexists(path), 'destination remains absent immediately before native-safe Windows rename')
    os.rename(staging,path)
    # Staging is deliberately no longer a live input after its own exact rename.
    OBSERVATIONS.pop(str(staging),None)
    output = fact(path,read(path,sha(data),cap))
    source_reserve(state['lease'])
    return output


def publication_stage(state):
    need(state['facts']['role'] in SUPPORTED_ROLES, 'no genuine peer/composer/four-observation metadata authoring in this tool')
    support = state['facts']['stage_support']
    exact(support,('draft','draft_Source_review','draft_Root_adoption','generation_receipt','generation_receipt_review',
        'generation_receipt_Root_adoption'), 'publication only exact actually generated accepted draft/support6')
    row = state['row']
    draft = positive_pin(support['draft'])
    need(draft['path'] == row['draft_path'], 'exact selected draft only')
    data = read_pin(draft)
    source_acceptance(draft,support['draft_Source_review'],support['draft_Root_adoption'],state['facts']['Root_selection'],'/root',worker=SOURCE_AUTHOR)
    receipt = strict_source_json(read_pin(support['generation_receipt']))
    source_acceptance(support['generation_receipt'],support['generation_receipt_review'],
        support['generation_receipt_Root_adoption'],state['facts']['Root_selection'],'/root',worker=SOURCE_AUTHOR)
    need(receipt['physical_actor'] == '/root' and receipt['metadata_Source_worker'] == SOURCE_AUTHOR
        and receipt['draft'] == draft and receipt['predecessor'] == state['facts']['predecessor']
        and receipt['role'] == state['facts']['role'] and receipt['target_execution'] is False
        and receipt['operational_authority'] is False, 'honest actual Root serializer/Pipeline tool worker/retained semantic attribution')
    request = root_record(positive_pin(state['facts']['publication_request']))
    exact(request,PUBLICATION_REQUEST_KEYS,'Root selected reviewed Source publication request exact14')
    need(request.get('decision') == 'PUBLISH_EXACT_REVIEWED_SOURCE_ONLY_SELECTED_ROLE'
        and request['record_type']=='Root_Source024_selected_role_exact_reviewed_Source_publication_request'
        and request.get('role') == state['facts']['role'] and request.get('draft') == draft
        and request.get('canonical_path') == row['canonical_path'] and request.get('target_execution') is False
        and request.get('operational_authority') is False and exact_pin_occurs(request,state['facts']['Root_selection'])
        and request.get('Source_review')==support['draft_Source_review'] and request.get('Root_adoption')==support['draft_Root_adoption']
        and exact_pin_occurs(request,SOURCE024), 'separate genuine exact Root publication request')
    output = write_once(row['canonical_path'],data,row['source_cap'],state,canonical=True)
    return output, dict(generation_receipt=support['generation_receipt'],different_draft_Source_review=support['draft_Source_review'],
        Root_draft_adoption=support['draft_Root_adoption'],original_request=state['facts']['publication_request'],canonical_publication=True)


def main():
    parser = argparse.ArgumentParser(allow_abbrev=False)
    for name in ('facts','expected-facts-sha256','expected-self-sha256','facts-review','expected-facts-review-sha256',
        'facts-adoption','expected-facts-adoption-sha256'):
        parser.add_argument('--'+name,required=True)
    args = parser.parse_args()
    state = admitted(args)
    stage = state['facts']['stage']
    receipt_name = Path(state['row']['draft_path']).name+'.'+stage+'.Source024.receipt.json'
    receipt_path=absolute(state['facts']['output_namespace'])/'receipts'/receipt_name
    need(receipt_path.parent.is_dir(),'Root physically prepared exact stage receipt parent')
    absent_output(receipt_path)
    if stage == 'publish':
        output,details = publication_stage(state)
    else:
        need(not os.path.lexists(state['row']['canonical_path']) and not os.path.lexists(state['row']['canonical_path']+'.staging'),
            'fresh future canonical identity before Source draft creation')
        if stage == 'render':
            data,details = render_literal_source(state)
        elif stage == 'binding':
            data,details = assemble_pipeline_binding(state)
        elif stage == 'config':
            data,details = assemble_checker_config(state)
        else:
            raise ValueError('unknown metadata stage')
        output = write_once(state['row']['draft_path'],data,state['row']['source_cap'],state)
    observations = guarded_postread()
    record = dict(schema_version=1,record_type=('Root_Source024_selected45_role_Source_canonical_publication' if stage=='publish'
        else 'Root_Source024_selected_role_deferred_metadata_stage_receipt'),
        author='/root',physical_actor='/root',metadata_Source_worker=SOURCE_AUTHOR,
        retained_semantic_Source_author=state['row']['retained_semantic_Source_author'],created_utc=utc(),
        Source024=SOURCE024,Root_selection=state['facts']['Root_selection'],lawful_lease_support=state['facts']['lawful_lease_support'],
        actual_Root_late_facts=state['facts_pin'],original_request=state['facts']['publication_request'],
        tool_source=state['own_pin'],tool_Source_review=state['facts']['tool_review'],tool_Root_adoption=state['facts']['tool_Root_adoption'],
        role=state['facts']['role'],stage=stage,predecessor=state['facts']['predecessor'],draft=output if stage!='publish' else state['facts']['stage_support']['draft'],
        canonical=output if stage=='publish' else None,canonical_publication=stage=='publish',details=details,
        actual_paired_metadata_inputs=observations,target_execution=False,operational_authority=False,lease_issuance=False,
        genuine_peer_authored=False,Native_or_Parser_or_original_fixture_or_science=False,
        original_Source_guards_caps_inverse_and_all_spent_gates_preserved=True)
    receipt = write_once(receipt_path,wire(record),2097152,state)
    print(json.dumps(dict(output=output,receipt=receipt,target_execution=False,operational_authority=False),sort_keys=True))




