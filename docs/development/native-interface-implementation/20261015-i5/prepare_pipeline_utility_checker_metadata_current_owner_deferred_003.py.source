         and adoption['target_execution'] is False and adoption['operational_authority'] is False
         and exact_pin_occurs(adoption, SOURCE024) and exact_pin_occurs(adoption, GATE024_REVIEW)
         and OBSERVATIONS[GATE024_REVIEW['path']]['path9'][8]//100 <= moment(adoption['created_utc']),
         'real Root adoption of exact genuine current gate review')
    now = current_ticks()
    need(moment(request['created_utc'],6) <= moment(peer['created_utc'],6) <= moment(scope['created_utc'],6)
         <= moment(review['created_utc'],6) <= moment(adoption['created_utc'],6) <= now
         and moment(scope['interval_start'],7) <= now and now+60*10000000 < moment(scope['interval_end'],7),
         'prearranged scheduling chronology independent of current start and unchanged60 reserve')
    _CURRENT_GATE = scope
    return scope

def genuine_m3_source_chain(helper, rows, config):
    """Validate actual Source metadata links; never call capture or phase code."""
    values, pins = {}, {}
    for role in ('metadata_manifest', 'metadata_peer', 'metadata_binding', 'capture_bound',
                 'metadata_bound_review', 'phase_binding', 'phase_peer'):
        selected = rows[role]
        raw = helper.read(selected['canonical_path'])
        pins[role] = helper.fact(selected['canonical_path'], raw)
        if role != 'capture_bound':
            values[role] = helper.decode(raw)
    for role, verdict in (('metadata_peer', 'PASS_STATIC_METADATA_PREPARATION_ONLY'),
                          ('metadata_bound_review', 'PASS_STATIC_BOUND_METADATA_ONLY'),
                          ('phase_peer', 'PASS_STATIC_ACTUAL_PHASE_PS_SOURCE_BINDINGS_ONLY')):
        need(values[role]['reviewer'] == '/root/owner_docs_review' and values[role]['verdict'] == verdict,
             'actual genuinely different M3 Source peer at ' + role)
    metadata_peer = values['metadata_peer']
    need(metadata_peer['source_manifest_sha256'] == pins['metadata_manifest']['sha256'] and
         metadata_peer['operational_authority'] is False and metadata_peer['runtime_acceptance'] is False,
         'new M3 peer authenticates actual new staged Source manifest without runtime authority')
    binding, bound = values['metadata_binding'], values['metadata_bound_review']
    need(binding['binder'] == '/root' and binding['target_capture_executed'] is False and
         binding['actual_before_authorization'] is None and binding['actual_after_authorization'] is None and
         binding['exact_six_assignment_reversal'] is True and binding['exact_function_ASTs'] is True,
         'actual capture Source binding provenance and no capture authorization')
    need(binding['actual_script_sha256'] == pins['capture_bound']['sha256'] == bound['actual_script_sha256'] and
         bound['metadata_only'] is True and bound['source_bindings'] == binding['bindings'],
         'actual genuine bound peer binds exact capture Source and bindings')
    need(binding['bindings']['preparer_static_review_sha256'] == pins['metadata_peer']['sha256'] and
         binding['bindings']['guard_profile_sha256'] == config['profile']['sha256'] and
         binding['bindings']['guard_harness_static_review_sha256'] == config['harness_static_review']['sha256'],
         'capture actual new preparer/profile/static Source pins')
    phases, phase_peer = values['phase_binding'], values['phase_peer']
    need(phases['binder'] == '/root' and phases['actual_script_sha256'] == pins['capture_bound']['sha256'] and
         phases['bound_review_sha256'] == pins['metadata_bound_review']['sha256'] and
         phases['actual_authorization'] is None and phases['prepared_source_actions_executed'] is False,
         'actual four-phase Source binding has exact capture/bound-peer links and no action authorization')
    need(phase_peer['phase_source_binding_sha256'] == pins['phase_binding']['sha256'] and
         phase_peer['bound_metadata_source_sha256'] == pins['capture_bound']['sha256'] and
         phase_peer['bound_source_review_sha256'] == pins['metadata_bound_review']['sha256'] and
         phase_peer['metadata_only'] is True and phase_peer['actual_authorization_or_entry_approved'] is False and
         phase_peer['exact_two_literal_reversal_all_four'] is True and phase_peer['PowerShell_parser_errors'] == 0,
         'actual genuine phase Source peer authenticates exact new provenance')
    need(len(phases['sources']) == 4, 'exact four genuinely reviewed phase Source rows')
    source_keys = ('metadata_before_writer', 'metadata_before_parent', 'metadata_after_writer', 'metadata_after_parent')
    peer_keys = ('writer_sha256', 'supervisor_sha256', 'after_writer_sha256', 'after_supervisor_sha256')
    for phase, source_key, peer_key in zip(phases['sources'], source_keys, peer_keys):
        actual = config['sources'][source_key]
        need(phase['path'] == actual['path'] and phase['sha256'] == actual['sha256'] == phase_peer[peer_key] and
             phase['exact_two_literal_reversal'] is True, 'actual exact Source phase digest chain')
    return pins

