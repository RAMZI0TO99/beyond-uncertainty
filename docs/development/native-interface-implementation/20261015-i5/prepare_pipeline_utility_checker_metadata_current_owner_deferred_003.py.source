def lease_producer_record(pin, leaf):
    positive_pin(pin)
    allowed = ('ROOT_SOURCE024_PROSPECTIVE_LEASE_CANONICAL_PUBLICATION_RECEIPT_001.json',
        'ROOT_SOURCE024_PROSPECTIVE_LEASE_PUBLICATION_FACTS_001.json',
        'ROOT_SOURCE024_PROSPECTIVE_LEASE_CANDIDATE_RECEIPT_001.json')
    path = absolute(pin['path'])
    need(leaf in allowed and path == LEASE_PRODUCER_FOLDER/leaf,
        'only the three exact actual lease-producer metadata routes, not arbitrary Root records')
    value = strict_source_json(read_pin(pin))
    need(type(value) is dict and value.get('author') == '/root', 'real Root lease-producer metadata author')
    return value


def lease_source_acceptance(subject, review_pin, adoption_pin, *, original_publication=None, author_receipt=None):
    read_pin(positive_pin(subject))
    proof = reviewed_subject(positive_pin(review_pin), subject, '/root')
    if author_receipt is not None:
        need(exact_pin_occurs(proof, positive_pin(author_receipt)),
            'prior genuine candidate Source review covers its actual candidate author receipt')
    if original_publication is not None:
        need(exact_pin_occurs(proof, positive_pin(original_publication)),
            'later genuine canonical Source review covers the original actual publication')
    adopted = root_record(positive_pin(adoption_pin))
    need(type(adopted.get('verdict')) is str and adopted['verdict'].startswith('ACCEPT_')
        and adopted.get('target_execution') is False and adopted.get('operational_authority') is False
        and exact_pin_occurs(adopted, subject) and exact_pin_occurs(adopted, review_pin)
        and exact_pin_occurs(adopted, SOURCE024),
        'exact positive current Root lease adoption, independent of the later family selection')
    if original_publication is not None:
        need(exact_pin_occurs(adopted, original_publication),
            'later canonical Root adoption binds original publication separately from late reconciliation')
    born = OBSERVATIONS[review_pin['path']]['path9'][8]
    need(type(born) is int and born > 0 and born//100 <= moment(adopted['created_utc']) <= current_ticks()
        and moment(proof['created_utc']) <= moment(adopted['created_utc']),
        'real lease Root adoption follows actual different review')
    return proof, adopted


def actual_lawful_lease(support):
    exact(support, LEASE_SUPPORT_KEYS, 'exact9 separate lawful lease support')
    data = read_pin(positive_pin(support['canonical']))
    candidate = read_pin(positive_pin(support['candidate']))
    need(data == candidate and support['canonical']['sha256'] == support['candidate']['sha256']
        and support['canonical']['bytes'] == support['candidate']['bytes']
        and support['canonical']['bytes'] <= 65536,
        'published lawful lease equals genuinely reviewed candidate complete bytes within original lease cap')
    lease = strict_source_json(data)
    old = strict_source_json(read_pin(EXISTING_LEASE010))
    exact(lease, tuple(old), 'unchanged original lease closed12 ABI')
    need(type(lease['schema_version']) is int and lease['schema_version'] == 1
        and lease['author'] == old['author'] and lease['record_type'] == old['record_type']
        and lease['scope'] == old['scope'] and lease['owner_master_sha256'] == old['owner_master_sha256']
        and lease['owner_review_sha256'] == old['owner_review_sha256']
        and lease['decision'] == old['decision'] and lease['operational_authority'] is False
        and lease['lease_is_owner_deadline'] is False and type(lease['maximum_lease_seconds']) is int
        and lease['maximum_lease_seconds'] == 43200, 'original owner types/caps/lease semantics without runtime authority')
    start, end = moment(lease['created_utc'], 7), moment(lease['lease_end_utc'], 7)
    need(end > start
        and support['canonical'] != EXISTING_LEASE010, 'real distinct lawful finite lease; no expired010 reuse or fabricated duration')
    issuance = root_record(support['issuance_decision'],coordination=True)
    exact(issuance,ISSUANCE_KEYS,'original separate Root prospective lease issuance decision closed20; Source024 slot')
    need(type(issuance['schema_version']) is int and issuance['schema_version']==1
        and issuance['record_type']=='Root_separate_Source024_prospective_closed12_lease_issuance_decision'
        and issuance['decision']=='SELECT_NEW_PROSPECTIVE_CLOSED12_LEASE_SOURCE_ONLY' and issuance['Root_thread']==ROOT_THREAD
        and issuance['future_canonical_path']==support['canonical']['path'] and issuance['Source024']==SOURCE024
        and type(issuance['selected_duration_seconds']) is int and 0 < issuance['selected_duration_seconds'] <= lease['maximum_lease_seconds']
        and end-start == issuance['selected_duration_seconds']*10000000
