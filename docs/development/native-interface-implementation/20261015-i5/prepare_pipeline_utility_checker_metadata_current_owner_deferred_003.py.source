    need(type(producer_adoption.get('verdict')) is str and producer_adoption['verdict'].startswith('ACCEPT_')
        and producer_adoption.get('target_execution') is False and producer_adoption.get('operational_authority') is False
        and exact_pin_occurs(producer_adoption,LEASE_PRODUCER_SOURCE)
        and exact_pin_occurs(producer_adoption,request['tool_review']) and exact_pin_occurs(producer_adoption,SOURCE024)
        and moment(producer_proof['created_utc'])<=moment(producer_adoption['created_utc'])<=moment(request['created_utc']),
        'actual producer different Source review and prior Root adoption, independent of unborn family choices')
    author_receipt_pin=positive_pin(publication['candidate_author_receipt'])
    author_receipt=lease_producer_record(author_receipt_pin,'ROOT_SOURCE024_PROSPECTIVE_LEASE_CANDIDATE_RECEIPT_001.json')
    need(author_receipt['record_type']=='Root_actual_Source024_prospective_closed12_lease_candidate_receipt'
        and author_receipt['physical_Source_editor']=='/root'
        and author_receipt['metadata_tool_Source_author']=='/root/runtime_audit'
        and author_receipt['candidate']==support['candidate'] and author_receipt['Source024']==SOURCE024
        and author_receipt['issuance_decision']==support['issuance_decision']
        and author_receipt['canonical_publication'] is False and author_receipt['target_execution'] is False
        and author_receipt['operational_authority'] is False,
        'actual prior Root candidate-author receipt, not a later canonical observation')
    prior_proof,prior_adoption=lease_source_acceptance(support['candidate'],support['candidate_review'],
        support['candidate_Root_adoption'],author_receipt=author_receipt_pin)
    later_proof,later_adoption=lease_source_acceptance(support['canonical'],support['canonical_review'],
        support['canonical_Root_adoption'],original_publication=support['original_publication'])
    publication_birth=OBSERVATIONS[support['original_publication']['path']]['path9'][8]
    canonical_birth=OBSERVATIONS[support['canonical']['path']]['path9'][8]
    need(type(publication_birth) is int and type(canonical_birth) is int and 0<canonical_birth<=publication_birth
        and moment(prior_proof['created_utc'])<=moment(prior_adoption['created_utc'])
        <=moment(request['created_utc'])<=moment(publication['created_utc'])
        <=moment(later_proof['created_utc'])<=moment(later_adoption['created_utc'])<=current_ticks()
        and publication_birth//100<=moment(later_proof['created_utc']),
        'prior candidate acceptance, actual canonical/publication births, then separate later canonical acceptance')
    source_reserve(lease)
    return lease


def role_paths(selected, output_namespace, frame):
    need(tuple(frame['future_selection_closed13_schema']) == HISTORICAL_SELECTION_KEYS, 'exact unchanged historical Source23 frame schema; no current23 fallback')
    exact(selected, CURRENT_SELECTION_KEYS, 'separate current Root future selection exact closed13')
    need(type(selected['schema_version']) is int and selected['schema_version']==1
        and type(selected['record_type']) is str and selected['record_type']=='Root_Source024_actual_separate_future45_Source_path_selection'
        and selected['author'] == '/root' and selected['target_execution'] is False
        and selected['operational_authority'] is False and selected['Source024'] == SOURCE024
        and selected['current_selection'] == CURRENT_ROOT_SELECTION,
        'current Source23 future choice distinct from historical Root13')
    namespace = absolute(output_namespace)
    need(namespace.parent.parent == SESSION and namespace.parent.name == 'generation'
        and namespace != HERE and namespace != ROOT_OWNED, 'Root explicitly selected separate future draft namespace')
    rows = {}
    old_rows = {row['role']: row for row in strict_source_json(read_pin(CURRENT_ROOT_SELECTION))['rows']}
    for row in selected['rows']:
        exact(row, ROW_KEYS, 'original finite45 row9 ABI')
        role = row['role']
        need(role in frame['role_basis'] and role not in rows and type(row['source_cap']) is int
            and row['source_cap'] == old_rows[role]['source_cap'], 'unique selected role and exact original cap')
        base = frame['role_basis'][role]
        need(row['predecessor'] == base['available_basis'], 'actual present or explicitly historical predecessor, no silent fallback')
        need(row['retained_semantic_Source_author']==old_rows[role]['retained_semantic_Source_author'],
            'separately retained semantic nominal exact')
        if role=='composer':
            need(row['preparation_Source_author'] is None and old_rows[role]['preparation_Source_author'] is None,
                'carried composer has no actual new preparation author')
        else:
            need(type(row['preparation_Source_author']) is str and row['preparation_Source_author'] in PHYSICAL_SOURCE_AGENTS,
                'actual reviewed Root preparation assignment for each44 successor')
        if role in SUPPORTED_ROLES:
            need(row['preparation_Source_author']==SOURCE_AUTHOR,'only actually assigned Pipeline metadata Source producers')
        if role == 'composer':
            need(row['must_change_Source_bytes'] is False and row['draft_path'] is None
                and row['selected_ordinal'] is None and row['canonical_path'] == base['available_basis']['path'],
                'one composer carry, never an authored output')
        else:
            canonical, draft = absolute(row['canonical_path']), absolute(row['draft_path'])
            old_path = absolute(old_rows[role]['canonical_path'])
            old_leaf = old_path.name
            ordinal = old_rows[role]['selected_ordinal']
            need(type(row['selected_ordinal']) is int and row['selected_ordinal'] > ordinal
                and 0 < row['selected_ordinal'] < 1000 and row['must_change_Source_bytes'] is True,
                'explicit Root newer ordinal; generator does not choose it')
            matches = list(re.finditer(r'\d{3}(?!\d)', old_leaf))
            valid = [m for m in matches if int(m.group()) == ordinal]
            need(len(valid) == 1, 'one actual current identity ordinal field')
            match = valid[0]
            new_leaf = old_leaf[:match.start()] + f"{row['selected_ordinal']:03d}" + old_leaf[match.end():]
            need(canonical.parent == old_path.parent and canonical.name == new_leaf and draft.parent == namespace/'drafts'
                and draft.name == canonical.name and row['retained_semantic_Source_author'] == old_rows[role]['retained_semantic_Source_author'],
                'exact Root-selected coupled ordinal leaf/parents/retained semantic nominal')
        rows[role] = row
    need(set(rows) == set(old_rows) and len(rows) == 45, 'whole45 coherent role set:44 successors/one composer')
    old_selection=strict_source_json(read_pin(CURRENT_ROOT_SELECTION))
    need(selected['selected_Source_nonce']==old_selection['selected_Source_nonce']
        and selected['current_complete45_inventory']==old_selection['current_complete45_inventory'],
        'historical complete45 basis and prospective nonce preserved, never claimed to be current runtime')
    need(selected['derived_launcher_runtime_path']==str(Path(rows['launcher_template']['canonical_path']).with_name(
        Path(rows['launcher_template']['canonical_path']).name.replace('.TEMPLATE.ps1','.BOUND.ps1'))),
        'Root selected derived launcher runtime identity only; no runtime output created')
    suffixes=set()
    for stem in ('WRITE_ROOT_METADATA_BEFORE_AUTHORIZATION','SUPERVISE_ROOT_METADATA_BEFORE',
        'WRITE_ROOT_METADATA_AFTER_AUTHORIZATION','SUPERVISE_ROOT_METADATA_AFTER'):
        bound_leaf=Path(rows[stem+'_bound']['canonical_path']).name
        template_leaf=Path(rows[stem+'_template']['canonical_path']).name
        match=re.search(r'_003-corrected\d{3}\.TEMPLATE\.ps1$',template_leaf)
        need(match is not None and bound_leaf.endswith('.BOUND.ps1')
            and bound_leaf[:-len('.BOUND.ps1')][:-4]+match.group()==template_leaf,
            'actual selected four bound/template identities preserve original utility dynamic-stem expression')
        suffixes.add(match.group())
    need(len(suffixes)==1,'one original corrected-template suffix shared by the four phase Source identities')
    return rows



SINGLE_ROLE_PUBLICATION_KEYS = ('schema_version', 'record_type', 'author', 'physical_actor', 'metadata_Source_worker', 'retained_semantic_Source_author', 'created_utc', 'Source024', 'Root_selection', 'lawful_lease_support', 'actual_Root_late_facts', 'original_request', 'tool_source', 'tool_Source_review', 'tool_Root_adoption', 'role', 'stage', 'predecessor', 'draft', 'canonical', 'canonical_publication', 'details', 'actual_paired_metadata_inputs', 'target_execution', 'operational_authority', 'lease_issuance', 'genuine_peer_authored', 'Native_or_Parser_or_original_fixture_or_science', 'original_Source_guards_caps_inverse_and_all_spent_gates_preserved')
