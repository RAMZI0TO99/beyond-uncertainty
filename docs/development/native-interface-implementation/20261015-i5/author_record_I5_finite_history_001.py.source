"""Record actual author-tool/static-review history only; no target execution."""
import datetime as dt
import hashlib
import json
from pathlib import Path

O=Path(__file__).parent
OUT=O/'I5_ACTUAL_AUTHOR_TOOLING_AND_SOURCE001_002_CORRECTION_HISTORY_001.json'

def pin(p):
    b=p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

files=sorted((p for p in O.iterdir() if p.is_file()),key=lambda p:p.name)
assert len(files)==25 and all(p.stat().st_size<=2097152 for p in files)
history=dict(schema_version=1,record_type='I5_actual_author_tooling_and_uninvoked_Source_correction_history',
             author='/root/phase_frontier',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
             actual_finite_owned_inputs=[pin(p) for p in files],
             own_author_tools=[dict(program=str(O/('author_inert_I5_Source_only_'+version+'.py')),
                   observed_process_exit_code=0,execution_kind='Own stdlib Source construction; target strings parsed/compiled only; no evaluated project code')
                   for version in ('001','002','003')],
             own_static_inspection=dict(Source001=dict(checks_passed=155,checks_failed=0),
                                        Source002=dict(checks_passed=168,checks_failed=0),
                                        Source003=dict(checks_passed=177,checks_failed=0),
                                        boundary='Author static checks, not independent acceptance or project/runtime tests. Early checks did not prove semantic cap/proof-graph correctness; actual different Source review identified the preserved defects.'),
             initial_command_setup_failure=dict(executed_command=False,filesystem_mutated=False,target_entered=False,
                 actual_error='Failed to create unified exec process: The directory name is invalid. (os error 267)',
                 cause='Inherited cwd alias invalid for native exec process; explicit D:\\Aenv\\pro2 workdir used on later commands.'),
             Source001=dict(status='PRESERVED_UNINVOKED_REFUSED_SOURCE_BASIS',
                 actual_findings=['_i5_review default2MiB read could widen retained generic OBSERVATIONS cap after earlier65536 lease reads.',
                                  '_i5_pin accepted bytes0 and selection used invented zero-byte/zero-SHA pin-shaped dictionaries solely for path validation.'],
                 successor='002 adds min-held-cap reader callbacks and strict positive actual pin plus separate pure syntactic path validator.'),
             Source002=dict(status='PRESERVED_UNINVOKED_REFUSED_SOURCE_BASIS',
                 actual_findings=['Phase context21 embeds genuine-content review/adoption pins; asking those same proofs to cover context_pin creates a self/hash cycle.'],
                 successor='003 excludes containingcontext pin only; content subjects are decision+actualSource supportpins+current owner scope. Full separate context/proposal/native/result/serialization closure remains UNWIRED.'),
             Source003=dict(status='FINAL_INERT_SOURCE_FOR_DIFFERENT_REVIEW',all86_original_definitions_byte_exact=True,
                 complete_four_original_Source_API_inverse=True,both_first_literal_false_and_unconditional_UNWIRED_guards=True,
                 actual_new_family_or_lease_or_stage_grant_or_Native8_or_Parser4=None,
                 independent_final_Source_review=None,Root_final_Source_adoption=None),
             implemented_scope='Strict owner-v2 closed shapes, authenticated I0 loader Source contract after entry holds, dynamic actor/proof predicates and honestly labelled I1/selection metadata subsets. Original algorithms preserved; final bindings refuse old entries.',
             incomplete_scope='Publication/reconciliation mapping, accepted Native8 carrier, Parser saved-result adapter, full producer/selection/proposal/context/owncode closure and actual qualified I2/I3/I4 successors remain UNWIRED. No flag flip qualifies them.',
             target_execution=False,tests_executed=False,original_helpers_imported_or_called=False,
             Native_or_Parser_or_PowerShell_syntax_compilation=False,operational_authority=False,scientific_authority=False,
             managed_or_Git_mutated=False)
raw=(json.dumps(history,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')
assert len(raw)<=2097152 and not OUT.exists()
with OUT.open('xb') as f:f.write(raw)
assert OUT.read_bytes()==raw
print(json.dumps(dict(history=pin(OUT),finite_owned_files_including_history=len(files)+1),sort_keys=True))
