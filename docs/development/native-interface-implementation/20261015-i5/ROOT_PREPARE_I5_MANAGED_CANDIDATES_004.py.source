"""Prepare reviewed I5 generic and phase-peer interface development evidence; invoke no project helper."""
import datetime
import hashlib
import json
import os
from pathlib import Path

R = Path(r"D:\Aenv\pro2")
P = R / "WORK/resume-20261015-001/native_interface_implementation_008"
G = R / "github-portable-20261012-001"
C = R / "WORK/I5P008/c1"
REL = "docs/development/native-interface-implementation/20261015-i5/"
CAP = 2097152


def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_pin = fact(P / "ROOT_I5_GENERIC_PHASE_PEER_SOURCE_REVIEW_ADOPTION_001.json")
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I5_GENERIC_PHASE_PEER_CONTEXT_SOURCE_ONLY"
    assert adoption["I5_executed"] is False and adoption["tests_executed"] is False
    scope_pin = fact(P / "ROOT_CURRENT_I5_STATIC_INTERFACE_HELPER_IMPLEMENTATION_SCOPE_001.json")
    assert scope_pin["sha256"] == "3129b44f4c8a2dcf92127bf45f442dad715986cc2377e8e2ba1af9298d6714dc"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    previous_scope_pin = fact(R / "WORK/resume-20261015-001/native_parser_implementation_007/managed_preparation_001/candidates_001/EXACT_MANAGED_I4_PARSER_IMPLEMENTATION_PUBLICATION_SCOPE_001.json")
    assert previous_scope_pin["sha256"] == "ddd45d4869832fe7c3abea73d26d487fc93decacd38839a827e7c11591cb55e8"
    previous = json.loads(pinned(previous_scope_pin))
    rows, evidence, names = [], [], set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = Path(pin["path"])
        assert path.resolve().is_relative_to(P.resolve())
        inert_source = path.suffix in (".py", ".ps1")
        name = path.name + (".source" if inert_source else "")
        assert Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": inert_source})
    add(REL + "evidence-index.json", {
        "schema_version": 1, "record_type": "I5_exact_generic_and_phase_peer_context_Source_and_review_evidence_index",
        "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
        "actual_evidence_copy_count": len(evidence), "files": evidence,
        "I5_or_original_helper_import_call_test_native_or_scientific_execution": False,
        "actual_Parser_grant_facts_result_or_family_created": False,
        "current_dated_Source_inventory": {"present": 36, "pending": 9},
        "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}})
    report = "# Current owner generic metadata and phase peer interfaces\n\nRoot accepted the I5 held owner-context Source successors for the generic metadata helper and genuine phase-peer helper after independent static review and [Root adoption](ROOT_I5_GENERIC_PHASE_PEER_SOURCE_REVIEW_ADOPTION_001.json). Source003 corrects a retained-cap widening path, separates positive actual pins from unborn-path syntax checks, and removes a genuine-content proof hash cycle. Earlier001/002 Sources and actual refusals remain preserved. Both final Sources remain unrun. This milestone implements Source context predicates and documents exact preserved interfaces; it does not qualify their downstream publication or result dependencies.\n\nThe context specifications use strict version2 generic facts26/stage decision14 and phase context21/content decision15/Parser support9. The Parser support explicitly names owner purpose acceptance; it does not rename an old peer ACK into current authority. Exact owner support3 and dynamic author exclusion bind the current Root context. Context validation alone grants no helper action. APIs distinguish Source predicates from held dependency routes. The new I1 lease and selection checks are explicitly metadata subsets; full lawful producer, current selection proof, self-Source/API closure and family-specific recipe binding still require qualified successors.\n\nThe original seven-link M3 validation, strong21 binding prerequisites/output20 and39 config prerequisites/output18 remain protected. Complete predecessor inverses retain original helpers, algorithms, strict read/stat/postread behavior, renderers, wire codecs, spent identities, caps and guards. Original phase peer output20/rows6 and Parser result data leaves retain their existing wire formats. The exact static review documents whole-function and changed-region evidence.\n\nSingle request14/publication29, batch request21/row10/publication43 and reconciliation26 are separate historical interfaces. Proof4 Root_publication can name verified-prior reconciliation26, which authenticates the original write receipt. I4 proof6 canonical_publication names the original write receipt. This Source port does not declare an owner-v2 publisher or reconciliation adapter qualified. The old Publisher external selected-peer receipt27 integration remains outside acceptance.\n\nLiteral false entry holds and separate unconditional refusals keep execution closed. Accepted Native8 support has no qualified carrier in I4 closed facts27/phase8/proof6. The typed Parser saved-result adapter remains unimplemented; unchanged mains terminate with legacy leaves. No flag or JSON field can substitute for the later exact contracts, reviewed producer/consumer bindings and actual saved-result reviews/adoptions. I2, I3 and I4 Sources and their holds remain unchanged.\n\nThe future order stays acyclic: a real selected future45 identity decision and eight new canonical Sources, accepted Native8 saved result, separately admitted Parser4 saved result, genuine future-family phase peer, strong binding and config. No old result, fixture, declared birth time or Source-only observation supplies those results. Future paired ordinals must exceed018. No future family, lease, grant, path, nonce, purpose, actual result or selected ordinal was issued here.\n\nNo project helper import/call/main, project test, native measurement, PowerShell Language Parser validation, Parser execution, runtime or science ran. Source review uses own standard-library text/AST/hash/JSON scripts only. I0's earlier17 memory-only methods were not rerun and do not validate this port. All75 spent identities and saved refusals remain unreplayed. The current dated family remains36/45 with nine pending; frozen STEP080 remains35/45 with ten pending. The608 preexisting managed file bytes, eight STEP080 sentinels and original36 Source bytes remain exact.\n\nNext: separately scope exact owner publication/reconciliation ABI adapters, the Native8 support carrier and Parser saved-result adapter, then reviewed qualifying binding successors. Native8, Parser, fixtures, C8, actual6 and science remain held.\n\nThe [evidence index](evidence-index.json) records exact Source/API/inverse/protocol/review copies. Code is copied as inert `.source` files. Original absolute paths are dated provenance requiring fresh bindings elsewhere. Three navigation prepends retain complete prior bytes. Later Git publication is recorded by external Root receipts and repository history.\n"
    add(REL + "I5_INTERFACE_IMPLEMENTATION.md", report.encode())
    prefix = ("**October15 I5 interface context Source accepted.** The [generic and phase-peer report](" + REL + "I5_INTERFACE_IMPLEMENTATION.md) records held owner-context successors with the original strong21/39 and seven-link M3 checks preserved. Both Sources remain unrun; publication ABI adapters, Native8 support carrier, Parser result adapter and qualifying consumer bindings remain required. The dated Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        old_bytes = pinned(predecessor)
        saved = save(P / "managed_preparation_001/predecessors_001" / name, old_bytes)
        source = save(C / name, prefix + old_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {
        "schema_version": 1, "record_type": "Root_exact_finite_I5_interface_context_Source_implementation_managed_publication_scope",
        "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "base_HEAD": "b85f1e83cbc0fa10da1cf7581cb91978afb3f854",
        "managed_file_count": len(rows), "files": rows, "Root_implementation_adoption": adoption_pin,
        "preexisting608_byte_baseline": previous["preexisting608_byte_baseline"],
        "all_frozen_STEP080_sentinels": previous["all_frozen_STEP080_sentinels"],
        "current36_Source_baseline": previous["current36_Source_baseline"],
        "target_execution": False, "tests_executed": False, "I5_executed": False}
    print(json.dumps(save(P / "managed_preparation_001/candidates_001/EXACT_MANAGED_I5_INTERFACE_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
