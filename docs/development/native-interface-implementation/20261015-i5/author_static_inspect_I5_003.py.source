"""Own stdlib byte/JSON/AST/symtable inspection; never imports target Sources."""
import ast
import base64
import builtins
import datetime as dt
import hashlib
import json
from pathlib import Path
import symtable

O=Path(__file__).parent
G=O/'prepare_pipeline_utility_checker_metadata_current_owner_deferred_003.py'
H=O/'assemble_genuine_phase_peer_current_owner_deferred_003.py'
A=O/'CURRENT_OWNER_GENERIC_AND_PHASE_PEER_INERT_API_003.json'
I=O/'CURRENT_OWNER_GENERIC_AND_PHASE_PEER_COMPLETE_PREDECESSOR_INVERSE_003.json'
R=O/'CURRENT_OWNER_GENERIC_AND_PHASE_PEER_ACTUAL_SOURCE_AUTHOR_RECEIPT_003.json'
OUT=O/'I5_AUTHOR_ACTUAL_FINITE_SOURCE_SELF_INSPECTION_003.json'

def pin(p):
    b=p.read_bytes()
    return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())

checks=[]
def check(name,condition,detail=None):
    checks.append(dict(name=name,passed=bool(condition),detail=detail))

def pairs(rows):
    d={}
    for k,v in rows:
        assert k not in d,k
        d[k]=v
    return d

def nofloat(value):
    raise ValueError(value)

def record(p):
    return json.loads(p.read_bytes(),object_pairs_hook=pairs,parse_float=nofloat,parse_constant=nofloat)

api=record(A);inverse=record(I);receipt=record(R)
trees={};texts={}
for p in (G,H):
    b=p.read_bytes();s=b.decode('utf8');tree=ast.parse(s);trees[p]=tree;texts[p]=s
    compile(tree,str(p),'exec',dont_inherit=True)
    check(p.stem+':Source_AST_compile_only',True,'No compiled code evaluated')
    check(p.stem+':metadata_Source_cap',len(b)<=2097152)
    check(p.stem+':actual_pin_strict_positive',"0<value['bytes']<=cap" in s)
    new=s[s.index('# CURRENT OWNER V2 SOURCE PREDICATES.'):]
    check(p.stem+':path_only_no_fake_fact3',"dict(path=row['canonical_path'],bytes=0" not in new and "dict(path=row['draft_path'],bytes=0" not in new and "def _i5_path(value):" in new)
    check(p.stem+':retained_cap_never_widened',"min(cap,held['cap'])" in new)

    definitions={n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
    flag=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='I5_DEPENDENCY_INTERFACES_QUALIFIED' for t in n.targets))
    check(p.stem+':literal_false',isinstance(flag.value,ast.Constant) and flag.value.value is False)
    entry='validate_current_owner_generic_metadata_stage' if p==G else 'validate_current_owner_phase_peer_context'
    body=definitions[entry].body
    check(p.stem+':first_public_if_false_hold',isinstance(body[0],ast.If) and ast.unparse(body[0].test)=='I5_DEPENDENCY_INTERFACES_QUALIFIED is not True' and isinstance(body[0].body[0],ast.Raise))
    check(p.stem+':second_public_unconditional_unwired',isinstance(body[1],ast.Expr) and isinstance(body[1].value,ast.Call) and isinstance(body[1].value.func,ast.Name) and body[1].value.func.id=='_i5_unwired_interfaces')
    check(p.stem+':unconditional_unwired_body',isinstance(definitions['_i5_unwired_interfaces'].body[0],ast.Raise))
    check(p.stem+':private_I0_before_reads_guard',ast.unparse(definitions['_i5_owner_context'].body[1])=='_i5_require_qualification()')
    check(p.stem+':unique_module_name_includes_self_and_I0_digest',"hashlib.sha256(I5_SELF.encode('utf8')).hexdigest()" in ast.unparse(definitions['_i5_owner_context']).replace('_i5_hashlib','hashlib') and "I5_FIXED['I0_Source']['sha256']" in ast.unparse(definitions['_i5_owner_context']))
    check(p.stem+':exact_epoch_bridge',s.count('context.interval_start_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS')==1 and s.count('context.interval_end_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS')==1 and 'I5_CONTEXT_FILETIME_TO_UNIX_TICKS = 116444736000000000' in s)
    check(p.stem+':no_old_gate_called_in_new_predicates','current_Source024_gate24(' not in s[s.index('# CURRENT OWNER V2 SOURCE PREDICATES.'):])
    check(p.stem+':no_actual_Parser_native_or_subprocess_new_call',not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('_kernel32','_native10','ParseFile','ParseInput','system','Popen','run') for fn in tree.body if isinstance(fn,ast.FunctionDef) and fn.name.startswith(('_i5_','validate_current_owner_')) for n in ast.walk(fn)))
    check(p.stem+':different_actual_editor_and_subtree',"who!=x and (x=='/root' or not who.startswith(x+'/'))" in s)
    check(p.stem+':proof_covers_API_review_fullproof',"required=[*subjects,review_pin,_i5_pin(review['full_proof'])]" in s)
    check(p.stem+':Source_static_verdict_marker',"'SOURCE' in review['verdict'].upper() or 'STATIC' in review['verdict'].upper()" in s)
    check(p.stem+':I0_exact_support3_key',"('current_owner_scope','different_current_owner_scope_Source_review'," in s and "owner_support['owner_scope']" not in s)
    check(p.stem+':old_roster_not_used_in_new_predicates','PHYSICAL_SOURCE_AGENTS' not in s[s.index('# CURRENT OWNER V2 SOURCE PREDICATES.'):])
    check(p.stem+':strict_phase_eight_ordinals',"row['selected_ordinal']>18" in s)
    check(p.stem+':Source60_strict1200_preserved',"now+600000000<context.interval_end_ticks" in s and "now+12000000000<_i5_ticks(lease['lease_end_utc'])" in s)
    check(p.stem+':no_current_grant_built',not any(isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr in ('write_bytes','write_text','mkdir','open') for fn in tree.body if isinstance(fn,ast.FunctionDef) and fn.name.startswith(('_i5_','validate_current_owner_')) for n in ast.walk(fn)))
    # Sequential top-level evaluation checks. Function bodies are inspected separately.
    bound=set(dir(builtins))|{'__name__','__file__','__doc__','__package__','__builtins__','__annotations__'}
    order_issues=[]
    def expr_names(expr):
        if expr is None:return set()
        return {n.id for n in ast.walk(expr) if isinstance(n,ast.Name) and isinstance(n.ctx,ast.Load)}
    def bound_names(target):
        return {n.id for n in ast.walk(target) if isinstance(n,ast.Name) and isinstance(n.ctx,ast.Store)}
    for n in tree.body:
        used=set();new=set()
        if isinstance(n,(ast.Import,ast.ImportFrom)):
            new={x.asname or (x.name.split('.')[0] if isinstance(n,ast.Import) else x.name) for x in n.names}
        elif isinstance(n,ast.Assign):
            used=expr_names(n.value)
            new=set().union(*(bound_names(t) for t in n.targets))
        elif isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)):
            for x in [*n.decorator_list,*n.args.defaults,*n.args.kw_defaults]:used|=expr_names(x)
            new={n.name}
        elif isinstance(n,ast.ClassDef):
            for x in [*n.decorator_list,*n.bases,*[k.value for k in n.keywords]]:used|=expr_names(x)
            new={n.name}
        elif isinstance(n,ast.For):
            used=expr_names(n.iter);new=bound_names(n.target)
            local=bound|new
            for x in n.body:
                for y in ast.walk(x):
                    if isinstance(y,ast.Name) and isinstance(y.ctx,ast.Load) and y.id not in local:order_issues.append((y.lineno,y.id))
        elif isinstance(n,ast.If):
            used=expr_names(n.test)
            for x in n.body:
                if isinstance(x,ast.Expr):used|=expr_names(x.value)
        for name in used-bound:order_issues.append((n.lineno,name))
        bound|=new
    check(p.stem+':module_assignment_order',not order_issues,order_issues)
    # Symtable names reveal unresolved global references, but order is checked above independently.
    table=symtable.symtable(s,str(p),'exec')
    module_names={x.get_name() for x in table.get_symbols()}|set(dir(builtins))|{'__file__','__name__'}
    missing=[]
    def visit(t):
        for symbol in t.get_symbols():
            if symbol.is_referenced() and symbol.is_global() and symbol.get_name() not in module_names:missing.append((t.get_name(),symbol.get_name()))
        for child in t.get_children():visit(child)
    visit(table)
    check(p.stem+':all_lexical_globals_resolve',not missing,missing)
    # New direct-name calls: exact positional/keyword compatibility, excluding starred transport.
    fnmap={n.name:n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef)}
    arity_issues=[]
    for fn in tree.body:
        if not isinstance(fn,ast.FunctionDef) or not fn.name.startswith(('_i5_','validate_current_owner_')):continue
        for call in ast.walk(fn):
            if not isinstance(call,ast.Call) or not isinstance(call.func,ast.Name) or call.func.id not in fnmap:continue
            callee=fnmap[call.func.id];a=callee.args
            if any(isinstance(x,ast.Starred) for x in call.args) or any(x.arg is None for x in call.keywords):continue
            pos=[x.arg for x in a.posonlyargs+a.args];kw=[x.arg for x in a.kwonlyargs];supplied={k.arg for k in call.keywords}
            good=(a.vararg is not None or len(call.args)<=len(pos)) and (a.kwarg is not None or supplied<=set(pos+kw))
            covered=set(pos[:len(call.args)])|supplied
            required=set(pos[:len(pos)-len(a.defaults)])|{k for k,d in zip(kw,a.kw_defaults) if d is None}
            good=good and required<=covered and not (set(pos[:len(call.args)])&supplied)
            if not good:arity_issues.append((call.lineno,call.func.id))
    check(p.stem+':new_direct_call_signatures',not arity_issues,arity_issues)
    disabled=api['disabled_historical_entries']['generic' if p==G else 'phase_peer']
    loops=[n for n in tree.body if isinstance(n,ast.For) and ast.unparse(n.iter)=='I5_DISABLED_LEGACY_ENTRIES']
    check(p.stem+':legacy_final_binding_refusal',len(loops)==1 and "globals()[_i5_disabled_name] = _i5_legacy_refusal" in ast.unparse(loops[0]))
    check(p.stem+':no_saved_historical_callable_alias',not any(isinstance(n,ast.Assign) and isinstance(n.value,ast.Name) and n.value.id in disabled for n in tree.body))
    footer=tree.body[-1]
    check(p.stem+':final_main_only_qualification_guard',isinstance(footer,ast.If) and len(footer.body)==1 and ast.unparse(footer.body[0])=='_i5_require_qualification()')

for row in inverse['whole_definition_inventory']:
    p=Path(row['Source']['path']);tree=trees[p];lines=texts[p].splitlines(keepends=True)
    n=next(n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name==row['name'])
    raw=''.join(lines[n.lineno-1:n.end_lineno]).encode('utf8')
    check('whole_definition:'+p.name+':'+row['name'],hashlib.sha256(raw).hexdigest()==row['sha256']==row['successor_sha256'] and len(raw)==row['bytes'])
for row in inverse['original_complete_bytes']:
    raw=base64.b64decode(row['complete_bytes_base64'],validate=True);old=Path(row['subject']['path'])
    check('full_inverse:'+old.name,raw==old.read_bytes() and len(raw)==row['subject']['bytes'] and hashlib.sha256(raw).hexdigest()==row['subject']['sha256'])
for name,spec in api['schemas'].items():
    check('closed_schema:'+name,len(spec['keys'])==spec['field_count'] and len(set(spec['keys']))==spec['field_count'] and all(v is None for v in spec['all_actual_future_cells'].values()))
for p in (G,H,A,I):
    check('receipt_actual_pin:'+p.name,pin(p) in receipt['actual_outputs'])
check('all86_original_definitions',len(inverse['whole_definition_inventory'])==86)
for oldpin in api['preserved_uninvoked001']+api['preserved_uninvoked002']:
    check('001_history_byte_preservation:'+Path(oldpin['path']).name,pin(Path(oldpin['path']))==oldpin)

check('actual_future_authority_cells_all_null',all(v is None for v in api['future_actual'].values()))
phase_entry=next(n for n in trees[H].body if isinstance(n,ast.FunctionDef) and n.name=='validate_current_owner_phase_peer_context')
proofcalls=[n for n in ast.walk(phase_entry) if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in ('_i5_review','_i5_root')]
check('phase_content_proof_subject_graph_acyclic',len(proofcalls)==2 and all('context_pin' not in ast.unparse(c.args[1]) and 'content_decision_pin' in ast.unparse(c.args[1]) and "owner_support['current_owner_scope']" in ast.unparse(c.args[1]) for c in proofcalls))
clarification=api['acyclic_content_subject_clarification']
check('actual_acyclic_Root_clarification_pin',pin(Path(clarification['path']))==clarification and clarification['sha256']=='715d8b98ce05c45d9dd61a88373eef759ece257ba605d38284d221587ddd05f3')

check('runtime_eligibility_false',api['actual_runtime_eligibility'] is False and api['I2_I3_I4_qualified_by_this_Source'] is False)
check('subsets_honestly_declared',len(api['explicit_incomplete_predicates'])==5)
check('resource_policy_not_observation',any('actual fresh RAM/disk' in x for x in api['explicit_incomplete_predicates']))
check('all_evidence_cap',all(p.stat().st_size<=2097152 for p in (G,H,A,I,R)))
result=dict(schema_version=1,record_type='I5_author_actual_finite_Source_self_inspection',author='/root/phase_frontier',
            created_utc=dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds'),
            verdict='PASS_I5_AUTHOR_STATIC_SOURCE_ONLY' if all(c['passed'] for c in checks) else 'REFUSE_I5_AUTHOR_STATIC_SOURCE_ONLY',
            checks_passed=sum(c['passed'] for c in checks),checks_failed=sum(not c['passed'] for c in checks),checks=checks,
            actual_inputs=[pin(p) for p in (G,H,A,I,R,Path(__file__))],target_execution=False,tests_executed=False,
            operational_authority=False,scientific_authority=False,independent_review=False,
            limits='Author AST/compile/symtable/static-call/byte checks only; no target code evaluation/import/function/main/fixtures/native/Parser/PowerShell syntax qualification. Known metadata subsets remain held and unqualified.')
raw=(json.dumps(result,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')
assert len(raw)<=2097152 and not OUT.exists()
with OUT.open('xb') as f:f.write(raw)
assert OUT.read_bytes()==raw
print(json.dumps(dict(report=pin(OUT),checks_passed=result['checks_passed'],checks_failed=result['checks_failed'],failures=[c for c in checks if not c['passed']]),sort_keys=True))
