    _i5_root(support['Root_adoption'],[source,api_pin],support['different_review'],review,read_record,observations,now)
    return api

def _i5_owner_context(owner_support, read_record, observations, expected_root_thread, actual_now_utc):
    global _I5_I0_MODULE
    _i5_require_qualification()  # Mandatory before any I0 compile/exec or callback read.
    _i5_need(expected_root_thread==I5_TRUSTED_ROOT_THREAD,'actual trusted current Root, no old-thread default')
    _i5_closed(owner_support,('current_owner_scope','different_current_owner_scope_Source_review',
                  'current_owner_scope_Root_adoption'),'I0 owner support3')
    now=_i5_ticks(actual_now_utc)
    code={'Source':I5_FIXED['I0_Source'],'API':I5_FIXED['I0_API'],
          'different_review':I5_FIXED['I0_Source_review'],'Root_adoption':I5_FIXED['I0_Root_adoption']}
    api=_i5_code_support(code,'/root/checker_frontier',read_record,observations,now)
    _i5_need(api['Source']==I5_FIXED['I0_Source'],'exact accepted I0 Source/API')
    raw=_i5_read(I5_FIXED['I0_Source'],read_record)
    if _I5_I0_MODULE is None:
        name='_I5_I0_'+_i5_hashlib.sha256(I5_SELF.encode('utf8')).hexdigest()+'_'+I5_FIXED['I0_Source']['sha256']
        _i5_need(name not in _i5_sys.modules,'unique authenticated role/self I0 loader')
        module=_i5_types.ModuleType(name);module.__file__=I5_FIXED['I0_Source']['path']
        _i5_sys.modules[name]=module
        try:
            exec(compile(raw,I5_FIXED['I0_Source']['path'],'exec'),module.__dict__)
        except BaseException:
            _i5_sys.modules.pop(name,None)
            raise
        _I5_I0_MODULE=module
    context=_I5_I0_MODULE.validate_current_owner_support(support=owner_support,
        read_record=lambda p:_i5_read(p,read_record),expected_root_thread=expected_root_thread,
        source_editor=I5_ACTUAL_SOURCE_EDITOR,now_utc=actual_now_utc)
    _i5_need(context.root_thread==expected_root_thread and context.scope_pin.to_dict()==owner_support['current_owner_scope'] and
              context.metadata_only is True and context.operational_authority is False and context.scientific_authority is False and
              context.interval_start_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS<=now and
              now+600000000<context.interval_end_ticks-I5_CONTEXT_FILETIME_TO_UNIX_TICKS,
              'I0 context only, exact FILETIME-to-Unix epoch bridge and strict Source60')
    return context

def _i5_shape(value, name):
    spec=I5_SCHEMAS[name]
    _i5_closed(value,spec['keys'],name)
    _i5_need(type(value['schema_version']) is int and value['schema_version']==2 and
              value['record_type']==spec['record_type'],'explicit owner-v2 version/type; no old cast')
    if 'target_execution' in value:
        _i5_need(value['target_execution'] is False and value['operational_authority'] is False,'no target/operational authority')
    return value

def _i5_selection_shape(selection, scope, lease_pin):
    _i5_closed(selection,I5_SELECTION_KEYS,'owner selection13')
    _i5_need(type(selection['schema_version']) is int and selection['schema_version']==2 and
              selection['record_type']=='Root_owner_v2_actual_separate_future45_Source_path_selection' and
              selection['author']=='/root' and selection['current_owner_scope']==scope and
              selection['new_canonical_lease']==lease_pin and selection['target_execution'] is False and
              selection['operational_authority'] is False and type(selection['selected_Source_nonce']) is str and
              _i5_re.fullmatch('[0-9a-f]{32}',selection['selected_Source_nonce']) is not None,'actual owner selection13 context/nonce')
    _i5_pin(selection['current_complete45_inventory']);_i5_pin(selection['current_selection'])
    rows=selection['rows']
    _i5_need(type(rows) is list and len(rows)==45 and [r.get('role') for r in rows]==list(I5_ROLE_ORDER),
              'exact ordered45 role identities')
    paths=set();drafts=set()
    for row in rows:
        _i5_closed(row,I5_ROW_KEYS,'selected row9')
        role=row['role'];cap=I5_ROLE_CAPS[role]
        _i5_need(type(row['source_cap']) is int and row['source_cap']==cap,'original role cap')
        _i5_pin(row['predecessor'],cap)
        _i5_need(type(row['canonical_path']) is str and row['canonical_path'] not in paths,'unique exact canonical identity')
        _i5_pin(dict(path=row['canonical_path'],bytes=0,sha256='0'*64),cap);paths.add(row['canonical_path'])
        if role=='composer':
            _i5_need(row['canonical_path']==row['predecessor']['path'] and row['must_change_Source_bytes'] is False and
                      all(row[k] is None for k in ('draft_path','selected_ordinal','preparation_Source_author','retained_semantic_Source_author')),
                      'one composer carry with original null4')
        else:
            _i5_actor(row['preparation_Source_author'])
            _i5_need(type(row['selected_ordinal']) is int and 0<row['selected_ordinal']<1000 and
                      row['must_change_Source_bytes'] is True and row['retained_semantic_Source_author']==I5_ROLE_SEMANTICS[role],
                      'explicit new ordinal/actual physical editor/distinct retained semantic author')
            _i5_pin(dict(path=row['draft_path'],bytes=0,sha256='0'*64),cap)
            _i5_need(row['draft_path'] not in drafts and len({row['canonical_path'],row['draft_path'],row['predecessor']['path']})==3 and
                      _i5_WindowsPath(row['draft_path']).name==_i5_WindowsPath(row['canonical_path']).name and
                      _i5_WindowsPath(row['draft_path']).parent.name=='drafts','44 unique fresh draft identities')
            drafts.add(row['draft_path'])
            if role in I5_PHASE8_ROLES:
                _i5_need(row['selected_ordinal']>18,'all eight future TEMPLATE/BOUND identities strictly beyond018')
    _i5_need(len(paths)==45 and len(drafts)==44,'whole45/44 structural selection')
    return {row['role']:row for row in rows}

def _i5_lease_shapes(support, owner_support, read_record, observations, actual_now_utc):
    # Known I1 metadata predicates only; actual timestamp entry/grant/native evidence is not inferred.
    _i5_closed(support,I5_LEASE_SUPPORT_KEYS,'lawful lease support9')
    for p in support.values():_i5_pin(p)
    canonical=_i5_read(support['canonical'],read_record,65536)
    candidate=_i5_read(support['candidate'],read_record,65536)
    _i5_need(canonical==candidate and support['canonical']['path']!=support['candidate']['path'],'whole distinct candidate/canonical lease bytes')
    lease=_i5_decode(canonical);_i5_closed(lease,I5_LEASE_KEYS,'original lease12')
    decision=_i5_record(support['issuance_decision'],read_record);_i5_closed(decision,I5_LEASE_DECISION_KEYS,'I1 decision20')
    publication=_i5_record(support['original_publication'],read_record);_i5_closed(publication,I5_LEASE_PUBLICATION_KEYS,'I1 publication36')
    request=_i5_record(support['original_request'],read_record);_i5_closed(request,I5_LEASE_FACT_KEYS,'I1 facts14')
    author_pin=_i5_pin(publication['candidate_author_receipt'])
    author=_i5_record(author_pin,read_record);_i5_closed(author,I5_LEASE_CANDIDATE_KEYS,'I1 candidate32')
    scope=owner_support['current_owner_scope'];now=_i5_ticks(actual_now_utc)
    for record,kind in ((decision,'Root_owner_v2_prospective_lease_issuance_decision'),
                       (publication,'Root_owner_v2_prospective_lease_original_publication'),
                       (author,'Root_owner_v2_prospective_lease_candidate_author_receipt')):
        _i5_need(type(record['schema_version']) is int and record['schema_version']==2 and record['record_type']==kind and
                  record['author']=='/root' and record['current_owner_scope']==scope and record['operational_authority'] is False and
                  record['target_execution'] is False and record['lease_is_owner_deadline'] is False,'strict actual I1 owner-v2 record')
    _i5_need(decision['Root_thread']==I5_TRUSTED_ROOT_THREAD and decision['decision']=='SELECT_NEW_PROSPECTIVE_CLOSED12_LEASE_SOURCE_ONLY' and
              type(decision['selected_ordinal']) is int and 11<=decision['selected_ordinal']<=999 and
              type(decision['selected_duration_seconds']) is int and 0<decision['selected_duration_seconds']<=43200 and
              decision['future_canonical_path']==support['canonical']['path'] and
              _i5_WindowsPath(decision['future_canonical_path']).name=='EXECUTION_LEASE_GG6_M3_'+str(decision['selected_ordinal']).zfill(3)+'.json',
              'actual Root lease identity/ordinal/duration; no allocation or timestamp permission')
    _i5_need(type(lease['schema_version']) is int and lease['schema_version']==1 and lease['author']=='/root' and
              lease['record_type']=='root_local_private_execution_lease' and lease['operational_authority'] is False and
              lease['lease_is_owner_deadline'] is False and type(lease['maximum_lease_seconds']) is int and lease['maximum_lease_seconds']==43200 and
              _i5_ticks(lease['lease_end_utc'])-_i5_ticks(lease['created_utc'])==decision['selected_duration_seconds']*10000000 and
              _i5_re.fullmatch(r'.+\.\d{7}\+00:00',lease['created_utc']) is not None and
              _i5_re.fullmatch(r'.+\.\d{7}\+00:00',lease['lease_end_utc']) is not None and
              _i5_ticks(lease['created_utc'])<=now and now+12000000000<_i5_ticks(lease['lease_end_utc']),
              'unchanged schema1 nativeUTC7 lease43200 maximum and strict1200 reserve')
    for record in (author,publication):
        _i5_need(record['physical_Source_editor']=='/root' and record['metadata_tool_Source_author']=='/root/phase_frontier' and
                  record['issuance_decision']==support['issuance_decision'] and record['candidate']==support['candidate'] and
                  type(record['publication_reserve_seconds']) is int and record['publication_reserve_seconds']==60 and
                  record['selected_duration_seconds']==decision['selected_duration_seconds'],'actual I1 Source editor versus Root serializer')
    _i5_need(publication['canonical']==support['canonical'] and publication['Root_facts']==support['original_request'] and
              publication['different_lease_Source_review']==support['candidate_review'] and
              publication['candidate_Root_adoption']==support['candidate_Root_adoption'] and author['canonical_publication'] is False,
              'dedicated I1 candidate/original-publication joins')
    _i5_need(type(request['schema_version']) is int and request['schema_version']==2 and
              request['record_type']=='Root_owner_v2_prospective_lease_metadata_facts' and request['author']=='/root' and
              request['current_owner_support']==owner_support and request['issuance_decision']==support['issuance_decision'] and
              request['tool_source']==I5_FIXED['I1_Source'],'actual producer facts14/current support3')
    code={'Source':request['tool_source'],'API':I5_FIXED['I1_API'],'different_review':request['tool_review'],'Root_adoption':request['tool_Root_adoption']}
    _i5_code_support(code,'/root/phase_frontier',read_record,observations,now)
    _i5_need(request['candidate_support']==dict(candidate=support['candidate'],author_receipt=author_pin,
              different_review=support['candidate_review'],Root_adoption=support['candidate_Root_adoption']),
              'publication facts bind actual earlier candidate support4')
    for record in (decision,author,publication):
        for k in ('old_leases_extended','source_family_selected'):_i5_need(record[k] is False,'no historical extension or selected family')
    for k in ('original_closed12_schema_preserved','complete_candidate_bytes_exact','original_owner_and_timestamp_contracts_preserved'):
        _i5_need(publication[k] is True,'actual producer preservation '+k)
    for k in ('actual_entry006','original_fixture_or_case_grant','host_quiet','actor_Job_or_science_authority'):
        _i5_need(publication[k] is False,'no entry/science/quiet authority')
    prior=_i5_review(support['candidate_review'],[support['candidate'],author_pin],['/root','/root/phase_frontier'],read_record,observations,now)
    prior_root=_i5_root(support['candidate_Root_adoption'],[support['candidate'],author_pin],support['candidate_review'],prior,read_record,observations,now)
    later=_i5_review(support['canonical_review'],[support['canonical'],support['original_publication']],['/root','/root/phase_frontier'],read_record,observations,now)
    later_root=_i5_root(support['canonical_Root_adoption'],[support['canonical'],support['original_publication']],support['canonical_review'],later,read_record,observations,now)
    _i5_need(_i5_ticks(decision['created_utc'])<=_i5_ticks(lease['created_utc'])<=_i5_ticks(author['created_utc'])<=
              _i5_ticks(prior['created_utc'])<=_i5_ticks(prior_root['created_utc'])<=_i5_ticks(request['created_utc'])<=
              _i5_ticks(publication['created_utc'])<=_i5_ticks(later['created_utc'])<=_i5_ticks(later_root['created_utc'])<=now,
              'real candidate-to-canonical chronology')
    return lease

def _i5_generic_shapes(facts, decision, owner_support):
