"""Inert dictionary-only phasepeer020 recipe. No I/O, clock, main or subject import.
All decisions, native outcomes and actual Source proofs must exist and be independently authenticated by Root.
This recipe is never imported or invoked by preparation/review and grants no admission.
"""
from copy import deepcopy


def need(value, message):
    if value is not True:
        raise ValueError(message)


def exact_fact3(value):
    need(type(value) is dict and set(value) == {'path','sha256','bytes'}, 'actual closed fact3 supplied externally')
    need(type(value['path']) is str and type(value['sha256']) is str and len(value['sha256']) == 64 and all(c in '0123456789abcdef' for c in value['sha256']) and type(value['bytes']) is int and value['bytes'] > 0, 'positive real Source fact3, not a future placeholder')
    return deepcopy(value)


def phase_peer_dictionary(contract, *, actual_genuine_decision, actual_decision_fact3,
                         actual_support_fact3s, approved_original_schema_updates,
                         actual_Root_created_utc, actual_parser_result,
                         actual_parser_result_fact3, actual_parser_support_fact3s,
                         actual_current_Source_inputs, actual_exact_reversal_proofs):
    """Construct original-schema data after external genuine decisions; no admission."""
    need(contract['role'] == 'phase_peer', 'only the genuine original closed20 phase-peer role')
    decision_pin = exact_fact3(actual_decision_fact3)
    parser_pin = exact_fact3(actual_parser_result_fact3)
    support = [exact_fact3(pin) for pin in actual_support_fact3s]
    parser_support = [exact_fact3(pin) for pin in actual_parser_support_fact3s]
    need(type(actual_genuine_decision) is dict and actual_genuine_decision.get('author') == contract['genuine_content_reviewer']
         and actual_genuine_decision.get('reviewer') == contract['genuine_content_reviewer']
         and actual_genuine_decision.get('verdict') == contract['required_original_verdict']
         and actual_genuine_decision.get('target_execution') is False
         and actual_genuine_decision.get('operational_authority') is False,
         'fresh physically Owner-authored content approval; no predecessor PASS borrowing')
    need(actual_genuine_decision.get('approved_original_schema_updates') == approved_original_schema_updates
         and actual_genuine_decision.get('actual_current_Source_inputs') == support
         and actual_genuine_decision.get('actual_fresh_native_Parser_result') == parser_pin
         and actual_genuine_decision.get('actual_fresh_native_Parser_support') == parser_support
         and len(support) > 0 and len(parser_support) > 0,
         'real independently authenticated Source and Parser chain bound by genuine content decision')
    need(type(actual_current_Source_inputs) is dict
         and set(actual_current_Source_inputs) == set(contract['required_Source_roles'])
         and type(actual_exact_reversal_proofs) is dict
         and set(actual_exact_reversal_proofs) == set(contract['ordered_bound_roles']),
         'all11 exact Source roles and four actual separate reversal proofs')
    sources = {role:exact_fact3(pin) for role,pin in actual_current_Source_inputs.items()}
    for role,pin in sources.items():
        selected = contract['selected_prerequisite_rows'][role]
        need(pin['path'] == selected['canonical_path'] and pin['bytes'] <= selected['source_cap'],
             'actual Source at the entire exact selected canonical path and original cap')
    need(type(actual_parser_result) is dict
         and set(actual_parser_result) == set(contract['native_Parser_result_closed20_keys'])
         and actual_parser_result['record_type'] == 'Root_owned_four_BOUND018_native_Parser_only_result'
         and actual_parser_result['author'] == '/root'
         and actual_parser_result['source_only'] is True
         and actual_parser_result['target_execution'] is False
         and actual_parser_result['operational_authority'] is False
         and actual_parser_result['complete_phase_set'] is True
         and actual_parser_result['all_source_hashes_unchanged'] is True
         and type(actual_parser_result['parse_call_count']) is int
         and actual_parser_result['parse_call_count'] == 4
         and type(actual_parser_result['powershell_parser_error_count']) is int
         and actual_parser_result['powershell_parser_error_count'] == 0,
         'genuine current four-call integer-zero native result, never a missing-output zero inference')
    projections = actual_parser_result['consumer_phase_source_rows']
    need(type(projections) is list and len(projections) == 4
         and type(actual_parser_result['phase_results']) is list and len(actual_parser_result['phase_results']) == 4,
         'all four actual complete native result rows and closed6 projections')
    phase_rows = []
    for index,(bound_role,template_role) in enumerate(contract['ordered_bound_template_pairs']):
        projection = projections[index]
        need(type(projection) is dict and set(projection) == set(contract['phase_source_row_keys_in_order']),
             'original exact phase_source row6, no extra keys')
        bound, template = sources[bound_role], sources[template_role]
        reversal = actual_exact_reversal_proofs[bound_role]
        need(type(reversal) is dict and set(reversal) == {'bound','template','exact_two_literal_reversal','original_function_or_Parser_invoked'}
             and reversal['bound'] == bound and reversal['template'] == template
             and reversal['exact_two_literal_reversal'] is True
             and reversal['original_function_or_Parser_invoked'] is False,
             'actual separately reviewed whole TEMPLATE018 reconstruction from exactly two hash tokens')
        need(projection['path'] == bound['path'] and projection['sha256'] == bound['sha256']
             and projection['template_sha256'] == template['sha256']
             and type(projection['bytes']) is int and projection['bytes'] == bound['bytes']
             and 0 < projection['bytes'] <= 65536
             and projection['exact_two_literal_reversal'] is True
             and type(projection['PowerShell_parser_errors']) is int and projection['PowerShell_parser_errors'] == 0,
             'fresh actual row links exact selected Source, template, bytes and measured integer-zero Parser count')
        actual = actual_parser_result['phase_results'][index]
        need(type(actual) is dict and set(actual) == set(contract['native_Parser_phase_result_closed12_keys'])
             and actual['role'] == bound_role and all(actual[key] == projection[key] for key in projection)
             and type(actual['PowerShell_parser_errors']) is int and actual['PowerShell_parser_errors'] == 0
             and type(actual['error_details']) is list and len(actual['error_details']) == 0,
             'native detailed row matches measured projection and contains truthful complete error details')
        phase_rows.append({key:deepcopy(projection[key]) for key in contract['phase_source_row_keys_in_order']})
    allowed = set(contract['mutable_original_fields']) - {'created_utc','reviewer','reviewer_agent','verdict'}
    need(type(approved_original_schema_updates) is dict and set(approved_original_schema_updates) == allowed
         and all(value is not None for value in approved_original_schema_updates.values()),
         'all and only originally mutable data approved by the actual genuine Owner')
    expected = dict(
        PowerShell_parser_errors=0,
        exact_two_literal_reversal_all_four=True,
        writer_sha256=sources[contract['ordered_bound_roles'][0]]['sha256'],
        supervisor_sha256=sources[contract['ordered_bound_roles'][1]]['sha256'],
        after_writer_sha256=sources[contract['ordered_bound_roles'][2]]['sha256'],
        after_supervisor_sha256=sources[contract['ordered_bound_roles'][3]]['sha256'],
        bound_metadata_source_sha256=sources['capture_bound']['sha256'],
        bound_source_review_sha256=sources['metadata_bound_review']['sha256'],
        phase_source_binding_sha256=sources['phase_binding']['sha256'],
        phase_sources=phase_rows,
    )
    need(approved_original_schema_updates == expected
         and type(approved_original_schema_updates['PowerShell_parser_errors']) is int
         and approved_original_schema_updates['exact_two_literal_reversal_all_four'] is True,
         'all original seven digest links, four ordered row6s and zero/reversal fields coherent with real inputs')
    need(type(actual_Root_created_utc) is str and len(actual_Root_created_utc) == 32
         and actual_Root_created_utc.endswith('+00:00')
         and type(actual_genuine_decision.get('created_utc')) is str
         and actual_genuine_decision['created_utc'] <= actual_Root_created_utc
         and decision_pin is not None,
         'externally observed new real Python UTC6 after genuine content approval; recipe has no clock')
    data = deepcopy(contract['unaccepted_original_schema_template'])
    for key,value in approved_original_schema_updates.items():
        data[key] = deepcopy(value)
    data['created_utc'] = actual_Root_created_utc
    data['reviewer'] = actual_genuine_decision['reviewer']
    data['reviewer_agent'] = actual_genuine_decision['reviewer']
    data['verdict'] = actual_genuine_decision['verdict']
    need(tuple(data) == tuple(contract['original_closed_keys_in_order']), 'exact original closed20 schema/order retained')
    for key,value in contract['immutable_original_fields'].items():
        need(type(data[key]) is type(value) and data[key] == value, 'original nominal or authority field retained: ' + key)
    return data



def generic_receipt_dictionary(contract, *, actual_selected_draft, actual_genuine_content_proposal, actual_genuine_content_decision, actual_Root_content_adoption, actual_Root_serialization_witness, actual_inverse_evidence, actual_recipe_Source_support, actual_current_Source_inputs, actual_Root_created_utc):
    draft = exact_fact3(actual_selected_draft)
    need(draft['path'] == contract['selected_row']['draft_path'] and draft['bytes'] <= contract['selected_row']['source_cap'], 'exact selected draft and original peer cap')
    receipt = {
        'schema_version':1,
        'record_type':'proposed_Root_Source022_genuine_static_peer_selected_byte_author_receipt',
        'author':'/root',
        'created_utc':actual_Root_created_utc,
        'role':contract['role'],
        'draft':draft,
        'predecessor':deepcopy(contract['selected_row']['predecessor']),
        'Root_future_path_selection':deepcopy(contract['Root_future_path_selection']),
        'new_canonical_lease':deepcopy(contract['new_canonical_lease']),
        'Source022':deepcopy(contract['Source022']),
        'physical_selected_byte_editor':'/root',
        'physical_receipt_author':'/root',
        'genuine_content_author_and_reviewer':contract['genuine_content_reviewer'],
        'metadata_Source_worker':contract['selected_row']['preparation_Source_author'],
        'retained_semantic_Source_author':contract['selected_row']['retained_semantic_Source_author'],
        'original_peer_source_author_nominal':contract['original_peer_source_author_nominal'],
        'actual_genuine_content_proposal':exact_fact3(actual_genuine_content_proposal),
        'actual_genuine_content_decision':exact_fact3(actual_genuine_content_decision),
        'actual_Root_content_adoption':exact_fact3(actual_Root_content_adoption),
        'actual_Root_serialization_witness':exact_fact3(actual_Root_serialization_witness),
        'actual_complete_predecessor_inverse':exact_fact3(actual_inverse_evidence),
        'actual_recipe_Source_support':[exact_fact3(pin) for pin in actual_recipe_Source_support],
        'actual_current_Source_inputs':[exact_fact3(pin) for pin in actual_current_Source_inputs],
        'target_execution':False,
        'operational_authority':False,
        'canonical_publication':False,
        'original_fixtures_and_runtime_admission':False,
    }
    need(type(actual_Root_created_utc) is str and len(receipt['actual_current_Source_inputs']) > 0 and len(receipt['actual_recipe_Source_support']) > 0, 'future actual date and genuinely reviewed recipe/current input closure supplied')
    return receipt


def publication_row_dictionary(contract, *, actual_selected_draft, actual_selected_receipt, actual_different_Source_review, actual_Root_adoption):
    row = contract['selected_row']
    draft = exact_fact3(actual_selected_draft)
    need(draft['path'] == row['draft_path'] and draft['bytes'] <= row['source_cap'], 'selected exact future draft')
    return {
        'role':contract['role'],
        'draft':draft,
        'canonical_path':row['canonical_path'],
        'source_review':exact_fact3(actual_different_Source_review),
        'Root_adoption':exact_fact3(actual_Root_adoption),
        'physical_Source_editor':'/root',
        'retained_semantic_Source_author':row['retained_semantic_Source_author'],
        'source_cap':row['source_cap'],
        'author_receipt':exact_fact3(actual_selected_receipt),
        'metadata_Source_worker':row['preparation_Source_author'],
    }

