def pin(path):
    p=Path(path);raw=p.read_bytes();f={'path':str(p),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()};inputs[str(p)]=f;return f,raw
def obj(path):
    f,b=pin(path)
    def pairs(rows):
        d={}
        for k,v in rows:
            if k in d:raise ValueError('duplicate JSON key')
            d[k]=v
        return d
    return f,json.loads(b,object_pairs_hook=pairs,parse_float=lambda _:(_ for _ in()).throw(ValueError('float')),parse_constant=lambda _:(_ for _ in()).throw(ValueError('constant')))
def ck(name,passed,evidence=None):
    if any(r['name']==name for r in checks):raise ValueError('duplicate check')
    checks.append({'name':name,'passed':bool(passed),'evidence':evidence})
def exact(f,label):
    actual,b=pin(f['path']);ck('actual_pin:'+label,type(f) is dict and set(f)=={'path','bytes','sha256'} and actual==f,actual);return b
def constant_sets(tree):
    result={}
    for node in tree.body:
        if not isinstance(node,ast.Assign) or len(node.targets)!=1 or not isinstance(node.targets[0],ast.Name):continue
        v=node.value
        if isinstance(v,ast.Call) and isinstance(v.func,ast.Name) and v.func.id in ('set','frozenset','tuple') and len(v.args)==1:v=v.args[0]
        try:value=ast.literal_eval(v)
        except (ValueError,TypeError,SyntaxError):continue
        result[node.targets[0].id]=value
    return result
def write(path,value):
    b=(json.dumps(value,ensure_ascii=False,sort_keys=True,indent=2)+'\n').encode('utf8')
    if len(b)>2097152:raise ValueError('complete review output cap')
    with Path(path).open('xb') as f:f.write(b)
    return {'path':str(path),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}

