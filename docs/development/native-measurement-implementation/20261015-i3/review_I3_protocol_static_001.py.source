def check(name,passed,evidence):
    checks.append({"name":name,"passed":bool(passed),"evidence":evidence})
    if not passed:raise ValueError((name,evidence))
def read(path,n=None,digest=None):
    raw=path.read_bytes()
    pin={"path":str(path),"bytes":len(raw),"sha256":hashlib.sha256(raw).hexdigest()}
    inputs.append(pin)
    check("Whole actual bounded input "+path.name,0<len(raw)<=2097152 and (n is None or n==len(raw)) and (digest is None or digest==pin["sha256"]),pin)
    return raw
def reject(_):raise ValueError("Noninteger input JSON")
def unique(rows):
    value={}
    for k,v in rows:
        if k in value:raise ValueError("Duplicate input JSON key")
        value[k]=v
    return value
def doc(path,n=None,digest=None):return json.loads(read(path,n,digest).decode(),object_pairs_hook=unique,parse_float=reject,parse_constant=reject)
