def module(raw):
    t=ast.parse(raw);ls=raw.splitlines(keepends=True)
    fs={n.name:n for n in t.body if isinstance(n,ast.FunctionDef)}
    fb={k:b''.join(ls[n.lineno-1:n.end_lineno])for k,n in fs.items()}
    assigns={n.targets[0].id:n.value for n in t.body if isinstance(n,ast.Assign)and len(n.targets)==1 and isinstance(n.targets[0],ast.Name)}
    return t,fs,fb,assigns
