def check(name,condition,evidence):
    if any(c['name']==name for c in checks):raise ValueError('duplicate own check '+name)
    checks.append(dict(name=name,passed=bool(condition),evidence=evidence))
def f3(path,b):return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def raw(path,n=None,h=None):
    path=Path(path); b=path.read_bytes(); p=f3(path,b)
    if str(path) not in inputs:
        inputs[str(path)]=p;cache[str(path)]=b
        check('Whole actual input '+str(path),type(p['bytes'])is int and 0<len(b)<=2097152,p)
    else:check('Retained re-read '+str(path)+' #'+str(len(checks)),b==cache[str(path)],p)
    if n is not None or h is not None:check('Expected exact input '+str(path)+' #'+str(len(checks)),(n is None or len(b)==n)and(h is None or p['sha256']==h),p)
    return b
def exact(p):
    if str(p['path'])in inputs:
        check('Declared input identity '+str(p['path'])+' #'+str(len(checks)),inputs[p['path']]==p,p)
        return cache[p['path']]
    return raw(p['path'],p['bytes'],p['sha256'])
def pairs(rows):
    d={}
    for k,v in rows:
        if k in d:raise ValueError('Duplicate actual review-input JSON key '+k)
        d[k]=v
    return d
def forbidden(s):raise ValueError('float/nonfinite actual review-input token '+s)
def decode(b):return json.loads(b.decode('utf8'),object_pairs_hook=pairs,parse_float=forbidden,parse_constant=forbidden)
def doc(path,n=None,h=None):return decode(raw(path,n,h))
def pins(value):
    if type(value)is dict:
