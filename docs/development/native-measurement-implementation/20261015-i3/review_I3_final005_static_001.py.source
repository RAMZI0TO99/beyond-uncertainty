def audit_module(label,b,t,fs,fc):
    compile(t,label,'exec',dont_inherit=True)
    check('Static AST compile only '+label,True,'compile creates a code object without evaluating, importing or calling target Source.')
    st=symtable.symtable(b.decode(),label,'exec');bound={s.get_name()for s in st.get_symbols()if s.is_assigned()or s.is_imported()or s.is_namespace()};missing=set()
    def walk(table):
        for s in table.get_symbols():
            if s.is_global()and s.is_referenced()and s.get_name()not in bound and s.get_name()not in dir(builtins)and s.get_name()not in{'__file__','__name__','__spec__','__package__','__builtins__'}:missing.add(s.get_name())
        for child in table.get_children():walk(child)
    walk(st);check('No unresolved global references '+label,not missing,sorted(missing))
    assigned=set(dir(builtins))|{'__file__','__name__','__spec__','__package__','__builtins__'};forward=[];immediate=[]
    def deps(expr):return{x.id for x in ast.walk(expr)if isinstance(x,ast.Name)and isinstance(x.ctx,ast.Load)}
    for n in t.body:
        if isinstance(n,(ast.Import,ast.ImportFrom)):
            assigned.update(a.asname or(a.name.split('.')[0]if isinstance(n,ast.Import)else a.name)for a in n.names)
        elif isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)):
            for expr in n.decorator_list+n.args.defaults+[v for v in n.args.kw_defaults if v is not None]:
                if deps(expr)-assigned:forward.append(dict(line=expr.lineno,missing=sorted(deps(expr)-assigned)))
            assigned.add(n.name)
        elif isinstance(n,(ast.Assign,ast.AnnAssign)):
            if n.value is not None:
                if deps(n.value)-assigned:forward.append(dict(line=n.lineno,missing=sorted(deps(n.value)-assigned)))
                immediate.extend(ast.unparse(c.func)for c in ast.walk(n.value)if isinstance(c,ast.Call))
            for v in(n.targets if isinstance(n,ast.Assign)else[n.target]):assigned.update(x.id for x in ast.walk(v)if isinstance(x,ast.Name)and isinstance(x.ctx,ast.Store))
        elif isinstance(n,ast.Expr)and isinstance(n.value,ast.Constant)and isinstance(n.value.value,str):pass
        else:forward.append(dict(line=n.lineno,unsupported_top_level=type(n).__name__))
    check('Sequential top-level/default/decorator bindings '+label,not forward,forward)
    check('No import-time project calls or I/O '+label,set(immediate)<={'Path','frozenset'},sorted(set(immediate)))
    errors=[];calls=0
    for n in ast.walk(t):
        if not isinstance(n,ast.Call)or not isinstance(n.func,ast.Name)or n.func.id not in fs or any(isinstance(a,ast.Starred)for a in n.args)or any(k.arg is None for k in n.keywords):continue
        calls+=1;a=fs[n.func.id].args;pos=a.posonlyargs+a.args;kws={k.arg for k in n.keywords};why=[]
        if a.vararg is None and len(n.args)>len(pos):why.append('too many positional')
        if a.kwarg is None and kws-{x.arg for x in a.args+a.kwonlyargs}:why.append('unknown keyword')
        if any(x.arg in kws for x in pos[:len(n.args)]):why.append('duplicate binding')
        if any(i>=len(n.args)and x.arg not in kws for i,x in enumerate(pos[:len(pos)-len(a.defaults)])):why.append('missing positional')
        if any(d is None and x.arg not in kws for x,d in zip(a.kwonlyargs,a.kw_defaults)):why.append('missing keyword')
        if why:errors.append(dict(line=n.lineno,call=ast.unparse(n),why=why))
    check('All direct local function-call signatures '+label,not errors,dict(calls_inspected=calls,errors=errors))
    assignments=[n for n in ast.walk(t)if isinstance(n,(ast.Assign,ast.AnnAssign,ast.AugAssign))and any(isinstance(x,ast.Name)and isinstance(x.ctx,ast.Store)and x.id=='CURRENT_NATIVE8_DEPENDENCY_ABIS_QUALIFIED'for x in ast.walk(n))]
    check('Single literalFalse ABI hold assignment '+label,len(assignments)==1 and isinstance(assignments[0],ast.Assign)and isinstance(assignments[0].value,ast.Constant)and assignments[0].value.value is False,'No JSON, CLI, environment or later assignment qualifies the held Source.')
    check('Only stdlib imports in Source '+label,all((n.module or '').split('.')[0]in{'__future__','pathlib'}for n in t.body if isinstance(n,ast.ImportFrom))and all(a.name.split('.')[0]in{'base64','datetime','hashlib','json','os','re','stat','struct','sys','types'}for n in t.body if isinstance(n,ast.Import)for a in n.names),'Imports themselves were not performed by this review. Own initial allowlist omitted original stdlib struct; actual imports were reread and allowlist corrected without Source mutation or waiver.')
