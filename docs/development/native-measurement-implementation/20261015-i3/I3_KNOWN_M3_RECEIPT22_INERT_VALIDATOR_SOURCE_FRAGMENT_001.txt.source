def _validate_known_M3_receipt22(*,receipt_pin,facts21_pin,selection_pin,canonical_Source,
    expected_helper_Source,expected_helper_API,expected_helper_editor,state,observations):
    """Known M3 metadata only. No unknown I5 receipt extraction is inferred here.

    A later independently reviewed I3 dependency-binding successor must supply these
    exact authenticated metadata pins from the separately qualified I5 route.
    This private function remains unwired and held in this inert Source successor.
    """
    _need(CURRENT_NATIVE8_DEPENDENCY_ABIS_QUALIFIED is True,
        'known receipt22 validation stays behind literalFalse I2/I4/I5 dependency hold; no flag-only qualification')
    for p in (receipt_pin,facts21_pin,selection_pin,canonical_Source,expected_helper_Source,expected_helper_API):_pin(p)
    _need(canonical_Source['path'] in _EXPECTED_SUBJECT_PINS
        and canonical_Source == _EXPECTED_SUBJECT_PINS[canonical_Source['path']],
        'exact declared canonical Native8 subject pin; no subject body read')
    _need(expected_helper_Source != FIXED_SOURCE_CONTEXT['I2_held_Source_provenance']
        and expected_helper_API != FIXED_SOURCE_CONTEXT['I2_held_API_provenance'],
        'accepted held I2Source002/API provenance cannot be actual Native8 Source generator')
    _need(type(expected_helper_editor) is str and expected_helper_editor.startswith('/root/')
        and expected_helper_editor != ROOT_ONLY, 'actual nonRoot helper Source editor distinct from Root physical serializer')
    receipt = _source_value(receipt_pin,observations)
    facts21 = _source_value(facts21_pin,observations)
    selection = _source_value(selection_pin,observations)
    _need(type(receipt) is dict and set(receipt) == M3_RECEIPT22_KEYS and len(receipt) == 22
        and type(receipt['schema_version']) is int and receipt['schema_version'] == 2
        and receipt['record_type'] == 'Root_owner_v2_actual_deferred_M3_Source_draft_author_receipt'
        and receipt['author'] == receipt['actual_physical_Source_editor'] == ROOT_ONLY,
        'known closed22 v2 Root serializer and physical Source editor; no legacy/unknown receipt acceptance')
    _need(type(facts21) is dict and set(facts21) == M3_FACT21_KEYS and len(facts21) == 21
        and type(facts21['schema_version']) is int and facts21['schema_version'] == 2
        and facts21['record_type'] == 'Root_owner_v2_exact_M3_Source_stage_purpose_and_facts'
        and facts21['author'] == ROOT_ONLY and facts21['Root_thread'] == state['expected_root_thread']
        and facts21['current_owner_scope'] == state['owner_support']['current_owner_scope']
        and facts21['source_only'] is True, 'known closed21 v2 exact M3 Source stage-purpose context')
    for key in ('target_execution','operational_authority','canonical_publication','native_Parser_authority'):
        _need(facts21[key] is False, 'M3 facts21 exact false '+key)
    _need(type(selection) is dict and set(selection) == SELECTION_KEYS and len(selection) == 13
        and type(selection['schema_version']) is int and selection['schema_version'] == 2
        and selection['record_type'] == 'Root_owner_v2_actual_separate_future45_Source_path_selection'
        and selection['author'] == ROOT_ONLY and selection['current_owner_scope'] == facts21['current_owner_scope']
        and selection['new_canonical_lease'] == state['canonical_lease']
        and selection['target_execution'] is False and selection['operational_authority'] is False
        and selection_pin == state['facts']['Root_path_selection']
        and type(selection['rows']) is list and len(selection['rows']) == 45, 'known closed13 selection context and real Native8 family joins')
    rows = {}
    for row in selection['rows']:
        _need(type(row) is dict and set(row) == SELECTION_ROW_KEYS and row['role'] not in rows,
            'known closed9 distinct selected identity rows')
        rows[row['role']] = row
    role = receipt['role']
    _need(type(role) is str and role in ROLE_ORDER and role in rows, 'receipt role is one exact selected Native8 template/bound role')
    row = rows[role]
    _need(row['canonical_path'] == canonical_Source['path'] and type(row['selected_ordinal']) is int
        and row['selected_ordinal'] > 18 and type(row['source_cap']) is int and row['source_cap'] == 65536
        and canonical_Source['bytes'] <= 65536 and row['must_change_Source_bytes'] is True,
        'genuinely new >018 declared canonical phase Source at original cap')
    expected_draft = dict(path=row['draft_path'],bytes=canonical_Source['bytes'],sha256=canonical_Source['sha256'])
    _pin(expected_draft,65536)
    _need(receipt['draft'] == expected_draft and receipt['predecessor'] == row['predecessor']
        and receipt['Root_future_path_selection'] == selection_pin
        and receipt['current_owner_scope'] == facts21['current_owner_scope']
        and receipt['new_canonical_lease'] == state['canonical_lease']
        and receipt['actual_Source_packet'] == facts21_pin
        and receipt['retained_semantic_Source_author'] == row['retained_semantic_Source_author'],
        'exact draft derived from selected draft_path plus declared canonical Source SHA/bytes, predecessor/selection/lease/semantic joins')
    for key in ('target_execution','canonical_publication','operational_authority','original_fixtures_and_runtime_admission'):
        _need(receipt[key] is False, 'M3 receipt22 exact false '+key)
    _need(receipt['complete_current_predecessor_byte_inverse'] is True
        and receipt['different_actual_generated_Source_review_pending'] is True
        and type(receipt['finite_actual_Source_observations']) is list,
        'original receipt inverse/pending-review flags and metadata observations preserved')
    lease_support,selection_support,tool = facts21['lease_support'],facts21['selection_support'],facts21['tool_support']
    _need(type(lease_support) is dict and set(lease_support) == {'canonical','separate_Root_decision','different_review','Root_adoption','original_publication'}
        and lease_support['canonical'] == state['canonical_lease']
        and type(selection_support) is dict and set(selection_support) == {'selection','different_review','Root_adoption'}
        and selection_support['selection'] == selection_pin
        and type(tool) is dict and set(tool) == {'Source','API','different_review','Root_adoption'}
        and tool['Source'] == expected_helper_Source and tool['API'] == expected_helper_API,
        'exact existing M3 support5/support3/tool4 and actual helper Source/API identities')
    steps = receipt['steps']
    _need(type(steps) is dict and set(steps) == {'complete_inverse','actual_diff_removed_byte_basis','actual_check_codec','metadata_Source_provenance'},
        'known exact four M3 receipt steps')
    provenance = steps['metadata_Source_provenance']
    _need(type(provenance) is dict and set(provenance) == {'Source','API','actual_implementation_Source_editor','historical_implementation_Source_editor','stage_purpose','resource_observation'}
        and provenance['Source'] == expected_helper_Source and provenance['API'] == expected_helper_API
        and provenance['actual_implementation_Source_editor'] == expected_helper_editor
        and provenance['historical_implementation_Source_editor'] == '/root/pipeline_source_editor',
        'exact known provenance6 actual helper Source/API/editor with separate historical editor')
    helper_api = _source_value(expected_helper_API,observations)
    _source_read(expected_helper_Source,observations)
    _need(type(helper_api) is dict and type(helper_api.get('schema_version')) is int and helper_api['schema_version'] == 2
        and helper_api.get('record_type') == 'Root_owner_v2_M3_deferred_metadata_inert_API'
        and helper_api.get('Source') == expected_helper_Source
        and helper_api.get('author') == helper_api.get('actual_binding_Source_editor') == expected_helper_editor
        and helper_api.get('external_canonical_receipt_ABI_qualified') is True,
        'actual separately qualified M3 helper API Source/editor joins, not current heldSource002')
    code_review = _verified_review(tool['different_review'],[expected_helper_Source,expected_helper_API],observations,{ROOT_ONLY,expected_helper_editor})
    _verified_root(tool['Root_adoption'],[expected_helper_Source,expected_helper_API,tool['different_review'],code_review['full_proof']],observations)
    stage = facts21['stage']
    if stage == 'templates':
        _need(facts21['role'] is None and role in ROLE_ORDER[:4], 'template facts role is null; receipt names actual selected template')
        stage_roles = ['capture_template']+list(ROLE_ORDER[:4])
    else:
        _need(stage == 'phase_bound' and facts21['role'] == role and role in ROLE_ORDER[4:], 'phase-bound facts/purpose role is exact selected bound role')
        stage_roles = [role]
    purpose = provenance['stage_purpose']
    _need(type(purpose) is dict and set(purpose) == {'schema_version','stage','role','facts','inputs','output_paths'}
        and type(purpose['schema_version']) is int and purpose['schema_version'] == 2
        and purpose['stage'] == stage and purpose['role'] == facts21['role'] and purpose['facts'] == facts21_pin
        and type(purpose['inputs']) is list and type(purpose['output_paths']) is list,
        'known separate closed6 M3 stage-purpose matches actual facts21 stage and role')
    helper_here = Path(expected_helper_Source['path']).parent
    output_paths = []
    for r in stage_roles:
        _need(r in rows, 'every exact M3 stage output role selected')
        draft = Path(rows[r]['draft_path'])
        output_paths.extend((str(draft),str(helper_here/'source_diffs'/(draft.name+'.diff')),
            str(helper_here/'stage_receipts'/('ROOT_CURRENT_OWNER_'+r.upper()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json'))))
    _need(len(output_paths) == len(set(output_paths)) and purpose['output_paths'] == sorted(output_paths)
        and receipt_pin['path'] == str(helper_here/'stage_receipts'/('ROOT_CURRENT_OWNER_'+role.upper()+'_ACTUAL_M3_SOURCE_DRAFT_AUTHOR_RECEIPT_001.json'))
        and receipt['diff']['path'] == str(helper_here/'source_diffs'/(Path(row['draft_path']).name+'.diff')),
        'known finite exact selected draft/diff/receipt output routes, not guessed I5 canonical receipt fields')
    for p in (facts21_pin,selection_pin,state['canonical_lease'],state['owner_support']['current_owner_scope'],expected_helper_Source,expected_helper_API):
        _need(p in purpose['inputs'], 'M3 purpose declares each exact context/helper pin')
    resource = provenance['resource_observation']
    _need(type(resource) is dict and set(resource) == {'observed_utc','available_RAM_bytes','free_disk_bytes'}
        and type(resource['available_RAM_bytes']) is int and resource['available_RAM_bytes'] >= 1073741824
        and type(resource['free_disk_bytes']) is int and resource['free_disk_bytes'] >= 10737418240,
        'retained separate finite M3 RAM/disk observation, not Source pin or Native8 permission')
    _need(_source_ticks(facts21['created_utc']) <= _source_ticks(resource['observed_utc']) <= _source_ticks(receipt['created_utc']),
        'actual facts then resource then receipt chronology without timestamp rewriting')
    return receipt
