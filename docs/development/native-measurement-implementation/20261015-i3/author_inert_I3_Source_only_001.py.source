        and value['current_owner_support'] == state['owner_support'] and value['producer_Source'] == state['helper_Source']
        and value['producer_API'] == state['helper_API'] and value['actual_Root_facts'] == state['facts_pin']
        and value['actual_Root_facts_review'] == state['facts_review'] and value['actual_Root_facts_adoption'] == state['facts_adoption']
