    common_top+='\nLATE_CONTEXT_NAMES = '+repr(literal(0,'LATE_CONTEXT_NAMES'))+'\n' if 'LATE_CONTEXT_NAMES' not in a else ''
    common_top+='\nGENERAL_HOST = Path('+repr(r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe')+')\n'
