        and selection['schema_version'] == 2 and selection['record_type'] == 'Root_owner_v2_actual_separate_future45_Source_path_selection'
        and selection['author'] == ROOT_ONLY and selection['current_owner_scope'] == owner['current_owner_scope']
        and selection['new_canonical_lease'] == facts['canonical_lease'] and selection['target_execution'] is False
        and selection['operational_authority'] is False and type(selection['rows']) is list and len(selection['rows']) == 45,
        'exact selected45 v2 identity decision, never oldpartial inventory promotion')
    selected = {}
    for row in selection['rows']:
        _need(type(row) is dict and set(row) == set(SELECTION_ROW_KEYS) and row['role'] not in selected,
            'exact closed9 distinct45 identity rows')
        selected[row['role']] = row
    _need(set(ROLE_ORDER) <= set(selected), 'all eight declared phase roles selected')
    for row in facts['subjects']:
        chosen = selected[row['role']]
        _need(chosen['canonical_path'] == row['Source']['path'] and chosen['source_cap'] == row['source_cap'] == 65536
            and type(chosen['selected_ordinal']) is int and chosen['selected_ordinal'] > 18
            and chosen['must_change_Source_bytes'] is True, 'true new >018 phase Source subject joins and65536 caps')
        proof = row['canonical_Source_proof']
        _need(type(proof) is dict and set(proof) == set(PROOF_KEYS) and proof['Source'] == row['Source'], 'exact Source proof4 references actual declared subject')
        _verified_review(proof['different_Source_review'],[row['Source']],observations,{ROOT_ONLY,chosen['preparation_Source_author']})
        _verified_root(proof['Root_adoption'],[row['Source'],proof['different_Source_review']],observations)
        _verified_root(proof['Root_publication'],[row['Source'],proof['different_Source_review']],observations,publication=True)
    # Only declared ordinary metadata pins are read here. The eight target bodies are never warmed or restatted.
    for p in _declared_pins(facts)+_declared_pins(selection):
        if p['path'] not in _EXPECTED_SUBJECT_PINS:_source_read(p,observations)
    state=dict(fixed,facts=facts,facts_pin=facts_pin,facts_review=facts_review,facts_full_proof=full_pin,
        facts_adoption=facts_adoption,expected_root_thread=expected_root_thread,owner_support=owner,purpose=purpose,
        helper_Source=hs,helper_API=ha,wrapper_Source=ws,wrapper_API=wa)
    _purpose_gate(state,observations)
    return facts,state


def _validate_helper_result(value,state):
