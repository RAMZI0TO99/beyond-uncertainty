"""Prepare reviewed I3 development evidence; invoke no measurement helper."""
import datetime
import hashlib
import json
import os
from pathlib import Path

R = Path(r"D:\Aenv\pro2")
P = R / "WORK/resume-20261015-001/native_measurement_implementation_006"
G = R / "github-portable-20261012-001"
C = P / "managed_preparation_001/candidates_001"
REL = "docs/development/native-measurement-implementation/20261015-i3/"
CAP = 2097152


def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open("rb") as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data


def fact(path):
    data = raw(path)
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def pinned(pin):
    data = raw(pin["path"])
    assert len(data) == pin["bytes"] and hashlib.sha256(data).hexdigest() == pin["sha256"]
    return data


def save(path, data):
    path = Path(path)
    if type(data) is not bytes:
        data = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + "\n").encode()
    assert len(data) <= CAP
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)


def main():
    adoption_pin = fact(P / "ROOT_I3_NATIVE_HELPER_WRAPPER_SOURCE_REVIEW_ADOPTION_001.json")
    adoption = json.loads(pinned(adoption_pin))
    assert adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I3_NATIVE_HELPER_WRAPPER_SOURCE_ONLY"
    assert adoption["I3_executed"] is False and adoption["tests_executed"] is False
    scope_pin = fact(P / "ROOT_CURRENT_I3_STATIC_NATIVE_HELPER_WRAPPER_IMPLEMENTATION_SCOPE_001.json")
    assert scope_pin["sha256"] == "20ac1f55d545965b05da0aaf4e2a75e8a41f5d254367e637369287041f972a20"
    scope = json.loads(pinned(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope["interval_end"])
    previous_scope_pin = fact(R / "WORK/resume-20261015-001/native_family_implementation_005/managed_preparation_001/candidates_001/EXACT_MANAGED_I2_FAMILY_IMPLEMENTATION_PUBLICATION_SCOPE_001.json")
    assert previous_scope_pin["sha256"] == "0dc00e99cc24d0554143fbd1a00b4adf94744548b7349308f899d5ffdd9d876c"
    previous = json.loads(pinned(previous_scope_pin))
    rows, evidence, names = [], [], set()

    def add(relative, data):
        assert relative.startswith(REL) and relative not in names
        names.add(relative)
        source = save(C / relative, data)
        assert not (G / relative).exists()
        rows.append({"managed_path": relative, "mode": "create", "source": source})
        return source

    inputs = adoption["managed_evidence_inputs"] + [adoption_pin]
    assert len({p["path"] for p in inputs}) == len(inputs)
    for pin in inputs:
        path = Path(pin["path"])
        assert path.resolve().is_relative_to(P.resolve())
        name = path.name + (".source" if path.suffix in (".py", ".ps1") else "")
        assert Path(name).suffix in (".json", ".source")
        copied = add(REL + name, pinned(pin))
        evidence.append({"original": pin, "managed_path": REL + name,
                         "copied_bytes": copied["bytes"], "copied_sha256": copied["sha256"],
                         "inert_Source_copy": path.suffix in (".py", ".ps1")})
    add(REL + "evidence-index.json", {
        "schema_version": 1, "record_type": "I3_exact_Native8_helper_wrapper_Source_and_review_evidence_index",
        "original_absolute_paths_are_dated_provenance_not_portable_runtime_bindings": True,
        "actual_evidence_copy_count": len(evidence), "files": evidence,
        "I3_or_original_helper_import_call_test_native_or_scientific_execution": False,
        "actual_Native8_grant_facts_result_or_family_created": False,
        "current_dated_Source_inventory": {"present": 36, "pending": 9},
        "frozen_STEP080_restore_snapshot": {"present": 35, "pending": 10}})
    report = """# Current owner Native8 helper and wrapper Source implementation

Root accepted the I3 Python Native8 helper, diagnostic wrapper and APIs after actual independent Source review and [Root adoption](ROOT_I3_NATIVE_HELPER_WRAPPER_SOURCE_REVIEW_ADOPTION_001.json). This completes the I3 Source port. Both modules remain unrun; no I0/I1/I2/I3 helper, Native8 collection, Parser or project test ran during this step.

The port uses explicit owner support and Root thread binding, version2 Native facts27, and a separate exact Native8 purpose. I0 context validation and code acceptance supply no collection permission. Future purpose capsule, actual full Source proof and Root adoption must agree on exact facts, Root thread, eight ordered subjects, bounded input pins and an in-memory-only output policy. The code review/adoption covers the helper/wrapper Source/API quartet; it remains distinct from the actual future native purpose.

**All15 complete protected Python functions and the exact347-byte eight-subject loop/postread block remain byte-exact.** These retain full Native10 including LastAccess, both independently stable PATH9/descriptor9 vectors, shared seven-field comparisons, native file index/inode identity, integer100ns FILETIME/UTC7, full buffers and owned-handle cleanup. The wrapper retains one helper call, the original diagnostic functions and exception capture. No retry, warmup, rebaseline, normalization or field omission was added.

**Admission does not pre-read the eight subject files.** Purpose inputs combine paired-read metadata/code/proof inputs with eight declared expected Source pins. Subject bytes are first read inside the preserved measurement routine after its initial native vector; subsequent actual observations must match those declarations. Original postread remains unchanged. Declared pins are not claimed as preflight measurements, and cross-path physical alias provenance remains a trusted Root evidence obligation.

The new helper result is a strict version2 closed16 envelope binding owner support, Root facts and producer Source/API around preserved result data. The wrapper result is a strict closed23 success/refusal envelope. Successful metadata must validate the helper envelope and exact joins; a refusal retains the actual diagnostic from the one attempted helper entry. Preadmission failures propagate before that entry and cannot claim a helper call. Historical Source024/Source022 pins remain dated provenance inside retained data and supply no new authority. The specifications are not issued results.

**The dependency interface remains held by literal false Source guards.** Native entry needs later reviewed I5 receipt/publication contracts, a genuinely qualified I2 producer successor, qualified I4 Parser Source/API compatibility and a separately reviewed I3 binding successor. JSON/CLI approval or flipping a flag alone cannot qualify them. I2Source002 is Source provenance and remains held; it is not represented as the producer of actual eight phase Sources. The known future M3 receipt22 separates Root physical authorship from helper Source-editor provenance. Its private typed validator is authored behind the hold and remains unwired. A later reviewed I3 binding must connect the exact I5 provenance route and include its inputs in the shared purpose closure before entry can qualify.

Source60, lease1200, resource60/RAM1GiB/disk10GiB, ordinary2MiB metadata/output and65536-byte phase caps remain unchanged. Native facts require a bounded canonical lease, actual selected45 identity decision and eight genuinely new TEMPLATE/BOUND Sources beyond018, with their real proofs. No new lease, selected paths/ordinals/nonce, Native8 purpose/facts/result or Parser purpose was created here.

The old dated family remains **36/45, nine pending**; frozen STEP080 remains **35/45, ten pending**. All75 spent identities and prior refusals remain preserved without replay. Fresh original fixtures, C8, actual6, runtime, recovery and science remain unentered. The earlier I0 result of17 passing memory-only methods was not rerun.

Next is a separately scoped **I4 Parser parent/child/API context port**, preserving47 protected I/O spans and both complete original mains. I5 and the held I2/I3 interface qualifications follow before actual family generation and native/Parser admission. An authored helper supplies no invocation permission.

The [evidence index](evidence-index.json) records exact Source/API/inverse/protocol/review copies as development evidence; code copies are inert `.source` files. Absolute paths retain dated provenance and require fresh bindings elsewhere. This directory does not rebuild or overlay STEP080. Three navigation prepends preserve complete prior bytes; Git history and external Root receipts record the later publication.
"""
    add(REL + "I3_NATIVE_IMPLEMENTATION.md", report.encode())
    prefix = ("**October15 I3 Native8 Source port accepted.** The [native helper/wrapper report](" + REL + "I3_NATIVE_IMPLEMENTATION.md) records reviewed owner-context/purpose and typed-result Source changes with all15 protected functions and exact8 loop preserved. Both modules remain unrun; dependency interfaces stay held for later I5/I2/I4 qualification and a reviewed I3 successor. Next: separately scope I4 Parser context. The dated Source inventory stays36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n").encode()
    for name in ("CONTINUE.md", "AGENTS.md", "README.md"):
        predecessor = fact(G / name)
        old_bytes = pinned(predecessor)
        saved = save(P / "managed_preparation_001/predecessors_001" / name, old_bytes)
        source = save(C / name, prefix + old_bytes)
        rows.append({"managed_path": name, "mode": "prepend", "source": source,
                     "predecessor": predecessor, "saved_predecessor": saved, "prefix_bytes": len(prefix)})
    publication_scope = {
        "schema_version": 1, "record_type": "Root_exact_finite_I3_native_Source_implementation_managed_publication_scope",
        "author": "/root", "created_utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "base_HEAD": "57fcb1694f005f94c0b50ed328ec879427f81662",
        "managed_file_count": len(rows), "files": rows, "Root_implementation_adoption": adoption_pin,
        "preexisting608_byte_baseline": previous["preexisting608_byte_baseline"],
        "all_frozen_STEP080_sentinels": previous["all_frozen_STEP080_sentinels"],
        "current36_Source_baseline": previous["current36_Source_baseline"],
        "target_execution": False, "tests_executed": False, "I3_executed": False}
    print(json.dumps(save(C / "EXACT_MANAGED_I3_NATIVE_IMPLEMENTATION_PUBLICATION_SCOPE_001.json", publication_scope)))


if __name__ == "__main__":
    main()
