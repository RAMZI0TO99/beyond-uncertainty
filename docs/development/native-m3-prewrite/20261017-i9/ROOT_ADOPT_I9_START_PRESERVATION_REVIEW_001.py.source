"""Root adopts actual independent start-preservation metadata; no target invocation."""
import datetime, hashlib, json, os, re
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
EXCEPTION = (r'D:\Aenv\pro2\github-portable-20261012-001\docs\development\closeout-evidence\root-docs-independent-major036\INDEPENDENT_MAJOR036_CREATION_REVIEW_001.json', 3483233, 'e646afc11642d8df66cf7ef0aff26474ce45eaec23d08ecd16f17eaedae2b0e9')

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def raw(path, limit=CAP):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= limit
    with path.open('rb') as handle:
        data = handle.read(limit + 1)
    assert len(data) <= limit
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(item):
    assert type(item) is dict and set(item) == {'path', 'bytes', 'sha256'}
    assert type(item['bytes']) is int and item['bytes'] >= 0
    assert type(item['sha256']) is str and re.fullmatch('[0-9a-f]{64}', item['sha256'])
    exceptional = (item['path'], item['bytes'], item['sha256']) == EXCEPTION
    data = raw(item['path'], EXCEPTION[1] if exceptional else CAP)
    assert len(data) == item['bytes'] and hashlib.sha256(data).hexdigest() == item['sha256']
    return data

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

scope_pin = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
scope = obj(pin(scope_pin))
assert scope_pin['sha256'] == '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end'])
review_pin = fact(P / 'managed_review_001/INDEPENDENT_I9_START_PRESERVATION_SOURCE_CAPSULE_001.json')
assert review_pin['sha256'] == '19fbe9c20b536e0c00d25cd4ce2b4bdf2d554299afdd2ee258b3ea35440951ab'
review = obj(pin(review_pin))
full = obj(pin(review['full_proof']))
pin(review['reviewer_Source'])
assert review['reviewer'] == full['reviewer'] == '/root/owner_publication_review'
assert review['verdict'] == full['verdict'] == 'PASS_I9_FRESH_SOURCE_SCOPE_AND_START_PRESERVATION_ONLY'
assert review['current_Source_scope'] == full['current_Source_scope'] == scope_pin
checks = full['checks']
assert type(checks) is list and len(checks) == 9710 == review['serialized_check_count'] == full['serialized_check_count']
assert len({c['name'] for c in checks}) == len(checks)
assert all(type(c) is dict and type(c['passed']) is bool and c['passed'] is True and c['name'].startswith(f'{i:05d}: ') for i, c in enumerate(checks, 1))
assert type(review['checks_failed']) is int and type(full['checks_failed']) is int and review['checks_failed'] == full['checks_failed'] == 0
inputs = full['all_actual_inputs']
assert type(inputs) is list and len(inputs) == 1371 == review['actual_input_count'] == full['actual_input_count']
assert len({q['path'].casefold() for q in inputs}) == len(inputs)
for q in inputs:
    pin(q)
for name in ('all608_historical_bytes_preserved', 'all342_prior_I6_I7_I8_non_navigation_files_preserved', 'all178_I8_candidate_and_published_files_exact', 'all173_I8_evidence_copies_and_originals_exact', 'all6_I8_raw_streams_exact', 'all8_frozen_sentinels_preserved', 'all3_pre_I8_navigation_suffixes_preserved', 'all_actual_input_pins_stable_at_final_readback'):
    assert review[name] is True and full[name] is True
for name in ('target_execution', 'tests_executed', 'Root_preservation_program_invoked', 'Git_command_executed', 'old_or_new_project_target_import_call_test', 'native_Parser_runtime_scientific_execution', 'operational_authority', 'scientific_authority'):
    assert review[name] is False and full[name] is False
assert review['current_Source_present'] == 36 and review['pending_roles'] == 9
assert review['frozen_STEP080_present'] == 35 and review['frozen_STEP080_pending'] == 10
assert review['live_managed_main_base'] == 'add1a93c7a0ad841f3760565b087afcbe638d292'
result = dict(schema_version=1, record_type='Root_I9_actual_independent_start_preservation_review_adoption', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), verdict='ACCEPT_I9_START_PRESERVATION_SOURCE_ONLY', scope=scope_pin, different_Source_review=review_pin, full_proof=review['full_proof'], reviewer_Source=review['reviewer_Source'], all_actual_review_inputs_rehashed=True, actual_rehashed_input_count=len(inputs), actual_named_checks=len(checks), Source_present=36, pending_roles=9, frozen_STEP080_present=35, frozen_STEP080_pending=10, live_base_commit=review['live_managed_main_base'], remote_and_index_boundary='Root fresh saved refresh; reviewer independently checked local Git metadata only.', target_execution=False, tests_executed=False, original_module_invocations=False, actual_family_publication=False, new_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= CAP
output = P / 'ROOT_I9_ACTUAL_START_DIFFERENT_PRESERVATION_REVIEW_ADOPTION_001.json'
with output.open('xb') as handle:
    handle.write(data)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(fact(output)))
