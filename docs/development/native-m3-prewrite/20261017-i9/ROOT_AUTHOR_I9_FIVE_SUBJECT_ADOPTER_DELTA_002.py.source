"""Preserve unrun adopter002 and author exact five-subject adopter003."""
import ast, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
old = (P / 'ROOT_ADOPT_I9_EXACT_DIFFERENT_SOURCE_REVIEW_002.py').read_bytes()
assert len(old) == 6556 and hashlib.sha256(old).hexdigest() == 'f504df121290822f59bdeceaa4e58262b31f18e488ceef8e765d8fb2d797ce0f'
text = old.decode('utf-8'); needle = 'PROTOCOLS = {\n'
addition = "    'ROOT_I9_PROTOCOL001_EXACT_CURRENT_DIFF_HEADER_CLARIFICATION_001.json': (1529, 'e88cb920fbb000eff1b3efbb7135167e465f2e7d7c836e4c833516d7ee63d974'),\n"
before = 'assert len(subjects) == 4 and all(q in subjects for q in protocol_pins)'
assert text.count(needle) == text.count(before) == 1
new = text.replace(needle, needle + addition).replace(before, 'assert len(subjects) == len(PROTOCOLS) and all(q in subjects for q in protocol_pins)').encode('utf-8')
output = P / 'ROOT_ADOPT_I9_EXACT_DIFFERENT_SOURCE_REVIEW_003.py'
ast.parse(new); compile(new, str(output), 'exec')
with output.open('xb') as handle:
    handle.write(new); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(dict(path=str(output), bytes=len(new), sha256=hashlib.sha256(new).hexdigest(), old_Source_preserved=True, old_Source_executed=False, target_execution=False)))
