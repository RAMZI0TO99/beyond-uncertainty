"""Inert evidence adapter Source; never infer fixture entry from a child launch."""
def inspect_exact_unknown_timeout005(row, saved_inputs, source_refusal_lineage):
    check("only historical timeout005 may lack a child result", type(row["attempt_ordinal"]) is int and row["attempt_ordinal"] == 5 and row["result"] is None and row["tests_executed"] is None and row["I9_memory_test_runs"] is None and row["actual_test_case_count"] is None and row["all_cases_passed"] is None and row["accepted_complete_run"] is False and row["unknown_suite_status"] is True)
    sp, vp, ep = row["scope"], row["supervisor"], row["streams_capture"]
    check("exact historical timeout005 scope", sp == {"path": str(P / "ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_005.json"), "bytes": 9147, "sha256": "eff3eab32516e56644e0dbab2f7526e729a8541ea0c44ab3e5f228f466ccf786"})
    check("exact historical timeout005 supervisor", vp == {"path": str(P / "ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_005.json"), "bytes": 3563, "sha256": "8b2f9bc4324cf6acc0b220348bd9db8a8ee20a9bf45468ce827896eaea781de3"})
    check("exact historical timeout005 streams capture", ep == {"path": str(P / "ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_005.json"), "bytes": 2148, "sha256": "0131b744aea3a426339a34105723ccc1910c529d492ece6e01e58de51d5cf990"})
    check("different saved reviewer retains all timeout005 records", all(q in saved_inputs for q in (sp, vp, ep)))
    scope, supervisor, envelope = (loads(pinned(q)) for q in (sp, vp, ep))
    check("timeout005 has no actual child result", not (P / "ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_005.json").exists() and supervisor["child_saved_result"] is None)
    check("timeout005 suite entry and progress remain unknown", supervisor["tests_executed"] is None and supervisor["I9_memory_test_runs"] is None)
    check("timeout005 one owned launch is not a fixture invocation", type(supervisor["owned_child_invocations"]) is int and supervisor["owned_child_invocations"] == 1 and type(supervisor["owned_child_PID"]) is int and supervisor["owned_child_PID"] > 0)
    check("timeout005 unaccepted and reaped with joined streams", supervisor["passed"] is False and supervisor["refusal"] == "owned I9 child exceeded60second wall cap" and supervisor["owned_child_wait_reaped"] is True and supervisor["stream_reader_threads_joined"] is True)
    check("timeout005 recorded wall and reap caps", type(supervisor["wall_cap_seconds"]) is int and supervisor["wall_cap_seconds"] == 60 and type(supervisor["cleanup_reap_seconds"]) is int and supervisor["cleanup_reap_seconds"] == 5 and type(supervisor["owned_child_wall_integer_nanoseconds"]) is int and 60000000000 <= supervisor["owned_child_wall_integer_nanoseconds"] < 65000000000)
    check("timeout005 exact saved scope joins", supervisor["scope"] == envelope["scope"] == sp and envelope["supervisor_result"] == vp and scope["attempt_number"] == supervisor["attempt_number"] == envelope["attempt_number"] == 5)
    check("timeout005 no canonical or original authorization claim", supervisor["actual_canonical_IO"] is False and supervisor["original_project_native_Parser_runtime_scientific_execution"] is False)
    check("timeout005 actual capture complete without replay", envelope["all_streams_complete"] is True and envelope["no_child_or_test_rerun"] is True and envelope["supervisor_accepted"] is False)
    check("timeout005 exactly two saved streams", len(supervisor["streams"]) == len(envelope["streams"]) == 2)
    for role, observed, captured in zip(("STDOUT", "STDERR"), supervisor["streams"], envelope["streams"]):
        q = observed["actual_capture"]
        check("timeout005 exact zero raw stream: " + role, q == {"path": str(P / f"ROOT_I9_ACTUAL_MEMORY_CHILD_{role}_005.txt"), "bytes": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"} and q in saved_inputs and captured["actual_capture"] == q and captured["UTF8_text"] == "" and observed["overcap"] is False and observed["reader_error"] is None and pinned(q) == b"")
    for name in ("ROOT_I9_MEMORY_SCOPE_CONSUMED_005.json", "ROOT_I9_MEMORY_SUPERVISOR_CONSUMED_005.json"):
        q = fact(P / name)
        marker = loads(pinned(q))
        check("timeout005 consumed marker retained", q in saved_inputs and marker["scope"] == sp and marker["automatic_retry_authorized"] is False)
    fresh_pin = fact(P / "ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION_005.json")
    fresh = loads(pinned(fresh_pin))
    check("timeout005 actual fresh-scope adoption retained", fresh_pin in saved_inputs and fresh["author"] == "/root" and fresh["fresh_one_use_scope"] == sp and fresh["verdict"] == "ACCEPT_I9_FRESH_ONE_USE_SYNTHETIC_MEMORY_SCOPE_ONLY")
    check("timeout005 explicit Root unknown-status adoption present", 5 in source_refusal_lineage and source_refusal_lineage[5] in saved_inputs and row["unknown_timeout_Root_adoption"] == source_refusal_lineage[5])
    root = loads(pinned(source_refusal_lineage[5]))
    check("timeout005 exact unknown Root adoption kind", root["author"] == "/root" and root["verdict"] == "ACCEPT_I9_ACTUAL_UNKNOWN_TIMEOUT_AND_EXACT_EQUIVALENT_SOURCE_CORRECTION_ONLY")
    check("timeout005 Root does not invent a suite count", root["I9_memory_test_runs"] is None and type(root["known_I9_memory_test_runs"]) is int and root["known_I9_memory_test_runs"] == 4 and type(root["unknown_I9_memory_test_runs"]) is int and root["unknown_I9_memory_test_runs"] == 1 and type(root["spent_memory_scope_count"]) is int and root["spent_memory_scope_count"] == 5)
    check("timeout005 Root preserves four known failures", root["accepted_complete_memory_test_runs"] == 0 and root["failed_memory_test_runs"] == 4 and root["actual_completed_case_count"] is None and root["actual_error"] is None and root["new_invocation_authorized_now"] is False)
    return 1
