"""Author sixth-attempt metadata controls while preserving the fifth unknown status."""
import ast, datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def raw(path):
    path=Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size<=CAP
    data=path.read_bytes(); assert len(data)<=CAP
    return data

def fact(path):
    data=raw(path)
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def save(path,value):
    data=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(data)<=CAP
    with path.open('xb') as handle:
        handle.write(data); handle.flush(); os.fsync(handle.fileno())
    return fact(path)

def replace(text,before,after,count=1):
    assert text.count(before)==count,(before,text.count(before),count)
    return text.replace(before,after)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv)==2 and re.fullmatch('[0-9a-f]{64}',sys.argv[1])
failure=fact(P/'ROOT_I9_ATTEMPT005_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json')
assert failure['sha256']==sys.argv[1]
r=json.loads(raw(failure['path']))
assert r['author']=='/root' and r['I9_memory_test_runs'] is None
assert r['known_I9_memory_test_runs']==4 and r['unknown_I9_memory_test_runs']==1
assert r['spent_memory_scope_count']==5 and r['failed_memory_test_runs']==4
assert r['accepted_complete_memory_test_runs']==0 and r['tests_executed'] is False and r['target_execution'] is False
created=[]
for original_name,new_name,role in (
    ('ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_006.py','ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_007.py','source_adopter'),
    ('ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_005.py','ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_006.py','binder'),
    ('ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_006.py','ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_007.py','tool_adopter')):
    original=fact(P/original_name); text=raw(original['path']).decode()
    if role=='source_adopter':
        tree=ast.parse(text)
        assignment=next(node for node in tree.body if isinstance(node,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='REQUIRED' for t in node.targets))
        literal=ast.get_source_segment(text,assignment.value); required=ast.literal_eval(assignment.value)
        assert Path(failure['path']).name not in required
        index=len(required); required[Path(failure['path']).name]=failure['sha256']
        text=replace(text,literal,repr(required))
        anchor='        different_Source_review=capsule_pin, full_proof=full_pin, reviewer_Source=reviewer_source,\n'
        text=replace(text,anchor,f'        prior_actual_memory_refusal005_adoption=authority_inputs[{index}],\n'+anchor)
        text=replace(text,'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_005.json','ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_006.json')
    elif role=='binder':
        for base,suffix in (('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION','json'),('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS','json'),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT','json'),('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES','py'),('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES','py'),('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE','py'),('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS','py')):
            text=replace(text,f'{base}_005.{suffix}',f'{base}_006.{suffix}')
        text=replace(text,'attempt_numbers=[5]','attempt_numbers=[6]',2)
    else:
        for base,count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS',1),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT',1),('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION',2),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE',1),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION',1)):
            text=replace(text,f'{base}_005.json',f'{base}_006.json',count)
        text=replace(text,"s['attempt_number'] == 5","s['attempt_number'] == 6")
    if role!='binder':
        text=replace(text,'I9_memory_test_runs=4,','I9_memory_test_runs=None, known_I9_memory_test_runs=4, unknown_I9_memory_test_runs=1, spent_memory_scope_count=5,')
    data=text.encode(); ast.parse(data); compile(data,str(P/new_name),'exec')
    created.append(dict(original_Source=original,new_Source=save(P/new_name,data)))
record=dict(schema_version=1,record_type='Root_I9_sixth_control_Source_author_receipt_preserving_unknown_timeout',
    author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    next_attempt_number=6,prior_actual_failure_adoption=failure,subjects=created,
    I9_memory_test_runs=None,known_I9_memory_test_runs=4,unknown_I9_memory_test_runs=1,
    spent_memory_scope_count=5,failed_memory_test_runs=4,prior_sources_and_all_spent_scopes_preserved=True,
    new_Source_scripts_invoked=False,new_bound_tools_or_scopes_not_yet_born=True,
    automatic_retry_authorized=False,target_execution=False,tests_executed=False,
    operational_authority=False,scientific_authority=False)
print(json.dumps(save(P/'ROOT_I9_ATTEMPT006_METADATA_CONTROL_SOURCE_AUTHOR_RECEIPT_001.json',record)))
