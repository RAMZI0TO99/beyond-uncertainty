checks=[]
inputs={}
raws={}
docs={}

def check(name,passed,evidence=None):
    assert type(name) is str and name and name not in {q['name'] for q in checks}
    assert type(passed) is bool
    q=dict(name=name,passed=passed)
    if evidence is not None:q['evidence']=evidence
    checks.append(q)

def fact(path):
    path=str(Path(path));b=Path(path).read_bytes()
    assert 0<len(b)<=2097152
    pin=dict(path=path,bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    raws[path]=b;inputs[path]=pin
    return pin

def pin(q,label):
    check(label+': strict positive fact3',type(q) is dict and set(q)=={'path','bytes','sha256'} and
          type(q['path']) is str and type(q['bytes']) is int and 0<q['bytes']<=2097152 and
          type(q['sha256']) is str and len(q['sha256'])==64)
    check(label+': whole bytes and SHA256',fact(q['path'])==q)
    return q

def pairs(values):
    out={}
    for k,v in values:
        assert k not in out;out[k]=v
    return out

def bad(value):raise ValueError(value)

def obj(path):
    path=str(Path(path))
    if path not in docs:
        if path not in raws:fact(path)
        docs[path]=json.loads(raws[path].decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    return docs[path]

def refs(value):
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'}:yield value
        else:
            for v in value.values():yield from refs(v)
    elif type(value) is list:
        for v in value:yield from refs(v)

def utc(value):
    q=datetime.datetime.fromisoformat(value.replace('Z','+00:00'))
    assert q.utcoffset()==datetime.timedelta(0)
    return q

