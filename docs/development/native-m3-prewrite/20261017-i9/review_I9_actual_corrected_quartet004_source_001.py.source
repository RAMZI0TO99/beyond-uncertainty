def save(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8')
    assert len(data)<=2097152
    with (OWN/name).open('xb') as handle:handle.write(data)
    return dict(path=str(OWN/name),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

fp=save('INDEPENDENT_I9_INITIAL_IMPLEMENTATION_FULL_SOURCE_PROOF_004.json',full)
capsule=dict(schema_version=1,record_type='Independent_I9_corrected_quartet004_Source_capsule',reviewer=REVIEWER,
    source_author=AUTHOR,created_utc=created,verdict=full['verdict'],subjects=subjects,reviewer_Source=source_pin,full_proof=fp,
