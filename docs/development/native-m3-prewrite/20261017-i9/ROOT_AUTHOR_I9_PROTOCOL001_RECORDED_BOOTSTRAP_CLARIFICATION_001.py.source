"""Record exact inherited bootstrap byte closure without executing owner validation."""
import ast, datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data = path.read_bytes(); assert len(data) <= 2097152
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
protocol = fact(P / 'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json')
assert protocol['sha256'] == '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'
scope = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(json.loads(Path(scope['path']).read_bytes())['interval_end'])
producer = json.loads((P / 'discovery_author_001/I9_COMPLETE_M3_PRODUCER_SEMANTIC_AND_PURE_BOUNDARY_DISCOVERY_001.json').read_bytes())
source = producer['Source']; assert fact(Path(source['path'])) == source
tree = ast.parse(Path(source['path']).read_bytes())
nodes = [n for n in tree.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'FIXED_CONTEXT_ANCHORS' for t in n.targets)]
assert len(nodes) == 1
anchors = ast.literal_eval(nodes[0].value); assert type(anchors) is dict and len(anchors) == 19
for q in anchors.values():
    assert fact(Path(q['path'])) == q
x = dict(schema_version=1, record_type='Root_I9_protocol001_recorded_bootstrap_input_closure_and_external_authority_boundary', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), protocol=protocol, scope=scope, original_producer_Source=source, exact_fixed_I2_context_anchors=anchors,
    owner_manifest='Without adding a trusted top-level key, require purpose.inputs to contain exactly one identifiable closed3 owner-support manifest with keys current_owner_scope,different_current_owner_scope_Source_review,current_owner_scope_Root_adoption, all exact f3, and current_owner_scope equal to trusted.current_owner_scope. Its whole bytes must match the predeclared expected_inputs roster and exact literal purpose in capsule/full/Root adoption. Missing or ambiguous candidate manifests are refused. Read/hash the manifest and all three referenced pins.',
    retained_record_closure='Read/hash scope.owner_instruction_record, scope.owner_policy_record, and the owner-scope review.full_proof. Any fact3 references recursively appearing in these known manifest/scope/review/adoption/full/retained witness records must be finite, declared and pin-matched in purpose.inputs and expected_inputs; aliases, undeclared references and future publisher outputs are refused. This is recorded byte/reference closure, not original I0 authority authentication. Retain the stated pure reader limits.',
    fixed_context='All19 exact fixed I2 anchors listed here must be declared in purpose.inputs and expected_inputs, read and hash-matched. Retain original immutable code proof and Root adoption predicates as metadata with context_required=False; do not invent owner-context joins for code that predates a future context. Never invoke I0/I1/I2 or call old objects. Declare these fixed/context inputs separately from stage proof auxiliaries and generated artifacts.',
    external_authority='I9 checks M3 algorithms, recorded purpose input/output and reference closure and known saved proof semantics. It does not authenticate the original I0 dynamic physical read stream, provenance, live bootstrap, owner policy or current authority. Do not describe this finite recorded-byte closure as complete original I0 authentication or physical observation proof. The separate I8 owner/lease/purpose layer and future genuinely qualified producer/caller/IO composition remain required; all qualification flags stay False.',
    new_trusted_binding_keys=False, new_public_or_carrier_ABI=False, budget_relaxation=False, new_target_Source_authoring_authority=False, target_execution=False, tests_executed=False, new_actual_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(x, sort_keys=True, indent=2, allow_nan=False) + '\n').encode(); assert len(data) <= 2097152
output = P / 'ROOT_I9_PROTOCOL001_RECORDED_BOOTSTRAP_CLOSURE_AND_EXTERNAL_AUTHORITY_BOUNDARY_001.json'
with output.open('xb') as handle:
    handle.write(data); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(fact(output)))
