"""Author only own blocked reviewer Source, never execute target/tool/template."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
O=P/'managed_review_001'
CAP=2097152

def pin(path):
    data=path.read_bytes()
    assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def replace(text,before,after):
    assert text.count(before)==1,before
    return text.replace(before,after)

def main():
    original=O/'review_I9_managed_publication_TEMPLATE_001.py'
    fragment=O/'I9_ACTUAL_ADOPTION_SAVED_RESULTS_ADAPTER_SOURCE_FRAGMENT_002.py'
    text=original.read_text(encoding='utf-8')
    adapter=fragment.read_text(encoding='utf-8')
    compile(ast.parse(adapter),str(fragment),'exec')
    begin=text.index('def inspect_actual_I9_Source_and_saved_results(')
    end=text.index('\ndef main():',begin)
    text=text[:begin]+adapter+'\n\n'+text[end:]
    text=replace(text,'# No I9 target, protocol/adoption schema, Root tooling pins, or candidate scope\n# exists at this preparation point. An immutable successor must bind these facts.',
        '# Actual Source/API/adopter schemas have been read. No accepted final saved\n# result adoption/candidate scope is bound. An immutable successor must bind them.\n# All failure histories, including the newly reported first attempt, must remain.\n# Exact Source/saved-review verdict and Source-adoption pins are final binding keys.')
    # Actual evidence includes dated raw streams. Only finite indexed originals
    # may use .txt; executable Python/PowerShell still gains inert .source suffix.
    text=replace(text,'name.endswith((".json", ".md", ".py.source", ".ps1.source"))',
        'name.endswith((".json", ".md", ".txt", ".py.source", ".ps1.source"))')
    text=replace(text,'data = (json.dumps(record, sort_keys=True, indent=2, allow_nan=False) + "\\n").encode()',
        'data = (json.dumps(record, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\\n").encode()')
    # Add complete dynamic accounting to both proof and derived capsule.
    text=replace(text,'"failed_memory_runs_preserved": actual["failed_runs"],',
        '"failed_memory_runs_preserved": actual["failed_runs"], "accepted_attempt_ordinal": actual["accepted_attempt_ordinal"], "all_saved_memory_attempts": actual["all_saved_memory_attempts"],')
    text=replace(text,'"current_Source_scope": current_scope_pin,',
        '"current_Source_scope": current_scope_pin, "source_scope": current_scope_pin,')
    # Exclude the authored memory tooling from our acceptance jurisdiction.
    text=replace(text,'for pin in b["reviewed_Root_tool_Source_pins"]:\n        data = pinned(pin)',
        'for pin in b["reviewed_Root_tool_Source_pins"]:\n        check("metadata review excludes own-authored memory tools", pathlib.Path(pin["path"]).name not in ("ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_001.py", "ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_001.py", "ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_001.py", "ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_001.py"))\n        data = pinned(pin)')
    output=O/'review_I9_managed_publication_TEMPLATE_002.py'
    data=text.encode('utf-8')
    tree=ast.parse(data,filename=str(output))
    compile(tree,str(output),'exec')
    literal=[n.value for n in tree.body if isinstance(n,ast.Assign) and
        any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets)]
    assert len(literal)==1 and isinstance(literal[0],ast.Constant) and literal[0].value is None
    assert not any(isinstance(n,ast.Raise) and isinstance(n.exc,ast.Call) and
        isinstance(n.exc.func,ast.Name) and n.exc.func.id=='NotImplementedError' for n in ast.walk(tree))
    with output.open('xb') as handle:
        handle.write(data)
    assert output.read_bytes()==data
    source_adoption=P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json'
    adoption=json.loads(source_adoption.read_bytes())
    assert pin(source_adoption)['sha256']=='6295783b7f2888353cbd236a4dbac2b3c817d0d830ade8f671b2087a15d573d4'
    inputs=[original,fragment,Path(__file__),source_adoption,
        P/'ROOT_ADOPT_I9_ACTUAL_SAVED_MEMORY_RESULTS_001.py',
        P/'ROOT_ADOPT_I9_FINITE_MANAGED_PUBLICATION_REVIEW_001.py']
    for q in adoption['subjects']:
        assert pin(Path(q['path']))==q
        inputs.append(Path(q['path']))
    receipt=dict(schema_version=1,record_type='I9_publication_review_adapter_template_preparation_only',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=[pin(path) for path in inputs],reviewer_template=pin(output),
        Source_AST_and_compile_only=True,literal_EXACT_ROOT_BINDINGS=None,
        template_executed=False,target_execution=False,tests_executed=False,
        Root_tool_execution=False,Git_commands_or_mutation=False,
        original001_preserved=True,actual_final_saved_case_count=None,actual_final_candidate_count=None,
        final_saved_results_or_candidate_acceptance=False,
        schemas_read=['Root final Source adoption subjects/different_Source_review/full_proof/protocol/actor/refusal joins',
            'Root saved results adoption all_saved_memory_attempts and dynamic count fields',
            'Root finite adopter capsule/full flags,342/608/8/3 preservation and36/9/35/10 fields',
            'Actual API003 fixture_interface/result_contract and actual Source-review capsule/full schema'],
        actual_saved_attempt001_failure_notice='Parent reports consumed/reaped first run refused E_SELECTION_ROUTE at first positive, zero completed; diagnosis/correction belongs different reviewer/author. This template claims no successful results and remains unbound.',
        pending_bindings=['actual_candidate_scope','actual_implementation_adoption','actual_Source_adoption',
            'actual_Source_review_verdict','actual_saved_results_review_verdict','reviewed_Root_tool_Source_pins',
            'accepted_protocol_and_clarification_pins','actual final output filenames/verdict',
            'exact scope/adoption key map and evidence-index managed path'],
        limits=['Do not bind until actual accepted final saved results+different review+Root adoption/candidate scope.',
            'Every failed attempt preserved; final Source/adoption versions may change after first failure.',
            'Memory tool acceptance belongs genuinely different phase reviewer; this author only joins saved provenance.',
            'Current saved adopter schema requires complete child/refusal/stream evidence for all attempts; unrepresented missing-result or unverified-cleanup cases require a separately reviewed successor.'],
        operational_authority=False,scientific_authority=False)
    path=O/'I9_PUBLICATION_REVIEW_ADAPTER_TEMPLATE_AUTHOR_RECEIPT_002.json'
    encoded=(json.dumps(receipt,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    assert len(encoded)<=CAP
    with path.open('xb') as handle:
        handle.write(encoded)
    assert path.read_bytes()==encoded
    print(json.dumps(dict(template=pin(output),fragment=pin(fragment),receipt=pin(path),author_Source=pin(Path(__file__))),indent=2))

if __name__=='__main__':
    main()
