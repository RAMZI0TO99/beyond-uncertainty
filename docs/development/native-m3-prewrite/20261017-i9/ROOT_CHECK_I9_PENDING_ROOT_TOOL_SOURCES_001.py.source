"""Read/AST/compile pending Root metadata tools, never execute their bodies."""
import ast, datetime, hashlib, json, os
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
names=('ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_001.py','ROOT_PREPARE_I9_MANAGED_CANDIDATES_003.py','ROOT_REVIEWED_I9_FINITE_PUBLICATION_003.py')
rows=[]
for name in names:
    path=P/name;assert path.is_file() and not path.is_symlink() and path.stat().st_size<=2097152
    with path.open('rb') as handle:data=handle.read(2097153)
    assert 0<len(data)<=2097152
    tree=ast.parse(data);compile(data,str(path),'exec')
    functions=[node.name for node in tree.body if isinstance(node,(ast.FunctionDef,ast.AsyncFunctionDef))]
    assert len(functions)==len(set(functions))
    rows.append(dict(Source=dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest()),Source_AST_parse=True,Source_compile_only=True,top_level_function_names_unique=True,body_executed=False))
result=dict(schema_version=1,record_type='Root_I9_pending_metadata_tool_Source_static_check',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),subjects=rows,actual_Source_file_count=len(rows),target_execution=False,tests_executed=False,project_or_native_Parser_invocation=False,pending_metadata_tool_bodies_invoked=False,operational_authority=False,scientific_authority=False)
encoded=(json.dumps(result,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(encoded)<=2097152
path=P/'ROOT_I9_PENDING_ROOT_TOOL_SOURCE_STATIC_CHECK_001.json'
with path.open('xb') as handle:handle.write(encoded);handle.flush();os.fsync(handle.fileno())
print(json.dumps(dict(path=str(path),bytes=len(encoded),sha256=hashlib.sha256(encoded).hexdigest())))
