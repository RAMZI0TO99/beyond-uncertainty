def raw(p,expected=None):
 p=Path(p);b=p.read_bytes();assert 0<len(b)<=2097152
 q=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if expected is not None:assert q==expected
 key=str(p).casefold();assert key not in INPUTS or INPUTS[key]==q;INPUTS[key]=q;return b,q
def object_data(p,expected=None):
 b,q=raw(p,expected);dups=[]
 def pairs(items):
  d={}
  for k,v in items:
   if k in d:dups.append(k)
   d[k]=v
  return d
 v=json.loads(b,object_pairs_hook=pairs);assert type(v) is dict
 nodes=[0,0];bad=[]
 def walk(x,path='',depth=0):
  nodes[0]+=1;nodes[1]=max(nodes[1],depth)
  if type(x) not in (dict,list,str,int,bool,type(None)):bad.append(dict(path=path,type=type(x).__name__))
  if type(x)is str and re.search(r'[\ud800-\udfff]',x):bad.append(dict(path=path,type='surrogate_string'))
  if type(x)is dict:
   for k,y in x.items():walk(y,path+'.'+k,depth+1)
  elif type(x)is list:
   for i,y in enumerate(x):walk(y,path+'['+str(i)+']',depth+1)
 walk(v)
 return v,q,dict(root_builtin_dict=True,duplicate_JSON_keys=dups,builtin_node_count=nodes[0],maximum_depth=nodes[1],unsupported_types_or_surrogates=bad,no_BOM=not b.startswith(b'\xef\xbb\xbf'),within_current_JSON_bounds=nodes[0]<=50000 and nodes[1]<=48 and not dups and not bad)
def occurs(v,p):
 if type(v)is dict:
  if all(k in v and type(v[k]) is type(p[k]) and v[k]==p[k] for k in p):return True
  return any(occurs(x,p) for x in v.values())
 return type(v)is list and any(occurs(x,p) for x in v)
