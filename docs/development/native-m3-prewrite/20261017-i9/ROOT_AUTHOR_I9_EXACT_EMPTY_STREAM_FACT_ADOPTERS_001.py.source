"""Retain genuine zero-byte external stream facts without weakening metadata pins."""
import ast, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
created = []
for name in ('ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_003.py', 'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_003.py'):
    original = P / name
    data = original.read_bytes()
    text = data.decode()
    before = "    assert type(q['path']) is str and type(q['bytes']) is int and 0 < q['bytes'] <= CAP\n"
    after = "    assert type(q['path']) is str and type(q['bytes']) is int and 0 <= q['bytes'] <= CAP\n    if q['bytes'] == 0:\n        assert Path(q['path']).parent == P and re.fullmatch(r'ROOT_I9_ACTUAL_MEMORY_CHILD_(?:STDOUT|STDERR)_[0-9]{3}\\.txt', Path(q['path']).name)\n"
    assert text.count(before) == 1
    text = text.replace(before, after)
    path = P / name.replace('_003.py', '_004.py')
    out = text.encode()
    ast.parse(out)
    compile(out, str(path), 'exec')
    with path.open('xb') as handle:
        handle.write(out)
        handle.flush()
        os.fsync(handle.fileno())
    created.append(dict(original_Source=dict(path=str(original), bytes=len(data), sha256=hashlib.sha256(data).hexdigest()), new_Source=dict(path=str(path), bytes=len(out), sha256=hashlib.sha256(out).hexdigest())))
record = dict(author='/root', record_type='Root_I9_exact_external_empty_stream_fact_adopter_Source_correction', subjects=created,
    external_stream_facts_only=True, metadata_and_Source_pins_remain_positive=True,
    all_old_Source_bytes_preserved=True, new_adopter_bodies_invoked=False,
    I9_memory_test_runs=2, target_execution=False, tests_executed=False,
    operational_authority=False, scientific_authority=False)
path = P / 'ROOT_I9_EXACT_EXTERNAL_EMPTY_STREAM_FACT_ADOPTER_SOURCE_RECEIPT_001.json'
out = (json.dumps(record, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
with path.open('xb') as handle:
    handle.write(out)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(dict(path=str(path), bytes=len(out), sha256=hashlib.sha256(out).hexdigest())))
