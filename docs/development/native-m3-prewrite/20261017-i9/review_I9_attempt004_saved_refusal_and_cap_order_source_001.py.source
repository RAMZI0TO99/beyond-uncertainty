        check('cause carried payload'+str(index)+': bytes fit strict65KiB and cap is not oversized failure',type(row['bytes']) is int and 0<row['bytes']<=65536)
        carried.append(dict(payload_index=index,subject=q,required_read_cap=65536,installed_in_fixed45_cap_map=False))
