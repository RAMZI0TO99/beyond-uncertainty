"""Independent preliminary read/hash/AST audit. Never import or invoke templates."""
import ast
import datetime
import hashlib
import json
import os
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN = P / 'tooling_review_001'
M = P / 'memory_tooling_001'
CAP = 2097152
inputs = {}
checks = []


def pin(path):
    path = Path(path)
    data = path.read_bytes()
    assert 0 < len(data) <= CAP
    result = dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
    if str(path) in inputs:
        assert inputs[str(path)] == result
    inputs[str(path)] = result
    return result, data


def check(name, value, evidence):
    assert type(value) is bool and name not in {x['name'] for x in checks}
    checks.append(dict(name=name, passed=value, evidence=evidence))


def pairs(rows):
    value = {}
    for k, v in rows:
        assert k not in value
        value[k] = v
    return value


def no_number(value):
    raise ValueError(value)


def decode(raw):
    return json.loads(raw, object_pairs_hook=pairs, parse_float=no_number,
                      parse_constant=no_number)


def direct_calls(tree, name):
    return [n for n in ast.walk(tree) if isinstance(n, ast.Call)
            and isinstance(n.func, ast.Name) and n.func.id == name]


def attr_calls(tree, name):
    return [n for n in ast.walk(tree) if isinstance(n, ast.Call)
            and isinstance(n.func, ast.Attribute) and n.func.attr == name]


