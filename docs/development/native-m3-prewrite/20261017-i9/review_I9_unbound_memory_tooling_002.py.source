    check(role + '_scope_fresh_60s_reserve_exact_once_and_false_old_authority', all(s in text for s in
          ("s['maximum_invocations'] == 1", 'NEW_I9_ONLY', 'FRESH_PRIVATE_SCOPE',
           "now() + datetime.timedelta(seconds=60) < end <= source_end",
           "'cleanup_reap_seconds':5", "'actual_selected_family_Source_publication':False")), [q])
    check(role + '_no_original_project_helper_import', all(not isinstance(n, ast.ImportFrom)
          or not n.level for n in ast.walk(tree)) and not any(
          isinstance(n, (ast.Import, ast.ImportFrom)) and 'Source0' in ast.unparse(n)
          for n in ast.walk(tree)), [q])
    regions[role] = {name: dict(first_line=n.lineno, last_line=n.end_lineno,
                               AST_sha256=hashlib.sha256(ast.dump(n, include_attributes=False).encode()).hexdigest())
                     for name, n in defs[role].items()}

