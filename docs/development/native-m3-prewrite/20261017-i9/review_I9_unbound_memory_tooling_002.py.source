    trees[role] = tree
    defs[role] = {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    check(role + '_exact_actual_Source_pin', q['bytes'] == size and q['sha256'] == sha, [q])
    constants = {n.targets[0].id: ast.literal_eval(n.value) for n in tree.body
                 if isinstance(n, ast.Assign) and len(n.targets) == 1
                 and isinstance(n.targets[0], ast.Name) and n.targets[0].id in
                 ('EXACT_ROOT_BINDINGS', 'CAP', 'SOURCE_VERDICT', 'OLD_AUTHORITY_KEY', 'PYTHON')}
    check(role + '_UNBOUND_None_refuses_before_main_work', constants['EXACT_ROOT_BINDINGS'] is None
          and "need(type(b) is dict, 'UNBOUND_I9_MEMORY_TOOLING_TEMPLATE')" in text, [q])
    check(role + '_fixed_2MiB_and_Source_verdict', constants['CAP'] == CAP
          and constants['SOURCE_VERDICT'] == 'ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY', [q])
    check(role + '_main_guard_is_only_top_level_entry', isinstance(tree.body[-1], ast.If)
          and ast.unparse(tree.body[-1].test) == "__name__ == '__main__'"
          and len(direct_calls(tree.body[-1], 'main')) == 1, [q])
    check(role + '_strict_duplicate_float_JSON_and_positive_pin', all(s in text for s in
          ('DUPLICATE_JSON_KEY', 'parse_float=bad_json, parse_constant=bad_json',
           "type(pin['bytes']) is int", "0 < pin['bytes'] <= CAP", 'PIN_CHANGED')), [q])
    check(role + '_finite_outputs_xb_readback_fsync', all(s in text for s in
          ("path.parent == P", "path.open('xb')", 'os.fsync', 'OUTPUT_READBACK')), [q])
    check(role + '_closed_role_paths_and_three_digit_attempt_only', all(s in text for s in
          ("{'runner', 'supervisor', 'scope_preparer', 'capture'}", "len(sys.argv) == 2",
           "re.fullmatch('[0-9]{3}', sys.argv[1])", 'ATTEMPT_NOT_REVIEWED')), [q])
    check(role + '_Source_review_API_count_names_typed_and_joined', all(s in text for s in
