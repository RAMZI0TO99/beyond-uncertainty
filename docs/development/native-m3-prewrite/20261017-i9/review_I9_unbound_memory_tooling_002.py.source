          dict(**common_record, record_type='Independent_I9_UNBOUND_memory_tooling_preliminary_Source_capsule',
               full_proof=fp, actual_input_count=len(held), final_invocation_or_binding_acceptance=False))
print(json.dumps(dict(capsule=cp, full_proof=fp, reviewer_Source=self_q,
                     checks=len(checks), checks_failed=len(failed), failures=failed,
                     actual_inputs=len(held)), indent=2))
