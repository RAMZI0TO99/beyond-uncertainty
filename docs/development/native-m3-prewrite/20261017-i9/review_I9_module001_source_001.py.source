def save(name,value):
    path=OWN/name;data=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(data)<=CAP
    with path.open('xb') as handle:handle.write(data)
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
fp=save('INDEPENDENT_I9_MODULE001_SOURCE_FULL_REFUSAL_PROOF_001.json',full)
cp=save('INDEPENDENT_I9_MODULE001_SOURCE_REFUSAL_CAPSULE_001.json',dict(**common,record_type='Independent_I9_module001_Source_refusal_capsule',full_proof=fp,actual_input_count=len(held),consolidated_defect_count=len(findings)))
print(json.dumps(dict(capsule=cp,full_proof=fp,reviewer_Source=selfq,checks=len(checks),checks_failed=len(failed),failures=failed,actual_inputs=len(held)),indent=2))
