    args=defs[n.func.id].args;pos=args.posonlyargs+args.args;names=[a.arg for a in pos];kw={k.arg for k in n.keywords};bound=set(names[:len(n.args)])|kw
    badcall=(args.vararg is None and len(n.args)>len(pos)) or (args.kwarg is None and bool(kw-set(names)-{a.arg for a in args.kwonlyargs})) or bool(set(names[:len(n.args)])&kw) or bool(set(names[:len(pos)-len(args.defaults)])-bound) or bool({a.arg for a,v in zip(args.kwonlyargs,args.kw_defaults) if v is None}-bound)
