class PurePort(ast.NodeTransformer):
    def visit_FunctionDef(self,n):
        old=n.name;n=self.generic_visit(n);n.name=rename.get(old,old)
        if old in buffers:n.args.args.insert(0,ast.arg(arg='_i9_engine'))
        return n
    def visit_Call(self,n):
        original=n.func.id if isinstance(n.func,ast.Name) else None
        special=n.func.attr if isinstance(n.func,ast.Attribute) and isinstance(n.func.value,ast.Name) and n.func.value.id=='ast' else None
        n=self.generic_visit(n)
        if original in context:n.args.insert(0,ast.Name(id='_i9_engine',ctx=ast.Load()))
        if special in ('parse','literal_eval'):n.func=ast.Name(id='_i9_data_ast' if special=='parse' else '_i9_literal',ctx=ast.Load())
        return n
    def visit_Name(self,n):
        if n.id=='OBSERVATIONS':return ast.Attribute(value=ast.Name(id='_i9_engine',ctx=ast.Load()),attr='observations',ctx=n.ctx)
        return ast.Name(id=rename.get(n.id,n.id),ctx=n.ctx)
