def fact(path):
    path=Path(path);raw=path.read_bytes();assert 0<len(raw)<=CAP
    q=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    if str(path) in inputs:assert inputs[str(path)]==q
    inputs[str(path)]=q;return q,raw
def pairs(rows):
    v={}
    for k,x in rows:assert k not in v;v[k]=x
    return v
def bad(x):raise ValueError(x)
def obj(path):
    q,b=fact(path);return q,json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def check(name,value,evidence):
    assert type(value) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name,passed=value,evidence=evidence))
def constant_values(tree):
    d={}
    for n in tree.body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            x=n.value
            if isinstance(x,ast.Call) and isinstance(x.func,ast.Name) and x.func.id=='frozenset':x=x.args[0]
            try:d[n.targets[0].id]=ast.literal_eval(x)
            except (TypeError,ValueError,SyntaxError):pass
    return d
def norm(v):
    if type(v) in (tuple,list):return [norm(x) for x in v]
    if type(v) in (set,frozenset):return sorted(norm(x) for x in v)
    if type(v) is dict:return {k:norm(x) for k,x in v.items()}
    return v

