OWN=P/'bound_tool_review_001';CAP=2097152;INPUTS={};CHECKS=[]
def data(path):
    path=Path(path);raw=path.read_bytes();assert 0<len(raw)<=CAP
    q=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest());k=q['path'].casefold()
    assert k not in INPUTS or INPUTS[k]==q;INPUTS[k]=q
    return raw,q
def obj(path):
    raw,q=data(path)
    def pairs(items):
        value={}
        for k,v in items:assert k not in value;value[k]=v
        return value
    def reject(v):raise ValueError(v)
    value=json.loads(raw,object_pairs_hook=pairs,parse_float=reject,parse_constant=reject);assert type(value) is dict
    return value,q
def pin(q):
    assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
    raw,current=data(q['path']);assert current==q
    return raw
def check(name,condition):
    assert type(condition) is bool;CHECKS.append(dict(name=name,passed=condition))
def same(a,b):
    if type(a) is not type(b):return False
    if type(a) is dict:return set(a)==set(b) and all(same(a[k],b[k]) for k in a)
    if type(a) is list:return len(a)==len(b) and all(same(x,y) for x,y in zip(a,b))
    return a==b
def save(path,value):
    raw=(json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert 0<len(raw)<=CAP and not path.exists()
    with path.open('xb') as f:f.write(raw)
    assert path.read_bytes()==raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

