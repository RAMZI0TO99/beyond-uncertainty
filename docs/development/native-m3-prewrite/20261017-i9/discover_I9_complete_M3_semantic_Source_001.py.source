P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN=P/'discovery_author_001'
S=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_family_implementation_005\i2\build_M3_metadata_current_owner_deferred_002.py')
A=S.parent/'CURRENT_OWNER_M3_DEFERRED_METADATA_INERT_API_002.json'
scope=P/'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json'
registry={}
def read(path):
    b=path.read_bytes();assert 0<len(b)<=2097152
    registry[str(path)]=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    return b
def pin(path):
    read(path);return dict(registry[str(path)])
def strict(raw):
    def pairs(items):
        out={}
        for k,v in items:
            assert k not in out
            out[k]=v
        return out
    def reject(x):raise ValueError(x)
    return json.loads(raw.decode('utf8'),object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
assert pin(scope)==dict(path=str(scope),bytes=3262,sha256='0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d')
raw=read(S);assert registry[str(S)]['sha256']=='600ab5bf46faceee88b7b5a99eb32b71a7ebfc763151e2f4e3453a6cccd281c2'
api=strict(read(A));assert api['Source']==registry[str(S)]
tree=ast.parse(raw);lines=raw.splitlines(keepends=True)
constants={};constant_sources={}
for node in tree.body:
    if not isinstance(node,ast.Assign) or len(node.targets)!=1 or not isinstance(node.targets[0],ast.Name):continue
    value=node.value
    if isinstance(value,ast.Call) and isinstance(value.func,ast.Name) and value.func.id=='frozenset':value=value.args[0]
    try:constants[node.targets[0].id]=ast.literal_eval(value)
    except (TypeError,ValueError):continue
    constant_sources[node.targets[0].id]=dict(first_line=node.lineno,last_line=node.end_lineno)
functions={}
for node in tree.body:
    if not isinstance(node,ast.FunctionDef):continue
    body=b''.join(lines[node.lineno-1:node.end_lineno])
    calls=sorted({n.func.id if isinstance(n.func,ast.Name) else ast.unparse(n.func) for n in ast.walk(node) if isinstance(n,ast.Call)})
    functions[node.name]=dict(name=node.name,first_line=node.lineno,last_line=node.end_lineno,bytes=len(body),sha256=hashlib.sha256(body).hexdigest(),calls=calls)
invpin=constants['INVENTORY_PIN'];basis_pin=constants['BASIS_PIN']
inv=strict(read(Path(invpin['path'])));basis=strict(read(Path(basis_pin['path'])))
assert registry[invpin['path']]==invpin and registry[basis_pin['path']]==basis_pin
assert len(inv['roles'])==len(basis['rows'])==17
bybasis={r['role']:r for r in basis['rows']};inventory=[]
for row in inv['roles']:
    p=row['available_basis'];body=read(Path(p['path']));assert registry[p['path']]==p
    record=bybasis[row['role']]
    assert base64.b64decode(record['whole_current_bytes_base64'],validate=True)==body
    predecessor=base64.b64decode(record['whole_predecessor_bytes_base64'],validate=True)
    predpin=record['complete_STEP077_predecessor']
    assert len(predecessor)==predpin['bytes'] and hashlib.sha256(predecessor).hexdigest()==predpin['sha256']
    slots=row['literal_slots'];slotchecks=[]
    for slot in slots:
        valid=body[slot['start_byte']:slot['end_byte']]==slot['raw_literal'].encode()
        assert valid
        slotchecks.append(dict(kind=slot['kind'],start_byte=slot['start_byte'],end_byte=slot['end_byte'],raw_span_exact=True))
    phase_counts=None
    if row['role'] in constants['PHASE_BOUND_ROLES']:
        phase_counts={n:len(re.findall(rb'^\$'+n.encode()+rb" = '[a-f0-9]{64}'$",body,re.M)) for n in ('BoundScriptSha256','BoundReviewSha256')}
    inventory.append(dict(role=row['role'],source_cap=row['source_cap'],available_basis=p,whole_actual_buffer_hash_verified=True,
        embedded_basis_current_whole_bytes_equal=True,embedded_prior_pin_hash_verified=True,literal_slot_count=len(slots),
        literal_slots=slotchecks,stored_protected_complement_sha256=row['protected_complement_sha256'],
        inventoried_whole_function_span_count=len(row['whole_function_spans']),JSON_ABI=row['JSON_ABI'],
        phase_old_assignment_pattern_counts=phase_counts,basis_is_current_lease010_Source=row['basis_is_current_lease010_Source'],
        historical_fallback_only=row['historical_fallback_only']))
