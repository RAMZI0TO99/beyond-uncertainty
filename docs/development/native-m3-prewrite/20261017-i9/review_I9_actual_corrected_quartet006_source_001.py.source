"""Independent actual quartet006 Source-only delta and provenance review.

No reviewed target, fixture, renderer, builder, callback or oracle is invoked.
Prior three failed attempts stay consumed. New module005 is unrun; reused fixture005 was Root-entered once.
"""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
I=P/'i9';OWN=P/'independent_review_001'
REVIEWER='/root/owner_source_review';AUTHOR='/root/phase_frontier'
VERDICT='PASS_I9_QUARTET006_EXACT_IMMUTABLE_REVIEW_ABI_SOURCE_ONLY'
checks=[];inputs={};raws={};docs={};metadata_case_aliases=[]

def check(name,passed,evidence=None):
    assert type(name) is str and name and name not in {q['name'] for q in checks}
    assert type(passed) is bool
    q=dict(name=name,passed=passed)
    if evidence is not None:q['evidence']=evidence
    checks.append(q)

def fact(path):
    path=str(Path(path));data=Path(path).read_bytes();assert len(data)<=2097152
    assert data or Path(path).suffix=='.txt'
    q=dict(path=path,bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
    canonical=path
    authority='ROOT_I9_ATTEMPT003_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json'
    if Path(path).parent==P and Path(path).name.casefold()==authority.casefold():
        canonical=str(P/authority)
    cq=dict(q,path=canonical)
    if canonical in inputs:assert inputs[canonical]==cq
    inputs[canonical]=cq;raws[path]=data;raws[canonical]=data
    if canonical!=path and not any(v['reference_spelling']['path']==path for v in metadata_case_aliases):
        metadata_case_aliases.append(dict(reference_spelling=q,actual_input_canonical_spelling=cq,
            boundary='Windows metadata observation alias only; no component Source/pin bytes or target guard normalized.'))
    return q

def pin(q,label):
    check(label+': typed fact3',type(q) is dict and set(q)=={'path','bytes','sha256'} and
          type(q['path']) is str and type(q['bytes']) is int and 0<=q['bytes']<=2097152 and
          (q['bytes']>0 or Path(q['path']).suffix=='.txt') and type(q['sha256']) is str and len(q['sha256'])==64)
    check(label+': whole actual bytes and digest',fact(q['path'])==q)

def pairs(values):
    out={}
    for k,v in values:
        assert k not in out;out[k]=v
    return out

def bad(value):raise ValueError(value)

def obj(path):
    path=str(Path(path))
    if path not in docs:
        if path not in raws:fact(path)
        docs[path]=json.loads(raws[path].decode('utf8'),object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
    return docs[path]

def refs(value):
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'}:yield value
        else:
            for v in value.values():yield from refs(v)
    elif type(value) is list:
        for v in value:yield from refs(v)

def utc(value):
    result=datetime.datetime.fromisoformat(value.replace('Z','+00:00'))
    assert result.utcoffset()==datetime.timedelta(0)
    return result

def literals(tree):
    out={}
    for q in tree.body:
        if isinstance(q,ast.Assign) and len(q.targets)==1 and isinstance(q.targets[0],ast.Name):
            try:out[q.targets[0].id]=ast.literal_eval(q.value)
            except (ValueError,TypeError):pass
    return out

def definitions(tree):return {q.name:q for q in tree.body if isinstance(q,(ast.FunctionDef,ast.ClassDef))}
def segment(text,node):return ast.get_source_segment(text,node)

# Read bytes and AST/data only. None of the reviewed Sources is imported,
