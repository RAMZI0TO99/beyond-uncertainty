def save(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');assert len(data)<=2097152
    with (OWN/name).open('xb') as handle:handle.write(data)
    return dict(path=str(OWN/name),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

