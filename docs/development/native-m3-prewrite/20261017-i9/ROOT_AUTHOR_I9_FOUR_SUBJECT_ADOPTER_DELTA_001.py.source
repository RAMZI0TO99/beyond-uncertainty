"""Preserve unrun adopter001 and author exact four-subject adopter002."""
import ast, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
old = (P / 'ROOT_ADOPT_I9_EXACT_DIFFERENT_SOURCE_REVIEW_001.py').read_bytes()
text = old.decode('utf-8')
needle = 'PROTOCOLS = {\n'
addition = "    'ROOT_I9_PROTOCOL001_RECORDED_BOOTSTRAP_CLOSURE_AND_EXTERNAL_AUTHORITY_BOUNDARY_001.json': (9160, 'bb4a6d54e210d722847b96e68ad761486a59085abe30c4031985b9f41ebab982'),\n"
assert text.count(needle) == 1 and text.count('assert len(subjects) == 3 and') == 1
text = text.replace(needle, needle + addition).replace('assert len(subjects) == 3 and', 'assert len(subjects) == 4 and')
new = text.encode('utf-8')
ast.parse(new); compile(new, 'ROOT_ADOPT_I9_EXACT_DIFFERENT_SOURCE_REVIEW_002.py', 'exec')
output = P / 'ROOT_ADOPT_I9_EXACT_DIFFERENT_SOURCE_REVIEW_002.py'
with output.open('xb') as handle:
    handle.write(new); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(dict(path=str(output), bytes=len(new), sha256=hashlib.sha256(new).hexdigest(), old_Source_preserved=True, old_Source_executed=False, target_execution=False)))
