helper='''def _fx_drop_later_stage_purpose_input(fixture,stage_key,path,protected_stage_key):
    # One later stage only. Retain first-stage bytes so the shared Reader must actually cache it first.
    graph=fixture['graph'];support=fixture['trusted']['stage_supports'][stage_key]
    current_cap=json.loads(graph['store'][support['different_review']['path']])
    stage_role=stage_key.split(':',1)[1]
    assert current_cap['exact_M3_Source_stage_purpose']['role']==stage_role
    assert path in [p['path'] for p in current_cap['exact_M3_Source_stage_purpose']['inputs']]
    first=fixture['trusted']['stage_supports'][protected_stage_key]
    first_cap=json.loads(graph['store'][first['different_review']['path']])
    assert path in [p['path'] for p in first_cap['exact_M3_Source_stage_purpose']['inputs']]
    protected_paths=[p['path'] for p in first.values()]+[first_cap['full_proof']['path']]
    protected_paths += [p['path'] for artifact in graph['stage_artifacts'][protected_stage_key] for p in (artifact['draft'],artifact['diff'],artifact['author_receipt'])]
    protected={p:graph['store'][p] for p in protected_paths}
    targets=[current_cap['full_proof']['path'],support['different_review']['path'],support['Root_adoption']['path']]
    targets += [a['author_receipt']['path'] for a in graph['stage_artifacts'][stage_key]]
    for current in targets:
        raw=graph['store'][current];value=json.loads(raw);changed=[False]
        def remove(v):
            if type(v) is dict:
                selected={k:remove(x) for k,x in v.items()}
                if set(selected)=={'schema_version','stage','role','facts','inputs','output_paths'} and selected['stage']=='phase_bound' and selected['role']==stage_role:
                    previous=selected['inputs'];selected['inputs']=[p for p in previous if p['path']!=path]
                    assert len(selected['inputs'])==len(previous)-1
                    changed[0]=True
                if type(selected.get('finite_actual_Source_observations')) is list:
                    previous=selected['finite_actual_Source_observations']
                    selected['finite_actual_Source_observations']=[p for p in previous if p['path']!=path]
                    assert len(selected['finite_actual_Source_observations'])==len(previous)-1
                    changed[0]=True
                return selected
            if type(v) is list:return [remove(x) for x in v]
            return v
        selected=remove(value);assert changed[0]
        _fx_repin(fixture,current,_fx_wire(selected))
    assert all(graph['store'][p]==raw for p,raw in protected.items())
    later=json.loads(graph['store'][support['different_review']['path']])
    assert path not in [p['path'] for p in later['exact_M3_Source_stage_purpose']['inputs']]
    assert path in [p['path'] for p in fixture['trusted']['expected_inputs']]
    return fixture


'''
