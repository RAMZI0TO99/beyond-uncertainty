def save(name,value):
    body=(json.dumps(value,ensure_ascii=False,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf-8')
    assert len(body)<=2097152
    with (OWN/name).open('xb') as handle:
        handle.write(body)
    return dict(path=str(OWN/name),bytes=len(body),sha256=hashlib.sha256(body).hexdigest())

OWN.mkdir(parents=True,exist_ok=True)
