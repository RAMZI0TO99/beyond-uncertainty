"""Independent read/hash/JSON/AST review of an already consumed failed attempt.

Never imports or executes either reviewed target, fixture, renderer, or builder.
Only this directory receives create-once metadata outputs. No target replay.
"""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN = P / 'saved_refusal_review_001'
REVIEWER = '/root/owner_source_review'
VERDICT = 'PASS_I9_ATTEMPT001_SAVED_REFUSAL_AND_FIXTURE_SELECTION_ROUTE_CAUSE_SOURCE_ONLY'
CHECKS = []
INPUTS = {}
BYTES = {}
DOCUMENTS = {}

def check(name, passed, evidence=None):
    assert type(name) is str and name and name not in {v['name'] for v in CHECKS}
    assert type(passed) is bool
    item = dict(name=name, passed=passed)
    if evidence is not None:
        item['evidence'] = evidence
    CHECKS.append(item)

def fact(path, allow_empty=False):
    path = Path(path)
    body = path.read_bytes()
    assert len(body) <= 2097152
    assert allow_empty or len(body) > 0
    pin = dict(path=str(path), bytes=len(body), sha256=hashlib.sha256(body).hexdigest())
    BYTES[str(path)] = body
    if body:
        INPUTS[str(path)] = pin
    return pin

def verify(pin, label):
    shape = (type(pin) is dict and set(pin) == {'path','bytes','sha256'} and
             type(pin.get('path')) is str and type(pin.get('bytes')) is int and pin['bytes'] > 0 and
             type(pin.get('sha256')) is str and len(pin['sha256']) == 64)
    check(label + ': strict positive fact3', shape)
    assert shape
    observed = fact(pin['path'])
    check(label + ': whole bytes and SHA256', observed == pin)
    return observed

def pairs(rows):
    result = {}
    for k,v in rows:
        assert k not in result
        result[k] = v
    return result

def bad(value):
    raise ValueError(value)

def doc(path):
    path = str(Path(path))
    if path not in DOCUMENTS:
        if path not in BYTES:
            fact(path)
        DOCUMENTS[path] = json.loads(BYTES[path].decode('utf-8'), object_pairs_hook=pairs,
                                      parse_float=bad, parse_constant=bad)
    return DOCUMENTS[path]

def refs(value):
    if type(value) is dict:
        if set(value) == {'path','bytes','sha256'}:
            yield value
        else:
            for v in value.values():
                yield from refs(v)
    elif type(value) is list:
        for v in value:
            yield from refs(v)

def utc(text):
    value = datetime.datetime.fromisoformat(text.replace('Z','+00:00'))
    assert value.utcoffset() == datetime.timedelta(0)
    return value

def load(name):
    path = P/name
    fact(path)
    return doc(path)

