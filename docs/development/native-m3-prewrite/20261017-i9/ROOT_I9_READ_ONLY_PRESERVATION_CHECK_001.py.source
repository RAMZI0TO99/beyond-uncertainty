for row in s['files']:
 pin(row['source'],G/row['managed_path'])
 if row['mode']=='create':prior.append(dict(path=str(G/row['managed_path']),bytes=row['source']['bytes'],sha256=row['source']['sha256']))
assert len(prior)==342 and len({q['path'].casefold() for q in prior})==342
for q in prior:pin(q)
adop=obj(pin(s['Root_implementation_adoption']));assert adop['actual_memory_case_count']==97 and adop['I8_memory_test_runs']==3 and adop['failed_memory_test_runs']==2
for q in adop['managed_evidence_inputs']:pin(q)
