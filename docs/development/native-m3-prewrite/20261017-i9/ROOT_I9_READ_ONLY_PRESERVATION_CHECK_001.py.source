"""Current finite read/hash preservation refresh, no project target execution."""
import datetime,hashlib,json,os,subprocess
from pathlib import Path
R=Path(r'D:\Aenv\pro2');P=R/'WORK/resume-20261017-001/m3_prewrite_validation_012';G=R/'github-portable-20261012-001';CAP=2097152
GIT=r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Git\cmd\git.exe'
def raw(p,cap=CAP):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=cap
 with p.open('rb') as h:b=h.read(cap+1)
 assert len(b)<=cap;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q,path=None,cap=CAP):
 b=raw(path or q['path'],cap);assert type(q['bytes']) is int and len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def obj(b):return json.loads(b)
scopepin=fact(P/'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json');root=obj(pin(scopepin))
