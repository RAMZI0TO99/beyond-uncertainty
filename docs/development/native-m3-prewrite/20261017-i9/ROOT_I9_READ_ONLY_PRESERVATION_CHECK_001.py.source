def git(*args):
 c=subprocess.run([GIT,'-c','core.autocrlf=false','-c','core.safecrlf=false',*args],cwd=G,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,check=True);return c.stdout
