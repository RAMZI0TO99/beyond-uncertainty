"""Adopt the saved fixture Source refusal without invoking a fixture or target."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and 0 < q['bytes'] <= CAP
    assert type(q['sha256']) is str and re.fullmatch('[0-9a-f]{64}', q['sha256'])
    data = raw(q['path'])
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
scope_pin = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert scope_pin['sha256'] == '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(obj(pin(scope_pin))['interval_end'])
subject = fact(P / 'i9/test_recorded_M3_semantics_memory_only_001.py')
assert subject['bytes'] == 2035229 and subject['sha256'] == '2959fae47777c7cba19eb83dec543085be5b83b9f70af175b3671b23991b4eac'
capsule_pin = fact(P / 'fixture_review_001/INDEPENDENT_I9_FIXTURE001_CONTENT_SOURCE_REFUSAL_CAPSULE_001.json')
assert capsule_pin['sha256'] == 'c02359dc0b5562a70e7d8492efb47671fb8363fa10927fc0eb5fdfb1a13811d9'
c = obj(pin(capsule_pin))
f = obj(pin(c['full_proof']))
for record in (c, f):
    assert record['reviewer'] == '/root/owner_source_review' and record['source_author'] == '/root/phase_frontier'
    assert record['verdict'] == 'REFUSE_I9_FIXTURE001_CONTENT_SOURCE_TWO_BLOCKERS_AND_EXISTING_ORACLE_COVERAGE'
    assert record['subjects'] == [subject] and record['target_execution'] is False and record['tests_executed'] is False
    assert type(record['checks_passed']) is int and record['checks_passed'] == 310
    assert type(record['checks_failed']) is int and record['checks_failed'] == 3
checks = f['checks']
assert len(checks) == 313 and len({q['name'] for q in checks}) == 313
assert all(type(q['passed']) is bool for q in checks) and sum(q['passed'] for q in checks) == 310
inputs = f['all_actual_inputs']
assert len(inputs) == 125 and len({q['path'].casefold() for q in inputs}) == 125
assert subject in inputs and c['reviewer_Source'] in inputs
for q in inputs:
    pin(q)
assert [q['id'] for q in f['findings']] == ['I9_FIXTURE001_F1_CODE_SOURCE_VERDICT', 'I9_FIXTURE001_F2_POP_RETURN_REPLACES_WHOLE_RECORD', 'I9_FIXTURE001_F3_BRANCH_CALLBACK_AND_NESTED_SNAPSHOT_ORACLES']
result = dict(schema_version=1, record_type='Root_actual_I9_fixture001_Source_refusal_and_correction_adoption',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='ACCEPT_I9_FIXTURE001_SOURCE_REFUSAL_AND_EXISTING_CASE_CORRECTIONS_ONLY',
    source_scope=scope_pin, refused_fixture_Source=subject, different_Source_review=capsule_pin,
    full_proof=c['full_proof'], reviewer_Source=c['reviewer_Source'],
    actual_named_checks=313, actual_passed_checks=310, actual_failed_checks=3,
    actual_rehashed_input_count=125, all_actual_inputs_rehashed=True, Source_findings=f['findings'],
    fixture001_and_independent_draft001_preserved_unrun=True,
    corrected_fixture002_API002_and_receipt002_require_actual_final_quartet_review=True,
    fixture_content_contributor='/root/i9_fixture_author', physical_final_Source_editor='/root/phase_frontier',
    target_execution=False, tests_executed=False, I9_memory_test_runs=0,
    new_module_or_fixture_invocation_authorized=False,
    old_I0_I8_changes_or_invocations_authorized=False, actual_family_publication=False,
    all_new_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= CAP
output = P / 'ROOT_I9_FIXTURE001_ACTUAL_SOURCE_REFUSAL_AND_EXISTING_CASE_CORRECTION_ADOPTION_001.json'
with output.open('xb') as handle:
    handle.write(data)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(fact(output)))
