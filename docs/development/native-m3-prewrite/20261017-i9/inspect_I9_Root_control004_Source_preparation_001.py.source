"""Different finite Root controls004 Source analysis; no reviewed tool invocation."""
import ast
import datetime
import hashlib
import json
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN=P/'bound_tool_review_001';INPUTS={};CHECKS=[]
def read(path):
    path=Path(path);b=path.read_bytes();assert 0<len(b)<=2097152
    q=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    k=str(path).casefold();assert k not in INPUTS or INPUTS[k]==q;INPUTS[k]=q
    return b,q
def source(path):
    b,q=read(path);ast.parse(b);compile(b,str(path),'exec');return b.decode(),q
def check(name,value):
    assert type(value)is bool;CHECKS.append(dict(name=name,passed=value));assert value,name
def replace(s,a,b,n=1):
    assert s.count(a)==n,(a,s.count(a),n);return s.replace(a,b)
factory,fp=source(P/'ROOT_AUTHOR_I9_NEXT_ONCE_CONTROL_SOURCES_001.py')
b,rp=read(P/'ROOT_I9_ATTEMPT004_METADATA_CONTROL_SOURCE_AUTHOR_RECEIPT_001.json');r=json.loads(b)
check('Exact actual Root controls004 Source receipt',rp['bytes']==2662 and rp['sha256']=='7fea862a455798648bf388e658f19ce6f90279cf34adf98c2c808947a8c34c3b')
check('Controls004 Source authoring preserves global3 history and no invocation',r['author']=='/root' and r['next_attempt_number']==4 and r['I9_memory_test_runs']==r['failed_memory_test_runs']==3 and r['new_Source_scripts_invoked'] is False and r['target_execution'] is False and r['tests_executed'] is False and r['automatic_retry_authorized'] is False)
b,failurepin=read(r['prior_actual_failure_adoption']['path']);failure=json.loads(b)
check('Exact actual spent attempt003 failure adoption',failurepin==r['prior_actual_failure_adoption'] and failurepin['sha256']=='6301ca4668dfec5ae1670c6d40dd7f18d229c529675b936cf5812afd0ef79e5a' and failure['I9_memory_test_runs']==failure['failed_memory_test_runs']==3 and failure['accepted_complete_memory_test_runs']==0 and failure['actual_completed_case_count']==0)
subjects=[]
for row in r['subjects']:
    old,oldpin=source(row['original_Source']['path']);new,newpin=source(row['new_Source']['path']);subjects.append(newpin)
    name=Path(oldpin['path']).name;expected=old
    check('Actual old/new Source pins '+name,oldpin==row['original_Source'] and newpin==row['new_Source'])
    if name.startswith('ROOT_ADOPT_I9_FINAL'):
        tree=ast.parse(old)
        node=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id=='REQUIRED' for x in n.targets))
        oldvalue=ast.get_source_segment(old,node.value);required=ast.literal_eval(node.value)
        check('Exactly15 prior immutable authority inputs retained before attempt003 addition',len(required)==15 and Path(failurepin['path']).name not in required)
        required[Path(failurepin['path']).name]=failurepin['sha256']
        expected=replace(expected,oldvalue,repr(required))
        anchor='        different_Source_review=capsule_pin, full_proof=full_pin, reviewer_Source=reviewer_source,\n'
        expected=replace(expected,anchor,'        prior_actual_memory_refusal003_adoption=authority_inputs[15],\n'+anchor)
        expected=replace(expected,'I9_memory_test_runs=2','I9_memory_test_runs=3')
        expected=replace(expected,'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_003.json','ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_004.json')
        check('Required historical context includes all three failures and scan scope',all(x in required for x in (
          'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json',
          'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json',
          Path(failurepin['path']).name,'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json')))
    elif name.startswith('ROOT_BIND'):
        for base,suffix in (('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION','json'),
          ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS','json'),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT','json'),
          ('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES','py'),('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES','py'),
          ('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE','py'),('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS','py')):
            expected=replace(expected,base+'_003.'+suffix,base+'_004.'+suffix)
        expected=replace(expected,'attempt_numbers=[3]','attempt_numbers=[4]',2)
        check('Only finite fourth attempt selected',new.count('attempt_numbers=[4]')==2 and 'attempt_numbers=[3]' not in new)
        check('All four original TEMPLATE002 Source identities retained',all(d in new for d in (
          'dbd64396b20019b965115d2a5a8b2e1c465b8c36e227b5b403657cb49036680d',
          '02e6fc14789a27e0b5d5d3a2ef23b9fdbf9b9e43116f7fe7135fe29902b3afaf',
          'b926dd703bdb4aea87f8ed1693ffd218e70d62e2c2cdeb5ce7c5a80022f20d87',
          'cf1533d475dc113d1e5ab85c0749faf8345ed0d2f534d88ae33762c357824720')))
    else:
        for base,count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS',1),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT',1),
          ('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION',2),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE',1),
          ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION',1)):
            expected=replace(expected,base+'_003.json',base+'_004.json',count)
        expected=replace(expected,"s['attempt_number'] == 3","s['attempt_number'] == 4")
        expected=replace(expected,'I9_memory_test_runs=2','I9_memory_test_runs=3')
        check('Independent review and reserve65 before scope adoption retained',"record['reviewer'] == '/root/phase_frontier'" in new and 'now + datetime.timedelta(seconds=65)' in new and 'expected = [fresh_scope]' in new)
    check('Entire Source complement exact outside bounded metadata delta '+name,new==expected)
    for anchor in ('ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json',
      'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'):
        if anchor in old:check('Immutable original Source authority anchor retained '+name+' '+anchor,new.count(anchor)==old.count(anchor))
    if name.startswith('ROOT_ADOPT'):
        oldtree=ast.parse(old);newtree=ast.parse(new)
        op=next(n for n in oldtree.body if isinstance(n,ast.FunctionDef) and n.name=='pin')
        np=next(n for n in newtree.body if isinstance(n,ast.FunctionDef) and n.name=='pin')
        check('Positive metadata and exact external-empty-stream pin body unchanged '+name,ast.get_source_segment(old,op)==ast.get_source_segment(new,np))
_,selfpin=read(Path(__file__))
check('All own named checks unique',len({q['name'] for q in CHECKS})==len(CHECKS))
report=dict(schema_version=1,record_type='independent_I9_Root_controls004_Source_preparation_analysis',
 reviewer='/root/phase_frontier',source_author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),
 subjects=subjects,reviewer_Source=selfpin,all_actual_inputs=sorted(INPUTS.values(),key=lambda q:q['path']),
 checks=CHECKS,checks_passed=len(CHECKS),checks_failed=0,status='NO_ACTIONABLE_CONTROL004_SOURCE_DEFECT_FOUND_PRELIMINARY_ONLY',
 actual_six_bound_subjects_review_not_yet_performed=True,new_bound_tool_Source_acceptance_issued=False,
 target_execution=False,tests_executed=False,tools_invoked=False,
 limitations=['No target semantic acceptance is issued by this different Root-controls review.',
 'Actual Sourceadoption004 plus four bound Sources/config/receipt004 must exist before final six-subject Source review.',
 'All spent scopes and three failed actual attempts remain immutable; no retry or invocation follows this preparation analysis.'])
path=OWN/'INDEPENDENT_I9_ROOT_CONTROL004_SOURCE_PREPARATION_ANALYSIS_001.json'
b=(json.dumps(report,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152
with path.open('xb') as f:f.write(b)
print(json.dumps(dict(report=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),checks_passed=len(CHECKS))))
