"""Record precise non-executable AST and aggregate-reader protocol clarification."""
import datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data = path.read_bytes()
    assert len(data) <= 2097152
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
protocol = fact(P / 'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json')
assert protocol['bytes'] == 122682 and protocol['sha256'] == '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'
scope = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(json.loads(Path(scope['path']).read_bytes())['interval_end'])
x = dict(schema_version=1, record_type='Root_I9_protocol001_precise_bounded_AST_and_aggregate_reader_clarification', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), protocol=protocol, scope=scope,
    aggregate_reader='One API call constructs exactly one I9Reader and one immutable caller snapshot. A prewrite call dispatches all applicable stages through private validation functions sharing that same Reader, cache, role caps, output protections, declared roster and aggregate256 distinct/33554432 declared bytes/1024 callback/67108864 returned bytes/depth48/node50000 budgets. It must not recursively call the public stage-only entry to reset budgets. A separate caller invocation of the stage-only API is a separate bounded validation call, never authority for a later prewrite.',
    AST_data_exception='The original intrinsic assignments/functions/protected-assignment/complement algorithms require ast.parse and ast.literal_eval on bounded Python Source bytes or AST nodes as DATA. Allow only ast.parse with ordinary non-executable PyCF_ONLY_AST behavior and ast.literal_eval; this is an explicit narrow exception to generic compile-forbidden language. No executable code object is produced or invoked by these target operations. Direct target use of compile/eval/exec/__import__, dynamic imports, importlib, source-loader execution and target function/main invocation remains forbidden. ast.parse internally emits a CPython compile audit event; the reviewed driver must distinguish bounded AST-only parsing from its own exactly-two initial executable target/fixture compile+exec operations. This exception does not permit invoking an old target or fixture.',
    new_public_or_carrier_ABI=False, budget_relaxation=False, new_target_Source_authoring_authority=False, target_execution=False, tests_executed=False, new_actual_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(x, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= 2097152
output = P / 'ROOT_I9_PROTOCOL001_BOUNDED_AST_AND_AGGREGATE_READER_CLARIFICATION_001.json'
with output.open('xb') as handle:
    handle.write(data); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(fact(output)))
