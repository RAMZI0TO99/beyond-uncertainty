            assert all(q in review_inputs for q in (sp,vp,capture_pin,ap,up,s['Source_adoption'],s['module_Source'],s['fixture_Source'],s['API'],s['author_receipt']))
            assert not (P / f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json').exists()
            assert v['child_saved_result'] is None and v['tests_executed'] is None and v['I9_memory_test_runs'] is None
            assert v['attempt_number'] == s['attempt_number'] == 5 and v['passed'] is False
            assert v['scope'] == capture['scope'] == sp and capture['supervisor_result'] == vp
            assert v['refusal'] == 'owned I9 child exceeded60second wall cap'
            assert v['owned_child_invocations'] == 1 and v['owned_child_wait_reaped'] is True
            assert v['stream_reader_threads_joined'] is True and capture['all_streams_complete'] is True
            assert capture['no_child_or_test_rerun'] is True and v['wall_cap_seconds'] == 60 and v['cleanup_reap_seconds'] == 5
            assert 60000000000 <= v['owned_child_wall_integer_nanoseconds'] < 65000000000
            assert a['fresh_one_use_scope'] == sp and a['author'] == '/root'
            assert a['verdict'] == 'ACCEPT_I9_FRESH_ONE_USE_SYNTHETIC_MEMORY_SCOPE_ONLY'
            assert a['new_I9_memory_invocation_authorized_now'] is True
            assert datetime.datetime.fromisoformat(a['created_utc']) <= datetime.datetime.fromisoformat(v['started_utc'])
            assert u['author'] == '/root' and u['I9_memory_test_runs'] is None
            assert u['known_I9_memory_test_runs'] == 4 and u['unknown_I9_memory_test_runs'] == 1
            assert u['spent_memory_scope_count'] == 5 and u['accepted_complete_memory_test_runs'] == 0
            for basename in ('ROOT_I9_MEMORY_SCOPE_CONSUMED','ROOT_I9_MEMORY_SUPERVISOR_CONSUMED'):
                mp = fact(P / f'{basename}_{suffix}.json'); assert mp in review_inputs
                m = obj(pin(mp)); assert m['scope'] == sp and m['automatic_retry_authorized'] is False
            assert len(v['streams']) == len(capture['streams']) == 2
            for stream,envelope in zip(v['streams'],capture['streams']):
                q = stream['actual_capture']; assert q in review_inputs and envelope['actual_capture'] == q
                assert q['bytes'] == 0 and pin(q) == b'' and envelope['UTF8_text'] == ''
                assert stream['overcap'] is False and stream['reader_error'] is None and envelope['complete'] is True
            attempts.append(dict(attempt_ordinal=5,I9_memory_test_runs=None,tests_executed=None,
                accepted_complete_run=False,all_cases_passed=None,scope=sp,result=None,supervisor=vp,
                streams_capture=capture_pin,actual_test_case_count=None,failed_or_last_case_at_failure=None,
                unknown_suite_status=True,unknown_timeout_Root_adoption=up))
            continue
'''
text=replace(text,anchor,unknown_branch+anchor)
text=replace(text,"    runs = sum(row['I9_memory_test_runs'] for row in attempts)\n    failed_runs = sum(row['I9_memory_test_runs'] for row in attempts[:-1])\n    assert runs == failed_runs + 1\n",
"    assert len(attempts) == 6 and attempts[4]['I9_memory_test_runs'] is None\n    runs = sum(row['I9_memory_test_runs'] for row in attempts if type(row['I9_memory_test_runs']) is int)\n    failed_runs = sum(row['I9_memory_test_runs'] for row in attempts[:-1] if type(row['I9_memory_test_runs']) is int)\n    assert runs == 5 and failed_runs == 4 and runs == failed_runs + 1\n")
text=replace(text,'actual_memory_cases_passed=count, actual_memory_cases_failed=0, I9_memory_test_runs=runs,',
    'actual_memory_cases_passed=count, actual_memory_cases_failed=0, I9_memory_test_runs=None,\n        known_I9_memory_test_runs=runs, unknown_I9_memory_test_runs=1, spent_memory_scope_count=6,')
