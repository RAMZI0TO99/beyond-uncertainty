"""Author metadata-only successors with one explicitly unknown saved timeout."""
import ast, datetime, hashlib, json, os, sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP=2097152

def fact(path):
    data=path.read_bytes(); assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def replace(text,old,new,count=1):
    assert text.count(old)==count,(old[:100],text.count(old),count)
    return text.replace(old,new)

def save(path,value):
    data=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(data)<=CAP
    with path.open('xb') as handle:
        handle.write(data); handle.flush(); os.fsync(handle.fileno())
    return fact(path)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
created=[]
original=P/'ROOT_ADOPT_I9_ACTUAL_SAVED_MEMORY_RESULTS_001.py'
text=original.read_text(encoding='utf-8')
anchor="        rp = fact(P / f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json')\n"
unknown_branch='''        if ordinal == 5:
            vp = fact(path); v = obj(pin(vp))
            capture_pin = fact(P / f'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_{suffix}.json')
