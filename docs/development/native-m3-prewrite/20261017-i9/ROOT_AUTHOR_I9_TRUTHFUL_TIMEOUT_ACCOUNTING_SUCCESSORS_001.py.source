    'actual_publication_admission=False, no_observed_forbidden_audit_events=None,\n        accepted_run_no_observed_forbidden_audit_events=True, timeout005_audit_status_unknown=True,')
new=P/'ROOT_ADOPT_I9_ACTUAL_SAVED_MEMORY_RESULTS_002.py'
ast.parse(text); compile(text,str(new),'exec')
created.append(dict(original_Source=fact(original),new_Source=save(new,text.encode())))

new_counts='''def validate_counts(a):
 for key in ('actual_memory_case_count','actual_memory_cases_passed','known_I9_memory_test_runs','unknown_I9_memory_test_runs','spent_memory_scope_count','failed_memory_test_runs','accepted_complete_memory_test_runs','accepted_attempt_ordinal'):
  assert type(a[key]) is int and a[key]>=0, key
 assert a['I9_memory_test_runs'] is None and a['unknown_I9_memory_test_runs']==1
 assert 1<=a['actual_memory_case_count']<=256 and a['actual_memory_cases_passed']==a['actual_memory_case_count']
 runs=a['known_I9_memory_test_runs'];failed=a['failed_memory_test_runs']
 assert runs==5 and failed==4 and a['accepted_complete_memory_test_runs']==1 and runs==failed+1
 attempts=a['all_saved_memory_attempts'];assert type(attempts) is list and len(attempts)==a['spent_memory_scope_count']==a['accepted_attempt_ordinal']==6
 for ordinal,row in enumerate(attempts,1):
  assert type(row) is dict and type(row['attempt_ordinal']) is int and row['attempt_ordinal']==ordinal
  assert type(row['accepted_complete_run']) is bool and row['accepted_complete_run'] is (ordinal==len(attempts))
  if ordinal==5:
   assert row['I9_memory_test_runs'] is None and row['tests_executed'] is None and row['result'] is None
   assert row['all_cases_passed'] is None and row['actual_test_case_count'] is None and row['unknown_suite_status'] is True
  else:
   assert type(row['I9_memory_test_runs']) is int and row['I9_memory_test_runs']==1
   assert row['tests_executed'] is True and type(row['all_cases_passed']) is bool
   assert row['all_cases_passed'] is (ordinal==6)
 assert sum(row['I9_memory_test_runs'] for row in attempts if type(row['I9_memory_test_runs']) is int)==runs
 return runs,failed
'''
for basename,newname in (('ROOT_PREPARE_I9_MANAGED_CANDIDATES_003.py','ROOT_PREPARE_I9_MANAGED_CANDIDATES_004.py'),('ROOT_REVIEWED_I9_FINITE_PUBLICATION_003.py','ROOT_REVIEWED_I9_FINITE_PUBLICATION_004.py')):
    original=P/basename; text=original.read_text(encoding='utf-8')
    node=next(n for n in ast.parse(text).body if isinstance(n,ast.FunctionDef) and n.name=='validate_counts')
    text=replace(text,ast.get_source_segment(text,node),new_counts.rstrip())
    if 'PREPARE' in basename:
        text=replace(text,'I9_memory_test_runs=runs,','I9_memory_test_runs=None, known_I9_memory_test_runs=runs, unknown_I9_memory_test_runs=1, spent_memory_scope_count=6,',2)
        text=replace(text,'There were {runs} separately scoped fixture invocation(s), including {failed_runs} saved failed attempt(s), with one accepted complete run.',
            'There were six separately scoped owned launches: four known failed suite entries, one 60-second timeout with unknown suite entry and progress, and one accepted complete run. Five suite entries are known; aggregate suite-entry count remains unknown.')
    else:
        text=replace(text,"type(implementation['I9_memory_test_runs']) is int and type(implementation['failed_memory_test_runs']) is int and implementation['I9_memory_test_runs']==implementation['failed_memory_test_runs']+1",
            "implementation['I9_memory_test_runs'] is None and implementation['known_I9_memory_test_runs']==5 and implementation['unknown_I9_memory_test_runs']==1 and type(implementation['failed_memory_test_runs']) is int and implementation['known_I9_memory_test_runs']==implementation['failed_memory_test_runs']+1")
        text=replace(text,"'I9_memory_test_runs':implementation['I9_memory_test_runs'],",
            "'I9_memory_test_runs':implementation['I9_memory_test_runs'],'known_I9_memory_test_runs':implementation['known_I9_memory_test_runs'],'unknown_I9_memory_test_runs':implementation['unknown_I9_memory_test_runs'],'spent_memory_scope_count':implementation['spent_memory_scope_count'],")
    new=P/newname; ast.parse(text); compile(text,str(new),'exec')
    created.append(dict(original_Source=fact(original),new_Source=save(new,text.encode())))
record=dict(schema_version=1,record_type='Root_I9_truthful_timeout_accounting_metadata_Source_author_receipt',
