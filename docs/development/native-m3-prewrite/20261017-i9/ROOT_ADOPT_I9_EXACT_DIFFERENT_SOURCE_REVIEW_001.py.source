"""Root exact protocol/initial-quartet Source adoption, never target execution."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
PROTOCOLS = {
    'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json': (122682, '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'),
    'ROOT_I9_PROTOCOL001_BOUNDED_AST_AND_AGGREGATE_READER_CLARIFICATION_001.json': (2514, '07b09a988e8d8328c2f5362e90a5bbc144eff6af7bc65fd5bf37d414d17783aa'),
    'ROOT_I9_PROTOCOL001_OPEN_PROOF_FLAGS_AND_CANONICAL_CODEC_CLARIFICATION_001.json': (2348, '483451d49c32be2a7d45ac4cb0d372890695f0b0c68951b7368e983ce8046e8f'),
}
TARGETS = ('validate_recorded_M3_semantics_001.py', 'test_recorded_M3_semantics_memory_only_001.py', 'CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_001.json', 'CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_001.json')

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and 0 < q['bytes'] <= CAP
    assert type(q['sha256']) is str and re.fullmatch('[0-9a-f]{64}', q['sha256'])
    data = raw(q['path'])
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def main():
    assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
    mode, expected_sha = sys.argv[1:]
    assert mode in ('protocol', 'source') and re.fullmatch('[0-9a-f]{64}', expected_sha)
    scope_pin = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
    assert scope_pin['sha256'] == '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
    scope = obj(pin(scope_pin))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end'])
    name = 'INDEPENDENT_I9_EXACT_PROTOCOL_SOURCE_CAPSULE_001.json' if mode == 'protocol' else 'INDEPENDENT_I9_INITIAL_IMPLEMENTATION_SOURCE_CAPSULE_001.json'
    capsule_pin = fact(P / 'independent_review_001' / name)
    assert capsule_pin['sha256'] == expected_sha
    capsule = obj(pin(capsule_pin)); full_pin = capsule['full_proof']; full = obj(pin(full_pin))
    reviewer_source = capsule['reviewer_Source']; pin(reviewer_source)
    for item in (capsule, full):
        assert item['reviewer'] == '/root/owner_source_review'
        assert type(item['checks_failed']) is int and item['checks_failed'] == 0
        assert item['target_execution'] is False and item['tests_executed'] is False
        assert item['verdict'].startswith(('PASS_', 'ACCEPT_'))
    assert capsule['verdict'] == full['verdict']
    checks = full['checks']
    assert type(checks) is list and checks and len({c['name'] for c in checks}) == len(checks)
    assert all(type(c['passed']) is bool and c['passed'] is True for c in checks)
    inputs = full['all_actual_inputs']
    assert type(inputs) is list and inputs and len({q['path'].casefold() for q in inputs}) == len(inputs)
    for q in inputs:
        pin(q)
    subjects = capsule['subjects']
    assert type(subjects) is list and subjects == full['subjects'] and reviewer_source in inputs
    for q in subjects:
        pin(q); assert q in inputs
    protocol_pins = []
    for filename, (size, digest) in PROTOCOLS.items():
        q = fact(P / filename)
        assert (q['bytes'], q['sha256']) == (size, digest) and q in inputs
        protocol_pins.append(q)
    if mode == 'protocol':
        assert capsule['source_author'] == '/root'
        assert len(subjects) == 3 and all(q in subjects for q in protocol_pins)
        assert all(not (P / 'i9' / name).exists() for name in TARGETS)
        verdict = 'ACCEPT_I9_COMPLETE_RECORDED_M3_SEMANTIC_PROTOCOL_SOURCE_ONLY'
        filename = 'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
        extra = dict(new_Source_API_fixture_authoring_authorized=True)
    else:
        assert capsule['source_author'] == '/root/phase_frontier'
        expected = [fact(P / 'i9' / name) for name in TARGETS]
        assert len(subjects) == 4 and all(q in subjects for q in expected)
        prior = fact(P / 'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json')
        assert prior in inputs
        verdict = 'ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY'
        filename = 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json'
        extra = dict(real_family_entry_unconditionally_held=True, fixture_invocation_requires_fresh_separate_one_use_Root_scope=True)
    result = dict(schema_version=1, record_type='Root_actual_I9_different_Source_review_adoption_' + mode, author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), scope=scope_pin, verdict=verdict, subjects=subjects, protocol_subjects=protocol_pins, different_Source_review=capsule_pin, full_proof=full_pin, reviewer_Source=reviewer_source, actual_named_checks=len(checks), actual_rehashed_input_count=len(inputs), all_actual_review_inputs_rehashed=True, target_execution=False, tests_executed=False, new_module_or_fixture_invocation_authorized_now=False, actual_family_Source_publication_authorized=False, all_actual_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False, **extra)
    data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode(); assert len(data) <= CAP
    output = P / filename
    with output.open('xb') as handle:
        handle.write(data); handle.flush(); os.fsync(handle.fileno())
    print(json.dumps(fact(output)))

if __name__ == '__main__':
    main()
