"""Prepare UNBOUND T007 for two unknowns and genuinely different monitoring proof."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
O=P/'managed_review_001'
CAP=2097152

def pin(path):
    data=path.read_bytes();assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def change(text,before,after):
    assert text.count(before)==1,before
    return text.replace(before,after)

MONITOR_CHECK='''        check("accepted instrumentation current overlay", fresh["instrumentation_protocol_Root_adoption"] == instrumentation_overlay["protocol_adoption_pin"] and fresh["unknown_timeout006_Root_adoption"] == instrumentation_overlay["unknown6_pin"] and fresh["actual_binding_receipt"] == instrumentation_overlay["receipt_pin"] and fresh["Source_adoption"] == source_pin and fresh["I9_memory_test_runs"] is None and fresh["known_I9_memory_test_runs"] == 4 and fresh["unknown_I9_memory_test_runs"] == 2 and fresh["spent_memory_scope_count"] == 6)
        check("accepted monitoring saved method and owned cleanup", r["monitoring_method"] == "Python3.13 exact compiled code identity entry/resume/throw events" and type(r["monitoring_tool_id"]) is int and r["monitoring_tool_id"] == 5 and r["monitoring_tool_claimed"] is True and r["monitoring_cleanup_verified"] is True and r["monitoring_cleanup_errors"] == [])
        check("monitor counts are explicitly different evidence", r["profile_evidence_boundary"] == "Target code entry/resume/throw events only; no measured numeric equivalence to historical sys.setprofile call counts.")
        monitor_events = r["monitoring_event_counts"]
        check("actual exact start/resume/throw counters", type(monitor_events) is dict and set(monitor_events) == {"PY_START", "PY_RESUME", "PY_THROW"} and all(type(n) is int and n >= 0 for n in monitor_events.values()) and type(r["monitoring_target_event_total"]) is int and 0 < r["monitoring_target_event_total"] <= 50000000 and sum(monitor_events.values()) == r["monitoring_target_event_total"] == sum(r["profile_call_counts"].values()))
        per_source = r["monitoring_function_counts_by_Source"]
        check("actual all-name counter subject set", type(per_source) is dict and set(per_source) == set(r["profile_call_counts"]) and all(type(names) is dict and all(type(name) is str and name and type(n) is int and n > 0 for name, n in names.items()) for names in per_source.values()))
        check("actual all-name/event cap joins", sum(sum(names.values()) for names in per_source.values()) == r["monitoring_target_event_total"] and per_source[adoption["module_Source"]["path"]] == r["new_module_function_call_counts"] and type(r["monitoring_unique_function_name_count"]) is int and r["monitoring_unique_function_name_count"] == sum(len(names) for names in per_source.values()) <= 4096 and type(r["monitoring_registered_code_identity_count"]) is int and r["monitoring_registered_code_identity_count"] > 0)
'''

def main():
    prior=O/'review_I9_managed_publication_TEMPLATE_006.py'
    assert pin(prior)['sha256']=='ca118aaa45bc38bd637ea4d6a5227547d0444fa67c5454359cf17c28008b71c0'
    fragment=O/'I9_TWO_UNKNOWN_AND_MONITORING_OVERLAY_SOURCE_FRAGMENT_001.py'
    text=prior.read_text(encoding='utf-8')
    start=text.index('def inspect_exact_unknown_timeout005(')
    end=text.index('\ndef inspect_actual_I9_Source_and_saved_results(',start)
    text=text[:start]+fragment.read_text(encoding='utf-8')+'\n'+text[end:]
    anchor='    for key in ("actual_memory_case_count", "actual_memory_cases_passed", "actual_memory_cases_failed",'
    extra='''    instrumentation_overlay = inspect_current_monitoring_overlay(bindings, source_pin, saved_inputs)
    unknown_root_adoptions = dict(source_refusal_lineage)
    unknown_root_adoptions[6] = instrumentation_overlay["unknown6_pin"]
'''
    text=change(text,anchor,extra+anchor)
    text=change(text,'        if ordinal == 5:\n','        if ordinal in (5, 6):\n')
    text=change(text,'unknown_runs += inspect_exact_unknown_timeout005(row, saved_inputs, source_refusal_lineage)',
        'unknown_runs += inspect_exact_unknown_timeouts(row, saved_inputs, unknown_root_adoptions)')
    text=change(text,'adoption["unknown_I9_memory_test_runs"] == unknown_runs == 1',
        'adoption["unknown_I9_memory_test_runs"] == unknown_runs == 2')
    text=change(text,'len(attempts) == adoption["accepted_attempt_ordinal"] == 6 and known_runs == 5',
        'len(attempts) == adoption["accepted_attempt_ordinal"] == 7 and known_runs == 5')
    text=change(text,'truthful current exact six-scope accounting','truthful current exact seven-scope accounting')
    text=change(text,'adoption["timeout005_audit_status_unknown"] is True and adoption["accepted_run_no_observed_forbidden_audit_events"] is True',
        'adoption["timeout005_audit_status_unknown"] is True and adoption["timeout006_audit_status_unknown"] is True and adoption["accepted_run_no_observed_forbidden_audit_events"] is True')
    text=change(text,'Source adoption preserves prior unknown timeout count','dated Source adoption preserves pre006 unknown timeout count')
    text=change(text,'"six separately scoped owned launches"','"seven separately scoped owned launches"')
    text=change(text,'"one 60-second timeout with unknown suite entry and progress"','"two 60-second timeouts with unknown suite entry and progress"')
    text=change(text,'actual["unknown_runs"] == 1 and actual["spent_scopes"]',
        'actual["unknown_runs"] == 2 and actual["spent_scopes"]')
    text=change(text,'"timeout005_audit_status_unknown": True,',
        '"timeout005_audit_status_unknown": True, "timeout006_audit_status_unknown": True,')
    text=change(text,'        check("accepted latest Source/API adoption joins",',MONITOR_CHECK+'        check("accepted latest Source/API adoption joins",')
    text=change(text,'"saved_review_inputs": len(saved_inputs), "required_truthful_report_phrases":',
        '"saved_review_inputs": len(saved_inputs), "instrumentation_binding_receipt": instrumentation_overlay["receipt_pin"], "instrumentation_protocol_Root_adoption": instrumentation_overlay["protocol_adoption_pin"], "unknown_timeout006_Root_adoption": instrumentation_overlay["unknown6_pin"], "required_truthful_report_phrases":')
    text=change(text,'"actual_saved_memory_review_input_count": actual["saved_review_inputs"],',
        '"actual_saved_memory_review_input_count": actual["saved_review_inputs"], "instrumentation_binding_receipt": actual["instrumentation_binding_receipt"], "instrumentation_protocol_Root_adoption": actual["instrumentation_protocol_Root_adoption"], "unknown_timeout006_Root_adoption": actual["unknown_timeout006_Root_adoption"], "self_authored_monitoring_Source_acceptance_delegated_to_genuinely_different_reviewer": True,')
    output=O/'review_I9_managed_publication_TEMPLATE_007.py'
    encoded=text.encode('utf-8')
    tree=ast.parse(encoded,filename=str(output));compile(tree,str(output),'exec')
    assignments=[n.value for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets)]
    assert len(assignments)==1 and isinstance(assignments[0],ast.Constant) and assignments[0].value is None
    assert 'inspect_exact_unknown_timeout005(' not in text
    # Different Source evidence is read/hashed as provenance, never self-approved.
    second=P/'ROOT_I9_SECOND_UNKNOWN_ACCOUNTING_SOURCE_AUTHOR_RECEIPT_001.json'
    second_pin=pin(second)
    assert second_pin['bytes']==3302 and second_pin['sha256']=='071a408d98ad57be251402b3147d8c63ffcf5c21483ce89c4696f3e19fa8693f'
    metadata=json.loads(second.read_bytes())
    inputs=[pin(prior),pin(fragment),pin(Path(__file__)),second_pin]
    for row in metadata['subjects']:
        q=row['new_Source'];assert pin(Path(q['path']))==q
        compile(ast.parse(Path(q['path']).read_bytes()),q['path'],'exec')
        inputs.append(q)
    for name,size,sha in (
        ('ROOT_I9_ATTEMPT006_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json',13618,'7c33bd55c0aa899636fee61af58f0afafbbe979d84fb9c85de5083d44880fc89'),
        ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_006.json',9147,'ab0e6174de0b0ab270976822ea407d8f9dc02a258de4390efd5720023b9fce2e'),
        ('ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_006.json',3563,'649b1bf8e76040f17c0edaf261b76fcfd838ff83f64888f394ae92a646d11fd2'),
        ('ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_006.json',2148,'cc93a06dc2eff2a840857299d546c01f68fe9944104d9fc8473b6de05883f593'),
        ('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_006.json',8399,'822d134d7e838c7b37fc54918f7d7c206bacc3bd5ff5e2bd1eb623c61e736c67')):
        q=pin(P/name);assert (q['bytes'],q['sha256'])==(size,sha);inputs.append(q)
    dated=json.loads((P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_006.json').read_bytes())
    assert dated['I9_memory_test_runs'] is None and dated['known_I9_memory_test_runs']==4 and dated['unknown_I9_memory_test_runs']==1 and dated['spent_memory_scope_count']==5
    with output.open('xb') as handle:handle.write(encoded)
    assert output.read_bytes()==encoded
    result=dict(schema_version=1,record_type='I9_TEMPLATE007_two_unknown_current_monitoring_overlay_preparation_only',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=inputs,reviewer_template=pin(output),literal_EXACT_ROOT_BINDINGS=None,
        Source_AST_compile_only=True,template_executed=False,Root_tool_execution=False,
        target_or_fixture_import_call_test=False,monitoring_API_activated=False,Git_commands_or_mutation=False,
        prior_TEMPLATE006_preserved=True,
        current_aggregate_fixture_invocations=None,current_known_fixture_invocations=4,
        current_unknown_fixture_status_attempts=2,current_spent_scopes=6,current_accepted_complete_runs=0,
        dated_Source_adoption006_aggregate=None,dated_Source_adoption006_known=4,
        dated_Source_adoption006_unknown=1,dated_Source_adoption006_spent=5,
        future_success_or_candidate_verdict_issued=False,
        added_binding_field='actual_current_instrumentation_binding_receipt (actual immutable receipt007 f3 only after birth)',
        compatibility=['Root actual results-adopter003/preparer005/publisher005/finite-adopter003 fields and report wording read.',
            'Only exact frozen unknown005 and006 may have null child result/tests/run/case, both rawstreams0 and cleanup observed.',
            'Do not rewrite dated Sourceadop006; current Root receipt/protocol/tool/fresh-adoption overlay supplies known4unknown2spent6.',
            'Conditional future accepted7 requires known5unknown2spent7/fail4accept1, all aggregate counts null.',
            'Accepted monitoring result must save exact method, tool5, cleanup true/no errors and entry/resume/throw/function totals/caps.',
            'Own instrumentation acceptance belongs genuinely different phase proof and actual Root adoption; only provenance/copy/readback here.'],
        final_actual_bound_inputs_still_required=True,operational_authority=False,scientific_authority=False)
    dest=O/'I9_PUBLICATION_REVIEW_TEMPLATE007_PREPARATORY_ACTUAL_RECEIPT_001.json'
    data=(json.dumps(result,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(data)<=CAP
    with dest.open('xb') as handle:handle.write(data)
    assert dest.read_bytes()==data
    for q in inputs:assert pin(Path(q['path']))==q
    print(json.dumps(dict(template=pin(output),receipt=pin(dest),author_Source=pin(Path(__file__))),indent=2))

if __name__=='__main__':main()
