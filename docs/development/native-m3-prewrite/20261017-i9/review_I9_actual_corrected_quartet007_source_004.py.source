    pin(row['new_Source'],'Root control'+str(j+1)+' actual Source');pin(row['original_Source'],'Root control'+str(j+1)+' preserved predecessor')
    a=raws[row['original_Source']['path']].decode('utf8');b=raws[row['new_Source']['path']].decode('utf8');at,bt=ast.parse(a),ast.parse(b)
    ad,bd=definitions(at),definitions(bt)
    check('Root control'+str(j+1)+': non-main guards byteexact',set(ad)==set(bd) and all(segment(a,ad[k])==segment(b,bd[k]) for k in ad if k!='main'))
    if j==0:
        expected=segment(a,ad['main']).replace('prior_actual_memory_refusal003_adoption=authority_inputs[15],',
            'prior_actual_memory_refusal003_adoption=authority_inputs[15],\n        prior_actual_memory_refusal004_adoption=authority_inputs[16],').replace('I9_memory_test_runs=3','I9_memory_test_runs=4').replace('SOURCE_REVIEW_ADOPTION_004.json','SOURCE_REVIEW_ADOPTION_005.json')
        check('Root control1: only required actual refusal4/history4/output5 main delta',expected==segment(b,bd['main']))
        ac=literals(bt);check('Root Source adopter006: exact uppercase refusal4 REQUIRED',ac['REQUIRED'][Path(failure_pin['path']).name]==failure_pin['sha256'])
    elif j==1:
        check('Root binder005: only attempt5 output names and binding fields change',a.replace('_004','_005').replace('attempt_numbers=[4]','attempt_numbers=[5]').replace('current_attempt_numbers=[4]','current_attempt_numbers=[5]')==b)
    else:
        expected=segment(a,ad['main']).replace('_004.json','_005.json').replace("s['attempt_number'] == 4","s['attempt_number'] == 5").replace('I9_memory_test_runs=3','I9_memory_test_runs=4')
        check('Root control3: only scope5/history4 metadata main delta',expected==segment(b,bd['main']))
prep_pin=fact(OWN/'INDEPENDENT_I9_QUARTET007_UNBOUND_SOURCE_REVIEW_PREPARATION_001.json');prep=obj(prep_pin['path']);pin(prep['reviewer_Source'],'preserved UNBOUND Source007 preparation')
check('preparation: unbound Source not cast as final verdict or invocation',prep['final_verdict'] is None and prep['target_execution'] is False and prep['tests_executed'] is False and prep['I9_fixture_reruns']==0)
own_history_pin=fact(OWN/'I9_QUARTET007_REVIEWER_OWN_AUDITOR_SOURCE_SYNTAX_HISTORY_001.json')
own_history=obj(own_history_pin['path']);pin(own_history['preserved_auditor_Source'],'reviewer own preserved syntax draft')
check('reviewer own tooling: syntax-only draft correction, no reviewed target or verdict',own_history['no_target_or_fixture_invoked'] is True and own_history['review_capsule_emitted'] is False)
own_history2_pin=fact(OWN/'I9_QUARTET007_REVIEWER_OWN_RECEIPT_FIELD_ASSERTION_HISTORY_001.json')
own_history2=obj(own_history2_pin['path']);pin(own_history2['preserved_auditor_Source'],'reviewer own preserved receipt-field draft')
check('reviewer own tooling: no invented receipt target field required',own_history2['no_target_or_fixture_invoked'] is True and own_history2['review_capsule_emitted'] is False)
source_pin=fact(__file__);created=datetime.datetime.now(datetime.timezone.utc).isoformat()
check('review: genuine actor distinct Root and all Source contributors',REVIEWER not in {'/root',AUTHOR,'/root/i9_fixture_author'})
check('review: reserve >60seconds in actual Source-only window',utc(window['interval_start'])<=utc(created) and utc(created)+datetime.timedelta(seconds=60)<utc(window['interval_end']))
check('review: final four actual subjects frozen',all(fact(q['path'])==q for q in subjects))
check('review: whole input roster sorted unique under Windows casefold',len(inputs)==len({k.casefold() for k in inputs}))
check('review: exact uppercase actual refusal004 authority in inputs',inputs[failure_pin['path']]==failure_pin)
failed=sum(q['passed'] is not True for q in checks);assert failed==0,json.dumps([q for q in checks if not q['passed']],ensure_ascii=True)
full=dict(schema_version=1,record_type='Independent_I9_actual_quartet007_Source_review',reviewer=REVIEWER,source_author=AUTHOR,created_utc=created,
    verdict=VERDICT,subjects=subjects,reviewer_Source=source_pin,checks=checks,checks_failed=0,checks_passed=len(checks),all_actual_inputs=[inputs[k] for k in sorted(inputs)],
    target_execution=False,tests_executed=False,I9_fixture_reruns=0,I9_target_calls_by_reviewer=0,I9_target_imports_by_reviewer=0,
    Source_index_equivalence_experiments=0,operational_authority=False,scientific_authority=False,
    actual_existing_I9_memory_test_runs=4,failed_actual_memory_test_runs=4,accepted_complete_memory_test_runs=0,actual_completed_case_prefixes=[0,0,0,1],
    current_module006_execution_count=0,current_fixture005_prior_Root_execution_count=2,planned_case_count=98,actual_correction_instruction=failure_pin,
    Source_inverse=inverse_pin,prior_genuine_review_rosters_rehashed=prior_rosters,metadata_path_spelling_observations=metadata_case_aliases,
    exact_carried_pin_literals=carry,
    Source_coverage='Whole module005-to006 reverse reconstruction. Constructor adds only exact authenticated carry7 cap installation before callbacks; only purpose two coverage lookups use a local typed-subset index. All other functions/classes/methods, original23 algorithms, generic and exact legacy proof guards, Reader.cap and callback/budget/birth paths, immutable view and actualentry hold remain byteexact. Fixture00598-case bytes unchanged.',
    equivalence_reason='For strict declared closed fact3 pins, the original predicate is existence of a nested dict containing matching builtin typed path,bytes,sha256 fields; extra keys are allowed. The new local index visits every dict/list child and records exactly those typed tuple values without validation or normalization. Case-sensitive set membership equals that occurrence relation. No target/index experiment or benchmark was performed.',
    history_boundary='Four actual failed runs remain consumed. Attempt004 has one passing templates5 prefix, not a complete accepted suite. Reused fixture005 was entered twice by Root; new module006/new pair are unrun. Source-author and reviewer calls remain0. Actual human/native/physical provenance, originalI0 dynamicbootstrap, I8owner/lease, producer/caller and actualpublication qualification remain external/unwired.',
    runtime_boundary='No target/fixture/renderer/builder/privatehelper/callback/oracle import/call/replay. No time, cap, resource or case relaxation and no measured performance gain. Empty historical external raw txt observations do not change positive component record pins.',
    actual_future_grants_lease_family_Native8_Parser_results=None,next_invocation_authorized=False)

def save(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');assert len(data)<=2097152
    with (OWN/name).open('xb') as h:h.write(data)
    return dict(path=str(OWN/name),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

fp=save('INDEPENDENT_I9_INITIAL_IMPLEMENTATION_FULL_SOURCE_PROOF_007.json',full)
