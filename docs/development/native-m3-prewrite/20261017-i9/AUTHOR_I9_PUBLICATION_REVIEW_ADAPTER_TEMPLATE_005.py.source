"""Minimal immutable Source-schema correction; never invoke the review template."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
O=P/'managed_review_001'
CAP=2097152

def pin(path):
    data=path.read_bytes()
    assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def replace(text,before,after):
    assert text.count(before)==1,before
    return text.replace(before,after)

def main():
    prior=O/'review_I9_managed_publication_TEMPLATE_002.py'
    assert pin(prior)['sha256']=='87feb87211d6deabdb010ac5dc645b83f41cfc71d866b7e5b67a93e4ed4da378'
    text=prior.read_text(encoding='utf-8')
    text=replace(text,
        'source_checks == sc["checks_passed"] and type(source["actual_rehashed_input_count"]) is int and source["actual_rehashed_input_count"] == len(source_inputs) == sc["actual_input_count"]',
        'source_checks == sc["checks_passed"] == sf["checks_passed"] and type(source["actual_rehashed_input_count"]) is int and source["actual_rehashed_input_count"] == len(source_inputs)')
    text=replace(text,
        'type(sc["actual_fixture_runs"]) is int and sc["actual_fixture_runs"] == 0 and type(sf["I9_fixture_reruns"]) is int and sf["I9_fixture_reruns"] == 0',
        'type(sc["I9_fixture_reruns"]) is int and sc["I9_fixture_reruns"] == 0 and type(sf["I9_fixture_reruns"]) is int and sf["I9_fixture_reruns"] == 0')
    text=replace(text,
        'source["actual_fixture_case_count"] == sc["planned_case_count"] == sf["planned_case_count"] == count and sf["planned_case_names"] == planned',
        'source["actual_fixture_case_count"] == sc["planned_case_count"] == sf["planned_case_count"] == count')
    text=replace(text,
        '"quartet002_cached_record_refusal_adoption"):',
        '"quartet002_cached_record_refusal_adoption", "prior_actual_memory_refusal_adoption", "prior_actual_memory_refusal002_adoption", "equivalent_surrogate_scan_correction", "prior_actual_memory_refusal003_adoption"):')
    text=replace(text,'for q in subjects:\n        pinned(q)',
        'for q in subjects:\n        check("positive Source subject stays below2MiB", type(q["bytes"]) is int and 0 < q["bytes"] <= CAP)\n        pinned(q)')
    text=replace(text,
        'pathlib.Path(pin["path"]).name not in ("ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_001.py", "ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_001.py", "ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_001.py", "ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_001.py")',
        'pathlib.Path(pin["path"]).parent != P / "memory_tooling_001" and not pathlib.Path(pin["path"]).name.startswith(("ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_", "ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_", "ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_", "ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_"))')
    output=O/'review_I9_managed_publication_TEMPLATE_003.py'
    encoded=text.encode('utf-8')
    tree=ast.parse(encoded,filename=str(output))
    compile(tree,str(output),'exec')
    binding=[n.value for n in tree.body if isinstance(n,ast.Assign) and
        any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets)]
    assert len(binding)==1 and isinstance(binding[0],ast.Constant) and binding[0].value is None
    assert 'UNBOUND_I9_PUBLICATION_TEMPLATE' in text
    # No invocation, final outcome, or count is inferred by this metadata author.
    quartet=[]
    for name,size,sha in (
        ('validate_recorded_M3_semantics_005.py',125799,'c04c96ace539a3e69bf51e5c8a365d0b45827156234a053712a52fb21f9417cc'),
        ('test_recorded_M3_semantics_memory_only_005.py',2042670,'efbc96a635050337d7d2b39b36679db08c6d2c2b6fa66620ac437dd507e8a1b8'),
        ('CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_006.json',50097,'296a3edc8fa6f71d3f632e2480d33d30fab55802d7cf590965a7f2df9e6b9e5e'),
        ('CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_006.json',33246,'9480e050a2f7662e00bedef7712708466636fbfe87db2d4b9baaf8090d39ae18')):
        q=pin(P/'i9'/name)
        assert q['bytes']==size and q['sha256']==sha
        quartet.append(q)
    api=json.loads(Path(quartet[2]['path']).read_bytes())
    literals={}
    for node in ast.parse(Path(quartet[1]['path']).read_bytes()).body:
        if isinstance(node,ast.Assign):
            for target in node.targets:
                if isinstance(target,ast.Name) and target.id in ('EXPECTED_CASE_COUNT','PLANNED_CASE_NAMES'):
                    assert target.id not in literals
                    literals[target.id]=ast.literal_eval(node.value)
    planned=literals['EXPECTED_CASE_COUNT']
    assert type(planned) is int and planned==api['fixture_interface']['expected_case_count']==98
    assert len(literals['PLANNED_CASE_NAMES'])==planned and list(literals['PLANNED_CASE_NAMES'])==api['fixture_interface']['planned_case_names']
    inputs=[pin(prior),pin(Path(__file__)),pin(O/'AUTHOR_I9_PUBLICATION_REVIEW_ADAPTER_TEMPLATE_003.py'),pin(O/'AUTHOR_I9_PUBLICATION_REVIEW_ADAPTER_TEMPLATE_004.py'),*quartet,
        pin(P/'ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_005.py'),
        pin(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_003.json')]
    historical=[]
    for ordinal in range(1,4):
        suffix=f'{ordinal:03d}'
        result_pin=pin(P/f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json')
        capture_pin=pin(P/f'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_{suffix}.json')
        inputs.extend((result_pin,capture_pin))
        result=json.loads(Path(result_pin['path']).read_bytes())
        capture=json.loads(Path(capture_pin['path']).read_bytes())
        assert type(result['I9_memory_test_runs']) is int and result['I9_memory_test_runs']==1
        assert result['tests_executed'] is True and type(result['actual_test_case_count']) is int and result['actual_test_case_count']==0 and result['all_cases_passed'] is False
        for role,row in zip(('STDOUT','STDERR'),capture['streams']):
            q=row['actual_capture']
            assert q['path']==str(P/f'ROOT_I9_ACTUAL_MEMORY_CHILD_{role}_{suffix}.txt')
            assert type(q['bytes']) is int and 0<=q['bytes']<=CAP and pin(Path(q['path']))==q
            assert row['UTF8_text'].encode()==Path(q['path']).read_bytes()
            inputs.append(q)
        historical.append(dict(ordinal=ordinal,result=result_pin,streams_capture=capture_pin,
            fixture_invocations=1,completed_cases=0,all_cases_passed=False,
            raw_stream_sizes=[r['actual_capture']['bytes'] for r in capture['streams']]))
    actual_source004_exists=(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_004.json').exists()
    actual_result004_exists=(P/'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_004.json').exists()
    if actual_source004_exists:
        inputs.append(pin(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_004.json'))
    with output.open('xb') as handle:
        handle.write(encoded)
    assert output.read_bytes()==encoded
    receipt=dict(schema_version=1,record_type='I9_minimal_unbound_publication_template_Source_schema_update',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=inputs,reviewer_template=pin(output),literal_EXACT_ROOT_BINDINGS=None,
        Source_AST_compile_only=True,template_executed=False,target_execution=False,
        tests_executed=False,Root_tool_execution=False,Git_commands_or_mutation=False,
        prior_TEMPLATE002_preserved=True,prior_metadata_author004_snapshot_refusal_preserved='Sourceadoption004 appeared concurrently before metadata author completed. No output Source was written on that refusal; author005 records actual existence without binding or accepting it.',prior_metadata_author003_failure_preserved='AttributeError in own AST-literal None assertion before any template/receipt write; corrected only that assertion in author004. No target execution.',
        changes=['Source capsule/full use I9_fixture_reruns0, not historical actual_fixture_runs.',
            'Source adoption supplies actual_rehashed_input_count; modern capsule has no actual_input_count.',
            'Modern Source full has planned_case_count only; names still strictly join literal/API/actual scope/outcome.',
            'Explicit final Source004 lineage includes three saved refusals and equivalent surrogate correction.',
            'Positive Source subjects remain capped at2MiB; zero-length historical streams keep exact nonnegative pins.',
            'Own-authored memory tools excluded from acceptance across all numbered versions.'],
        current_quartet=quartet,current_actual_planned_case_count=planned,
        fixture_bytes_below_2MiB=CAP-quartet[1]['bytes'],
        actual_prior_failed_attempts=historical,
        final_Source_adoption004_exists=actual_source004_exists,actual_attempt004_result_exists=actual_result004_exists,
        final_accepted_case_count=None,final_candidate_count=None,
        final_results_or_candidate_verdict_issued=False,
        pending='Bind only actual new Source adoption+different saved acceptance+Root implementation adoption+candidate scope. Review every actual ordinal1..K and retain all three current refusals. Future exact Source/saved schemas must be checked on actual birth.',
        operational_authority=False,scientific_authority=False)
    dest=O/'I9_PUBLICATION_REVIEW_TEMPLATE003_PREPARATORY_ACTUAL_RECEIPT_001.json'
    data=(json.dumps(receipt,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(data)<=CAP
    with dest.open('xb') as handle:
        handle.write(data)
    assert dest.read_bytes()==data
    for q in inputs:
        assert pin(Path(q['path']))==q
    print(json.dumps(dict(template=pin(output),receipt=pin(dest),author_Source=pin(Path(__file__))),indent=2))

if __name__=='__main__':
    main()
