report=dict(schema_version=1,record_type='I9_independent_fixture_Source_only_AST_and_compile_analysis',author='/root/i9_fixture_author',
 created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),source=fact(out),actual_inputs=inputs,
 planned_case_count=95,planned_case_names=names,imports=imports,top_level_functions=sum(isinstance(n,ast.FunctionDef) for n in tree.body),
 AST_parse_passed=True,compile_only_passed=True,fixture_module_or_function_executed=False,new_or_old_target_imported_or_called=False,
 original_or_native_or_Parser_or_project_tests_executed=False,filesystem_calls_inside_fixture_Source=0,
 actor_boundary='All current context actors and recorded births are explicit fictional2030 memory data; historical nominal BODY labels remain old byte data.',
 oracle_boundary='Own independent descending span splices, AST assignment-span data, closed JSON field recipes and unified diffs; no target renderer/helper called to generate expected bytes.',
 timeline='Historical recorded births derive literal created timestamps plus1us; no native/stat birth evidence collected. Synthetic current proof/input observations699 precede firstdraft700; later snapshots reuse exact first observations.',
 source_only_budget_notes=literal['FIXTURE_SOURCE_ONLY_BUDGET_BOUNDARY_NOTES'],
 retained_authoring_history=[dict(kind='metadata_literal_authoring_lookup_refusal',detail='First metadata embedder attempt found no projection digest row in old audit manifest. No output existed. Added exact fixed SOURCE_INPUTS_PROJECTION_006.json path and reran own metadata writer; no target or fixture code called.')],
 known_pending_before_invocation=['Root independent final quartet Source review and adoption','Module successor002 closes dynamic prelude/timestamp/stage observation stability findings; update only exact new error codes if needed before final pins','Fresh reviewed one-use supervisor scope; no invocation authorized by this report'],
 actual_new_grants_lease_family_paths_ordinals_purpose_Native8_Parser_results=None,target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
rp=OWN/'I9_INDEPENDENT_FIXTURE_SOURCE_ONLY_ANALYSIS_001.json'
