assert len(raw)<=2097152
tree=ast.parse(raw);compile(raw,'I9_independent_fixture_Source_only','exec')
literal={node.targets[0].id:ast.literal_eval(node.value) for node in tree.body if isinstance(node,ast.Assign) and isinstance(node.targets[0],ast.Name) and node.targets[0].id in ('PLANNED_CASE_NAMES','EXPECTED_CASE_COUNT','FIXTURE_SOURCE_ONLY_BUDGET_BOUNDARY_NOTES')}
names=literal['PLANNED_CASE_NAMES'];assert type(literal['EXPECTED_CASE_COUNT']) is int and literal['EXPECTED_CASE_COUNT']==len(names)==95 and len(set(names))==95
imports=[n.names[0].name for n in tree.body if isinstance(n,ast.Import)]
assert imports==['ast','base64','copy','datetime','difflib','hashlib','json','re','zlib']
for n in ast.walk(tree):
 if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in ('open','exec','eval','compile','__import__','getattr','setattr')
out=OWN/'test_recorded_M3_semantics_memory_only_INDEPENDENT_DRAFT_001.py'
with out.open('xb') as f:f.write(raw)
module=P/'i9/validate_recorded_M3_semantics_001.py'
assert fact(module)['sha256']=='d75d31c59be76332c625e17b3312284068706b0aac954512c4f8d8a9b0501ed1'
