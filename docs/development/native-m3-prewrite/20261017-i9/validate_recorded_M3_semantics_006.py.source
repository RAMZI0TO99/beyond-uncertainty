        _i9_need(expected == bound, 'actual canonical BOUND exactly two assignments from actual canonical TEMPLATE/current capture/bound peer')
        sources.append(dict(path=bound_pin['path'], sha256=bound_pin['sha256'], template_sha256=template_pin['sha256'], exact_two_literal_reversal=True))
    value.update(actual_script_sha256=deps['capture_bound'][0]['sha256'], bound_review_sha256=deps['metadata_bound_review'][0]['sha256'], sources=sources)
    return [_i9_json_artifact(_i9_engine, 'phase_binding', old_raw, value, {'actual_script_sha256', 'bound_review_sha256', 'sources'}, rows, dict(actual_four_canonical_two_assignment_reconstructions=True, native_Parser_executed=False))]

def _i9_required_dependencies(stage, role):
    if stage == 'templates':
        return set()
    if stage == 'manifest':
        return set(I9_TEMPLATE_ROLES) | {'profile'}
    if stage == 'capture':
        return {'capture_template', 'metadata_manifest', 'profile', 'static', 'metadata_peer'}
    if stage == 'phase_bound':
        return {role.replace('_bound', '_template'), 'capture_bound', 'metadata_binding', 'metadata_bound_review'}
    if stage == 'phase_binding':
        return set(I9_TEMPLATE_ROLES[1:]) | set(I9_PHASE_BOUND_ROLES) | {'capture_bound', 'metadata_binding', 'metadata_bound_review'}
    raise ValueError('unknown deferred metadata stage')



