def _i9_actor(value,allow_root=False):
    if allow_root and value=='/root':return value
    _i9_need(type(value) is str and len(value)<=512 and _i9_re.fullmatch(r'/root(?:/[A-Za-z0-9_-]+)+',value) is not None,'E_ACTOR')
    return value


def _i9_time(value,mode='current'):
    _i9_need(type(value) is str,'E_TIME')
    match=_i9_re.fullmatch(r'([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(?:\.([0-9]{6,7}))?(Z|[+-][0-9]{2}:[0-9]{2})',value)
    _i9_need(match is not None,'E_TIME')
    year,month,day,hour,minute,second=(int(x) for x in match.groups()[:6]);fraction=match[7] or '';zone=match[8]
    _i9_need(year>=1601 and hour<24 and minute<60 and second<60,'E_TIME')
    if mode=='current':_i9_need(len(fraction) in (6,7) and zone in ('Z','+00:00'),'E_TIME')
    if mode=='native7':_i9_need(len(fraction)==7 and zone=='+00:00','E_NATIVE7')
    try:ordinal=_i9_dt.date(year,month,day).toordinal()
    except ValueError as error:raise I9MetadataError('E_TIME') from error
    offset=0
    if zone!='Z':
        hours,minutes=int(zone[1:3]),int(zone[4:6]);_i9_need(hours<24 and minutes<60,'E_TIME')
        offset=(1 if zone[0]=='+' else -1)*(hours*3600+minutes*60)
    return ((ordinal-_i9_dt.date(1601,1,1).toordinal())*86400+hour*3600+minute*60+second-offset)*10000000+int(fraction.ljust(7,'0'))


def _i9_data_ast(data):
    _i9_need(type(data) in (str,bytes) and 0<len(data)<=2097152,'E_AST_BOUNDS')
    try:tree=_i9_ast.parse(data)
    except (SyntaxError,ValueError,RecursionError,UnicodeError) as error:raise I9MetadataError('E_AST_DATA') from error
    stack=[(tree,0)];count=0
    while stack:
        node,depth=stack.pop();count+=1
        _i9_need(count<=50000 and depth<=48,'E_AST_BOUNDS')
        stack.extend((x,depth+1) for x in _i9_ast.iter_child_nodes(node))
    return tree


def _i9_literal(value):
    try:return _i9_ast.literal_eval(value)
    except (ValueError,TypeError,SyntaxError,RecursionError) as error:raise I9MetadataError('E_AST_LITERAL') from error


def _i9_no_authority(value):
    _i9_need(value.get('target_execution') is False and value.get('operational_authority') is False,'E_AUTHORITY')
    for key in I9_OPTIONAL_FALSE_FLAGS:_i9_need(key not in value or value[key] is False,'E_AUTHORITY',key)


def _i9_pins(value):
    out=[]
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'}:out.append(_i9_pin(value))
        else:
            for k in sorted(value):out.extend(_i9_pins(value[k]))
    elif type(value) is list:
        for x in value:out.extend(_i9_pins(x))
    return out


class I9Reader:
    def __init__(self,trusted_bindings,read_record,expected_root_thread,source_editor,now_utc):
        self.trusted=_i9_snapshot(trusted_bindings);b=_i9_closed(self.trusted,I9_TRUSTED_KEYS,'E_BINDINGS')
        self.root_thread=expected_root_thread;self.source_editor=_i9_actor(source_editor);self.now=_i9_time(now_utc)
        _i9_need(type(expected_root_thread) is str and _i9_re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',expected_root_thread) is not None,'E_ROOT_THREAD')
        _i9_need(callable(read_record),'E_READER');self.external=read_record
        outputs=b['expected_output_paths'];_i9_need(type(outputs) is list and len(outputs)<=18 and outputs==sorted(outputs) and
          all(type(x) is str for x in outputs) and len(set(x.casefold() for x in outputs))==len(outputs),'E_OUTPUTS')
        self.outputs=frozenset(_i9_path(x).casefold() for x in outputs)
        roster=b['expected_inputs'];_i9_need(type(roster) is list and 0<len(roster)<=256,'E_READER_LIMIT')
        self.pins={};self.caps={};self.cache={};self.records={};self.calls=0;self.returned=0;self.observations={}
        for value in roster:
            p=_i9_pin(value);key=p['path'].casefold()
            _i9_need(key not in self.outputs,'E_FUTURE_OUTPUT_INPUT');_i9_need(key not in self.pins,'E_INPUT_ALIAS')
            self.pins[key]=p;self.caps[key]=2097152
        _i9_need([p['path'] for p in roster]==sorted(p['path'] for p in roster) and sum(p['bytes'] for p in roster)<=33554432,'E_READER_LIMIT')
        births=b['recorded_births_ns'];_i9_need(type(births) is dict and set(births)=={p['path'] for p in roster} and
          all(type(n) is int and n>0 for n in births.values()),'E_BIRTHS')
        self.births=births
        self.producer_editor=_i9_actor(b['producer_Source_editor'])
        authors=b['actual_content_authors'];_i9_need(type(authors) is list and len(authors)<=32 and len(set(authors))==len(authors),'E_AUTHORS')
        self.authors=[_i9_actor(x,allow_root=True) for x in authors]
        for key in ('current_owner_scope','canonical_lease','selection','M3_predecessor_inventory'):self.declare(b[key])
        _i9_need(_i9_same(b['M3_predecessor_inventory'],I9_INVENTORY_PIN),'E_INVENTORY17')
        self.support(b['producer_support'],I9_TOOL4)
        supports=b['stage_supports'];_i9_need(type(supports) is dict and 0<len(supports)<=8 and set(supports)<=I9_STAGE_KEYS,'E_STAGE_SUPPORTS')
        for support in supports.values():self.support(support,I9_STAGE3)
        # Fixed manifest carry roles are authenticated and capped before any body callback.
        for carry in I9_CARRIED_MANIFEST_INPUTS:
            key=carry['path'].casefold()
            if key in self.pins:
                _i9_need(_i9_same(self.pins[key],carry),'E_CARRIED_MANIFEST_PIN')
                self.cap(carry,65536)
        for path,cap in I9_KNOWN_ROLE_CAPS.items():
            if path.casefold() in self.pins:self.cap(self.pins[path.casefold()],cap)
        self.rows=None;self.inventory=None;self.selection=None;self.scope=None;self.lease=None;self.common_loaded=False
        self.stage_results={};self.recorded_time=None;self.current_stage=None;self.reviews={}
        self.common_generation_inputs={};self.generation_inputs=None
        self.generation_outputs=frozenset();self.generation_auxiliary=frozenset()

    def declare(self,value):
        p=_i9_pin(value);key=p['path'].casefold()
        _i9_need(key not in self.outputs,'E_FUTURE_OUTPUT_INPUT')
        _i9_need(key in self.pins and _i9_same(p,self.pins[key]),'E_UNDECLARED_INPUT')
        return p

    def cap(self,value,cap):
        p=self.declare(value);key=p['path'].casefold();_i9_pin(p,cap)
        old=self.caps[key];_i9_need(cap<=old,'E_CAP_WIDENING')
        _i9_need(cap==old or key not in self.cache,'E_ROLECAP_ORDER')
        self.caps[key]=cap
        return p

    def support(self,value,keys):
        _i9_closed(value,keys,'E_SUPPORT')
        return {k:self.declare(p) for k,p in value.items()}

    def body(self,value,cap=None):
        p=self.declare(value);key=p['path'].casefold()
        if self.generation_inputs is not None:
            _i9_need(p['path'] not in self.generation_outputs,'E_GENERATION_PRELUDE')
            if p['path'] not in self.generation_auxiliary:self.generation_inputs[p['path']]=dict(p)
        if cap is not None:
            _i9_need(type(cap) is int and 0<cap<=2097152,'E_PIN')
            if cap<self.caps[key]:self.cap(p,cap)
            _i9_need(p['bytes']<=min(cap,self.caps[key]),'E_PIN')
        bound=self.caps[key]
        if key not in self.cache:
            self.calls+=1;_i9_need(self.calls<=1024,'E_CALLBACK_LIMIT')
            try:raw=self.external(dict(p))
            except Exception as error:raise I9MetadataError('E_READER_REFUSAL') from error
            _i9_need(type(raw) is bytes,'E_READER_BYTES');self.returned+=len(raw)
            _i9_need(self.returned<=67108864,'E_CALLBACK_LIMIT')
            _i9_need(len(raw)==p['bytes'] and len(raw)<=bound and _i9_sha(raw)==p['sha256'],'E_HASH')
            self.cache[key]=raw
        return self.cache[key]

    def record(self,value):
        p=self.declare(value);key=p['path'].casefold()
        # Every semantic edge registers with its active stage even when JSON/bytes are cached.
        raw=self.body(p)
        if key not in self.records:
            self.records[key]=_i9_json(raw)
            self.creation(p,self.records[key])
        return self.records[key]

    def semantic(self,value,raw):
        p=self.declare(value);record=_i9_json(raw);self.creation(p,record)
        return record

    def birth(self,value):return self.births[self.declare(value)['path']]
    def born_ticks(self,value):return self.birth(value)//100+116444736000000000
    def creation(self,value,record):
        if 'created_utc' in record:
            created=_i9_time(record['created_utc'],'retained')
            _i9_need(created<=self.born_ticks(value)<=self.now,'E_CREATED_BIRTH')
            return created
        _i9_need(self.born_ticks(value)<=self.now,'E_CREATED_BIRTH')
        return None


def _i9_review(reader,pin,subjects,rejected=()):
    p=reader.declare(pin);v=reader.record(p);_i9_no_authority(v)
    who=_i9_actor(v.get('reviewer'));reject=['/root',reader.source_editor,reader.producer_editor,*reader.authors,*rejected]
    _i9_need(all(who!=a and (a=='/root' or not who.startswith(a+'/')) for a in reject),'E_REVIEWER')
    _i9_need(type(v.get('verdict')) is str and v['verdict'].startswith('PASS_') and type(v.get('checks_failed')) is int and v['checks_failed']==0 and
              all(_i9_occurs(v,x) for x in subjects),'E_REVIEW')
    fp=reader.declare(v.get('full_proof'));full=reader.record(fp);_i9_no_authority(full)
    checks=full.get('checks');_i9_need(type(checks) is list and 0<len(checks)<=10000,'E_FULL_PROOF')
    names=[]
    for c in checks:
        _i9_need(type(c) is dict and type(c.get('name')) is str and bool(c['name']) and c.get('passed') is True,'E_FULL_PROOF');names.append(c['name'])
    _i9_need(len(set(names))==len(names) and full.get('reviewer')==who and full.get('verdict')==v['verdict'] and
              type(full.get('checks_failed')) is int and full['checks_failed']==0 and all(_i9_occurs(full,x) for x in subjects),'E_FULL_PROOF')
    vt=reader.creation(p,v);ft=reader.creation(fp,full)
    _i9_need(ft is not None and vt is not None and ft<=vt<=reader.now and all(reader.born_ticks(x)<=vt for x in subjects),'E_REVIEW_TIME')
    return dict(pin=p,value=v,full_pin=fp,full=full,time=vt,full_time=ft)


def _i9_adoption(reader,pin,subjects,review,*,context=True,selection=False,verdict=None):
    p=reader.declare(pin);v=reader.record(p);_i9_no_authority(v)
    required=list(subjects)+[review['pin'],review['full_pin']]
    if context:required.append(reader.trusted['current_owner_scope'])
    if selection:required.append(reader.trusted['selection'])
    _i9_need(v.get('author')=='/root' and type(v.get('verdict')) is str and
              (v['verdict']==verdict if verdict is not None else v['verdict'].startswith('ACCEPT_')) and
              all(_i9_occurs(v,x) for x in required),'E_ADOPTION')
    at=reader.creation(p,v);_i9_need(at is not None and review['time']<=at<=reader.now and
              reader.born_ticks(review['pin'])<=at and reader.born_ticks(review['full_pin'])<=at,'E_ADOPTION_TIME')
    return dict(pin=p,value=v,time=at)


def _i9_read_pin(reader,pin,*,cap=2097152):return reader.body(pin,cap)
def _i9_recorded_utc(reader):
    _i9_need(type(reader.recorded_time) is str,'E_RECORDED_RENDER_TIME')
    return reader.recorded_time


# New I9 metadata predicates; author never invokes this fragment.
def _i9_original_wire(value):
    _i9_walk(value)
    raw=(_i9_json_module.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('utf8')
    _i9_need(0<len(raw)<=2097152,'E_METADATA_CAP')
    return raw


def _i9_different_review(reader,pin,subjects,rejected):
    checked=_i9_review(reader,pin,subjects,rejected)
    reader.reviews[checked['pin']['path']]=checked
    return checked['value']


def _i9_root_review_adoption(reader,pin,subjects,review_pin,review,*,selection=None,context_required=True):
    checked=reader.reviews.get(review_pin['path'])
    _i9_need(checked is not None and _i9_same(checked['value'],review),'E_REVIEW_BINDING')
    if selection is not None:_i9_need(_i9_same(selection,reader.trusted['selection']),'E_SELECTION_JOIN')
    return _i9_adoption(reader,pin,subjects,checked,context=context_required,selection=selection is not None)['value']


def _i9_fixed_legacy_code_adoption(reader,kind,pin,subjects,review):
    # Only two exact immutable saved metadata records; never inject a synthetic target field.
    _i9_need(kind in ('I0','I1'),'E_FIXED_ADOPTION_PIN')
    p=reader.declare(pin)
    _i9_need(_i9_same(p,I9_FIXED_CONTEXT[kind+'_Root_adoption']),'E_FIXED_ADOPTION_PIN')
    value=reader.record(p)
    abi={
      'I0':('Root_actual_I0_Source_review_adoption_and_finite_new_pure_fixture_launch',
        ('I1_or_original_entry_authorized','Native_Parser_runtime_science_authorized')),
      'I1':('Root_actual_I0_I1_Source_and_saved_new_I0_fixture_review_adoption',
        ('I1_executed','Native_Parser_or_original_tests_executed'))}[kind]
    _i9_need(type(value.get('schema_version')) is int and value['schema_version']==1 and value.get('record_type')==abi[0] and
      value.get('author')=='/root' and type(value.get('verdict')) is str and value['verdict'].startswith('ACCEPT_'),'E_FIXED_ADOPTION_ABI')
    for name in ('operational_authority','scientific_authority',*abi[1]):
        _i9_need(value.get(name) is False,'E_FIXED_ADOPTION_AUTHORITY',name)
    _i9_need('target_execution' not in value or value['target_execution'] is False,'E_FIXED_ADOPTION_AUTHORITY')
    for name in I9_OPTIONAL_FALSE_FLAGS:
        _i9_need(name not in value or value[name] is False,'E_FIXED_ADOPTION_AUTHORITY',name)
    _i9_need(all(_i9_occurs(value,q) for q in [*subjects,review['pin'],review['full_pin']]),'E_ADOPTION')
    at=reader.creation(p,value)
    _i9_need(at is not None and review['time']<=at<=reader.now and
      reader.born_ticks(review['pin'])<=at and reader.born_ticks(review['full_pin'])<=at,'E_ADOPTION_TIME')
    return dict(pin=p,value=value,time=at)


def _i9_fixed_legacy_code_review(reader,kind,pin,subjects,editor,fixed_full):
    # Exact immutable bundle is authenticated before this legacy-only dispatch.
    _i9_need(kind in ('I0','I1'),'E_FIXED_CODE_BUNDLE')
    expected_subjects=[I9_FIXED_CONTEXT[kind+'_Source'],I9_FIXED_CONTEXT[kind+'_API']]
    if kind=='I1':expected_subjects.append(I9_FIXED_CONTEXT['I1_native_entry'])
    actual_editor={'I0':'/root/checker_frontier','I1':'/root/phase_frontier'}[kind]
    _i9_need(_i9_same(subjects,expected_subjects) and editor==actual_editor and
      _i9_same(fixed_full,I9_FIXED_CONTEXT[kind+'_full_proof']),'E_FIXED_CODE_BUNDLE')
    p=reader.declare(pin)
    _i9_need(_i9_same(p,I9_FIXED_CONTEXT[kind+'_Source_review']),'E_FIXED_CODE_BUNDLE')
    v=reader.record(p);_i9_no_authority(v)
    abi={
      'I0':('independent_I0_pure_validator_implementation_actual_Source_review_capsule',
        'independent_I0_pure_validator_implementation_actual_full_Source_review',72,72),
      'I1':('independent_I1_Source003_and_I0_saved_fixture_review_capsule',
        'independent_I1_Source003_actual_static_and_I0_saved_fixture_full_review',199,189)}[kind]
    _i9_need(type(v.get('schema_version')) is int and v['schema_version']==1 and
      v.get('record_type')==abi[0] and v.get('source_author')==actual_editor and
      type(v.get('checks_performed')) is int and v['checks_performed']==abi[2],'E_FIXED_REVIEW_ABI')
    who=_i9_actor(v.get('reviewer'));reject=['/root',reader.source_editor,reader.producer_editor,*reader.authors,editor]
    _i9_need(all(who!=a and (a=='/root' or not who.startswith(a+'/')) for a in reject),'E_REVIEWER')
    _i9_need(type(v.get('verdict')) is str and v['verdict'].startswith('PASS_') and
      type(v.get('checks_failed')) is int and v['checks_failed']==0 and
      all(_i9_occurs(v,x) for x in subjects),'E_REVIEW')
    fp=reader.declare(v.get('full_proof'))
    _i9_need(_i9_same(fp,fixed_full) and _i9_same(fp,I9_FIXED_CONTEXT[kind+'_full_proof']),'E_CODE_FULL')
    full=reader.record(fp);_i9_no_authority(full)
    _i9_need(type(full.get('schema_version')) is int and full['schema_version']==1 and
      full.get('record_type')==abi[1] and full.get('source_author')==actual_editor and
      type(full.get('checks_performed')) is int and full['checks_performed']==abi[2],'E_FIXED_REVIEW_ABI')
    checks=full.get('checks');_i9_need(type(checks) is list and 0<len(checks)<=10000 and len(checks)==abi[2],'E_FULL_PROOF')
    names=[]
    for c in checks:
        _i9_need(type(c) is dict and type(c.get('name')) is str and bool(c['name']) and c.get('passed') is True,'E_FULL_PROOF');names.append(c['name'])
    # No row is removed, sorted or renamed; exact full-body hash retains original order.
    _i9_need(len(set(names))==abi[3] and full.get('reviewer')==who and full.get('verdict')==v['verdict'] and
      type(full.get('checks_failed')) is int and full['checks_failed']==0 and
      all(_i9_occurs(full,x) for x in subjects),'E_FULL_PROOF')
    vt=reader.creation(p,v);ft=reader.creation(fp,full)
    _i9_need(ft is not None and vt is not None and ft<=vt<=reader.now and
      all(reader.born_ticks(x)<=vt for x in subjects),'E_REVIEW_TIME')
    return dict(pin=p,value=v,full_pin=fp,full=full,time=vt,full_time=ft)


def _i9_code_support(reader,support,subjects,editor,*,fixed_full=None):
    reader.support(support,I9_TOOL4)
    kind=None
    if fixed_full is not None:
        matches=[]
        for candidate,actual_editor in (('I0','/root/checker_frontier'),('I1','/root/phase_frontier')):
            expected_support=dict(Source=I9_FIXED_CONTEXT[candidate+'_Source'],API=I9_FIXED_CONTEXT[candidate+'_API'],
              different_review=I9_FIXED_CONTEXT[candidate+'_Source_review'],Root_adoption=I9_FIXED_CONTEXT[candidate+'_Root_adoption'])
            expected_subjects=[I9_FIXED_CONTEXT[candidate+'_Source'],I9_FIXED_CONTEXT[candidate+'_API']]
            if candidate=='I1':expected_subjects.append(I9_FIXED_CONTEXT['I1_native_entry'])
            if _i9_same(support,expected_support) and _i9_same(subjects,expected_subjects) and editor==actual_editor and _i9_same(fixed_full,I9_FIXED_CONTEXT[candidate+'_full_proof']):
                matches.append(candidate)
        _i9_need(len(matches)==1,'E_FIXED_CODE_BUNDLE');kind=matches[0]
    reader.body(support['Source']);reader.record(support['API'])
    if kind is None:
        reviewed=_i9_review(reader,support['different_review'],subjects,[editor])
    else:
        reviewed=_i9_fixed_legacy_code_review(reader,kind,support['different_review'],subjects,editor,fixed_full)
    _i9_need('SOURCE' in reviewed['value']['verdict'].upper(),'E_CODE_REVIEW_VERDICT')
    if fixed_full is not None:_i9_need(_i9_same(reviewed['full_pin'],fixed_full),'E_CODE_FULL')
    if kind is None:
        adopted=_i9_adoption(reader,support['Root_adoption'],subjects,reviewed,context=False)
    else:
        adopted=_i9_fixed_legacy_code_adoption(reader,kind,support['Root_adoption'],subjects,reviewed)
    return reviewed,adopted


def _i9_historical_basis(reader):
    h=I9_HISTORICAL_SOURCE023_ARTIFACTS
    old=reader.record(h['gate']);request=reader.record(h['request']);peer_raw=reader.body(h['genuine_response']);peer=_i9_json(peer_raw)
    _i9_need(set(old)==set(I9_HISTORICAL_SOURCE023_GATE_KEYS) and set(request)==set(I9_HISTORICAL_REQUEST023_KEYS) and
      set(peer)==set(I9_HISTORICAL_PEER023_KEYS) and reader.body(h['retained_copy'])==peer_raw and
      old['record_type']==I9_HISTORICAL_SOURCE023_GATE_RECORD_TYPE and request['record_type']==I9_HISTORICAL_REQUEST023_RECORD_TYPE and
      peer['schema']==I9_HISTORICAL_PEER023_SCHEMA and peer['source_tools_only']==I9_HISTORICAL_PEER023_DESCRIPTOR,'E_HISTORICAL_BASIS')
    _i9_need(old['author']==request['author']=='/root' and old['genuine_peer_response'] is True and
      all(_i9_same(old[k],h[v]) for k,v in (('request','request'),('response','genuine_response'),('retained_copy','retained_copy'))) and
      _i9_same(peer['exact_request'],h['request']) and request['scope']==peer['scope']==old['scope'] and
      type(old['publication_reserve_seconds']) is int and old['publication_reserve_seconds']==60 and
      type(old['maximum_concurrent_subagents']) is int and old['maximum_concurrent_subagents']==5,'E_HISTORICAL_BASIS')
    for key in ('operational_authority','actual_entry006_authority','target_import_function_main_or_original_oracle_authority',
      'C8_or_tests_authority','science_or_native_recovery_authority','whole_host_quiet','push','lease_issued_or_extended'):
        _i9_need(old[key] is False,'E_HISTORICAL_AUTHORITY')
    for key in ('actual6_or_c8_or_original_target_admitted','peer_runtime_or_original_fixture_admitted','peer_results_or_reviews_accepted',
      'new_real_case_or_scientific_signature_granted','prospective_lease_issued_or_extended_by_this_response'):
        _i9_need(peer[key] is False,'E_HISTORICAL_AUTHORITY')
    gr=reader.record(h['different_review']);ga=reader.record(h['Root_adoption'])
    ir=reader.record(I9_INVENTORY_REVIEW);ia=reader.record(I9_INVENTORY_ADOPTION)
    for value,subjects in ((gr,[h['gate']]),(ir,[I9_INVENTORY_PIN])):
        _i9_no_authority(value)
        _i9_need(type(value.get('checks_failed')) is int and value['checks_failed']==0 and type(value.get('verdict')) is str and
          value['verdict'].startswith('PASS_') and all(_i9_occurs(value,p) for p in subjects),'E_HISTORICAL_REVIEW')
    _i9_need(gr['reviewer']=='/root/owner_docs_review' and gr['verdict']=='PASS_SOURCE023_GENUINE_ACTUAL_GATE_CONDITIONAL_METADATA_SOURCE_ONLY' and
      ir['reviewer'] not in ('/root','/root/m3_source_editor'),'E_HISTORICAL_REVIEW')
    for value,subjects in ((ga,[h['gate'],h['different_review']]),(ia,[I9_INVENTORY_PIN,I9_INVENTORY_REVIEW,h['gate']])):
        _i9_no_authority(value)
        _i9_need(value.get('author')=='/root' and type(value.get('verdict')) is str and value['verdict'].startswith('ACCEPT_') and
          all(_i9_occurs(value,p) for p in subjects),'E_HISTORICAL_ADOPTION')
    start,end=_i9_time(old['interval_start'],'retained'),_i9_time(old['interval_end'],'retained')
    times=[_i9_time(v['created_utc'],'retained') for v in (request,peer,old,gr,ga,ir,ia)]
    _i9_need(times==sorted(times) and times[-1]<end and start<=reader.born_ticks(I9_INVENTORY_PIN)<=times[-2] and
      reader.born_ticks(I9_INVENTORY_REVIEW)<=times[-1],'E_HISTORICAL_CHRONOLOGY')


def _i9_selection(reader):
    b=reader.trusted;pin=b['selection'];value=reader.record(pin)
    _i9_need(_i9_parent(pin['path'])==I9_ROOT_OWNED and not _i9_same(pin,I9_CURRENT_ROOT_SELECTION),'E_SELECTION_ROUTE')
    _i9_closed(value,I9_SELECTION13,'E_SELECTION13');_i9_no_authority(value)
    _i9_need(type(value['schema_version']) is int and value['schema_version']==2 and
      value['record_type']=='Root_owner_v2_actual_separate_future45_Source_path_selection' and value['author']=='/root' and
      _i9_same(reader.declare(value['current_owner_scope']),b['current_owner_scope']) and
      _i9_same(reader.declare(value['new_canonical_lease']),b['canonical_lease']) and
      _i9_same(reader.declare(value['current_selection']),I9_CURRENT_ROOT_SELECTION),'E_SELECTION13')
    old=reader.record(I9_CURRENT_ROOT_SELECTION)
    reader.body(reader.declare(value['current_complete45_inventory']))
    _i9_need(_i9_same(value['current_complete45_inventory'],I9_HISTORICAL45_PIN) and
      type(value['selected_Source_nonce']) is str and _i9_re.fullmatch('[0-9a-f]{32}',value['selected_Source_nonce']) is not None and
      value['selected_Source_nonce']==old['selected_Source_nonce'],'E_SELECTION_NONCE')
    rows=value['rows'];_i9_need(type(rows) is list and len(rows)==45,'E_SELECTION_ROWS')
    oldrows={r['role']:r for r in old['rows']};found={};can=set();drafts=set()
    for row in rows:
        _i9_closed(row,I9_ROW9,'E_ROW9');role=row['role']
        _i9_need(type(role) is str and role in oldrows and role not in found,'E_SELECTION_ROWS')
        cap=65536 if role=='composer' else I9_ROLE_SOURCE_CAPS[role]
        _i9_need(type(row['source_cap']) is int and row['source_cap']==cap,'E_ROLE_CAP')
        pred=reader.cap(row['predecessor'],cap);canonical=_i9_path(row['canonical_path'])
        _i9_need(canonical.startswith(I9_BASE+'\\') and canonical.casefold() not in can,'E_SELECTION_ALIAS');can.add(canonical.casefold())
        if canonical.casefold() in reader.pins:reader.cap(reader.pins[canonical.casefold()],cap)
        if role=='composer':
            _i9_need(_i9_same(row,oldrows[role]) and canonical==pred['path'] and row['must_change_Source_bytes'] is False and
              all(row[k] is None for k in ('draft_path','selected_ordinal','preparation_Source_author','retained_semantic_Source_author')),'E_COMPOSER')
        else:
            previous=oldrows[role]['selected_ordinal'];ordinal=row['selected_ordinal']
            _i9_need(type(previous) is int and type(ordinal) is int and previous<ordinal<1000 and
              row['must_change_Source_bytes'] is True and row['retained_semantic_Source_author']==oldrows[role]['retained_semantic_Source_author'],'E_SELECTION_SUCCESSOR')
            _i9_actor(row['preparation_Source_author'])
            if role in I9_M3_ROLES and role not in I9_PEER_ROLES:
                _i9_need(row['preparation_Source_author']==reader.producer_editor,'E_M3_EDITOR')
            leaf=_i9_leaf(oldrows[role]['canonical_path']);matches=[m for m in _i9_re.finditer(r'[0-9]{3}(?![0-9])',leaf) if int(m.group())==previous]
            _i9_need(len(matches)==1,'E_SELECTION_BASENAME');m=matches[0]
            expected=leaf[:m.start()]+str(ordinal).zfill(3)+leaf[m.end():];draft=_i9_path(row['draft_path'])
            _i9_need(_i9_leaf(canonical)==expected and _i9_parent(canonical)==_i9_parent(oldrows[role]['canonical_path'])==_i9_parent(pred['path']) and
              canonical.casefold()!=pred['path'].casefold() and _i9_leaf(draft)==expected and _i9_leaf(_i9_parent(draft))=='drafts' and
              draft.startswith(I9_SESSION+'\\generation\\') and draft.casefold() not in drafts,'E_SELECTION_BASENAME')
            drafts.add(draft.casefold())
            if draft.casefold() in reader.pins:reader.cap(reader.pins[draft.casefold()],cap)
            if role in I9_PHASE_ROLES:
                suffix='.TEMPLATE.ps1' if role.endswith('_template') else '.BOUND.ps1'
                _i9_need(ordinal>18 and expected.endswith(suffix),'E_PHASE_ORDINAL')
        found[role]=row
    _i9_need(set(found)==set(I9_ROLE_SOURCE_CAPS)|{'composer'} and len(drafts)==44,'E_SELECTION_ROWS')
    for group in I9_ORDINAL_GROUPS:_i9_need(len({found[r]['selected_ordinal'] for r in group})==1,'E_ORDINAL_COUPLING')
    launcher=found['launcher_template']['canonical_path']
    _i9_need(value['derived_launcher_runtime_path']==_i9_parent(launcher)+'\\'+_i9_leaf(launcher).replace('.TEMPLATE.ps1','.BOUND.ps1'),'E_LAUNCHER_RUNTIME')
    reader.rows=found;reader.selection=value
    return found


def _i9_inventory(reader):
    value=reader.record(I9_INVENTORY_PIN);rows=value.get('roles')
    _i9_need(type(rows) is list and len(rows)==17 and value.get('future_Source_bytes_generated') is False,'E_INVENTORY17')
    found={};basis=reader.record(I9_BASIS_PIN);br=basis.get('rows')
    _i9_need(type(br) is list and len(br)==17 and basis.get('future_Source_bytes_generated') is False and
      basis.get('future_successor_inverse_results') is None,'E_BASIS17')
    originals={}
    for row in br:
        _i9_closed(row,('complete_STEP077_predecessor','current_or_historical_basis','role','whole_current_bytes_base64','whole_predecessor_bytes_base64'),'E_BASIS17')
        role=row['role'];_i9_need(type(role) is str and role in I9_M3_ROLES and role not in originals,'E_BASIS17');originals[role]=row
    for row in rows:
        role=row.get('role');_i9_need(type(role) is str and role in I9_M3_ROLES and role not in found,'E_INVENTORY17')
        _i9_need(type(row.get('source_cap')) is int and row['source_cap']==I9_ROLE_SOURCE_CAPS[role],'E_ROLE_CAP')
        p=reader.cap(row['available_basis'],I9_ROLE_SOURCE_CAPS[role])
        _i9_need(_i9_same(p,reader.rows[role]['predecessor']),'E_M3_PREDECESSOR')
        body=reader.body(p);original=originals[role]
        if row.get('JSON_ABI') is not None:reader.semantic(p,body)
        _i9_need(_i9_same(original['current_or_historical_basis'],p),'E_BASIS17')
        for field,expected in (('whole_current_bytes_base64',p),('whole_predecessor_bytes_base64',_i9_pin(original['complete_STEP077_predecessor'],I9_ROLE_SOURCE_CAPS[role]))):
            text=original[field];_i9_need(type(text) is str and len(text)<=4*((I9_ROLE_SOURCE_CAPS[role]+2)//3),'E_BASE64_CAP')
            try:decoded=_i9_base64.b64decode(text,validate=True)
            except (ValueError,_i9_base64.binascii.Error) as error:raise I9MetadataError('E_BASE64') from error
            _i9_need(len(decoded)==expected['bytes'] and _i9_sha(decoded)==expected['sha256'] and
              (field!='whole_current_bytes_base64' or decoded==body),'E_BASIS_BYTES')
        slots=row.get('literal_slots');_i9_need(type(slots) is list,'E_LITERAL_SLOTS')
        for slot in slots:
            _i9_need(type(slot) is dict and type(slot.get('start_byte')) is int and type(slot.get('end_byte')) is int and
              0<=slot['start_byte']<slot['end_byte']<=len(body) and type(slot.get('raw_literal')) is str and
              body[slot['start_byte']:slot['end_byte']]==slot['raw_literal'].encode(),'E_LITERAL_SLOTS')
        found[role]=row
    _i9_need(set(found)==set(originals)==set(I9_M3_ROLES),'E_INVENTORY17');reader.inventory=found
    return found


def _i9_load_common(reader):
    if reader.common_loaded:return
    _i9_need(reader.generation_inputs is None,'E_GENERATION_PRELUDE')
    reader.generation_inputs={};reader.generation_outputs=frozenset();reader.generation_auxiliary=frozenset()
    try:
        b=reader.trusted;scope=reader.record(b['current_owner_scope']);_i9_no_authority(scope)
        _i9_need(scope.get('Root_thread')==reader.root_thread and
          _i9_time(scope['interval_start'])<=reader.now and _i9_time(scope['interval_end'])-reader.now>600000000,'E_SCOPE_TIME')
        reader.scope=scope
        leasepin=reader.cap(b['canonical_lease'],65536);lease=reader.record(leasepin);_i9_closed(lease,I9_LEASE12,'E_LEASE12')
        for k,v in I9_LEASE_FIXED.items():_i9_need(_i9_same(lease[k],v),'E_LEASE12')
        start,end=_i9_time(lease['created_utc'],'native7'),_i9_time(lease['lease_end_utc'],'native7')
        _i9_need(end-start==43200*10000000 and start<=reader.now and end-reader.now>1200*10000000,'E_LEASE_TIME');reader.lease=lease
        _i9_selection(reader);_i9_inventory(reader);_i9_historical_basis(reader)
        # All selected roles now have strict caps, before any speculative bootstrap scan.
        api=reader.record(b['producer_support']['API'])
        _i9_need(type(api.get('schema_version')) is int and api['schema_version']==2 and api.get('record_type')=='Root_owner_v2_M3_deferred_metadata_inert_API' and
          _i9_same(reader.declare(api.get('Source')),b['producer_support']['Source']) and
          api.get('actual_binding_Source_editor')==reader.producer_editor and api.get('author')==reader.producer_editor,'E_PRODUCER_API')
        _i9_no_authority(api)
        cr,ca=_i9_code_support(reader,b['producer_support'],[b['producer_support']['Source'],b['producer_support']['API']],reader.producer_editor)
        reader.code_adopted=ca['time'];reader.common_loaded=True
    finally:
        if reader.common_loaded:reader.common_generation_inputs=dict(reader.generation_inputs)
        reader.generation_inputs=None;reader.generation_outputs=frozenset();reader.generation_auxiliary=frozenset()

def _i9_bootstrap(reader,purpose_inputs):
    names={p['path']:reader.declare(p) for p in purpose_inputs}
    for p in I9_FIXED_CONTEXT.values():
        _i9_need(p['path'] in names and _i9_same(names[p['path']],p),'E_FIXED_CONTEXT');reader.body(p)
    for prefix,editor in (('I0','/root/checker_frontier'),('I1','/root/phase_frontier')):
        keys=[prefix+'_Source',prefix+'_API']+(['I1_native_entry'] if prefix=='I1' else [])
        subjects=[I9_FIXED_CONTEXT[k] for k in keys]
        support=dict(Source=I9_FIXED_CONTEXT[prefix+'_Source'],API=I9_FIXED_CONTEXT[prefix+'_API'],
          different_review=I9_FIXED_CONTEXT[prefix+'_Source_review'],Root_adoption=I9_FIXED_CONTEXT[prefix+'_Root_adoption'])
        _i9_code_support(reader,support,subjects,editor,fixed_full=I9_FIXED_CONTEXT[prefix+'_full_proof'])
    _i9_need(reader.record(I9_FIXED_CONTEXT['I0_Root_adoption']).get('I1_or_original_entry_authorized') is False and
      reader.record(I9_FIXED_CONTEXT['I1_Root_adoption']).get('I1_executed') is False,'E_FIXED_CONTEXT_AUTHORITY')
    candidates=[]
    for p in purpose_inputs:
        body=reader.body(p)
        if not body.lstrip(b' \t\r\n').startswith(b'{'):continue
        try:v=_i9_json(body)
        except ValueError:continue
        if set(v)==set(I9_OWNER3):candidates.append((p,v))
    _i9_need(len(candidates)==1,'E_OWNER_MANIFEST')
    manifest,m=candidates[0];reader.support(m,I9_OWNER3)
    _i9_need(_i9_same(m['current_owner_scope'],reader.trusted['current_owner_scope']),'E_OWNER_MANIFEST')
    required_json={p['path'] for p in m.values()}
    scope_record=reader.record(m['current_owner_scope'])
    owner_review=reader.record(m['different_current_owner_scope_Source_review'])
    mandatory=[reader.declare(scope_record[k]) for k in ('owner_instruction_record','owner_policy_record')]+[reader.declare(owner_review['full_proof'])]
    required_json.update(p['path'] for p in mandatory)
    visited=set();stack=list(m.values())+mandatory;records={}
    while stack:
        p=reader.declare(stack.pop());_i9_need(p['path'] in names and _i9_same(p,names[p['path']]),'E_BOOTSTRAP_CLOSURE')
        if p['path'] in visited:continue
        visited.add(p['path']);body=reader.body(p)
        if p['path'] in required_json:v=reader.record(p)
        else:
            if not body.lstrip(b' \t\r\n').startswith(b'{'):continue
            try:v=_i9_json(body)
            except ValueError:continue
            reader.creation(p,v)
        records[p['path']]=v;stack.extend(_i9_pins(v))
    scope=records[reader.trusted['current_owner_scope']['path']]
    for key in ('owner_instruction_record','owner_policy_record'):
        p=reader.declare(scope[key]);_i9_need(p['path'] in visited,'E_BOOTSTRAP_CLOSURE')
    scope_review=records[m['different_current_owner_scope_Source_review']['path']]
    _i9_need(reader.declare(scope_review['full_proof'])['path'] in visited,'E_BOOTSTRAP_CLOSURE')
    return manifest,visited


def _i9_codec(value):
    keys=('encoding','check_labels','checks','actual_serialized_check_count','checks_failed','ordered_check_stream_sha256','snapshot_phase')
    _i9_closed(value,keys,'E_CODEC')
    labels=value['check_labels'];rows=value['checks']
    _i9_need(value['encoding']=='lossless_boolean_label_index_v1' and type(labels) is list and bool(labels) and
      all(type(x) is str for x in labels) and len(set(labels))==len(labels) and type(rows) is list and bool(rows) and
      type(value['actual_serialized_check_count']) is int and value['actual_serialized_check_count']==len(rows) and
      type(value['checks_failed']) is int and value['checks_failed']==0 and
      value['snapshot_phase']=='before per-artifact receipt serialization; later writer gates execute separately','E_CODEC')
    stream=[];canonical_labels=[];indices={};canonical_rows=[]
    for row in rows:
        _i9_need(type(row) is list and len(row)==2 and row[0] is True and type(row[1]) is int and 0<=row[1]<len(labels),'E_CODEC')
        label=labels[row[1]];stream.append([True,label])
        if label not in indices:indices[label]=len(canonical_labels);canonical_labels.append(label)
        canonical_rows.append([True,indices[label]])
    _i9_need(canonical_labels==labels and _i9_same(canonical_rows,rows) and
      type(value['ordered_check_stream_sha256']) is str and value['ordered_check_stream_sha256']==_i9_sha(_i9_original_wire(stream)),'E_CODEC_CANONICAL')
    return len(stream)


def _i9_occurs(value, pin):
    if type(value) is dict:
        if all((key in value and type(value[key]) is type(pin[key]) and (value[key] == pin[key]) for key in pin)):
            return True
        return any((_i9_occurs(child, pin) for child in value.values()))
    return type(value) is list and any((_i9_occurs(child, pin) for child in value))

def _i9_stage_roles(stage, role):
    if stage == 'templates':
        return list(I9_TEMPLATE_ROLES)
    if stage == 'manifest':
        return ['metadata_manifest']
    if stage == 'capture':
        return ['plan', 'capture_bound', 'metadata_binding']
    if stage == 'phase_bound' and role in I9_PHASE_BOUND_ROLES:
        return [role]
    if stage == 'phase_binding':
        return ['phase_binding']
    raise ValueError('unknown exact M3 Source stage/role')

def _i9_assignments(data):
    return {node.targets[0].id: node for node in _i9_data_ast(data).body if isinstance(node, _i9_ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], _i9_ast.Name)}

def _i9_functions(data):
    return {node.name: _i9_ast.dump(node, include_attributes=False) for node in _i9_data_ast(data).body if isinstance(node, (_i9_ast.FunctionDef, _i9_ast.AsyncFunctionDef, _i9_ast.ClassDef))}

def _i9_protected_assignments(data):
    return {name: _i9_ast.dump(node, include_attributes=False) for name, node in _i9_assignments(data).items() if name not in I9_CAPTURE_SLOTS}

def _i9_splice_exact(raw, edits):
    _i9_need(type(raw) is bytes and type(edits) is list and bool(edits), 'finite actual nonempty Source span edits')
    edits = sorted(edits, key=lambda x: x['start_byte'])
    cursor, parts, proof, delta = (0, [], [], 0)
    for item in edits:
        _i9_need(set(item) == {'start_byte', 'end_byte', 'old', 'new'} and type(item['start_byte']) is int and (type(item['end_byte']) is int) and (cursor <= item['start_byte'] < item['end_byte'] <= len(raw)) and (type(item['old']) is str) and (type(item['new']) is str) and (raw[item['start_byte']:item['end_byte']] == item['old'].encode('utf8')), 'nonoverlapping exact old whole literal/assignment span')
        old, new = (item['old'].encode('utf8'), item['new'].encode('utf8'))
        start = item['start_byte'] + delta
        proof.append(dict(item, selected_start_byte=start, selected_end_byte=start + len(new)))
        parts.extend((raw[cursor:item['start_byte']], new))
        cursor = item['end_byte']
        delta += len(new) - len(old)
    parts.append(raw[cursor:])
    result = b''.join(parts)
    reverse = result
    for item in reversed(proof):
        start, end = (item['selected_start_byte'], item['selected_end_byte'])
        _i9_need(reverse[start:end] == item['new'].encode('utf8'), 'exact selected span for whole Source inverse')
        reverse = reverse[:start] + item['old'].encode('utf8') + reverse[end:]
    _i9_need(reverse == raw, 'entire complete Source byte inverse; all complement bytes untouched')
    return (result, proof)

def _i9_safe_relative(value):
    _i9_need(type(value) is str and _i9_re.fullmatch('[A-Za-z0-9_./-]+', value) is not None and (not value.startswith('/')) and all((x not in ('', '..', '.') for x in value.split('/'))), 'ordinary finite Root-chosen relative identity only; no code/numeric predicate replacement')
    return value

def _i9_template_identity(_i9_engine, role, old, inventory, rows, lease_pin, operational_choices):
    entry = inventory[role]
    slots = entry['literal_slots']
    edits = []
    _i9_need(entry['available_basis'] == rows[role]['predecessor'] and _i9_sha(old) == entry['available_basis']['sha256'], 'actual inventory binds complete current template Source')
    operational = {slot['value'] for slot in slots if slot['kind'] == 'separate_unselected_operational_path'}
    _i9_need(type(operational_choices) is dict and set(operational_choices) == operational, 'exact closed Root-chosen operational filename identities, never actual operational records')
    for slot in slots:
        old_literal = slot['raw_literal']
        value = slot['value']
        _i9_need(old[slot['start_byte']:slot['end_byte']] == old_literal.encode(), 'actual inventoried literal byte boundaries')
        if slot['kind'] == 'future_lease_leaf':
            selected = _i9_leaf(lease_pin['path'])
        elif slot['kind'] == 'selected_family_literal_reference':
            target = rows[slot['referenced_role']]['canonical_path']
            selected = _i9_relative(target, I9_BASE) if '/' in value else _i9_leaf(target)
        elif slot['kind'] == 'separate_unselected_operational_path':
            selected = operational_choices[value]
        else:
            raise ValueError('uninventoried literal transformation kind')
        _i9_safe_relative(selected)
        _i9_need(type(selected) is type(value), 'same original literal type')
        new_literal = repr(selected) if role == 'capture_template' else "'" + selected + "'"
        if selected != value:
            edits.append(dict(start_byte=slot['start_byte'], end_byte=slot['end_byte'], old=old_literal, new=new_literal))
    _i9_need(bool(edits), 'selected successor actually changes Source identity bytes')
    result, proof = _i9_splice_exact(old, edits)
    if role == 'capture_template':
        tree = _i9_data_ast(old)
        literals = {(n.lineno, n.col_offset, _i9_literal(n)) for n in _i9_ast.walk(tree) if isinstance(n, _i9_ast.Constant) and type(n.value) is str}
        _i9_need(bool(literals), 'actual Python Source literals parsed as data only')
        restored = result
        for item in reversed(proof):
            restored = restored[:item['selected_start_byte']] + item['old'].encode() + restored[item['selected_end_byte']:]
        _i9_need(_i9_functions(restored) == _i9_functions(old) and _i9_protected_assignments(restored) == _i9_protected_assignments(old), 'all original Python functions/guards/owner/timestamp assignments retained by exact identity inverse')
        nodes = _i9_assignments(result)
        _i9_need(all((_i9_literal(nodes[x].value) is None for x in I9_CAPTURE_SLOTS if x != 'BINDINGS')) and len(_i9_literal(nodes['BINDINGS'].value)) == 9 and all((x is None for x in _i9_literal(nodes['BINDINGS'].value).values())), 'capture six slots/nine binding cells remain unbound')
        _i9_data_ast(result)
    else:
        _i9_need(result.count(b'$BoundScriptSha256 = $null') == 1 and result.count(b'$BoundReviewSha256 = $null') == 1, 'two phase assignment slots remain original null; no Parser execution')
    return (result, proof)

def _i9_immutable_json(old, new, changed_keys):
    _i9_need(set(old) == set(new), 'original closed JSON ABI retained')
    _i9_need(all((old[key] == new[key] for key in old if key not in changed_keys)), 'all original JSON fields outside dependency cells retained')
    reverse = _i9_copy_module.deepcopy(new)
    for key in changed_keys:
        reverse[key] = _i9_copy_module.deepcopy(old[key])
    _i9_need(reverse == old, 'exact original decoded JSON reconstruction')

def _i9_json_artifact(_i9_engine, role, old_raw, value, fields, rows, proof):
    old = _i9_json(old_raw)
    _i9_need(_i9_original_wire(old) == old_raw, 'complete original JSON wire identity; no hidden formatting normalization')
    _i9_immutable_json(old, value, fields)
    restored = _i9_copy_module.deepcopy(value)
    for key in fields:
        restored[key] = _i9_copy_module.deepcopy(old[key])
    _i9_need(_i9_original_wire(restored) == old_raw, 'whole original JSON byte inverse')
    proof = dict(proof, changed_top_level_fields=sorted(fields), original_fields={key: old[key] for key in sorted(fields)}, complete_current_predecessor_byte_inverse=True)
    return _i9_pack(_i9_engine, role, _i9_original_wire(value), old_raw, rows[role]['predecessor'], rows, proof)

def _i9_capture_assignment_bind(template, values):
    _i9_need(set(values) == set(I9_CAPTURE_SLOTS), 'exact original six capture assignments')
    nodes = _i9_assignments(template)
    offsets = [0]
    for line in template.splitlines(keepends=True):
        offsets.append(offsets[-1] + len(line))
    edits = []
    for name in I9_CAPTURE_SLOTS:
        node = nodes[name]
        old_value = _i9_literal(node.value)
        _i9_need(name == 'BINDINGS' and type(old_value) is dict and (set(old_value) == I9_BINDING_KEYS) and all((x is None for x in old_value.values())) or (name != 'BINDINGS' and old_value is None), 'original capture template unbound slots retained before binding')
        start, end = (offsets[node.lineno - 1] + node.col_offset, offsets[node.end_lineno - 1] + node.end_col_offset)
        edits.append(dict(start_byte=start, end_byte=end, old=template[start:end].decode(), new=name + ' = ' + repr(values[name])))
    result, proof = _i9_splice_exact(template, edits)
    _i9_need(_i9_functions(result) == _i9_functions(template) and _i9_protected_assignments(result) == _i9_protected_assignments(template), 'all original capture functions/classes/guards/protected assignments exact outside six slots')
    _i9_data_ast(result)
    return (result, proof)

def _i9_old_bound_template_inverse(old_bound, old_template):
    b, t = (_i9_assignments(old_bound), _i9_assignments(old_template))
    bo, to = ([0], [0])
    for line in old_bound.splitlines(keepends=True):
        bo.append(bo[-1] + len(line))
    for line in old_template.splitlines(keepends=True):
        to.append(to[-1] + len(line))
    edits = []
    for name in I9_CAPTURE_SLOTS:
        bn, tn = (b[name], t[name])
        bs, be = (bo[bn.lineno - 1] + bn.col_offset, bo[bn.end_lineno - 1] + bn.end_col_offset)
        ts, te = (to[tn.lineno - 1] + tn.col_offset, to[tn.end_lineno - 1] + tn.end_col_offset)
        edits.append(dict(start_byte=bs, end_byte=be, old=old_bound[bs:be].decode(), new=old_template[ts:te].decode()))
    restored, proof = _i9_splice_exact(old_bound, edits)
    _i9_need(restored == old_template and _i9_functions(old_bound) == _i9_functions(old_template), 'actual whole predecessor BOUND six-assignment inverse to current predecessor TEMPLATE')
    return proof

def _i9_phase_assignment_bind(template, bound_sha, peer_sha):
    _i9_need(_i9_re.fullmatch('[a-f0-9]{64}', bound_sha) is not None and _i9_re.fullmatch('[a-f0-9]{64}', peer_sha) is not None, 'two real canonical dependency digests, never guessed future Source pins')
    edits = []
    for variable, digest in (('BoundScriptSha256', bound_sha), ('BoundReviewSha256', peer_sha)):
        old = '$' + variable + ' = $null'
        new = '$' + variable + " = '" + digest + "'"
        _i9_need(template.count(old.encode()) == 1, 'exact original single phase binding assignment')
        start = template.index(old.encode())
        edits.append(dict(start_byte=start, end_byte=start + len(old), old=old, new=new))
    return _i9_splice_exact(template, edits)

def _i9_phase_predecessor_inverse(old_bound, old_template):
    restored = old_bound
    for name in ('BoundScriptSha256', 'BoundReviewSha256'):
        pattern = b'^\\$' + name.encode() + b" = '[a-f0-9]{64}'$"
        matches = list(_i9_re.finditer(pattern, restored, _i9_re.M))
        _i9_need(len(matches) == 1, 'actual previous single digest-bound phase assignment')
        match = matches[0]
        restored = restored[:match.start()] + ('$' + name + ' = $null').encode() + restored[match.end():]
    _i9_need(restored == old_template, 'complete original phase BOUND two-literal predecessor inverse')
    return True

def _i9_pack(_i9_engine, role, raw, diff_basis_raw, diff_basis_pin, rows, proof):
    row = rows[role]
    _i9_need(role in I9_GENERATED_ROLES and role not in I9_PEER_ROLES and (type(raw) is bytes) and (0 < len(raw) <= row['source_cap']) and (_i9_sha(raw) != row['predecessor']['sha256']), 'finite changed selected Source only; no peer synthesis/cap relaxation')
    _i9_need(_i9_read_pin(_i9_engine, diff_basis_pin, cap=row['source_cap']) == diff_basis_raw, 'actual exact removed-byte diff basis, no false oldBOUND header claim')
    return dict(role=role, raw=raw, proof=proof, diff_basis=diff_basis_pin, diff_basis_raw=diff_basis_raw)

def _i9_validate_binding_supports(_i9_engine, facts, deps, rows, selection_pin):
    supports = facts['binding_supports']
    _i9_need(type(supports) is dict and set(supports) == I9_BINDING_KEYS, 'exact original nine binding-source proof rows')
    bindings = {}
    for key, support in supports.items():
        _i9_need(type(support) is dict and set(support) == {'source', 'different_review', 'Root_adoption'}, 'closed3 real binding Source/eligibility review/adoption')
        pin = _i9_pin(support['source'])
        _i9_read_pin(_i9_engine, pin)
        role = I9_RENEWED_BINDINGS.get(key)
        if role is not None:
            _i9_need(pin == deps[role][0], 'new profile/static/genuineM3 peer exact current canonical binding')
        else:
            _i9_need(pin['sha256'] == I9_CURRENT_PLAN_BINDINGS[key], 'six retained historical capsule/coordination Source bindings exact')
        review = _i9_different_review(_i9_engine, support['different_review'], [pin], ['/root'])
        _i9_root_review_adoption(_i9_engine, support['Root_adoption'], [pin], support['different_review'], review, selection=selection_pin)
        bindings[key] = pin['sha256']
    selections = facts['role_selections']
    _i9_need(type(selections) is dict and set(selections) == set(I9_CAPTURE_SLOTS[3:]) and (selections['UNIT_TERMINAL_RELATIVE'] == I9_CURRENT_PLAN_ROLE_SELECTIONS['UNIT_TERMINAL_RELATIVE']), 'exact original Unit006 terminal identity/three role selections; no operational publication')
    for name, key in (('COORDINATION_PEER_REPLY_RELATIVE', 'coordination_peer_reply_sha256'), ('COORDINATION_ROOT_RESPONSE_RELATIVE', 'coordination_root_response_sha256')):
        _i9_need(selections[name] == _i9_relative(supports[key]['source']['path'], I9_BASE), 'actual carried coordination paths as dated static Source only, not fresh runtime ACK')
    return (bindings, selections)

