    old_template = _i9_read_pin(_i9_engine, old_template_pin, cap=65536)
    _i9_phase_predecessor_inverse(old_bound, old_template)
    return [_i9_pack(_i9_engine, role, raw, template, template_pin, rows, dict(exact_two_assignment_steps=steps, original_bound_to_original_template_inverse=True, original_template=old_template_pin, new_actual_template=template_pin, complete_current_predecessor_byte_inverse=True, new_template_identity_inverse_authenticated_by_canonical_Source_review=True, native_Parser_executed=False, all_original_protected_Source_complement_exact=True))]

def _i9_render_phase_binding(_i9_engine, facts, inventory, rows, deps):
    _i9_validate_peer_metadata(_i9_engine, deps, inventory, rows)
    old_raw = _i9_read_pin(_i9_engine, rows['phase_binding']['predecessor'], cap=65536)
    old = _i9_json(old_raw)
