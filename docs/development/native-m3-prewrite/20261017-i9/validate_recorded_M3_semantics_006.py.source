    binding.update(template_sha256=template_pin['sha256'], actual_script_sha256=_i9_sha(bound), bindings=bindings, role_selections=selections)
    outputs.append(_i9_json_artifact(_i9_engine, 'metadata_binding', old_binding_raw, binding, {'template_sha256', 'actual_script_sha256', 'bindings', 'role_selections'}, rows, dict(exact_six_assignment_reversal=True)))
    return outputs

def _i9_render_phase_bound(_i9_engine, facts, inventory, rows, deps):
    _i9_validate_peer_metadata(_i9_engine, deps, inventory, rows)
    role = facts['role']
    template_role = role.replace('_bound', '_template')
    template_pin, template = deps[template_role]
    raw, steps = _i9_phase_assignment_bind(template, deps['capture_bound'][0]['sha256'], deps['metadata_bound_review'][0]['sha256'])
    old_bound = _i9_read_pin(_i9_engine, rows[role]['predecessor'], cap=65536)
