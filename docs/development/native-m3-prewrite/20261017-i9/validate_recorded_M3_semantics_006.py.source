def _i9_render_templates(_i9_engine, facts, inventory, rows, lease_pin):
    _i9_need(type(facts['operational_choices']) is dict and set(facts['operational_choices']) == set(I9_TEMPLATE_ROLES), 'five exact future Root template identity-choice maps')
