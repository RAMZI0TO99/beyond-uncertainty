def _i9_render_manifest(_i9_engine, facts, inventory, rows, deps):
    old_raw = _i9_read_pin(_i9_engine, rows['metadata_manifest']['predecessor'])
    old = _i9_json(old_raw)
    value = _i9_copy_module.deepcopy(old)
    _i9_need(set(old) == set(inventory['metadata_manifest']['JSON_ABI']['ordered_top_keys']) and len(old) == 23 and (old['payload_count'] == len(old['payloads']) == 12) and (old['active_source_count'] == 6), 'original closed23 manifest12/active6 retained')
    by_old = {_i9_leaf(inventory[role]['available_basis']['path']): role for role in I9_TEMPLATE_ROLES}
    changed, carried, observed = ([], [], [])
    for index, item in enumerate(value['payloads']):
        previous = _i9_copy_module.deepcopy(old['payloads'][index])
        role = by_old.get(item['path'])
