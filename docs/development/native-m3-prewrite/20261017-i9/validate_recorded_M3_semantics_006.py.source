    bound, steps = _i9_capture_assignment_bind(template, values)
    old_bound = _i9_read_pin(_i9_engine, rows['capture_bound']['predecessor'], cap=65536)
    old_template = _i9_read_pin(_i9_engine, inventory['capture_template']['available_basis'], cap=65536)
    predecessor_inverse = _i9_old_bound_template_inverse(old_bound, old_template)
    outputs = [_i9_json_artifact(_i9_engine, 'plan', old_raw, plan, {'bindings', 'role_selections', 'lease_selection'}, rows, dict(exact_nine_actual_source_bindings=True, old_six_carried_Source_SHA_preserved=True)), _i9_pack(_i9_engine, 'capture_bound', bound, template, template_pin, rows, dict(six_assignment_steps=steps, original_bound_to_original_template_steps=predecessor_inverse, current_original_template=inventory['capture_template']['available_basis'], new_actual_template=template_pin, complete_current_predecessor_byte_inverse=True, new_template_identity_inverse_authenticated_by_canonical_Source_review=True, original_functions_classes_globals_exact=True))]
    old_binding_raw = _i9_read_pin(_i9_engine, rows['metadata_binding']['predecessor'], cap=65536)
    old_binding = _i9_json(old_binding_raw)
