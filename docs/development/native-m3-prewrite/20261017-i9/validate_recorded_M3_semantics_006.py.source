    _i9_need(len(old) == 7 and old['binder'] == '/root' and (old['actual_authorization'] is None) and (old['prepared_source_actions_executed'] is False) and (len(old['sources']) == 4), 'original closed7 phase binding/no prepared action/authorization')
    for template_role in I9_TEMPLATE_ROLES[1:]:
        role = template_role.replace('_template', '_bound')
