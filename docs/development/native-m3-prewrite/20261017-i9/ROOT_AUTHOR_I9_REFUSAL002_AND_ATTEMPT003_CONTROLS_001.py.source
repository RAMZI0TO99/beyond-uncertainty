"""Author metadata-only refusal002 adopter or fresh third-attempt controls."""
import ast, datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
FAILURE_NAME = 'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json'

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def save(path, value):
    data = value if type(value) is bytes else (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(data) <= CAP
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)

def replace(text, before, after, count=1):
    assert text.count(before) == count, (before, text.count(before), count)
    return text.replace(before, after)

def source(old_name, new_name, transform):
    original = fact(P / old_name)
    data = transform(raw(P / old_name).decode()).encode()
    ast.parse(data)
    compile(data, str(P / new_name), 'exec')
    return dict(original_Source=original, new_Source=save(P / new_name, data))

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv) >= 2
mode = sys.argv[1]
created = []
if mode == 'refusal-source':
    assert len(sys.argv) == 2
    def transform(text):
        for before, after in (
            ('saved_refusal_review_001/INDEPENDENT_I9_ATTEMPT001_SAVED_REFUSAL_CAPSULE_001.json', 'saved_refusal_review_002/INDEPENDENT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_CAPSULE_001.json'),
            ('834adafacab3524db889b8ba4a8326992645f9bac0045a8a3dd2cb7634f72a09', '20b78181fe49a1bac92baf57dd206292d59e9bcc3f9c9a7c209e178a57745b97'),
            ('PASS_I9_ATTEMPT001_SAVED_REFUSAL_AND_FIXTURE_SELECTION_ROUTE_CAUSE_SOURCE_ONLY', 'PASS_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_NO_RERUN'),
            ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_001.json', 'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_002.json'),
            ('ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_001.json', 'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_002.json'),
            ('ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_001.json', 'ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_002.json'),
            ('ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_001.json', 'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_002.json'),
            ("assert f['Source_cause']['module_guard_preserved'] is True", "assert f['Source_cause']['classification'] == 'implementation_incompatible_fixed_historical_Source_adoption_authority_predicate'\nassert len(f['Source_cause']['immutable_legacy_adoptions']) == 2"),
            ('Root_actual_I9_attempt001_saved_refusal_and_fixture_route_correction_adoption', 'Root_actual_I9_attempt002_saved_refusal_and_fixed_adoption_compatibility_adoption'),
            ('ACCEPT_I9_ATTEMPT001_SAVED_REFUSAL_AND_FIXTURE_SELECTION_ROUTE_CORRECTION_ONLY', 'ACCEPT_I9_ATTEMPT002_SAVED_REFUSAL_AND_EXACT_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ONLY'),
            ('I9_memory_test_runs=1, failed_memory_test_runs=1', 'I9_memory_test_runs=2, failed_memory_test_runs=2'),
            ('module003_guard_and_Source_bytes_must_remain_unchanged=True', 'generic_current_adoption_and_authority_guard_bodies_must_remain_byte_exact=True'),
            ('fixture004_API004_receipt004_Source_authoring_authorized=True', 'fixed_pin_only_legacy_module_API_receipt_and_regression_Source_successors_authorized=True'),
            ('prior_scope001_consumed_forever_and_all_evidence_preserved=True', 'prior_scopes001_and002_consumed_forever_and_all_evidence_preserved=True'),
            ('next_invocation_requires_new_bound_tools_and_separately_fresh_reviewed_scope002=True', 'next_invocation_requires_new_bound_tools_and_separately_fresh_reviewed_scope003=True'),
            ('ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json', FAILURE_NAME),
        ):
            text = replace(text, before, after)
        text = text.replace('E_SELECTION_ROUTE', 'E_AUTHORITY').replace('768749000', '4347512800')
        text = re.sub(r'\b741\b', '1962', text)
        text = re.sub(r'\b205\b', '251', text)
        anchor = "    actual_error='E_AUTHORITY', Source_cause=f['Source_cause'],\n"
        text = replace(text, anchor, anchor + "    exact_correction='Use compatibility only for fixed_full plus an exact immutable I0/I1 support4/subject/editor/full bundle. Require its actual typed historical entry/native false flags, OP/science false, Root ACCEPT, complete subject/capsule/full coverage and chronology; optional target_execution false when present. Mismatched fixed context refuses. Keep generic current guard bodies byte-exact. Add the 97th full-public current-producer missing-target field refusal with exact E_AUTHORITY.',\n")
        return text
    created.append(source('ROOT_ADOPT_I9_ATTEMPT001_SAVED_REFUSAL_001.py', 'ROOT_ADOPT_I9_ATTEMPT002_SAVED_REFUSAL_001.py', transform))
else:
    assert mode == 'controls' and len(sys.argv) == 3 and re.fullmatch('[0-9a-f]{64}', sys.argv[2])
    failure = fact(P / FAILURE_NAME)
    assert failure['sha256'] == sys.argv[2]
    r = json.loads(raw(failure['path']))
    assert r['I9_memory_test_runs'] == 2 and r['failed_memory_test_runs'] == 2 and r['actual_completed_case_count'] == 0
    for old_name in ('ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_002.py', 'ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_002.py', 'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_002.py'):
        def transform(text, old_name=old_name):
            if old_name.startswith('ROOT_ADOPT_I9_FINAL'):
                anchor = "    'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json': 'b8c5e65fe9f3f72ce6fda9299ce6d97a749ccccb8f98da308775efe3354a90ff',\n"
                text = replace(text, anchor, anchor + "    '" + FAILURE_NAME + "': '" + failure['sha256'] + "',\n")
                anchor = '        prior_actual_memory_refusal_adoption=authority_inputs[12],\n'
                text = replace(text, anchor, anchor + '        prior_actual_memory_refusal002_adoption=authority_inputs[13],\n')
                text = replace(text, 'I9_memory_test_runs=1', 'I9_memory_test_runs=2')
                text = replace(text, 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json', 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_003.json')
            elif old_name.startswith('ROOT_BIND'):
                for base, suffix in (('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION', 'json'), ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS', 'json'), ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT', 'json'), ('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES', 'py'), ('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES', 'py'), ('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE', 'py'), ('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS', 'py')):
                    text = replace(text, base + '_002.' + suffix, base + '_003.' + suffix)
                text = replace(text, 'attempt_numbers=[2]', 'attempt_numbers=[3]', 2)
            else:
                for base, count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS', 1), ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT', 1), ('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION', 2), ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE', 1), ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION', 1)):
                    text = replace(text, base + '_002.json', base + '_003.json', count)
                text = replace(text, "s['attempt_number'] == 2", "s['attempt_number'] == 3")
                text = replace(text, 'I9_memory_test_runs=1', 'I9_memory_test_runs=2')
            return text
        created.append(source(old_name, old_name.replace('_002.py', '_003.py'), transform))
receipt = dict(schema_version=1, record_type='Root_I9_refusal002_or_third_attempt_metadata_Source_author_receipt',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), mode=mode,
    subjects=created, I9_memory_test_runs=2, actual_completed_cases=0,
    all_prior_Sources_scopes_and_failures_preserved=True, authored_Sources_invoked=False,
    target_execution=False, tests_executed=False, automatic_retry_authorized=False,
    operational_authority=False, scientific_authority=False)
name = 'ROOT_I9_REFUSAL002_METADATA_ADOPTER_SOURCE_AUTHOR_RECEIPT_001.json' if mode == 'refusal-source' else 'ROOT_I9_THIRD_ATTEMPT_METADATA_TOOL_SOURCE_AUTHOR_RECEIPT_001.json'
print(json.dumps(save(P / name, receipt)))
