"""Record inherited open-proof optional flags and exact canonical codec rules."""
import datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data = path.read_bytes(); assert len(data) <= 2097152
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
protocol = fact(P / 'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json')
assert protocol['sha256'] == '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'
scope = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(json.loads(Path(scope['path']).read_bytes())['interval_end'])
x = dict(schema_version=1, record_type='Root_I9_protocol001_open_proof_optional_flags_and_canonical_codec_clarification', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), protocol=protocol, scope=scope,
    open_proof_flags='Retain the actual I2/I6 OPEN capsule/full proof ABIs and their actual mandatory target/operational checks. Known native/original/fixture/scientific authority fields rejected by original no_authority must be builtin False IF PRESENT. The generic protocol phrase false native flags does not add missing required fields, a fixed record_type/schema_version, closed keyset or arbitrary full-proof identity. Apply original explicit predicates and exclusions; identify any separately stated new strengthening as such.',
    canonical_codec='Reconstruct ordered [True,label] rows from the declared lossless_boolean_label_index_v1 codec and independently checked semantic predicates. Then re-run the exact pure frozen_check_codec first-occurrence algorithm over that ordered stream: append each distinct string label on first encounter and record its canonical index for every row. Require the resulting ordered label table and index sequence to exactly equal the supplied closed7 codec, with exact builtin counts and wire SHA. Reject unused labels, duplicate labels, equivalent noncanonical label permutations/reindexing, malformed/non-builtin booleans and false rows. This is logical saved-record consistency only; it does not authenticate or re-execute historical physical checks.',
    new_public_or_carrier_ABI=False, budget_relaxation=False, new_target_Source_authoring_authority=False, target_execution=False, tests_executed=False, new_actual_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(x, sort_keys=True, indent=2, allow_nan=False) + '\n').encode(); assert len(data) <= 2097152
output = P / 'ROOT_I9_PROTOCOL001_OPEN_PROOF_FLAGS_AND_CANONICAL_CODEC_CLARIFICATION_001.json'
with output.open('xb') as handle:
    handle.write(data); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(fact(output)))
