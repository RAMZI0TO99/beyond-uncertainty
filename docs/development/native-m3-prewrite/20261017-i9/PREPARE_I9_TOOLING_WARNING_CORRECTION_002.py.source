"""Create immutable template-author successor correcting one regex literal warning."""
import ast
import hashlib
from pathlib import Path

P = Path(__file__).parent
old = P/'AUTHOR_I9_MEMORY_TOOLING_TEMPLATES_001.py'
data = old.read_bytes()
text = data.decode('utf-8')
before = "re.fullmatch('[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*', name)"
after = "re.fullmatch(r'[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*', name)"
assert text.count(before) == 1
text = text.replace(before, after)
text = text.replace('_TEMPLATE_001.py', '_TEMPLATE_002.py')
text = text.replace('I9_MEMORY_TOOLING_TEMPLATE_SOURCE_AUTHOR_RECEIPT_001.json',
                    'I9_MEMORY_TOOLING_TEMPLATE_SOURCE_AUTHOR_RECEIPT_002.json')
text = text.replace("OLD/'ROOT_CAPTURE_I8_ACTUAL_MEMORY_STREAMS_003.py', Path(__file__)]",
    "OLD/'ROOT_CAPTURE_I8_ACTUAL_MEMORY_STREAMS_003.py', Path(__file__), OUT/'AUTHOR_I9_MEMORY_TOOLING_TEMPLATES_001.py', OUT/'PREPARE_I9_TOOLING_WARNING_CORRECTION_002.py', PHASE/'ROOT_I9_PROTOCOL001_BOUNDED_AST_AND_AGGREGATE_READER_CLARIFICATION_001.json']")
text = text.replace("template_execution_authorized=False,all_templates_UNBOUND=True,",
    "template_execution_authorized=False,all_templates_UNBOUND=True,prior001_Source_preserved=True,correction='Only add raw regex string prefix to avoid invalid escape SyntaxWarning; no execution-boundary change.',")
destination = P/'AUTHOR_I9_MEMORY_TOOLING_TEMPLATES_002.py'
encoded = text.encode('utf-8')
compile(ast.parse(encoded), str(destination), 'exec')
with destination.open('xb') as handle:
    handle.write(encoded)
print(destination, len(encoded), hashlib.sha256(encoded).hexdigest())
