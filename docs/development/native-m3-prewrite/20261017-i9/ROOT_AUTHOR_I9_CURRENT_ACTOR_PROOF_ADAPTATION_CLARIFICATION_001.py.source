"""Clarify actual actor proofs versus retained historical peer-body labels."""
import ast, datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data = path.read_bytes(); assert len(data) <= 2097152
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
adoption = fact(P / 'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json')
assert adoption['sha256'] == 'f2447b86e8178a59f94e5fd4d75866d27ba83f994bc5f9d60ca5b9a5599bcc0f'
discovery = json.loads((P / 'discovery_author_001/I9_COMPLETE_M3_PRODUCER_SEMANTIC_AND_PURE_BOUNDARY_DISCOVERY_001.json').read_bytes())
source = discovery['Source']; assert fact(Path(source['path'])) == source
raw = Path(source['path']).read_bytes(); tree = ast.parse(raw)
nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'canonical_dependency']; assert len(nodes) == 1
n = nodes[0]; span = b''.join(raw.splitlines(keepends=True)[n.lineno-1:n.end_lineno])
assert b"owner_review['reviewer'] == '/root/owner_docs_review'" in span
assert not (P / 'i9/validate_recorded_M3_semantics_001.py').exists()
x = dict(schema_version=1, record_type='Root_I9_current_actor_open_proof_adaptation_Source_clarification', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), adopted_protocol=adoption, original_I2_Source=source, original_canonical_dependency_region=dict(first_line=n.lineno,last_line=n.end_lineno,bytes=len(span),sha256=hashlib.sha256(span).hexdigest()),
    retained_semantic_body='Retain exact historical nominal peer BODY reviewer/semantic author labels required by the original byte algorithms, including owner_docs_review where appropriate. These literals remain historical Source data, never an assertion that a current actor has that identity.',
    actual_current_content_proof='In the NEW I9 recorded dependency adapter, the actual peer content author must be a canonical non-Root actor in trusted.actual_content_authors, distinct from the actual producer helper Source editor and its descendants. The actual OPEN Owner_genuine_content_review proof must name a canonical genuinely different non-Root current reviewer; reject Root, actual source_editor and descendants, producer_Source_editor and descendants, the actual content author and every trusted actual_content_authors actor/subtree. Bind capsule/full reviewer identity and full proof, current proposal, actual selected draft, Root serializer, exact scope and selection and Root adoption coverage/chronology. Do not require the historical owner_docs_review literal as the actual current proof actor.',
    preserved_semantics='Retain all other original known closed9 dependency carrier, canonical/new-byte, author receipt, peer content proposal, actual selected draft, Root serialization, source review, separate original publication and closed26 reconciliation/review/adoption joins and chronology. No old file, Source guard or actual I2 ABI qualification flag is changed.',
    explicit_adapter_boundary='This is an explicit new I9 metadata actor-proof adaptation consistent with the adopted current-actor/historical-label distinction. It does not make the held I2 canonical_dependency callable or qualify a producer/carrier/caller. Exact old I2 role literals remain unchanged there, and genuine future actor authentication remains external. All new I9 actual_admission, producer_qualified, caller_qualified, physical/human/native/operational/scientific authority flags remain False.',
    trusted_top_level_keys_changed=False, public_API_changed=False, target_execution=False, tests_executed=False, actual_family_publication=False, new_actual_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
encoded = (json.dumps(x, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
output = P / 'ROOT_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_CLARIFICATION_001.json'
with output.open('xb') as handle:
    handle.write(encoded); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(fact(output)))
