      inspection['author_target_calls']==0 and inspection['author_fixture_calls']==0)
check('chronology: correction born after both actual Root Source instructions',
      utc(failure['created_utc'])<=utc(api['created_utc'])<=utc(receipt['created_utc']) and utc(surrogate['created_utc'])<=utc(api['created_utc']))

root_receipt_pin=fact(P/'ROOT_I9_EXACT_EXTERNAL_EMPTY_STREAM_FACT_ADOPTER_SOURCE_RECEIPT_001.json')
root_receipt=obj(root_receipt_pin['path'])
check('Root adopters: exact dated metadata-only empty stream correction receipt',root_receipt_pin['bytes']==1639 and
      root_receipt_pin['sha256']=='2a5a2912167343a7b0ec72db6bc91c68839b795812da457f136b0b62dae7dc9e' and
      root_receipt['author']=='/root' and root_receipt['target_execution'] is False and root_receipt['tests_executed'] is False and
      root_receipt['new_adopter_bodies_invoked'] is False)
for index,row in enumerate(root_receipt['subjects']):
    label='Root adopter '+str(index+1)
    pin(row['new_Source'],label+' current actual Source');pin(row['original_Source'],label+' preserved prior Source')
    rs=raws[row['new_Source']['path']].decode('utf8');rsold=raws[row['original_Source']['path']].decode('utf8')
    rt=ast.parse(rs);rot=ast.parse(rsold)
    rp=next(q for q in rt.body if isinstance(q,ast.FunctionDef) and q.name=='pin')
    rop=next(q for q in rot.body if isinstance(q,ast.FunctionDef) and q.name=='pin')
    rpin=segment(rs,rp)
    check(label+': only pin validator Source changed',rsold.replace(segment(rsold,rop),rpin,1)==rs)
    check(label+': zero fact requires exact parent and exact external stream filename',
          "if q['bytes'] == 0:" in rpin and "Path(q['path']).parent == P" in rpin and
          r"ROOT_I9_ACTUAL_MEMORY_CHILD_(?:STDOUT|STDERR)_[0-9]{3}\.txt" in rpin)
    check(label+': strict builtin integer cap and actual whole file hash remain',
          "type(q['bytes']) is int and 0 <= q['bytes'] <= CAP" in rpin and
          "len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']" in rpin)

source_pin=fact(__file__);created=datetime.datetime.now(datetime.timezone.utc).isoformat()
check('review: genuine different actor from Root and every actual Source contributor',REVIEWER not in {'/root',AUTHOR,'/root/i9_fixture_author'})
check('review: current Source-only window and >60 second reserve',utc(window['interval_start'])<=utc(created) and
      utc(created)+datetime.timedelta(seconds=60)<utc(window['interval_end']))
check('review: all four final subjects still exact frozen bytes',all(fact(q['path'])==q for q in subjects))
failed=sum(q['passed'] is not True for q in checks)
full=dict(schema_version=1,record_type='Independent_I9_actual_quartet005_Source_review',reviewer=REVIEWER,source_author=AUTHOR,
    created_utc=created,verdict=VERDICT if failed==0 else 'REFUSE_I9_QUARTET005_SOURCE_CHECKS_FAILED',subjects=subjects,
    reviewer_Source=source_pin,checks=checks,checks_failed=failed,checks_passed=len(checks)-failed,
    all_actual_inputs=[inputs[k] for k in sorted(inputs)],target_execution=False,tests_executed=False,I9_fixture_reruns=0,
    I9_target_calls_by_reviewer=0,I9_target_imports_by_reviewer=0,operational_authority=False,scientific_authority=False,
    actual_existing_I9_memory_test_runs=2,failed_actual_memory_test_runs=2,accepted_complete_memory_test_runs=0,
    current_module004_execution_count=0,current_fixture005_execution_count=0,planned_case_count=98,
    actual_correction_instructions=[failure_pin,surrogate_pin],Source_inverse=inverse_pin,
    Source_coverage='All23 ports, generic current authority/adoption bodies, reader/view/public holds and every unrelated module definition are byte-exact. Full Source reverse reconstruction and all new fixed-bundle/legacy fields, chronology, surrogate AST and public regression branches independently inspected. Existing fixture96 cases and independent basis are unchanged.',
    performance_boundary='Equivalent surrogate range predicate removes Python per-character generator. No target benchmark or timing improvement was measured by author or reviewer; original60s suite/5s cleanup and all cases/budgets remain required.',
    memory_boundary='No target/fixture import/call/private helper/oracle or replay. Empty historical raw .txt captures remain genuine nonnegative external file facts, not positive metadata-schema records.',
    static_limit='Two prior zero-completion failures remain evidence. Source review does not certify a passing positive graph or accepted suite; only actual fresh separately scoped invocation can supply new outcomes.',
    actual_future_grants_lease_family_Native8_Parser_results=None,next_invocation_authorized=False)

def save(name,value):
    data=(json.dumps(value,sort_keys=True,indent=2,ensure_ascii=False,allow_nan=False)+'\n').encode('utf8');assert len(data)<=2097152
    with (OWN/name).open('xb') as handle:handle.write(data)
    return dict(path=str(OWN/name),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

fp=save('INDEPENDENT_I9_INITIAL_IMPLEMENTATION_FULL_SOURCE_PROOF_005.json',full)
capsule=dict(schema_version=1,record_type='Independent_I9_actual_quartet005_Source_capsule',reviewer=REVIEWER,source_author=AUTHOR,
    created_utc=created,verdict=full['verdict'],subjects=subjects,reviewer_Source=source_pin,full_proof=fp,
    checks_failed=failed,checks_passed=len(checks)-failed,target_execution=False,tests_executed=False,I9_fixture_reruns=0,
    actual_existing_I9_memory_test_runs=2,failed_actual_memory_test_runs=2,accepted_complete_memory_test_runs=0,
    current_module004_execution_count=0,current_fixture005_execution_count=0,planned_case_count=98,
    operational_authority=False,scientific_authority=False,next_invocation_authorized=False)
cp=save('INDEPENDENT_I9_INITIAL_IMPLEMENTATION_SOURCE_CAPSULE_005.json',capsule)
print(json.dumps(dict(capsule=cp,full_proof=fp,reviewer_Source=source_pin,checks=len(checks),checks_failed=failed,
    inputs=len(inputs),failed_checks=[q for q in checks if not q['passed']]),sort_keys=True))
assert failed==0
