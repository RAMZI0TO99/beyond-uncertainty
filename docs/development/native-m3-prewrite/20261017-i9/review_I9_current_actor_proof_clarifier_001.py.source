"""Actual independent bounded Source review; no target imports/calls/execution."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN = P / 'independent_review_001'
CAP = 2097152
inputs = {}
checks = []


def fact(path):
    path = Path(path)
    raw = path.read_bytes()
    assert 0 < len(raw) <= CAP
    q = dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())
    if str(path) in inputs:
        assert inputs[str(path)] == q
    inputs[str(path)] = q
    return q, raw


def pairs(rows):
    result = {}
    for key, value in rows:
        assert key not in result
        result[key] = value
    return result


def bad(value):
    raise ValueError(value)


def read_object(path):
    q, raw = fact(path)
    return q, json.loads(raw, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)


def check(name, passed, evidence):
    assert type(passed) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name, passed=passed, evidence=evidence))


subject, clarifier = read_object(P / 'ROOT_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_CLARIFICATION_001.json')
subjects = [subject]
check('actual_subject3243_exact_pin', subject['bytes'] == 3243 and subject['sha256'] ==
      '94f6c2be74c5350b9f6d1323d57e8e5f420987f5132985df7c141336d5771f66', [subject])
check('actual_Root_author_schema1_type', clarifier['author'] == '/root' and
      type(clarifier['schema_version']) is int and clarifier['schema_version'] == 1 and
      clarifier['record_type'] == 'Root_I9_current_actor_open_proof_adaptation_Source_clarification', [subject])
for name in ('target_execution', 'tests_executed', 'operational_authority', 'scientific_authority',
             'actual_family_publication', 'trusted_top_level_keys_changed', 'public_API_changed'):
    check('clarifier_false_' + name, clarifier[name] is False, [subject])
check('no_new_actual_grants', clarifier['new_actual_grants_lease_family_Native8_Parser_results'] is None,
      [subject])

adoptq, adopt = read_object(clarifier['adopted_protocol']['path'])
check('actual_adopted_protocol4717_exact', adoptq == clarifier['adopted_protocol'] and
      adoptq['bytes'] == 4717 and adoptq['sha256'] ==
      'f2447b86e8178a59f94e5fd4d75866d27ba83f994bc5f9d60ca5b9a5599bcc0f', [subject, adoptq])
check('five_subject_adoption_Source_only', adopt['author'] == '/root' and len(adopt['subjects']) == 5
      and adopt['tests_executed'] is False, [adoptq])
protocol = None
protocolq = None
for q in adopt['subjects']:
    actual, raw = fact(q['path'])
    check('actual_adopted_subject_' + Path(q['path']).name, actual == q, [adoptq, actual])
    if Path(q['path']).name == 'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json':
        protocolq = actual
        protocol = json.loads(raw, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
assert protocol is not None
scopeq, scope = read_object(protocol['scope']['path'])
now = datetime.datetime.now(datetime.timezone.utc)
check('Source_scope_pin_and_current_60s_reserve', scopeq == protocol['scope'] and
      datetime.datetime.fromisoformat(scope['interval_start']) <= now and
      now + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end']),
      [scopeq, protocolq])
check('unchanged_closed11_trusted_top_level', len(protocol['trusted_bindings_keys']) == 11 and
      'actual_content_authors' in protocol['trusted_bindings_keys'] and
      'producer_Source_editor' in protocol['trusted_bindings_keys'] and
      clarifier['trusted_top_level_keys_changed'] is False, [subject, protocolq])
check('adopted_current_actual_versus_historical_actor_distinction',
      'Retained historical semantic authors and actual current content authors are distinct data.'
      in ' '.join(protocol['stage_and_request_rules']) and
      'exclude these, Root exactly' in protocol['trusted_binding_contract']['actual_content_authors'],
      [protocolq])

sourceq, source = fact(clarifier['original_I2_Source']['path'])
check('actual_I2_Source127014_exact', sourceq == clarifier['original_I2_Source'] and
      sourceq['bytes'] == 127014 and sourceq['sha256'] ==
      '600ab5bf46faceee88b7b5a99eb32b71a7ebfc763151e2f4e3453a6cccd281c2', [subject, sourceq])
tree = ast.parse(source)
node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'canonical_dependency')
region = b''.join(source.splitlines(keepends=True)[node.lineno - 1:node.end_lineno])
recorded = clarifier['original_canonical_dependency_region']
check('actual_canonical_dependency_whole_region5189_pin', recorded == dict(first_line=node.lineno,
      last_line=node.end_lineno, bytes=len(region), sha256=hashlib.sha256(region).hexdigest()) and
      recorded['bytes'] == 5189 and recorded['sha256'] ==
      '38f058c2e1286556aa9a615f280447753ae920468462b99c28c1ccdba6fe03e9', [sourceq, subject])
text = region.decode()
check('original_held_entry_before_dependency_acceptance',
      "need(EXTERNAL_CANONICAL_RECEIPT_ABI_QUALIFIED is True" in text and
      text.index('EXTERNAL_CANONICAL_RECEIPT_ABI_QUALIFIED') < text.index("set(support) == DEPENDENCY_KEYS"),
      [sourceq])
check('original_nominal_actual_reviewer_equality_identified',
      "owner_review['reviewer'] == '/root/owner_docs_review'" in text and
      "different_review(receipt['Owner_genuine_content_review']" in text, [sourceq])

actual = clarifier['actual_current_content_proof']
retained = clarifier['retained_semantic_body']
boundary = clarifier['explicit_adapter_boundary']
preserved = clarifier['preserved_semantics']
check('historical_body_labels_preserved_as_data_only', all(x in retained for x in
      ('BODY', 'reviewer/semantic author labels', 'original byte algorithms', 'owner_docs_review',
       'historical Source data', 'never an assertion')), [subject])
check('actual_peer_content_author_from_trusted_set_nonRoot', all(x in actual for x in
      ('canonical non-Root actor', 'trusted.actual_content_authors', 'actual producer helper Source editor',
       'descendants')), [subject])
check('genuine_actual_reviewer_current_nonRoot_not_historical_roster', all(x in actual for x in
      ('OPEN Owner_genuine_content_review', 'canonical genuinely different non-Root current reviewer',
       'Do not require the historical owner_docs_review literal')), [subject])
check('actual_editor_and_all_content_author_subtrees_excluded', all(x in actual for x in
      ('reject Root', 'actual source_editor and descendants', 'producer_Source_editor and descendants',
       'the actual content author', 'every trusted actual_content_authors actor/subtree')), [subject])
check('proof_capsule_full_identity_and_proposal_draft_Root_serializer_joins', all(x in actual for x in
      ('capsule/full reviewer identity', 'full proof', 'current proposal', 'actual selected draft',
       'Root serializer', 'exact scope and selection', 'Root adoption coverage/chronology')), [subject])
check('open_proof_preserved_no_new_closed_review_ABI', 'OPEN' in actual and
      clarifier['public_API_changed'] is False and 'new I9 metadata actor-proof adaptation' in boundary,
      [subject])
check('other_original_closed9_22_semantics_preserved', all(x in preserved for x in
      ('closed9', 'canonical/new-byte', 'author receipt', 'peer content proposal', 'actual selected draft',
       'Root serialization', 'source review', 'separate original publication', 'closed26 reconciliation',
       'chronology')), [subject])
check('original_receipt22_Rootphysical_and_retained_author_remain_distinct', all(x in text for x in
      ("len(receipt) == 22", "receipt['author'] == receipt['actual_physical_Source_editor'] == '/root'",
       "receipt['retained_semantic_Source_author'] == row['retained_semantic_Source_author']")), [sourceq])
check('original_proposal_Root_draft_serializer_edges_preserved', all(x in text for x in
      ("receipt.get('physical_proposal_editor') == who", "receipt.get('physical_selected_draft_editor') == '/root'",
       "receipt['actual_peer_content_proposal']", "receipt.get('actual_selected_peer_draft')")), [sourceq])
check('original_separate_original_publication_not_reconciliation_substitute', all(x in text for x in
      ("support['original_publication']", "support['late_reconciliation']", 'len(reconciliation) == 26',
       'never substitute it for original publication')), [sourceq])
check('old_I2_Source_and_qualification_not_changed', all(x in boundary for x in
      ('does not make the held I2 canonical_dependency callable', 'qualify a producer/carrier/caller',
       'Exact old I2 role literals remain unchanged', 'actor authentication remains external')), [subject])
check('all_new_actual_admission_qualification_authority_false', all(x in boundary for x in
      ('actual_admission', 'producer_qualified', 'caller_qualified',
       'physical/human/native/operational/scientific authority flags remain False')), [subject])

authorq, author_raw = fact(P / 'ROOT_AUTHOR_I9_CURRENT_ACTOR_PROOF_ADAPTATION_CLARIFICATION_001.py')
author_tree = ast.parse(author_raw)
check('Root_author_Source_AST_only_no_dynamic_target_loader', not any(
      isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and
      n.func.id in ('exec', 'eval', 'compile', '__import__') for n in ast.walk(author_tree)) and
      b"with output.open('xb')" in author_raw, [authorq])
check('Root_author_checks_exact_historical_reviewer_condition',
      b"owner_review['reviewer'] == '/root/owner_docs_review'" in author_raw and
      b"ast.parse(raw)" in author_raw, [authorq, sourceq])
selfq, _ = fact(Path(__file__))
held = sorted(inputs.values(), key=lambda q: q['path'])
check('all_actual_inputs_unique_casefold', len({q['path'].casefold() for q in held}) == len(held), [selfq])
for i, q in enumerate(held):
    raw = Path(q['path']).read_bytes()
    check('final_actual_input_rehash_' + str(i), len(raw) == q['bytes'] and
          hashlib.sha256(raw).hexdigest() == q['sha256'], [q])
failed = [c['name'] for c in checks if not c['passed']]
common = dict(schema_version=1, reviewer='/root/owner_source_review', source_author='/root',
    created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='PASS_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_ONLY' if not failed else
    'REFUSE_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_REVIEW',
    subjects=subjects, reviewer_Source=selfq, checks_failed=len(failed), checks_passed=len(checks)-len(failed),
    tests_executed=False, target_execution=False, operational_authority=False, scientific_authority=False)
full = dict(**common, record_type='Independent_I9_current_actor_proof_clarifier_full_Source_proof',
    all_actual_inputs=held, checks=checks, failures=failed,
    review_scope='One actual Root actor-adaptation clarification against the exact held I2 dependency Source and adopted five-subject protocol; preserves historical byte semantics and every remaining dependency/proof/chronology join.',
    adoption_scope='Root may adopt the exact explicit new I9 recorded metadata actor adapter for Source authoring. No target call, producer/caller qualification, actual publication, authority token or operational/scientific execution is granted.',
    original_I2_unchanged=True, template_or_target_imports=0, template_or_target_calls=0,
    target_Source_compilations=0, fixture_runs=0, renderer_calls=0, native_Parser_calls=0,
    Git_mutations=0, Pro3_messages=0, all_actual_new_grants_lease_family_Native8_Parser_results=None)


def save(name, value):
    path = OWN / name
    raw = (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(raw) <= CAP
    with path.open('xb') as handle:
        handle.write(raw)
    return dict(path=str(path), bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest())


fp = save('INDEPENDENT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_FULL_SOURCE_PROOF_001.json', full)
cp = save('INDEPENDENT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_SOURCE_CAPSULE_001.json',
          dict(**common, record_type='Independent_I9_current_actor_proof_clarifier_Source_capsule',
               full_proof=fp, actual_input_count=len(held)))
print(json.dumps(dict(capsule=cp, full_proof=fp, reviewer_Source=selfq,
                     checks=len(checks), checks_failed=len(failed), failures=failed,
                     actual_inputs=len(held)), indent=2))
