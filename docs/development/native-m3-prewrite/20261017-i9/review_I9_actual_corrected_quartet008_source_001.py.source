    actual_I9_memory_test_runs=None,known_I9_memory_test_runs=4,unknown_suite_status_owned_launches=1,known_failed_memory_test_runs=4,spent_memory_scope_count=5,
    accepted_complete_memory_test_runs=0,current_module007_execution_count=0,current_fixture005_aggregate_entry_count=None,
