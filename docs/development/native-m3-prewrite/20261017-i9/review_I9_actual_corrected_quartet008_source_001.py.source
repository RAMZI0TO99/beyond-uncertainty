        ac=literals(bt);check('Root Source adopter007: exact uppercase timeout005 REQUIRED',ac['REQUIRED'][Path(timeout_pin['path']).name]==timeout_pin['sha256'])
    elif j==1:
        check('Root binder006: next6 output/binding ordinal only',a.replace('_005','_006').replace('attempt_numbers=[5]','attempt_numbers=[6]').replace('current_attempt_numbers=[5]','current_attempt_numbers=[6]')==b)
    else:
        expected=segment(a,ad['main']).replace('_005.json','_006.json').replace("s['attempt_number'] == 5","s['attempt_number'] == 6").replace('I9_memory_test_runs=4,',
          'I9_memory_test_runs=None, known_I9_memory_test_runs=4, unknown_I9_memory_test_runs=1, spent_memory_scope_count=5,')
        check('Root tool/scope adopter007: exact unknown-history and next6 metadata',expected==segment(b,bd['main']))
source_pin=fact(__file__);created=datetime.datetime.now(datetime.timezone.utc).isoformat()
check('review: actual different Source actor from Root and every contributor',REVIEWER not in {'/root',AUTHOR,'/root/i9_fixture_author'})
check('review: >60second Source-only scope reserve',utc(window['interval_start'])<=utc(created) and utc(created)+datetime.timedelta(seconds=60)<utc(window['interval_end']))
check('review: four actual subject bytes unchanged',all(fact(q['path'])==q for q in subjects))
check('review: all actual inputs casefold unique and exact Root timeout pin retained',len(inputs)==len({k.casefold() for k in inputs}) and inputs[timeout_pin['path']]==timeout_pin)
failed=sum(q['passed'] is not True for q in checks);assert failed==0,json.dumps([q for q in checks if not q['passed']],ensure_ascii=True)
full=dict(schema_version=1,record_type='Independent_I9_actual_quartet008_Source_review',reviewer=REVIEWER,source_author=AUTHOR,created_utc=created,verdict=VERDICT,
