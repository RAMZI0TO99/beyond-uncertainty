"""Adopt actual static Source findings and scope an immutable uninvoked successor."""
import datetime, hashlib, json, os
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012');CAP=2097152
def raw(path):
    path=Path(path);assert path.is_file() and not path.is_symlink() and path.stat().st_size<=CAP
    with path.open('rb') as handle:data=handle.read(CAP+1)
    assert len(data)<=CAP;return data
def fact(path):
    data=raw(path);return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
def pin(q):
    assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
    data=raw(q['path']);assert len(data)==q['bytes'] and hashlib.sha256(data).hexdigest()==q['sha256'];return data
def pairs(items):
    result={}
    for key,value in items:assert key not in result;result[key]=value
    return result
def bad(value):raise AssertionError(value)
def obj(data):return json.loads(data,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
scope_pin=fact(P/'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json');assert scope_pin['sha256']=='0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(obj(pin(scope_pin))['interval_end'])
module=fact(P/'i9/validate_recorded_M3_semantics_001.py');assert module['bytes']==116461 and module['sha256']=='d75d31c59be76332c625e17b3312284068706b0aac954512c4f8d8a9b0501ed1'
capsule_pin=fact(P/'module_review_001/INDEPENDENT_I9_MODULE001_SOURCE_REFUSAL_CAPSULE_002.json');assert capsule_pin['sha256']=='c898aaa19a2eb117f8451db6e56fe3496ba187bbb989cafc44e1181f595f0133'
c=obj(pin(capsule_pin));f=obj(pin(c['full_proof']));pin(c['reviewer_Source'])
for x in (c,f):
    assert x['reviewer']=='/root/owner_source_review' and x['source_author']=='/root/phase_frontier'
    assert x['verdict']=='REFUSE_I9_MODULE001_RECORDED_SEMANTIC_SOURCE_THREE_CONSOLIDATED_DEFECTS'
    assert type(x['checks_failed']) is int and x['checks_failed']==3
    assert type(x['checks_passed']) is int and x['checks_passed']==236
    assert x['subjects']==[module] and x['target_execution'] is False and x['tests_executed'] is False
checks=f['checks'];assert type(checks) is list and len(checks)==239 and len({x['name'] for x in checks})==len(checks)
assert all(type(x['passed']) is bool for x in checks)
failed=[x for x in checks if x['passed'] is False]
expected={'generation_prelude_closure_complete','timestamped_semantic_JSON_body_own_creation_validated','same_stage_retained_observation_rows_immutable'}
assert {x['name'] for x in failed}==expected and len(failed)==3
inputs=f['all_actual_inputs'];assert type(inputs) is list and len(inputs)==65 and len({q['path'].casefold() for q in inputs})==len(inputs)
assert module in inputs and c['reviewer_Source'] in inputs
for q in inputs:pin(q)
assert not (P/'i9/validate_recorded_M3_semantics_002.py').exists()
result=dict(schema_version=1,record_type='Root_I9_actual_module001_Source_refusal_adoption_and_exact_successor_correction_scope',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),verdict='ACCEPT_I9_MODULE001_STATIC_REFUSAL_AND_THREE_SOURCE_CORRECTIONS_ONLY',source_scope=scope_pin,refused_module=module,different_Source_review=capsule_pin,full_proof=c['full_proof'],reviewer_Source=c['reviewer_Source'],actual_named_checks=239,actual_passed_checks=236,actual_failed_checks=3,actual_rehashed_input_count=65,all_actual_inputs_rehashed=True,Source_findings=f['findings'],
    exact_corrections={
      'F1':'Implement explicit stage-scoped generation prelude input closure including every known current producer/selection/dependency/reconciliation/peer/binding full proof and actual peer proposal/draft auxiliaries read by original I2. Retain fixed code19/owner recursive closure. Do not derive purpose from the whole post-generation I9 read log or leak request/other-stage outputs. Purpose/observations must not omit known generation inputs.',
      'F2':'Check created<=own recorded birth<=validation now for every consumed timestamped semantic JSON body, including fresh manifest draft header and canonical peer metadata. Retain exact wire strings and old-format rules. Apply fresh-render-after-stage-adoption order only where original generation requires it, never to retained historical headers.',
      'F3':'Within each recorded stage preserve a first-observation map: every repeated row across later receipt snapshots must be typed/byte-equivalent in path/pin/cap/PATH9 full9/fd9 full9/shared7/two_read_match/observed_utc. Append only exact required output prefix. Different stage invocations may have different recorded observations; shared reader cache must not impose cross-stage physical equality.'},
    successor='i9/validate_recorded_M3_semantics_002.py',successor_Source_authoring_authorized=True,module001_preserve_unrun=True,all23_render_inverse_ports_must_remain_unchanged_except_reviewed_pure_adaptations=True,fixture_content_contributor='/root/i9_fixture_author',physical_final_quartet_Source_editor='/root/phase_frontier',required_next='Independent corrected module and actual four-subject Source review, Root adoption, separately fresh reviewed one-use memory scope, then exactly once new memory fixture invocation. No invocation now.',target_execution=False,tests_executed=False,I9_memory_test_runs=0,new_module_or_fixture_invocation_authorized=False,old_I0_I8_changes_or_invocations_authorized=False,actual_family_publication=False,new_grants_lease_family_Native8_Parser_results=None,operational_authority=False,scientific_authority=False)
data=(json.dumps(result,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(data)<=CAP
output=P/'ROOT_I9_MODULE001_ACTUAL_SOURCE_REFUSAL_AND_THREE_CORRECTION_ADOPTION_001.json'
with output.open('xb') as handle:handle.write(data);handle.flush();os.fsync(handle.fileno())
print(json.dumps(fact(output)))
