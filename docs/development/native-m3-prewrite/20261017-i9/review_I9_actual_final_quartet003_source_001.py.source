cp=save('INDEPENDENT_I9_INITIAL_IMPLEMENTATION_SOURCE_CAPSULE_001.json',dict(**common,record_type='Independent_I9_actual_final_quartet003_Source_capsule',full_proof=fp,actual_input_count=len(held),planned_case_count=count,actual_fixture_runs=0))
print(json.dumps(dict(capsule=cp,full_proof=fp,reviewer_Source=selfq,checks=len(checks),checks_failed=len(failed),failures=failed,actual_inputs=len(held)),indent=2))
