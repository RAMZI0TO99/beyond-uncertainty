def fact(path):
    path=Path(path);raw=path.read_bytes();assert 0<len(raw)<=CAP
    q=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    if str(path) in inputs:assert inputs[str(path)]==q
    inputs[str(path)]=q;return q,raw
def pairs(rows):
    d={}
    for k,v in rows:assert k not in d;d[k]=v
    return d
def bad(x):raise ValueError(x)
def parse_json(raw):return json.loads(raw,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def obj(path):
    q,b=fact(path);return q,parse_json(b)
def check(name,value,evidence):
    assert type(value) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name,passed=value,evidence=evidence))
def allpins(value):
    result=[]
    if type(value) is dict:
        if set(value)=={'path','bytes','sha256'}:return [value]
        for v in value.values():result.extend(allpins(v))
    elif type(value) is list:
        for v in value:result.extend(allpins(v))
    return result
def defs(raw):return {n.name:n for n in ast.parse(raw).body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
def literal(raw,name):
    found=[n.value for n in ast.parse(raw).body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets)]
    assert len(found)==1;return ast.literal_eval(found[0])
def astsame(a,b):return ast.dump(a,include_attributes=False)==ast.dump(b,include_attributes=False)

