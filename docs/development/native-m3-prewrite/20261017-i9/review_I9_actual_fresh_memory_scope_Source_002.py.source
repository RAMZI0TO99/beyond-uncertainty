check('Fresh scope aware interval starts before current review and retains65 seconds',start.tzinfo is not None and end.tzinfo is not None and start<=now and now+datetime.timedelta(seconds=65)<end)
check('Scope duration is positive and no more than20min/current Source window',datetime.timedelta(0)<end-start<=datetime.timedelta(seconds=1200) and end<=source_end and now+datetime.timedelta(seconds=65)<source_end)
