check('Exact96 case names join API/literal Source/scope without executing fixture',type(s['expected_planned_case_count']) is int and s['expected_planned_case_count']==96==literals['EXPECTED_CASE_COUNT']==api['fixture_interface']['expected_case_count'] and s['planned_case_names']==list(literals['PLANNED_CASE_NAMES'])==api['fixture_interface']['planned_case_names'] and len(set(s['planned_case_names']))==96)
for key,value in (('wall_cap_seconds',60),('cleanup_reap_seconds',5),('stream_cap_bytes',2097152),('RAM_floor_bytes',1073741824),('disk_floor_bytes',10737418240)):
    check('Exact builtin integer budget/floor: '+key,type(s[key]) is int and s[key]==value)
check('Actual fresh prelaunch resource observation remains required',s['actual_prelaunch_resource_observation_required_in_supervisor'] is True and 'resource = fresh_resources()' in tool_text['supervisor'] and "'FRESH_PRELAUNCH_RESOURCES'" in tool_text['supervisor'] and 'status.available >= 1073741824 and disk >= 10737418240' in tool_text['supervisor'])
check('Accepted supervisor enforces one isolated child and60+5 bounds',"argv = [PYTHON,'-I','-S','-B',runner['path'],f'{attempt:03d}']" in tool_text['supervisor'] and 'subprocess.CREATE_NO_WINDOW' in tool_text['supervisor'] and 'observed-launch > 60000000000' in tool_text['supervisor'] and 'proc.wait(timeout=5)' in tool_text['supervisor'])
check('Accepted runner consumes scope before only two controlled Source loads','Root_I9_one_use_memory_scope_consumed_before_target_compile' in tool_text['runner'] and 'EXACT_ONE_COMPILE_AND_EXEC_PER_NEW_TARGET' in tool_text['runner'] and 'I9_FORBIDDEN_AUDIT_EVENT:' in tool_text['runner'])
check('Root scope adopter will require this exact subject and unconsumed outputs',b'expected = [fresh_scope]' in adopter_raw and b'now + datetime.timedelta(seconds=65)' in adopter_raw and b'assert not (P / s[\'names\'][role]).exists()' in adopter_raw)
