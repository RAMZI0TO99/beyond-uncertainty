check('Source-only tool adoption has no memory invocation or family grant',tool_adoption['verdict']=='ACCEPT_I9_EXACT_BOUND_MEMORY_TOOL_SOURCE_ONLY' and tool_adoption['new_I9_memory_invocation_authorized_now'] is False and type(tool_adoption['maximum_new_I9_invocations']) is int and tool_adoption['maximum_new_I9_invocations']==0 and tool_adoption['all_new_grants_lease_family_Native8_Parser_results'] is None)
check('Actual accepted final quartet adoption stays Source only',source_adoption['verdict']=='ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY' and source_adoption['tests_executed'] is False and source_adoption['target_execution'] is False and type(source_adoption['I9_memory_test_runs']) is int and source_adoption['I9_memory_test_runs']==1)
check('Tool adoption/config/binding receipt exact joins',tool_adoption['actual_bindings']==config_pin and tool_adoption['actual_binding_receipt']==receipt_pin and tool_adoption['Source_adoption']==source_adoption_pin and tool_adoption['source_window']==window_pin and receipt['actual_bindings']==config_pin)
