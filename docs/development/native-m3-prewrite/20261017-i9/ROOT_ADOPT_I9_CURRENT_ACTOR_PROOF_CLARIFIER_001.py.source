"""Root adopts independently reviewed current actor clarification, Source only."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
def raw(path):
    path = Path(path); assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle: data = handle.read(CAP + 1)
    assert len(data) <= CAP; return data
def fact(path):
    data = raw(path); return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
def pin(q):
    assert type(q) is dict and set(q) == {'path','bytes','sha256'} and type(q['bytes']) is int and 0 < q['bytes'] <= CAP
    data = raw(q['path']); assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']; return data
def pairs(items):
    result = {}
    for key,value in items: assert key not in result; result[key] = value
    return result
def bad(value): raise AssertionError(value)
def obj(data): return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)
assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv) == 2 and re.fullmatch('[0-9a-f]{64}', sys.argv[1])
scope_pin = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert scope_pin['sha256'] == '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
scope = obj(pin(scope_pin))
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end'])
subject = fact(P / 'ROOT_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_CLARIFICATION_001.json')
assert subject['bytes'] == 3243 and subject['sha256'] == '94f6c2be74c5350b9f6d1323d57e8e5f420987f5132985df7c141336d5771f66'
capsule_pin = fact(P / 'independent_review_001/INDEPENDENT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_SOURCE_CAPSULE_001.json')
assert capsule_pin['sha256'] == sys.argv[1]
c = obj(pin(capsule_pin)); f = obj(pin(c['full_proof'])); pin(c['reviewer_Source'])
for x in (c,f):
    assert x['reviewer'] == '/root/owner_source_review' and x['source_author'] == '/root'
    assert type(x['checks_failed']) is int and x['checks_failed'] == 0
    assert x['target_execution'] is False and x['tests_executed'] is False
    assert x['verdict'].startswith(('PASS_','ACCEPT_'))
    assert x['subjects'] == [subject]
assert c['verdict'] == f['verdict']
checks = f['checks']; assert type(checks) is list and checks and len({x['name'] for x in checks}) == len(checks)
assert all(type(x['passed']) is bool and x['passed'] is True for x in checks)
inputs = f['all_actual_inputs']; assert inputs and len({q['path'].casefold() for q in inputs}) == len(inputs)
assert subject in inputs and c['reviewer_Source'] in inputs
for q in inputs: pin(q)
protocol = fact(P / 'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json')
assert protocol['sha256'] == 'f2447b86e8178a59f94e5fd4d75866d27ba83f994bc5f9d60ca5b9a5599bcc0f' and protocol in inputs
assert not (P / 'i9/validate_recorded_M3_semantics_001.py').exists()
result = dict(schema_version=1, record_type='Root_I9_current_actor_proof_Source_clarification_review_adoption', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), verdict='ACCEPT_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_ONLY', source_scope=scope_pin, subjects=[subject], adopted_protocol=protocol, different_Source_review=capsule_pin, full_proof=c['full_proof'], reviewer_Source=c['reviewer_Source'], actual_named_checks=len(checks), actual_rehashed_input_count=len(inputs), all_actual_review_inputs_rehashed=True, actor_adapter_Source_detail_clarified=True, public_API_or_trusted_keys_changed=False, target_execution=False, tests_executed=False, new_module_or_fixture_invocation_authorized=False, old_I2_modified_or_qualified=False, actual_family_publication=False, new_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode(); assert len(data) <= CAP
output = P / 'ROOT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
with output.open('xb') as handle:
    handle.write(data); handle.flush(); os.fsync(handle.fileno())
print(json.dumps(fact(output)))
