"""Bind four inert tool Sources only after exact final quartet Source adoption."""
import ast, datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
def raw(path):
    path=Path(path);assert path.is_file() and not path.is_symlink() and path.stat().st_size<=CAP
    with path.open('rb') as handle:data=handle.read(CAP+1)
    assert len(data)<=CAP;return data
def fact(path):
    data=raw(path);return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
def pin(q):
    assert type(q) is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes']) is int and 0<q['bytes']<=CAP
    data=raw(q['path']);assert len(data)==q['bytes'] and hashlib.sha256(data).hexdigest()==q['sha256'];return data
def pairs(items):
    result={}
    for key,value in items:assert key not in result;result[key]=value
    return result
def bad(value):raise AssertionError(value)
def obj(data):return json.loads(data,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def save(path,value):
    data=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(data)<=CAP
    with path.open('xb') as handle:handle.write(data);handle.flush();os.fsync(handle.fileno())
    return fact(path)
assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv)==3 and re.fullmatch('[0-9a-f]{64}',sys.argv[1]) and re.fullmatch('[0-9a-f]{64}',sys.argv[2])
monitoring_adoption_pin=fact(P/'ROOT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_REVIEW_ADOPTION_001.json')
assert monitoring_adoption_pin['sha256']==sys.argv[2]
monitoring_adoption=obj(pin(monitoring_adoption_pin))
assert monitoring_adoption['author']=='/root' and monitoring_adoption['verdict']=='ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY'
assert monitoring_adoption['tests_executed'] is False and monitoring_adoption['target_execution'] is False
pin(monitoring_adoption['unknown_timeout006_adoption'])
adoption_pin=fact(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_006.json')
assert adoption_pin['sha256']==sys.argv[1] and monitoring_adoption['original_target_Source_adoption']==adoption_pin
adoption=obj(pin(adoption_pin));assert adoption['author']=='/root' and adoption['verdict']=='ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY'
assert adoption['tests_executed'] is False and adoption['target_execution'] is False
subjects=adoption['subjects'];assert type(subjects) is list and len(subjects)==4
patterns={
 'module_Source':r'validate_recorded_M3_semantics_[0-9]{3}\.py',
 'fixture_Source':r'test_recorded_M3_semantics_memory_only_[0-9]{3}\.py',
 'API':r'CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_[0-9]{3}\.json',
 'author_receipt':r'CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_[0-9]{3}\.json'}
selected={}
for key,pattern in patterns.items():
    found=[q for q in subjects if Path(q['path']).parent==P/'i9' and re.fullmatch(pattern,Path(q['path']).name)]
    assert len(found)==1;selected[key]=found[0];pin(found[0])
protocol=fact(P/'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json');assert protocol['sha256']=='64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'
protocol_adoption=fact(P/'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json');assert protocol_adoption['sha256']=='f2447b86e8178a59f94e5fd4d75866d27ba83f994bc5f9d60ca5b9a5599bcc0f'
actor_adoption=fact(P/'ROOT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json');assert actor_adoption['sha256']=='a9de80e3d8313a953d01aa13b60e21867bccc096e43bab0010318855ca7aea6b'
assert adoption['actor_clarifier_adoption']==actor_adoption
window=fact(P/'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert window['sha256']=='0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
window_record=obj(pin(window));assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(window_record['interval_end'])
api=obj(pin(selected['API']));fixture_interface=api['fixture_interface']
fixture_tree=ast.parse(pin(selected['fixture_Source']));literals={}
for node in fixture_tree.body:
    if isinstance(node,ast.Assign):
        for name in node.targets:
            if isinstance(name,ast.Name) and name.id in ('EXPECTED_CASE_COUNT','PLANNED_CASE_NAMES'):literals[name.id]=ast.literal_eval(node.value)
assert type(literals['EXPECTED_CASE_COUNT']) is int and 1<=literals['EXPECTED_CASE_COUNT']<=256
assert type(literals['PLANNED_CASE_NAMES']) in (tuple,list) and len(literals['PLANNED_CASE_NAMES'])==literals['EXPECTED_CASE_COUNT']
assert fixture_interface['entry']=='run_memory_suite(module)' and type(fixture_interface['expected_case_count']) is int and fixture_interface['expected_case_count']==literals['EXPECTED_CASE_COUNT'] and fixture_interface['planned_case_names']==list(literals['PLANNED_CASE_NAMES'])
imports=set();module_tree=ast.parse(pin(selected['module_Source']))
for tree in (module_tree,fixture_tree):
    for node in ast.walk(tree):
        if isinstance(node,ast.Import):imports.update(a.name for a in node.names)
        if isinstance(node,ast.ImportFrom):assert node.level==0 and node.module and all(a.name!='*' for a in node.names);imports.add(node.module)
pure={'ast','base64','binascii','copy','datetime','difflib','hashlib','json','re','zlib','types','collections','math','struct','functools','itertools','operator','codecs','_strptime','locale','calendar'}
assert imports and all(name.split('.')[0] in pure for name in imports)
functions=['validate_recorded_M3_stage_semantics','validate_recorded_M3_prewrite_semantics','require_actual_M3_prewrite_publication_admission','_i9_render_templates','_i9_render_manifest','_i9_render_capture','_i9_render_phase_bound','_i9_render_phase_binding']
assert set(functions)<={n.name for n in module_tree.body if isinstance(n,ast.FunctionDef)}
paths={role:str(P/name) for role,name in dict(runner='ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_007.py',supervisor='ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_007.py',scope_preparer='ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_007.py',capture='ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_007.py').items()}
b=dict(binding_schema=1,Root_author='/root',protocol=protocol,protocol_Root_adoption=protocol_adoption,protocol_adoption_required_fields=dict(author='/root',verdict='ACCEPT_I9_COMPLETE_RECORDED_M3_SEMANTIC_PROTOCOL_SOURCE_ONLY',target_execution=False,tests_executed=False,subjects=obj(pin(protocol_adoption))['subjects']),source_window=window,source_window_required_fields=dict(author='/root',new_target_Source_authoring_requires_reviewed_exact_protocol=True,old_publisher_I0_I1_I2_I3_I4_I5_I6_I7_I8_changes_or_invocations_authorized=False,target_execution=False,tests_executed=False),Source_window_end_field='interval_end',Source_adoption=adoption_pin,Source_adoption_required_fields=dict(author='/root',verdict=adoption['verdict'],target_execution=False,tests_executed=False,subjects=subjects,actor_clarifier_adoption=actor_adoption),Source_adoption_subject_field='subjects',Source_review_records=[dict(pin=q,required_fields=dict(reviewer='/root/owner_source_review',target_execution=False,tests_executed=False,checks_failed=0,subjects=subjects)) for q in (adoption['different_Source_review'],adoption['full_proof'])],API_fixture_field='fixture_interface',API_entry_field='entry',API_count_field='expected_case_count',API_names_field='planned_case_names',exact_import_modules=sorted(imports),approved_import_roots=sorted({n.split('.')[0] for n in imports}),maximum_profiled_module_calls=50000000,required_positive_module_function_names=functions,attempt_numbers=[7],scope_duration_seconds=1200,tool_Source_paths=paths,python_executable=r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe',**selected)
config=save(P/'ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_007.json',b)
templates={'runner': ('RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_TEMPLATE_003.py', '381a5424df27ddaf19c23b28b090caea9906489b243af702b02d109bb0d3197e'), 'supervisor': ('SUPERVISE_I9_ONCE_MEMORY_FIXTURES_TEMPLATE_003.py', '02e6fc14789a27e0b5d5d3a2ef23b9fdbf9b9e43116f7fe7135fe29902b3afaf'), 'scope_preparer': ('PREPARE_I9_FRESH_MEMORY_SCOPE_TEMPLATE_003.py', 'b926dd703bdb4aea87f8ed1693ffd218e70d62e2c2cdeb5ce7c5a80022f20d87'), 'capture': ('CAPTURE_I9_ACTUAL_MEMORY_STREAMS_TEMPLATE_003.py', 'cf1533d475dc113d1e5ab85c0749faf8345ed0d2f534d88ae33762c357824720')}
created=[]
for role,(name,digest) in templates.items():
    template=fact(P/'memory_tooling_001'/name);assert template['sha256']==digest
    text=pin(template).decode();tree=ast.parse(text);first=tree.body[0];assert isinstance(first,ast.Expr) and type(first.value.value) is str
    lines=text.splitlines(keepends=True)
    text='"""Root exactly bound I9 synthetic-memory tool; a fresh independently reviewed one-use scope is required.\nNo actual publisher, Native8, Parser, runtime or scientific authority.\n"""\n'+''.join(lines[first.end_lineno:])
    assert text.count('EXACT_ROOT_BINDINGS = None')==1
    text=text.replace('EXACT_ROOT_BINDINGS = None','EXACT_ROOT_BINDINGS = '+repr(b))
    data=text.encode();ast.parse(data);compile(data,paths[role],'exec')
    created.append(dict(role=role,original_TEMPLATE=template,new_Source=save(Path(paths[role]),data)))
receipt=dict(instrumentation_protocol_Root_adoption=monitoring_adoption_pin,unknown_timeout006_Root_adoption=monitoring_adoption['unknown_timeout006_adoption'],schema_version=1,record_type='Root_I9_actual_exact_memory_tool_Source_binding_receipt',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),actual_Source_adoption=adoption_pin,actual_bindings=config,subjects=created,actual_fixture_case_count=literals['EXPECTED_CASE_COUNT'],actual_literal_import_modules=sorted(imports),current_attempt_numbers=[7],original_templates_invoked=False,new_bound_tools_invoked=False,target_execution=False,tests_executed=False,requires_actual_different_tool_Source_review_and_fresh_scope_review_before_invocation=True,operational_authority=False,scientific_authority=False)
print(json.dumps(save(P/'ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_007.json',receipt)))
