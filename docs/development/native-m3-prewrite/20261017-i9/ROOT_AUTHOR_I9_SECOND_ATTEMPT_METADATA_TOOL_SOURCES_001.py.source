"""Author fresh attempt002 controls after the actual once-consumed refusal adoption."""
import ast, datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def save(path, value):
    data = value if type(value) is bytes else (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(data) <= CAP
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)

def replace(text, before, after, count=1):
    assert text.count(before) == count, (before, text.count(before), count)
    return text.replace(before, after)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv) == 2 and re.fullmatch('[0-9a-f]{64}', sys.argv[1])
failure = fact(P / 'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json')
assert failure['sha256'] == sys.argv[1]
record = json.loads(raw(failure['path']))
assert record['author'] == '/root' and record['I9_memory_test_runs'] == 1
assert record['actual_completed_case_count'] == 0 and record['actual_suite_passed'] is False
assert record['target_execution'] is False and record['tests_executed'] is False
created = []
items = [
    ('ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_001.py', '5083b9ae7e0ce1e00ab32e18ff29444e2a7ba43899f4fc85476cefa91d7705de'),
    ('ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_001.py', '0afdd67deb2d58903ef875ccf449eac6d1bb8bead3a5a07d27f78528ca8d02e1'),
    ('ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_001.py', '912cb31ae11008f786fedcc545bbecb5b8f4118ab815afe93cf64e5a63a47645'),
]
for name, digest in items:
    original = fact(P / name)
    assert original['sha256'] == digest
    text = raw(P / name).decode()
    if name.startswith('ROOT_ADOPT_I9_FINAL'):
        anchor = "    'ROOT_I9_QUARTET002_ACTUAL_CACHED_RECORD_SOURCE_REFUSAL_AND_CORRECTION_ADOPTION_001.json': 'ae2db2562692be5d3abc1f9111fd1025ef717f60f7ffd5fa74c16f135dd12cc6',\n"
        text = replace(text, anchor, anchor + "    '" + Path(failure['path']).name + "': '" + failure['sha256'] + "',\n")
        anchor = '        quartet002_cached_record_refusal_adoption=authority_inputs[11],\n'
        text = replace(text, anchor, anchor + '        prior_actual_memory_refusal_adoption=authority_inputs[12],\n')
        text = replace(text, 'I9_memory_test_runs=0', 'I9_memory_test_runs=1')
        text = replace(text, 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json', 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json')
    elif name.startswith('ROOT_BIND'):
        for old, new in (
            ('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json', 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json'),
            ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_001.json', 'ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_002.json'),
            ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_001.json', 'ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_002.json'),
            ('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_001.py', 'ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_002.py'),
            ('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_001.py', 'ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_002.py'),
            ('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_001.py', 'ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_002.py'),
            ('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_001.py', 'ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_002.py'),
        ):
            text = replace(text, old, new)
        text = replace(text, 'attempt_numbers=[1]', 'attempt_numbers=[2]', count=2)
    else:
        for old, new, count in (
            ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_001.json', 'ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_002.json', 1),
            ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_001.json', 'ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_002.json', 1),
            ('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json', 'ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION_002.json', 2),
            ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_001.json', 'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_002.json', 1),
            ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION_001.json', 'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION_002.json', 1),
            ("s['attempt_number'] == 1", "s['attempt_number'] == 2", 1),
            ('I9_memory_test_runs=0', 'I9_memory_test_runs=1', 1),
        ):
            text = replace(text, old, new, count)
    output_name = name.replace('_001.py', '_002.py')
    data = text.encode()
    ast.parse(data)
    compile(data, str(P / output_name), 'exec')
    created.append(dict(original_Source=original, new_Source=save(P / output_name, data)))
receipt = dict(schema_version=1, record_type='Root_I9_second_attempt_metadata_tool_Source_author_receipt',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    prior_actual_memory_refusal_adoption=failure, subjects=created, I9_memory_test_runs=1,
    prior_attempt001_and_all_original_Sources_preserved=True, new_attempt_number=2,
    new_Source_scripts_invoked=False, new_bound_tools_or_scope_not_yet_born=True,
    target_execution=False, tests_executed=False, automatic_retry_authorized=False,
    operational_authority=False, scientific_authority=False)
print(json.dumps(save(P / 'ROOT_I9_SECOND_ATTEMPT_METADATA_TOOL_SOURCE_AUTHOR_RECEIPT_001.json', receipt)))
