store={};pins={}
def add(p):
 b=Path(p['path']).read_bytes();assert 0<len(b)<=2097152 and len(b)==p['bytes'] and hashlib.sha256(b).hexdigest()==p['sha256'];store[p['path']]=base64.b64encode(b).decode();pins[p['path']]=p;return b
sel=json.loads(add(c['CURRENT_ROOT_SELECTION']));c['HISTORICAL45_PIN']=sel['current_complete45_inventory'];add(c['HISTORICAL45_PIN']);add(c['EXISTING_LEASE010'])
