for r in sel['rows']:add(r['predecessor'])
for r in inv['roles']:add(r['available_basis'])
manifest=next(r for r in inv['roles'] if r['role']=='metadata_manifest');m=json.loads(add(manifest['available_basis']))
for index in (1,6,7,8,9,10,11):
 q=m['payloads'][index];add(dict(path=str(Path(manifest['available_basis']['path']).parent/q['path']),bytes=q['bytes'],sha256=q['sha256']))
audit=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001\capsule-design-independent-review001\AUDIT_MANIFEST_001.json');a=json.loads(audit.read_bytes());bysha={p['sha256']:p for p in a['files']};c['FIXED_BINDING_SOURCE_DATA']={}
for key,digest in c['CURRENT_PLAN_BINDINGS'].items():
 if key in c['RENEWED_BINDINGS']:continue
 if key.startswith('coordination_'):
  role='COORDINATION_PEER_REPLY_RELATIVE' if key=='coordination_peer_reply_sha256' else 'COORDINATION_ROOT_RESPONSE_RELATIVE';p=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001')/c['CURRENT_PLAN_ROLE_SELECTIONS'][role];b=p.read_bytes();assert hashlib.sha256(b).hexdigest()==digest
 elif key=='source_projection_sha256':
  p=Path(r'D:\Aenv\pro2\resume-2026-10-03-continuation001\consumer005-guard006-runtime-prep001\SOURCE_INPUTS_PROJECTION_006.json');b=p.read_bytes();assert hashlib.sha256(b).hexdigest()==digest
 else:
  row=bysha[digest];p=audit.parent/row['path'];b=p.read_bytes();assert hashlib.sha256(b).hexdigest()==digest
 c['FIXED_BINDING_SOURCE_DATA'][key]=dict(original_path=str(p),bytes=len(b),sha256=digest,base64=base64.b64encode(b).decode())
value=dict(constants=c,records=store,pins=pins)
blob=json.dumps(value,sort_keys=True,separators=(',',':')).encode();packed=zlib.compress(blob,9)
source=('FIXTURE_FIXED_DATA_DECODED_BYTES = '+str(len(blob))+'\nFIXTURE_FIXED_DATA_DECODED_SHA256 = '+repr(hashlib.sha256(blob).hexdigest())+'\nFIXTURE_FIXED_DATA_ZLIB_BASE64 = '+repr(base64.b64encode(packed).decode())+'\n').encode()
with (OWN/'I9_FIXED_BYTE_LITERAL_SOURCE_FRAGMENT_001.py').open('xb') as f:f.write(source)
subjects=[dict(path=str(OLD),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),dict(path=str(audit),bytes=audit.stat().st_size,sha256=hashlib.sha256(audit.read_bytes()).hexdigest()),*pins.values()]
receipt=dict(author='/root/i9_fixture_author',record_type='I9_fixed_existing_bytes_literal_authoring_receipt',fixed_inputs=subjects,decoded_bytes=len(blob),decoded_sha256=hashlib.sha256(blob).hexdigest(),source_fragment=dict(path=str(OWN/'I9_FIXED_BYTE_LITERAL_SOURCE_FRAGMENT_001.py'),bytes=len(source),sha256=hashlib.sha256(source).hexdigest()),target_or_fixture_executed=False,physical_births_observed=False,all_future_context_and_births_synthetic=True)
with (OWN/'I9_FIXED_BYTE_LITERAL_AUTHOR_RECEIPT_001.json').open('xb') as f:f.write((json.dumps(receipt,sort_keys=True,indent=2)+'\n').encode())
