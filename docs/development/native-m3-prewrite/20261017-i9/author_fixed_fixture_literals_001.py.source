names=['CURRENT_ROOT_SELECTION','EXISTING_LEASE010','INVENTORY_PIN','BASIS_PIN','INVENTORY_REVIEW','INVENTORY_ADOPTION','HISTORICAL_SOURCE023_ARTIFACTS','CURRENT_PLAN_BINDINGS','CURRENT_PLAN_ROLE_SELECTIONS','RENEWED_BINDINGS','TEMPLATE_ROLES','PHASE_BOUND_ROLES','CAPTURE_SLOTS','FIXED_CONTEXT_ANCHORS','ROLE_SOURCE_CAPS','M3_ROLES','GENERATED_ROLES','PEER_ROLES']
