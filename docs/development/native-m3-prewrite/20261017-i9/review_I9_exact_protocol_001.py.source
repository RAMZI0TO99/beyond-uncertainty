def fact(p):
 p=Path(p);b=p.read_bytes();assert 0<len(b)<=CAP
 q=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
 if str(p) in inputs:assert inputs[str(p)]==q
 inputs[str(p)]=q;raws[str(p)]=b;return q
def pin(q):assert fact(q['path'])==q;return raws[q['path']]
def pairs(rows):
 d={}
 for k,v in rows:assert k not in d;d[k]=v
 return d
def bad(v):raise ValueError(v)
def obj(b):return json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def ck(name,value,evidence):
 assert type(value) is bool and name not in {c['name'] for c in checks}
 checks.append(dict(name=name,passed=value,evidence=evidence))
def load(p):
 q=fact(p);b=raws[q['path']];t=ast.parse(b);defs={n.name:n for n in t.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))};constants={}
 for n in t.body:
  if isinstance(n,ast.Assign):
   value=n.value
   if isinstance(value,ast.Call) and isinstance(value.func,ast.Name) and value.func.id in ('frozenset','set','tuple') and len(value.args)==1:value=value.args[0]
   try:value=ast.literal_eval(value)
   except (ValueError,TypeError,SyntaxError):continue
   for target in n.targets:
    if isinstance(target,ast.Name):constants[target.id]=value
 return q,b,t,defs,constants
def span(source,name):
 q,b,t,defs,constants=source;n=defs[name];s=ast.get_source_segment(b.decode(),n);raw=s.encode()
 r=dict(Source=q,name=name,first_line=n.lineno,last_line=n.end_lineno,AST_region_bytes=len(raw),AST_region_sha256=hashlib.sha256(raw).hexdigest(),region_convention='AST exact source segment; module hash covers retained line endings and whole bytes')
 regions.append(r);return s

