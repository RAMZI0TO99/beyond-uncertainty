"""Adopt reviewed saved failure001 and fixture-only route correction; no rerun."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and 0 <= q['bytes'] <= CAP
    data = raw(q['path'])
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
cp = fact(P / 'saved_refusal_review_002/INDEPENDENT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_CAPSULE_001.json')
assert cp['sha256'] == '20b78181fe49a1bac92baf57dd206292d59e9bcc3f9c9a7c209e178a57745b97'
c = obj(pin(cp))
f = obj(pin(c['full_proof']))
for record in (c, f):
    assert record['reviewer'] == '/root/owner_source_review' and record['source_author'] == '/root'
    assert record['verdict'] == 'PASS_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_NO_RERUN'
    assert record['target_execution'] is False and record['tests_executed'] is False
    assert type(record['checks_failed']) is int and record['checks_failed'] == 0
    assert type(record['checks_passed']) is int and record['checks_passed'] == 1962
    assert type(record['I9_fixture_reruns']) is int and record['I9_fixture_reruns'] == 0
checks = f['checks']
assert len(checks) == 1962 and len({q['name'] for q in checks}) == 1962
assert all(type(q['passed']) is bool and q['passed'] is True for q in checks)
inputs = f['all_actual_inputs']
assert len(inputs) == 251 and len({q['path'].casefold() for q in inputs}) == 251
assert c['reviewer_Source'] in inputs
for q in inputs:
    pin(q)
sp = fact(P / 'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_002.json')
rp = fact(P / 'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_002.json')
vp = fact(P / 'ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_002.json')
ep = fact(P / 'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_002.json')
assert c['subjects'] == f['subjects'] == [sp, rp, vp, ep]
r = obj(pin(rp))
v = obj(pin(vp))
e = obj(pin(ep))
assert r['scope'] == v['scope'] == e['scope'] == sp
assert r['tests_executed'] is True and type(r['I9_memory_test_runs']) is int and r['I9_memory_test_runs'] == 1
assert r['actual_test_case_count'] == 0 and type(r['actual_test_case_count']) is int
assert r['all_cases_passed'] is False and r['failed_or_last_case_at_failure'] == 'positive_complete_templates5'
assert r['error'] == dict(type='I9MetadataError', message='E_AUTHORITY')
assert r['blocked_forbidden_event_names'] == []
assert v['passed'] is False and v['owned_child_exit_code'] == 1
assert v['owned_child_wait_reaped'] is True and v['stream_reader_threads_joined'] is True
assert v['owned_child_wall_integer_nanoseconds'] == 4347512800 and e['all_streams_complete'] is True
assert f['Source_cause']['classification'] == 'implementation_incompatible_fixed_historical_Source_adoption_authority_predicate'
assert len(f['Source_cause']['immutable_legacy_adoptions']) == 2
scope = obj(raw(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json'))
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end'])
result = dict(schema_version=1, record_type='Root_actual_I9_attempt002_saved_refusal_and_fixed_adoption_compatibility_adoption',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='ACCEPT_I9_ATTEMPT002_SAVED_REFUSAL_AND_EXACT_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ONLY',
    different_saved_refusal_review=cp, full_proof=c['full_proof'], reviewer_Source=c['reviewer_Source'],
    actual_named_checks=1962, actual_rehashed_review_inputs=251, all_actual_inputs_rehashed=True,
    consumed_scope=sp, actual_saved_result=rp, actual_owned_supervisor_result=vp, actual_owned_streams=ep,
    I9_memory_test_runs=2, failed_memory_test_runs=2, accepted_complete_memory_test_runs=0,
    actual_suite_passed=False, actual_completed_case_count=0, actual_planned_case_count=96,
    actual_suite_tests_executed=True, actual_failed_case='positive_complete_templates5',
    actual_error='E_AUTHORITY', Source_cause=f['Source_cause'],
    exact_correction='Use compatibility only for fixed_full plus an exact immutable I0/I1 support4/subject/editor/full bundle. Require its actual typed historical entry/native false flags, OP/science false, Root ACCEPT, complete subject/capsule/full coverage and chronology; optional target_execution false when present. Mismatched fixed context refuses. Keep generic current guard bodies byte-exact. Add the 97th full-public current-producer missing-target field refusal with exact E_AUTHORITY.',
    generic_current_adoption_and_authority_guard_bodies_must_remain_byte_exact=True,
    fixed_pin_only_legacy_module_API_receipt_and_regression_Source_successors_authorized=True,
    prior_scopes001_and002_consumed_forever_and_all_evidence_preserved=True,
    corrected_Source_requires_different_review_and_Root_adoption=True,
    next_invocation_requires_new_bound_tools_and_separately_fresh_reviewed_scope003=True,
    new_invocation_authorized_now=False, automatic_retry_authorized=False,
    target_execution=False, tests_executed=False,
    old_I0_I8_changes_or_invocations_authorized=False, actual_family_publication=False,
    all_actual_new_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= CAP
path = P / 'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json'
with path.open('xb') as handle:
    handle.write(data)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(fact(path)))
