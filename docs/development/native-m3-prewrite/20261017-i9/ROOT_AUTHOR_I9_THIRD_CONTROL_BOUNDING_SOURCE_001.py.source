"""Extend uninvoked third-control authoring with the exact reviewed-predicate scope."""
import ast, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
old = P / 'ROOT_AUTHOR_I9_REFUSAL002_AND_ATTEMPT003_CONTROLS_001.py'
data = old.read_bytes()
text = data.decode()
before = 'anchor + "    \'" + FAILURE_NAME + "\': \'" + failure[\'sha256\'] + "\',\\n")'
after = 'anchor + "    \'" + FAILURE_NAME + "\': \'" + failure[\'sha256\'] + "\',\\n" + "    \'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json\': \'397a33473d37c8e6a0c3d4f166f9eca23ee8d3af8b54bf34af507e38d2cc2a31\',\\n")'
assert text.count(before) == 1
text = text.replace(before, after)
before = "anchor + '        prior_actual_memory_refusal002_adoption=authority_inputs[13],\\n')"
after = "anchor + '        prior_actual_memory_refusal002_adoption=authority_inputs[13],\\n        equivalent_surrogate_scan_correction=authority_inputs[14],\\n')"
assert text.count(before) == 1
text = text.replace(before, after)
anchor = "    failure = fact(P / FAILURE_NAME)\n"
extra = "    performance = fact(P / 'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json')\n    assert performance['sha256'] == '397a33473d37c8e6a0c3d4f166f9eca23ee8d3af8b54bf34af507e38d2cc2a31'\n"
assert text.count(anchor) == 1
text = text.replace(anchor, extra + anchor)
path = P / 'ROOT_AUTHOR_I9_REFUSAL002_AND_ATTEMPT003_CONTROLS_002.py'
out = text.encode()
ast.parse(out)
compile(out, str(path), 'exec')
with path.open('xb') as handle:
    handle.write(out)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(dict(path=str(path), bytes=len(out), sha256=hashlib.sha256(out).hexdigest(), authored_Source_body_invoked=False)))
