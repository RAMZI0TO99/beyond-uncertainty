"""Root rehashes actual different final-quartet Source review; no target calls."""
import ast
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sys

P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
REQUIRED = {
    'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json': '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d',
    'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json': '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc',
    'ROOT_I9_PROTOCOL001_BOUNDED_AST_AND_AGGREGATE_READER_CLARIFICATION_001.json': '07b09a988e8d8328c2f5362e90a5bbc144eff6af7bc65fd5bf37d414d17783aa',
    'ROOT_I9_PROTOCOL001_OPEN_PROOF_FLAGS_AND_CANONICAL_CODEC_CLARIFICATION_001.json': '483451d49c32be2a7d45ac4cb0d372890695f0b0c68951b7368e983ce8046e8f',
    'ROOT_I9_PROTOCOL001_RECORDED_BOOTSTRAP_CLOSURE_AND_EXTERNAL_AUTHORITY_BOUNDARY_001.json': 'bb4a6d54e210d722847b96e68ad761486a59085abe30c4031985b9f41ebab982',
    'ROOT_I9_PROTOCOL001_EXACT_CURRENT_DIFF_HEADER_CLARIFICATION_001.json': 'e88cb920fbb000eff1b3efbb7135167e465f2e7d7c836e4c833516d7ee63d974',
    'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json': 'f2447b86e8178a59f94e5fd4d75866d27ba83f994bc5f9d60ca5b9a5599bcc0f',
    'ROOT_I9_CURRENT_ACTOR_OPEN_PROOF_ADAPTATION_SOURCE_CLARIFICATION_001.json': '94f6c2be74c5350b9f6d1323d57e8e5f420987f5132985df7c141336d5771f66',
    'ROOT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json': 'a9de80e3d8313a953d01aa13b60e21867bccc096e43bab0010318855ca7aea6b',
    'ROOT_I9_MODULE001_ACTUAL_SOURCE_REFUSAL_AND_THREE_CORRECTION_ADOPTION_001.json': '89a9f3f39cc4214b7d16bb25b49f05c9ad6a9ff186603eb54bb0897468982e34',
    'ROOT_I9_FIXTURE001_ACTUAL_SOURCE_REFUSAL_AND_EXISTING_CASE_CORRECTION_ADOPTION_001.json': '67790eef2b5b57458a27eb6a303c59576f4887c583d80b031c9d5c6034892207',
    'ROOT_I9_QUARTET002_ACTUAL_CACHED_RECORD_SOURCE_REFUSAL_AND_CORRECTION_ADOPTION_001.json': 'ae2db2562692be5d3abc1f9111fd1025ef717f60f7ffd5fa74c16f135dd12cc6',
    'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json': 'b8c5e65fe9f3f72ce6fda9299ce6d97a749ccccb8f98da308775efe3354a90ff',
    'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json': '0330ddd4a175904215a1679deaf7cdf232393546fef49063b43b3488080e6077',
    'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json': '397a33473d37c8e6a0c3d4f166f9eca23ee8d3af8b54bf34af507e38d2cc2a31',
}
PATTERNS = {
    'module_Source': r'validate_recorded_M3_semantics_[0-9]{3}\.py',
    'fixture_Source': r'test_recorded_M3_semantics_memory_only_[0-9]{3}\.py',
    'API': r'CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_[0-9]{3}\.json',
    'author_receipt': r'CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_[0-9]{3}\.json',
}

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['path']) is str and type(q['bytes']) is int and 0 <= q['bytes'] <= CAP
    if q['bytes'] == 0:
        assert Path(q['path']).parent == P and re.fullmatch(r'ROOT_I9_ACTUAL_MEMORY_CHILD_(?:STDOUT|STDERR)_[0-9]{3}\.txt', Path(q['path']).name)
    assert type(q['sha256']) is str and re.fullmatch('[0-9a-f]{64}', q['sha256'])
    data = raw(q['path'])
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def main():
    assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
    assert len(sys.argv) == 3 and re.fullmatch('[0-9a-f]{64}', sys.argv[2])
    capsule_path = Path(sys.argv[1])
    assert capsule_path.parent.parent == P and 'CAPSULE' in capsule_path.name
    capsule_pin = fact(capsule_path)
    assert capsule_pin['sha256'] == sys.argv[2]
    capsule = obj(pin(capsule_pin))
    full_pin = capsule['full_proof']
    full = obj(pin(full_pin))
    reviewer_source = capsule['reviewer_Source']
    pin(reviewer_source)
    for record in (capsule, full):
        assert record['reviewer'] == '/root/owner_source_review'
        assert record['source_author'] == '/root/phase_frontier'
        assert record['target_execution'] is False and record['tests_executed'] is False
        assert type(record['checks_failed']) is int and record['checks_failed'] == 0
        assert record['verdict'].startswith(('PASS_', 'ACCEPT_'))
    assert capsule['verdict'] == full['verdict']
    checks = full['checks']
    assert type(checks) is list and checks and len({c['name'] for c in checks}) == len(checks)
    assert all(type(c['name']) is str and c['name'] and type(c['passed']) is bool and c['passed'] for c in checks)
    assert type(full['checks_passed']) is int and full['checks_passed'] == len(checks)
    assert type(capsule['checks_passed']) is int and capsule['checks_passed'] == len(checks)
    inputs = full['all_actual_inputs']
    assert type(inputs) is list and inputs and len({q['path'].casefold() for q in inputs}) == len(inputs)
    for q in inputs:
        pin(q)
    assert reviewer_source in inputs
    subjects = capsule['subjects']
    assert type(subjects) is list and len(subjects) == 4 and subjects == full['subjects']
    selected = {}
    for role, pattern in PATTERNS.items():
        matches = [q for q in subjects if Path(q['path']).parent == P / 'i9' and re.fullmatch(pattern, Path(q['path']).name)]
        assert len(matches) == 1 and matches[0] in inputs
        selected[role] = matches[0]
        pin(matches[0])
    source_author = obj(pin(selected['author_receipt']))
    assert source_author['author'] == '/root/phase_frontier'
    assert source_author['actual_physical_Source_editor'] == '/root/phase_frontier'
    assert source_author['fixture_content_contributor'] == '/root/i9_fixture_author'
    assert source_author['Source'] == selected['module_Source']
    assert source_author['fixture_Source'] == selected['fixture_Source'] and source_author['API'] == selected['API']
    execution = source_author['tests_and_execution']
    assert execution == dict(Native_or_Parser_invoked=False, fixture_function_calls=0,
        fixture_imports=0, module_function_calls=0, module_imports=0,
        new_tests_executed=False, old_modules_imported_or_called=False)
    assert all(type(execution[k]) is int for k in ('fixture_function_calls', 'fixture_imports', 'module_function_calls', 'module_imports'))
    proposal = source_author['fixture_content_proposal']
    contributor = source_author['fixture_content_contributor_receipt']
    assert proposal in inputs and contributor in inputs
    pin(proposal)
    assert obj(pin(contributor))['author'] == '/root/i9_fixture_author'
    authority_inputs = []
    for name, digest in REQUIRED.items():
        q = fact(P / name)
        assert q['sha256'] == digest and q in inputs
        authority_inputs.append(q)
    window = obj(pin(authority_inputs[0]))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(window['interval_end'])
    api = obj(pin(selected['API']))
    interface = api['fixture_interface']
    tree = ast.parse(pin(selected['fixture_Source']))
    literals = {}
    for node in tree.body:
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id in ('EXPECTED_CASE_COUNT', 'PLANNED_CASE_NAMES'):
                    assert target.id not in literals
                    literals[target.id] = ast.literal_eval(node.value)
    count = literals['EXPECTED_CASE_COUNT']
    names = literals['PLANNED_CASE_NAMES']
    assert type(count) is int and 1 <= count <= 256
    assert type(names) in (tuple, list) and len(names) == len(set(names)) == count
    assert all(type(name) is str and name for name in names)
    assert interface['entry'] == 'run_memory_suite(module)'
    assert type(interface['expected_case_count']) is int and interface['expected_case_count'] == count
    assert interface['planned_case_names'] == list(names)
    assert interface['source_only'] is True and interface['memory_only'] is True
    assert type(interface['filesystem_calls']) is int and interface['filesystem_calls'] == 0
    assert interface['tests_executed'] is False and interface['project_or_native_tests'] is False
    result = dict(schema_version=1, record_type='Root_actual_I9_final_quartet_different_Source_review_adoption',
        author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        verdict='ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY', subjects=subjects,
        scope=authority_inputs[0], protocol_subjects=authority_inputs[1:6],
        protocol_adoption=authority_inputs[6], actor_clarifier=authority_inputs[7],
        actor_clarifier_adoption=authority_inputs[8], module001_refusal_adoption=authority_inputs[9],
        fixture001_refusal_adoption=authority_inputs[10],
        quartet002_cached_record_refusal_adoption=authority_inputs[11],
        prior_actual_memory_refusal_adoption=authority_inputs[12],
        prior_actual_memory_refusal002_adoption=authority_inputs[13],
        equivalent_surrogate_scan_correction=authority_inputs[14],
        different_Source_review=capsule_pin, full_proof=full_pin, reviewer_Source=reviewer_source,
        actual_named_checks=len(checks), actual_rehashed_input_count=len(inputs),
        all_actual_review_inputs_rehashed=True, actual_fixture_case_count=count,
        target_execution=False, tests_executed=False, I9_memory_test_runs=2,
        new_module_or_fixture_invocation_authorized_now=False,
        actual_family_Source_publication_authorized=False, real_family_entry_unconditionally_held=True,
        fixture_invocation_requires_fresh_separate_one_use_Root_scope=True,
        all_actual_grants_lease_family_Native8_Parser_results=None,
        operational_authority=False, scientific_authority=False)
    data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(data) <= CAP
    output = P / 'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_003.json'
    with output.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    print(json.dumps(fact(output)))

if __name__ == '__main__':
    main()
