tools={};tool_pins=[]
for role,path in config['tool_Source_paths'].items():
    text,tree,q=source(path);tools[role]=(text,tree,q);tool_pins.append(q)
    row=next(r for r in receipt['subjects'] if r['role']==role)
    traw=read_pin(row['original_TEMPLATE']);template=traw.decode();ttree=ast.parse(traw)
    check(role+' actual Source pin joins binding receipt',row['new_Source']==q)
    old=next(n for n in ttree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets))
    new=next(n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets))
    check(role+' literal bindings exactly equal actual config',ast.literal_eval(new.value)==config and isinstance(old.value,ast.Constant) and old.value.value is None)
    # Remove only first docstring and restore ONLY binding value. Every other Source byte stays exact.
    restored=text.replace(ast.get_source_segment(text,new),'EXACT_ROOT_BINDINGS = None',1)
    restored_tree=ast.parse(restored)
    rlines=restored.splitlines(keepends=True);tlines=template.splitlines(keepends=True)
    check(role+' entire immutable template complement byte exact',''.join(rlines[restored_tree.body[0].end_lineno:])==''.join(tlines[ttree.body[0].end_lineno:]))
    contains(role+' shared Source/scope guard',text,["'UNBOUND_I9_MEMORY_TOOLING_TEMPLATE'","'ISOLATED_NO_SITE_NO_BYTECODE'","'EXACT_BOUND_SELF_SOURCE_PATH'","'SOURCE_RESERVE60'","'NEW_I9_ONLY'","'FINITE_OUTPUT_NAMES'","'EXACT_SCOPE_BINDING:'","'EXACT_TOOL_SCOPE_PATH'","'SCOPE_API_CASE_JOIN'","'automatic_retry_authorized':False"],path)
