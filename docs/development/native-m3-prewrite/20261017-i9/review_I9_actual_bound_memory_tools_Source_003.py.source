"""Independent finite Root-tool Source review. Never invokes bound tools or target code."""
import ast
import datetime
import hashlib
import json
import re
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
OWN=P/'bound_tool_review_001'
CAP=2097152
INPUTS={};CHECKS=[]
def data(path):
    path=Path(path);raw=path.read_bytes()
    assert 0<len(raw)<=CAP,path
    q=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
    key=q['path'].casefold();assert key not in INPUTS or INPUTS[key]==q
    INPUTS[key]=q
    return raw,q
def read_json(path):
    raw,p=data(path)
    def pairs(items):
        value={}
        for k,v in items:assert k not in value;value[k]=v
        return value
    def reject(v):raise ValueError(v)
    value=json.loads(raw,object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
    assert type(value) is dict
    return value,p
def read_pin(value):
    assert type(value) is dict and set(value)=={'path','bytes','sha256'} and type(value['bytes']) is int and 0<value['bytes']<=CAP
    assert type(value['path']) is str and type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}',value['sha256'])
    raw,q=data(value['path']);assert q==value
    return raw
def check(name,passed,*,path=None,line=None):
    assert type(passed) is bool
    row=dict(name=name,passed=passed)
    if path is not None:row['Source_path']=str(path)
    if line is not None:row['first_line']=line
    CHECKS.append(row)
def source(path):
    raw,p=data(path);tree=ast.parse(raw);compile(raw,str(path),'exec')
    return raw.decode(),tree,p
def function(text,tree,name):
    n=next(n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name==name)
    return ast.get_source_segment(text,n),n
def contains(label,text,parts,path):
    for i,part in enumerate(parts,1):
        index=text.find(part)
        check(label+' '+str(i),index>=0,path=path,line=(text[:index].count('\n')+1 if index>=0 else None))
def save(path,value):
    raw=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert 0<len(raw)<=CAP and not path.exists()
    with path.open('xb') as f:f.write(raw)
    assert path.read_bytes()==raw
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())

