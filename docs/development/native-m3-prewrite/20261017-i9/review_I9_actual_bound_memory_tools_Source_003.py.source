                assert t.id not in literals;literals[t.id]=ast.literal_eval(n.value)
check('Actual API fixture count and ordered names join98 literal Source cases',literals['EXPECTED_CASE_COUNT']==98 and type(literals['EXPECTED_CASE_COUNT']) is int and len(literals['PLANNED_CASE_NAMES'])==len(set(literals['PLANNED_CASE_NAMES']))==98 and api['fixture_interface']['entry']=='run_memory_suite(module)' and api['fixture_interface']['expected_case_count']==98 and api['fixture_interface']['planned_case_names']==list(literals['PLANNED_CASE_NAMES']))
# This is binding metadata inspection only; no target semantic acceptance is issued here.
observed_imports=set()
for raw in (read_pin(config['module_Source']),fixture_raw):
    for n in ast.walk(ast.parse(raw)):
        if isinstance(n,ast.Import):observed_imports.update(x.name for x in n.names)
        if isinstance(n,ast.ImportFrom):observed_imports.add(n.module)
check('Exact actual final literal imports drive finite preloading',sorted(observed_imports)==config['exact_import_modules'] and sorted({n.split('.')[0] for n in observed_imports})==config['approved_import_roots'])
