contains('Supervisor actual resources distinct from Native8',supervisor,['GlobalMemoryStatusEx','shutil.disk_usage(P).free','status.available >= 1073741824 and disk >= 10737418240','FileTime_or_Native8_collection=False','age_limit_seconds=60'],sp['path'])
contains('Supervisor wall cleanup streams',supervisor,['observed-launch > 60000000000','proc.kill()  # Only the exact Popen child','code = proc.wait(timeout=5)','5000000000-(time.monotonic_ns()-cleanup_started)','thread.join(timeout=remaining)',"available = max(0,CAP-state['saved_bytes'])","state['overcap'] = True",'wall > 60000000000','passed=reason is None and code == 0 and reaped and joined'],sp['path'])
