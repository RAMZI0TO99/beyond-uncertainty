prior=ast.parse(oldraw)
def planned(t):
    return {n.targets[0].id:ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('PLANNED_CASE_NAMES','EXPECTED_CASE_COUNT')}
names=planned(tree);assert names==planned(prior) and names['EXPECTED_CASE_COUNT']==95
assert len(newraw)<=2097152
