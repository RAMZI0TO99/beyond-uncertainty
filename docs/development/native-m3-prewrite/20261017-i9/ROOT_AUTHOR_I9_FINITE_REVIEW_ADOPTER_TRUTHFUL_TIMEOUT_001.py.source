"""Author immutable finite-review adopter for the exact known/unknown history."""
import ast, datetime, hashlib, json, os, sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data=path.read_bytes(); assert len(data)<=2097152
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
def replace(text,old,new):
    assert text.count(old)==1
    return text.replace(old,new)
def save(path,data):
    assert len(data)<=2097152
    with path.open('xb') as handle:
        handle.write(data); handle.flush(); os.fsync(handle.fileno())
    return fact(path)
assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
original=P/'ROOT_ADOPT_I9_FINITE_MANAGED_PUBLICATION_REVIEW_001.py'
text=original.read_text(encoding='utf-8')
text=replace(text,"    assert implementation['I9_memory_test_runs'] == implementation['failed_memory_test_runs'] + 1",
"    assert implementation['I9_memory_test_runs'] is None\n    assert implementation['known_I9_memory_test_runs'] == f['known_I9_memory_runs_saved_and_adopted'] == 5\n    assert implementation['unknown_I9_memory_test_runs'] == f['unknown_I9_memory_runs_preserved'] == 1\n    assert implementation['spent_memory_scope_count'] == f['spent_memory_scopes_saved'] == 6\n    assert implementation['known_I9_memory_test_runs'] == implementation['failed_memory_test_runs'] + 1")
text=replace(text,"        I9_memory_test_runs=implementation['I9_memory_test_runs'],",
"        I9_memory_test_runs=implementation['I9_memory_test_runs'],\n        known_I9_memory_test_runs=implementation['known_I9_memory_test_runs'],\n        unknown_I9_memory_test_runs=implementation['unknown_I9_memory_test_runs'],\n        spent_memory_scope_count=implementation['spent_memory_scope_count'],")
new=P/'ROOT_ADOPT_I9_FINITE_MANAGED_PUBLICATION_REVIEW_002.py'
ast.parse(text); compile(text,str(new),'exec')
q=save(new,text.encode())
record=dict(schema_version=1,author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    original_Source=fact(original),new_Source=q,exact_unknown_ordinal=5,
    old_Source_preserved=True,new_Source_invoked=False,target_execution=False,tests_executed=False,
    operational_authority=False,scientific_authority=False)
print(json.dumps(save(P/'ROOT_I9_FINITE_REVIEW_ADOPTER_TRUTHFUL_TIMEOUT_SOURCE_RECEIPT_001.json',(json.dumps(record,sort_keys=True,indent=2,allow_nan=False)+'\n').encode())))
