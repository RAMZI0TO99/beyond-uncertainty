"""Author immutable next-attempt metadata controls from actual previous Sources."""
import ast, datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    data = path.read_bytes()
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def save(path, value):
    data = value if type(value) is bytes else (json.dumps(value, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(data) <= CAP
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    return fact(path)

def replace(text, before, after, count=1):
    assert text.count(before) == count, (before, text.count(before), count)
    return text.replace(before, after)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv) == 3 and re.fullmatch('[0-9a-f]{64}', sys.argv[2])
attempt = int(sys.argv[1])
assert 4 <= attempt <= 999 and sys.argv[1] == f'{attempt:03d}'
previous = attempt - 1
failure = fact(P / f'ROOT_I9_ATTEMPT{previous:03d}_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json')
assert failure['sha256'] == sys.argv[2]
r = json.loads(raw(failure['path']))
assert r['author'] == '/root' and r['I9_memory_test_runs'] == previous
assert r['failed_memory_test_runs'] == previous and r['accepted_complete_memory_test_runs'] == 0
assert r['target_execution'] is False and r['tests_executed'] is False
source_pattern = r'ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_([0-9]{3})\.py'
final_candidates = sorted((int(re.fullmatch(source_pattern, q.name).group(1)), q) for q in P.glob('ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_*.py') if re.fullmatch(source_pattern, q.name))
adopter_number, final_path = final_candidates[-1]
tool_path = P / f'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_{adopter_number:03d}.py'
assert tool_path.is_file()
binder_path = P / f'ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_{previous:03d}.py'
created = []
for original_path, new_name in (
    (final_path, f'ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_{adopter_number+1:03d}.py'),
    (binder_path, f'ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_{attempt:03d}.py'),
    (tool_path, f'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_{adopter_number+1:03d}.py'),
):
    original = fact(original_path)
    text = raw(original_path).decode()
    if original_path == final_path:
        tree = ast.parse(text)
        assignment = next(node for node in tree.body if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'REQUIRED' for t in node.targets))
        literal = ast.get_source_segment(text, assignment.value)
        required = ast.literal_eval(assignment.value)
        assert type(required) is dict and Path(failure['path']).name not in required
        index = len(required)
        required[Path(failure['path']).name] = failure['sha256']
        text = replace(text, literal, repr(required))
        anchor = "        different_Source_review=capsule_pin, full_proof=full_pin, reviewer_Source=reviewer_source,\n"
        extra = f'        prior_actual_memory_refusal{previous:03d}_adoption=authority_inputs[{index}],\n'
        text = replace(text, anchor, extra + anchor)
        text = replace(text, f'I9_memory_test_runs={previous-1}', f'I9_memory_test_runs={previous}')
        text = replace(text, f'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_{previous:03d}.json', f'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_{attempt:03d}.json')
    elif original_path == binder_path:
        for base, suffix in (('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION', 'json'), ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS', 'json'), ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT', 'json'), ('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES', 'py'), ('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES', 'py'), ('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE', 'py'), ('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS', 'py')):
            text = replace(text, f'{base}_{previous:03d}.{suffix}', f'{base}_{attempt:03d}.{suffix}')
        text = replace(text, f'attempt_numbers=[{previous}]', f'attempt_numbers=[{attempt}]', 2)
    else:
        for base, count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS', 1), ('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT', 1), ('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION', 2), ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE', 1), ('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION', 1)):
            text = replace(text, f'{base}_{previous:03d}.json', f'{base}_{attempt:03d}.json', count)
        text = replace(text, f"s['attempt_number'] == {previous}", f"s['attempt_number'] == {attempt}")
        text = replace(text, f'I9_memory_test_runs={previous-1}', f'I9_memory_test_runs={previous}')
    data = text.encode()
    ast.parse(data)
    compile(data, str(P / new_name), 'exec')
    created.append(dict(original_Source=original, new_Source=save(P / new_name, data)))
record = dict(schema_version=1, record_type='Root_I9_next_once_metadata_control_Source_author_receipt',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    next_attempt_number=attempt, prior_actual_failure_adoption=failure,
    subjects=created, I9_memory_test_runs=previous, failed_memory_test_runs=previous,
    prior_sources_and_all_spent_scopes_preserved=True, new_Source_scripts_invoked=False,
    new_bound_tools_or_scopes_not_yet_born=True, automatic_retry_authorized=False,
    target_execution=False, tests_executed=False, operational_authority=False, scientific_authority=False)
print(json.dumps(save(P / f'ROOT_I9_ATTEMPT{attempt:03d}_METADATA_CONTROL_SOURCE_AUTHOR_RECEIPT_001.json', record)))
