"""UNBOUND I9 metadata-memory tooling template; never target/runtime qualification.

An immutable Root-owned successor must replace EXACT_ROOT_BINDINGS with the
actual reviewed finite configuration, then receive independent Source review.
This template is never a Source acceptance or an execution authorization.
"""
import ast
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import time

EXACT_ROOT_BINDINGS = None
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
SOURCE_VERDICT = 'ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY'
OLD_AUTHORITY_KEY = 'original_I0_I1_I2_I3_I4_I5_I6_I7_I8_native_Parser_project_invocations_authorized'
PYTHON = r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe'

def need(ok, message):
    if not ok:
        raise RuntimeError(message)

def now():
    return datetime.datetime.now(datetime.timezone.utc)

def pairs(items):
    result = {}
    for key, value in items:
        need(key not in result, 'DUPLICATE_JSON_KEY')
        result[key] = value
    return result

def bad_json(value):
    raise ValueError('NON_INTEGER_OR_NONFINITE_JSON_NUMBER')

def decode(data):
    need(type(data) is bytes and len(data) <= CAP, 'JSON_CAP')
    return json.loads(data.decode('utf-8', 'strict'), object_pairs_hook=pairs,
                      parse_float=bad_json, parse_constant=bad_json)

def raw(path):
    path = Path(path)
    need(path.is_file() and not path.is_symlink(), 'NOT_REGULAR_FILE')
    need(path.stat().st_size <= CAP, 'FILE_CAP')
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    need(len(data) <= CAP, 'READ_CAP')
    return data

def fact(path):
    path = Path(path)
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pinned(pin):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'}, 'CLOSED_F3')
    need(type(pin['path']) is str and type(pin['bytes']) is int and
         0 < pin['bytes'] <= CAP and type(pin['sha256']) is str and
         re.fullmatch('[0-9a-f]{64}', pin['sha256']) is not None, 'POSITIVE_F3')
    data = raw(pin['path'])
    need(len(data) == pin['bytes'] and hashlib.sha256(data).hexdigest() == pin['sha256'], 'PIN_CHANGED')
    return data

def equal_typed(left, right):
    if type(left) is not type(right):
        return False
    if type(left) is dict:
        return left.keys() == right.keys() and all(equal_typed(left[k], right[k]) for k in left)
    if type(left) is list:
        return len(left) == len(right) and all(equal_typed(a, b) for a, b in zip(left, right))
    return left == right

def checked_fields(record, expected):
    need(type(record) is dict and type(expected) is dict and expected, 'REQUIRED_EXACT_FIELDS')
    for name, value in expected.items():
        need(name in record and equal_typed(record[name], value), 'FIELD_MISMATCH:' + name)

def save(path, record):
    path = Path(path)
    need(path.parent == P and not path.exists(), 'FINITE_CREATE_ONCE_OUTPUT')
    data = (json.dumps(record, indent=2, sort_keys=True, allow_nan=False) + '\n').encode('utf-8')
    need(len(data) <= CAP, 'SERIALIZED_CAP')
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    need(raw(path) == data, 'OUTPUT_READBACK')
    return fact(path)

def bound():
    b = EXACT_ROOT_BINDINGS
    need(type(b) is dict, 'UNBOUND_I9_MEMORY_TOOLING_TEMPLATE')
    required = {'binding_schema', 'Root_author', 'protocol', 'protocol_Root_adoption',
        'protocol_adoption_required_fields', 'source_window', 'source_window_required_fields',
        'module_Source', 'fixture_Source', 'API', 'author_receipt', 'Source_adoption',
        'Source_adoption_required_fields', 'Source_adoption_subject_field',
        'Source_review_records', 'API_fixture_field', 'API_entry_field',
        'API_count_field', 'API_names_field', 'exact_import_modules',
        'approved_import_roots', 'maximum_profiled_module_calls',
        'required_positive_module_function_names', 'attempt_numbers',
        'scope_duration_seconds', 'tool_Source_paths', 'python_executable',
        'Source_window_end_field'}
    need(set(b) == required and b['binding_schema'] == 1 and b['Root_author'] == '/root', 'CLOSED_BINDINGS')
    need(b['python_executable'] == PYTHON, 'EXACT_PYTHON')
    need(type(b['attempt_numbers']) in (tuple, list) and b['attempt_numbers'] and
         all(type(n) is int and 1 <= n <= 999 for n in b['attempt_numbers']) and
         len(set(b['attempt_numbers'])) == len(b['attempt_numbers']), 'FINITE_ATTEMPTS')
    need(type(b['scope_duration_seconds']) is int and 65 <= b['scope_duration_seconds'] <= 1200,
         'REVIEWED_PRIVATE_SCOPE_DURATION')
    need(type(b['maximum_profiled_module_calls']) is int and b['maximum_profiled_module_calls'] > 0,
         'REVIEWED_FINITE_PROFILE_CAP')
    allowed = {'ast','difflib','zlib','base64','binascii','hashlib','json','re','datetime',
               'copy','types','collections','dataclasses','enum','functools','itertools',
               'operator','math','struct','typing','codecs','_strptime','locale','calendar'}
    need(type(b['approved_import_roots']) in (tuple, list) and
         set(b['approved_import_roots']) <= allowed, 'PURE_IMPORT_ROOTS')
    need(type(b['exact_import_modules']) in (tuple, list) and
         all(type(name) is str and re.fullmatch(r'[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*', name)
             and name.split('.')[0] in b['approved_import_roots'] for name in b['exact_import_modules']) and
         len(set(b['exact_import_modules'])) == len(b['exact_import_modules']), 'FINITE_LITERAL_IMPORTS')
    need(type(b['required_positive_module_function_names']) in (tuple, list) and
         b['required_positive_module_function_names'] and
         all(type(name) is str and name.isidentifier() for name in b['required_positive_module_function_names']),
         'ACTUAL_FINAL_API_PROFILE_SUBJECTS_REQUIRED')
    need(type(b['Source_adoption_subject_field']) is str and b['Source_adoption_subject_field'], 'EXACT_ADOPTION_SCHEMA')
    need(type(b['tool_Source_paths']) is dict and
         set(b['tool_Source_paths']) == {'runner', 'supervisor', 'scope_preparer', 'capture'} and
         all(type(path) is str and Path(path).is_absolute() and Path(path).suffix == '.py'
             and Path(path).parent in (P,P/'memory_tooling_001') for path in b['tool_Source_paths'].values()) and
         len(set(path.casefold() for path in b['tool_Source_paths'].values())) == 4, 'FINITE_TOOL_PATHS')
    return b

def names(attempt):
    need(type(attempt) is int and 1 <= attempt <= 999, 'ATTEMPT_RANGE')
    suffix = f'{attempt:03d}'
    return dict(scope=f'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_{suffix}.json',
        child_marker=f'ROOT_I9_MEMORY_SCOPE_CONSUMED_{suffix}.json',
        supervisor_marker=f'ROOT_I9_MEMORY_SUPERVISOR_CONSUMED_{suffix}.json',
        child_result=f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json',
        supervisor_result=f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_{suffix}.json',
        stdout=f'ROOT_I9_ACTUAL_MEMORY_CHILD_STDOUT_{suffix}.txt',
        stderr=f'ROOT_I9_ACTUAL_MEMORY_CHILD_STDERR_{suffix}.txt',
        capture=f'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_{suffix}.json')

def attempt_argument(b):
    need(len(sys.argv) == 2 and re.fullmatch('[0-9]{3}', sys.argv[1]) is not None, 'ONLY_FINITE_ATTEMPT_ARGUMENT')
    attempt = int(sys.argv[1])
    need(attempt in b['attempt_numbers'], 'ATTEMPT_NOT_REVIEWED')
    return attempt

def check_source(b):
    protocol = decode(pinned(b['protocol']))
    need(protocol['author'] == '/root', 'ROOT_PROTOCOL')
    protocol_adoption = decode(pinned(b['protocol_Root_adoption']))
    checked_fields(protocol_adoption, b['protocol_adoption_required_fields'])
    window = decode(pinned(b['source_window']))
    checked_fields(window, b['source_window_required_fields'])
    end = datetime.datetime.fromisoformat(window[b['Source_window_end_field']])
    need(end.tzinfo is not None and now() + datetime.timedelta(seconds=60) < end, 'SOURCE_RESERVE60')
    adoption = decode(pinned(b['Source_adoption']))
    checked_fields(adoption, b['Source_adoption_required_fields'])
    need(adoption['verdict'] == SOURCE_VERDICT and adoption['tests_executed'] is False, 'SOURCE_ONLY_ADOPTION')
    subjects = adoption[b['Source_adoption_subject_field']]
    need(type(subjects) is list, 'EXACT_SUBJECT_LIST')
    for key in ('module_Source', 'fixture_Source', 'API', 'author_receipt'):
        pinned(b[key])
        need(b[key] in subjects, 'ACTUAL_FOUR_SOURCE_SUBJECTS:' + key)
    reviews = b['Source_review_records']
    need(type(reviews) is list and len(reviews) == 2, 'DIFFERENT_REVIEW_CAPSULE_AND_FULL')
    for item in reviews:
        need(type(item) is dict and set(item) == {'pin','required_fields'}, 'REVIEW_BINDING')
        record = decode(pinned(item['pin']))
        checked_fields(record, item['required_fields'])
        need(record['tests_executed'] is False and type(record['checks_failed']) is int
             and record['checks_failed'] == 0, 'STRICT_SOURCE_REVIEW_ONLY')
    api = decode(pinned(b['API']))
    fixture = api[b['API_fixture_field']]
    need(type(fixture) is dict and fixture[b['API_entry_field']] == 'run_memory_suite(module)', 'API_ENTRY')
    count = fixture[b['API_count_field']]
    planned = fixture[b['API_names_field']]
    need(type(count) is int and 1 <= count <= 256 and type(planned) is list and
         len(planned) == count and all(type(n) is str and n for n in planned) and
         len(set(planned)) == count, 'ACTUAL_API_CASE_NAMES_AND_COUNT')
    return end, count, planned

def load_scope(b, attempt):
    n = names(attempt)
    scope_pin = fact(P / n['scope'])
    s = decode(pinned(scope_pin))
    need(s['author'] == '/root' and s['record_type'] == 'Root_I9_one_use_pure_semantic_memory_scope', 'ROOT_EXACT_SCOPE')
    need(type(s['maximum_invocations']) is int and s['maximum_invocations'] == 1 and
         type(s['attempt_number']) is int and s['attempt_number'] == attempt, 'ONCE_ATTEMPT')
    need(s['new_I9_pure_memory_fixture_invocation_authorized'] is True and s[OLD_AUTHORITY_KEY] is False,
         'NEW_I9_ONLY')
    need(s['names'] == n, 'FINITE_OUTPUT_NAMES')
    for key in ('protocol','protocol_Root_adoption','source_window','module_Source','fixture_Source',
                'API','author_receipt','Source_adoption'):
        need(equal_typed(s[key], b[key]), 'EXACT_SCOPE_BINDING:' + key)
    need(type(s['tool_Source_pins']) is dict and set(s['tool_Source_pins']) == set(b['tool_Source_paths']),
         'EXACT_TOOL_SCOPE_ROLES')
    for role,path in b['tool_Source_paths'].items():
        need(s['tool_Source_pins'][role]['path'] == path, 'EXACT_TOOL_SCOPE_PATH')
        pinned(s['tool_Source_pins'][role])
    source_end, count, planned = check_source(b)
    start = datetime.datetime.fromisoformat(s['interval_start'])
    end = datetime.datetime.fromisoformat(s['interval_end'])
    need(start.tzinfo is not None and end.tzinfo is not None and start <= now() and
         now() + datetime.timedelta(seconds=60) < end <= source_end and
         0 < (end-start).total_seconds() <= b['scope_duration_seconds'], 'FRESH_PRIVATE_SCOPE')
    need(type(s['expected_planned_case_count']) is int and s['expected_planned_case_count'] == count and
         equal_typed(s['planned_case_names'], planned), 'SCOPE_API_CASE_JOIN')
    checked_fields(s, {'wall_cap_seconds':60, 'cleanup_reap_seconds':5, 'stream_cap_bytes':CAP,
        'RAM_floor_bytes':1073741824, 'disk_floor_bytes':10737418240,
        'automatic_retry_authorized':False, 'actual_selected_family_Source_publication':False,
        'operational_authority':False, 'scientific_authority':False})
    return scope_pin, s, n

def self_pin(b, role):
    # Hashes live in the independently reviewed fresh scope, avoiding self-hash cycles.
    need(str(Path(__file__)) == b['tool_Source_paths'][role], 'EXACT_BOUND_SELF_SOURCE_PATH')

def isolated():
    need(sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1,
         'ISOLATED_NO_SITE_NO_BYTECODE')

import ctypes
import shutil
import subprocess
import threading

def fresh_resources():
    class MemoryStatus(ctypes.Structure):
        _fields_ = [('length',ctypes.c_ulong),('load',ctypes.c_ulong),('total',ctypes.c_ulonglong),
            ('available',ctypes.c_ulonglong),('page_total',ctypes.c_ulonglong),('page_available',ctypes.c_ulonglong),
            ('virtual_total',ctypes.c_ulonglong),('virtual_available',ctypes.c_ulonglong),('extended',ctypes.c_ulonglong)]
    status = MemoryStatus()
    status.length = ctypes.sizeof(status)
    need(ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)) != 0, 'RAM_OBSERVATION_FAILED')
    disk = shutil.disk_usage(P).free
    observed = dict(observed_utc=now().isoformat(), observed_monotonic_ns=time.monotonic_ns(),
        available_RAM_bytes=status.available, disk_free_bytes=disk, RAM_floor_bytes=1073741824,
        disk_floor_bytes=10737418240, age_limit_seconds=60, FileTime_or_Native8_collection=False)
    need(status.available >= 1073741824 and disk >= 10737418240, 'RAM_OR_DISK_FLOOR')
    return observed

def main():
    b = bound()
    isolated()
    need(os.name == 'nt' and sys.executable.casefold() == PYTHON.casefold(), 'WINDOWS_EXACT_PYTHON')
    self_pin(b, 'supervisor')
    attempt = attempt_argument(b)
    scope_pin, s, n = load_scope(b, attempt)
    runner = s['tool_Source_pins']['runner']
    pinned(runner)
    for key in ('supervisor_marker','child_marker','child_result','supervisor_result','stdout','stderr','capture'):
        need(not (P/n[key]).exists(), 'ONE_USE_OUTPUT_ALREADY_EXISTS:' + key)
    marker = save(P/n['supervisor_marker'], dict(schema_version=1,
        record_type='Root_I9_memory_supervisor_once_consumed_before_child', author='/root',
        created_utc=now().isoformat(), scope=scope_pin, child_runner=runner, attempt_number=attempt,
        automatic_retry_authorized=False))
    argv = [PYTHON,'-I','-S','-B',runner['path'],f'{attempt:03d}']
    reason = None
    proc = None
    code = None
    reaped = False
    resource = None
    launch = None
    exit_observed = None
    threads = []
    stream_states = []
    started_utc, started = now().isoformat(), time.monotonic_ns()
    def drain(pipe, handle, state):
        try:
            while True:
                data = pipe.read(4096)
                if not data:
                    break
                state['observed_lower_bound_bytes'] += len(data)
                available = max(0,CAP-state['saved_bytes'])
                chunk = data[:available]
                handle.write(chunk)
                state['saved_bytes'] += len(chunk)
                if len(chunk) != len(data):
                    state['overcap'] = True
                    break
            handle.flush()
            os.fsync(handle.fileno())
        except BaseException as exc:
            state['reader_error'] = type(exc).__name__ + ':' + str(exc)[:4096]
        finally:
            pipe.close()
            handle.close()
    try:
        handles = [(P/n[key]).open('xb') for key in ('stdout','stderr')]
        # This is the last external observation immediately before one Popen.
        resource = fresh_resources()
        need(now() + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(s['interval_end']),
             'PRELAUNCH_PRIVATE_SCOPE_RESERVE')
        need(time.monotonic_ns()-resource['observed_monotonic_ns'] < 60000000000, 'FRESH_PRELAUNCH_RESOURCES')
        launch = time.monotonic_ns()
        proc = subprocess.Popen(argv, cwd=P, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NO_WINDOW, bufsize=0,
            close_fds=True, env={'SYSTEMROOT':os.environ.get('SYSTEMROOT',r'C:\Windows'),
                'WINDIR':os.environ.get('WINDIR',r'C:\Windows'), 'PYTHONHASHSEED':'0',
                'PYTHONUTF8':'1', 'PYTHONIOENCODING':'utf-8'})
        for key, pipe, handle in zip(('stdout','stderr'),(proc.stdout,proc.stderr),handles):
            state = dict(path=str(P/n[key]),saved_bytes=0,observed_lower_bound_bytes=0,
                         overcap=False,reader_error=None)
            stream_states.append(state)
            thread = threading.Thread(target=drain,args=(pipe,handle,state),daemon=True)
            threads.append(thread)
            thread.start()
        while True:
            polled = proc.poll()
            observed = time.monotonic_ns()
            if polled is not None:
                exit_observed = observed
                break
            if observed-launch > 60000000000:
                reason = 'owned I9 child exceeded60second wall cap'
                break
            if any(q['overcap'] or q['reader_error'] is not None for q in stream_states):
                reason = 'owned I9 child stream cap or reader failure'
                break
            time.sleep(0.05)
    except BaseException as exc:
        reason = reason or type(exc).__name__ + ':' + str(exc)[:4096]
    cleanup_started = time.monotonic_ns()
    if proc is not None:
        if reason is not None and proc.poll() is None:
            try:
                proc.kill()  # Only the exact Popen child; no enumeration or unrelated kill.
            except BaseException as exc:
                reason += ';owned kill failed:' + type(exc).__name__
        try:
            code = proc.wait(timeout=5)
            reaped = True
        except subprocess.TimeoutExpired:
            reason = reason or 'owned child not reaped within5seconds; cleanup unverified'
        if reaped and exit_observed is None:
            exit_observed = time.monotonic_ns()
    for thread in threads:
        remaining = max(0,(5000000000-(time.monotonic_ns()-cleanup_started))/1000000000)
        thread.join(timeout=remaining)
    joined = all(not thread.is_alive() for thread in threads)
    if not joined:
        reason = reason or 'owned stream readers not joined within cleanup5seconds'
    wall = exit_observed-launch if exit_observed is not None and launch is not None else None
    if wall is not None and wall > 60000000000:
        reason = reason or 'terminal child wall observation exceeded60seconds'
    streams = []
    if joined:
        for state in stream_states:
            q = fact(state['path'])
            need(q['bytes'] == state['saved_bytes'], 'ACTUAL_STREAM_SAVED_SIZE')
            streams.append(dict(actual_capture=q, **{k:v for k,v in state.items() if k != 'path'}))
            if state['overcap'] or state['reader_error'] is not None:
                reason = reason or 'terminal stream incomplete or overcap'
    child_pin, child = None, None
    if reaped and (P/n['child_result']).is_file():
        try:
            child_pin = fact(P/n['child_result'])
            child = decode(pinned(child_pin))
            need(equal_typed(child['scope'],scope_pin), 'CHILD_SCOPE_JOIN')
            need(child['all_cases_passed'] is True and child['tests_executed'] is True and
                 type(child['I9_memory_test_runs']) is int and child['I9_memory_test_runs'] == 1,
                 'CHILD_COMPLETE_ACCEPTED_MEMORY_RESULT')
        except BaseException as exc:
            reason = reason or 'saved child refused:' + type(exc).__name__ + ':' + str(exc)[:4096]
    else:
        reason = reason or 'owned child saved result missing or cleanup unverified'
    record = dict(schema_version=1,record_type='Root_actual_I9_once_synthetic_memory_supervisor_result',
        author='/root',started_utc=started_utc,created_utc=now().isoformat(),scope=scope_pin,
        supervisor_marker=marker,attempt_number=attempt,resource_prelaunch=resource,
        scope_creation_resource_observation_is_historical=True,child_runner=runner,argv=argv,cwd=str(P),
        owned_child_PID=proc.pid if proc is not None else None,owned_child_exit_code=code,
        owned_child_wait_reaped=reaped,stream_reader_threads_joined=joined,wall_cap_seconds=60,
        cleanup_reap_seconds=5,child_launch_monotonic_ns=launch,child_exit_observed_monotonic_ns=exit_observed,
        owned_child_wall_integer_nanoseconds=wall,elapsed_integer_nanoseconds=time.monotonic_ns()-started,
        streams=streams,child_saved_result=child_pin,passed=reason is None and code == 0 and reaped and joined,
        refusal=reason,owned_child_invocations=1 if proc is not None else 0,
        tests_executed=child.get('tests_executed') if type(child) is dict else None,
        I9_memory_test_runs=child.get('I9_memory_test_runs') if type(child) is dict else None,
        original_I0_I1_I2_I3_I4_I5_I6_I7_I8_import_call_or_test=False,
        original_project_native_Parser_runtime_scientific_execution=False,
        actual_selected_family_Source_publication=False,actual_canonical_IO=False,
        actual_new_lease_family_grants_Native8_Parser_results=None,
        operational_authority=False,scientific_authority=False)
    print(json.dumps(save(P/n['supervisor_result'],record),sort_keys=True))
    if not record['passed']:
        raise SystemExit(1)

if __name__ == '__main__':
    main()
