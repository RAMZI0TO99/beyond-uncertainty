def validate_counts(a):
 for key in ('actual_memory_case_count','actual_memory_cases_passed','known_I9_memory_test_runs','unknown_I9_memory_test_runs','spent_memory_scope_count','failed_memory_test_runs','accepted_complete_memory_test_runs','accepted_attempt_ordinal'):
  assert type(a[key]) is int and a[key]>=0, key
 assert a['I9_memory_test_runs'] is None and a['unknown_I9_memory_test_runs']==1
 assert 1<=a['actual_memory_case_count']<=256 and a['actual_memory_cases_passed']==a['actual_memory_case_count']
 runs=a['known_I9_memory_test_runs'];failed=a['failed_memory_test_runs']
 assert runs==5 and failed==4 and a['accepted_complete_memory_test_runs']==1 and runs==failed+1
 attempts=a['all_saved_memory_attempts'];assert type(attempts) is list and len(attempts)==a['spent_memory_scope_count']==a['accepted_attempt_ordinal']==6
 for ordinal,row in enumerate(attempts,1):
  assert type(row) is dict and type(row['attempt_ordinal']) is int and row['attempt_ordinal']==ordinal
  assert type(row['accepted_complete_run']) is bool and row['accepted_complete_run'] is (ordinal==len(attempts))
  if ordinal==5:
   assert row['I9_memory_test_runs'] is None and row['tests_executed'] is None and row['result'] is None
   assert row['all_cases_passed'] is None and row['actual_test_case_count'] is None and row['unknown_suite_status'] is True
  else:
   assert type(row['I9_memory_test_runs']) is int and row['I9_memory_test_runs']==1
   assert row['tests_executed'] is True and type(row['all_cases_passed']) is bool
   assert row['all_cases_passed'] is (ordinal==6)
 assert sum(row['I9_memory_test_runs'] for row in attempts if type(row['I9_memory_test_runs']) is int)==runs
 return runs,failed

