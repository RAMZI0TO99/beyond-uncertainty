def now():return datetime.datetime.now(datetime.timezone.utc).isoformat()
def raw(p,cap=CAP):
 p=pathlib.Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=cap
 with p.open('rb') as f:b=f.read(cap+1)
 assert len(b)<=cap;return b
def fact(p):
 p=pathlib.Path(p);b=raw(p);return {'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()}
def pinned(f,path=None,cap=CAP):
 p=pathlib.Path(path or f['path']);assert p.stat().st_size==f['bytes'];b=raw(p,cap);assert hashlib.sha256(b).hexdigest()==f['sha256'],str(p);return b
def save(name,x):
 b=(json.dumps(dict(schema_version=1,created_utc=now(),author='/root',**x),sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP;p=O/name
 with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 return fact(p)
