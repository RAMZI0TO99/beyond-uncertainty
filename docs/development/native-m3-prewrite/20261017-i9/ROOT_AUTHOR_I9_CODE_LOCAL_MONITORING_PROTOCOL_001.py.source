record=dict(schema_version=1,record_type='Root_exact_I9_code_local_monitoring_instrumentation_Source_protocol',
    author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_window=window,
    adopted_target_Source=fact(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_006.json'),
    module_Source=fact(P/'i9/validate_recorded_M3_semantics_007.py'),
    fixture_Source=fact(P/'i9/test_recorded_M3_semantics_memory_only_005.py'),
    exact_existing_98_cases_and_target_Source_unchanged=True,
    purpose='Replace global frame-based profiling with exact compiled-target code entry/resume/throw event observation. This is instrumentation only; no timeout cause or speed improvement has been measured.',
