        ownership='Require get_tool(5) is None before use_tool_id; never disturb other tool ids.',
        registry='Before each of exactly two target execs recursively install every CodeType in the compiled code constants, including the module code. Keep strong references and exact object identity; never match a structurally equal unregistered code object.',
        local_events=['PY_START','PY_RESUME'],local_callback_signature='(code, instruction_offset)',
        global_events=['PY_THROW'],global_callback_signature='(code, instruction_offset, exception)',
        global_throw_filter='Count only exact preinstalled target CodeType identity; other codes return without counting. PY_THROW is not a supported local event.',
        counted_subjects='The same two target paths and all their executed function names, including generator starts/resumes/throws. Records label this event evidence explicitly; no unmeasured old/new numeric comparison.',
        maximum_profiled_target_events=50000000,maximum_function_names=4096,
        no_sampling_or_event_DISABLE_or_global_start_resume=True,
        cleanup='First set all owned local events to0, then owned global events to0, unregister every owned callback, then free only owned tool_id5 in finally. Free alone is insufficient.',
        source_tampering='Target sources cannot acquire or mutate monitoring. Preserve existing strict imports, AST dynamic/IO denials and audit; additionally reject monitoring API attributes in target Source.',
        frame_access='No frame.f_code access in instrumentation counting callbacks; receive direct code object.'),
    unchanged=['Exactly one compile and exec per new target','All existing audit denials and AST-data-only compile exception','All preloaded literal imports and safe builtins','Owned supervisor60second wall and shared5second cleanup','RAM1GiB/disk10GiB/resourceage60','2MiB stream/metadata caps','Fresh20minute one-use scope and actual different Source reviews/Root adoptions','All8 required public/render function observations','All75 spent identities and every original guard/cap/clock','No oldI0-I8/Native8/Parser/runtime/science execution'],
    known_prior_I9_memory_test_runs=4,unknown_prior_suite_entries=2,spent_memory_scopes=6,
    tests_executed=False,target_execution=False,new_invocation_authorized_now=False,
    actual_new_grants_lease_family_Native8_Parser_results=None,operational_authority=False,scientific_authority=False)
data=(json.dumps(record,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
path=P/'ROOT_I9_CODE_LOCAL_MONITORING_EXACT_INSTRUMENTATION_PROTOCOL_001.json'
with path.open('xb') as handle:
    handle.write(data);handle.flush();os.fsync(handle.fileno())
