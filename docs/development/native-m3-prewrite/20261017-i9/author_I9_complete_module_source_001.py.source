values['I9_HISTORICAL45_PIN']=old_selection['current_complete45_inventory']
lease=json.loads(Path(c['EXISTING_LEASE010']['path']).read_bytes())
values['I9_LEASE_FIXED']={k:v for k,v in lease.items() if k not in ('created_utc','lease_end_utc')}
values['I9_KNOWN_ROLE_CAPS']={r['predecessor']['path']:r['source_cap'] for r in old_selection['rows']}
values['I9_STAGE_KEYS']=set(c['STAGES'])-{'phase_bound'}|{'phase_bound:'+r for r in c['PHASE_BOUND_ROLES']}
header='''"""Pure recorded M3 semantic leaf; no IO, dynamic target execution or authority grant.
Actual Source editor /root/phase_frontier. Historical algorithms are isolated new Source ports.
I8 authorization and a genuinely qualified producer/caller remain separately mandatory.
"""
import ast as _i9_ast
import base64 as _i9_base64
import copy as _i9_copy_module
import datetime as _i9_dt
import difflib as _i9_difflib
import hashlib as _i9_hashlib
import json as _i9_json_module
import re as _i9_re

'''
set_names={'I9_BINDING_KEYS','I9_DEPENDENCY_KEYS','I9_STAGE_KEYS'}
for name,value in values.items():
    header+=name+' = '+('frozenset('+repr(sorted(value))+')' if name in set_names else repr(value))+'\n'
fragments=[OWN/name for name in ('I9_CORE_METADATA_SOURCE_FRAGMENT_001.py',
 'I9_COMMON_AND_STAGE_METADATA_SOURCE_FRAGMENT_001.py','I9_ISOLATED_RENDER_AND_INVERSE_ALGORITHM_SOURCE_PORTS_001.py',
 'I9_STAGE_AND_REQUEST_VALIDATION_SOURCE_FRAGMENT_001.py')]
raw=header.encode()+b'\n\n'+b'\n\n'.join(p.read_bytes() for p in fragments)
tree=ast.parse(raw);compile(raw,'I9_new_module_Source_only','exec')
binding=set();dups=[]
for n in tree.body:
    ns=[]
    if isinstance(n,(ast.FunctionDef,ast.ClassDef)):ns=[n.name]
    elif isinstance(n,ast.Import):ns=[a.asname or a.name for a in n.names]
    elif isinstance(n,ast.Assign):ns=[x.id for x in n.targets if isinstance(x,ast.Name)]
    for name in ns:
        if name in binding:dups.append(name)
        binding.add(name)
assert not dups,dups
st=symtable.symtable(raw.decode(),'I9_Source','exec');unknown=set()
def visit(table):
    for symbol in table.get_symbols():
        if symbol.is_global() and symbol.is_referenced() and symbol.get_name() not in binding and symbol.get_name() not in vars(builtins):unknown.add(symbol.get_name())
    for child in table.get_children():visit(child)
visit(st)
assert not unknown,unknown
for n in ast.walk(tree):
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in ('exec','eval','compile','open','__import__')
    if isinstance(n,ast.Import):assert all(x.name in ('ast','base64','copy','datetime','difflib','hashlib','json','re') for x in n.names)
source=save(OWN/'validate_recorded_M3_semantics_001.py',raw)
spec=save(OWN/'I9_ASSEMBLED_MODULE_CONSTANT_BINDINGS_001.json',wire({k:sorted(v) if isinstance(v,set) else v for k,v in values.items()}))
report=dict(schema_version=1,record_type='I9_actual_module_Source_assembly_receipt',author='/root/phase_frontier',
 created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),Source=source,
 fragments=[pin(p) for p in fragments],constants=spec,protocol=pin(P/'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json'),
 Root_protocol_adoption=pin(adoption),actor_clarifier_Root_adoption=pin(actor),
 algorithm_inverse_and_map=pin(OWN/'I9_ORIGINAL_ALGORITHM_FULL_REGION_INVERSE_AND_ADAPTATION_MAP_001.json'),
 static_checks=dict(AST_parse=True,compile_Source_only=True,no_duplicate_module_bindings=True,no_unresolved_global_names=True,
   no_exec_eval_compile_open_import_dispatch=True),target_imports=0,target_calls=0,fixtures_executed=False,
 independent_review_pending=True,operational_authority=False,scientific_authority=False,target_execution=False)
receipt=save(OWN/'I9_ACTUAL_MODULE_SOURCE_ASSEMBLY_RECEIPT_001.json',wire(report))
print(json.dumps(dict(Source=source,constants=spec,receipt=receipt)))
