actor=P/'ROOT_I9_CURRENT_ACTOR_PROOF_CLARIFIER_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
assert pin(actor)['sha256']=='a9de80e3d8313a953d01aa13b60e21867bccc096e43bab0010318855ca7aea6b'
old=Path(protocol['reference_contracts']['I2_Source']['path']);oldraw=old.read_bytes()
assert pin(old)==protocol['reference_contracts']['I2_Source']
def constants(raw):
    out={}
    for n in ast.parse(raw).body:
        if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name):
            value=n.value
            if isinstance(value,ast.Call) and isinstance(value.func,ast.Name) and value.func.id=='frozenset':value=value.args[0]
            try:out[n.targets[0].id]=ast.literal_eval(value)
            except (ValueError,TypeError):pass
    return out
c=constants(oldraw)
i8=Path(protocol['reference_contracts']['I8_separate_required_layer']['Source']['path'])
c8=constants(i8.read_bytes())
schemas=protocol['schemas']
values={
 'I9_BASE':r'D:\Aenv\pro2\resume-2026-10-03-continuation001',
 'I9_SESSION':r'D:\Aenv\pro2\WORK\resume-20261007-001',
 'I9_ROOT_OWNED':r'D:\Aenv\pro2\WORK\resume-20261007-001\generation\observer010_lease009_root_001',
 'I9_TRUSTED_KEYS':tuple(protocol['trusted_bindings_keys']),
 'I9_TOOL4':tuple(schemas['tool_support4']),'I9_OWNER3':tuple(c['OWNER_SUPPORT_KEYS']),
 'I9_STAGE3':tuple(schemas['stage_support3']['keys']),'I9_SELECTION13':tuple(schemas['selection13']),
 'I9_ROW9':tuple(schemas['selection_row9']),'I9_FACT21':tuple(schemas['facts21']['keys']),
 'I9_RECEIPT22':tuple(schemas['receipt22']['keys']),'I9_RESOURCE3':tuple(schemas['resource3']),
 'I9_LEASE_SUPPORT5':tuple(schemas['lease_support5']),'I9_SELECTION_SUPPORT3':tuple(schemas['selection_support3']),
 'I9_STEPS4':tuple(schemas['steps4']),'I9_PROVENANCE6':tuple(schemas['provenance6']),
 'I9_PURPOSE6':tuple(schemas['stage_purpose6']),'I9_REQUEST21':tuple(schemas['request21']),
 'I9_REQUEST_ROW10':tuple(schemas['request_row10']),'I9_LEASE12':tuple(c['LEASE_KEYS']),
 'I9_OBSERVATION9':('path','sha256','bytes','cap','path9','descriptor9','shared_identity_indexes','two_read_match','observed_utc'),
 'I9_CURRENT_ROOT_SELECTION':c['CURRENT_ROOT_SELECTION'],
 'I9_FIXED_CONTEXT':c['FIXED_CONTEXT_ANCHORS'],
 'I9_PHASE_ROLES':tuple(c8['I8_ROLE_ORDER']),'I9_ORDINAL_GROUPS':c8['I8_ORDINAL_COUPLING_GROUPS'],
 'I9_OPTIONAL_FALSE_FLAGS':('original_fixture_or_runtime_admission','original_fixtures_and_runtime_admission',
   'native_Parser_authority','original_target_or_fixture_execution','science_or_native_recovery_authority'),
 'I9_PERMANENT_FALSE':tuple(protocol['result_contract']['permanently_false']),
 'I9_UNWIRED_OBLIGATIONS':('Separate exact I8 owner/lease/Source-publication-purpose validation and genuine caller binding.',
   'Actual producer code origin, human/reviewer authority, current policy and recorded-birth/resource authenticity.',
   'Held I2/I5 external canonical carriers and qualified real producer/caller/physical IO composition.',
   'No IO, canonical publication, Native8, Parser, runtime or scientific admission is supplied by this view.'),
 'I9_ACTUAL_PUBLICATION_DEPENDENCIES_QUALIFIED':False,
}
for name in ('SEMANTIC','CAPTURE_SLOTS','BINDING_KEYS','TEMPLATE_ROLES','PHASE_BOUND_ROLES','GENERATED_ROLES','PEER_ROLES',
 'ROLE_SOURCE_CAPS','CURRENT_PLAN_BINDINGS','CURRENT_PLAN_ROLE_SELECTIONS','RENEWED_BINDINGS','STAGES','M3_ROLES','DEPENDENCY_KEYS',
 'INVENTORY_PIN','BASIS_PIN','INVENTORY_REVIEW','INVENTORY_ADOPTION','HISTORICAL_BINDING_SOURCE_EDITOR',
