from pathlib import Path

OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012\i9')
P=OWN.parent
def pin(path):
    raw=path.read_bytes()
    return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,raw):
    assert not path.exists()
    with path.open('xb') as f:f.write(raw)
    assert path.read_bytes()==raw
    return pin(path)
def wire(value):return (json.dumps(value,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
protocol=json.loads((P/'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json').read_bytes())
adoption=P/'ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'
