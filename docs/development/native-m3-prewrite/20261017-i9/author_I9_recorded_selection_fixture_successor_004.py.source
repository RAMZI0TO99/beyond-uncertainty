assert child['error']==dict(message='E_SELECTION_ROUTE',type='I9MetadataError') and child['blocked_forbidden_event_names']==[]
assert supervisor['owned_child_wait_reaped'] is True and supervisor['stream_reader_threads_joined'] is True and supervisor['owned_child_exit_code']==1
