    assert selection_path.rsplit('\\\\',1)[0]==r'D:\\Aenv\\pro2\\WORK\\resume-20261007-001\\generation\\observer010_lease009_root_001'
    assert selection_path!=c['CURRENT_ROOT_SELECTION']['path']
    # This is a fictional memory-store key under the required recorded parent, never a filesystem allocation.
    graph['selection']=_fx_put(graph,selection_path,value,30)
    assert graph['selection']!=c['CURRENT_ROOT_SELECTION']"""
source=oldraw.decode();assert source.count(before)==1
source=source.replace(before,after);raw=source.encode()
tree=ast.parse(raw);compile(raw,'I9_fixture004_Source_only','exec')
oldtree=ast.parse(oldraw)
def names(t):
    return {n.targets[0].id:ast.literal_eval(n.value) for n in t.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in ('EXPECTED_CASE_COUNT','PLANNED_CASE_NAMES')}
assert names(tree)==names(oldtree) and names(tree)['EXPECTED_CASE_COUNT']==96
assert source.count(after)==1 and source.replace(after,before).encode()==oldraw
