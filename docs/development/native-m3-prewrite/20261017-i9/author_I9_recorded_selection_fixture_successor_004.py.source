from pathlib import Path

OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012\i9');P=OWN.parent
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def wire(value):return (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
def save(path,raw):
    assert not path.exists() and 0<len(raw)<=2097152
    with path.open('xb') as f:f.write(raw)
    assert path.read_bytes()==raw
    return pin(path)
assert len(sys.argv)==3 and re.fullmatch('[0-9a-f]{64}',sys.argv[2])
failure_adoption_path=Path(sys.argv[1]);assert failure_adoption_path.parent==P
failure_adoption=pin(failure_adoption_path);assert failure_adoption['sha256']==sys.argv[2]
assert json.loads(failure_adoption_path.read_bytes())['author']=='/root'
