"""Author isolated new Source from old AST as data; do not load targets."""
import ast
import hashlib
import json
from pathlib import Path

OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012\i9')
OLD=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_family_implementation_005\i2\build_M3_metadata_current_owner_deferred_002.py')
raw=OLD.read_bytes();assert hashlib.sha256(raw).hexdigest()=='600ab5bf46faceee88b7b5a99eb32b71a7ebfc763151e2f4e3453a6cccd281c2'
tree=ast.parse(raw);lines=raw.splitlines(keepends=True)
intrinsic=['exact_pin_occurs','assignments','functions','protected_assignments','splice_exact','safe_relative','immutable_json',
 'capture_assignment_bind','old_bound_template_inverse','phase_assignment_bind','phase_predecessor_inverse','_stage_roles','required_dependencies']
buffers=['template_identity','json_artifact','pack','validate_binding_supports','validate_peer_metadata',
 'render_templates','render_manifest','render_capture','render_phase_bound','render_phase_binding']
mapping={n:'_i9_'+n.lstrip('_') for n in intrinsic+buffers}
mapping.update(exact_pin_occurs='_i9_occurs',need='_i9_need',sha='_i9_sha',wire='_i9_original_wire',strict_source_json='_i9_json',
 exact_fact3='_i9_pin',read_pin='_i9_read_pin',utc='_i9_recorded_utc',different_review='_i9_different_review',root_review_adoption='_i9_root_review_adoption',
 ast='_i9_ast',copy='_i9_copy_module',re='_i9_re')
constant_names={'SEMANTIC','CAPTURE_SLOTS','BINDING_KEYS','TEMPLATE_ROLES','PHASE_BOUND_ROLES','GENERATED_ROLES','PEER_ROLES',
 'ROLE_SOURCE_CAPS','CURRENT_PLAN_BINDINGS','CURRENT_PLAN_ROLE_SELECTIONS','RENEWED_BINDINGS','BASE'}
mapping.update({n:'I9_'+n for n in constant_names})
context_names=set(buffers)|{'read_pin','utc','different_review','root_review_adoption'}
path_edits=[
 ("Path(lease_pin['path']).name","_i9_leaf(lease_pin['path'])"),
 ("Path(rows[slot['referenced_role']]['canonical_path'])","rows[slot['referenced_role']]['canonical_path']"),
 ("target.relative_to(BASE).as_posix()","_i9_relative(target,I9_BASE)"),
 ('target.name','_i9_leaf(target)'),
 ("Path(supports[key]['source']['path']).relative_to(BASE).as_posix()","_i9_relative(supports[key]['source']['path'],I9_BASE)"),
 ("Path(inventory[role]['available_basis']['path']).name","_i9_leaf(inventory[role]['available_basis']['path'])"),
 ("str(Path(rows['metadata_manifest']['predecessor']['path']).parent/item['path'])","_i9_join(_i9_parent(rows['metadata_manifest']['predecessor']['path']),item['path'])"),
 ("Path(rows[role]['canonical_path']).name","_i9_leaf(rows[role]['canonical_path'])"),
 ("Path(rows['profile']['canonical_path']).name","_i9_leaf(rows['profile']['canonical_path'])")]
class Port(ast.NodeTransformer):
    def visit_FunctionDef(self,node):
        old=node.name;node=self.generic_visit(node);node.name=mapping.get(old,old)
        if old in buffers:node.args.args.insert(0,ast.arg(arg='_i9_engine'))
        return node
    def visit_Call(self,node):
        old=node.func.id if isinstance(node.func,ast.Name) else None
        old_ast_attr=node.func.attr if isinstance(node.func,ast.Attribute) and isinstance(node.func.value,ast.Name) and node.func.value.id=='ast' else None
        node=self.generic_visit(node)
        if old in context_names:node.args.insert(0,ast.Name(id='_i9_engine',ctx=ast.Load()))
        if old_ast_attr=='parse':node.func=ast.Name(id='_i9_data_ast',ctx=ast.Load())
        if old_ast_attr=='literal_eval':node.func=ast.Name(id='_i9_literal',ctx=ast.Load())
        return node
    def visit_Name(self,node):
        if node.id=='OBSERVATIONS':return ast.copy_location(ast.Attribute(value=ast.Name(id='_i9_engine',ctx=ast.Load()),attr='observations',ctx=node.ctx),node)
        if node.id in mapping:return ast.copy_location(ast.Name(id=mapping[node.id],ctx=node.ctx),node)
        return node
parts=[];inventory=[]
for node in tree.body:
    if not isinstance(node,ast.FunctionDef) or node.name not in intrinsic+buffers:continue
    before=b''.join(lines[node.lineno-1:node.end_lineno]);text=before.decode()
    edits=[]
    for old,new in path_edits:
        count=text.count(old)
        if count:edits.append(dict(old=old,new=new,count=count));text=text.replace(old,new)
    target=Port().visit(ast.parse(text));ast.fix_missing_locations(target)
    after=(ast.unparse(target)+'\n\n').encode()
    assert not any(isinstance(n,ast.Name) and n.id in ('Path','os','sys','ctypes','shutil') for n in ast.walk(target))
    compile(after,'I9_isolated_port_Source','exec')
    parts.append(after)
    inventory.append(dict(original_name=node.name,selected_name=mapping[node.name],original_first_line=node.lineno,
      original_last_line=node.end_lineno,original_bytes=len(before),original_sha256=hashlib.sha256(before).hexdigest(),
      original_whole_Source_utf8=before.decode(),new_bytes=len(after),new_sha256=hashlib.sha256(after).hexdigest(),
      exact_AST_identifier_and_context_adaptations=mapping,path_adaptations=edits,
      algorithm_predicates_retained=True,old_function_invoked=False,new_function_invoked=False))
assert len(inventory)==23
out=OWN/'I9_ISOLATED_RENDER_AND_INVERSE_ALGORITHM_SOURCE_PORTS_001.py'
with out.open('xb') as f:f.write(b''.join(parts))
record=OWN/'I9_ORIGINAL_ALGORITHM_FULL_REGION_INVERSE_AND_ADAPTATION_MAP_001.json'
value=dict(schema_version=1,record_type='I9_isolated_algorithm_whole_original_region_inverse_and_AST_adaptation_map',author='/root/phase_frontier',
 original_Source=dict(path=str(OLD),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),entries=inventory,
 retained_original_wire='sort_keys=True,indent=2,default ensure_ascii=True,allow_nan=False,UTF8,newline',
 time_adaptation='Explicit1601integer ticks and Unixbirth_ns//100 bridge; originalmoment/_anchor helpers not executed; original nofraction/6..7 retained contract.',
 check_adapter='Pure need raises on false; no historical physicalCHECKS replay asserted. Saved codec independently reconstructed/canonicalized.',
 source_executed=False,target_function_calls=0)
b=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152
with record.open('xb') as f:f.write(b)
print(json.dumps({'ports':{'path':str(out),'bytes':out.stat().st_size,'sha256':hashlib.sha256(out.read_bytes()).hexdigest()},
 'map':{'path':str(record),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()},'functions':len(inventory),'target_calls':0},sort_keys=True))
