"""Bind-author metadata Sources only after adopted exact monitoring template proof."""
import ast,datetime,hashlib,json,os,re,sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data=path.read_bytes();assert len(data)<=2097152
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
def replace(text,old,new,count=1):
    assert text.count(old)==count,(old[:100],text.count(old),count)
    return text.replace(old,new)
def save(path,value):
    data=value if type(value) is bytes else (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(data)<=2097152
    with path.open('xb') as handle:handle.write(data);handle.flush();os.fsync(handle.fileno())
    return fact(path)
assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv)==2 and re.fullmatch('[0-9a-f]{64}',sys.argv[1])
ap=fact(P/'ROOT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_REVIEW_ADOPTION_001.json');assert ap['sha256']==sys.argv[1]
a=json.loads(Path(ap['path']).read_bytes());assert a['author']=='/root' and a['tests_executed'] is False and a['target_execution'] is False
assert a['verdict']=='ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY'
assert a['known_I9_memory_test_runs']==4 and a['unknown_I9_memory_test_runs']==2 and a['spent_memory_scope_count']==6
created=[]
original=P/'ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_006.py';text=original.read_text(encoding='utf-8')
for base,suffix in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS','json'),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT','json'),('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES','py'),('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES','py'),('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE','py'),('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS','py')):
    text=replace(text,f'{base}_006.{suffix}',f'{base}_007.{suffix}')
text=replace(text,'attempt_numbers=[6]','attempt_numbers=[7]',2)
text=replace(text,"assert len(sys.argv)==2 and re.fullmatch('[0-9a-f]{64}',sys.argv[1])",
    "assert len(sys.argv)==3 and re.fullmatch('[0-9a-f]{64}',sys.argv[1]) and re.fullmatch('[0-9a-f]{64}',sys.argv[2])\nmonitoring_adoption_pin=fact(P/'ROOT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_REVIEW_ADOPTION_001.json')\nassert monitoring_adoption_pin['sha256']==sys.argv[2]\nmonitoring_adoption=obj(pin(monitoring_adoption_pin))\nassert monitoring_adoption['author']=='/root' and monitoring_adoption['verdict']=='ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY'\nassert monitoring_adoption['tests_executed'] is False and monitoring_adoption['target_execution'] is False\npin(monitoring_adoption['unknown_timeout006_adoption'])")
text=replace(text,"assert adoption_pin['sha256']==sys.argv[1]","assert adoption_pin['sha256']==sys.argv[1] and monitoring_adoption['original_target_Source_adoption']==adoption_pin")
start=text.index('templates={\n');end=text.index('\ncreated=[]',start)
templates={}
for role,stem in (('runner','RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES'),('supervisor','SUPERVISE_I9_ONCE_MEMORY_FIXTURES'),('scope_preparer','PREPARE_I9_FRESH_MEMORY_SCOPE'),('capture','CAPTURE_I9_ACTUAL_MEMORY_STREAMS')):
    q=fact(P/'memory_tooling_001'/f'{stem}_TEMPLATE_003.py');assert q in a['subjects']
    templates[role]=(Path(q['path']).name,q['sha256'])
text=text[:start]+'templates='+repr(templates)+text[end:]
text=replace(text,'receipt=dict(schema_version=1,','receipt=dict(instrumentation_protocol_Root_adoption=monitoring_adoption_pin,unknown_timeout006_Root_adoption=monitoring_adoption[\'unknown_timeout006_adoption\'],schema_version=1,')
new=P/'ROOT_BIND_I9_EXACT_MEMORY_TOOL_SOURCES_007.py';ast.parse(text);compile(text,str(new),'exec')
created.append(dict(original_Source=fact(original),new_Source=save(new,text.encode())))
original=P/'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_007.py';text=original.read_text(encoding='utf-8')
for base,count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS',1),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT',1),('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION',2),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE',1),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION',1)):
    text=replace(text,f'{base}_006.json',f'{base}_007.json',count)
text=replace(text,"s['attempt_number'] == 6","s['attempt_number'] == 7")
text=replace(text,'unknown_I9_memory_test_runs=1, spent_memory_scope_count=5','unknown_I9_memory_test_runs=2, spent_memory_scope_count=6')
anchor="    assert receipt['actual_Source_adoption'] == config['Source_adoption']\n"
extra="    monitoring_adoption_pin=fact(P/'ROOT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_REVIEW_ADOPTION_001.json')\n    assert receipt['instrumentation_protocol_Root_adoption']==monitoring_adoption_pin and monitoring_adoption_pin in inputs\n    monitoring_adoption=obj(pin(monitoring_adoption_pin))\n    assert monitoring_adoption['verdict']=='ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY'\n    assert monitoring_adoption['original_target_Source_adoption']==config['Source_adoption']\n    assert monitoring_adoption['known_I9_memory_test_runs']==4 and monitoring_adoption['unknown_I9_memory_test_runs']==2 and monitoring_adoption['spent_memory_scope_count']==6\n    unknown6=monitoring_adoption['unknown_timeout006_adoption'];assert unknown6 in inputs;pin(unknown6)\n"
text=replace(text,anchor,anchor+extra)
text=replace(text,"        actual_bindings=config_pin, actual_binding_receipt=receipt_pin,","        actual_bindings=config_pin, actual_binding_receipt=receipt_pin,\n        instrumentation_protocol_Root_adoption=monitoring_adoption_pin, unknown_timeout006_Root_adoption=unknown6,")
new=P/'ROOT_ADOPT_I9_BOUND_MEMORY_TOOL_OR_FRESH_SCOPE_REVIEW_008.py';ast.parse(text);compile(text,str(new),'exec')
created.append(dict(original_Source=fact(original),new_Source=save(new,text.encode())))
record=dict(schema_version=1,author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    subjects=created,instrumentation_protocol_adoption=ap,known_prior_I9_runs=4,unknown_prior_I9_runs=2,
    spent_scopes=6,next_scope=7,target_Source_unchanged=True,new_Source_invoked=False,
    target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
print(json.dumps(save(P/'ROOT_I9_ATTEMPT007_METADATA_CONTROL_SOURCE_AUTHOR_RECEIPT_001.json',record)))
