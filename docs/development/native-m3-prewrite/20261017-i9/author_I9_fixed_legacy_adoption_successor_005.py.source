def pin(path):
    b=path.read_bytes();return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
def save(path,b):
    assert not path.exists() and 0<len(b)<=2097152
    with path.open('xb') as f:f.write(b)
    assert path.read_bytes()==b
    return pin(path)
