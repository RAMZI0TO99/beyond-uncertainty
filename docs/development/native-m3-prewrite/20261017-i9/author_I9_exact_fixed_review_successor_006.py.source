assert rootpin['bytes']==33491 and rootpin['sha256']=='6301ca4668dfec5ae1670c6d40dd7f18d229c529675b936cf5812afd0ef79e5a'
assert root['author']=='/root' and root['bounded_Source_correction_from_actual_review_authorized'] is True
assert root['I9_memory_test_runs']==root['failed_memory_test_runs']==3 and root['actual_completed_case_count']==0
