for leaf,digest in (
 ('ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_003.json','dd39487c20e1ad7b0bc97ad9b695082ded4b4b9de6104a6189ee34ad2a7a1821'),
 ('ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_003.json','0556c873f55f39cb2d30d85b513ca00fd6980904a53722a0f862c96b923dc7ec'),
 ('ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_003.json','479bab9e244e0a0fe4698adc856bb7a28c02d49366a5fc3bffdee96eda5ad16a')):
    v,q=obj(P/leaf);assert q['sha256']==digest;saved.append(q)
    if 'SUITE_RESULT' in leaf:
        assert v['tests_executed'] is True and v['actual_test_case_count']==0
        assert v['error']==dict(type='I9MetadataError',message='E_FULL_PROOF') and v['blocked_forbidden_event_names']==[]
    if 'SUPERVISOR_RESULT' in leaf:
        assert v['owned_child_exit_code']==1 and v['owned_child_wait_reaped'] is True and v['stream_reader_threads_joined'] is True
old,oldpin=read(OWN/'validate_recorded_M3_semantics_004.py')
assert oldpin['sha256']=='65c062b2d1f9cde05c2b6570d2839f9e906076f67c00768d5e44abc845b7152c'
fragment,fragmentpin=read(OWN/'I9_FIXED_LEGACY_REVIEW_SOURCE_FRAGMENT_001.py')
ast.parse(fragment);compile(fragment,'legacy_review_fragment_Source_only','exec')
helper=fragment.decode()+'\n\n'
oldfunctions=functions(old);oldcode=oldfunctions['_i9_code_support'].decode()
newcode='''def _i9_code_support(reader,support,subjects,editor,*,fixed_full=None):
    reader.support(support,I9_TOOL4)
    kind=None
    if fixed_full is not None:
        matches=[]
        for candidate,actual_editor in (('I0','/root/checker_frontier'),('I1','/root/phase_frontier')):
            expected_support=dict(Source=I9_FIXED_CONTEXT[candidate+'_Source'],API=I9_FIXED_CONTEXT[candidate+'_API'],
              different_review=I9_FIXED_CONTEXT[candidate+'_Source_review'],Root_adoption=I9_FIXED_CONTEXT[candidate+'_Root_adoption'])
            expected_subjects=[I9_FIXED_CONTEXT[candidate+'_Source'],I9_FIXED_CONTEXT[candidate+'_API']]
            if candidate=='I1':expected_subjects.append(I9_FIXED_CONTEXT['I1_native_entry'])
            if _i9_same(support,expected_support) and _i9_same(subjects,expected_subjects) and editor==actual_editor and _i9_same(fixed_full,I9_FIXED_CONTEXT[candidate+'_full_proof']):
                matches.append(candidate)
        _i9_need(len(matches)==1,'E_FIXED_CODE_BUNDLE');kind=matches[0]
    reader.body(support['Source']);reader.record(support['API'])
    if kind is None:
        reviewed=_i9_review(reader,support['different_review'],subjects,[editor])
    else:
        reviewed=_i9_fixed_legacy_code_review(reader,kind,support['different_review'],subjects,editor,fixed_full)
    _i9_need('SOURCE' in reviewed['value']['verdict'].upper(),'E_CODE_REVIEW_VERDICT')
    if fixed_full is not None:_i9_need(_i9_same(reviewed['full_pin'],fixed_full),'E_CODE_FULL')
    if kind is None:
        adopted=_i9_adoption(reader,support['Root_adoption'],subjects,reviewed,context=False)
    else:
        adopted=_i9_fixed_legacy_code_adoption(reader,kind,support['Root_adoption'],subjects,reviewed)
    return reviewed,adopted
'''
text=old.decode();assert text.count(oldcode)==1;text=text.replace(oldcode,helper+newcode)
new=text.encode();ast.parse(new);compile(new,'module005_Source_only','exec')
newfunctions=functions(new)
assert set(newfunctions)-set(oldfunctions)=={'_i9_fixed_legacy_code_review'}
assert [n for n in oldfunctions if oldfunctions[n]!=newfunctions[n]]==['_i9_code_support']
unchanged=[]
for name,b in oldfunctions.items():
    if name=='_i9_code_support':continue
    assert b==newfunctions[name]
    unchanged.append(dict(name=name,bytes=len(b),sha256=hashlib.sha256(b).hexdigest(),byte_exact=True))
assert text.replace(helper+newcode,oldcode).encode()==old
module=save(OWN/'validate_recorded_M3_semantics_005.py',new)
