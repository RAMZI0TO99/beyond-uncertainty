raw=source.encode();newtree=ast.parse(raw);compile(raw,'I9_module002_Source_only','exec')
binding=set();duplicates=[]
for n in newtree.body:
    names=[]
    if isinstance(n,(ast.FunctionDef,ast.ClassDef)):names=[n.name]
    elif isinstance(n,ast.Import):names=[x.asname or x.name for x in n.names]
    elif isinstance(n,ast.Assign):names=[x.id for x in n.targets if isinstance(x,ast.Name)]
    for name in names:
        if name in binding:duplicates.append(name)
        binding.add(name)
assert not duplicates,duplicates
unknown=set()
def symbols(table):
    for s in table.get_symbols():
        if s.is_global() and s.is_referenced() and s.get_name() not in binding and s.get_name() not in vars(builtins):unknown.add(s.get_name())
    for child in table.get_children():symbols(child)
symbols(symtable.symtable(source,'I9_module002_Source','exec'));assert not unknown,unknown
for n in ast.walk(newtree):
    if isinstance(n,ast.Call) and isinstance(n.func,ast.Name):assert n.func.id not in ('exec','eval','compile','open','__import__')
