INPUTS={};CHECKS=[]
def data(path):
    path=Path(path);b=path.read_bytes();assert 0<len(b)<=CAP
    q=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    k=str(path).casefold();assert k not in INPUTS or INPUTS[k]==q;INPUTS[k]=q;return b,q
def obj(path):
    b,q=data(path)
    def pairs(items):
        out={}
        for k,v in items:assert k not in out;out[k]=v
        return out
    def reject(v):raise AssertionError(v)
    value=json.loads(b,object_pairs_hook=pairs,parse_float=reject,parse_constant=reject)
    assert type(value)is dict;return value,q
def pin(q):
    assert type(q)is dict and set(q)=={'path','bytes','sha256'} and type(q['bytes'])is int and 0<q['bytes']<=CAP
    b,p=data(q['path']);assert p==q;return b
def source(path):
    b,q=data(path);tree=ast.parse(b);compile(b,str(path),'exec');return b.decode(),tree,q
def check(name,value,evidence=None):
    assert type(value)is bool
    row=dict(name=name,passed=value)
    if evidence is not None:row['evidence']=evidence
    CHECKS.append(row)
def parts(label,text,values):
    for index,value in enumerate(values,1):
        at=text.find(value);check(label+' '+str(index),at>=0,dict(Source_text=value,first_line=text[:at].count('\n')+1 if at>=0 else None))
def save(path,value):
    b=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert 0<len(b)<=CAP
    with path.open('xb') as f:f.write(b)
    assert path.read_bytes()==b
    return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
