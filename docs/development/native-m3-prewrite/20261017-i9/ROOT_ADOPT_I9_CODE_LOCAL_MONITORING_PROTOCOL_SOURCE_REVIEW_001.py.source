"""Root adopts genuinely different monitoring protocol/template Source proof only."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP=2097152
def fact(path):
    path=Path(path);assert path.is_file() and not path.is_symlink()
    data=path.read_bytes();assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())
def pin(q):
    assert type(q) is dict and set(q)=={'path','bytes','sha256'}
    assert type(q['bytes']) is int and 0<=q['bytes']<=CAP and re.fullmatch('[0-9a-f]{64}',q['sha256'])
    if q['bytes']==0:
        assert Path(q['path']).parent==P and re.fullmatch(r'ROOT_I9_ACTUAL_MEMORY_CHILD_(?:STDOUT|STDERR)_[0-9]{3}\.txt',Path(q['path']).name)
    assert fact(q['path'])==q
    return Path(q['path']).read_bytes()
def pairs(items):
    result={}
    for key,value in items:
        assert key not in result;result[key]=value
    return result
def bad(value):raise AssertionError(value)
def obj(data):return json.loads(data,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv)==3 and re.fullmatch('[0-9a-f]{64}',sys.argv[2])
cp=fact(sys.argv[1]);assert cp['sha256']==sys.argv[2] and Path(cp['path']).parent==P/'bound_tool_review_001'
c=obj(pin(cp));f=obj(pin(c['full_proof']))
for value in (c,f):
    assert value['reviewer']=='/root/phase_frontier' and value['source_author']=='/root/owner_publication_review'
    assert value['target_execution'] is False and value['tests_executed'] is False
    assert value['checks_failed']==0 and type(value['checks_failed']) is int
    assert value['verdict'].startswith('PASS_') and 'MONITORING' in value['verdict']
assert c['verdict']==f['verdict']
checks=f['checks'];inputs=f['all_actual_inputs']
assert checks and len({q['name'] for q in checks})==len(checks)
assert all(type(q['passed']) is bool and q['passed'] for q in checks)
assert c['checks_passed']==f['checks_passed']==len(checks)
assert inputs and len({q['path'].casefold() for q in inputs})==len(inputs) and c['reviewer_Source'] in inputs
for q in inputs:pin(q)
protocol=fact(P/'ROOT_I9_CODE_LOCAL_MONITORING_EXACT_INSTRUMENTATION_PROTOCOL_001.json')
assert protocol['sha256']=='9b34de28ba26474a416bb5708673f62804ea547a26bfb80807ce1c0595b11e4a'
templates=[fact(P/'memory_tooling_001'/name) for name in (
 'RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_TEMPLATE_003.py',
 'SUPERVISE_I9_ONCE_MEMORY_FIXTURES_TEMPLATE_003.py',
 'PREPARE_I9_FRESH_MEMORY_SCOPE_TEMPLATE_003.py',
 'CAPTURE_I9_ACTUAL_MEMORY_STREAMS_TEMPLATE_003.py')]
expected=[protocol,*templates]
assert c['subjects']==f['subjects'] and len(c['subjects'])==5 and all(q in c['subjects'] and q in inputs for q in expected)
unknown=fact(P/'ROOT_I9_ATTEMPT006_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json')
assert unknown in inputs
u=obj(pin(unknown));assert u['author']=='/root' and u['I9_memory_test_runs'] is None
assert u['known_I9_memory_test_runs']==4 and u['unknown_I9_memory_test_runs']==2 and u['spent_memory_scope_count']==6
window=obj(pin(obj(pin(protocol))['source_window']))
assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=65)<datetime.datetime.fromisoformat(window['interval_end'])
record=dict(schema_version=1,author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY',subjects=expected,
    different_Source_review=cp,full_proof=c['full_proof'],reviewer_Source=c['reviewer_Source'],
    actual_named_checks=len(checks),all_actual_inputs_rehashed=True,actual_input_count=len(inputs),
    instrumentation_protocol=protocol,unknown_timeout006_adoption=unknown,
    original_target_Source_adoption=obj(pin(protocol))['adopted_target_Source'],
    I9_memory_test_runs=None,known_I9_memory_test_runs=4,unknown_I9_memory_test_runs=2,spent_memory_scope_count=6,
    target_Source_unchanged=True,all98_cases_and_50M_event_cap_and60plus5_preserved=True,
    actual_new_bound_tool_review_and_fresh_scope_review_required=True,new_invocation_authorized_now=False,
    target_execution=False,tests_executed=False,operational_authority=False,scientific_authority=False)
data=(json.dumps(record,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(data)<=CAP
path=P/'ROOT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_REVIEW_ADOPTION_001.json'
with path.open('xb') as handle:
    handle.write(data);handle.flush();os.fsync(handle.fileno())
print(json.dumps(fact(path)))
