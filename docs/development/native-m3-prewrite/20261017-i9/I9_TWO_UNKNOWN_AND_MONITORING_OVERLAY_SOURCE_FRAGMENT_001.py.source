"""Inert evidence adapter Source for exact two unknowns and different monitoring review."""
def inspect_current_monitoring_overlay(bindings, dated_Source_pin, saved_inputs):
    receipt_pin = bindings["actual_current_instrumentation_binding_receipt"]
    check("exact current instrumentation binding receipt path", receipt_pin["path"] == str(P / "ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_007.json") and receipt_pin in saved_inputs)
    receipt = loads(pinned(receipt_pin))
    check("binding receipt retains dated original Source adoption", receipt["author"] == "/root" and receipt["actual_Source_adoption"] == dated_Source_pin and receipt["target_execution"] is False and receipt["tests_executed"] is False)
    config = loads(pinned(receipt["actual_bindings"]))
    check("current bound config keeps exact Source adoption and scope7", config["Source_adoption"] == dated_Source_pin and config["attempt_numbers"] == [7] and type(config["maximum_profiled_module_calls"]) is int and config["maximum_profiled_module_calls"] == 50000000)
    adoption_pin = receipt["instrumentation_protocol_Root_adoption"]
    adoption = loads(pinned(adoption_pin))
    check("actual different monitoring protocol adoption", adoption_pin in saved_inputs and adoption["author"] == "/root" and adoption["verdict"] == "ACCEPT_I9_CODE_LOCAL_MONITORING_PROTOCOL_AND_TEMPLATE_SOURCE_ONLY" and adoption["tests_executed"] is False and adoption["target_execution"] is False)
    check("current overlay preserves known4 unknown2 spent6", adoption["I9_memory_test_runs"] is None and type(adoption["known_I9_memory_test_runs"]) is int and adoption["known_I9_memory_test_runs"] == 4 and type(adoption["unknown_I9_memory_test_runs"]) is int and adoption["unknown_I9_memory_test_runs"] == 2 and type(adoption["spent_memory_scope_count"]) is int and adoption["spent_memory_scope_count"] == 6 and adoption["original_target_Source_adoption"] == dated_Source_pin)
    protocol_pin = adoption["instrumentation_protocol"]
    check("exact current instrumentation protocol pin", protocol_pin == {"path": str(P / "ROOT_I9_CODE_LOCAL_MONITORING_EXACT_INSTRUMENTATION_PROTOCOL_001.json"), "bytes": 4246, "sha256": "9b34de28ba26474a416bb5708673f62804ea547a26bfb80807ce1c0595b11e4a"})
    protocol = loads(pinned(protocol_pin))
    check("protocol anchored to unchanged dated target", protocol["adopted_target_Source"] == dated_Source_pin)
    unknown6 = adoption["unknown_timeout006_adoption"]
    check("exact current unknown6 overlay pin", unknown6 == receipt["unknown_timeout006_Root_adoption"] == {"path": str(P / "ROOT_I9_ATTEMPT006_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json"), "bytes": 13618, "sha256": "7c33bd55c0aa899636fee61af58f0afafbbe979d84fb9c85de5083d44880fc89"})
    pinned(unknown6)
    peer_capsule = loads(pinned(adoption["different_Source_review"]))
    peer_full = loads(pinned(adoption["full_proof"]))
    check("genuinely different phase monitoring review joins", peer_capsule["full_proof"] == adoption["full_proof"] and peer_capsule["reviewer_Source"] == adoption["reviewer_Source"] and peer_capsule["verdict"] == peer_full["verdict"] and peer_capsule["verdict"].startswith("PASS_") and "MONITORING" in peer_capsule["verdict"])
    for record in (peer_capsule, peer_full):
        check("own instrumentation is not self-approved", record["reviewer"] == "/root/phase_frontier" and record["source_author"] == AUTHOR and record["tests_executed"] is False and record["target_execution"] is False and type(record["checks_failed"]) is int and record["checks_failed"] == 0)
    peer_checks, peer_inputs = peer_full["checks"], peer_full["all_actual_inputs"]
    check("different peer actual checks and ledger", len(peer_checks) == len({q["name"] for q in peer_checks}) == adoption["actual_named_checks"] and all(q["passed"] is True and type(q["passed"]) is bool for q in peer_checks) and len(peer_inputs) == len({q["path"].casefold() for q in peer_inputs}) == adoption["actual_input_count"] and adoption["reviewer_Source"] in peer_inputs and unknown6 in peer_inputs)
    for q in peer_inputs:
        pinned(q)  # Hash/source-provenance readback only, never our tool acceptance.
    check("peer exact protocol plus four template subjects", peer_capsule["subjects"] == peer_full["subjects"] == adoption["subjects"] and len(adoption["subjects"]) == 5 and protocol_pin in adoption["subjects"])
    for q in adoption["subjects"]:
        check("peer subject in actual different review inputs", q in peer_inputs)
        pinned(q)
    return {"receipt_pin": receipt_pin, "protocol_adoption_pin": adoption_pin, "unknown6_pin": unknown6, "config": config}


def inspect_exact_unknown_timeouts(row, saved_inputs, unknown_root_adoptions):
    ordinal = row["attempt_ordinal"]
    check("only exact unknown5or6 rows may lack child result", type(ordinal) is int and ordinal in (5, 6) and row["result"] is None and row["tests_executed"] is None and row["I9_memory_test_runs"] is None and row["actual_test_case_count"] is None and row["all_cases_passed"] is None and row["accepted_complete_run"] is False and row["unknown_suite_status"] is True)
    suffix = f"{ordinal:03d}"
    hashes = {
        5: ("eff3eab32516e56644e0dbab2f7526e729a8541ea0c44ab3e5f228f466ccf786", "8b2f9bc4324cf6acc0b220348bd9db8a8ee20a9bf45468ce827896eaea781de3", "0131b744aea3a426339a34105723ccc1910c529d492ece6e01e58de51d5cf990"),
        6: ("ab0e6174de0b0ab270976822ea407d8f9dc02a258de4390efd5720023b9fce2e", "649b1bf8e76040f17c0edaf261b76fcfd838ff83f64888f394ae92a646d11fd2", "cc93a06dc2eff2a840857299d546c01f68fe9944104d9fc8473b6de05883f593"),
    }
    sp, vp, ep = row["scope"], row["supervisor"], row["streams_capture"]
    for pin, stem, size, digest in zip((sp, vp, ep), ("ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE", "ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT", "ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE"), (9147, 3563, 2148), hashes[ordinal]):
        check("exact frozen unknown artifact: " + stem + suffix, pin == {"path": str(P / f"{stem}_{suffix}.json"), "bytes": size, "sha256": digest} and pin in saved_inputs)
    scope, supervisor, envelope = (loads(pinned(q)) for q in (sp, vp, ep))
    check("unknown has no actual child result: " + suffix, not (P / f"ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json").exists() and supervisor["child_saved_result"] is None)
    check("unknown suite entry and progress remain null: " + suffix, supervisor["tests_executed"] is None and supervisor["I9_memory_test_runs"] is None)
    check("unknown one owned launch is not suite entry: " + suffix, type(supervisor["owned_child_invocations"]) is int and supervisor["owned_child_invocations"] == 1 and type(supervisor["owned_child_PID"]) is int and supervisor["owned_child_PID"] > 0)
    check("unknown unaccepted/reaped/joined: " + suffix, supervisor["passed"] is False and supervisor["refusal"] == "owned I9 child exceeded60second wall cap" and supervisor["owned_child_wait_reaped"] is True and supervisor["stream_reader_threads_joined"] is True)
    check("unknown saved wall/reap cap: " + suffix, supervisor["wall_cap_seconds"] == 60 and supervisor["cleanup_reap_seconds"] == 5 and type(supervisor["owned_child_wall_integer_nanoseconds"]) is int and 60000000000 <= supervisor["owned_child_wall_integer_nanoseconds"] < 65000000000)
    check("unknown exact scope/capture joins: " + suffix, supervisor["scope"] == envelope["scope"] == sp and envelope["supervisor_result"] == vp and scope["attempt_number"] == supervisor["attempt_number"] == envelope["attempt_number"] == ordinal)
    check("unknown capture complete without replay: " + suffix, envelope["all_streams_complete"] is True and envelope["no_child_or_test_rerun"] is True and envelope["supervisor_accepted"] is False)
    check("unknown exactly two streams: " + suffix, len(supervisor["streams"]) == len(envelope["streams"]) == 2)
    for role, observed, captured in zip(("STDOUT", "STDERR"), supervisor["streams"], envelope["streams"]):
        q = observed["actual_capture"]
        check("unknown exact zero raw stream: " + role + suffix, q == {"path": str(P / f"ROOT_I9_ACTUAL_MEMORY_CHILD_{role}_{suffix}.txt"), "bytes": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"} and q in saved_inputs and captured["actual_capture"] == q and captured["UTF8_text"] == "" and observed["overcap"] is False and observed["reader_error"] is None and pinned(q) == b"")
    for stem in ("ROOT_I9_MEMORY_SCOPE_CONSUMED", "ROOT_I9_MEMORY_SUPERVISOR_CONSUMED"):
        q = fact(P / f"{stem}_{suffix}.json")
        marker = loads(pinned(q))
        check("unknown consumed marker retained: " + suffix, q in saved_inputs and marker["scope"] == sp and marker["automatic_retry_authorized"] is False)
    fresh_pin = fact(P / f"ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION_{suffix}.json")
    fresh = loads(pinned(fresh_pin))
    check("unknown actual fresh adoption: " + suffix, fresh_pin in saved_inputs and fresh["author"] == "/root" and fresh["fresh_one_use_scope"] == sp and fresh["verdict"] == "ACCEPT_I9_FRESH_ONE_USE_SYNTHETIC_MEMORY_SCOPE_ONLY")
    check("unknown explicit Root adoption retained: " + suffix, ordinal in unknown_root_adoptions and unknown_root_adoptions[ordinal] in saved_inputs and row["unknown_timeout_Root_adoption"] == unknown_root_adoptions[ordinal])
    root = loads(pinned(unknown_root_adoptions[ordinal]))
    check("unknown Root does not invent suite count: " + suffix, root["author"] == "/root" and root["verdict"] == "ACCEPT_I9_ACTUAL_UNKNOWN_TIMEOUT_AND_EXACT_EQUIVALENT_SOURCE_CORRECTION_ONLY" and root["I9_memory_test_runs"] is None and type(root["known_I9_memory_test_runs"]) is int and root["known_I9_memory_test_runs"] == 4 and type(root["unknown_I9_memory_test_runs"]) is int and root["unknown_I9_memory_test_runs"] == ordinal-4 and type(root["spent_memory_scope_count"]) is int and root["spent_memory_scope_count"] == ordinal)
    check("unknown Root no grant or progress claim: " + suffix, root["accepted_complete_memory_test_runs"] == 0 and root["failed_memory_test_runs"] == 4 and root["actual_completed_case_count"] is None and root["actual_error"] is None and root["new_invocation_authorized_now"] is False)
    return 1
