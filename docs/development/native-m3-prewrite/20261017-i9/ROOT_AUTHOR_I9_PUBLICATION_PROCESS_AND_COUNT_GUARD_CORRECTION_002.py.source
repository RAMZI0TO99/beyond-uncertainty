"""Author unrun successors after actual preliminary Source findings; no publication."""
import ast, datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
def fact(path):
    data = path.read_bytes(); assert len(data) <= 2097152
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
def save_source(name, text):
    data = text.encode(); output = P / name
    ast.parse(data); compile(data, str(output), 'exec')
    with output.open('xb') as handle:
        handle.write(data); handle.flush(); os.fsync(handle.fileno())
    return fact(output)
review = fact(P / 'managed_review_001/INDEPENDENT_I9_PUBLICATION_TOOLING_PRELIMINARY_SOURCE_REVIEW_001.json')
assert review['sha256'] == 'bb719ef2eb62c064b68c62b3be87b96daf9d666835c866684664d23dd22fc346'
counts = '''def validate_counts(a):
 for key in ('actual_memory_case_count','actual_memory_cases_passed','I9_memory_test_runs','failed_memory_test_runs','accepted_complete_memory_test_runs','accepted_attempt_ordinal'):
  assert type(a[key]) is int and a[key]>=0, key
 assert 1<=a['actual_memory_case_count']<=256 and a['actual_memory_cases_passed']==a['actual_memory_case_count']
 runs=a['I9_memory_test_runs'];failed=a['failed_memory_test_runs']
 assert runs>=1 and a['accepted_complete_memory_test_runs']==1 and runs==failed+1
 attempts=a['all_saved_memory_attempts'];assert type(attempts) is list and 1<=len(attempts)<=999 and a['accepted_attempt_ordinal']==len(attempts)
 for ordinal,row in enumerate(attempts,1):
  assert type(row) is dict and type(row['attempt_ordinal']) is int and row['attempt_ordinal']==ordinal
  assert type(row['I9_memory_test_runs']) is int and row['I9_memory_test_runs'] in (0,1)
  assert type(row['tests_executed']) is bool and row['I9_memory_test_runs']==int(row['tests_executed'])
  assert type(row['accepted_complete_run']) is bool and row['accepted_complete_run'] is (ordinal==len(attempts))
  assert type(row['all_cases_passed']) is bool and row['all_cases_passed'] is row['accepted_complete_run']
  if row['accepted_complete_run']:assert row['tests_executed'] is True
 assert sum(row['I9_memory_test_runs'] for row in attempts)==runs
 assert sum(row['I9_memory_test_runs'] for row in attempts if not row['accepted_complete_run'])==failed
 return runs,failed

'''
builder_path = P / 'ROOT_PREPARE_I9_MANAGED_CANDIDATES_001.py'; builder_pin = fact(builder_path)
assert builder_pin['sha256'] == '4f061118ef760796e835e4b59816c833042de057ed5535166045548ef6dc4a63'
builder = builder_path.read_bytes().decode()
assert builder.count('def main():\n') == 1
builder = builder.replace('def main():\n', counts + 'def main():\n')
old = "    runs = adoption['I9_memory_test_runs']\n    failed_runs = adoption['failed_memory_test_runs']\n    assert type(runs) is int and type(failed_runs) is int and runs == failed_runs + 1\n    assert adoption['accepted_complete_memory_test_runs'] == 1\n"
assert builder.count(old) == 1
builder = builder.replace(old, '    runs, failed_runs = validate_counts(adoption)\n')
needle = "Root_implementation_adoption=adoption_pin, prior_I8_scope=previous_pin,"
assert builder.count(needle) == 1
builder = builder.replace(needle, 'Root_implementation_adoption=adoption_pin, source_scope=scope_pin, prior_I8_scope=previous_pin,')
new_builder = save_source('ROOT_PREPARE_I9_MANAGED_CANDIDATES_002.py', builder)
pub_path = P / 'ROOT_REVIEWED_I9_FINITE_PUBLICATION_001.py'; pub_pin = fact(pub_path)
assert pub_pin['sha256'] == '71c603c6a39307d98c15a5dd22ce2ea9f4b4b66c184ed1c861e637176a6408d7'
pub = pub_path.read_bytes().decode()
assert pub.count('import pathlib,json,hashlib,datetime,os,subprocess,sys,ctypes,shutil') == 1
pub = pub.replace('import pathlib,json,hashlib,datetime,os,subprocess,sys,ctypes,shutil', 'import pathlib,json,hashlib,datetime,os,subprocess,sys,ctypes,shutil,time')
tree = ast.parse(pub); nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'git']; assert len(nodes) == 1
lines = pub.splitlines(keepends=True); node = nodes[0]
git_source = '''def git(args,allowed=(0,)):
 argv=[GIT,'-c','core.autocrlf=false','-c','core.safecrlf=false',*args];st=now()
 p=subprocess.Popen(argv,cwd=G,env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE,creationflags=subprocess.CREATE_NO_WINDOW)
 try:out,err=p.communicate(timeout=60)
 except subprocess.TimeoutExpired as timeout:
  cleanup_started=time.monotonic_ns();kill_error=None;drained=False;out=timeout.output or b'';err=timeout.stderr or b''
  if p.poll() is None:
   try:p.kill()
   except BaseException as error:kill_error=type(error).__name__+': '+str(error)
  remaining=max(0,5-(time.monotonic_ns()-cleanup_started)/1000000000)
  try:out,err=p.communicate(timeout=remaining);drained=True
  except subprocess.TimeoutExpired as cleanup_error:out=cleanup_error.output or out;err=cleanup_error.stderr or err
  code=p.poll();reaped=code is not None
  def captured(data):
   assert type(data) is bytes
   prefix=data[:CAP]
   return dict(observed_bytes=len(data),saved_prefix_bytes=len(prefix),saved_prefix_sha256=hashlib.sha256(prefix).hexdigest(),overcap=len(data)>CAP)
  row=dict(argv=argv,cwd=str(G),owned_process_PID=p.pid,started_utc=st,completed_utc=now(),timed_out=True,owned_exact_child_kill_error=kill_error,owned_exact_child_reaped=reaped,owned_exit_code=code,streams_drained=drained,stdout=captured(out),stderr=captured(err),descendant_or_whole_Job_cleanup_verified=False,remote_or_index_effect_after_timeout_unknown=True,automatic_retry_authorized=False)
  calls.append(row)
  save('ROOT_I9_OWNED_GIT_TIMEOUT_REFUSAL_'+step.upper()+'_001.json',dict(record_type='Root_I9_owned_Git_timeout_refusal',step=step,scope=scopepin,actual_Git_calls=calls,timeout_seconds=60,cleanup_seconds=5,requires_read_only_effect_reconciliation_before_any_further_mutation=True,original_project_target_execution=False,operational_authority=False,scientific_authority=False))
  raise RuntimeError('Owned Git timeout; exact child cleanup recorded, effects require reconciliation') from timeout
 assert len(out)<=CAP and len(err)<=CAP
 calls.append({'argv':argv,'cwd':str(G),'owned_process_PID':p.pid,'started_utc':st,'completed_utc':now(),'exit_code':p.returncode,'stdout':out.decode('utf-8') if args[0]!='show' and len(out)<16384 else None,'stdout_bytes':len(out),'stdout_sha256':hashlib.sha256(out).hexdigest(),'stderr':err.decode('utf-8'),'Native_creation_Job_or_wholehost_proof':False})
 assert p.returncode in allowed,calls[-1]
 return out
'''
pub = ''.join(lines[:node.lineno-1]) + git_source + ''.join(lines[node.end_lineno:])
assert pub.count('scopefile=') == 1
pub = pub.replace('scopefile=', counts + "assert len(sys.argv)==4 and len(sys.argv[3])==64 and all(c in '0123456789abcdef' for c in sys.argv[3])\nscopefile=", 1)
marker = "managed_adoption_pin=fact(O/'ROOT_I9_FINITE_MANAGED_DOCS_SOURCE_REVIEW_ADOPTION_001.json')"
assert pub.count(marker) == 1
pub = pub.replace(marker, marker + ";assert managed_adoption_pin['sha256']==sys.argv[3]")
marker = "assert s['preexisting608_byte_baseline']['sha256']=="
assert pub.count(marker) == 1
admission = '''validate_counts(implementation)
managed_adoption=json.loads(pinned(managed_adoption_pin))
assert managed_adoption['verdict']=='ACCEPT_I9_FINITE_MANAGED_DOCS_SOURCE_PUBLICATION_ONLY'
assert managed_adoption['author']=='/root' and managed_adoption['target_execution'] is False and managed_adoption['tests_executed'] is False
assert managed_adoption['managed_publication_scope']==scopepin and managed_adoption['Root_implementation_adoption']==s['Root_implementation_adoption']
assert managed_adoption['source_scope']==s['source_scope'] and managed_adoption['all_actual_review_inputs_rehashed'] is True
assert type(managed_adoption['actual_file_count']) is int and managed_adoption['actual_file_count']==len(rows)

'''
pub = pub.replace(marker, admission + marker)
pub = pub.replace("authority();step=sys.argv[1]", "authority();step=sys.argv[1];assert step in ('copy','stage','commit','push')")
new_pub = save_source('ROOT_REVIEWED_I9_FINITE_PUBLICATION_002.py', pub)
receipt = dict(schema_version=1, record_type='Root_I9_publication_tool_process_count_and_exact_adoption_guard_correction_Source_receipt', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), actual_preliminary_findings=review, original_Source_subjects=[builder_pin,pub_pin], new_Source_subjects=[new_builder,new_pub], original_Source_preserved_unrun=True, new_Source_AST_and_compile_only=True, new_Source_invoked=False, actual_result_or_candidate_adoption_exists=False, exact_managed_adoption_verdict='ACCEPT_I9_FINITE_MANAGED_DOCS_SOURCE_PUBLICATION_ONLY', publication_argv='mode exact_scope_sha256 exact_managed_adoption_sha256', saved_attempt_row_contract='attempt_ordinal, I9_memory_test_runs builtin0or1, tests_executed bool, accepted_complete_run bool true only last row, all_cases_passed bool equals accepted_complete_run; exact sum/count/ordinal joins. Extra pinned evidence keys are allowed.', target_execution=False, tests_executed=False, operational_authority=False, scientific_authority=False)
data = (json.dumps(receipt, indent=2, sort_keys=True, allow_nan=False) + '\n').encode()
with (P / 'ROOT_I9_PUBLICATION_TOOL_PROCESS_AND_COUNT_GUARD_CORRECTION_SOURCE_RECEIPT_002.json').open('xb') as handle:
    handle.write(data); handle.flush(); os.fsync(handle.fileno())
