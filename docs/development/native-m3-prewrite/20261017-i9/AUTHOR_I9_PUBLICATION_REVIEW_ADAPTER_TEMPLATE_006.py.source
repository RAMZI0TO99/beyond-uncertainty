"""Author minimal UNBOUND template004 with dynamic explicit refusal lineage."""
import ast
import datetime
import hashlib
import json
import re
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
O=P/'managed_review_001'
CAP=2097152

def pin(path):
    data=path.read_bytes()
    assert len(data)<=CAP
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def main():
    original=O/'review_I9_managed_publication_TEMPLATE_003.py'
    assert pin(original)['sha256']=='ce54dd46fce9a47c812fa0e545356bb59d053f91a90327cb1847a43053cc1f28'
    text=original.read_text(encoding='utf-8')
    before='''    for key in ("protocol_adoption", "actor_clarifier", "actor_clarifier_adoption", "module001_refusal_adoption", "fixture001_refusal_adoption", "quartet002_cached_record_refusal_adoption", "prior_actual_memory_refusal_adoption", "prior_actual_memory_refusal002_adoption", "equivalent_surrogate_scan_correction", "prior_actual_memory_refusal003_adoption"):
        loads(pinned(source[key]))
'''
    after='''    for key in ("protocol_adoption", "actor_clarifier", "actor_clarifier_adoption", "module001_refusal_adoption", "fixture001_refusal_adoption", "quartet002_cached_record_refusal_adoption", "equivalent_surrogate_scan_correction"):
        loads(pinned(source[key]))
    source_refusal_lineage = {}
    for key in sorted(source):
        match = re.fullmatch(r"prior_actual_memory_refusal([0-9]{3})?_adoption", key)
        if match is None:
            continue
        ordinal = int(match.group(1) or "001")
        check("explicit Source refusal ordinal unique", 1 <= ordinal <= 999 and ordinal not in source_refusal_lineage)
        refusal_pin = source[key]
        check("explicit Source refusal included in different Source review", refusal_pin in source_inputs)
        refusal = loads(pinned(refusal_pin))
        check("explicit Source refusal genuine Root metadata", refusal["author"] == "/root" and refusal["operational_authority"] is False and refusal["scientific_authority"] is False)
        source_refusal_lineage[ordinal] = refusal_pin
'''
    assert text.count(before)==1
    text=text.replace(before,after)
    before='''    observed_supervisors = sorted(P.glob("ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_[0-9][0-9][0-9].json"))'''
    after='''    check("Source-provided refusals remain actual prior saved attempts", all(1 <= ordinal < len(attempts) for ordinal in source_refusal_lineage))
    observed_supervisors = sorted(P.glob("ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_[0-9][0-9][0-9].json"))'''
    assert text.count(before)==1
    text=text.replace(before,after)
    output=O/'review_I9_managed_publication_TEMPLATE_004.py'
    data=text.encode('utf-8')
    tree=ast.parse(data,filename=str(output))
    compile(tree,str(output),'exec')
    bindings=[n.value for n in tree.body if isinstance(n,ast.Assign) and
        any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets)]
    assert len(bindings)==1 and isinstance(bindings[0],ast.Constant) and bindings[0].value is None
    assert 'UNBOUND_I9_PUBLICATION_TEMPLATE' in text
    actual=[]
    for name,size,sha in (
        ('validate_recorded_M3_semantics_006.py',128619,'38b0d6343cb10b9ab28a9785f974d6a293ffed11713f7bea4e3111dbedaaca81'),
        ('test_recorded_M3_semantics_memory_only_005.py',2042670,'efbc96a635050337d7d2b39b36679db08c6d2c2b6fa66620ac437dd507e8a1b8'),
        ('CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_007.json',56319,'aa887eb2a276918123291715dae5fc4d9058d4cc8448e0b17415c7773e6a4371'),
        ('CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_007.json',39253,'57f5b7353540bc11f5d25457fa88275b015db0b87beb0b492c63e886b65aa205')):
        q=pin(P/'i9'/name)
        assert (q['bytes'],q['sha256'])==(size,sha)
        actual.append(q)
    failure_path=P/'ROOT_I9_ATTEMPT004_ACTUAL_SAVED_REFUSAL_AND_BOUNDED_SOURCE_CORRECTION_ADOPTION_001.json'
    failure_pin=pin(failure_path)
    assert failure_pin['bytes']==17729 and failure_pin['sha256']=='41d9fa373f35ac501de9a80065ee7e61186b490391d7b1fc959944544d0987e5'
    failure=json.loads(failure_path.read_bytes())
    assert type(failure['I9_memory_test_runs']) is int and failure['I9_memory_test_runs']==4
    assert failure['accepted_complete_memory_test_runs']==0 and failure['failed_memory_test_runs']==4
    assert failure['actual_completed_case_count']==1 and failure['actual_suite_passed'] is False
    result_path=P/'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_004.json'
    result=json.loads(result_path.read_bytes())
    assert result['I9_memory_test_runs']==1 and result['tests_executed'] is True and result['all_cases_passed'] is False
    assert result['actual_test_case_count']==1 and result['error']['message']=='E_ROLECAP_ORDER'
    assert result['partial_completed_cases_at_failure'][0]['name']=='positive_complete_templates5'
    assert result['partial_completed_cases_at_failure'][0]['passed'] is True
    api=json.loads(Path(actual[2]['path']).read_bytes())
    assert type(api['fixture_interface']['expected_case_count']) is int
    adopter=P/'ROOT_ADOPT_I9_FINAL_ACTUAL_QUARTET_SOURCE_REVIEW_006.py'
    adopter_tree=ast.parse(adopter.read_bytes())
    # Static schema observation only: no Root function is called.
    explicit_fields=sorted({keyword.arg for node in ast.walk(adopter_tree) if isinstance(node,ast.Call)
        and isinstance(node.func,ast.Name) and node.func.id=='dict' for keyword in node.keywords
        if keyword.arg and re.fullmatch(r'prior_actual_memory_refusal([0-9]{3})?_adoption',keyword.arg)})
    assert 'prior_actual_memory_refusal004_adoption' in explicit_fields
    inputs=[pin(original),pin(Path(__file__)),*actual,failure_pin,pin(result_path),pin(adopter)]
    with output.open('xb') as handle:
        handle.write(data)
    assert output.read_bytes()==data
    receipt=dict(schema_version=1,record_type='I9_publication_TEMPLATE004_dynamic_explicit_Source_refusal_lineage_preparation',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=inputs,reviewer_template=pin(output),Source_AST_compile_only=True,
        literal_EXACT_ROOT_BINDINGS=None,template_executed=False,target_execution=False,
        tests_executed=False,Root_tool_execution=False,Git_commands_or_mutation=False,
        prior_TEMPLATE003_preserved=True,
        exact_changes=['Replace hardcoded three Source-refusal keys with exact numbered field-name recognition of all explicitly present Source-adoption refusal pins, including004.',
            'Every explicit refusal must be in the different Source-review input ledger and belong to an actual prior saved ordinal; all1..K actual outcomes/markers/streams/counts remain reviewed independently.',
            'No change to modern I9_fixture_reruns0 ABI, positive Source2MiB cap, exact zero-stream support or dynamic accepted-case/run counts.'],
        current_quartet=actual,fixture_bytes_below_2MiB=CAP-actual[1]['bytes'],
        actual_API_planned_case_count=api['fixture_interface']['expected_case_count'],
        current_Root_Source_adopter_declared_refusal_fields=explicit_fields,
        current_actual_global_runs=4,current_actual_failed_runs=4,current_actual_accepted_runs=0,
        actual_attempt004_completed_case_count=1,actual_attempt004_first_case='positive_complete_templates5',
        Source_adoption005_exists_at_observation=(P/'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_005.json').exists(),
        actual_attempt005_result_exists_at_observation=(P/'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_005.json').exists(),
        final_accepted_case_count=None,final_candidate_count=None,final_results_or_candidate_verdict_issued=False,
        pending='Bind only actual future final Source/saved-result adoptions and candidate scope; retain all current four failed invocations and any later actual history. No target/candidate acceptance is claimed.',
        operational_authority=False,scientific_authority=False)
    dest=O/'I9_PUBLICATION_REVIEW_TEMPLATE004_PREPARATORY_ACTUAL_RECEIPT_001.json'
    encoded=(json.dumps(receipt,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
    assert len(encoded)<=CAP
    with dest.open('xb') as handle:
        handle.write(encoded)
    assert dest.read_bytes()==encoded
    for q in inputs:
        assert pin(Path(q['path']))==q
    print(json.dumps(dict(template=pin(output),receipt=pin(dest),author_Source=pin(Path(__file__))),indent=2))

if __name__=='__main__':
    main()
