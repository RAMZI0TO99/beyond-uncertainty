 fixed_literal_data_audit=dict(records=len(fixed_raw),raw_body_bytes=sum(map(len,fixed_raw.values())),decoded_bundle_bytes=len(bundle),maximum_raw_body_bytes=max(map(len,fixed_raw.values())),decompression_is_known_literal_data_only=True),
