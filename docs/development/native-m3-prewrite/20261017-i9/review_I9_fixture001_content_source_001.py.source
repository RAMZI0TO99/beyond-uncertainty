table=symtable.symtable(text,q['path'],'exec');known=set(table.get_identifiers());unknown=[]
def symbols(block):
    for v in block.get_symbols():
        if v.is_global() and v.is_referenced() and v.get_name() not in known and v.get_name() not in vars(builtins):unknown.append([block.get_name(),v.get_name()])
    for b in block.get_children():symbols(b)
symbols(table);check('no_unresolved_fixture_global_symbols',not unknown,[q])

