def save(name,value):
    path=OWN/name;b=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
    with path.open('xb') as h:h.write(b)
    return dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
