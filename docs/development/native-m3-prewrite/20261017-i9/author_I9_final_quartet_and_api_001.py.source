fixture_raw=draft.read_bytes();fixture_tree=ast.parse(fixture_raw)
compile(fixture_raw,'I9_new_fixture_Source_only','exec')
literals={}
for node in fixture_tree.body:
    if isinstance(node,ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0],ast.Name) and node.targets[0].id in ('EXPECTED_CASE_COUNT','PLANNED_CASE_NAMES'):
        literals[node.targets[0].id]=ast.literal_eval(node.value)
names=literals['PLANNED_CASE_NAMES'];count=literals['EXPECTED_CASE_COUNT']
assert type(count) is int and count==95 and type(names) in (list,tuple) and len(names)==count and len(set(names))==count
entry=next(n for n in fixture_tree.body if isinstance(n,ast.FunctionDef) and n.name=='run_memory_suite')
assert len(entry.args.args)==1 and entry.args.args[0].arg=='module'
for node in ast.walk(fixture_tree):
    if isinstance(node,ast.Call) and isinstance(node.func,ast.Name):assert node.func.id not in ('exec','eval','compile','open','__import__')
    if isinstance(node,ast.Import):assert all(n.name in ('ast','base64','copy','datetime','difflib','hashlib','json','re','zlib') for n in node.names)
    if isinstance(node,ast.ImportFrom):raise AssertionError('unexpected from-import')
fixture_pin=save(OWN/'test_recorded_M3_semantics_memory_only_001.py',fixture_raw)
assert fixture_pin['sha256']==dp['sha256']
