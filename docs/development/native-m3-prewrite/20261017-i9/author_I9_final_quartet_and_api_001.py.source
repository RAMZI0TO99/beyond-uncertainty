"""Assemble Source evidence only. Never load/call the new module or fixture."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012\i9')
P=OWN.parent
def pin(path):
    raw=path.read_bytes();return dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest())
def save(path,raw):
    assert not path.exists() and 0<len(raw)<=2097152
    with path.open('xb') as f:f.write(raw)
    assert path.read_bytes()==raw
    return pin(path)
def wire(value):return (json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
def read_json(path):return json.loads(path.read_bytes())
