x = dict(schema_version=1, record_type='Root_I9_protocol001_exact_current_diff_header_clarification', author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(), protocol=dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest()),
