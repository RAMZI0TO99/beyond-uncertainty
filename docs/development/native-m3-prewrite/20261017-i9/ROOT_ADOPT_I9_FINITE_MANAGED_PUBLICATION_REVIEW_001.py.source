"""Root adopts exact finite inert documentation candidates; no Git mutation."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
R = Path(r'D:\Aenv\pro2')
P = R / 'WORK/resume-20261017-001/m3_prewrite_validation_012'
G = R / 'github-portable-20261012-001'
CAP = 2097152
REL = 'docs/development/native-m3-prewrite/20261017-i9/'
EXCEPTION = dict(path=str(G / 'docs/development/closeout-evidence/root-docs-independent-major036/INDEPENDENT_MAJOR036_CREATION_REVIEW_001.json'), bytes=3483233, sha256='e646afc11642d8df66cf7ef0aff26474ce45eaec23d08ecd16f17eaedae2b0e9')

def raw(path, cap=CAP):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= cap
    with path.open('rb') as handle:
        data = handle.read(cap + 1)
    assert len(data) <= cap
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and q['bytes'] >= 0
    assert type(q['sha256']) is str and re.fullmatch('[0-9a-f]{64}', q['sha256'])
    cap = CAP
    if q['bytes'] > CAP:
        assert q == EXCEPTION
        cap = q['bytes']
    data = raw(q['path'], cap)
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def main():
    assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
    assert len(sys.argv) == 3 and re.fullmatch('[0-9a-f]{64}', sys.argv[2])
    capsule_path = Path(sys.argv[1])
    assert capsule_path.parent == P / 'managed_review_001' and 'CAPSULE' in capsule_path.name
    cp = fact(capsule_path)
    assert cp['sha256'] == sys.argv[2]
    c = obj(pin(cp))
    f = obj(pin(c['full_proof']))
    for record in (c, f):
        assert record['reviewer'] == '/root/owner_publication_review'
        assert record['verdict'].startswith(('PASS_', 'ACCEPT_'))
        assert type(record['checks_failed']) is int and record['checks_failed'] == 0
        assert record['target_execution'] is False and record['tests_executed'] is False
        assert record['new_I9_module_or_fixture_rerun_by_reviewer'] is False
        assert record['I0_I1_I2_I3_I4_I5_I6_I7_I8_import_call_or_test'] is False
        assert record['native_Parser_original_runtime_or_scientific_execution'] is False
        assert record['Git_mutation_or_Root_publication_script_execution'] is False
        assert record['Git_command_executed'] is False
        for key in ('all342_prior_I6_I7_I8_non_navigation_files_preserved', 'all608_historical_bytes_preserved', 'all8_frozen_sentinels_preserved', 'all3_complete_navigation_suffixes_preserved'):
            assert record[key] is True
        assert tuple(record[k] for k in ('current_Source_present', 'pending_roles', 'frozen_STEP080_present', 'frozen_STEP080_pending')) == (36, 9, 35, 10)
    assert c['verdict'] == f['verdict']
    checks = f['checks']
    assert type(checks) is list and checks and len({q['name'] for q in checks}) == len(checks)
    assert all(type(q['passed']) is bool and q['passed'] is True for q in checks)
    assert type(f['serialized_check_count']) is int and f['serialized_check_count'] == len(checks)
    inputs = f['all_actual_inputs']
    assert type(inputs) is list and inputs and len({q['path'].casefold() for q in inputs}) == len(inputs)
    assert c['reviewer_Source'] in inputs
    for q in inputs:
        pin(q)
    scope_pin = fact(P / 'managed_preparation_001/candidates_001/EXACT_MANAGED_I9_RECORDED_M3_SEMANTICS_PUBLICATION_SCOPE_001.json')
    assert scope_pin == c['managed_publication_scope'] == f['managed_publication_scope'] and scope_pin in inputs
    s = obj(pin(scope_pin))
    assert s['author'] == '/root' and s['base_HEAD'] == 'add1a93c7a0ad841f3760565b087afcbe638d292'
    rows = s['files']
    assert type(s['managed_file_count']) is int and len(rows) == s['managed_file_count'] == f['candidate_file_count']
    assert len({row['managed_path'].casefold() for row in rows}) == len(rows)
    navigation = []
    for row in rows:
        data = pin(row['source'])
        assert row['source'] in inputs
        assert Path(row['source']['path']).resolve().is_relative_to((R / 'WORK/I9P012/c1').resolve())
        name = row['managed_path']
        if row['mode'] == 'prepend':
            assert name in ('AGENTS.md', 'CONTINUE.md', 'README.md')
            old = pin(row['predecessor'])
            assert pin(row['saved_predecessor']) == old
            assert row['predecessor']['path'] == str(G / name) and fact(G / name) == row['predecessor']
            assert type(row['prefix_bytes']) is int and row['prefix_bytes'] > 0 and data[row['prefix_bytes']:] == old
            navigation.append(name)
        else:
            assert row['mode'] == 'create' and name.startswith(REL) and not (G / name).exists()
            assert Path(name).suffix in ('.json', '.source', '.txt', '.md') and '..' not in Path(name).parts
    assert set(navigation) == {'AGENTS.md', 'CONTINUE.md', 'README.md'}
    implementation = obj(pin(s['Root_implementation_adoption']))
    assert s['Root_implementation_adoption'] == c['Root_implementation_adoption'] == f['Root_implementation_adoption']
    assert implementation['author'] == '/root' and implementation['verdict'] == 'ACCEPT_I9_RECORDED_M3_SEMANTICS_AND_SAVED_MEMORY_RESULTS_ONLY'
    assert implementation['tests_executed'] is True and implementation['original_project_native_Parser_runtime_scientific_execution'] is False
    assert type(implementation['actual_memory_case_count']) is int and 1 <= implementation['actual_memory_case_count'] <= 256
    assert implementation['actual_memory_case_count'] == implementation['actual_memory_cases_passed'] == f['actual_I9_memory_cases_saved_passed']
    assert implementation['I9_memory_test_runs'] == f['I9_memory_runs_saved_and_adopted']
    assert implementation['accepted_complete_memory_test_runs'] == f['accepted_complete_memory_runs'] == 1
    assert implementation['failed_memory_test_runs'] == f['failed_memory_runs_preserved']
    assert implementation['I9_memory_test_runs'] == implementation['failed_memory_test_runs'] + 1
    assert s['all_saved_memory_attempts'] == implementation['all_saved_memory_attempts']
    scope = obj(pin(s['source_scope']))
    assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(scope['interval_end'])
    result = dict(schema_version=1, record_type='Root_actual_I9_finite_managed_docs_Source_review_adoption',
        author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        verdict='ACCEPT_I9_FINITE_MANAGED_DOCS_SOURCE_PUBLICATION_ONLY',
        managed_publication_scope=scope_pin, Root_implementation_adoption=s['Root_implementation_adoption'],
        source_scope=s['source_scope'], different_Source_review=cp, full_proof=c['full_proof'],
        reviewer_Source=c['reviewer_Source'], actual_named_checks=len(checks),
        actual_review_input_count=len(inputs), all_actual_review_inputs_rehashed=True,
        actual_file_count=len(rows), actual_adopted_I9_memory_cases=implementation['actual_memory_case_count'],
        I9_memory_test_runs=implementation['I9_memory_test_runs'],
        accepted_complete_memory_test_runs=1, failed_memory_test_runs=implementation['failed_memory_test_runs'],
        all_saved_memory_attempts=implementation['all_saved_memory_attempts'],
        exact_historical_large_file_exception=EXCEPTION,
        all608_historical_bytes_and342_prior_inert_files_and8_sentinels_and36_Source_files_preserved=True,
        all9_pending_canonical_paths_absent=True, complete_navigation_suffixes_preserved=3,
        tests_executed=False, target_execution=False, new_I9_fixture_reruns=0,
        original_native_Parser_project_execution=False,
        only_reviewed_finite_Git_copy_stage_commit_push_may_follow=True,
        operational_authority=False, scientific_authority=False)
    data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(data) <= CAP
    path = P / 'ROOT_I9_FINITE_MANAGED_DOCS_SOURCE_REVIEW_ADOPTION_001.json'
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    print(json.dumps(fact(path)))

if __name__ == '__main__':
    main()
