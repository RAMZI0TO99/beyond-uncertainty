"""Bind exact finite-adopter field aliases in another unexecuted template."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
O=P/'managed_review_001'

def pin(path):
    data=path.read_bytes()
    assert len(data)<=2097152
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def main():
    original=O/'review_I9_managed_publication_TEMPLATE_005.py'
    assert pin(original)['sha256']=='5bac4fb39caa5e6ba1832167e8914ecb820eb02fdb0e9aa15f3bf1fc6492de25'
    text=original.read_text(encoding='utf-8')
    before='"I9_memory_runs_saved_and_adopted": actual["total_runs"],'
    after='"I9_memory_runs_saved_and_adopted": actual["total_runs"], "known_I9_memory_runs_saved_and_adopted": actual["known_runs"], "unknown_I9_memory_runs_preserved": actual["unknown_runs"], "spent_memory_scopes_saved": actual["spent_scopes"],'
    assert text.count(before)==1
    text=text.replace(before,after)
    output=O/'review_I9_managed_publication_TEMPLATE_006.py'
    data=text.encode('utf-8')
    tree=ast.parse(data,filename=str(output))
    compile(tree,str(output),'exec')
    bindings=[n.value for n in tree.body if isinstance(n,ast.Assign) and
        any(isinstance(t,ast.Name) and t.id=='EXACT_ROOT_BINDINGS' for t in n.targets)]
    assert len(bindings)==1 and isinstance(bindings[0],ast.Constant) and bindings[0].value is None
    root_receipt=P/'ROOT_I9_FINITE_REVIEW_ADOPTER_TRUTHFUL_TIMEOUT_SOURCE_RECEIPT_001.json'
    rr=json.loads(root_receipt.read_bytes())
    assert pin(root_receipt)['bytes']==849 and pin(root_receipt)['sha256']=='3fdea73efcfbdb4795c35ddb0a7100d9264b89db3bac8eb98ee8b7469fa415f1'
    root_source=Path(rr['new_Source']['path'])
    assert pin(root_source)==rr['new_Source']
    source=root_source.read_text(encoding='utf-8')
    compile(ast.parse(source),str(root_source),'exec')
    for field in ('known_I9_memory_runs_saved_and_adopted','unknown_I9_memory_runs_preserved','spent_memory_scopes_saved'):
        assert field in source and '"'+field+'": actual[' in text
    with output.open('xb') as handle:
        handle.write(data)
    assert output.read_bytes()==data
    inputs=[pin(original),pin(Path(__file__)),pin(root_receipt),pin(root_source),
        pin(O/'I9_PUBLICATION_REVIEW_TEMPLATE005_PREPARATORY_ACTUAL_RECEIPT_001.json')]
    record=dict(schema_version=1,record_type='I9_unbound_timeout_accounting_template006_exact_finite_adopter_field_compatibility',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=inputs,reviewer_template=pin(output),Source_AST_compile_only=True,
        literal_EXACT_ROOT_BINDINGS=None,template_executed=False,target_execution=False,
        tests_executed=False,Root_tool_execution=False,Git_commands_or_mutation=False,
        prior_TEMPLATE005_preserved=True,
        exact_change='Only add exact full/capsule known/unknown/spent alias fields required by actual Root finite adopter002; nullable aggregate and all timeout/foundation checks remain unchanged.',
        actual_current_total_fixture_invocations=None,actual_current_known_fixture_invocations=4,
        actual_current_unknown_fixture_status_attempts=1,actual_current_spent_scopes=5,
        actual_current_known_failed_fixture_invocations=4,actual_current_accepted_complete_runs=0,
        future_success_or_candidate_verdict_issued=False,
        pending='Actual new Source/saved acceptance, exact Root implementation adoption and candidate pins must bind an immutable successor before final review. Missing child status is allowed only for exact005.',
        operational_authority=False,scientific_authority=False)
    dest=O/'I9_PUBLICATION_REVIEW_TEMPLATE006_PREPARATORY_ACTUAL_RECEIPT_001.json'
    data=(json.dumps(record,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    with dest.open('xb') as handle:
        handle.write(data)
    assert dest.read_bytes()==data
    for q in inputs:
        assert pin(Path(q['path']))==q
    print(json.dumps(dict(template=pin(output),receipt=pin(dest),author_Source=pin(Path(__file__))),indent=2))

if __name__=='__main__':
    main()
