b,perf=read(P/'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json')
check('Exact equivalent surrogate Source correction scope',perf['sha256']=='397a33473d37c8e6a0c3d4f166f9eca23ee8d3af8b54bf34af507e38d2cc2a31')
subjects=[]
for row in r['subjects']:
 old,op=src(row['original_Source']['path']);new,np=src(row['new_Source']['path']);subjects.append(np)
 check('Actual predecessor/successor pins '+Path(np['path']).name,op==row['original_Source'] and np==row['new_Source'])
 expected=old;name=Path(op['path']).name
 if name.startswith('ROOT_ADOPT_I9_FINAL'):
  anchor="    'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json': 'b8c5e65fe9f3f72ce6fda9299ce6d97a749ccccb8f98da308775efe3354a90ff',\n"
  addition="    'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json': '0330ddd4a175904215a1679deaf7cdf232393546fef49063b43b3488080e6077',\n    'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json': '397a33473d37c8e6a0c3d4f166f9eca23ee8d3af8b54bf34af507e38d2cc2a31',\n"
  expected=replace(expected,anchor,anchor+addition)
  anchor='        prior_actual_memory_refusal_adoption=authority_inputs[12],\n'
  expected=replace(expected,anchor,anchor+'        prior_actual_memory_refusal002_adoption=authority_inputs[13],\n        equivalent_surrogate_scan_correction=authority_inputs[14],\n')
  expected=replace(expected,'I9_memory_test_runs=1','I9_memory_test_runs=2')
  expected=replace(expected,'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json','ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_003.json')
 elif name.startswith('ROOT_BIND'):
  for base,suffix in (('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION','json'),('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS','json'),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT','json'),('ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES','py'),('ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES','py'),('ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE','py'),('ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS','py')):
   expected=replace(expected,base+'_002.'+suffix,base+'_003.'+suffix)
  expected=replace(expected,'attempt_numbers=[2]','attempt_numbers=[3]',2)
 else:
  for base,count in (('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS',1),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT',1),('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION',2),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE',1),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION',1)):
   expected=replace(expected,base+'_002.json',base+'_003.json',count)
  expected=replace(expected,"s['attempt_number'] == 2","s['attempt_number'] == 3")
  expected=replace(expected,'I9_memory_test_runs=1','I9_memory_test_runs=2')
 check('Entire control003 complement exact outside enumerated finite history/name deltas '+name,new==expected)
 for anchor in ('ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json','ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'):
  if anchor in old:check('Immutable Source authority anchor retained '+name+' '+anchor,old.count(anchor)==new.count(anchor))
 if name.startswith('ROOT_BIND'):
  check('Only third attempt selected by binder',new.count('attempt_numbers=[3]')==2 and 'attempt_numbers=[2]' not in new)
  check('Original four TEMPLATE002 identities unchanged',all(x in new for x in ('dbd64396b20019b965115d2a5a8b2e1c465b8c36e227b5b403657cb49036680d','02e6fc14789a27e0b5d5d3a2ef23b9fdbf9b9e43116f7fe7135fe29902b3afaf','b926dd703bdb4aea87f8ed1693ffd218e70d62e2c2cdeb5ce7c5a80022f20d87','cf1533d475dc113d1e5ab85c0749faf8345ed0d2f534d88ae33762c357824720')))
 if name.startswith('ROOT_ADOPT_I9_BOUND'):
  check('Independent reviewer and fresh65 reserve checks unchanged',"record['reviewer'] == '/root/phase_frontier'" in new and 'now + datetime.timedelta(seconds=65)' in new and 'expected = [fresh_scope]' in new)
_,selfpin=read(Path(__file__))
check('Unique named exact bool checks',len({x['name'] for x in CHECKS})==len(CHECKS) and all(type(x['passed']) is bool for x in CHECKS))
report=dict(schema_version=1,record_type='independent_I9_Root_control003_Source_preparation_analysis',reviewer='/root/phase_frontier',source_author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),subjects=subjects,reviewer_Source=selfpin,all_actual_inputs=sorted(INPUTS.values(),key=lambda q:q['path']),checks=CHECKS,checks_passed=len(CHECKS),checks_failed=0,status='NO_ACTIONABLE_CONTROL003_SOURCE_DEFECT_FOUND_PRELIMINARY_ONLY',actual_six_bound_subjects_review_not_yet_performed=True,new_bound_tool_Source_acceptance_issued=False,target_execution=False,tests_executed=False,tools_invoked=False,limitations=['Preliminary Root control Source analysis only; final accepted Sourceadoption003 and actual four bound Sources/config/receipt remain required for the six-subject review.','No target/fixture/control tool is invoked. Prior two failed attempts remain historical evidence and no automatic retry is authorized.'])
q=OWN/'INDEPENDENT_I9_ROOT_CONTROL003_SOURCE_PREPARATION_ANALYSIS_001.json';b=(json.dumps(report,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=2097152
with q.open('xb') as f:f.write(b)
print(json.dumps(dict(report=dict(path=str(q),bytes=len(b),sha256=hashlib.sha256(b).hexdigest()),checks_passed=len(CHECKS))))
