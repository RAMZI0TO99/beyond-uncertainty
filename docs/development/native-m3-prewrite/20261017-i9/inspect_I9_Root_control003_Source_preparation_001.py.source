INPUTS={};CHECKS=[]
def read(p):
 p=Path(p);b=p.read_bytes();assert 0<len(b)<=2097152
 q=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest());k=str(p).casefold();assert k not in INPUTS or INPUTS[k]==q;INPUTS[k]=q;return b,q
def src(p):
 b,q=read(p);ast.parse(b);compile(b,str(p),'exec');return b.decode(),q
def check(n,v):
 assert type(v) is bool;CHECKS.append(dict(name=n,passed=v));assert v,n
def replace(s,a,b,n=1):
 assert s.count(a)==n,(a,s.count(a),n);return s.replace(a,b)
