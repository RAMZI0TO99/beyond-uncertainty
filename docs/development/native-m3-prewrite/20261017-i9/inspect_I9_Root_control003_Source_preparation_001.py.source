check('Root control003 author receipt distinguishes Source authoring from prior actual tests',r['author']=='/root' and r['mode']=='controls' and r['I9_memory_test_runs']==2 and r['actual_completed_cases']==0 and r['authored_Sources_invoked'] is False and r['target_execution'] is False and r['tests_executed'] is False and r['automatic_retry_authorized'] is False)
