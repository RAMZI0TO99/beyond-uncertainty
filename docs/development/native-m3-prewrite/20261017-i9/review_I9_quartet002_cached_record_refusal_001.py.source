def fact(path):
    path=Path(path);b=path.read_bytes();assert 0<len(b)<=CAP
    q=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
    if str(path) in inputs:assert inputs[str(path)]==q
    inputs[str(path)]=q;return q,b
def pairs(rows):
    d={}
    for k,v in rows:assert k not in d;d[k]=v
    return d
def bad(x):raise ValueError(x)
def obj(path):
    q,b=fact(path);return q,json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def check(name,passed,evidence):
    assert type(passed) is bool and name not in {c['name'] for c in checks}
    checks.append(dict(name=name,passed=passed,evidence=evidence))
