assert sup['owned_child_wait_reaped'] is True and sup['stream_reader_threads_joined'] is True
assert not (P/'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_005.json').exists()
assert all(q['actual_capture']['bytes']==0 for q in capture['streams'])
old,oldpin=read(OWN/'validate_recorded_M3_semantics_006.py')
assert oldpin['sha256']=='38b0d6343cb10b9ab28a9785f974d6a293ffed11713f7bea4e3111dbedaaca81'
reserved=['CON','PRN','AUX','NUL','CLOCK$','COM1','COM2','COM3','COM4','COM5','COM6','COM7','COM8','COM9','LPT1','LPT2','LPT3','LPT4','LPT5','LPT6','LPT7','LPT8','LPT9']
assert len(reserved)==len(set(reserved))==23
constant='I9_RESERVED_PATH_COMPONENTS = frozenset('+repr(reserved)+')\n\n'
text=old.decode();edits=[]
def replace(before,after):
    global text
    assert text.count(before)==1,(before[:80],text.count(before))
    text=text.replace(before,after);edits.append(dict(before=before,after=after))
replace('def _i9_path(path):',constant+'def _i9_path(path):')
replace("    reserved={'CON','PRN','AUX','NUL','CLOCK$',*('COM'+str(x) for x in range(1,10)),*('LPT'+str(x) for x in range(1,10))}",
        '    reserved=I9_RESERVED_PATH_COMPONENTS')
replace("not any(ord(c)<32 or c in '/:\"<>|?*' for c in p)",
        r"""_i9_re.search(r'[\x00-\x1f/:"<>|?*]',p) is None""")
new=text.encode();ast.parse(new);compile(new,'module007_Source_only','exec')
a,b=regions(old),regions(new)
assert set(a)==set(b) and {n for n in a if a[n]!=b[n]}=={'_i9_path'}
unchanged=[]
for name,body in a.items():
    if name=='_i9_path':continue
    assert body==b[name];unchanged.append(dict(name=name,bytes=len(body),sha256=hashlib.sha256(body).hexdigest(),byte_exact=True))
reverse=text
for e in reversed(edits):
    assert reverse.count(e['after'])==1;reverse=reverse.replace(e['after'],e['before'])
assert reverse.encode()==old
module=save(OWN/'validate_recorded_M3_semantics_007.py',new)
