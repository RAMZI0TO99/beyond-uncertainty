"""Own Source-only exact path predicate successor after unknown timeout; no target calls."""
import ast
import datetime
import hashlib
import json
from pathlib import Path
OWN=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012\i9')
P=OWN.parent;CAP=2097152
def read(path):
    path=Path(path);b=path.read_bytes();assert 0<len(b)<=CAP
    return b,dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def obj(path):
    b,p=read(path);return json.loads(b),p
def wire(v):return (json.dumps(v,sort_keys=True,indent=2,allow_nan=False)+'\n').encode()
def save(path,b):
    assert 0<len(b)<=CAP
    with path.open('xb') as f:f.write(b)
    assert path.read_bytes()==b
    return read(path)[1]
def regions(b):
    lines=b.splitlines(keepends=True);out={}
    for n in ast.parse(b).body:
        if isinstance(n,(ast.FunctionDef,ast.ClassDef)):
            out[n.name]=b''.join(lines[n.lineno-1:n.end_lineno])
            if isinstance(n,ast.ClassDef):
                for x in n.body:
                    if isinstance(x,ast.FunctionDef):out[n.name+'.'+x.name]=b''.join(lines[x.lineno-1:x.end_lineno])
    return out
