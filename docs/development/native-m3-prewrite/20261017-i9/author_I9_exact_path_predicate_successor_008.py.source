     unknown_I9_memory_test_runs=1,spent_memory_scope_count=5,owned_memory_child_launch_count=5,
     accepted_complete_memory_test_runs=0,actual_saved_refusal_Root_adoption=rootpin,
     exact_path_Source_inverse=inverse,independent_correction_Source_review_pending=True)
    assert len(v['actual_saved_memory_attempts'])==4;v['actual_saved_memory_attempts'].append(attempt)
    v['Source_basis'] += [rootpin,mappin,suppin,capturepin]
