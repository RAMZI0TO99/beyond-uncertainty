COMMON = r'''"""UNBOUND I9 metadata-memory tooling template; never target/runtime qualification.

An immutable Root-owned successor must replace EXACT_ROOT_BINDINGS with the
actual reviewed finite configuration, then receive independent Source review.
This template is never a Source acceptance or an execution authorization.
"""
import ast
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import time

EXACT_ROOT_BINDINGS = None
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
SOURCE_VERDICT = 'ACCEPT_I9_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_ONLY'
OLD_AUTHORITY_KEY = 'original_I0_I1_I2_I3_I4_I5_I6_I7_I8_native_Parser_project_invocations_authorized'
PYTHON = r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe'

def need(ok, message):
    if not ok:
        raise RuntimeError(message)

def now():
    return datetime.datetime.now(datetime.timezone.utc)

def pairs(items):
    result = {}
    for key, value in items:
        need(key not in result, 'DUPLICATE_JSON_KEY')
        result[key] = value
    return result

def bad_json(value):
    raise ValueError('NON_INTEGER_OR_NONFINITE_JSON_NUMBER')

def decode(data):
    need(type(data) is bytes and len(data) <= CAP, 'JSON_CAP')
    return json.loads(data.decode('utf-8', 'strict'), object_pairs_hook=pairs,
                      parse_float=bad_json, parse_constant=bad_json)

def raw(path):
    path = Path(path)
    need(path.is_file() and not path.is_symlink(), 'NOT_REGULAR_FILE')
    need(path.stat().st_size <= CAP, 'FILE_CAP')
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    need(len(data) <= CAP, 'READ_CAP')
    return data

def fact(path):
    path = Path(path)
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pinned(pin):
    need(type(pin) is dict and set(pin) == {'path', 'bytes', 'sha256'}, 'CLOSED_F3')
    need(type(pin['path']) is str and type(pin['bytes']) is int and
         0 < pin['bytes'] <= CAP and type(pin['sha256']) is str and
         re.fullmatch('[0-9a-f]{64}', pin['sha256']) is not None, 'POSITIVE_F3')
    data = raw(pin['path'])
    need(len(data) == pin['bytes'] and hashlib.sha256(data).hexdigest() == pin['sha256'], 'PIN_CHANGED')
    return data

def equal_typed(left, right):
    if type(left) is not type(right):
        return False
    if type(left) is dict:
        return left.keys() == right.keys() and all(equal_typed(left[k], right[k]) for k in left)
    if type(left) is list:
        return len(left) == len(right) and all(equal_typed(a, b) for a, b in zip(left, right))
    return left == right

def checked_fields(record, expected):
    need(type(record) is dict and type(expected) is dict and expected, 'REQUIRED_EXACT_FIELDS')
    for name, value in expected.items():
        need(name in record and equal_typed(record[name], value), 'FIELD_MISMATCH:' + name)

def save(path, record):
    path = Path(path)
    need(path.parent == P and not path.exists(), 'FINITE_CREATE_ONCE_OUTPUT')
    data = (json.dumps(record, indent=2, sort_keys=True, allow_nan=False) + '\n').encode('utf-8')
    need(len(data) <= CAP, 'SERIALIZED_CAP')
    with path.open('xb') as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    need(raw(path) == data, 'OUTPUT_READBACK')
    return fact(path)

def bound():
    b = EXACT_ROOT_BINDINGS
    need(type(b) is dict, 'UNBOUND_I9_MEMORY_TOOLING_TEMPLATE')
    required = {'binding_schema', 'Root_author', 'protocol', 'protocol_Root_adoption',
        'protocol_adoption_required_fields', 'source_window', 'source_window_required_fields',
        'module_Source', 'fixture_Source', 'API', 'author_receipt', 'Source_adoption',
        'Source_adoption_required_fields', 'Source_adoption_subject_field',
        'Source_review_records', 'API_fixture_field', 'API_entry_field',
        'API_count_field', 'API_names_field', 'exact_import_modules',
        'approved_import_roots', 'maximum_profiled_module_calls',
        'required_positive_module_function_names', 'attempt_numbers',
        'scope_duration_seconds', 'tool_Source_paths', 'python_executable',
        'Source_window_end_field'}
    need(set(b) == required and b['binding_schema'] == 1 and b['Root_author'] == '/root', 'CLOSED_BINDINGS')
    need(b['python_executable'] == PYTHON, 'EXACT_PYTHON')
    need(type(b['attempt_numbers']) in (tuple, list) and b['attempt_numbers'] and
         all(type(n) is int and 1 <= n <= 999 for n in b['attempt_numbers']) and
         len(set(b['attempt_numbers'])) == len(b['attempt_numbers']), 'FINITE_ATTEMPTS')
    need(type(b['scope_duration_seconds']) is int and 65 <= b['scope_duration_seconds'] <= 1200,
         'REVIEWED_PRIVATE_SCOPE_DURATION')
    need(type(b['maximum_profiled_module_calls']) is int and b['maximum_profiled_module_calls'] > 0,
         'REVIEWED_FINITE_PROFILE_CAP')
    allowed = {'ast','difflib','zlib','base64','binascii','hashlib','json','re','datetime',
               'copy','types','collections','dataclasses','enum','functools','itertools',
               'operator','math','struct','typing','codecs','_strptime','locale','calendar'}
    need(type(b['approved_import_roots']) in (tuple, list) and
         set(b['approved_import_roots']) <= allowed, 'PURE_IMPORT_ROOTS')
    need(type(b['exact_import_modules']) in (tuple, list) and
         all(type(name) is str and re.fullmatch('[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)*', name)
             and name.split('.')[0] in b['approved_import_roots'] for name in b['exact_import_modules']) and
         len(set(b['exact_import_modules'])) == len(b['exact_import_modules']), 'FINITE_LITERAL_IMPORTS')
    need(type(b['required_positive_module_function_names']) in (tuple, list) and
         b['required_positive_module_function_names'] and
         all(type(name) is str and name.isidentifier() for name in b['required_positive_module_function_names']),
         'ACTUAL_FINAL_API_PROFILE_SUBJECTS_REQUIRED')
    need(type(b['Source_adoption_subject_field']) is str and b['Source_adoption_subject_field'], 'EXACT_ADOPTION_SCHEMA')
    need(type(b['tool_Source_paths']) is dict and
         set(b['tool_Source_paths']) == {'runner', 'supervisor', 'scope_preparer', 'capture'} and
         all(type(path) is str and Path(path).is_absolute() and Path(path).suffix == '.py'
             and Path(path).parent in (P,P/'memory_tooling_001') for path in b['tool_Source_paths'].values()) and
         len(set(path.casefold() for path in b['tool_Source_paths'].values())) == 4, 'FINITE_TOOL_PATHS')
    return b

def names(attempt):
    need(type(attempt) is int and 1 <= attempt <= 999, 'ATTEMPT_RANGE')
    suffix = f'{attempt:03d}'
    return dict(scope=f'ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_{suffix}.json',
        child_marker=f'ROOT_I9_MEMORY_SCOPE_CONSUMED_{suffix}.json',
        supervisor_marker=f'ROOT_I9_MEMORY_SUPERVISOR_CONSUMED_{suffix}.json',
        child_result=f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUITE_RESULT_{suffix}.json',
        supervisor_result=f'ROOT_I9_ACTUAL_ONCE_MEMORY_SUPERVISOR_RESULT_{suffix}.json',
        stdout=f'ROOT_I9_ACTUAL_MEMORY_CHILD_STDOUT_{suffix}.txt',
        stderr=f'ROOT_I9_ACTUAL_MEMORY_CHILD_STDERR_{suffix}.txt',
        capture=f'ROOT_I9_ACTUAL_OWNED_MEMORY_STREAMS_CAPTURE_{suffix}.json')

def attempt_argument(b):
    need(len(sys.argv) == 2 and re.fullmatch('[0-9]{3}', sys.argv[1]) is not None, 'ONLY_FINITE_ATTEMPT_ARGUMENT')
    attempt = int(sys.argv[1])
    need(attempt in b['attempt_numbers'], 'ATTEMPT_NOT_REVIEWED')
    return attempt

def check_source(b):
    protocol = decode(pinned(b['protocol']))
    need(protocol['author'] == '/root', 'ROOT_PROTOCOL')
    protocol_adoption = decode(pinned(b['protocol_Root_adoption']))
    checked_fields(protocol_adoption, b['protocol_adoption_required_fields'])
    window = decode(pinned(b['source_window']))
    checked_fields(window, b['source_window_required_fields'])
    end = datetime.datetime.fromisoformat(window[b['Source_window_end_field']])
    need(end.tzinfo is not None and now() + datetime.timedelta(seconds=60) < end, 'SOURCE_RESERVE60')
    adoption = decode(pinned(b['Source_adoption']))
    checked_fields(adoption, b['Source_adoption_required_fields'])
    need(adoption['verdict'] == SOURCE_VERDICT and adoption['tests_executed'] is False, 'SOURCE_ONLY_ADOPTION')
    subjects = adoption[b['Source_adoption_subject_field']]
    need(type(subjects) is list, 'EXACT_SUBJECT_LIST')
    for key in ('module_Source', 'fixture_Source', 'API', 'author_receipt'):
        pinned(b[key])
        need(b[key] in subjects, 'ACTUAL_FOUR_SOURCE_SUBJECTS:' + key)
    reviews = b['Source_review_records']
    need(type(reviews) is list and len(reviews) == 2, 'DIFFERENT_REVIEW_CAPSULE_AND_FULL')
    for item in reviews:
        need(type(item) is dict and set(item) == {'pin','required_fields'}, 'REVIEW_BINDING')
        record = decode(pinned(item['pin']))
        checked_fields(record, item['required_fields'])
        need(record['tests_executed'] is False and type(record['checks_failed']) is int
             and record['checks_failed'] == 0, 'STRICT_SOURCE_REVIEW_ONLY')
    api = decode(pinned(b['API']))
    fixture = api[b['API_fixture_field']]
    need(type(fixture) is dict and fixture[b['API_entry_field']] == 'run_memory_suite(module)', 'API_ENTRY')
    count = fixture[b['API_count_field']]
    planned = fixture[b['API_names_field']]
    need(type(count) is int and 1 <= count <= 256 and type(planned) is list and
         len(planned) == count and all(type(n) is str and n for n in planned) and
         len(set(planned)) == count, 'ACTUAL_API_CASE_NAMES_AND_COUNT')
    return end, count, planned

def load_scope(b, attempt):
    n = names(attempt)
    scope_pin = fact(P / n['scope'])
    s = decode(pinned(scope_pin))
    need(s['author'] == '/root' and s['record_type'] == 'Root_I9_one_use_pure_semantic_memory_scope', 'ROOT_EXACT_SCOPE')
    need(type(s['maximum_invocations']) is int and s['maximum_invocations'] == 1 and
         type(s['attempt_number']) is int and s['attempt_number'] == attempt, 'ONCE_ATTEMPT')
    need(s['new_I9_pure_memory_fixture_invocation_authorized'] is True and s[OLD_AUTHORITY_KEY] is False,
         'NEW_I9_ONLY')
    need(s['names'] == n, 'FINITE_OUTPUT_NAMES')
    for key in ('protocol','protocol_Root_adoption','source_window','module_Source','fixture_Source',
                'API','author_receipt','Source_adoption'):
        need(equal_typed(s[key], b[key]), 'EXACT_SCOPE_BINDING:' + key)
    need(type(s['tool_Source_pins']) is dict and set(s['tool_Source_pins']) == set(b['tool_Source_paths']),
         'EXACT_TOOL_SCOPE_ROLES')
    for role,path in b['tool_Source_paths'].items():
        need(s['tool_Source_pins'][role]['path'] == path, 'EXACT_TOOL_SCOPE_PATH')
        pinned(s['tool_Source_pins'][role])
    source_end, count, planned = check_source(b)
    start = datetime.datetime.fromisoformat(s['interval_start'])
    end = datetime.datetime.fromisoformat(s['interval_end'])
    need(start.tzinfo is not None and end.tzinfo is not None and start <= now() and
         now() + datetime.timedelta(seconds=60) < end <= source_end and
         0 < (end-start).total_seconds() <= b['scope_duration_seconds'], 'FRESH_PRIVATE_SCOPE')
    need(type(s['expected_planned_case_count']) is int and s['expected_planned_case_count'] == count and
         equal_typed(s['planned_case_names'], planned), 'SCOPE_API_CASE_JOIN')
    checked_fields(s, {'wall_cap_seconds':60, 'cleanup_reap_seconds':5, 'stream_cap_bytes':CAP,
        'RAM_floor_bytes':1073741824, 'disk_floor_bytes':10737418240,
        'automatic_retry_authorized':False, 'actual_selected_family_Source_publication':False,
        'operational_authority':False, 'scientific_authority':False})
    return scope_pin, s, n

def self_pin(b, role):
    # Hashes live in the independently reviewed fresh scope, avoiding self-hash cycles.
    need(str(Path(__file__)) == b['tool_Source_paths'][role], 'EXACT_BOUND_SELF_SOURCE_PATH')

def isolated():
    need(sys.flags.isolated == 1 and sys.flags.no_site == 1 and sys.flags.dont_write_bytecode == 1,
         'ISOLATED_NO_SITE_NO_BYTECODE')
'''

RUNNER = r'''
import builtins
import importlib
import io
import types

class BoundedText(io.TextIOBase):
    def __init__(self):
        self.data = bytearray()
        self.overcap = False
    @property
    def encoding(self):
        return 'utf-8'
    def write(self, value):
        need(type(value) is str, 'TEXT_STREAM_ONLY')
        encoded = value.encode('utf-8', 'strict')
        if len(self.data) + len(encoded) > CAP:
            self.overcap = True
            raise RuntimeError('I9_TARGET_STREAM_CAP')
        self.data.extend(encoded)
        return len(value)
    def flush(self):
        return None

def inspect_imports(data, b):
    tree = ast.parse(data)
    observed = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            modules = [a.name for a in node.names]
        elif isinstance(node, ast.ImportFrom):
            need(node.level == 0 and node.module is not None and all(a.name != '*' for a in node.names),
                 'NO_RELATIVE_OR_STAR_IMPORT')
            modules = [node.module]
        else:
            modules = []
        for name in modules:
            need(name in b['exact_import_modules'], 'UNREVIEWED_TARGET_IMPORT:' + name)
            observed.add(name)
        if isinstance(node, ast.Call):
            need(not (isinstance(node.func, ast.Name) and node.func.id in
                 {'eval','exec','compile','__import__','breakpoint','open','input'}), 'DYNAMIC_OR_IO_BUILTIN_SOURCE')
            need(not (isinstance(node.func, ast.Attribute) and node.func.attr in
                 {'eval','exec','compile','__import__','import_module','setprofile','settrace','addaudithook'}),
                 'DYNAMIC_ATTRIBUTE_SOURCE')
    return observed

def main():
    b = bound()
    isolated()
    self_pin(b, 'runner')
    attempt = attempt_argument(b)
    scope_pin, s, n = load_scope(b, attempt)
    need(not (P/n['child_marker']).exists() and not (P/n['child_result']).exists(), 'SCOPE_ALREADY_CONSUMED')
    supervisor_marker = decode(raw(P/n['supervisor_marker']))
    need(equal_typed(supervisor_marker['scope'], scope_pin), 'SUPERVISOR_SCOPE_JOIN')
    module_raw = pinned(b['module_Source'])
    fixture_raw = pinned(b['fixture_Source'])
    actual_imports = inspect_imports(module_raw, b) | inspect_imports(fixture_raw, b)
    need(actual_imports == set(b['exact_import_modules']), 'EXACT_FINAL_SOURCE_IMPORT_SET')
    # Preload deterministic dependencies BEFORE audit. No target bytes execute here.
    baseline_preloads = ('ast','difflib','zlib','base64','binascii','codecs','encodings.utf_8',
        'encodings.ascii','copy','dataclasses','collections.abc','_strptime','locale','calendar')
    for name in baseline_preloads + tuple(b['exact_import_modules']):
        importlib.import_module(name)
    loaded_modules = dict(sys.modules)
    ast_parse_code = ast.parse.__code__
    module_path, fixture_path = b['module_Source']['path'], b['fixture_Source']['path']
    target_paths = {module_path, fixture_path}
    marker = save(P/n['child_marker'], dict(schema_version=1,
        record_type='Root_I9_one_use_memory_scope_consumed_before_target_compile', author='/root',
        created_utc=now().isoformat(), scope=scope_pin, attempt_number=attempt,
        module_Source=b['module_Source'], fixture_Source=b['fixture_Source'], automatic_retry_authorized=False))
    events, blocked, function_counts = {}, [], {}
    calls = {p:0 for p in target_paths}
    compile_counts, exec_counts = {p:0 for p in target_paths}, {p:0 for p in target_paths}
    state = {'active':True, 'loader_compile':None, 'loader_exec':None, 'AST_parse_compile_events':0}
    own_filename = str(Path(__file__))
    def audit(event, args):
        if not state['active']:
            return
        need(len(events) <= 1024, 'AUDIT_EVENT_NAME_CAP')
        events[event] = events.get(event, 0) + 1
        forbidden = event == 'open' or event.startswith(('os.','subprocess.','socket.','ctypes.','winreg.'))
        if event == 'compile':
            caller = sys._getframe(1)
            loader_path = state['loader_compile']
            if loader_path in target_paths and len(args) > 1 and args[1] == loader_path and caller.f_code.co_filename == own_filename:
                compile_counts[loader_path] += 1
                forbidden = compile_counts[loader_path] != 1
            elif caller.f_code is ast_parse_code:
                state['AST_parse_compile_events'] += 1
            else:
                forbidden = True
        elif event == 'exec':
            code = args[0]
            if code is state['loader_exec'] and code.co_filename in target_paths:
                exec_counts[code.co_filename] += 1
                forbidden = exec_counts[code.co_filename] != 1
            else:
                forbidden = True
        elif event == 'import':
            forbidden = True  # All reviewed imports were preloaded and resolved without import execution.
        elif event in {'sys.settrace','sys.setprofile'}:
            caller = sys._getframe(1)
            forbidden = caller.f_code.co_filename != own_filename
        if forbidden:
            if len(blocked) < 256:
                blocked.append(event)
            raise RuntimeError('I9_FORBIDDEN_AUDIT_EVENT:' + event)
    def profile(frame, event, arg):
        if event == 'call' and frame.f_code.co_filename in calls:
            path = frame.f_code.co_filename
            calls[path] += 1
            need(sum(calls.values()) <= b['maximum_profiled_module_calls'], 'PROFILE_CALL_CAP')
            if path == module_path:
                name = frame.f_code.co_name
                need(len(function_counts) <= 4096, 'FUNCTION_NAME_CAP')
                function_counts[name] = function_counts.get(name, 0) + 1
    def approved_import(name, globals=None, locals=None, fromlist=(), level=0):
        caller = sys._getframe(1)
        need(level == 0 and name in b['exact_import_modules'] and caller.f_code.co_filename in target_paths
             and caller.f_code.co_name == '<module>', 'ONLY_REVIEWED_LITERAL_TOP_LEVEL_IMPORT')
        key = name if fromlist else name.split('.')[0]
        need(key in loaded_modules, 'PRELOADED_IMPORT_ONLY')
        return loaded_modules[key]
    safe_builtins = dict(vars(builtins))
    for key in ('open','input','eval','exec','compile','breakpoint'):
        safe_builtins.pop(key, None)
    safe_builtins['__import__'] = approved_import
    out, err = BoundedText(), BoundedText()
    old_out, old_err = sys.stdout, sys.stderr
    error = None
    outcome = None
    invoked = False
    partial = None
    failed_case = None
    capture_issue = None
    started_utc, started = now().isoformat(), time.monotonic_ns()
    sys.addaudithook(audit)
    try:
        sys.stdout, sys.stderr = out, err
        sys.setprofile(profile)
        def load(data, pin, namespace):
            target = types.ModuleType(namespace)
            target.__file__ = pin['path']
            target.__dict__['__builtins__'] = safe_builtins
            sys.modules[namespace] = target  # dataclasses requires actual namespace membership.
            state['loader_compile'] = pin['path']
            code = compile(data, pin['path'], 'exec')
            state['loader_compile'] = None
            state['loader_exec'] = code
            try:
                exec(code, target.__dict__)
            finally:
                state['loader_exec'] = None
            return target
        module = load(module_raw, b['module_Source'], '_i9_module_scoped_' + b['module_Source']['sha256'])
        fixture = load(fixture_raw, b['fixture_Source'], '_i9_fixture_scoped_' + b['fixture_Source']['sha256'])
        count, planned = s['expected_planned_case_count'], s['planned_case_names']
        need(type(fixture.EXPECTED_CASE_COUNT) is int and fixture.EXPECTED_CASE_COUNT == count,
             'LITERAL_API_SCOPE_COUNT_JOIN')
        need(type(fixture.PLANNED_CASE_NAMES) in (tuple,list) and list(fixture.PLANNED_CASE_NAMES) == planned,
             'LITERAL_API_SCOPE_NAMES_JOIN')
        invoked = True
        outcome = fixture.run_memory_suite(module)
        need(type(outcome) is dict and outcome['synthetic_fixture'] is True and
             type(outcome['filesystem_calls']) is int and outcome['filesystem_calls'] == 0 and
             outcome['project_or_native_tests'] is False, 'MEMORY_OUTCOME_FLAGS')
        cases = outcome['cases']
        need(type(cases) is list and len(cases) == count and [q['name'] for q in cases] == planned,
             'COMPLETE_EXACT_CASES')
        need(all(type(q) is dict and type(q['name']) is str and type(q['passed']) is bool and
             q['passed'] is True and q['synthetic_fixture'] is True and
             type(q['memory_record_reader_calls']) is int and q['memory_record_reader_calls'] >= 0
             for q in cases), 'STRICT_CASE_FLAGS')
        need(type(outcome['checks_passed']) is int and outcome['checks_passed'] == count and
             type(outcome['checks_failed']) is int and outcome['checks_failed'] == 0, 'STRICT_CASE_COUNTS')
        need(all(v == 1 for v in compile_counts.values()) and all(v == 1 for v in exec_counts.values()),
             'EXACT_ONE_COMPILE_AND_EXEC_PER_NEW_TARGET')
        need(not blocked and all(v > 0 for v in calls.values()) and
             all(function_counts.get(name, 0) > 0 for name in b['required_positive_module_function_names']),
             'REQUIRED_NEW_TARGET_PROFILE')
        need(not out.overcap and not err.overcap and time.monotonic_ns()-started <= 60000000000,
             'MEMORY_RUN_CAPS')
    except BaseException as exc:
        error = dict(type=type(exc).__name__, message=str(exc)[:8192])
        try:
            tb = exc.__traceback__
            while tb is not None:
                frame = tb.tb_frame
                if frame.f_code.co_filename == fixture_path and frame.f_code.co_name == 'run_memory_suite':
                    local_cases, local_case = frame.f_locals.get('cases'), frame.f_locals.get('case')
                    if type(local_cases) is list:
                        partial = decode(json.dumps(local_cases, allow_nan=False).encode('utf-8'))
                    if type(local_case) is str:
                        failed_case = local_case[:4096]
                tb = tb.tb_next
        except BaseException as capture_error:
            capture_issue = type(capture_error).__name__ + ':' + str(capture_error)[:4096]
    finally:
        sys.setprofile(None)
        state['active'] = False
        sys.stdout, sys.stderr = old_out, old_err
    elapsed = time.monotonic_ns()-started
    def stream(item):
        data = bytes(item.data)
        return dict(bytes=len(data), sha256=hashlib.sha256(data).hexdigest(),
                    UTF8_text=data.decode('utf-8','strict'), overcap=item.overcap)
    completed = len(outcome['cases']) if type(outcome) is dict and type(outcome.get('cases')) is list else (
        len(partial) if type(partial) is list else None)
    record = dict(schema_version=1, record_type='Root_actual_once_I9_synthetic_memory_suite_saved_result',
        author='/root', created_utc=now().isoformat(), started_utc=started_utc, scope=scope_pin,
        attempt_number=attempt, consumption_marker=marker, module_Source=b['module_Source'],
        fixture_Source=b['fixture_Source'], API=b['API'], actual_Source_adoption=b['Source_adoption'],
        tests_executed=invoked, I9_memory_test_runs=1 if invoked else 0, fixture_entry_invoked=invoked,
        synthetic_memory_only=True, expected_planned_case_count=s['expected_planned_case_count'],
        planned_case_names=s['planned_case_names'], actual_test_case_count=completed,
        partial_completed_cases_at_failure=partial, failed_or_last_case_at_failure=failed_case,
        partial_capture_issue=capture_issue, case_count_boundary='Completed saved outcomes only; interrupted case separate; unknown null.',
        all_cases_passed=error is None, error=error, outcome=outcome, elapsed_integer_nanoseconds=elapsed,
        profile_call_counts=calls, new_module_function_call_counts=function_counts,
        target_compile_counts=compile_counts, target_exec_counts=exec_counts,
        ast_parse_internal_compile_events=state['AST_parse_compile_events'], audit_event_counts=events,
        blocked_forbidden_event_names=blocked,
        audit_evidence_boundary='Observed CPython audit events plus reviewed Source; not exhaustive stat/native or security isolation proof.',
        stdout=stream(out), stderr=stream(err), original_I0_I1_I2_I3_I4_I5_I6_I7_I8_import_call_or_test=False,
        original_project_native_Parser_runtime_scientific_execution=False, actual_canonical_IO=False,
        owner_lease_qualified=False, producer_qualified=False, caller_qualified=False,
        actual_native_human_physical_provenance_qualified=False, actual_entry_authorized=False,
        operational_authority=False, scientific_authority=False)
    print(json.dumps(save(P/n['child_result'], record), sort_keys=True))
    if error is not None:
        raise SystemExit(1)

if __name__ == '__main__':
    main()
'''

SUPERVISOR = r'''
import ctypes
import shutil
import subprocess
import threading

def fresh_resources():
    class MemoryStatus(ctypes.Structure):
        _fields_ = [('length',ctypes.c_ulong),('load',ctypes.c_ulong),('total',ctypes.c_ulonglong),
            ('available',ctypes.c_ulonglong),('page_total',ctypes.c_ulonglong),('page_available',ctypes.c_ulonglong),
            ('virtual_total',ctypes.c_ulonglong),('virtual_available',ctypes.c_ulonglong),('extended',ctypes.c_ulonglong)]
    status = MemoryStatus()
    status.length = ctypes.sizeof(status)
    need(ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status)) != 0, 'RAM_OBSERVATION_FAILED')
    disk = shutil.disk_usage(P).free
    observed = dict(observed_utc=now().isoformat(), observed_monotonic_ns=time.monotonic_ns(),
        available_RAM_bytes=status.available, disk_free_bytes=disk, RAM_floor_bytes=1073741824,
        disk_floor_bytes=10737418240, age_limit_seconds=60, FileTime_or_Native8_collection=False)
    need(status.available >= 1073741824 and disk >= 10737418240, 'RAM_OR_DISK_FLOOR')
    return observed

def main():
    b = bound()
    isolated()
    need(os.name == 'nt' and sys.executable.casefold() == PYTHON.casefold(), 'WINDOWS_EXACT_PYTHON')
    self_pin(b, 'supervisor')
    attempt = attempt_argument(b)
    scope_pin, s, n = load_scope(b, attempt)
    runner = s['tool_Source_pins']['runner']
    pinned(runner)
    for key in ('supervisor_marker','child_marker','child_result','supervisor_result','stdout','stderr','capture'):
        need(not (P/n[key]).exists(), 'ONE_USE_OUTPUT_ALREADY_EXISTS:' + key)
    marker = save(P/n['supervisor_marker'], dict(schema_version=1,
        record_type='Root_I9_memory_supervisor_once_consumed_before_child', author='/root',
        created_utc=now().isoformat(), scope=scope_pin, child_runner=runner, attempt_number=attempt,
        automatic_retry_authorized=False))
    argv = [PYTHON,'-I','-S','-B',runner['path'],f'{attempt:03d}']
    reason = None
    proc = None
    code = None
    reaped = False
    resource = None
    launch = None
    exit_observed = None
    threads = []
    stream_states = []
    started_utc, started = now().isoformat(), time.monotonic_ns()
    def drain(pipe, handle, state):
        try:
            while True:
                data = pipe.read(4096)
                if not data:
                    break
                state['observed_lower_bound_bytes'] += len(data)
                available = max(0,CAP-state['saved_bytes'])
                chunk = data[:available]
                handle.write(chunk)
                state['saved_bytes'] += len(chunk)
                if len(chunk) != len(data):
                    state['overcap'] = True
                    break
            handle.flush()
            os.fsync(handle.fileno())
        except BaseException as exc:
            state['reader_error'] = type(exc).__name__ + ':' + str(exc)[:4096]
        finally:
            pipe.close()
            handle.close()
    try:
        handles = [(P/n[key]).open('xb') for key in ('stdout','stderr')]
        # This is the last external observation immediately before one Popen.
        resource = fresh_resources()
        need(now() + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(s['interval_end']),
             'PRELAUNCH_PRIVATE_SCOPE_RESERVE')
        need(time.monotonic_ns()-resource['observed_monotonic_ns'] < 60000000000, 'FRESH_PRELAUNCH_RESOURCES')
        launch = time.monotonic_ns()
        proc = subprocess.Popen(argv, cwd=P, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NO_WINDOW, bufsize=0,
            close_fds=True, env={'SYSTEMROOT':os.environ.get('SYSTEMROOT',r'C:\Windows'),
                'WINDIR':os.environ.get('WINDIR',r'C:\Windows'), 'PYTHONHASHSEED':'0',
                'PYTHONUTF8':'1', 'PYTHONIOENCODING':'utf-8'})
        for key, pipe, handle in zip(('stdout','stderr'),(proc.stdout,proc.stderr),handles):
            state = dict(path=str(P/n[key]),saved_bytes=0,observed_lower_bound_bytes=0,
                         overcap=False,reader_error=None)
            stream_states.append(state)
            thread = threading.Thread(target=drain,args=(pipe,handle,state),daemon=True)
            threads.append(thread)
            thread.start()
        while True:
            polled = proc.poll()
            observed = time.monotonic_ns()
            if polled is not None:
                exit_observed = observed
                break
            if observed-launch > 60000000000:
                reason = 'owned I9 child exceeded60second wall cap'
                break
            if any(q['overcap'] or q['reader_error'] is not None for q in stream_states):
                reason = 'owned I9 child stream cap or reader failure'
                break
            time.sleep(0.05)
    except BaseException as exc:
        reason = reason or type(exc).__name__ + ':' + str(exc)[:4096]
    cleanup_started = time.monotonic_ns()
    if proc is not None:
        if reason is not None and proc.poll() is None:
            try:
                proc.kill()  # Only the exact Popen child; no enumeration or unrelated kill.
            except BaseException as exc:
                reason += ';owned kill failed:' + type(exc).__name__
        try:
            code = proc.wait(timeout=5)
            reaped = True
        except subprocess.TimeoutExpired:
            reason = reason or 'owned child not reaped within5seconds; cleanup unverified'
        if reaped and exit_observed is None:
            exit_observed = time.monotonic_ns()
    for thread in threads:
        remaining = max(0,(5000000000-(time.monotonic_ns()-cleanup_started))/1000000000)
        thread.join(timeout=remaining)
    joined = all(not thread.is_alive() for thread in threads)
    if not joined:
        reason = reason or 'owned stream readers not joined within cleanup5seconds'
    wall = exit_observed-launch if exit_observed is not None and launch is not None else None
    if wall is not None and wall > 60000000000:
        reason = reason or 'terminal child wall observation exceeded60seconds'
    streams = []
    if joined:
        for state in stream_states:
            q = fact(state['path'])
            need(q['bytes'] == state['saved_bytes'], 'ACTUAL_STREAM_SAVED_SIZE')
            streams.append(dict(actual_capture=q, **{k:v for k,v in state.items() if k != 'path'}))
            if state['overcap'] or state['reader_error'] is not None:
                reason = reason or 'terminal stream incomplete or overcap'
    child_pin, child = None, None
    if reaped and (P/n['child_result']).is_file():
        try:
            child_pin = fact(P/n['child_result'])
            child = decode(pinned(child_pin))
            need(equal_typed(child['scope'],scope_pin), 'CHILD_SCOPE_JOIN')
            need(child['all_cases_passed'] is True and child['tests_executed'] is True and
                 type(child['I9_memory_test_runs']) is int and child['I9_memory_test_runs'] == 1,
                 'CHILD_COMPLETE_ACCEPTED_MEMORY_RESULT')
        except BaseException as exc:
            reason = reason or 'saved child refused:' + type(exc).__name__ + ':' + str(exc)[:4096]
    else:
        reason = reason or 'owned child saved result missing or cleanup unverified'
    record = dict(schema_version=1,record_type='Root_actual_I9_once_synthetic_memory_supervisor_result',
        author='/root',started_utc=started_utc,created_utc=now().isoformat(),scope=scope_pin,
        supervisor_marker=marker,attempt_number=attempt,resource_prelaunch=resource,
        scope_creation_resource_observation_is_historical=True,child_runner=runner,argv=argv,cwd=str(P),
        owned_child_PID=proc.pid if proc is not None else None,owned_child_exit_code=code,
        owned_child_wait_reaped=reaped,stream_reader_threads_joined=joined,wall_cap_seconds=60,
        cleanup_reap_seconds=5,child_launch_monotonic_ns=launch,child_exit_observed_monotonic_ns=exit_observed,
        owned_child_wall_integer_nanoseconds=wall,elapsed_integer_nanoseconds=time.monotonic_ns()-started,
        streams=streams,child_saved_result=child_pin,passed=reason is None and code == 0 and reaped and joined,
        refusal=reason,owned_child_invocations=1 if proc is not None else 0,
        tests_executed=child.get('tests_executed') if type(child) is dict else None,
        I9_memory_test_runs=child.get('I9_memory_test_runs') if type(child) is dict else None,
        original_I0_I1_I2_I3_I4_I5_I6_I7_I8_import_call_or_test=False,
        original_project_native_Parser_runtime_scientific_execution=False,
        actual_selected_family_Source_publication=False,actual_canonical_IO=False,
        actual_new_lease_family_grants_Native8_Parser_results=None,
        operational_authority=False,scientific_authority=False)
    print(json.dumps(save(P/n['supervisor_result'],record),sort_keys=True))
    if not record['passed']:
        raise SystemExit(1)

if __name__ == '__main__':
    main()
'''

PREPARER = r'''
def main():
    b = bound()
    isolated()
    self_pin(b, 'scope_preparer')
    attempt = attempt_argument(b)
    n = names(attempt)
    source_end, count, planned = check_source(b)
    tool_pins = {role:fact(path) for role,path in b['tool_Source_paths'].items()}
    for name in n.values():
        need(not (P/name).exists(), 'ATTEMPT_NAME_PREEXISTS')
    started = now()
    end = min(started + datetime.timedelta(seconds=b['scope_duration_seconds']), source_end)
    need(started + datetime.timedelta(seconds=65) < end, 'PRIVATE_SCOPE_REQUIRES_FRESH_RESERVE')
    record = dict(schema_version=1,record_type='Root_I9_one_use_pure_semantic_memory_scope',
        author='/root',created_utc=started.isoformat(),interval_start=started.isoformat(),interval_end=end.isoformat(),
        attempt_number=attempt,maximum_invocations=1,new_I9_pure_memory_fixture_invocation_authorized=True,
        expected_planned_case_count=count,planned_case_names=planned,names=n,
        tool_Source_pins=tool_pins,wall_cap_seconds=60,cleanup_reap_seconds=5,
        stream_cap_bytes=CAP,RAM_floor_bytes=1073741824,disk_floor_bytes=10737418240,
        actual_prelaunch_resource_observation_required_in_supervisor=True,
        automatic_retry_authorized=False,actual_selected_family_Source_publication=False,
        original_project_native_Parser_runtime_scientific_execution=False,
        tests_executed=False,target_execution=False,operational_authority=False,scientific_authority=False)
    record[OLD_AUTHORITY_KEY] = False
    for key in ('protocol','protocol_Root_adoption','source_window','module_Source','fixture_Source',
                'API','author_receipt','Source_adoption'):
        record[key] = b[key]
    # Root final issuance only; independent fresh-scope review and Root adoption
    # must happen outside this serializer BEFORE invoking the supervisor.
    record['fresh_scope_different_review_and_Root_adoption_required_before_invocation'] = True
    print(json.dumps(save(P/n['scope'],record),sort_keys=True))

if __name__ == '__main__':
    main()
'''

CAPTURE = r'''
def main():
    b = bound()
    isolated()
    self_pin(b, 'capture')
    attempt = attempt_argument(b)
    n = names(attempt)
    # Saved evidence can be captured after the one-use interval has ended;
    # capture never reopens invocation authority or revalidates an expired lease.
    scope_pin = fact(P/n['scope'])
    scope = decode(pinned(scope_pin))
    need(scope['attempt_number'] == attempt and scope['names'] == n, 'EXACT_SAVED_SCOPE')
    supervisor_pin = fact(P/n['supervisor_result'])
    supervisor = decode(pinned(supervisor_pin))
    need(equal_typed(supervisor['scope'],scope_pin) and supervisor['attempt_number'] == attempt,
         'SAVED_SUPERVISOR_SCOPE_JOIN')
    need(supervisor['owned_child_wait_reaped'] is True and
         supervisor['stream_reader_threads_joined'] is True, 'ACTUAL_STREAM_CLEANUP_REQUIRED')
    streams = supervisor['streams']
    need(type(streams) is list and len(streams) == 2, 'TWO_ACTUAL_SAVED_STREAMS')
    captured = []
    for role, item in zip(('stdout','stderr'), streams):
        q = item['actual_capture']
        need(q['path'] == str(P/n[role]) and type(item['saved_bytes']) is int and
             q['bytes'] == item['saved_bytes'], 'FINITE_SAVED_STREAM')
        # Empty streams use exact nonnegative facts, unlike positive metadata f3.
        data = raw(q['path'])
        need(type(q['bytes']) is int and 0 <= q['bytes'] <= CAP and len(data) == q['bytes'] and
             hashlib.sha256(data).hexdigest() == q['sha256'], 'ACTUAL_STREAM_BYTES')
        captured.append(dict(role=role,actual_capture=q,UTF8_text=data.decode('utf-8','strict'),
            overcap=item['overcap'],reader_error=item['reader_error'],
            complete=item['overcap'] is False and item['reader_error'] is None))
    record = dict(schema_version=1,record_type='Root_actual_owned_I9_memory_child_streams_dated_capture_envelope',
        author='/root',created_utc=now().isoformat(),serializer_Source=fact(Path(__file__)),
        attempt_number=attempt,scope=scope_pin,supervisor_result=supervisor_pin,streams=captured,
        supervisor_accepted=supervisor['passed'],all_streams_complete=all(q['complete'] for q in captured),
        empty_captured_stream_bytes_are_actual_observation_not_positive_metadata_schema_pins=True,
        no_child_or_test_rerun=True,target_execution=False,tests_executed=False,
        operational_authority=False,scientific_authority=False)
    print(json.dumps(save(P/n['capture'],record),sort_keys=True))

if __name__ == '__main__':
    main()
'''

def file_pin(path):
    data = path.read_bytes()
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())

def main():
    assert OUT.is_dir()
    inputs = [PHASE/'ROOT_I9_EXACT_RECORDED_M3_SEMANTIC_IMPLEMENTATION_PROTOCOL_001.json',
        OLD/'ROOT_RUN_I8_ONCE_ISOLATED_MEMORY_FIXTURES_002.py',
        OLD/'ROOT_SUPERVISE_I8_ONCE_MEMORY_FIXTURES_002.py',
        OLD/'ROOT_CAPTURE_I8_ACTUAL_MEMORY_STREAMS_003.py', Path(__file__)]
    assert file_pin(inputs[0])['bytes'] == 122682
    assert file_pin(inputs[0])['sha256'] == '64f10785564b5bdeca10996384b3ad312d208fcd5f041f21e49190790fedd1bc'
    sources = {'RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_TEMPLATE_001.py':RUNNER,
        'SUPERVISE_I9_ONCE_MEMORY_FIXTURES_TEMPLATE_001.py':SUPERVISOR,
        'PREPARE_I9_FRESH_MEMORY_SCOPE_TEMPLATE_001.py':PREPARER,
        'CAPTURE_I9_ACTUAL_MEMORY_STREAMS_TEMPLATE_001.py':CAPTURE}
    actual = []
    for name, body in sources.items():
        data = (COMMON + body).encode('utf-8')
        assert len(data) <= CAP
        tree = ast.parse(data, filename=name)
        compile(tree,name,'exec')
        assignments = [n for n in tree.body if isinstance(n,ast.Assign) and
            any(isinstance(t,ast.Name) and t.id == 'EXACT_ROOT_BINDINGS' for t in n.targets)]
        assert len(assignments) == 1 and isinstance(assignments[0].value,ast.Constant) and assignments[0].value.value is None
        path = OUT/name
        with path.open('xb') as handle:
            handle.write(data)
        assert path.read_bytes() == data
        actual.append(dict(role=name,Source=file_pin(path),AST_parse_passed=True,
            compile_Source_only_passed=True,template_executed=False,bindings=None))
    receipt = dict(schema_version=1,record_type='Actual_I9_memory_tooling_TEMPLATE_Source_author_receipt',
        author='/root/owner_publication_review',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        actual_inputs=[file_pin(p) for p in inputs],templates=actual,
        tests_executed=False,target_execution=False,Root_tool_execution=False,
        old_I0_I1_I2_I3_I4_I5_I6_I7_I8_import_call_or_test=False,Git_commands_or_mutation=False,
        current_protocol_is_review_pending_and_confers_no_target_authority=True,
        template_execution_authorized=False,all_templates_UNBOUND=True,
        required_next='Root immutable exact binding + actual final Source/adoption/schema/API/import whitelist/profile subjects + independent tooling review + fresh one-use scope review/adoption before any supervisor/runner execution.',
        remaining_bind_fields=sorted(ast.literal_eval(next(n.value for n in ast.walk(ast.parse(COMMON))
            if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='required' for t in n.targets)))),
        safety_boundaries=['This is auditable same-user memory instrumentation, not an OS security sandbox.',
            'CPython audit is not exhaustive filesystem/stat/native interception; static Source review remains required.',
            'Only supervisor observes fresh RAM/disk and launches hidden owned child; no semantic Native8/Parser/actual grants.',
            'Scope final issuer creates only finite private attempt names, never target or canonical outputs.',
            'Source binds actual expected names/counts dynamically from exact final API, no guessed cases.',
            'Root must verify final actual Source requires no unlisted imports and profile positive function list is feasible.'],
        operational_authority=False,scientific_authority=False)
    path=OUT/'I9_MEMORY_TOOLING_TEMPLATE_SOURCE_AUTHOR_RECEIPT_001.json'
    data=(json.dumps(receipt,indent=2,sort_keys=True,allow_nan=False)+'\n').encode()
    with path.open('xb') as handle:
        handle.write(data)
    print(json.dumps(dict(receipt=file_pin(path),templates=actual),indent=2))

if __name__ == '__main__':
    main()
