"""Root adopts actual uninvoked quartet002 cached-record Source refusal."""
import datetime, hashlib, json, os, re, sys
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152
SUBJECTS = {
    'validate_recorded_M3_semantics_002.py': 'ecfdbf2da16eddb1aa89eac1735255ebebf928ec0df6818fd9058a047a8b1da1',
    'test_recorded_M3_semantics_memory_only_002.py': '796e672cee68f78c8b15ca73a38a00040a5889c43f7fd2cf78ba71c011137145',
    'CURRENT_OWNER_M3_RECORDED_SEMANTICS_INERT_API_002.json': '7aa68b9d9985dffb1babc14d14bb84e7bd22b73bd3273fb3acbd61ea50adaa41',
    'CURRENT_OWNER_M3_RECORDED_SEMANTICS_SOURCE_AUTHOR_RECEIPT_002.json': '00a4750e9ef70f216831f385ed9f9c85866bdd8706d5724be651f2e1828873ec',
}

def raw(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    with path.open('rb') as handle:
        data = handle.read(CAP + 1)
    assert len(data) <= CAP
    return data

def fact(path):
    data = raw(path)
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

def pin(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and 0 < q['bytes'] <= CAP
    assert type(q['sha256']) is str and re.fullmatch('[0-9a-f]{64}', q['sha256'])
    data = raw(q['path'])
    assert len(data) == q['bytes'] and hashlib.sha256(data).hexdigest() == q['sha256']
    return data

def pairs(items):
    result = {}
    for key, value in items:
        assert key not in result
        result[key] = value
    return result

def bad(value):
    raise AssertionError(value)

def obj(data):
    return json.loads(data, object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

assert sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
assert len(sys.argv) == 3 and re.fullmatch('[0-9a-f]{64}', sys.argv[2])
capsule_path = Path(sys.argv[1])
assert capsule_path.parent.parent == P and 'CAPSULE' in capsule_path.name
capsule_pin = fact(capsule_path)
assert capsule_pin['sha256'] == sys.argv[2]
c = obj(pin(capsule_pin))
f = obj(pin(c['full_proof']))
expected = []
for name, digest in SUBJECTS.items():
    q = fact(P / 'i9' / name)
    assert q['sha256'] == digest
    expected.append(q)
for record in (c, f):
    assert record['reviewer'] == '/root/owner_source_review' and record['source_author'] == '/root/phase_frontier'
    assert record['verdict'].startswith('REFUSE_')
    assert type(record['checks_failed']) is int and record['checks_failed'] == 2
    assert record['target_execution'] is False and record['tests_executed'] is False
    assert len(record['subjects']) == 4 and all(q in record['subjects'] for q in expected)
checks = f['checks']
assert type(checks) is list and checks and len({q['name'] for q in checks}) == len(checks)
assert all(type(q['passed']) is bool for q in checks)
failed = [q for q in checks if q['passed'] is False]
assert c['verdict'] == f['verdict']
assert len(failed) == 2 and f['checks_passed'] == c['checks_passed'] == len(checks) - 2
inputs = f['all_actual_inputs']
assert type(inputs) is list and inputs and len({q['path'].casefold() for q in inputs}) == len(inputs)
assert all(q in inputs for q in expected) and c['reviewer_Source'] in inputs
for q in inputs:
    pin(q)
scope_pin = fact(P / 'ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json')
assert scope_pin['sha256'] == '0c0815540d0be020040f1114f18975300ddeb279a24ba201ba4204680ea9773d'
assert datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=60) < datetime.datetime.fromisoformat(obj(pin(scope_pin))['interval_end'])
result = dict(schema_version=1, record_type='Root_actual_I9_quartet002_cached_record_Source_refusal_adoption',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='ACCEPT_I9_QUARTET002_CACHED_RECORD_SOURCE_REFUSAL_AND_REGRESSION_CORRECTIONS_ONLY',
    source_scope=scope_pin, refused_subjects=expected, different_Source_review=capsule_pin,
    full_proof=c['full_proof'], reviewer_Source=c['reviewer_Source'],
    actual_named_checks=len(checks), actual_passed_checks=len(checks)-2, actual_failed_checks=2,
    actual_rehashed_input_count=len(inputs), all_actual_inputs_rehashed=True,
    actual_failed_checks_detail=failed, Source_findings=f['findings'],
    exact_Source_correction='On every semantic record access register the declared body pin through I9Reader.body before testing the parsed-record cache; preserve immutable byte/JSON caches and existing callback/aggregate budgets and stage-specific generation closure.',
    exact_fixture_regression='Retain the 95 existing case order and append cached_later_stage_full_missing_from_purpose_refused: four-BOUND prewrite with first stage intact and selection review full proof omitted only from second stage purpose and observation snapshots must refuse E_GENERATION_PRELUDE despite cached parsed records.',
    corrected_planned_case_count=96, quartet002_preserved_unrun=True,
    required_next='Actual independent final quartet003 Source review and Root adoption, followed by reviewed bound tools and a separately fresh reviewed one-use memory scope.',
    target_execution=False, tests_executed=False, I9_memory_test_runs=0,
    new_module_or_fixture_invocation_authorized=False,
    old_I0_I8_changes_or_invocations_authorized=False, actual_family_publication=False,
    all_new_grants_lease_family_Native8_Parser_results=None, operational_authority=False, scientific_authority=False)
data = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= CAP
output = P / 'ROOT_I9_QUARTET002_ACTUAL_CACHED_RECORD_SOURCE_REFUSAL_AND_CORRECTION_ADOPTION_001.json'
with output.open('xb') as handle:
    handle.write(data)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(fact(output)))
