"""Different read-only Source analysis of Root attempt002 metadata controls; no tool invocation."""
import ast
import datetime
import hashlib
import json
from pathlib import Path

P=Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012');OWN=P/'bound_tool_review_001'
INPUTS={};checks=[]
def read(path):
    b=path.read_bytes();assert 0<len(b)<=2097152
    q=dict(path=str(path),bytes=len(b),sha256=hashlib.sha256(b).hexdigest());INPUTS[str(path).casefold()]=q
    return b,q
def check(name,value):
    assert type(value) is bool;checks.append(dict(name=name,passed=value));assert value,name
def source(path):
    b,q=read(path);ast.parse(b);compile(b,str(path),'exec');return b.decode(),q
factory,factory_pin=source(P/'ROOT_AUTHOR_I9_SECOND_ATTEMPT_METADATA_TOOL_SOURCES_001.py')
b,receipt_pin=read(P/'ROOT_I9_SECOND_ATTEMPT_METADATA_TOOL_SOURCE_AUTHOR_RECEIPT_001.json');receipt=json.loads(b)
check('Actual Root control002 author receipt exact pin',receipt_pin['bytes']==2642 and receipt_pin['sha256']=='c7b72d20e51e3ccc111ab95652d63f1abdef69cbb7a7c890e54c3220fea43fc6')
check('Root records one saved failed invocation and no automatic retry',receipt['author']=='/root' and type(receipt['I9_memory_test_runs']) is int and receipt['I9_memory_test_runs']==1 and receipt['new_attempt_number']==2 and receipt['automatic_retry_authorized'] is False and receipt['tests_executed'] is False and receipt['target_execution'] is False)
failure=receipt['prior_actual_memory_refusal_adoption'];raw,q=read(Path(failure['path']));check('Actual saved failure adoption pinned',q==failure and q['sha256']=='b8c5e65fe9f3f72ce6fda9299ce6d97a749ccccb8f98da308775efe3354a90ff')
failure_value=json.loads(raw);check('Actual prior failure is preserved run1 zero completed',failure_value['I9_memory_test_runs']==1 and failure_value['actual_completed_case_count']==0 and failure_value['actual_suite_passed'] is False)
subjects=[]
for pair in receipt['subjects']:
    original_text,original_pin=source(Path(pair['original_Source']['path']));text,new_pin=source(Path(pair['new_Source']['path']))
    check('Actual input/output pin: '+Path(new_pin['path']).name,original_pin==pair['original_Source'] and new_pin==pair['new_Source'])
    subjects.append(new_pin);expected=original_text
    name=Path(original_pin['path']).name
    if name.startswith('ROOT_ADOPT_I9_FINAL'):
        anchor="    'ROOT_I9_QUARTET002_ACTUAL_CACHED_RECORD_SOURCE_REFUSAL_AND_CORRECTION_ADOPTION_001.json': 'ae2db2562692be5d3abc1f9111fd1025ef717f60f7ffd5fa74c16f135dd12cc6',\n"
        assert expected.count(anchor)==1
        expected=expected.replace(anchor,anchor+"    'ROOT_I9_ATTEMPT001_ACTUAL_SAVED_REFUSAL_AND_FIXTURE_ROUTE_CORRECTION_ADOPTION_001.json': 'b8c5e65fe9f3f72ce6fda9299ce6d97a749ccccb8f98da308775efe3354a90ff',\n")
        anchor='        quartet002_cached_record_refusal_adoption=authority_inputs[11],\n';assert expected.count(anchor)==1
        expected=expected.replace(anchor,anchor+'        prior_actual_memory_refusal_adoption=authority_inputs[12],\n')
        replacements=[('I9_memory_test_runs=0','I9_memory_test_runs=1',1),('ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_001.json','ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_002.json',1)]
    elif name.startswith('ROOT_BIND'):
        replacements=[(a.replace('{N}','001'),a.replace('{N}','002'),1) for a in (
          'ROOT_I9_FINAL_RECORDED_M3_SEMANTIC_AND_FIXTURE_SOURCE_REVIEW_ADOPTION_{N}.json','ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_{N}.json','ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_{N}.json','ROOT_RUN_I9_ONCE_ISOLATED_MEMORY_FIXTURES_{N}.py','ROOT_SUPERVISE_I9_ONCE_MEMORY_FIXTURES_{N}.py','ROOT_PREPARE_I9_FRESH_MEMORY_SCOPE_{N}.py','ROOT_CAPTURE_I9_ACTUAL_MEMORY_STREAMS_{N}.py')]
        replacements.append(('attempt_numbers=[1]','attempt_numbers=[2]',2))
    else:
        replacements=[(a.replace('{N}','001'),a.replace('{N}','002'),n) for a,n in (
          ('ROOT_I9_EXACT_MEMORY_TOOL_BINDINGS_{N}.json',1),('ROOT_I9_EXACT_MEMORY_TOOL_ACTUAL_BINDING_SOURCE_RECEIPT_{N}.json',1),('ROOT_I9_EXACT_BOUND_MEMORY_TOOL_DIFFERENT_SOURCE_REVIEW_ADOPTION_{N}.json',2),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_{N}.json',1),('ROOT_I9_FRESH_ONE_USE_MEMORY_FIXTURE_SCOPE_DIFFERENT_REVIEW_ADOPTION_{N}.json',1))]
        replacements += [("s['attempt_number'] == 1","s['attempt_number'] == 2",1),('I9_memory_test_runs=0','I9_memory_test_runs=1',1)]
    for before,after,count in replacements:
        assert expected.count(before)==count;(expected_count:=count)
        expected=expected.replace(before,after)
    check('Whole control Source complement unchanged outside finite reviewed history/name delta: '+name,text==expected)
    for anchor in ('ROOT_CURRENT_I9_M3_SEMANTIC_PREFLIGHT_SOURCE_SCOPE_001.json','ROOT_I9_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json'):
        if anchor in original_text:check('Immutable anchor retained '+name+' '+anchor,text.count(anchor)==original_text.count(anchor))
    if name.startswith('ROOT_BIND'):
        check('Binder002 retains exact immutable four TEMPLATE002 hashes',all(s in text for s in ('dbd64396b20019b965115d2a5a8b2e1c465b8c36e227b5b403657cb49036680d','02e6fc14789a27e0b5d5d3a2ef23b9fdbf9b9e43116f7fe7135fe29902b3afaf','b926dd703bdb4aea87f8ed1693ffd218e70d62e2c2cdeb5ce7c5a80022f20d87','cf1533d475dc113d1e5ab85c0749faf8345ed0d2f534d88ae33762c357824720')))
        check('Binder002 keeps finite attempt2 only',text.count('attempt_numbers=[2]')==2 and 'attempt_numbers=[1]' not in text)
    if name.startswith('ROOT_ADOPT_I9_BOUND'):
        check('Scope adopter002 still requires independent different role and fresh65 reserve',"record['reviewer'] == '/root/phase_frontier'" in text and 'now + datetime.timedelta(seconds=65)' in text and 'expected = [fresh_scope]' in text)
_,self_pin=read(Path(__file__))
record=dict(schema_version=1,record_type='independent_I9_Root_control002_Source_preparation_analysis',reviewer='/root/phase_frontier',source_author='/root',
 created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='microseconds'),subjects=subjects,reviewer_Source=self_pin,
 all_actual_inputs=sorted(INPUTS.values(),key=lambda q:q['path']),checks=checks,checks_passed=len(checks),checks_failed=0,
 status='NO_ACTIONABLE_CONTROL002_SOURCE_DEFECT_FOUND_PRELIMINARY_ONLY',
 actual_six_bound_subjects_review_not_yet_performed=True,new_bound_tool_Source_acceptance_issued=False,
 target_execution=False,tests_executed=False,tools_invoked=False,
 limitations=['This preparation analysis is not the actual six-subject bound-tool review.',
 'Actual final quartet Source adoption002 plus bound four Sources/config/receipt must exist and be reviewed before any tool Source acceptance.',
 'No prior failed attempt, scope, marker, stream or result is rewritten or replayed.'])
path=OWN/'INDEPENDENT_I9_ROOT_CONTROL002_SOURCE_PREPARATION_ANALYSIS_001.json';assert not path.exists()
raw=(json.dumps(record,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(raw)<=2097152
path.write_bytes(raw)
print(json.dumps(dict(report=dict(path=str(path),bytes=len(raw),sha256=hashlib.sha256(raw).hexdigest()),checks_passed=len(checks),checks_failed=0)))
