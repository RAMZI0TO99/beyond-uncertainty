"""Record an equivalent Unicode predicate correction; never invoke target code."""
import ast, datetime, hashlib, json, os
from pathlib import Path
P = Path(r'D:\Aenv\pro2\WORK\resume-20261017-001\m3_prewrite_validation_012')
CAP = 2097152

def fact(path):
    path = Path(path)
    assert path.is_file() and not path.is_symlink() and path.stat().st_size <= CAP
    data = path.read_bytes()
    assert len(data) <= CAP
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())

adoption = fact(P / 'ROOT_I9_ATTEMPT002_ACTUAL_SAVED_REFUSAL_AND_FIXED_ADOPTION_COMPATIBILITY_CORRECTION_ADOPTION_001.json')
assert adoption['sha256'] == '0330ddd4a175904215a1679deaf7cdf232393546fef49063b43b3488080e6077'
module = fact(P / 'i9/validate_recorded_M3_semantics_003.py')
assert module['sha256'] == 'a4cddf6da7f4383901875cf54e9a0af2c949ca111444cea374dcb0623c667ab1'
tree = ast.parse(Path(module['path']).read_bytes())
node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == '_i9_walk')
body = ast.get_source_segment(Path(module['path']).read_text(), node)
assert '0xD800' in body and '0xDFFF' in body and 'ord(c)' in body
record = dict(schema_version=1, record_type='Root_I9_equivalent_Unicode_surrogate_scan_Source_correction_scope',
    author='/root', created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    verdict='AUTHORIZE_EQUIVALENT_SURROGATE_PREDICATE_SOURCE_CORRECTION_ONLY',
    actual_saved_refusal_adoption=adoption, actual_predecessor_module=module,
    I9_memory_test_runs=2, accepted_complete_memory_test_runs=0, failed_memory_test_runs=2,
    actual_completed_cases=0, evidence='Saved attempt002 reports 1926652 generator-expression calls and about4.05 seconds before first common/bootstrap refusal. This establishes a budget risk inference, not an observed timeout or accepted benchmark.',
    exact_equivalent_change='In _i9_walk only, replace the per-character surrogate generator with a re search for the inclusive U+D800..U+DFFF range, requiring no match. Retain exact built-in str checks, all other scalar/container/type/depth/node/cap predicates and error code. Python Unicode characters match that range exactly when 0xD800 <= ord(character) <= 0xDFFF.',
    unchanged_requirements=['All23 original render/inverse port bytes', 'Generic current authority/adoption guard whole bodies', 'Every immutable original Source and proof byte', '60-second suite wall plus5-second owned cleanup', 'All cases, caps, reader budgets, flags, chronology and no-entry holds'],
    regression='Append a meaningful public-API trusted-input surrogate-string refusal before any reader callback, with exact existing surrogate error code. Preserve all96 prior names/order, append the current missing-target authority regression and then the surrogate regression:98 literal cases if exactly these two additions.',
    required_next='Final independent actual module/fixture/API/receipt Source review includes this exact correction, current/fixed authority distinction and both regressions before Root adoption and fresh attempt003 controls/scope.',
    target_execution=False, tests_executed=False, new_invocation_authorized=False,
    no_budget_relaxation_or_case_omission=True, actual_runtime_improvement_measured=False,
    operational_authority=False, scientific_authority=False)
data = (json.dumps(record, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
assert len(data) <= CAP
path = P / 'ROOT_I9_EQUIVALENT_SURROGATE_SCAN_SOURCE_CORRECTION_SCOPE_001.json'
with path.open('xb') as handle:
    handle.write(data)
    handle.flush()
    os.fsync(handle.fileno())
print(json.dumps(fact(path)))
