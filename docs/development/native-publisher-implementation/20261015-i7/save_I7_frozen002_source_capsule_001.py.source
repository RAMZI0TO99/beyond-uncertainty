"""Serialize the completed independent Source review; never invoke its subjects."""
import datetime as dt
import hashlib
import json
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_implementation_010')
O = P / 'independent_review_001'
CAP = 2097152

def raw(p):
    b = Path(p).read_bytes()
    assert 0 < len(b) <= CAP
    return b

def fact(p):
    b = raw(p)
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def main():
    full = O / 'INDEPENDENT_I7_FROZEN002_FULL_SOURCE_PROOF_001.json'
    body = raw(full)
    assert hashlib.sha256(body).hexdigest() == '1fad1d8e8dc5f898e0fc4ce2be1fd4e2d0ea752a7bce2efbf711d51dc5d9d0e6'
    proof = json.loads(body)
    assert type(proof['checks_failed']) is int and proof['checks_failed'] == 0
    assert len(proof['checks']) == 371 and len({q['name'] for q in proof['checks']}) == 371
    assert all(q['passed'] is True for q in proof['checks'])
    assert proof['target_execution'] is False and proof['tests_executed'] is False
    for q in proof['all_actual_inputs']:
        assert q == fact(q['path'])
    assert not (P / 'ROOT_I7_PRIVATE_OWNED_TEMP_IO_SCOPE_001.json').exists()
    assert not (P / 'ROOT_I7_ONCE_OWNED_SYNTHETIC_IO_EXECUTION_SCOPE_001.json').exists()
    capsule = dict(
        schema_version=1,
        record_type='Independent_I7_frozen002_held_publisher_and_fixture_Source_review_capsule',
        reviewer='/root/owner_source_review', source_author='/root/phase_frontier',
        created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
        verdict='PASS_SOURCE_I7_HELD_PUBLISHER_IO_AND_METADATA_FIXTURE_ONLY',
        subjects=proof['subjects'], full_proof=fact(full), reviewer_Source=proof['reviewer_Source'],
        checks_passed=371, checks_failed=0, actual_input_count=len(proof['all_actual_inputs']),
        exact_inherited_helper_count=24, exact_context_only_writer_edits=3,
        complete_original_Source_API_and_prior001_quartet_inverse_verified=True,
        all_module_function_class_bodies001_to002_identical=True,
        planned_owned_synthetic_cases=54, actual_owned_synthetic_cases_run_by_reviewer=0,
        tests_executed=False, target_execution=False,
        target_imports=0, target_function_calls=0, target_Source_compilations=0,
        original_I0_I6_or_Native_Parser_calls=0,
        current_Root_runner='ROOT_RUN_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_003.py',
        current_Root_supervisor='ROOT_SUPERVISE_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_005.py',
        current_Root_scope_issuer='ROOT_PREPARE_I7_FRESH_OWNED_IO_SCOPES_002.py',
        real_publication_and_reconciliation_double_held=True,
        full_actual_owner_lease_producer_proof_resource_caller_admission='UNWIRED',
        new_module_or_fixture_invocation_authorized_now=False,
        next_boundary='Root Source adoption, separately issued private18 and outer one-use execution scope, then actual pre-invocation review. Only new owned synthetic IO may later run.',
        future_actual_family_lease_Source_grants_paths_purpose_Native8_Parser_results=None,
        operational_authority=False, scientific_authority=False,
    )
    out = O / 'INDEPENDENT_I7_FROZEN002_SOURCE_CAPSULE_001.json'
    b = (json.dumps(capsule, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(b) <= CAP
    with out.open('xb') as f:
        f.write(b)
    print(json.dumps(dict(capsule=fact(out), full_proof=fact(full), reviewer_Source=proof['reviewer_Source'],
                         checks=371, inputs=len(proof['all_actual_inputs']))))

if __name__ == '__main__':
    main()
