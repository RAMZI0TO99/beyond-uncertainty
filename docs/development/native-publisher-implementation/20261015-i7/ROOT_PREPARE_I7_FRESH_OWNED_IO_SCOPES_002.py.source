 subjects=adoption['subjects']
 def one(pattern):
  matches=[q for q in subjects if re.fullmatch(pattern,Path(q['path']).name)];assert len(matches)==1;pin(matches[0]);return matches[0]
 module=one(r'publish_current_owner_M3_finite8_\d{3}\.py');fixture=one(r'test_current_owner_M3_finite8_owned_io_\d{3}\.py');apipin=one(r'CURRENT_OWNER_M3_FINITE8_PUBLISHER_INERT_API_\d{3}\.json');api=json.loads(pin(apipin));interface=api['fixture_interface']
 assert interface['actual_source_paths']==dict(publisher_source=module['path'],fixture_source=fixture['path'],API=apipin['path'])
 root=Path(interface['owned_namespace']);assert root==Path(r'D:\Aenv\pro2\WORK\I7F010\n1') and not root.exists()
 manifest=interface['case_manifest'];directories=interface['case_directories'];count=interface['expected_case_count'];assert type(count) is int and 1<=count<=256 and len(manifest)==len(directories)==count
 assert len({q['case'] for q in manifest})==count and [q['directory'] for q in manifest]==directories
 leaves=[];dirs=[str(root)];seen=set()
 for case in manifest:
  assert type(case) is dict and set(case)=={'case','directory','leaves'} and re.fullmatch(r'c\d{2,3}',case['directory'])
  directory=root/case['directory'];dirs.append(str(directory))
  for q in case['leaves']:
   assert type(q) is dict and set(q)=={'path','cap','kind'} and type(q['cap']) is int and 0<q['cap']<=CAP
   path=root/q['path'];assert path.is_absolute() and path.parent==directory and '..' not in path.parts and path.is_relative_to(root)
   name=str(path).casefold();assert name not in seen;seen.add(name);leaves.append(dict(path=str(path),cap=q['cap'],kind=q['kind'],case=case['case']))
 class Memory(ctypes.Structure):_fields_=[('length',ctypes.c_ulong),('load',ctypes.c_ulong),('total',ctypes.c_ulonglong),('available',ctypes.c_ulonglong),('page_total',ctypes.c_ulonglong),('page_available',ctypes.c_ulonglong),('virtual_total',ctypes.c_ulonglong),('virtual_available',ctypes.c_ulonglong),('extended',ctypes.c_ulonglong)]
 memory=Memory();memory.length=ctypes.sizeof(memory);assert ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(memory));disk=shutil.disk_usage(P).free
 assert memory.available>=1073741824 and disk>=10737418240
 start=datetime.datetime.now(datetime.timezone.utc);end=min(start+datetime.timedelta(minutes=15),datetime.datetime.fromisoformat(authority['interval_end']));assert start+datetime.timedelta(seconds=120)<end
 private=dict(schema_version=1,record_type=interface['scope_record_type'],author='/root',Root_thread=authority['Root_thread'],created_utc=start.isoformat(timespec='microseconds'),interval_start=start.isoformat(timespec='microseconds'),interval_end=end.isoformat(timespec='microseconds'),owned_namespace=str(root),publisher_source=module,fixture_source=fixture,API=apipin,Source_review_Root_adoption=adoptionpin,case_manifest=manifest,hard_timeout_seconds=60,metadata_cap=CAP,operational_authority=False,original_project_target_execution=False,owned_I7_synthetic_IO_execution=True)
 assert set(private)==set(interface['scope_closed_keys']) and len(private)==18
 privatepin=save('ROOT_I7_PRIVATE_OWNED_TEMP_IO_SCOPE_001.json',private)
 execution=dict(schema_version=1,record_type='Root_fresh_exact_once_I7_owned_synthetic_IO_execution_scope',author='/root',Root_thread=authority['Root_thread'],created_utc=start.isoformat(timespec='microseconds'),interval_start=start.isoformat(timespec='microseconds'),interval_end=end.isoformat(timespec='microseconds'),original_Source_scope=authoritypin,private_fixture_scope=privatepin,maximum_invocations=1,automatic_retry_authorized=False,new_I7_owned_synthetic_IO_invocation_authorized=True,original_publisher_I0_I1_I2_I3_I4_I5_I6_native_Parser_project_invocations_authorized=False,publisher_Source=module,fixture_Source=fixture,API=apipin,actual_final_Source_adoption=adoptionpin,exact_child_runner=fact(P/'ROOT_RUN_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_003.py'),exact_supervisor_Source=fact(P/'ROOT_SUPERVISE_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_005.py'),owned_namespace_root=str(root),namespace_marker_name=interface['namespace_marker'],exact_owned_leaf_manifest=leaves,exact_owned_directories=dirs,actual_owned_hardlink_setup_authorized=True,hardlink_setup_boundary='Only declared neutral c13/a.in -> c13/l.in fixture setup; no actual symlink/reparse creation.',expected_planned_case_count=count,consumption_marker_name='ROOT_I7_OWNED_IO_SCOPE_CONSUMED_001.json',supervisor_marker_name='ROOT_I7_OWNED_IO_SUPERVISOR_CONSUMED_001.json',saved_result_name='ROOT_I7_ACTUAL_ONCE_OWNED_SYNTHETIC_IO_RESULTS_001.json',supervisor_result_name='ROOT_I7_ACTUAL_ONCE_OWNED_IO_SUPERVISOR_RESULT_001.json',child_stdout_name='ROOT_I7_OWNED_IO_CHILD_STDOUT_001.txt',child_stderr_name='ROOT_I7_OWNED_IO_CHILD_STDERR_001.txt',owned_hidden_child_maximum=1,wall_cap_seconds=60,cleanup_reap_seconds=5,stream_and_result_cap_bytes=CAP,scope_creation_resource_observation_is_historical=True,actual_resource_observation=dict(observed_utc=start.isoformat(timespec='microseconds'),available_RAM_bytes=memory.available,disk_free_bytes=disk,age_limit_seconds=60,RAM_floor_bytes=1073741824,disk_floor_bytes=10737418240),owned