"""Root issues two exact fresh synthetic test scopes after actual Source adoption."""
import ctypes,datetime,hashlib,json,os,re,shutil,sys
from pathlib import Path
P=Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_implementation_010');CAP=2097152
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and 0<p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 b=raw(q['path']);assert type(q['bytes']) is int and len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def save(name,x):
 p=P/name;b=(json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
 with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
 return fact(p)
