 print(json.dumps(dict(private_scope=privatepin,execution_scope=save('ROOT_I7_ONCE_OWNED_SYNTHETIC_IO_EXECUTION_SCOPE_001.json',execution),expected_case_count=count,exact_owned_leaf_count=len(leaves),exact_owned_directory_count=len(dirs))))
