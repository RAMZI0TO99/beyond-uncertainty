    check('actual_exact_isolated_argv_and_cwd',v['argv']==[r'C:\Users\aladdin-alyanai\AppData\Local\Programs\Python\Python313\python.exe','-I','-S','-B',s['exact_child_runner']['path'],sp.name,fact(sp)['sha256']] and v['cwd']==str(P) and v['child_runner']==s['exact_child_runner'])
