        check('actual_fresh_RAM_disk_floors_'+label,all(type(q[k]) is int for k in ('available_RAM_bytes','disk_free_bytes','observed_monotonic_ns','age_limit_seconds')) and q['available_RAM_bytes']>=1073741824 and q['disk_free_bytes']>=10737418240 and q['age_limit_seconds']==60 and q['FileTime_or_Native8_collection'] is False)
    check('resource_prelaunch_age_actual_monotonic_under60',0<=v['child_launch_monotonic_ns']-v['resource_prelaunch']['observed_monotonic_ns']<60000000000 and ticks(v['resource_before_namespace']['observed_utc'])<=ticks(namespace['created_utc'])<=ticks(v['resource_prelaunch']['observed_utc']))
    check('scope_creation_resource_historical_not_reused_as_fresh',v['scope_creation_resource_observation_is_historical'] is True and s['scope_creation_resource_observation_is_historical'] is True)
    for label in ('stdout','stderr'):
        stream=r[label];b=stream['text'].encode()
        check('inner_fixture_'+label+'_actual_empty',type(stream['bytes']) is int and stream['bytes']==len(b)==0 and stream['sha256']==hashlib.sha256(b).hexdigest())
    check('capture_envelope_exact_supervisor_and_no_rerun',c['supervisor_result']==fact(vp) and c['no_child_or_fixture_rerun'] is True and c['empty_capture_is_actual_observation_not_positive_authority_schema_pin'] is True)
    for index,q in enumerate(c['streams']):
        b=raw(q['actual_capture']['path'])
        check('outer_raw_stream_capture_'+str(index),q['actual_capture'] in v['streams'] and pin(q['actual_capture']) and q['UTF8_text'].encode()==b and len(b)<=CAP)
    check('outer_stdout_exact_saved_result_pin_only',json.loads(c['streams'][0]['UTF8_text'])==fact(rp))
    check('outer_stderr_actual_zero_capture',c['streams'][1]['actual_capture']['bytes']==0 and c['streams'][1]['UTF8_text']=='')
    pin(c['serializer_Source'])
    history=obj(P/'ROOT_I7_ACTUAL_METADATA_ADOPTION_TOOLING_HISTORY_001.json')
    raw(P/'ROOT_ADOPT_I7_FRESH_OWNED_IO_SCOPE_REVIEW_001.py');raw(P/'ROOT_ADOPT_I7_FRESH_OWNED_IO_SCOPE_REVIEW_002.py')
    check('metadata_adopter_failure_preserved_not_fixture_failure_or_rerun',history['I7_owned_IO_test_runs']==1 and history['fixture_reruns']==0 and history['automatic_retry'] is False and history['all_prior_tooling_versions_retained'] is True and '168' in history['initial_adopter_outcome'] and '148' in history['corrected_adopter_outcome'])
    preservation=obj(P/'ROOT_I7_ACTUAL_START_READ_ONLY_PRESERVATION_CHECK_001.json')
    baseline=obj(preservation['current_Source_baseline']['path']);current=0;pending_count=0
    check('current_Source_baseline_pin_exact',pin(preservation['current_Source_baseline']))
    for row in baseline['current_45_identity_rows']:
        if row['canonical'] is None:
            pending_count+=1;check('actual_real_pending_path_still_absent_'+row['role'],not os.path.lexists(row['canonical_path']))
        else:
            current+=1;check('actual_real_current_Source_unchanged_'+row['role'],pin(row['canonical']))
    check('real_current36_pending9_unchanged_by_synthetic_IO',current==36 and pending_count==9)
    raw(P/'ROOT_ADOPT_I7_SAVED_OWNED_IO_RESULTS_001.py');raw(O/'inspect_I7_saved_results_static_001.py');raw(Path(__file__))
    for index,q in enumerate(list(INPUTS.values())):check('final_rehash_actual_input_'+str(index).zfill(3),pin(q),q)
    failed=[q for q in CHECKS if q['passed'] is not True]
    common=dict(reviewer='/root/owner_source_review',source_author='/root',created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
                target_execution=False,tests_executed=False,I7_fixture_reruns=0,target_imports=0,target_function_calls=0,target_Source_compilations=0,
                original_I0_I6_Native_Parser_calls=0,checks_passed=len(CHECKS)-len(failed),checks_failed=len(failed),subjects=[fact(rp),fact(vp),fact(cp)])
    verdict='PASS_I7_ACTUAL_SAVED_OWNED_SYNTHETIC_IO_RESULTS_ONLY' if not failed else 'REFUSE_I7_SAVED_RESULT_EVIDENCE'
    full=dict(schema_version=1,record_type='Independent_I7_actual_saved_owned_IO_result_full_review',verdict=verdict,
              all_actual_inputs=list(INPUTS.values()),checks=CHECKS,reviewer_Source=fact(Path(__file__)),
              actual_saved_test_runs=1,actual_saved_passed_cases=54,actual_saved_writer_entries=24,actual_saved_reader_entries=370,
              actual_saved_audit_IO_trace_events=643,actual_saved_audit_omitted_events=0,actual_retained_files=66,actual_retained_directories=55,
              current_real_Source_present=36,current_real_pending_absent=9,actual_saved_child_PID=18116,actual_saved_child_exit=0,actual_saved_child_reaped=True,
              actual_saved_child_wall_nanoseconds=v['owned_child_wall_integer_nanoseconds'],
              evidence_boundary='Actual new copied IO on owned neutral synthetic files only. Full I0/I1/I2/producer/lease/proof/resource/caller actual-family admission is UNWIRED; real entries stay double held. No original/I0-I6/Native8/Parser/runtime/scientific qualification.',
              evidence_limits=['24/370 are profiled function entries, not claims that every call completed IO.',
                               'Actual retained full PATH9/descriptor9 pairs and rename8 are validated where saved. Negative injected paths retain their specific failure and actual physical prefix; injection is not physical reparse/native proof.',
                               'Pure metadata labels describe the tested predicate. Scope read and case-directory setup also occurred around those cases.',
                               'Nested synthetic21/43/26 examples are data-only and were not written as standalone authority records.',
                               'Audit covers observed CPython events plus reviewed Source wrappers, not exhaustive stat/native interception.',
