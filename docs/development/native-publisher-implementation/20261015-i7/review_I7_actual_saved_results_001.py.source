    fp=save(O/'INDEPENDENT_I7_ACTUAL_SAVED_RESULTS_FULL_PROOF_001.json',full)
    capsule=dict(schema_version=1,record_type='Independent_I7_actual_saved_owned_synthetic_IO_results_capsule',verdict=verdict,
                 full_proof=fp,reviewer_Source=fact(Path(__file__)),actual_input_count=len(INPUTS),actual_saved_test_runs=1,actual_saved_passed_cases=54,
