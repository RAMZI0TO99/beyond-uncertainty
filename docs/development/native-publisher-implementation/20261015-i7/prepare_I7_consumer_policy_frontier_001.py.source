def pairs(rows):
 d={}
 for k,v in rows:
  if k in d:raise ValueError('duplicate JSON')
  d[k]=v
 return d
def bad(v):raise ValueError(v)
def read(p):
 p=Path(p);b=p.read_bytes();assert 0<len(b)<=2097152
 f=dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest());inputs[str(p)]=f;return f,b
def obj(p):
 f,b=read(p);return f,json.loads(b,object_pairs_hook=pairs,parse_float=bad,parse_constant=bad)
def ck(n,v,e=None):
 assert type(v) is bool and n not in {r['name'] for r in checks};checks.append(dict(name=n,passed=v,evidence=e))
def py(p,names):
 f,b=read(p);text=b.decode();tree=ast.parse(text);defs={}
 for name in names:
  found=[n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef) and n.name==name];assert len(found)==1,name
  n=found[0];body=ast.get_source_segment(text,n);defs[name]=dict(line=n.lineno,end_line=n.end_lineno,Source=body,sha256=hashlib.sha256(body.encode()).hexdigest(),calls=[ast.unparse(c.func) for c in ast.walk(n) if isinstance(c,ast.Call)])
 readings.append(dict(subject=f,Python_AST_only=True,actual_functions=defs))
 return f,text,tree,defs
def save(n,v):
 b=(json.dumps(v,indent=2,sort_keys=True,allow_nan=False)+'\n').encode();assert len(b)<=2097152;p=O/n
 with p.open('xb') as h:h.write(b)
 return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
