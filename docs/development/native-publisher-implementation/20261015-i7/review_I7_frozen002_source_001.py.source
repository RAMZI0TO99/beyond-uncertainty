        'fixture_begin_scope_validate_before_first_reader': ordered(source['_fixture_begin'], ['wrapper = _fixture_scope_check', 'scope_body = read_pin', '_check_observations()', 'ordinary_chain(FIXTURE_NAMESPACE)', '_FIXTURE_CONTEXT =']),
