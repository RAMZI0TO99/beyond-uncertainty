        'fixture_time_same_epoch_strict60_reserve': 'now + 600000000 < end' in source['_fixture_scope_check'] and 'return moment(utc(), 6)' in source['current_ticks'],
        'fixture_authorize_before_read_and_publish_IO': ordered(source['_fixture_read'], ['_fixture_authorize', '_pin(pin, cap)', 'tracked_pin']) and ordered(source['_fixture_publish'], ['_fixture_authorize', 'E_OUTPUT_CAP', 'E_OUTPUT_PREFLIGHT_REQUIRED', 'root_publish_once']),
        'fixture_exact_cap_registry_before_IO': '_HELD_CAPS[key] == (path, cap)' in source['_fixture_authorize'] and 'cap in (PHASE_CAP, SOURCE_CAP)' in source['_fixture_authorize'],
        'fixture_preflight_all_declared_inputs_before_outputs': ordered(source['_fixture_preflight'], ["if leaf['kind'] == 'input'", 'E_ALL_INPUTS_PAIRED_READ', 'absent_output(path)', 'postread()', '_PREPARED_OUTPUTS =']),
        'fixture_all_three_guards_rehash_scope_and_check_observations': ordered(source['_current_owner_publication_guard'], ['E_FIXTURE_INACTIVE_REAL_ADMISSION_UNWIRED', '_fixture_scope_check', 'read_pin', '_check_observations()', '_FIXTURE_GUARD_COUNT += 1']),
        'fixture_no_real_hold_patch': "setattr(module, 'CURRENT_OWNER_V2_CANONICAL_PUBLICATION_BINDINGS_QUALIFIED'" not in tests,
        'fixture_patches_restore_in_finally': ordered(tests, ['finally:\n            for owner, name, old in reversed(patches):', 'setattr(owner, name, old)', 'module._fixture_end()']),
        'fixture_mutation_specific_postread_not_preflight_refusal': ordered(tests[tests.index("elif case == 'input_mutation_refusal'"):], ['_fixture_preflight', "source.open('wb')", "'Source digest/length'"]),
