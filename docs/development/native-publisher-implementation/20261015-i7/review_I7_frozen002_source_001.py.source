"""Independent I7 read/hash/AST Source audit, with zero target execution."""
import ast
import builtins
import datetime as dt
import hashlib
import json
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_implementation_010')
I = P / 'i7'
O = P / 'independent_review_001'
CAP = 2097152
CHECKS = []
INPUTS = {}

def check(name, condition, evidence=None):
    assert name not in {x['name'] for x in CHECKS}
    CHECKS.append(dict(name=name, passed=bool(condition), evidence=evidence))

def raw(p):
    p = Path(p)
    b = p.read_bytes()
    assert 0 < len(b) <= CAP
    f = dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())
    assert str(p) not in INPUTS or INPUTS[str(p)] == f
    INPUTS[str(p)] = f
    return b

def fact(p):
    raw(p)
    return INPUTS[str(Path(p))]

def pairs(rows):
    d = {}
    for k, v in rows:
        assert k not in d
        d[k] = v
    return d

def bad(v):
    raise ValueError(v)

def obj(p):
    return json.loads(raw(p), object_pairs_hook=pairs, parse_float=bad, parse_constant=bad)

def pinned(q):
    assert type(q) is dict and set(q) == {'path', 'bytes', 'sha256'}
    assert type(q['bytes']) is int and 0 < q['bytes'] <= CAP
    b = raw(q['path'])
    return len(b) == q['bytes'] and hashlib.sha256(b).hexdigest() == q['sha256']

def structure(p):
    b = raw(p)
    tree = ast.parse(b, filename=str(p))
    lines = b.splitlines(keepends=True)
    def span(n):
        return b''.join(lines[n.lineno - 1:n.end_lineno])
    funcs = {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.ClassDef))}
    constants = {}
    for n in tree.body:
        if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
            try:
                constants[n.targets[0].id] = ast.literal_eval(n.value)
            except (ValueError, TypeError):
                pass
    return b, tree, funcs, constants, span

def calls(n):
    return [x for x in ast.walk(n) if isinstance(x, ast.Call)]

def ordered(text, parts):
    pos = -1
    for piece in parts:
        found = text.find(piece, pos + 1)
        if found <= pos:
            return False
        pos = found
    return True

def main():
    m = I / 'publish_current_owner_M3_finite8_002.py'
    t = I / 'test_current_owner_M3_finite8_owned_io_002.py'
