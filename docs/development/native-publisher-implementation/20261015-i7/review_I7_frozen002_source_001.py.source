        'path_no_device_UNC_ADS_dot_trailing_aliases': all(x in source['_path'] for x in ('[A-Z]', "x not in ('.', '..')", "x[-1] not in '. '", 'CON', 'LPT', 'COM')),
        'strict_pin_builtin_positive_int_lower_sha': all(x in source['_pin'] for x in ("type(value['bytes']) is int", "0 < value['bytes'] <= cap", '[0-9a-f]{64}')),
