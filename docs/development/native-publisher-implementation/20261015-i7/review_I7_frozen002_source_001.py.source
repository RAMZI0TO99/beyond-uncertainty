    parentp = P / 'ROOT_SUPERVISE_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_005.py'
    cb, ct, cf, cc, cs = structure(childp)
    pb, pt, pf, pc, ps = structure(parentp)
    for p in (P / 'ROOT_ADOPT_I7_DIFFERENT_SOURCE_REVIEW_001.py',
              P / 'ROOT_PREPARE_I7_MANAGED_CANDIDATES_001.py',
              P / 'ROOT_I7_ACTUAL_START_READ_ONLY_PRESERVATION_CHECK_001.json',
              O / 'I7_PREBIRTH_FRAGMENT001_ACTUAL_STATIC_FINDINGS_001.json',
