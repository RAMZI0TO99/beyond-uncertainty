        'publication43_exact_draft_and_actual_source_pairs': all(x in source['construct_publication43'] for x in ("canonical['sha256'] == draft['sha256']", "canonical['sha256'] != predecessor['sha256']", "_physical_pair(row['actual_publication_metadata_APIs']")),
        'publication43_true_flags_explicit': all(x in source['construct_publication43'] for x in ("record['canonical_publication'] is True", "record['partial_failure_preserved_no_rollback_no_automatic_retry'] is True", "record['canonical_delta_and_creation_review_pending'] is True")),
        'retained_constants_use_recursive_type_equality': "_same_typed(record['topology'], TOPOLOGY)" in source['construct_publication43'] and "_same_typed(record['original_numerical_guards'], ORIGINAL_GUARDS)" in source['construct_publication43'],
        'reconciliation26_delegates43_and_never_writer': 'construct_publication43(' in source['construct_reconciliation26'] and 'root_publish_once' not in source['construct_reconciliation26'] and 'all(record[k] is False for k in RECON_FALSE_KEYS)' in source['construct_reconciliation26'],
        'reconciliation_birth6or7_integer_ticks_no_retained_string_rewrite': '_birth_ticks(record[\'canonical_Source_birth_utc\'])' in source['construct_reconciliation26'] and '[0-9]{6,7}' in source['_birth_ticks'] and "return moment(value[:-1] + '+00:00' if value.endswith('Z') else value)" in source['_birth_ticks'],
