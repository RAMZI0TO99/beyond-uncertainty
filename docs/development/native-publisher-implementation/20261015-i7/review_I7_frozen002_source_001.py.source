               I / 'I7_AUTHOR_ACTUAL_FINITE_SOURCE_SELF_INSPECTION_002.json',
               I / 'I7_ACTUAL_SOURCE002_COVERAGE_AND_AUTHOR_TOOLING_HISTORY_002.json']
    for p in authors:
        raw(p)
    author_audit = obj(authors[-2])
    author_history = obj(authors[-1])
    for index, q in enumerate(author_history['finite_owned_inputs']):
