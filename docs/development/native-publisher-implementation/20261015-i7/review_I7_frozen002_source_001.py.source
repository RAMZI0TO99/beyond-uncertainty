        'Root_supervisor_one_hidden_child_exact_isolated_flags': parent.count('subprocess.Popen(') == 1 and "[PYTHON,'-I','-S','-B'" in parent and 'creationflags=subprocess.CREATE_NO_WINDOW' in parent,
