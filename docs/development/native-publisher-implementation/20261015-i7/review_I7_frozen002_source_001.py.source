        'request_rows_ordered_unique_subset1to8': all(x in source['_validate_request_header'] for x in ('0 < len(rows) <= 8', 'len(set(roles)) == len(roles)', 'roles == [r for r in ROLE_ORDER if r in roles]')),
        'request_producer_map_exactly_M3': "_closed(request['producer_supports'], ('M3',)" in source['_validate_request_header'],
