    check('receipt_editor_distinct_from_future_physical_publisher', receipt['actual_physical_Source_editor'] == '/root/phase_frontier' and receipt['future_canonical_physical_actor'] == '/root')
    check('receipt_no_target_or_original_invocation', receipt['new_module_fixture_import_call_test'] is False and receipt['original_module_import_compile_call_test'] is False)
    for group in ('actual_outputs', 'actual_new_fragments', 'actual_Source_basis'):
        for index, q in enumerate(receipt[group]):
            check('receipt_' + group + '_pin_' + str(index), pinned(q))
    check('receipt_author_program_pin', pinned(receipt['actual_author_program']))
    check('schema_definitions_exact_accepted_I6', mc['SCHEMAS'] == i6c['SCHEMAS'] == api['schemas'])
    check('finite8_roles_exact_accepted_I6_order', mc['ROLE_ORDER'] == i6c['ROLE_ORDER'])
    check('support3_owner_scope_exact_current_key', mc['OWNER_SUPPORT_KEYS'] == ('current_owner_scope', 'different_current_owner_scope_Source_review', 'current_owner_scope_Root_adoption'))
    check('lease_support5_exact', mc['LEASE_SUPPORT_KEYS'] == ('canonical', 'separate_Root_decision', 'different_review', 'Root_adoption', 'original_publication'))
    check('source_caps_and_actual_Root_thread_exact', mc['SOURCE_CAP'] == CAP and mc['PHASE_CAP'] == 65536 and mc['ROOT_THREAD'] == '01a13e5d-171f-77b2-bd9c-a6cfae4f5a68')
    check('literal_real_hold_false', mc['CURRENT_OWNER_V2_CANONICAL_PUBLICATION_BINDINGS_QUALIFIED'] is False)
    for name in ('publish_current_owner_finite8', 'reconcile_current_owner_finite8'):
        n = mf[name]
        check('double_hold_' + name, len(n.body) == 2 and isinstance(n.body[0], ast.If) and isinstance(n.body[1], ast.Raise)
              and all(isinstance(x, ast.Raise) for x in n.body[0].body) and len(calls(n)) == 2)
    for prefix, tree in (('module', mt), ('fixture', tt)):
        check(prefix + '_no_import_time_IO_or_main', all(isinstance(n, (ast.Import, ast.ImportFrom, ast.Assign, ast.FunctionDef, ast.ClassDef)) or (isinstance(n, ast.Expr) and isinstance(n.value, ast.Constant)) for n in tree.body))
        imports = [n for n in ast.walk(tree) if isinstance(n, (ast.Import, ast.ImportFrom))]
        names = [a.name for n in imports if isinstance(n, ast.Import) for a in n.names] + [n.module for n in imports if isinstance(n, ast.ImportFrom)]
        check(prefix + '_only_actual_required_stdlib_imports', set(names) <= {'os', 'stat', 'hashlib', 'datetime', 'json', 're', 'pathlib'})
        check(prefix + '_no_exec_eval_compile_importlib_process_Native_Parser_calls', not any((isinstance(n.func, ast.Name) and n.func.id in ('exec', 'eval', 'compile', '__import__')) or
               (isinstance(n.func, ast.Attribute) and n.func.attr in ('Popen', 'run', 'system', 'ParseFile', 'LoadLibrary', 'WinDLL', 'CDLL')) for n in calls(tree)))
    # Binding order and local function signatures are checked from AST, without compiling targets.
    for prefix, tree in (('module', mt), ('fixture', tt)):
        defined = set(dir(builtins))
        failures = []
        for n in tree.body:
            eager = []
            if isinstance(n, ast.Assign):
                eager = [n.value]
            elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)):
                eager = [*n.decorator_list, *n.args.defaults, *(q for q in n.args.kw_defaults if q is not None)]
            elif isinstance(n, ast.ClassDef):
                eager = [*n.bases, *n.decorator_list, *(q.value for q in n.keywords)]
            for expr in eager:
                for q in ast.walk(expr):
                    if isinstance(q, ast.Name) and isinstance(q.ctx, ast.Load) and q.id not in defined:
                        failures.append((n.lineno, q.id))
            if isinstance(n, ast.Import):
                defined.update(a.asname or a.name.split('.')[0] for a in n.names)
            elif isinstance(n, ast.ImportFrom):
                defined.update(a.asname or a.name for a in n.names)
            elif isinstance(n, ast.Assign):
                defined.update(q.id for target in n.targets for q in ast.walk(target) if isinstance(q, ast.Name) and isinstance(q.ctx, ast.Store))
            elif isinstance(n, (ast.FunctionDef, ast.ClassDef)):
                defined.add(n.name)
        check(prefix + '_sequential_eager_bindings_defined', not failures, failures)
        defs = {n.name:n for n in tree.body if isinstance(n, ast.FunctionDef)}
        failures = []
        for n in calls(tree):
            if not isinstance(n.func, ast.Name) or n.func.id not in defs or any(isinstance(q, ast.Starred) for q in n.args) or any(q.arg is None for q in n.keywords):
                continue
            d = defs[n.func.id].args
            positional = d.posonlyargs + d.args
            required = [q.arg for q in positional[:len(positional)-len(d.defaults)]]
            kw_required = [q.arg for q, default in zip(d.kwonlyargs, d.kw_defaults) if default is None]
            provided = [q.arg for q in positional[:len(n.args)]] + [q.arg for q in n.keywords]
            allowed = {q.arg for q in positional + d.kwonlyargs}
            good = (d.vararg is not None or len(n.args) <= len(positional)) and len(provided) == len(set(provided)) and all(q in provided for q in required + kw_required) and (d.kwarg is not None or all(q.arg in allowed for q in n.keywords))
            if not good:
                failures.append((n.lineno, n.func.id))
        check(prefix + '_unexpanded_local_call_signatures', not failures, failures)
    # Source-specific semantic checks. These inspect actual Source, never call target predicates.
