        'metadata_view_immutable_bytes_detached_copy': all(x in source['MetadataView'] for x in ('class MetadataView(tuple)', '(_wire(value),)', 'return _json(self[0])', 'return True', 'return False')),
        'publication43_validates_request_header': '_validate_request_header(request)' in source['construct_publication43'],
