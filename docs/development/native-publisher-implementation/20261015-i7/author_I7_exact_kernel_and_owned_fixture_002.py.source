def pin(path):
    data = path.read_bytes()
    return dict(path=str(path), bytes=len(data), sha256=hashlib.sha256(data).hexdigest())


def json_bytes(value):
    return (json.dumps(value, ensure_ascii=False, allow_nan=False, sort_keys=True, indent=2)+'\n').encode()


def save(path, data):
    assert type(data) is bytes and 0 < len(data) <= 2097152
    with path.open('xb') as stream:
        assert stream.write(data) == len(data)
    assert path.read_bytes() == data
    return pin(path)


def literal_from_source(data, name):
    # Read one known literal assignment as data; no predecessor module AST/compile/import.
    prefix = name + ' = '
    lines = [line[len(prefix):] for line in data.decode().splitlines() if line.startswith(prefix)]
    assert len(lines) == 1
    return ast.literal_eval(lines[0])


def function_rows(data):
    lines = data.splitlines(keepends=True)
    starts = [0]
    for line in lines: starts.append(starts[-1]+len(line))
    result = []
    for node in ast.parse(data).body:
        if isinstance(node, (ast.FunctionDef, ast.ClassDef)):
            first = min([node.lineno]+[x.lineno for x in node.decorator_list])
            start = starts[first-1]
            end = starts[node.end_lineno]
            raw = data[start:end]
            result.append(dict(name=node.name, line_start=first, line_end=node.end_lineno,
                start_byte=start, end_byte=end, bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest()))
    return result


