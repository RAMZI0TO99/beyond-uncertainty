    check('only_reviewed_Source002_paths', mc['MODULE_PATH'] == outer['publisher_Source']['path'] and mc['FIXTURE_PATH'] == outer['fixture_Source']['path'] and mc['API_PATH'] == outer['API']['path'])
    check('private_scope_execution_flags_exact', private['operational_authority'] is False and private['original_project_target_execution'] is False and private['owned_I7_synthetic_IO_execution'] is True)
    check('outer_one_use_only_owned_synthetic_invocation', type(outer['maximum_invocations']) is int and outer['maximum_invocations'] == 1 and outer['automatic_retry_authorized'] is False and outer['new_I7_owned_synthetic_IO_invocation_authorized'] is True)
    check('outer_no_original_Project_or_Native_Parser_authority', outer['original_publisher_I0_I1_I2_I3_I4_I5_I6_native_Parser_project_invocations_authorized'] is False and outer['actual_selected45_Source_publication_authorized'] is False)
    check('outer_future_grants_unset_and_75_spent_preserved', outer['actual_new_lease_family_grant_canonical_paths_ordinals_purpose_Native8_Parser_results'] is None and outer['all75_spent_no_replay_and_all_prior_holds_preserved'] is True)
    check('outer_not_operational_or_scientific', outer['operational_authority'] is False and outer['scientific_authority'] is False)
    check('exact_Windows_owned_namespace', private['owned_namespace'] == outer['owned_namespace_root'] == mc['FIXTURE_NAMESPACE'] == interface['owned_namespace'] == r'D:\Aenv\pro2\WORK\I7F010\n1')
    root = Path(outer['owned_namespace_root'])
    check('owned_namespace_n1_absent_before_Root_supervisor', not os.path.lexists(root))
    existing = []
    for path in root.parents:
        if os.path.lexists(path):
            info = path.lstat()
            existing.append(str(path))
            check('existing_owned_ancestor_ordinary_' + str(len(existing)), stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode) and not getattr(info,'st_file_attributes',0)&1024)
    manifest = interface['case_manifest']
    check('exact54_ordered_case_manifest_three_way', private['case_manifest'] == mc['CASE_MANIFEST'] == manifest and tuple(q['case'] for q in manifest) == tc['PLANNED_CASE_NAMES'] == tuple(interface['planned_case_names']) and len(manifest) == outer['expected_planned_case_count'] == tc['EXPECTED_CASE_COUNT'] == 54)
    expected_dirs = [str(root)] + [str(root/q['directory']) for q in manifest]
    expected_leaves = [dict(path=str(root/leaf['path']),cap=leaf['cap'],kind=leaf['kind'],case=row['case']) for row in manifest for leaf in row['leaves']]
    check('exact125_leaf_manifest_no_extra_or_missing', outer['exact_owned_leaf_manifest'] == expected_leaves and len(expected_leaves) == 125)
    check('exact55_directory_manifest_no_extra_or_missing', outer['exact_owned_directories'] == expected_dirs and len(expected_dirs) == 55)
    check('owned_paths_unique_case_insensitive', len({q['path'].casefold() for q in expected_leaves}) == 125 and len({q.casefold() for q in expected_dirs}) == 55)
    for index, row in enumerate(manifest):
        case_root = root/row['directory']
        good = all(type(q['cap']) is int and q['cap'] in (65536,CAP) and (root/q['path']).parent == case_root and '..' not in (root/q['path']).parts and not os.path.lexists(root/q['path']) for q in row['leaves'])
        check('exact_unborn_owned_leaves_case_' + row['case'], good and not os.path.lexists(case_root))
    check('actual_hardlink_setup_only_fixed_declared_owned_endpoints', outer['actual_owned_hardlink_setup_authorized'] is True and {q['path'] for q in expected_leaves if q['case']=='hardlink_refusal'} == {str(root/r'c13\a.in'),str(root/r'c13\l.in')})
    check('namespace_marker_exact_and_absent', outer['namespace_marker_name'] == mc['NAMESPACE_MARKER'] == 'ROOT_I7_OWNED_NAMESPACE_BINDING_001.json' and not os.path.lexists(root/outer['namespace_marker_name']))
    outputs = ('consumption_marker_name','supervisor_marker_name','saved_result_name','supervisor_result_name','child_stdout_name','child_stderr_name')
    check('one_use_outputs_unique', len({outer[k].casefold() for k in outputs}) == len(outputs))
    for key in outputs:
        name = outer[key]
        check('one_use_output_exact_leaf_absent_' + key, type(name) is str and re.fullmatch(r'[A-Z0-9_]+\.(?:json|txt)',name) is not None and not os.path.lexists(P/name), name)
    for key in ('hard_timeout_seconds','metadata_cap'):
        check('private_budget_' + key, type(private[key]) is int and private[key] == (60 if key=='hard_timeout_seconds' else CAP))
    for key, expected in (('wall_cap_seconds',60),('cleanup_reap_seconds',5),('stream_and_result_cap_bytes',CAP),('owned_hidden_child_maximum',1)):
        check('outer_budget_' + key, type(outer[key]) is int and outer[key] == expected)
    check('no_cleanup_and_original_budget_preservation', outer['owned_namespace_preserved_no_cleanup'] is True and outer['original_Native_Parser_budgets_120_110_10_5_unchanged'] is True)
    resource = outer['actual_resource_observation']
    check('scope_resource_creation_explicitly_historical', outer['scope_creation_resource_observation_is_historical'] is True)
    check('recorded_creation_resource_floors_typed', all(type(resource[k]) is int for k in ('available_RAM_bytes','disk_free_bytes','RAM_floor_bytes','disk_floor_bytes','age_limit_seconds')) and resource['available_RAM_bytes'] >= resource['RAM_floor_bytes'] == 1073741824 and resource['disk_free_bytes'] >= resource['disk_floor_bytes'] == 10737418240 and resource['age_limit_seconds'] == 60)
    runnerp, supervisorp = Path(outer['exact_child_runner']['path']), Path(outer['exact_supervisor_Source']['path'])
    check('actual_runner003_exact_reviewed_pin', pin(outer['exact_child_runner']) and runnerp.name == 'ROOT_RUN_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_003.py' and outer['exact_child_runner']['sha256'] == '0992faf7fd41b036055eae32e04d47b612dc478ff3b157c3f616e656f2d8198b')
    check('actual_supervisor005_exact_reviewed_pin', pin(outer['exact_supervisor_Source']) and supervisorp.name == 'ROOT_SUPERVISE_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_005.py' and outer['exact_supervisor_Source']['sha256'] == '76fae354ca75211c7412aec6e3dd37500ead819f3ae4c7f9e2feee3d519d9745')
    runner, supervisor = raw(runnerp).decode(), raw(supervisorp).decode()
    check('current_supervisor_uses_child003_and_single_hidden_child', "ROOT_RUN_I7_ONCE_OWNED_SYNTHETIC_IO_FIXTURES_003.py" in supervisor and supervisor.count('subprocess.Popen(') == 1 and 'creationflags=subprocess.CREATE_NO_WINDOW' in supervisor)
    check('fresh_resource_probes_before_namespace_and_launch', supervisor.index('resource_before_namespace=fresh_resources()') < supervisor.index('root.mkdir(') and supervisor.index('resource_prelaunch=fresh_resources()') < supervisor.index('subprocess.Popen(') and "time.monotonic_ns()-resource_prelaunch['observed_monotonic_ns']<60000000000" in supervisor)
    check('fresh_resource_probes_exact_floors_not_Native8', 'm.available>=1073741824 and disk>=10737418240' in supervisor and 'FileTime_or_Native8_collection=False' in supervisor)
    check('single_wait5_and_observed_wall60_strict', supervisor.count('proc.wait(timeout=5)') == 1 and 'if child_wall is not None and child_wall>60000000000' in supervisor)
    check('Root_child_consumes_before_new_module_exec', runner.index("consumed=save(s['consumption_marker_name']") < runner.index('exec(compile(modraw'))
    check('Root_child_audit_leaf_whitelist_and_only_scope_marker_reads', "readonly={key(privatepin['path']),key(namespace_marker['path'])}" in runner and "writable if write else writable|readonly" in runner)
    check('Root_child_current_truthful_profile_and_partial_prefix', 'partial_cases=decode(encoded)' in runner and 'copied_writer_entry_count=functions.get' in runner and 'completed actual IO is evidenced separately' in runner)
    raw(Path(__file__))
    for index, q in enumerate(list(INPUTS.values())):
        check('final_rehash_actual_input_' + str(index).zfill(2), pin(q), q)
    check('final_scope_reserve_remains_above60', ticks6(dt.datetime.now(dt.timezone.utc).isoformat(timespec='microseconds')) + 600000000 < end)
    failed = [q for q in CHECKS if q['passed'] is not True]
    common = dict(reviewer='/root/owner_source_review',source_author='/root',subjects=[fact(privatep),fact(outerp)],
                  checks_passed=len(CHECKS)-len(failed),checks_failed=len(failed),target_execution=False,tests_executed=False,
                  target_imports=0,target_function_calls=0,target_Source_compilations=0,I7_owned_IO_fixture_runs=0,
                  original_I0_I6_Native_Parser_calls=0,created_utc=dt.datetime.now(dt.timezone.utc).isoformat())
    full = dict(schema_version=1,record_type='Independent_I7_actual_fresh_private18_outer_scope_preinvocation_Source_review',
                verdict='PASS_SOURCE_I7_FRESH_OWNED_IO_SCOPES_BEFORE_INVOCATION' if not failed else 'REFUSE_I7_FRESH_SCOPE',
                all_actual_inputs=list(INPUTS.values()),checks=CHECKS,reviewer_Source=fact(Path(__file__)),
                exact_expected_cases=54,exact_owned_leaves=125,exact_owned_directories=55,
                authority_boundary='Only new copied IO on owned neutral synthetic leaves. Real publication/reconciliation and full owner/lease/producer/proof/caller bindings remain held; no original/I0-I6/Native8/Parser/runtime/science execution.',
                resource_boundary='Scope creation observation is historical. Reviewed supervisor must make its two actual fresh Root RAM/disk floor probes before namespace and launch; this reviewer made no resource or Native collection call.',
                audit_boundary='CPython audit is not exhaustive stat/native interception; reviewed Source wrappers and exact declared paths are also required.',
                absent_before_invocation_outputs=[str(P/outer[k]) for k in outputs]+[str(root)],**common)
    fp = save(O/'INDEPENDENT_I7_ACTUAL_FRESH_SCOPE_FULL_SOURCE_PROOF_001.json',full)
    capsule = dict(schema_version=1,record_type='Independent_I7_actual_fresh_scope_preinvocation_capsule',
                   verdict=full['verdict'],full_proof=fp,reviewer_Source=fact(Path(__file__)),
                   actual_input_count=len(INPUTS),exact_expected_cases=54,exact_owned_leaves=125,exact_owned_directories=55,
                   actual_Source_adoption=fact(adoptionp),no_run_performed=True,not_real_family_admission=True,**common)
    cp = save(O/'INDEPENDENT_I7_ACTUAL_FRESH_SCOPE_SOURCE_CAPSULE_001.json',capsule)
    print(json.dumps(dict(capsule=cp,full_proof=fp,reviewer_Source=fact(Path(__file__)),checks=len(CHECKS),inputs=len(INPUTS),failed=failed)))

if __name__ == '__main__':
    main()
