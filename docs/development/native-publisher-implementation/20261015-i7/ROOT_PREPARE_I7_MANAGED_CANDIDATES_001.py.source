"""Prepare finite I7 inert Source/evidence copies, without invoking project code."""
import datetime,hashlib,json,os
from pathlib import Path
R=Path(r'D:\Aenv\pro2');P=R/'WORK/resume-20261015-001/native_publisher_implementation_010';G=R/'github-portable-20261012-001';C=R/'WORK/I7P010/c1';CAP=2097152
REL='docs/development/native-publisher-implementation/20261015-i7/'
def raw(p):
 p=Path(p);assert p.is_file() and not p.is_symlink() and p.stat().st_size<=CAP
 with p.open('rb') as f:b=f.read(CAP+1)
 assert len(b)<=CAP;return b
def fact(p):
 b=raw(p);return dict(path=str(p),bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
def pin(q):
 b=raw(q['path']);assert len(b)==q['bytes'] and hashlib.sha256(b).hexdigest()==q['sha256'];return b
def save(p,x):
 p=Path(p);b=x if type(x) is bytes else (json.dumps(x,sort_keys=True,indent=2,allow_nan=False)+'\n').encode();assert len(b)<=CAP
 p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb') as h:h.write(b);h.flush();os.fsync(h.fileno())
 return fact(p)
def main():
 adoptionpin=fact(P/'ROOT_I7_HELD_PUBLISHER_IO_AND_SAVED_OWNED_RESULTS_ADOPTION_001.json');a=json.loads(pin(adoptionpin))
 assert a['author']=='/root' and a['verdict']=='ACCEPT_I7_HELD_PUBLISHER_IO_AND_SAVED_SYNTHETIC_OWNED_RESULTS_ONLY'
 assert type(a['I7_owned_IO_test_runs']) is int and a['I7_owned_IO_test_runs']==1 and a['tests_executed'] is True and a['original_project_native_Parser_runtime_scientific_execution'] is False
 assert type(a['actual_owned_IO_case_count']) is int and a['actual_owned_IO_case_count']>0 and a['actual_owned_IO_cases_passed']==a['actual_owned_IO_case_count']
 scopepin=fact(P/'ROOT_CURRENT_I7_CANONICAL_PUBLISHER_IMPLEMENTATION_SOURCE_SCOPE_001.json');s=json.loads(pin(scopepin));assert scopepin['sha256']=='59d328ed6d2ac90ff122f64c31a96a4a01d5a9300f98d46d5965382d457150dd'
 assert datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(seconds=60)<datetime.datetime.fromisoformat(s['interval_end'])
 previouspin=s['prior_finite_managed_scope'];assert previouspin['sha256']=='4d4b78ccba40ee970c1cc6b6bb38a57d074e36a3217c87c199be0c58006bab20';previous=json.loads(pin(previouspin))
 rows=[];evidence=[];seen=set();prior=[]
 for row in previous['files']:
  q=dict(path=str(G/row['managed_path']),bytes=row['source']['bytes'],sha256=row['source']['sha256']);pin(q)
  if row['mode']=='create':prior.append(q)
 assert len(prior)==77
 def add(name,b):
  relative=REL+name;assert relative not in seen and not (G/relative).exists() and len(str(G/relative))<260;seen.add(relative)
  q=save(C/relative,b);rows.append(dict(managed_path=relative,mode='create',source=q));return q
 inputs=a['managed_evidence_inputs']+[adoptionpin];assert len({q['path'] for q in inputs})==len(inputs)
 for q in inputs:
  path=Path(q['path']);assert path.resolve().is_relative_to(P.resolve());inert=path.suffix in ('.py','.ps1');name=path.name+('.source' if inert else '')
  assert Path(name).suffix in ('.json','.source');copied=add(name,pin(q));evidence.append(dict(original=q,managed_path=REL+name,copied_bytes=copied['bytes'],copied_sha256=copied['sha256'],inert_Source_copy=inert))
 add('evidence-index.json',dict(schema_version=1,record_type='I7_exact_held_publisher_IO_Source_and_owned_synthetic_evidence_index',files=evidence,actual_evidence_copy_count=len(evidence),actual_new_I7_owned_synthetic_IO_tests=True,original_publisher_I0_I1_I2_I3_I4_I5_I6_import_call_test_execution=False,real_selected45_Source_publication=False,actual_lease_family_Native8_Parser_results=None,dated_Source_present=36,dated_Source_pending=9,frozen_STEP080_present=35,frozen_STEP080_pending=10,absolute_paths_are_dated_provenance_not_runtime_bindings=True))
 count=a['actual_owned_IO_case_count'];checks=a['actual_independent_saved_results_checks']
 report=(f'# Held owner-v2 publisher IO implementation\n\nThe new finite-eight publisher IO layer passed {count}/{count} cases in one separately scoped Windows owned-file test run. Independent saved-results review passed {checks} checks without rerunning the fixture. The [Root adoption](ROOT_I7_HELD_PUBLISHER_IO_AND_SAVED_OWNED_RESULTS_ADOPTION_001.json) and [evidence index](evidence-index.json) pin the exact Source, fixtures and results. These are actual filesystem operations on synthetic owned payloads, with fault-injected branches labelled separately. They establish the tested IO component only.\n\nThe implementation retains 24 inherited IO/codec helpers byte for byte. The writer retains its complete original Source except three owner-context guard callsites. Exclusive staging creation, flush/fsync, complete readback, Windows no-overwrite rename, paired PATH9/descriptor9 vectors, shared cross7 comparisons and the exact rename comparison excluding ctime remain intact. Writer raw9 observations are not accepted Native8 measurements.\n\nReal-family publication and reconciliation entries remain held by a literal false binding flag and an unconditional UNWIRED refusal before IO. The private owned-fixture context cannot satisfy those entries. Full I0 owner policy and Source-publication purpose, canonical I1 lease metadata, qualified I2 producer/receipt22/facts21/purpose proof semantics, current resources and actual caller bindings remain UNWIRED. No JSON flag, fixture result or copied helper changes those requirements.\n\nThe structural prewrite plan supports an ordered nonempty subset of the eight roles with exact closed request21/row10 metadata and selected draft pins. It preserves strings and rejects variants. It is metadata-only, with actual admission false. Template publication must precede BOUND generation and the required external capture/binding/peer roles; this IO component does not close that staged bootstrap. It does not fabricate unknown BOUND hashes or require all45 canonical files.\n\nPublication43/row13 data constructors use existing prepublication draft and receipt Source proofs. A later separate reconciliation26 constructor refers to an existing original publication, actual external witness and subsequent canonical delta review/adoption; it performs no canonical rewrite. Constructors check their supplied data and do not create owner authority. I6 remains an unchanged postbirth metadata audit, with its protected sixteen-path contract; it is never used to authorize prewrite or to hash unborn publication records. Native8 must follow Source birth.\n\nFailures preserve staging or the actual canonical prefix. There is no overwrite, rollback, cleanup, identity reuse or automatic retry. A later row failure or publication-record collision/overflow yields a saved partial refusal and no successful publication43. The owned test namespace and captured traces remain dated artifacts outside the managed copies. Schema examples are nested synthetic data, not standalone authority records.\n\nThe actual selected Source family remains36/45 with nine pending; frozen STEP080 remains35/45 with ten pending. All75 spent identities and original holds, caps, clocks and reserves remain unchanged. Historical608 file bytes, eight frozen sentinels, current36 Source bytes and prior77 I6 evidence files are preserved. The three new navigation prefixes retain every prior byte. No original publisher/I0-I6 helper or test, Native collector, Parser, runtime or scientific operation ran. The inherited algorithms were exercised only as copied code inside the new scoped I7 module.\n\nNext: implement and review the missing actual prewrite admission and staged producer/caller bindings, then the postbirth Native8 support carrier, Parser saved-result adapter and qualifying I2/I3/I4/I5 successors. The current component does not issue a lease, select a real family or publish any of its Sources.\n\nProgram copies here use inert `.source` suffixes. Original absolute paths are dated evidence locations. Normal Git publication is recorded separately in Root receipts and repository history.\n').encode()
 add('I7_HELD_PUBLISHER_IO_IMPLEMENTATION.md',report)
 prefix=('**October15 I7 held publisher IO tested.** The [publisher IO checkpoint]('+REL+'I7_HELD_PUBLISHER_IO_IMPLEMENTATION.md) records tested owned-file staging, no-overwrite rename and failure preservation, plus held version2 metadata constructors. Actual owner/lease/producer admission and real-family entries remain UNWIRED. No canonical family, Native8, Parser or runtime result was created. Source remains36/45 and frozen STEP08035/45. All prior guidance is preserved below.\n\n---\n\n').encode()
 for name in ('CONTINUE.md','AGENTS.md','README.md'):
  predecessor=fact(G/name);old=pin(predecessor);saved=save(P/'managed_preparation_001/predecessors_001'/name,old);source=save(C/name,prefix+old);rows.append(dict(managed_path=name,mode='prepend',source=source,predecessor=predecessor,saved_predecessor=saved,prefix_bytes=len(prefix)))
 out=dict(schema_version=1,record_type='Root_exact_finite_I7_held_publisher_IO_and_owned_results_managed_publication_scope',author='/root',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),base_HEAD=s['managed_base_HEAD'],files=rows,managed_file_count=len(rows),Root_implementation_adoption=adoptionpin,preexisting608_byte_baseline=previous['preexisting608_byte_baseline'],all_frozen_STEP080_sentinels=previous['all_frozen_STEP080_sentinels'],current36_Source_baseline=previous['current36_Source_baseline'],all_prior_I6_non_navigation_file_pins=prior,target_execution=False,tests_executed=True,I7_owned_IO_test_runs=1,original_project_target_execution=False)
 print(json.dumps(save(P/'managed_preparation_001/candidates_001/EXACT_MANAGED_I7_HELD_PUBLISHER_IO_IMPLEMENTATION_PUBLICATION_SCOPE_001.json',out)))
if __name__=='__main__':main()
