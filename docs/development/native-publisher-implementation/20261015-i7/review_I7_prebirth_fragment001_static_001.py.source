"""Independent draft Source inspection; never imports or invokes the draft."""
import ast
import datetime as dt
import hashlib
import json
from pathlib import Path

P = Path(r'D:\Aenv\pro2\WORK\resume-20261015-001\native_publisher_implementation_010')
O = P / 'independent_review_001'
CAP = 2097152

def read(p):
    p = Path(p)
    b = p.read_bytes()
    assert 0 < len(b) <= CAP
    return b

def pin(p):
    b = read(p)
    return dict(path=str(p), bytes=len(b), sha256=hashlib.sha256(b).hexdigest())

def main():
    paths = [
        P / 'i7' / 'I7_NEW_PUBLISHER_SOURCE_FRAGMENT_001.py',
        P / 'ROOT_CURRENT_I7_CANONICAL_PUBLISHER_IMPLEMENTATION_SOURCE_SCOPE_001.json',
        P / 'ROOT_I7_EXACT_HELD_PUBLISHER_IO_AND_ENVELOPE_IMPLEMENTATION_PROTOCOL_001.json',
        P / 'ROOT_I7_PROTOCOL001_FIXTURE_GUARD_AND_STRUCTURAL_PLAN_CLARIFICATION_001.json',
        P / 'ROOT_I7_PROTOCOL001_ACTUAL_DIFFERENT_SOURCE_REVIEW_ADOPTION_001.json',
        Path(__file__),
    ]
    source = read(paths[0]).decode('utf-8')
    tree = ast.parse(source, filename=str(paths[0]))
    funcs = {n.name: ast.get_source_segment(source, n) for n in tree.body if isinstance(n, ast.FunctionDef)}
    evidence = {
        name: funcs[name] for name in (
            '_fixture_scope_check', 'construct_reconciliation26', 'construct_publication43',
            'build_finite8_prewrite_metadata_plan',
        )
    }
    findings = [
        dict(name='final_Source_adoption_path_must_allow_P10_Root',
             status='PREBIRTH_CORRECTION_REQUESTED',
             evidence="Source_review_Root_adoption is included in the loop requiring SOURCE_DIRECTORY, while the adopted final Source record is at P10 root.",
             requested_change='Separate exact Root adoption path from the three i7 Source/API paths.'),
        dict(name='canonical_birth_keeps_seven_fractional_digits',
             status='PREBIRTH_CORRECTION_REQUESTED',
             evidence="construct_reconciliation26 passes canonical_Source_birth_utc to _ticks6, rejecting genuine seven-digit birth strings.",
             requested_change='Accept exact canonical birth7 (or exact6/7 compatibility) without rounding or rewriting strings.'),
        dict(name='envelope_constructors_validate_request21_header_flags',
             status='PREBIRTH_CORRECTION_REQUESTED',
             evidence="construct_publication43 closes request21 but omits schema/type/identity/flag predicates enforced by build_finite8_prewrite_metadata_plan.",
             requested_change='Reuse a pure request21 structural validator in plan and43, hence delegated26; do not claim full admission.'),
    ]
    result = dict(
        schema_version=1,
        record_type='Independent_I7_prebirth_fragment001_actual_static_findings',
        reviewer='/root/owner_source_review', source_author='/root/phase_frontier',
        created_utc=dt.datetime.now(dt.timezone.utc).isoformat(),
        verdict='PREBIRTH_DRAFT_CORRECTIONS_REQUIRED_NOT_FINAL_SOURCE_REVIEW',
        all_actual_inputs=[pin(p) for p in paths],
        Source_evidence=evidence, findings=findings, findings_count=len(findings),
        target_execution=False, tests_executed=False, target_imports=0,
        target_function_calls=0, target_Source_compilations=0, copied_IO_kernel_calls=0,
        filesystem_mutations='Only this reviewer-owned Source and JSON; no fixture or family paths.',
        final_quartet_review_still_required=True,
    )
    b = (json.dumps(result, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    assert len(b) <= CAP
    out = O / 'I7_PREBIRTH_FRAGMENT001_ACTUAL_STATIC_FINDINGS_001.json'
    with out.open('xb') as f:
        f.write(b)
    print(json.dumps(pin(out)))

if __name__ == '__main__':
    main()
