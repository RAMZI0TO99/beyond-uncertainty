def pairs(rows):
 d={}
 for k,v in rows:
  if k in d:raise ValueError('duplicate JSON key')
  d[k]=v
 return d
def bad(v):raise ValueError(v)
def read(path):
 path=Path(path);b=path.read_bytes();assert 0<len(b)<=2097152
